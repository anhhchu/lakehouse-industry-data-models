// DBML Schema for Business: Title_Insurance
// Version: 1
// Generated on: 2026-10-31 06:37:45

Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Title_Insurance - Version 1'
}

Table ti_operations.title_order {
  title_order_id varchar [pk, note: 'Unique surrogate identifier for the title order record. Primary key for the title_order entity in the operations domain.']
  agent_profile_id varchar [note: 'References the independent title agent profile when the order is produced through the independent agent channel. Null for direct branch and centralized lender orders.']
  order_channel_id varchar [note: 'References the order channel through which this title order was received (direct branch, centralized lender, or independent agent).']
  parcel_id varchar [note: 'References the parcel record associated with the subject property for this title order.']
  actual_closing_date date [note: 'Date the transaction actually closed and funds were disbursed. Populated post-closing. Used for cycle-time analysis and comparison against scheduled closing date.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor to uniquely identify the subject property for tax and recording purposes. Also known as PIN in some jurisdictions.']
  buyer_name varchar [note: 'Full legal name of the buyer (purchase) or borrower (refinance/HELOC). Restricted PII. Used for vesting, policy issuance, and NPPI-controlled workflows.']
  cancellation_date date [note: 'Date the title order was cancelled, if applicable. Populated only when order_status is \'cancelled\'. Used for fallout analysis and pipeline reporting.']
  cancellation_reason varchar [note: 'Reason code for order cancellation. Used for fallout root-cause analysis and pipeline management reporting.']
  closing_disclosure_form_type varchar [note: 'Type of settlement/closing disclosure form required: Closing Disclosure (CD) for TRID loans, HUD-1 for pre-TRID or exempt, ALTA Settlement Statement, or none for non-applicable transactions.']
  county_name varchar [note: 'County name where the subject property is located. Determines the recording jurisdiction and county recorder/register of deeds office for document submission.']
  cpl_required boolean [note: 'Indicates whether a Closing Protection Letter (CPL) must be issued to the lender for this order. Required by most institutional lenders for independent agent closings.']
  created_timestamp timestamp [note: 'Timestamp when the title_order record was first created in the data platform. Audit field for record provenance and lineage tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this order. Defaults to USD for domestic US transactions.']
  erecording_enabled boolean [note: 'Indicates whether documents for this order will be submitted via eRecording (e.g., Simplifile, CSC eRecording) rather than physical recording at the county recorder\'s office.']
  escrow_officer_name varchar [note: 'Name of the escrow officer or closing agent assigned to manage the escrow trust account and closing for this title order.']
  fips_code varchar [note: 'Five-digit FIPS county code identifying the county of the subject property. Used for county-level regulatory reporting, recording jurisdiction routing, and MERS reporting.']
  iolta_required boolean [note: 'Indicates whether escrow funds must be held in an IOLTA-compliant trust account for this order, as required by state bar rules in applicable jurisdictions.']
  lender_loan_number varchar [note: 'Lender-assigned loan number for cross-referencing the title order with the lender\'s origination system. Required for TRID compliance and closing disclosure reconciliation.']
  lender_name varchar [note: 'Name of the mortgage lender or financial institution ordering the lender title policy. Key party reference for lender channel routing and CPL issuance.']
  lender_policy_required boolean [note: 'Indicates whether a lender\'s title policy (LTP) is required for this order. Typically required by the mortgage lender as a condition of the loan.']
  loan_amount decimal(15,2) [note: 'Principal loan amount in US dollars for which the lender title policy (LTP) will be issued. Drives lender policy premium calculation and LTV/CLTV analysis.']
  ltv_ratio decimal(6,4) [note: 'Ratio of the loan amount to the property sales price or appraised value, expressed as a decimal (e.g., 0.8000 = 80%). Used for underwriting risk tier assignment and referral thresholds.']
  mers_reporting_required boolean [note: 'Indicates whether the mortgage instrument must be registered with MERS. Applicable when the lender uses MERS as the mortgagee of record.']
  order_date date [note: 'Calendar date the title order was received and entered into the Title Production System. Serves as the BUSINESS_EVENT_TIMESTAMP anchor for SLA and cycle-time measurement.']
  order_notes varchar [note: 'Free-text operational notes entered by intake staff or processors regarding special instructions, lender requirements, or order-specific conditions.']
  order_number varchar [note: 'Externally visible, human-readable order number assigned at intake by the Title Production System (e.g., SoftPro, RamQuest, Qualia). Used across all downstream modules.']
  order_received_timestamp timestamp [note: 'Precise date and time the title order was received by the system, including timezone offset. Used for intraday SLA measurement and intake-to-search cycle-time analytics.']
  order_status varchar [note: 'Current lifecycle status of the title order from intake through closing. Drives workflow routing and SLA tracking. [ENUM-REF-CANDIDATE: open|in_search|in_examination|commitment_issued|cleared_to_close|closed|cancelled|on_hold — promote to reference']
  owner_policy_required boolean [note: 'Indicates whether an owner\'s title policy (OTP) is required or requested for this order. Drives policy issuance workflow and premium calculation.']
  prior_order_number varchar [note: 'Order number of a prior title order on the same property, if this order is a continuation, reissue, or refinance of a previous transaction. Supports chain-of-title and reissue rate credit.']
  production_source varchar [note: 'Identifies the production channel source for this order: direct branch, centralized lender, or independent agent. Used for revenue attribution and channel performance reporting.']
  property_address_line1 varchar [note: 'Primary street address line of the subject property for this title order. Denormalized here for operational convenience and search/reporting without joining to property.']
  property_city varchar [note: 'City of the subject property. Used for jurisdiction routing, state filing, and geographic reporting.']
  property_state_code varchar [note: 'Two-letter USPS state abbreviation for the subject property. Drives state-specific underwriting rules, rate filings, and regulatory reporting.']
  property_zip_code varchar [note: 'Five- or nine-digit ZIP code of the subject property. Used for geographic risk segmentation, rate zone assignment, and county routing.']
  respa_applicable boolean [note: 'Indicates whether RESPA requirements apply to this transaction, governing settlement service disclosures and affiliated business arrangements.']
  ron_enabled boolean [note: 'Indicates whether Remote Online Notarization (RON) is authorized and enabled for the closing of this title order, subject to state law.']
  sales_price_amount decimal(15,2) [note: 'Contract purchase price of the subject property in US dollars. Used for owner policy premium calculation, LTV computation, and underwriting risk assessment. Null for refinance orders.']
  scheduled_closing_date date [note: 'Anticipated closing date for the transaction as scheduled at order intake or updated during the order lifecycle. Drives closing readiness and SLA monitoring.']
  seller_name varchar [note: 'Full legal name of the property seller. Restricted PII. Applicable to purchase transactions; null for refinance/HELOC. Used for chain-of-title and vesting verification.']
  sla_commitment_due_date date [note: 'Target date by which the title commitment must be issued per the applicable SLA for this order\'s channel and transaction type. Used for commitment issuance lag reporting.']
  title_examiner_name varchar [note: 'Name of the title examiner assigned to perform the title examination and identify defects, encumbrances, and chain-of-title breaks for this order.']
  transaction_type varchar [note: 'Classification of the real estate transaction type driving this title order: purchase, refinance (REFI), home equity line of credit (HELOC), construction, or commercial.']
  trid_applicable boolean [note: 'Indicates whether TRID disclosure requirements apply to this transaction. True for most residential purchase and refinance loans; false for exempt transaction types.']
  underwriter_code varchar [note: 'Code identifying the title insurance underwriter (e.g., FNF, FAF, STC, ORI) backing the policies issued on this order. Drives premium split and remittance routing.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the title_order record in the data platform. Used for change detection and incremental processing.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Core transaction spine for the operations domain. Represents a single title-insurance order from intake through closing, capturing transaction type (purchase, refinance, HELOC, construction, commercial), channel routing (direct branch, centralized lender'
}

Table ti_operations.party {
  party_id varchar [pk, note: 'Unique surrogate identifier for a party record in the title-insurance master party registry. Serves as the primary key across all title production, escrow, underwriting, and claims systems.']
  created_timestamp timestamp [note: 'Timestamp when the party record was first created in the title production or CRM system. Supports audit trail, data lineage, and SOX control evidence.']
  date_of_birth date [note: 'Birth date of a natural-person party. Used for identity verification, OFAC/FinCEN screening, and distinguishing same-name individuals in chain-of-title searches. Stored per GLBA NPPI controls.']
  dba_name varchar [note: 'Trade name or assumed name under which an organization operates, distinct from its legal entity name. Relevant for independent title agents and settlement service providers.']
  deceased_date date [note: 'Date of death for a natural-person party. Used to determine whether a conveyance occurred before or after death, which is critical for chain-of-title validity and estate underwriting.']
  entity_formation_date date [note: 'Date on which a legal entity was formally incorporated, organized, or registered. Used to verify the entity existed at the time of a conveyance for chain-of-title validity.']
  entity_formation_state varchar [note: 'Two-letter US state code where a legal entity (corporation, LLC, trust) was formed or registered. Used to validate authority to convey and underwriting risk assessment for organizational parties.']
  fax_number varchar [note: 'Fax number for the party, primarily used for lender, attorney, and independent agent communications where fax remains a standard document delivery channel.']
  first_name varchar [note: 'Given name of a natural-person party. Populated only when party_type is individual. Used for closing document preparation and NPPI-controlled communications.']
  identity_doc_ref varchar [note: 'Vault reference token pointing to the party\'s government-issued identity document (driver\'s license, passport) stored in the NPPI Vault. Required for RON/IPEN and closing identity verification.']
  is_deceased boolean [note: 'Indicates the party is deceased. Triggers estate/probate underwriting review, blocks new transaction role assignments, and preserves historical chain-of-title and claims records.']
  is_do_not_contact boolean [note: 'Indicates the party has opted out of marketing and non-essential communications. Enforced in CRM and title production system routing to comply with TCPA and CCPA opt-out requirements.']
  is_foreign_national boolean [note: 'Indicates whether the party is a non-US citizen or foreign entity. Triggers FIRPTA withholding analysis, additional underwriting review, and FinCEN beneficial ownership disclosure requirements.']
  is_nppi_consent_given boolean [note: 'Indicates whether the party has provided consent for sharing Non-Public Personal Information (NPPI) with affiliated settlement service providers per GLBA privacy notice requirements.']
  last_name varchar [note: 'Surname of a natural-person party. Used in grantor/grantee index searches and chain-of-title assembly. Retained for historical vesting even after legal name change.']
  legal_name varchar [note: 'Full legal name of the party exactly as it appears on vesting instruments, deeds, or articles of incorporation. Used for title commitment Schedule A vesting and policy issuance.']
  mailing_address_line1 varchar [note: 'First line of the party\'s mailing address (street number and name). Used for commitment and policy delivery, 1099-S mailing, and RESPA/TRID disclosure delivery.']
  mailing_address_line2 varchar [note: 'Second line of the party\'s mailing address (suite, unit, apartment number). Supplements mailing_address_line1 for complete postal delivery.']
  mailing_city varchar [note: 'City component of the party\'s mailing address. Required for RESPA/TRID disclosure delivery and IRS 1099-S reporting.']
  mailing_country varchar [note: 'ISO 3166-1 alpha-3 country code for the party\'s mailing address. Relevant for foreign national buyers, foreign lenders, and FIRPTA withholding determination.']
  mailing_postal_code varchar [note: 'ZIP or ZIP+4 postal code for the party\'s mailing address. Used for geographic risk segmentation, premium tax filing, and USPS delivery validation.']
  mailing_state varchar [note: 'Two-letter US state code for the party\'s mailing address. Used for state-specific regulatory disclosure routing and premium tax jurisdiction determination.']
  marital_status varchar [note: 'Marital status of a natural-person party at the time of the transaction. Drives spousal signature requirements, homestead rights analysis, and vesting options on title commitment Schedule A.']
  middle_name varchar [note: 'Middle name or initial of a natural-person party. Required for grantor/grantee name matching in chain-of-title searches to distinguish parties with common first and last names.']
  mobile_phone varchar [note: 'Mobile telephone number for the party. Used for SMS closing alerts, RON session links, and two-factor identity verification during electronic notarization.']
  name_suffix varchar [note: 'Generational or professional suffix appended to an individual party name (e.g., Jr., Sr., II). Critical for distinguishing same-name grantor/grantee pairs in chain-of-title searches.']
  nppi_consent_date date [note: 'Date on which the party provided or last renewed NPPI consent. Used to determine consent currency and trigger re-consent workflows per GLBA annual notice requirements.']
  ofac_screen_date date [note: 'Most recent date on which the party was screened against the OFAC SDN list. Used to determine whether a re-screen is required before closing based on elapsed time thresholds.']
  ofac_screen_result varchar [note: 'Outcome of the most recent OFAC SDN screening for this party. A hit or inconclusive result blocks closing until underwriting review is completed.']
  ofac_screened boolean [note: 'Indicates whether the party has been screened against the OFAC Specially Designated Nationals (SDN) list. Required for FinCEN compliance and underwriting approval prior to closing.']
  organization_name varchar [note: 'Legal entity name for organizations, trusts, estates, or government bodies. Populated when party_type is not individual. Used for vesting, lender identification, and agency agreement records.']
  party_code varchar [note: 'Business-facing alphanumeric identifier assigned to the party by the title production system (e.g., SoftPro, RamQuest, Qualia). Used for cross-system reconciliation and CRM lookup.']
  party_status varchar [note: 'Current lifecycle state of the party record. Inactive or dissolved parties are retained for historical chain-of-title and claims analysis but excluded from active transaction routing.']
  party_type varchar [note: 'Classifies the party as a natural person or legal entity. Drives vesting, signature, and NPPI handling rules. [ENUM-REF-CANDIDATE: individual|organization|trust|estate|government|other — promote to reference product]']
  preferred_contact_method varchar [note: 'Party\'s preferred channel for receiving closing documents, commitment updates, and settlement communications. Drives automated delivery routing in the title production system.']
  primary_email varchar [note: 'Primary email address for the party used for closing coordination, commitment delivery, and TRID/CD disclosures. Classified as NPPI under GLBA for individual parties.']
  primary_phone varchar [note: 'Primary telephone number for the party in E.164 format. Used for closing scheduling, RON/IPEN coordination, and identity verification callbacks.']
  record_effective_date date [note: 'Business-effective date from which this party record version is considered authoritative. Supports bi-temporal modeling for chain-of-title and ownership interest evidence provenance.']
  record_expiry_date date [note: 'Date on which this party record version is superseded by a newer version. Null indicates the current active version. Supports SCD Type 2 history for party identity changes.']
  secondary_email varchar [note: 'Alternate email address for the party, used when primary email is undeliverable or for routing copies of closing documents to a secondary contact such as a co-borrower or attorney.']
  source_system_party_code varchar [note: 'Native identifier for this party in the originating operational system (e.g., SoftPro contact ID, Salesforce Account ID). Used for cross-system reconciliation and master data management.']
  tax_id_ref varchar [note: 'Tokenized or vault reference to the party\'s Tax Identification Number (TIN) or Social Security Number (SSN). Actual value stored in the NPPI Vault per GLBA. Used for IRS 1099-S reporting and IOLTA compliance.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the party record. Used for change-data-capture (CDC) processing, master data synchronization, and audit trail maintenance.']
  vesting_type varchar [note: 'How the party holds or will hold title to real property (e.g., joint tenancy, tenancy in common, community property). Populates Schedule A of the title commitment and drives survivorship and conveyance rules.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master entity for every natural person or legal entity participating in a title transaction. Stores identity attributes (name, entity type, tax-ID reference, contact information, address) without embedding a role.'
}

Table ti_operations.party_role {
  party_role_id varchar [pk, note: 'Unique surrogate identifier for each party-role assignment record on a title order. Primary key of the party_role association entity.']
  cpl_issuance_id varchar [note: 'Reference to the CPL issuance record covering this party in this role. Populated when cpl_required is true and a CPL has been issued.']
  party_id varchar [note: 'Reference to the party record representing the person or organization assigned to this role on the title order.']
  superseded_by_role_party_role_id varchar [note: 'Reference to the party_role record that replaced this assignment when a role was revised or transferred. Supports lifecycle transition and revision history per VREQ-007.']
  title_order_id varchar [note: 'Reference to the title order on which this party holds the specified role. Anchors the role assignment to the production transaction spine.']
  acceptance_date date [note: 'Date the role assignment was formally accepted or confirmed by the relevant party or system. Distinct from execution, effective, submission, and recording dates per VREQ-008.']
  aml_screening_date date [note: 'Date on which the most recent AML/OFAC screening was performed for this party in this role. Used for compliance audit and re-screening interval tracking.']
  aml_screening_status varchar [note: 'Result of AML/OFAC/FinCEN screening for this party in this role. Supports fraud controls and regulatory compliance for high-value and cash transactions.']
  authority_document_ref varchar [note: 'Reference identifier for the document establishing the party\'s authority (e.g., POA instrument number, trust agreement reference, letters testamentary). Links to document management system.']
  authority_type varchar [note: 'Basis of authority under which the party acts in this role (e.g., self, power of attorney, trustee, executor, guardian, corporate officer). Drives curative and underwriting requirements.']
  cpl_required boolean [note: 'Indicates whether a Closing Protection Letter (CPL) must be issued naming this party in this role. Typically required for lender parties in lender-channel transactions.']
  created_timestamp timestamp [note: 'Timestamp when this party-role assignment record was first created in the system. Audit trail for record provenance per VREQ-007.']
  effective_date date [note: 'Date on which this party-role assignment became legally or operationally effective. Distinct from execution, submission, acceptance, and recording dates per VREQ-008.']
  execution_date date [note: 'Date the party executed or signed the document or agreement establishing this role. Distinct from effective, submission, acceptance, and recording dates per VREQ-008.']
  expiration_date date [note: 'Date on which this party-role assignment expires or is no longer valid. Null for open-ended assignments. Supports effective-dated role history per VREQ-007.']
  firpta_withholding_required boolean [note: 'Indicates whether FIRPTA withholding applies to this party in this role (typically seller parties who are foreign nationals). Drives escrow withholding and IRS reporting obligations.']
  foreign_national_flag boolean [note: 'Indicates whether this party is a foreign national or foreign entity, triggering FIRPTA withholding requirements, FinCEN beneficial ownership reporting, and enhanced due diligence.']
  identity_verification_date date [note: 'Date on which the party\'s identity was verified for this role assignment. Used for compliance audit trails and fraud control.']
  identity_verification_method varchar [note: 'Method used to verify the party\'s identity for this role (e.g., in-person, Remote Online Notarization (RON), In-Person Electronic Notarization (IPEN), knowledge-based authentication).']
  identity_verified boolean [note: 'Indicates whether the party\'s identity has been verified for this role assignment through an approved identity verification process (e.g., ID check, RON/IPEN verification).']
  is_primary boolean [note: 'Indicates whether this party is the primary holder of the role when multiple parties share the same role type on an order (e.g., primary borrower vs. co-borrower).']
  is_vesting_party boolean [note: 'Indicates whether this party appears on the vesting (title-holding) instrument for the subject property. Critical for Schedule A vesting language and ownership interest tracking.']
  marital_status varchar [note: 'Marital status of the party as relevant to vesting and spousal consent requirements. Required for community property states and certain title underwriting determinations.']
  notice_delivery_method varchar [note: 'Preferred method for delivering title-related notices and disclosures to this party in this role (email, mail, fax, portal, none). Supports TRID/RESPA disclosure delivery tracking.']
  nppi_vault_ref varchar [note: 'Tokenized reference to the NPPI Vault record holding sensitive identifiers (SSN/TIN, identity documents) for this party in this role. Actual NPPI is never stored here per GLBA/CCPA.']
  ownership_percentage decimal(5,4) [note: 'Fractional ownership interest held by this party when vesting type is tenancy in common or similar. Expressed as a decimal (e.g., 0.5000 = 50%). Null for sole ownership.']
  party_capacity varchar [note: 'Legal capacity in which the party acts in this role: individual (natural person), entity (corporation/LLC/partnership), trust, estate, government body, or other.']
  party_role_code varchar [note: 'Standardized alphanumeric code identifying the role type, aligned with MISMO or ALTA role code conventions (e.g., BUYER, SELLER, BRRWR, LNDR). Used for system integration and reporting.']
  respa_affiliated_flag boolean [note: 'Indicates whether this party has an affiliated business arrangement (AfBA) with the title company in this role, requiring RESPA Section 8 disclosure.']
  revision_number varchar [note: 'Sequential revision counter for this party-role assignment, incremented each time the role record is materially updated. Supports lifecycle history tracking per VREQ-007.']
  role_category varchar [note: 'Broad grouping of the role type for reporting and routing: principal (buyer/seller/borrower), service_provider (agent/attorney/notary), lender, government, or other.']
  role_notes varchar [note: 'Free-text notes or instructions specific to this party\'s role on the order (e.g., special handling instructions, POA limitations, trust restrictions). Not for NPPI.']
  role_sequence varchar [note: 'Ordinal position when multiple parties share the same role type on a single order (e.g., co-buyer 1, co-buyer 2). Enables ordered display and processing of co-principals.']
  role_source_system varchar [note: 'Originating system from which this party-role assignment was created or imported (e.g., title production system, CRM/order routing platform, lender portal, agency management system).']
  role_status varchar [note: 'Current lifecycle state of this party-role assignment. Supports lifecycle transition tracking per VREQ-007 (active, inactive, superseded, withdrawn, pending).']
  role_type varchar [note: 'Contextual role the party holds on this title order (e.g., buyer, seller, borrower, lender, trustee, agent). One party may hold multiple simultaneous roles per VREQ-006.']
  source_system_ref varchar [note: 'External identifier for this party-role record in the originating system of record (e.g., SoftPro party ID, Qualia contact ID, CRM contact ID). Supports cross-system reconciliation.']
  spouse_consent_required boolean [note: 'Indicates whether spousal consent or joinder is required for this party\'s role in the transaction, based on marital status and state community property or homestead laws.']
  submission_date date [note: 'Date this party-role assignment record was submitted into the title production system. Distinct from execution, effective, acceptance, and recording dates per VREQ-008.']
  trid_disclosure_required boolean [note: 'Indicates whether TRID disclosures (Loan Estimate / Closing Disclosure) must be provided to this party in this role. Typically true for borrower parties on covered loan transactions.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this party-role assignment record. Supports change detection and audit trail per VREQ-007.']
  vesting_type varchar [note: 'Form of title ownership vesting for this party on the subject property (e.g., joint tenancy, tenancy in common, community property, trust). Populated when is_vesting_party is true.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Association entity assigning a party (party_id) to a specific contextual role on a specific title_order, enabling one party to hold multiple simultaneous roles (e.g., buyer and borrower, or seller and trustee) per VREQ-006.'
}

Table ti_operations.title_search {
  title_search_id varchar [pk, note: 'Unique surrogate identifier for the title search record. Primary key for the title_search entity within the operations domain.']
  abstractor_party_id varchar [note: 'Foreign key linking to operations.party. Business justification: Links the title search to the party master for the abstractor who performed the search. Currently abstractor_name is stored as STRING (denormalized).']
  jurisdiction_id varchar [note: 'Foreign key linking to recording.jurisdiction. Business justification: Searches are performed against specific county recording offices. Jurisdiction determines plant coverage dates, recording fees, erecording capability, and turnaround times.']
  legal_description_id varchar [note: 'Reference to the legal description record used as the search boundary for this title search. Ensures search scope is tied to the correct metes-and-bounds or PLSS description.']
  parcel_id varchar [note: 'Reference to the parcel record against which this title search was executed. Supports chain-of-title assembly and property-level search history.']
  prior_search_title_search_id varchar [note: 'Reference to a prior title search on the same property or order, enabling update search linkage and chain-of-search provenance. Null for initial full searches.']
  title_order_id varchar [note: 'Reference to the parent title order that initiated this search. Links the search to the order lifecycle and channel routing context.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor. Used to locate the parcel in county tax and recorder indexes during the title search.']
  cancellation_reason varchar [note: 'Free-text or coded reason for search cancellation (e.g., order withdrawn, duplicate order, property changed). Populated only when search_status is cancelled.']
  cancelled_timestamp timestamp [note: 'Date and time the title search was cancelled, if applicable. Null when search was not cancelled. Supports cancellation rate and reason analysis.']
  completed_timestamp timestamp [note: 'Date and time the title search results were returned and marked complete. Used to calculate actual search turnaround time against SLA targets.']
  cot_break_description varchar [note: 'Narrative description of the chain-of-title break identified, including the gap period and missing instrument type. Populated only when cot_break_detected is True.']
  cot_break_detected boolean [note: 'Indicates whether a break in the chain of title was identified during this search. True triggers escalation to examination and curative processing.']
  cot_start_year varchar [note: 'Earliest year from which the chain-of-title was assembled in this search. Supports COT completeness and break detection metrics.']
  created_timestamp timestamp [note: 'Date and time this title search record was first created in the data platform. Audit timestamp for data lineage and record provenance.']
  easement_found boolean [note: 'Indicates whether one or more easements (ROW, utility, access) were identified during the search. Easements are typically carried as Schedule B-II exceptions.']
  encroachment_found boolean [note: 'Indicates whether an encroachment was identified during the search (e.g., from survey or prior instrument). May require survey endorsement or curative action.']
  gap_period_end_date date [note: 'End date of the gap period, typically the actual recording date. Null until recording is confirmed. Supports gap coverage period duration and risk metrics.']
  gap_period_start_date date [note: 'Start date of the gap period between the search cutoff date and the anticipated recording date. Used to assess gap coverage risk and coordinate with the recording team.']
  hoa_lien_found boolean [note: 'Indicates whether a homeowners association (HOA) lien or delinquent assessment was identified during the search. Requires payoff letter or clearance before closing.']
  instrument_count varchar [note: 'Total number of recorded instruments (deeds, mortgages, liens, releases, etc.) identified and indexed during this title search. Supports evidence completeness metrics.']
  is_automated_search boolean [note: 'Indicates whether the search was executed via an automated title plant system (e.g., DataTrace automated pull) versus a manual abstractor. Supports quality and cost analytics.']
  is_sla_breached boolean [note: 'Indicates whether the title search exceeded its SLA target hours. True when completed_timestamp minus ordered_timestamp exceeds sla_hours_target.']
  lis_pendens_found boolean [note: 'Indicates whether a lis pendens (LP) was identified against the property during the search. True requires underwriting review before commitment issuance.']
  open_judgment_count varchar [note: 'Number of open judgment liens against the property or vested owners identified during the search. Distinct from tax and mechanics liens for underwriting triage.']
  open_lien_count varchar [note: 'Number of open or unresolved liens (tax, mechanics, judgment, HOA) identified during the search. Feeds unresolved defect and lien aging metrics.']
  ordered_date date [note: 'Calendar date on which the title search was ordered or requested. Used as the start point for search turnaround and SLA cycle-time measurement.']
  ordered_timestamp timestamp [note: 'Precise date and time the title search was ordered. Supports intraday SLA tracking and search queue prioritization in the title production system.']
  plant_coverage_from_date date [note: 'Earliest date covered by the title plant or public-record index used in this search. Defines the start of the chain-of-title (COT) period examined.']
  plant_coverage_to_date date [note: 'Latest date covered by the title plant or public-record index used in this search. Defines the end of the COT period and the effective search cutoff.']
  prior_deed_type varchar [note: 'Type of the most recent vesting deed identified in the chain of title (WD, SWD, QCD, grant deed, trustee deed). Informs underwriting risk and coverage scope.']
  revision_number varchar [note: 'Sequential revision counter for this search record. Incremented when a search is updated or supplemented. Supports lifecycle history and revision frequency metrics.']
  search_fee_amount decimal(12,2) [note: 'Dollar amount charged by the search vendor or abstractor for this title search. Used for vendor cost tracking, settlement statement line items, and profitability analysis.']
  search_fee_currency varchar [note: 'ISO 4217 three-letter currency code for the search fee amount. Defaults to USD for domestic transactions; retained for multi-currency reporting consistency.']
  search_from_date date [note: 'Start date of the title search period as specified in the search order. May differ from plant coverage dates when a specific lookback period is requested.']
  search_number varchar [note: 'Externally visible, human-readable identifier assigned to this title search by the title production system (e.g., SoftPro, RamQuest). Used in correspondence and audit trails.']
  search_purpose varchar [note: 'Transaction type driving the search request: purchase, refinance, HELOC, construction, commercial, or equity loan. Aligns search scope with underwriting requirements.']
  search_result_document_ref varchar [note: 'Reference identifier or URL to the search result package stored in the document management and imaging system. Supports evidence completeness and provenance tracking.']
  search_source_type varchar [note: 'Indicates whether the search was performed against a title plant, direct public records, an automated search engine, manual abstractor review, or a hybrid combination.']
  search_status varchar [note: 'Current lifecycle status of the title search. Drives clearance cycle-time metrics and search aging dashboards. [ENUM-REF-CANDIDATE: ordered|in_progress|completed|cancelled|on_hold|failed — promote to reference product]']
  search_to_date date [note: 'End date of the title search period as specified in the search order. Represents the effective date through which public records were reviewed.']
  search_type varchar [note: 'Classification of the search scope: full chain-of-title, update, Ownership and Encumbrance (O&E) report, two-owner, 30-year, or current-owner. Determines depth of plant/public-record review.']
  search_vendor_code varchar [note: 'Code identifying the title plant or search vendor used to execute this search (e.g., DataTrace, TitlePoint, county plant). Supports vendor performance and cost tracking.']
  search_vendor_name varchar [note: 'Full name of the title plant or search vendor that performed the search (e.g., DataTrace, TitlePoint). Retained for display and reporting when vendor code alone is insufficient.']
  sla_due_date date [note: 'Contractual or operational due date by which the title search must be completed. Derived from ordered_date plus channel SLA hours; stored for direct SLA breach detection.']
  sla_hours_target varchar [note: 'Number of business hours within which the search must be completed per the applicable channel or product SLA. Enables SLA compliance reporting.']
  source_system_search_code varchar [note: 'Native identifier for this search record in the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Supports system-of-record traceability.']
  tax_lien_found boolean [note: 'Indicates whether a federal or state tax lien was identified against the property or vested owner during the search. Triggers requirement for payoff or release.']
  ucc_filing_found boolean [note: 'Indicates whether a UCC filing was identified against the property or owner during the search. Relevant for commercial transactions and fixture filings.']
  vesting_deed_instrument_number varchar [note: 'County recorder instrument number for the most recent vesting deed. Provides direct reference to the recorded instrument for evidence and provenance.']
  vesting_deed_recording_date date [note: 'Date the most recent vesting deed was recorded in the county recorder\'s office. Establishes the effective date of current ownership in the chain of title.']
  vesting_grantee_name varchar [note: 'Name of the grantee (current vested owner) on the most recent vesting deed. Must match the seller/borrower identity for commitment issuance.']
  vesting_grantor_name varchar [note: 'Name of the grantor on the most recent vesting deed as found in the grantor-grantee index. Used to verify current ownership and identify potential title defects.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Legally and operationally distinct entity representing the execution of a title search against public records and the title plant for a specific order. Captures search type (full, update, O&E, two-owner, 30-year), search vendor or plant source (DataTrace'
}

Table ti_operations.operations_title_examination {
  operations_title_examination_id varchar [pk, note: 'Unique surrogate primary key for the title examination record within the operations domain. Globally unique identifier for this examiner review event.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Title examinations performed by agent staff require agent context for oversight reviews, audit sampling, examiner quality tracking, and regulatory compliance.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Title examiners analyze specific legal description versions to identify defects, chain-of-title breaks, and boundary issues.']
  party_id varchar [note: 'Reference to the party record for the title examiner responsible for this examination. Supports examiner workload, performance, and cycle-time analytics.']
  prior_exam_operations_title_examination_id varchar [note: 'Reference to a prior title examination record this examination updates or supersedes. Supports lifecycle revision history and bring-down examination traceability per VREQ-007.']
  title_order_id varchar [note: 'Reference to the parent title order for which this examination was performed. Links the examination to the originating transaction spine.']
  title_search_id varchar [note: 'Reference to the title search whose results are being examined. Preserves the legally distinct relationship between search assembly and examiner review.']
  cot_break_description varchar [note: 'Narrative description of the chain-of-title break identified, including the time period affected and the nature of the gap (missing deed, unrecorded conveyance, etc.).']
  cot_break_detected boolean [note: 'Indicates whether the examiner identified a break or gap in the chain-of-title during this examination. Directly supports chain-of-title break metrics per VREQ-016.']
  cot_start_date date [note: 'Earliest date in the chain-of-title reviewed during this examination. Establishes the historical depth of the title review for marketability analysis.']
  county_name varchar [note: 'Name of the county or jurisdiction in which the subject property is located. Determines applicable recording requirements and county plant search standards.']
  created_timestamp timestamp [note: 'Date and time when this title examination record was first created in the data platform. Audit control field for record provenance.']
  defect_count varchar [note: 'Total number of title defects, clouds, or encumbrances identified during this examination. Supports unresolved defect and lien metrics per VREQ-016.']
  easement_count varchar [note: 'Number of easements, rights-of-way (ROW), or CC&Rs identified during the examination. Supports encumbrance completeness and Schedule B-II exception population.']
  effective_date date [note: 'Date through which the title examination is effective, i.e., the date to which the chain-of-title was examined. Distinct from examination_date per VREQ-008.']
  evidence_completeness_flag boolean [note: 'Indicates whether all required supporting evidence (deeds, releases, satisfactions, court orders) was available and reviewed during the examination. Supports evidence completeness metrics per VREQ-016.']
  examination_complete_timestamp timestamp [note: 'Precise date and time when the examiner marked the examination complete or referred it. Paired with start timestamp to compute examination cycle time.']
  examination_date date [note: 'Calendar date on which the title examiner completed or substantially performed the examination review. Principal business event date for cycle-time measurement.']
  examination_number varchar [note: 'Externally visible alphanumeric identifier assigned to this examination by the title production system (e.g., SoftPro/RamQuest exam module). Used for cross-system traceability.']
  examination_start_timestamp timestamp [note: 'Precise date and time when the examiner began the title examination in the production system. Used to calculate examination duration and SLA compliance.']
  examination_status varchar [note: 'Current lifecycle state of the title examination. Drives workflow routing: in_progress (active review), complete (exam finished), referred (sent to underwriter), on_hold, cancelled.']
  examination_type varchar [note: 'Classification of the examination scope: full chain-of-title review, update/bring-down of prior exam, O&E (Ownership and Encumbrance) report, or gap period review.']
  examiner_license_number varchar [note: 'State-issued license or certification number of the title examiner, where applicable. Supports regulatory compliance and examiner qualification tracking.']
  examiner_name varchar [note: 'Full name of the title examiner who performed the review, captured at time of examination for historical accuracy independent of party record changes.']
  examiner_notes varchar [note: 'Free-text narrative notes entered by the title examiner summarizing findings, concerns, or curative recommendations not captured in structured fields.']
  exception_count varchar [note: 'Total number of Schedule B-II exceptions identified during this examination. Supports unresolved exception and underwriting referral rate metrics.']
  fips_code varchar [note: 'Five-digit FIPS code identifying the county of the subject property. Used for jurisdiction-level reporting, plant access, and regulatory reporting alignment.']
  gap_coverage_required boolean [note: 'Indicates whether the examiner identified a gap period requiring gap coverage (GAPcure) between the search-through date and the anticipated recording date.']
  judgment_lien_detected boolean [note: 'Indicates whether a judgment lien against the current owner or a prior owner was identified during the examination. Requires curative action before policy issuance.']
  lien_count varchar [note: 'Total number of open liens (tax, mechanics, judgment, HOA, HELOC, etc.) identified during the examination. Supports unresolved lien metrics per VREQ-016.']
  lis_pendens_detected boolean [note: 'Indicates whether a lis pendens (LP) was identified during the examination, signaling pending litigation affecting the property title.']
  mers_lien_detected boolean [note: 'Indicates whether a MERS-registered mortgage or deed of trust was identified during the examination, requiring MERS-specific curative or release procedures.']
  missing_evidence_description varchar [note: 'Narrative description of any evidence items that were unavailable or incomplete at the time of examination, supporting evidence provenance tracking per VREQ-016.']
  open_lien_amount decimal(18,2) [note: 'Aggregate dollar amount of all open liens identified during the examination. Supports lien severity and underwriting risk assessment. Currency: USD.']
  property_state_code varchar [note: 'Two-letter USPS state code for the property jurisdiction. Determines applicable state title standards, examination requirements, and regulatory framework.']
  requirement_count varchar [note: 'Total number of Schedule B-I requirements raised by this examination. Supports open and aging title requirements metrics per VREQ-016.']
  revision_number varchar [note: 'Sequential revision counter for this examination record. Increments when the examination is updated or superseded, preserving the full revision history per VREQ-007.']
  revision_reason varchar [note: 'Narrative explanation for why this examination was revised or superseded (e.g., new search results received, additional instruments found, examiner correction).']
  search_through_date date [note: 'The date through which the underlying title search was run and upon which the examination is based. Defines the temporal boundary of the chain-of-title reviewed.']
  source_system_exam_code varchar [note: 'Native identifier for this examination record in the originating title production system (SoftPro, RamQuest, Qualia). Enables cross-system reconciliation and audit traceability.']
  tax_lien_detected boolean [note: 'Indicates whether a federal, state, or local tax lien was identified during the examination. Triggers curative requirement and potential underwriting referral.']
  title_opinion varchar [note: 'Examiner\'s overall title opinion resulting from the examination: marketable, insurable, uninsurable, conditional (subject to requirements), or defective. Core underwriting input.']
  transaction_type varchar [note: 'Type of real estate transaction for which this examination was performed. Contextualizes the examination scope and applicable title standards.']
  updated_timestamp timestamp [note: 'Date and time when this title examination record was last modified in the data platform. Audit control field for change tracking and incremental load processing.']
  uw_referral_reason varchar [note: 'Narrative reason the examiner flagged this examination for underwriter review (e.g., unresolved lien, COT break, high-risk encumbrance, complex easement).']
  uw_referral_required boolean [note: 'Flag indicating the examiner determined this examination requires underwriter review before a commitment can be issued. Drives underwriting referral rate metrics.']
  vesting_deed_type varchar [note: 'Type of deed by which current ownership is vested as identified during examination (WD, SWD, QCD, etc.). Informs title insurability and Schedule A vesting language.']
  vesting_description varchar [note: 'Narrative description of how title is currently vested (e.g., joint tenancy, tenancy in common, community property, trust). Populates Schedule A of the commitment.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Legally and operationally distinct entity representing the examiner\'s review and analysis of search results for a specific title order. Captures examiner identity, examination date, examination status (in-progress, complete, referred), overall title'
}

Table ti_operations.order_status_history {
  order_status_history_id varchar [pk, note: 'Unique surrogate identifier for each status transition record in the title order lifecycle history. Primary key of this append-only event log.']
  agent_profile_id varchar [note: 'Reference to the independent title agent profile associated with this order at the time of this transition. Populated for orders produced through the independent agent channel.']
  party_id varchar [note: 'Application user ID or system service account identifier that initiated this status transition. Used for audit trail and accountability tracking.']
  recording_submission_id varchar [note: 'Foreign key linking to recording.recording_submission. Business justification: Order status transitions often triggered by recording events (submission accepted, rejected, recorded). Tracks recording impact on order lifecycle per VREQ-007.']
  source_event_order_status_history_id varchar [note: 'Unique event or transaction identifier from the originating Title Production System (SoftPro/RamQuest/Qualia) for this status change. Supports lineage and deduplication.']
  title_order_id varchar [note: 'Reference to the title order whose status changed. Links this history record to the parent title order entity.']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record associated with this status transition, if applicable. Links to the uw_referral entity in the underwriting domain.']
  channel_type varchar [note: 'Production channel through which the title order was received at the time of this transition. Supports SLA and cycle-time analysis by channel.']
  closing_readiness_status varchar [note: 'Operational assessment of the order\'s readiness to proceed to closing at the time of this transition. Supports closing readiness metrics per VREQ-016.']
  commitment_revision_number varchar [note: 'Revision number of the title commitment in effect at the time of this status transition. Supports commitment revision frequency metrics per VREQ-016.']
  cot_break_identified boolean [note: 'Indicates whether a chain-of-title break was identified at or before this status transition. Supports chain-of-title break metrics per VREQ-016.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county jurisdiction for this title order at the time of this transition. Used for recording jurisdiction and regulatory reporting.']
  created_timestamp timestamp [note: 'Timestamp when this status history record was first written to the Silver layer. Audit field for data lineage and ETL traceability.']
  duration_in_prior_status_hours decimal(10,2) [note: 'Number of hours the title order spent in the prior_status before this transition. Supports clearance cycle-time and stage-level throughput analytics.']
  erecording_enabled boolean [note: 'Indicates whether electronic recording via an eRecording gateway (e.g., Simplifile, CSC) was enabled for this order at the time of this transition.']
  escrow_officer_name varchar [note: 'Name of the escrow officer assigned to this title order at the time of this status transition. Denormalized for operational reporting without requiring a party join.']
  gap_coverage_required boolean [note: 'Indicates whether gap coverage was required for this order at the time of this status transition, covering the period between search and recording.']
  is_current boolean [note: 'Indicates whether this record represents the most recent status of the title order. Facilitates efficient current-state queries without full history scan.']
  is_regression boolean [note: 'Indicates whether this transition represents a backward movement in the title order lifecycle (e.g., from cleared_to_close back to requirements_open). Flags rework events.']
  new_status varchar [note: 'Status of the title order after this transition. Represents the current state entered at this point in the lifecycle. [ENUM-REF-CANDIDATE']
  notes varchar [note: 'Free-text operational notes recorded by the user or system at the time of this status transition. Provides additional context beyond the reason code and description.']
  open_finding_count varchar [note: 'Number of unresolved title findings (defects, liens, encumbrances) at the time of this status transition. Supports unresolved defects and liens metrics.']
  open_requirement_count varchar [note: 'Number of open Schedule B-I title requirements at the time of this status transition. Supports open and aging title requirements metrics per VREQ-016.']
  order_number varchar [note: 'Human-readable title order number from the Title Production System (e.g., SoftPro/RamQuest/Qualia) at the time of this transition. Denormalized for audit traceability.']
  policy_exception_required boolean [note: 'Indicates whether a policy exception was required at this status transition point. Supports underwriting exception rate metrics per VREQ-016.']
  prior_status varchar [note: 'Status of the title order immediately before this transition. Null for the initial intake record. [ENUM-REF-CANDIDATE']
  regression_reason_code varchar [note: 'Standardized code explaining why a backward status transition occurred. Populated only when is_regression is true. Supports curative action aging and rework analysis.']
  ron_enabled boolean [note: 'Indicates whether Remote Online Notarization was enabled for this order at the time of this status transition.']
  sequence_number varchar [note: 'Monotonically increasing sequence number of this transition within the title order\'s lifecycle history. Enables ordered reconstruction of the full status timeline.']
  sla_breach_hours decimal(10,2) [note: 'Number of hours by which the SLA was exceeded for this status stage. Null if SLA was met. Used for aging and SLA severity reporting.']
  sla_breached boolean [note: 'Indicates whether the SLA target for this status stage was breached. Set to true when the order remained in the new status beyond sla_due_timestamp.']
  sla_due_timestamp timestamp [note: 'Calculated deadline timestamp by which the order must exit the new status to meet SLA. Derived from transition_timestamp plus sla_target_hours at write time.']
  sla_target_hours decimal(10,2) [note: 'The contracted or configured SLA target in hours for completing the new status stage. Used to measure on-time performance and clearance cycle-time compliance.']
  state_code varchar [note: 'Two-letter US state code for the jurisdiction governing this title order at the time of this transition. Denormalized for state-level SLA and regulatory reporting.']
  title_examiner_name varchar [note: 'Name of the title examiner assigned to this order at the time of this status transition. Supports examiner workload and cycle-time performance analytics.']
  transaction_type varchar [note: 'Classification of the real estate transaction type at the time of this status transition. Denormalized for lifecycle analytics segmented by transaction type.']
  transition_reason_code varchar [note: 'Standardized code identifying the business reason or trigger for this status transition. Supports workflow analytics and SLA root-cause reporting. [ENUM-REF-CANDIDATE']
  transition_reason_description varchar [note: 'Free-text narrative explaining the reason for the status transition, entered by the user or system. Supplements the reason code with operational context.']
  transition_timestamp timestamp [note: 'Exact date and time (with timezone offset) when the status transition occurred. Principal event time for SLA measurement and clearance cycle-time analytics.']
  triggered_by_system varchar [note: 'Name of the operational system that originated this transition event (e.g., SoftPro Select, RamQuest, Qualia, eRecording Gateway, CRM). Supports provenance tracking.']
  triggered_by_type varchar [note: 'Indicates whether the status transition was initiated by a human user, an automated system process, an external integration, a scheduled job, or an underwriter action.']
  triggered_by_user_name varchar [note: 'Display name of the user or system process that triggered this transition. Denormalized for audit readability without requiring a join to user directory.']
  updated_timestamp timestamp [note: 'Timestamp when this status history record was last modified in the Silver layer. Supports incremental load detection and audit trail maintenance.']
  uw_referral_required boolean [note: 'Indicates whether an underwriting referral was required as part of or triggering this status transition. Supports underwriting referral and exception rate metrics.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Lifecycle history entity that preserves every status transition of a title order from intake through closing and post-closing. Captures prior status, new status, transition timestamp, triggering user or system, transition reason code, and any SLA'
}

Table ti_operations.operations_curative_action {
  operations_curative_action_id varchar [pk, note: 'Unique surrogate identifier for each curative action record within the title production operations domain. Primary key for this entity.']
  assigned_to_party_id varchar [note: 'Reference to the party (curative specialist, title examiner, or external vendor) responsible for executing this curative action. Supports workload and aging analysis.']
  easement_restriction_id varchar [note: 'Foreign key linking to property.easement_restriction. Business justification: Curative actions address easement and restriction issues (missing releases, ambiguous language, encroachments, HOA violations).']
  encumbrance_id varchar [note: 'Foreign key linking to property.encumbrance. Business justification: Curative actions resolve specific encumbrances (mortgages, judgments, tax liens). Processors track payoff demands, release instruments, and satisfaction recordings per encumbrance.']
  operations_title_examination_id varchar [note: 'Reference to the title examination during which the defect or requirement necessitating this curative action was identified.']
  recording_submission_id varchar [note: 'Foreign key linking to recording.recording_submission. Business justification: Curative actions often result in resubmissions after recording rejection (corrected docs, additional signatures). Tracks curative-to-resubmission cycle time per VREQ-016.']
  title_evidence_id varchar [note: 'Reference to the document management record containing the curative evidence (e.g., recorded release, satisfaction, affidavit) that proves the defect has been cleared.']
  title_finding_id varchar [note: 'Reference to the title examination finding (defect, lien, encumbrance, or cloud on title) that triggered this curative action, if applicable.']
  title_order_id varchar [note: 'Reference to the parent title order under which this curative action is being performed. Links the curative step to the originating transaction.']
  title_requirement_id varchar [note: 'Reference to the Schedule B-I title requirement or defect that this curative action is intended to clear. Owned by the underwriting domain.']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record created when this curative action was escalated to the underwriter for risk review and approval.']
  action_notes varchar [note: 'Free-text operational notes entered by the curative specialist documenting correspondence, status updates, obstacles, and resolution details for this curative action.']
  action_number varchar [note: 'Externally visible, human-readable identifier for this curative action (e.g., CA-2024-00123). Used in correspondence, tracking, and curative processing memos (CPM).']
  action_status varchar [note: 'Current lifecycle state of the curative action. Drives clearance cycle-time metrics and closing readiness dashboards. Transitions: open → in_progress → pending_receipt → completed or waived.']
  action_type varchar [note: 'Classification of the curative step required to clear the defect or requirement. Examples include obtain release, record reconveyance, obtain payoff, record satisfaction, obtain affidavit.']
  clearance_method varchar [note: 'Method by which the title defect or requirement was ultimately cleared. Supports curative action effectiveness analysis and underwriting exception rate metrics per VREQ-016.']
  completed_date date [note: 'Calendar date on which the curative action was marked complete and the associated requirement or defect was cleared. Null if not yet completed.']
  cot_break_indicator boolean [note: 'Indicates whether this curative action is specifically addressing a chain-of-title break (gap in the grantor-grantee index or missing conveyance). Supports COT break metrics per VREQ-016.']
  created_timestamp timestamp [note: 'Timestamp when this curative action record was first created in the title production system. Audit field supporting record provenance and lifecycle tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for monetary amounts on this curative action record. Typically USD for domestic US title transactions.']
  days_open varchar [note: 'Number of calendar days this curative action has been open as of the last update. Stored for aging bucket reporting; supports open and aging title requirements metrics per VREQ-016.']
  defect_severity varchar [note: 'Underwriter-assigned severity rating of the title defect being cured. Critical defects block commitment issuance; high defects require UW referral; medium and low may be handled operationally.']
  defect_type varchar [note: 'Classification of the underlying title defect or encumbrance being cured (e.g., tax lien, mechanics lien, judgment lien, lis pendens, HOA lien, unreleased mortgage, chain-of-title break).']
  due_date date [note: 'Target date by which this curative action must be completed to support the scheduled closing date. Drives SLA monitoring and closing readiness metrics.']
  erecording_used boolean [note: 'Indicates whether the curative instrument was submitted via electronic recording (eRecording) gateway (e.g., Simplifile, CSC eRecording) rather than physical submission.']
  escalated_date date [note: 'Date on which this curative action was escalated to underwriting, management, or legal due to inability to clear within standard processing. Null if not escalated.']
  evidence_received boolean [note: 'Indicates whether the documentary evidence required to confirm clearance of the defect or requirement has been received and imaged into the document management system.']
  evidence_received_date date [note: 'Date on which the curative evidence document was received and confirmed by the title operations team. Supports evidence completeness and provenance metrics per VREQ-016.']
  fips_code varchar [note: 'Five-digit FIPS code identifying the county jurisdiction for recording the curative instrument. Used for jurisdiction routing and regulatory reporting.']
  gap_coverage_required boolean [note: 'Indicates whether gap coverage is required for this curative action due to the period between the effective date of the title search and the recording of the insured instrument.']
  instrument_acceptance_date date [note: 'Date the county recorder or relevant authority accepted the curative instrument for recording. Distinct from execution, effective, submission, and recording dates per VREQ-008.']
  instrument_effective_date date [note: 'Date the curative instrument becomes legally effective, which may differ from execution or recording date. Distinct from execution, submission, acceptance, and recording dates per VREQ-008.']
  instrument_execution_date date [note: 'Date the curative instrument (release, reconveyance, satisfaction, etc.) was signed or executed by the relevant party. Distinct from effective, submission, acceptance, and recording dates per VREQ-008.']
  instrument_recording_date date [note: 'Date the curative instrument was officially recorded in the public record by the county recorder. Distinct from execution, effective, submission, and acceptance dates per VREQ-008.']
  instrument_reference_number varchar [note: 'Recording number, document number, or external reference identifier of the instrument obtained or recorded as part of this curative action. Supports evidence provenance tracking.']
  instrument_submission_date date [note: 'Date the curative instrument was submitted to the county recorder or relevant authority for recording or filing. Distinct from execution, effective, acceptance, and recording dates per VREQ-008.']
  instrument_type varchar [note: 'Type of legal instrument required or obtained to cure the defect (e.g., release, reconveyance, satisfaction, subordination, affidavit, court order, deed). [ENUM-REF-CANDIDATE']
  lienholder_loan_number varchar [note: 'Loan or account number assigned by the lienholder to the obligation being cured. Used to obtain payoff demands and track correspondence with the lienholder.']
  lienholder_name varchar [note: 'Name of the lienholder, creditor, or encumbrancer whose interest must be released or satisfied as part of this curative action (e.g., lender, taxing authority, HOA, judgment creditor).']
  mers_min varchar [note: '18-digit MERS Mortgage Identification Number for the mortgage or deed of trust being released or reconveyed as part of this curative action, if registered with MERS.']
  opened_date date [note: 'Calendar date on which this curative action was opened and assigned. Used as the start point for curative action aging and clearance cycle-time calculations.']
  payoff_amount decimal(18,2) [note: 'Dollar amount required to satisfy and release the lien, mortgage, or encumbrance being cured. Applicable for payoff-type curative actions. Classified confidential due to financial sensitivity.']
  payoff_good_through_date date [note: 'Expiration date of the payoff quote obtained from the lienholder. After this date, a new payoff demand must be obtained before disbursement.']
  prior_action_status varchar [note: 'Previous lifecycle status of this curative action before the most recent status transition. Preserves material lifecycle transitions per VREQ-007 for audit and revision history.']
  priority varchar [note: 'Operational priority assigned to this curative action, reflecting closing timeline urgency. Rush items are tracked for SLA breach risk and closing readiness reporting.']
  recording_jurisdiction varchar [note: 'County and state jurisdiction where the curative instrument was or will be recorded (e.g., \'Cook County, IL\'). Used for eRecording routing and recording fee calculation.']
  responsible_party_role varchar [note: 'Role of the party assigned to execute this curative action within the title production workflow. Supports contextual role assignment per VREQ-006.']
  sla_breached boolean [note: 'Indicates whether this curative action exceeded its SLA target days without completion. True when days_open exceeds sla_target_days and action_status is not completed or waived.']
  sla_target_days varchar [note: 'Maximum number of calendar days allowed to complete this curative action per the applicable service level agreement or internal processing standard.']
  status_changed_timestamp timestamp [note: 'Timestamp of the most recent status transition for this curative action. Supports lifecycle history preservation per VREQ-007 and SLA breach detection.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this curative action record in the title production system. Supports incremental data loading and audit trail maintenance.']
  uw_referral_required boolean [note: 'Indicates whether this curative action requires escalation to the underwriter for approval before the associated requirement can be waived or the defect insured over.']
  waived_date date [note: 'Date on which the requirement or defect was formally waived by the underwriter, allowing the transaction to proceed without full cure. Null if not waived.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Operational entity tracking each curative step taken to clear a title requirement or defect identified during examination. Captures the linked title requirement (owned by underwriting domain), curative action type (obtain release, record reconveyance'
}

Table ti_operations.order_channel {
  order_channel_id varchar [pk, note: 'Unique surrogate identifier for each order origination and routing channel record. Primary key for the order_channel reference master. [REFERENCE_LOOKUP: canonical_skip_reason — this entity is a REFERENCE_LOOKUP classifying origination channels; per-role']
  affiliated_business_arrangement boolean [note: 'Indicates whether this channel involves an affiliated business arrangement as defined under RESPA Section 8(c)(4). True = AfBA disclosure required at order intake. Supports regulatory compliance tracking.']
  channel_category varchar [note: 'Broader grouping of channels for management reporting: retail (branch/consumer), institutional (lender/wholesale), agency (independent agent), or digital (online/consumer-direct). Supports segment-level performance analysis.']
  channel_code varchar [note: 'Short, system-recognized alphanumeric code uniquely identifying the channel (e.g., DIR_BRANCH, CENT_LENDER, IND_AGENT, CONS_DIRECT, WHOLESALE). Used as the operational lookup key in title production and CRM routing systems.']
  channel_description varchar [note: 'Free-text narrative describing the channel\'s business purpose, scope, and operational characteristics. Used for onboarding documentation and internal reference.']
  channel_name varchar [note: 'Human-readable business name of the origination channel (e.g., \'Direct Branch\', \'Centralized Lender\', \'Independent Agent\', \'Consumer Direct\', \'Wholesale\'). Displayed in dashboards, reports, and order intake screens.']
  channel_owner_email varchar [note: 'Business email address of the internal channel owner. Used for operational notifications, SLA breach alerts, and governance communications. Classified confidential as internal business contact.']
  channel_owner_name varchar [note: 'Name of the internal business owner or manager responsible for this channel\'s performance, configuration, and compliance. Used for escalation routing and governance accountability.']
  channel_status varchar [note: 'Current operational lifecycle status of the channel record. \'active\' channels accept new orders; \'inactive\' are retired; \'suspended\' are temporarily halted; \'pending\' are awaiting activation approval.']
  channel_type varchar [note: 'High-level classification of the channel: direct (branch-originated), lender (centralized lender channel), agent (independent title agent), consumer (consumer-direct), or wholesale. Drives routing logic and SLA assignment.']
  closing_disclosure_form_type varchar [note: 'Settlement statement form type required for closings through this channel: cd (Closing Disclosure / TRID), hud1 (HUD-1 for pre-TRID or exempt transactions), alta_ss (ALTA Settlement Statement), or none.']
  cost_center_code varchar [note: 'ERP cost center code associated with this channel for expense allocation and profitability reporting. Supports channel-level P&L analysis and management reporting.']
  created_timestamp timestamp [note: 'Timestamp when this channel record was first created in the system of record. Supports audit trail, data lineage, and record provenance tracking per ALTA Best Practices Pillar 3.']
  default_transaction_type varchar [note: 'The predominant real-estate transaction type associated with this channel (purchase, refinance, HELOC, construction, commercial). Used to pre-populate order intake forms and apply channel-specific underwriting rules.']
  effective_date date [note: 'Date on which this channel became or becomes operationally active and eligible to receive title orders. Supports effective-dated channel configuration and lifecycle history per VREQ-007.']
  erecording_enabled boolean [note: 'Indicates whether electronic recording submission is enabled for orders originating through this channel. True = eRecording via Simplifile/CSC gateway is the default submission method.']
  escrow_handling_type varchar [note: 'Indicates how escrow trust account management is handled for transactions from this channel: in_house (company escrow officer), agent_handled (independent agent manages escrow), lender_controlled, or none (no escrow).']
  expiration_date date [note: 'Date on which this channel configuration expires or is scheduled for deactivation. Null indicates no planned expiration. Supports lifecycle transition tracking and channel sunset management.']
  external_channel_ref_code varchar [note: 'External identifier for this channel as assigned by a lender, partner, or CRM system (e.g., Salesforce channel ID, lender-assigned branch code). Enables cross-system reconciliation and order traceability.']
  gl_revenue_account_code varchar [note: 'General Ledger account code to which premium revenue from orders originating through this channel is posted. Enables channel-level revenue recognition and financial reporting in the ERP/GL system.']
  iolta_required boolean [note: 'Indicates whether escrow funds for this channel must be held in an IOLTA-compliant trust account. Applies in states where attorney-conducted closings are mandatory. Supports ALTA Best Practices Pillar 1 compliance.']
  ipen_enabled boolean [note: 'Indicates whether In-Person Electronic Notarization (IPEN) closings are permitted for transactions originating through this channel. Distinct from RON; requires physical presence of notary and signer.']
  is_default_channel boolean [note: 'Indicates whether this channel is the system default when no explicit channel is specified at order intake. Only one channel should be flagged as default per production source type. Supports order routing fallback logic.']
  last_updated_timestamp timestamp [note: 'Timestamp when this channel record was most recently modified. Supports change detection, incremental ETL processing, and audit trail requirements.']
  lender_integration_type varchar [note: 'Technical integration method used for lender-channel order delivery: API (real-time), file_transfer (batch), portal (manual web entry), or none (not a lender channel). Drives automation and SLA differentiation.']
  lender_platform_name varchar [note: 'Name of the lender\'s loan origination system or order delivery platform (e.g., Encompass, Blend, ICE Mortgage Technology) used to transmit orders through this channel. Null for non-lender channels.']
  mers_reporting_required boolean [note: 'Indicates whether MERS registration and reporting is required for mortgage instruments originated through this channel. Applies primarily to lender and wholesale channels handling DOT/mortgage instruments.']
  nppi_data_sharing_permitted boolean [note: 'Indicates whether NPPI (SSN, TIN, bank account, wire instructions) may be shared with counterparties through this channel under applicable GLBA and state privacy agreements. False = NPPI sharing restricted.']
  order_intake_method varchar [note: 'Technical method by which orders are received through this channel: API integration, web portal, email, phone, fax, or EDI. Determines automation level and SLA baseline for order intake processing.']
  premium_split_type varchar [note: 'Indicates the premium revenue split model applicable to this channel: direct (100% retained by underwriter), agency (split with independent agent per agency agreement), or net_retained (net premium after agent remittance).']
  production_source varchar [note: 'Identifies the business production source model through which orders arrive: branch (direct office), lender_channel (centralized lender integration), independent_agent, consumer_direct, or wholesale. Aligns with ALTA production-source reporting.']
  remittance_required boolean [note: 'Indicates whether premium remittance to the underwriter is required for orders originating through this channel. True = remittance required (independent agent channels). Supports agency remittance timeliness metrics.']
  requires_agency_agreement boolean [note: 'Indicates whether orders originating through this channel require a valid independent agent agreement on file before order acceptance. True = agency agreement mandatory (applies to independent agent channels).']
  requires_cpl boolean [note: 'Indicates whether a Closing Protection Letter (CPL) must be issued for transactions originating through this channel. CPLs protect lenders against agent fraud or dishonesty. Mandatory for most lender and agent channels.']
  respa_applicable boolean [note: 'Indicates whether RESPA requirements apply to transactions originating through this channel. Governs settlement service provider disclosures, affiliated business arrangements, and kickback prohibitions.']
  ron_enabled boolean [note: 'Indicates whether Remote Online Notarization (RON) closings are permitted for transactions originating through this channel. Drives closing coordination workflow and notary assignment logic.']
  routing_priority varchar [note: 'Numeric priority rank (lower value = higher priority) used by the order routing engine to assign orders from this channel to processing queues, branches, or examiners. Supports SLA-driven workload balancing.']
  sla_commitment_hours decimal(5,2) [note: 'Maximum number of business hours from completed examination to title commitment issuance for this channel. Supports closing readiness and commitment revision frequency metrics.']
  sla_intake_hours decimal(5,2) [note: 'Maximum number of business hours allowed from order receipt to order acknowledgment/acceptance for this channel. Drives title clearance cycle-time SLA monitoring and operational reporting.']
  sla_search_hours decimal(5,2) [note: 'Maximum number of business hours from order acceptance to title search delivery for this channel. Used to measure and report title clearance cycle time by channel.']
  sox_control_applicable boolean [note: 'Indicates whether SOX internal controls over financial reporting apply to revenue and premium transactions originating through this channel. Supports ERP/GL audit trail requirements.']
  state_jurisdiction_scope varchar [note: 'Comma-delimited list of US state codes (e.g., \'CA,TX,FL\') in which this channel is authorized to originate title orders. Null or \'ALL\' indicates nationwide authorization. Supports state-level regulatory reporting.']
  supports_commercial boolean [note: 'Indicates whether this channel is authorized to originate commercial real-estate title orders. True = commercial orders accepted. Commercial orders typically require elevated underwriting referral thresholds.']
  supports_residential boolean [note: 'Indicates whether this channel is authorized to originate residential title orders (purchase, refinance, HELOC). True = residential orders accepted; False = residential orders not routed through this channel.']
  suspension_date date [note: 'Date on which this channel was suspended from accepting new orders. Null if channel has never been suspended. Preserves lifecycle transition history per VREQ-007.']
  suspension_reason varchar [note: 'Free-text explanation of why this channel was suspended (e.g., regulatory action, compliance failure, contract termination). Null if channel has never been suspended. Supports audit and lifecycle history.']
  trid_applicable boolean [note: 'Indicates whether TRID disclosure requirements (Closing Disclosure / Loan Estimate) apply to transactions originating through this channel. True for most residential purchase and refinance lender channels.']
  underwriter_referral_threshold_usd decimal(15,2) [note: 'Liability amount in USD above which orders from this channel must be referred to the underwriter for risk review. Supports underwriting referral and exception rate metrics by channel.']
  version_number varchar [note: 'Monotonically incrementing version counter for this channel record. Incremented on each configuration change. Supports lifecycle revision history and prior classification preservation per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Reference master classifying the origination and routing channels through which title orders are received and processed (direct branch, centralized lender, independent agent, consumer direct, wholesale).'
}

Table ti_operations.service_level {
  service_level_id varchar [pk, note: 'Unique surrogate identifier for a service-level agreement record defining turn-time commitments for title orders by channel, transaction type, and product tier.']
  order_channel_id varchar [note: 'Reference to the order channel (direct branch, centralized lender, independent agent) to which this service-level agreement applies.']
  approval_date date [note: 'Date on which this SLA definition was formally approved for use. Distinct from effective_date; supports lifecycle revision history per VREQ-007.']
  approved_by varchar [note: 'Name or identifier of the operations manager or executive who approved this SLA definition. Supports governance and audit trail for SLA lifecycle management.']
  breach_penalty_applicable boolean [note: 'Indicates whether a contractual penalty or credit applies when this SLA is breached. True for lender channel agreements with negotiated service credits.']
  breach_penalty_description varchar [note: 'Narrative description of the contractual penalty or service credit terms that apply upon SLA breach (e.g., fee waiver, rate reduction). Populated only when breach_penalty_applicable is true.']
  business_hours_end varchar [note: 'Local time (HH:MM, 24-hour) at which the business day ends for SLA measurement purposes (e.g., \'17:00\'). Used in conjunction with business_hours_start for cycle-time calculations.']
  business_hours_start varchar [note: 'Local time (HH:MM, 24-hour) at which the business day begins for SLA measurement purposes (e.g., \'08:00\'). Used to calculate business-hour turn-time compliance.']
  channel_type varchar [note: 'Production channel category for which this SLA is defined: direct branch, centralized lender, or independent agent. Mirrors the channel routing model in the CRM/order routing platform.']
  closing_disclosure_form_type varchar [note: 'Settlement statement form type required for closings under this SLA: Closing Disclosure (CD), HUD-1, ALTA Settlement Statement (ALTA SS), or custom. Driven by TRID/RESPA applicability.']
  closing_readiness_hours_target varchar [note: 'Maximum number of business hours from cleared requirements to confirmed closing readiness (CD/HUD-1/ALTA settlement statement prepared). Supports closing readiness metrics per VREQ-016.']
  commitment_form_type varchar [note: 'ALTA commitment form version or state-specific form required for commitments issued under this SLA (e.g., ALTA 2021, ALTA 2016). Governs Schedule A, B-I, B-II structure.']
  commitment_hours_target varchar [note: 'Maximum number of business hours from examination completion to issuance of the title commitment (Schedule A, B-I, B-II). Drives commitment revision frequency metrics.']
  cpl_required boolean [note: 'Indicates whether a Closing Protection Letter (CPL) must be issued to the lender for orders governed by this SLA. Typically required for centralized lender and independent agent channels.']
  created_timestamp timestamp [note: 'Timestamp when this service-level record was first created in the title production system. Audit field supporting SLA lifecycle and revision history tracking per VREQ-007.']
  curative_hours_target varchar [note: 'Maximum number of business hours allocated for curative action processing and clearance of Schedule B-I requirements. Supports curative action aging and effectiveness metrics.']
  effective_date date [note: 'Date on which this service-level agreement becomes binding and applicable to new title orders. Distinct from the record creation date per VREQ-008.']
  erecording_required boolean [note: 'Indicates whether eRecording via gateway (e.g., Simplifile, CSC) is required for orders under this SLA. Affects recording submission turn-time targets and rejection/resubmission tracking.']
  escalation_threshold_hours varchar [note: 'Number of business hours before the total SLA target at which an at-risk order is escalated to a supervisor or account manager. Supports proactive SLA breach prevention.']
  examination_hours_target varchar [note: 'Maximum number of business hours from search delivery to completion of title examination and defect identification. Supports open and aging title requirements metrics.']
  expiration_date date [note: 'Date on which this SLA ceases to be applicable to new orders. Null for open-ended agreements. Supports lifecycle transition tracking per VREQ-007.']
  gap_coverage_required boolean [note: 'Indicates whether gap coverage (GAP) — insuring the period between search date and recording — is required for orders governed by this SLA. Common in lender channel agreements.']
  intake_hours_target varchar [note: 'Maximum number of business hours from order receipt to confirmed order intake/acknowledgment. Supports title clearance cycle-time metrics per VREQ-016.']
  iolta_required boolean [note: 'Indicates whether escrow funds for orders under this SLA must be held in an IOLTA-compliant trust account. State bar and regulatory requirement for attorney-closing states.']
  ipen_permitted boolean [note: 'Indicates whether In-Person Electronic Notarization (IPEN) is permitted for closings governed by this SLA. Distinct from RON; state-specific authorization required.']
  lender_name varchar [note: 'Name of the lender or lender channel for which this SLA is specifically negotiated. Null for generic SLAs not tied to a specific lender. Supports lender-specific cycle-time reporting.']
  lender_platform varchar [note: 'Name of the lender integration platform (e.g., Encompass, Blend, SimpleNexus) through which orders governed by this SLA are received. Supports CRM/order routing platform alignment.']
  measurement_basis varchar [note: 'Defines whether SLA turn-time targets are measured in business hours, calendar hours, business days, or calendar days. Critical for accurate cycle-time calculation and lender reporting.']
  policy_issuance_hours_target varchar [note: 'Maximum number of business hours from recording confirmation to issuance of owner (OTP) and lender (LTP) title policies. Supports policy issuance lag after recording metric per VREQ-016.']
  product_tier varchar [note: 'Service tier classification applied to this SLA (e.g., standard, expedited, premium, bulk). Drives turn-time targets and pricing in the title production system.']
  recording_submission_hours_target varchar [note: 'Maximum number of business hours from closing to submission of documents to the county recorder/register of deeds via eRecording gateway. Supports recording rejection and resubmission rate metrics.']
  respa_applicable boolean [note: 'Indicates whether RESPA requirements (HUD-1/CD, affiliated business arrangement disclosures) apply to orders governed by this SLA.']
  ron_permitted boolean [note: 'Indicates whether Remote Online Notarization (RON) is permitted for closings governed by this SLA. State-specific; affects closing coordination and document execution workflows.']
  search_hours_target varchar [note: 'Maximum number of business hours from order intake to delivery of completed title search and chain-of-title (COT) assembly. Key metric for clearance cycle-time analysis.']
  search_type_required varchar [note: 'Minimum search type required for orders under this SLA: full chain-of-title search, two-owner search, update search, Ownership and Encumbrance (O&E) report, or title plant search.']
  search_years_required varchar [note: 'Minimum number of years of chain-of-title history required for the title search under this SLA (e.g., 40 years for full search, 2 years for two-owner). Drives evidence completeness metrics.']
  sla_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this service-level tier (e.g., SLA-REFI-LENDER-GOLD). Used in order routing and lender integration platforms.']
  sla_description varchar [note: 'Free-text narrative describing the scope, conditions, and special terms of this service-level agreement. Used for lender onboarding documentation and internal reference.']
  sla_name varchar [note: 'Human-readable name for this service-level tier (e.g., \'Lender Gold Refinance 48-Hour\'). Displayed in production system dashboards and lender-facing portals.']
  sla_status varchar [note: 'Current lifecycle state of this SLA record: active (in use), draft (pending approval), inactive (suspended), superseded (replaced by newer version), or expired (past end date).']
  sla_version varchar [note: 'Version identifier for this SLA definition, supporting lifecycle revision tracking (e.g., \'1.0\', \'2.3\'). Enables audit of prior SLA terms per VREQ-007.']
  state_jurisdiction varchar [note: 'Two-letter US state code (FIPS) for the jurisdiction to which this SLA applies. State-specific regulatory requirements (e.g., state DOI rules) may drive different turn-time commitments.']
  superseded_by_sla_code varchar [note: 'SLA code of the newer version that replaced this record when status is \'superseded\'. Enables forward-chaining of SLA revision history per VREQ-007.']
  time_zone varchar [note: 'IANA time zone identifier for the jurisdiction or branch where this SLA is applied (e.g., \'America/Chicago\'). Ensures accurate business-hour turn-time measurement across geographies.']
  total_order_hours_target varchar [note: 'Maximum total business hours from order intake to policy issuance, representing the end-to-end title clearance cycle-time commitment. Primary SLA metric for lender channel reporting.']
  transaction_type varchar [note: 'Classification of the real-estate transaction type to which this SLA applies: purchase, refinance (REFI), home-equity line of credit (HELOC), construction, or commercial.']
  trid_applicable boolean [note: 'Indicates whether TRID disclosure timing requirements apply to orders governed by this SLA. Drives CD issuance timing constraints and closing readiness targets.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this service-level record. Supports change detection and SLA revision frequency analysis in the silver layer.']
  uw_referral_threshold_usd decimal(18,2) [note: 'Liability amount in USD at or above which orders governed by this SLA require underwriting referral (UWR). Supports underwriting referral and exception rate metrics per VREQ-016.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Reference/master entity defining service-level agreements and turn-time commitments applied to title orders by channel, transaction type, and product tier.'
}

Table ti_property.property {
  property_id varchar [pk, note: 'Unique surrogate identifier for the real-property asset record. Primary key for the property master entity, consumed as a foreign key by parcel, legal_description, title_order, ownership_interest, and all downstream domain products.']
  prior_property_id varchar [note: 'Self-referencing identifier pointing to the predecessor property record when this property was created from a split, merger, or re-platting event. Preserves chain-of-title continuity and lifecycle history per VREQ-007.']
  annual_tax_amount decimal(14,2) [note: 'Most recent annual property tax levy amount in USD as recorded by the county tax authority. Used in settlement statement (CD/HUD-1) proration calculations and escrow impound analysis.']
  assessed_value decimal(18,2) [note: 'Most recent county assessor assessed value of the property in USD. Used as a reference data point for underwriting, policy amount reasonableness checks, and tax lien exposure analysis.']
  assessed_value_year varchar [note: 'Tax year for which the assessed_value was determined by the county assessor. Ensures temporal accuracy when comparing assessed values across multiple tax years.']
  building_sqft decimal(14,2) [note: 'Total above-grade finished living area or building footprint in square feet as recorded by the county assessor. Supports AVM, underwriting, and policy coverage amount validation.']
  ccr_flag boolean [note: 'Indicates whether the property is subject to recorded Covenants, Conditions, and Restrictions (CC&Rs). CC&Rs are listed as Schedule B-II exceptions and reviewed for use restriction violations.']
  census_tract varchar [note: 'US Census Bureau census tract identifier for the property location. Used for HMDA/CRA regulatory reporting, fair lending analysis, and geographic risk segmentation.']
  chain_of_title_break_flag boolean [note: 'Indicates whether a break in the chain of title has been identified for this property during title examination. A True value requires curative action and underwriting referral before commitment issuance.']
  city varchar [note: 'City or municipality in which the property is located. Used for jurisdiction determination, recording fee schedules, and regulatory reporting.']
  cloud_on_title_flag boolean [note: 'Indicates the presence of an unresolved defect, encumbrance, or adverse claim that impairs the property title. Triggers underwriting referral and curative processing workflow.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the property location. Defaults to USA for domestic transactions; supports cross-border commercial title operations.']
  county_name varchar [note: 'Name of the county or parish in which the property is located. Determines the recording jurisdiction, county recorder office, and applicable recording fees and transfer taxes.']
  created_timestamp timestamp [note: 'Timestamp when the property master record was first created in the lakehouse Silver layer. Supports audit trail, data lineage, and record provenance per VREQ-007.']
  easement_flag boolean [note: 'Indicates whether one or more recorded easements (e.g., utility, access, ROW) affect the property. Triggers Schedule B-II exception listing and potential ALTA endorsement requirements.']
  encroachment_flag boolean [note: 'Indicates whether a survey or examination has identified an encroachment onto or from the property. May require ALTA survey, curative action, or endorsement to insure over.']
  fips_code varchar [note: 'Five-digit FIPS county code (2-digit state + 3-digit county) uniquely identifying the county jurisdiction. Used for title plant indexing, recording submission routing, and regulatory geographic reporting.']
  flood_zone_code varchar [note: 'FEMA National Flood Insurance Program (NFIP) flood zone designation for the property (e.g., AE, X, VE). Informs underwriting risk assessment and mandatory flood insurance disclosure requirements.']
  flood_zone_determination_date date [note: 'Date on which the current FEMA flood zone determination was made for this property. Required for RESPA flood zone disclosure compliance and underwriting file documentation.']
  hoa_annual_assessment decimal(14,2) [note: 'Annual HOA assessment amount in USD applicable to this property. Used in settlement statement proration and escrow impound calculations where HOA fees are escrowed.']
  hoa_flag boolean [note: 'Indicates whether the property is subject to a Homeowners Association (HOA). A True value triggers HOA lien search, assessment verification, and potential title requirement for HOA estoppel letter.']
  hoa_name varchar [note: 'Legal name of the Homeowners Association governing the property. Required for HOA lien search, estoppel letter request, and CC&R review in the title examination process.']
  land_use_code varchar [note: 'Assessor or county land use classification code describing the current use of the property (e.g., single-family residential, multi-family, commercial retail). Sourced from the Property Information and County Data System.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the property in decimal degrees (WGS 84). Supports spatial analysis, flood zone determination, and automated valuation model (AVM) inputs.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the property in decimal degrees (WGS 84). Supports spatial analysis, flood zone determination, and AVM inputs.']
  lot_size_sqft decimal(14,2) [note: 'Total land area of the property lot expressed in square feet as recorded by the county assessor. Used in underwriting risk assessment, AVM inputs, and survey comparison.']
  market_value decimal(18,2) [note: 'Estimated fair market value of the property in USD, sourced from an AVM, appraisal, or broker price opinion. Used for policy amount validation, LTV calculation, and underwriting risk assessment.']
  market_value_source varchar [note: 'Source methodology used to derive the market_value (AVM, appraisal, broker price opinion, assessor, sale price, or other). Required for provenance tracking and underwriting file documentation.']
  marketable_title_flag boolean [note: 'Indicates whether the property currently holds a marketable title status based on the most recent title examination. A False value signals an open cloud on title requiring curative action before policy issuance.']
  municipality_name varchar [note: 'Name of the incorporated municipality, township, or special district governing the property. Relevant for zoning, building permit history, and local transfer tax determination.']
  number_of_units varchar [note: 'Count of residential or commercial units within the property structure (e.g., 1 for single-family, 4 for a quadplex). Determines applicable policy form and underwriting guidelines.']
  plat_book varchar [note: 'Recorded plat book number or volume in which the subdivision plat map is filed with the county recorder. Used in legal description verification and chain-of-title assembly.']
  plat_page varchar [note: 'Recorded plat page or folio number within the plat book where the subdivision map is filed. Used alongside plat_book for precise legal description and title plant cross-reference.']
  property_status varchar [note: 'Current lifecycle status of the property master record. Tracks whether the property is active in the title plant, has been merged or split into other parcels, condemned, or demolished. Supports chain-of-title continuity.']
  property_type varchar [note: 'Classification of the real-property asset by use category (e.g., residential single-family, commercial, condominium, co-op, vacant land, construction). Drives underwriting rules, policy forms, and endorsement eligibility.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this property record was originally sourced (e.g., title production system, title plant, county data system). Supports data lineage and provenance tracking.']
  source_system_property_ref varchar [note: 'The native property identifier or file number assigned by the originating source system (e.g., SoftPro property ID, DataTrace property key). Enables back-reference to the system of record for reconciliation.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the property is located. Governs applicable state insurance regulations, recording statutes, and title plant jurisdiction.']
  street_address varchar [note: 'Full street address of the property including house number, street name, unit/suite designator. Primary human-readable location identifier used in title commitments, policies, and settlement statements.']
  subdivision_name varchar [note: 'Name of the recorded plat subdivision or development in which the property is located. Used in legal description assembly, title plant indexing, and CC&R identification.']
  tax_delinquency_flag boolean [note: 'Indicates whether the property has any outstanding delinquent property tax amounts as of the most recent tax search. A True value triggers a title requirement for payoff prior to or at closing.']
  tax_year varchar [note: 'Tax year corresponding to the annual_tax_amount. Ensures correct proration period is applied in settlement calculations and identifies potential delinquency exposure.']
  transaction_type varchar [note: 'Type of real-estate transaction associated with this property record (purchase, refinance, home equity/HELOC, construction, commercial). Determines applicable TRID/RESPA disclosure requirements and title workflow.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the property master record. Used for change detection, incremental ETL processing, and audit trail maintenance.']
  year_built varchar [note: 'Year in which the primary structure on the property was originally constructed, as recorded by the county assessor. Used in underwriting risk scoring and AVM valuation.']
  zip_code varchar [note: 'USPS ZIP or ZIP+4 postal code for the property location. Used for geographic risk segmentation, premium rating, and regulatory reporting.']
  zoning_code varchar [note: 'Local government zoning classification assigned to the property (e.g., R-1, C-2, M-1). Relevant to underwriting review for use conformity, encroachment analysis, and commercial title risk.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Authoritative SSOT master record for a real-property asset as a legally distinct entity separate from parcel and legal_description. Captures the property type (residential, commercial, condo, co-op, vacant land, construction), transaction type (purchase'
}

Table ti_property.parcel {
  parcel_id varchar [pk, note: 'Unique surrogate identifier for the assessor parcel record within the title insurance platform. Primary key for the parcel entity.']
  legal_description_id varchar [note: 'Foreign key reference to the authoritative legal description record associated with this parcel. Supports the legally distinct legal_description entity per VREQ-004.']
  property_id varchar [note: 'Foreign key reference to the parent property record. Links the assessor parcel to its associated property entity in the property domain.']
  acreage decimal(18,6) [note: 'Total land area of the parcel expressed in acres as recorded by the county assessor. Used for property valuation, underwriting risk assessment, and legal description verification.']
  annual_tax_amount decimal(18,2) [note: 'Annual real property tax amount billed for the parcel based on the assessed value and applicable tax rate. Used in settlement statement proration and escrow impound calculations.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor office. Primary external identifier used to locate the parcel in county tax and recorder systems.']
  assessed_improvement_value decimal(18,2) [note: 'County assessor\'s assessed value of improvements (structures) on the parcel, excluding land. Used with assessed_land_value for total assessed value and tax computation.']
  assessed_land_value decimal(18,2) [note: 'County assessor\'s assessed value of the land component of the parcel, excluding improvements. Used for tax calculation, underwriting valuation, and LTV analysis.']
  assessed_total_value decimal(18,2) [note: 'Total assessed value of the parcel (land plus improvements) as determined by the county assessor. Used for property tax billing and underwriting risk analysis.']
  assessment_year varchar [note: 'Tax year for which the assessed values on this parcel record are applicable. Used to track annual assessment changes and historical valuation trends.']
  block_number varchar [note: 'Block number assigned to the parcel within its recorded subdivision plat. Used with lot_number to form the platted legal description.']
  county_name varchar [note: 'Full name of the county or parish in which the parcel is located as recognized by the county recorder or register of deeds office.']
  data_effective_date date [note: 'Date as of which the parcel data in this record is current and authoritative. Used to track data currency for title search, examination, and ownership interest analysis.']
  fips_code varchar [note: 'Five-digit FIPS county code identifying the county in which the parcel is located. Used for jurisdictional routing, regulatory reporting, and county recorder integration.']
  flood_map_panel_number varchar [note: 'FEMA Flood Insurance Rate Map (FIRM) panel number applicable to the parcel. Used with flood_zone_code to identify the specific FIRM panel for flood determination documentation.']
  flood_zone_code varchar [note: 'FEMA National Flood Insurance Program (NFIP) flood zone designation for the parcel (e.g., AE, X, VE). Used in underwriting risk assessment and lender flood insurance requirements.']
  hoa_flag boolean [note: 'Indicates whether the parcel is subject to a Homeowners Association (HOA). A true value requires HOA lien search and assessment verification during title examination.']
  hoa_name varchar [note: 'Name of the Homeowners Association (HOA) governing the parcel. Used to identify the HOA for lien search, assessment demand, and CC&R review during title examination.']
  land_use_code varchar [note: 'Assessor land use code assigned to the parcel indicating the specific use classification (e.g., single-family residential, multi-family, commercial retail). Sourced from county assessor records.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the parcel centroid in decimal degrees (WGS84). Used for spatial analysis, flood zone determination, and property information services.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the parcel centroid in decimal degrees (WGS84). Used with latitude for spatial analysis, flood zone determination, and mapping.']
  lot_area_sqft decimal(18,2) [note: 'Total lot area of the parcel expressed in square feet. Complements acreage for residential and commercial underwriting analysis and property information reporting.']
  lot_depth_ft decimal(10,2) [note: 'Depth of the parcel lot measured in feet as recorded by the county assessor or plat map. Used in legal description verification and encroachment analysis.']
  lot_number varchar [note: 'Lot number assigned to the parcel within its recorded subdivision plat. Core component of the platted legal description used in title commitments and policies.']
  lot_width_ft decimal(10,2) [note: 'Width of the parcel lot measured in feet as recorded by the county assessor or plat map. Used in legal description verification and encroachment analysis.']
  mers_min varchar [note: '18-digit MERS Mortgage Identification Number associated with the parcel\'s registered mortgage. Used to identify and track mortgage assignments in the MERS registry during title search.']
  parcel_status varchar [note: 'Current lifecycle status of the parcel as maintained by the county assessor. Reflects whether the parcel is active, has been merged into another parcel, split, or retired.']
  parcel_type varchar [note: 'Classification of the parcel by land use type as determined by the county assessor. Drives underwriting risk segmentation and policy coverage analysis. [ENUM-REF-CANDIDATE: residential|commercial|industrial|agricultural|vacant|mixed_use|exempt — promote']
  pin varchar [note: 'Parcel Identification Number as assigned by the county recorder or jurisdiction. May differ from APN in jurisdictions that maintain separate assessor and recorder numbering systems.']
  plat_book varchar [note: 'Plat book number in which the subdivision map for this parcel is recorded at the county recorder\'s office. Used to locate the recorded plat for legal description verification.']
  plat_page varchar [note: 'Page number within the plat book where the subdivision map for this parcel is recorded. Used with plat_book to locate the recorded plat instrument.']
  range varchar [note: 'Range designation within the PLSS grid (e.g., R5E). Used with township and section to form the PLSS legal description for rural and unplatted parcels.']
  record_created_timestamp timestamp [note: 'Timestamp when the parcel record was first created in the title insurance platform. Supports audit trail and data provenance requirements per ALTA Best Practices and SOC 2.']
  record_updated_timestamp timestamp [note: 'Timestamp when the parcel record was last modified in the title insurance platform. Used for change detection, data refresh tracking, and audit trail maintenance.']
  section_number varchar [note: 'Section number within the Public Land Survey System (PLSS) township/range grid. Used for metes-and-bounds and PLSS legal descriptions in non-platted rural parcels.']
  situs_address_line1 varchar [note: 'Primary street address line of the parcel\'s physical location (situs address) as recorded by the county assessor. Distinct from mailing address; used for property identification.']
  situs_address_line2 varchar [note: 'Secondary street address line for the parcel\'s physical location (unit, suite, building number). Supplements situs_address_line1 for multi-unit or complex properties.']
  situs_city varchar [note: 'City or municipality of the parcel\'s physical situs address as recorded by the county assessor. Used for jurisdictional routing and property information reporting.']
  situs_zip_code varchar [note: 'Five-digit or ZIP+4 postal code of the parcel\'s physical situs address. Used for property information, tax routing, and geographic analysis.']
  source_system_parcel_key varchar [note: 'Native parcel identifier from the originating Property Information and County Data System (e.g., DataTrace, TitlePoint). Used for lineage tracing and data refresh reconciliation.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the parcel is located. Used for jurisdictional routing and state department of insurance reporting.']
  subdivision_name varchar [note: 'Name of the recorded plat subdivision or development in which the parcel is located. Used in legal description assembly and chain-of-title analysis.']
  tax_account_number varchar [note: 'Tax account number assigned by the county tax collector or treasurer for billing and collection of real property taxes associated with this parcel.']
  tax_delinquent_amount decimal(18,2) [note: 'Total amount of delinquent property taxes, penalties, and interest outstanding on the parcel. Populated when tax_delinquent_flag is true; drives title requirement and curative action.']
  tax_delinquent_flag boolean [note: 'Indicates whether the parcel has delinquent property taxes as of the last data refresh. A true value triggers a title requirement for tax payoff prior to closing.']
  tax_exemption_type varchar [note: 'Type of property tax exemption applied to the parcel by the county assessor (e.g., homestead, senior, veteran). Affects tax proration in settlement and underwriting analysis.']
  township varchar [note: 'Township designation within the PLSS grid (e.g., T2N). Used with range and section to form the PLSS legal description for rural and unplatted parcels.']
  zoning_code varchar [note: 'Municipal or county zoning designation for the parcel (e.g., R-1, C-2, M-1). Used in title examination to identify zoning encumbrances and compliance with permitted use.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Legally distinct entity representing the assessor parcel as defined by the county recorder or assessor office. Owns the APN (Assessor\'s Parcel Number), PIN (Parcel Identification Number), FIPS county code, tax account number, acreage, lot dimensions, and'
}

Table ti_property.legal_description {
  legal_description_id varchar [pk, note: 'Unique surrogate identifier for the legal description record. Primary key for the legal_description entity in the property domain.']
  prior_description_legal_description_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding version of this legal description. Enables chain-of-description history and prior classification preservation per VREQ-007.']
  property_id varchar [note: 'Reference to the parent property entity. Enables direct linkage from legal description to the property record for title and underwriting workflows.']
  area_acres decimal(18,6) [note: 'Total land area of the described parcel expressed in acres. Used in underwriting risk assessment, policy coverage determination, and commercial transaction analysis.']
  area_sq_ft decimal(18,2) [note: 'Total land area of the described parcel expressed in square feet. Commonly used for residential and commercial underwriting and settlement calculations.']
  block_number varchar [note: 'Block number within the recorded subdivision or plat. Applicable when description_type is plat_subdivision or lot_block. Used with lot_number for full lot-block identification.']
  building_number varchar [note: 'Building or phase identifier within a condominium or multi-building development. Supplements unit_number for complex condo legal descriptions.']
  county_name varchar [note: 'Name of the county or parish where the property is located. Used in title search routing, recording submission, and Schedule A formatting.']
  created_timestamp timestamp [note: 'Timestamp when this legal description record was first created in the system. Audit field supporting record provenance and lifecycle tracking.']
  description_source varchar [note: 'Origin source from which this legal description was extracted or derived. Supports evidence and provenance capture across the title lifecycle. [ENUM-REF-CANDIDATE: recorded_deed|plat_map|alta_survey|title_plant|assessor_record|prior_policy|other — promote']
  description_status varchar [note: 'Current lifecycle status of this legal description record. Active indicates the current operative description; superseded preserves prior versions per VREQ-007 lifecycle history requirements.']
  description_type varchar [note: 'Classification of the legal description format. Metes and bounds (M&B), Public Land Survey System (PLSS) township/range/section, plat/subdivision lot-block, condominium unit, or other.']
  description_variance_notes varchar [note: 'Narrative notes documenting any discrepancy or variance between this legal description and the description appearing in a prior instrument, commitment, or policy.']
  effective_date date [note: 'Date on which this legal description became operative, typically the recording date of the source instrument. Supports effective-dated history per VREQ-007.']
  execution_date date [note: 'Date the source instrument (deed, plat, or survey) was signed/executed by the grantor or surveyor. Distinct from recording_date and effective_date per VREQ-008.']
  fips_county_code varchar [note: 'Five-digit FIPS county code identifying the county jurisdiction where the property is located. Used for county recorder routing, tax assessment, and regulatory reporting.']
  full_text varchar [note: 'Complete verbatim text of the legal description as it appears in the recorded instrument or title commitment Schedule A. Authoritative SSOT for the legal description string.']
  gap_notes varchar [note: 'Examiner or underwriter notes describing the nature of any identified gap between this legal description and the prior recorded description. Supports curative processing.']
  has_gap_risk boolean [note: 'Flags whether a gap exists between the legal description in the current instrument and the prior recorded description, indicating potential chain-of-title break or gap coverage need.']
  is_current boolean [note: 'Indicates whether this is the currently operative legal description for the associated parcel. True for the active version; False for superseded or historical versions.']
  is_schedule_a_approved boolean [note: 'Indicates whether this legal description has been reviewed and approved by the examiner or underwriter for use in the title commitment or policy Schedule A.']
  lot_number varchar [note: 'Lot number within the recorded subdivision or plat. Applicable when description_type is plat_subdivision or lot_block. Core identifier for platted parcels.']
  metes_bounds_point_of_beginning varchar [note: 'Narrative description of the point of beginning (POB) for a metes-and-bounds legal description. Applicable when description_type is metes_and_bounds.']
  plat_book varchar [note: 'Book number or volume of the recorded plat map in the county recorder\'s index. Used to locate the source plat document for title examination.']
  plat_page varchar [note: 'Page number within the plat book where the subdivision map is recorded. Used in conjunction with plat_book to locate the source plat document.']
  plss_aliquot_parts varchar [note: 'Aliquot part subdivisions within the PLSS section (e.g., NE1/4 of SW1/4). Applicable when description_type is plss. Provides precise parcel location within a section.']
  plss_principal_meridian varchar [note: 'Name or code of the PLSS principal meridian governing the township/range/section coordinates (e.g., Willamette, Boise, 6th PM). Applicable when description_type is plss.']
  plss_range varchar [note: 'Range designation in the PLSS coordinate system (e.g., R3E, R7W). Applicable when description_type is plss. Used in chain-of-title and search indexing.']
  plss_section varchar [note: 'Section number (1–36) within the PLSS township/range grid. Applicable when description_type is plss. Core identifier for PLSS-based legal descriptions.']
  plss_state varchar [note: 'Two-letter US state code for the PLSS meridian context. Applicable only when description_type is plss. Identifies the principal meridian jurisdiction.']
  plss_township varchar [note: 'Township designation in the PLSS coordinate system (e.g., T2N, T5S). Applicable when description_type is plss. Used in chain-of-title and search indexing.']
  recording_date date [note: 'Date the source instrument establishing this legal description was recorded with the county recorder or register of deeds. Distinct from effective_date per VREQ-008.']
  recording_reference varchar [note: 'Official recording reference (book/page, document number, or instrument number) of the source instrument from which this legal description derives. Links description to county recorder index.']
  schedule_a_text varchar [note: 'The legal description text as formatted and printed in the title commitment or policy Schedule A. May differ slightly from the raw recorded instrument text due to standardization.']
  source_instrument_id varchar [note: 'Reference to the recorded instrument (deed, plat, or other document) from which this legal description was extracted. Supports evidence and provenance capture.']
  standardized_text varchar [note: 'Normalized or standardized version of the legal description text produced by the title plant or search automation system for indexing and comparison purposes.']
  state_code varchar [note: 'Two-letter US state abbreviation for the jurisdiction where the property is located. Used for state-specific title insurance rate filing and regulatory compliance.']
  subdivision_name varchar [note: 'Name of the recorded plat or subdivision as shown on the plat map filed with the county recorder. Applicable when description_type is plat_subdivision or lot_block.']
  superseded_date date [note: 'Date on which this legal description was replaced by a newer version. Null if currently active. Preserves prior classification history per VREQ-007.']
  survey_date date [note: 'Date of the land survey from which the metes-and-bounds or ALTA/NSPS survey legal description was derived. Used to assess description currency and gap risk.']
  surveyor_license_number varchar [note: 'State-issued professional license number of the land surveyor who prepared the survey. Supports evidence provenance and regulatory compliance verification.']
  surveyor_name varchar [note: 'Name of the licensed land surveyor or surveying firm that prepared the survey underlying this legal description. Used for evidence provenance and E&O tracking.']
  title_plant_index_key varchar [note: 'Index key or reference code assigned by the title plant or search automation system (e.g., DataTrace, TitlePoint) to locate this legal description in the plant index.']
  unit_number varchar [note: 'Unit identifier for condominium or planned unit development descriptions. Applicable when description_type is condo_unit. Used in Schedule A for condo title policies.']
  updated_timestamp timestamp [note: 'Timestamp when this legal description record was last modified. Audit field supporting change tracking and data lineage in the silver layer.']
  version_number varchar [note: 'Sequential version counter for this legal description on the associated parcel. Increments each time the description is revised or corrected, supporting lifecycle revision tracking.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Legally distinct entity capturing the full text and structured components of the property\'s legal description as it appears in recorded instruments and title commitments (Schedule A).'
}

Table ti_property.ownership_interest {
  ownership_interest_id varchar [pk, note: 'Unique surrogate identifier for an effective-dated ownership interest record representing a vested ownership stake in a property held by a party. Primary key per VREQ-005.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Each ownership interest is vested according to specific legal description. Critical for gap analysis when legal descriptions change (lot splits, consolidations).']
  parcel_id varchar [note: 'Reference to the parcel entity that this ownership interest encumbers. Links the interest to the authoritative parcel record in the property domain.']
  party_id varchar [note: 'Reference to the party (individual, trust, entity, or co-owner) holding this ownership interest. Supports VREQ-006 multi-role party modeling.']
  prior_interest_ownership_interest_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding ownership interest record in the chain of title. Enables linked-list traversal of the full ownership history.']
  property_id varchar [note: 'Reference to the parent property entity. Provides the top-level real-property context for this ownership interest record.']
  acquisition_type varchar [note: 'Nature of the transaction by which this ownership interest was acquired (e.g., purchase, gift, inheritance, foreclosure). Informs underwriting risk classification and chain-of-title analysis.']
  book_number varchar [note: 'Deed book or volume number assigned by the county recorder where the instrument is indexed. Used in conjunction with page_number for traditional county plant lookups.']
  chain_of_title_sequence varchar [note: 'Sequential position of this ownership interest record within the chain of title (COT) for the parcel. Enables ordered traversal of ownership history and detection of chain-of-title breaks.']
  cloud_on_title_flag boolean [note: 'Indicates the presence of a cloud on title — an outstanding claim, encumbrance, or defect that impairs the owner\'s ability to convey clear title. Triggers curative processing.']
  consideration_amount decimal(18,2) [note: 'Purchase price or consideration stated on the conveying instrument in USD. Used for transfer tax calculation, underwriting risk assessment, and LTV analysis.']
  consideration_currency varchar [note: 'ISO 4217 three-letter currency code for the consideration amount. Defaults to USD for domestic US transactions.']
  cot_break_description varchar [note: 'Narrative description of the nature of the chain-of-title break or gap identified at this interest record. Used by examiners to document curative requirements.']
  cot_break_flag boolean [note: 'Indicates whether a break or gap exists in the chain of title at this interest record (e.g., missing link between grantor and prior grantee). Triggers curative action in the examination workflow.']
  created_timestamp timestamp [note: 'Timestamp when this ownership interest record was first created in the system. Supports audit trail and provenance tracking per VREQ-007.']
  effective_date date [note: 'Date on which this ownership interest became legally effective, typically the recording date of the conveying instrument. Start of the effective-dated ownership period per VREQ-005.']
  entity_type varchar [note: 'Legal entity classification of the party holding this ownership interest (e.g., individual, LLC, corporation, trust). Drives authority and capacity verification requirements.']
  evidence_document_id varchar [note: 'Reference to the recorded instrument or document that evidences this ownership interest (e.g., warranty deed, quit claim deed). Supports VREQ-005 evidence-backed ownership.']
  examiner_notes varchar [note: 'Free-text notes entered by the title examiner regarding this ownership interest record, including observations about vesting, authority, or chain-of-title issues.']
  execution_date date [note: 'Date the conveying instrument (deed) was signed by the grantor. Distinct from effective and recording dates per VREQ-008.']
  expiration_date date [note: 'Date on which this ownership interest ended or was superseded by a subsequent conveyance. Null for currently active interests. Closes the effective-dated period per VREQ-005.']
  gap_period_flag boolean [note: 'Indicates whether this interest record falls within a gap period (GAP) between the effective search date and the recording of the current transaction. Triggers gap coverage underwriting review.']
  grantee_name varchar [note: 'Full legal name of the party receiving the interest (grantee) as it appears on the recorded instrument. Supports grantor/grantee index and chain-of-title assembly.']
  grantor_name varchar [note: 'Full legal name of the party conveying the interest (grantor) as it appears on the recorded instrument. Supports grantor/grantee index and chain-of-title assembly.']
  instrument_number varchar [note: 'Official document or instrument number assigned by the county recorder at the time of recording. Used to retrieve the recorded instrument from the county index.']
  instrument_type varchar [note: 'Type of recorded instrument conveying this ownership interest (e.g., Warranty Deed (WD), Quit Claim Deed (QCD), Special Warranty Deed (SWD)). Affects title insurance risk assessment.']
  insurable_title_flag boolean [note: 'Indicates whether the title associated with this ownership interest is insurable by the underwriter, even if not fully marketable. Distinct from marketable title determination.']
  interest_status varchar [note: 'Current lifecycle state of this ownership interest record. Active indicates current vested ownership; superseded indicates a prior record replaced by a subsequent conveyance.']
  interest_type varchar [note: 'Classification of the estate or interest held (e.g., fee simple, life estate, leasehold). Determines the nature and scope of the ownership right conveyed.']
  marketable_title_flag boolean [note: 'Indicates whether the title associated with this ownership interest has been determined to be marketable (free from reasonable doubt as to validity). Set by the title examiner.']
  mers_flag boolean [note: 'Indicates whether the associated mortgage or deed of trust is registered with MERS (Mortgage Electronic Registration Systems), affecting lien holder identification in the chain of title.']
  ownership_percentage decimal(7,4) [note: 'Fractional ownership share held by this party expressed as a percentage (e.g., 50.0000 for an equal co-owner). Must sum to 100 across all active interests for a parcel.']
  page_number varchar [note: 'Page number within the deed book where the instrument is recorded. Used with book_number for traditional county plant and title plant index lookups.']
  prior_classification varchar [note: 'Previous interest_type or vesting_type classification before a reclassification event. Preserves lifecycle history of ownership classification changes per VREQ-007.']
  reclassification_reason varchar [note: 'Reason for any change in the ownership interest classification or status (e.g., correction of vesting language, court order, curative deed). Supports lifecycle history per VREQ-007.']
  recording_date date [note: 'Date the conveying instrument was officially recorded with the county recorder or register of deeds. Establishes constructive notice and priority. Distinct field per VREQ-008.']
  source_reference_number varchar [note: 'Identifier assigned by the source system of record to this ownership interest or conveying instrument. Enables traceability and reconciliation back to the originating system.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this ownership interest record was sourced (e.g., title plant, county recorder, title production system).']
  state_of_formation varchar [note: 'Two-letter US state code where a corporate or LLC entity holding title was formed. Required for entity authority and good-standing verification in underwriting.']
  transfer_tax_amount decimal(18,2) [note: 'Documentary transfer tax or deed stamp tax assessed on the conveyance in USD. Calculated from consideration amount and applicable state/county tax rate.']
  trust_name varchar [note: 'Legal name of the trust holding title, if the vesting type is trust. Required for Schedule A vesting language and trustee authority verification.']
  trustee_name varchar [note: 'Full legal name of the trustee acting on behalf of a trust that holds title. Required when vesting_type is trust for Schedule A and authority verification.']
  updated_timestamp timestamp [note: 'Timestamp when this ownership interest record was last modified. Supports change tracking, audit trail, and lifecycle history preservation per VREQ-007.']
  vesting_name varchar [note: 'Exact vesting language as it appears on the deed or title instrument (e.g., \'John Doe and Jane Doe, as joint tenants\'). Used verbatim in Schedule A of the title commitment and policy.']
  vesting_type varchar [note: 'Legal form of title vesting describing how ownership is held among one or more parties (e.g., joint tenancy, tenancy in common, community property). Drives survivorship and transfer rules.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Effective-dated ownership interest record representing a vested ownership stake in a property held by a party (individual, trust, entity, or co-owner). Implements VREQ-005: ownership is modeled as a set of time-bounded interest records supported by'
}

Table ti_property.title_evidence {
  title_evidence_id varchar [pk, note: 'Unique surrogate identifier for each title evidence record in the property domain. Primary key for the title_evidence product.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Title evidence documents reference specific legal description versions used in chain of title.']
  ownership_interest_id varchar [note: 'Reference to the effective-dated ownership interest record this evidence supports or establishes. Enables evidence-backed chain-of-title analysis.']
  parcel_id varchar [note: 'Reference to the parcel record this evidence pertains to. Anchors evidence to the authoritative parcel entity in the property domain.']
  superseded_by_evidence_id varchar [note: 'Reference to the title_evidence record that supersedes this one when evidence is revised or replaced. Enables forward-chaining of evidence revision history.']
  title_order_id varchar [note: 'Reference to the title order under which this evidence was collected or produced. Links evidence to the originating transaction workflow.']
  acceptance_date date [note: 'Date the county recorder formally accepted the instrument for recording. Distinct from submission_date; used to measure recording acceptance lag and rejection/resubmission tracking.']
  book_number varchar [note: 'Official deed book or volume number assigned by the county recorder where the instrument is recorded. Used in conjunction with page_number for legacy plant index lookups.']
  chain_of_title_sequence varchar [note: 'Ordinal position of this instrument within the assembled chain of title for the parcel. Enables sequential chain-of-title analysis and break detection.']
  consideration_amount decimal(18,2) [note: 'Dollar amount of consideration stated on the instrument (e.g., purchase price on a deed). Used for transfer tax calculation, LTV analysis, and underwriting risk assessment.']
  created_timestamp timestamp [note: 'Timestamp when this title_evidence record was first created in the lakehouse. Audit field for record provenance and data lineage tracking.']
  curative_status varchar [note: 'Current curative processing status for any defect associated with this evidence. Tracks whether curative action is required, in progress, cleared, or an exception has been taken.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for monetary amounts on this evidence record. Defaults to USD for domestic US title transactions.']
  defect_description varchar [note: 'Free-text description of the title defect, cloud, or chain-of-title break identified in connection with this evidence record. Populated when defect_indicator_flag is true.']
  defect_indicator_flag boolean [note: 'Indicates whether this evidence record has been flagged as containing or contributing to a title defect, cloud on title, or chain-of-title break requiring curative action.']
  document_image_url varchar [note: 'URL or path to the scanned or electronic image of the source instrument in the document management or imaging system. Supports evidence completeness and provenance verification.']
  effective_date date [note: 'Date the instrument becomes legally effective or operative. May differ from execution and recording dates. Required for effective-dated ownership interest analysis per VREQ-005.']
  encumbrance_type varchar [note: 'Classification of the encumbrance or restriction evidenced by this instrument. Used for Schedule B-II exception drafting and underwriting risk assessment. [ENUM-REF-CANDIDATE: promote to reference product]']
  erecording_flag boolean [note: 'Indicates whether the instrument was submitted and recorded electronically via an eRecording gateway (e.g., Simplifile, CSC eRecording). Used for recording channel analytics.']
  evidence_number varchar [note: 'Externally-known business identifier assigned to this evidence record by the title production system or document management system. Used for cross-system traceability.']
  evidence_status varchar [note: 'Current lifecycle state of the evidence record. Tracks whether the evidence is active, has been superseded by a later instrument, voided, or archived per retention policy.']
  evidence_subtype varchar [note: 'Further classification within the evidence type (e.g., Warranty Deed, Quit Claim Deed, Deed of Trust, Special Warranty Deed, Mechanics Lien, Tax Lien, Judgment Lien). Supports granular chain-of-title analysis.']
  evidence_type varchar [note: 'Classification of the source document or data artifact (e.g., deed, mortgage, lien, easement, plat, survey). Drives chain-of-title assembly and defect identification.']
  examiner_notes varchar [note: 'Free-text notes entered by the title examiner regarding the significance, interpretation, or concerns associated with this evidence record during the examination process.']
  execution_date date [note: 'Date the instrument was signed or executed by the parties. Distinct from effective, recording, and submission dates per VREQ-008 date separation requirements.']
  fips_code varchar [note: 'Five-digit FIPS county code identifying the county where the instrument was recorded. Used for jurisdiction routing, plant index lookups, and regulatory reporting.']
  gap_period_flag boolean [note: 'Indicates whether this evidence falls within the gap period between the effective date of the title search and the recording of the insured instrument. Used for gap coverage analysis.']
  grantee_name varchar [note: 'Name of the grantee (transferee, mortgagee, or lienholder) as it appears on the instrument. Used for grantor/grantee index searches and chain-of-title assembly.']
  grantor_name varchar [note: 'Name of the grantor (transferor, mortgagor, or lienor) as it appears on the instrument. Used for grantor/grantee index searches and chain-of-title assembly.']
  image_available_flag boolean [note: 'Indicates whether a scanned or electronic image of the instrument is available in the document management system. Used for evidence completeness scoring and audit readiness.']
  instrument_number varchar [note: 'Official instrument or document number assigned by the county recorder or register of deeds upon recording. Primary identifier for recorded instruments in the chain of title.']
  jurisdiction_name varchar [note: 'Name of the county, parish, or recording jurisdiction where the instrument is recorded. Complements the FIPS code for human-readable reporting and routing.']
  lien_amount decimal(18,2) [note: 'Dollar amount of the lien, mortgage, or encumbrance stated on the instrument. Applicable for mortgage, deed of trust, mechanics lien, judgment lien, and tax lien evidence types.']
  notarized_flag boolean [note: 'Indicates whether the instrument was notarized at execution. Required for recording eligibility in most jurisdictions and for underwriting evidence completeness.']
  notary_state varchar [note: 'Two-letter US state code of the state in which the instrument was notarized. Used for notarial authority validation and recording eligibility checks.']
  page_number varchar [note: 'Official page number within the deed book or volume where the instrument is recorded. Used with book_number for legacy county plant index lookups.']
  prior_classification varchar [note: 'Previous evidence_type or evidence_subtype classification before any reclassification event. Preserves lifecycle history and prior classifications per VREQ-007.']
  prior_instrument_number varchar [note: 'Instrument number of the immediately preceding instrument in the chain of title that this evidence links to or satisfies. Used for chain-of-title continuity and break detection.']
  recording_date date [note: 'Date the instrument was officially recorded by the county recorder or register of deeds. Establishes constructive notice and priority in the chain of title.']
  release_satisfaction_flag boolean [note: 'Indicates whether this evidence record represents a release, satisfaction, reconveyance, or discharge of a prior encumbrance. True if this instrument clears a prior lien or encumbrance.']
  retrieved_timestamp timestamp [note: 'Timestamp when this evidence record was retrieved from the source system or plant index. Represents the principal business event time for evidence collection. Used for search cycle time metrics.']
  revision_number varchar [note: 'Sequential revision counter for this evidence record. Incremented each time the evidence is updated or reclassified. Supports lifecycle history and audit trail per VREQ-007.']
  ron_flag boolean [note: 'Indicates whether the instrument was notarized via Remote Online Notarization (RON). Relevant for recording eligibility and underwriting risk assessment in RON-enabled jurisdictions.']
  source_reference_code varchar [note: 'Identifier of this evidence record in the originating source system (e.g., DataTrace document ID, Simplifile submission ID, county plant index key). Enables provenance traceability.']
  state_code varchar [note: 'Two-letter US state abbreviation for the jurisdiction where the instrument was recorded. Used for state-level regulatory reporting and underwriting authority routing.']
  submission_date date [note: 'Date the instrument was submitted to the county recorder for recording. Distinct from recording_date; used to track recording submission lag and gap period analysis.']
  updated_timestamp timestamp [note: 'Timestamp when this title_evidence record was last modified in the lakehouse. Audit field for change tracking and incremental processing.']
  vesting_type varchar [note: 'Form of ownership vesting as stated on the instrument (e.g., joint tenancy, tenancy in common, community property, trust). Critical for ownership interest modeling and policy issuance.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Provenance and evidence record capturing each source document or data artifact used to establish or support an ownership interest, encumbrance, easement, survey/plat, or chain-of-title link.'
}

Table ti_property.encumbrance {
  encumbrance_id varchar [pk, note: 'Unique surrogate identifier for each encumbrance, lien, or cloud-on-title record affecting a parcel or property. Primary key of the encumbrance entity.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Encumbrances are recorded against specific legal descriptions. When legal descriptions change (lot splits, consolidations), encumbrances must be tracked to correct legal']
  parcel_id varchar [note: 'Reference to the parcel record against which this encumbrance is recorded. Links the encumbrance to the authoritative parcel entity in the property domain.']
  property_id varchar [note: 'Reference to the property record associated with this encumbrance. Supports encumbrances that span multiple parcels under a single property umbrella.']
  recorded_instrument_id varchar [note: 'Foreign key linking to recording.recorded_instrument. Business justification: Encumbrances (mortgages, liens, judgments) are created by recorded instruments—essential for lien priority determination, payoff tracking, and underwriting exception analysis.']
  title_evidence_id varchar [note: 'Foreign key linking to property.title_evidence. Business justification: Encumbrances are discovered through title evidence. Critical for VREQ-009 provenance requirements — every material finding (encumbrance) must reference its evidence source.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor to the parcel affected by this encumbrance. Cross-reference for tax records and property information system lookups.']
  balance_as_of_date date [note: 'Date as of which the current_balance_amount was determined or reported. Required to assess payoff accuracy and staleness of balance information.']
  case_number varchar [note: 'Court case number associated with a judgment lien, lis pendens, or foreclosure action. Required for judgment lien and LP encumbrance types to support curative research.']
  classification_changed_date date [note: 'Date on which the encumbrance type or status was reclassified. Used with prior_classification to maintain a lightweight lifecycle history without a full audit table.']
  court_name varchar [note: 'Name of the court that entered the judgment or filed the lis pendens. Applicable to judgment lien and lis pendens encumbrance types.']
  created_timestamp timestamp [note: 'Timestamp when this encumbrance record was first created in the system. Audit field supporting data lineage and provenance tracking per VREQ-007.']
  curative_action_type varchar [note: 'Type of curative action required or taken to resolve this encumbrance (e.g., payoff, release, subordination, satisfaction, reconveyance, discharge). Null if no curative action required.']
  curative_completed_date date [note: 'Date on which the curative action for this encumbrance was completed and the encumbrance was cleared. Populated when curative_status transitions to completed.']
  curative_status varchar [note: 'Current status of the curative processing effort for this encumbrance (e.g., not required, pending, in progress, completed, waived, escalated). Supports curative aging and closing readiness metrics.']
  current_balance_amount decimal(18,2) [note: 'Most recently known outstanding balance of the encumbrance as of the balance_as_of_date. Used for payoff estimation and underwriting risk assessment. Null for non-monetary encumbrances.']
  discovered_date date [note: 'Date this encumbrance was first identified during a title search or examination. Supports evidence provenance, search completeness auditing, and chain-of-title gap analysis.']
  easement_purpose varchar [note: 'Stated purpose of the easement (e.g., utility, drainage, access, right-of-way, pipeline). Applicable when encumbrance_type is easement. Supports underwriting exception analysis.']
  easement_type varchar [note: 'Classification of easement when encumbrance_type is easement (e.g., appurtenant, in gross, prescriptive, implied, express, ROW). Null or not_applicable for non-easement encumbrance types.']
  effective_date date [note: 'Date the encumbrance becomes legally effective or binding, which may differ from execution_date or recording_date (e.g., tax lien attachment date). Required per VREQ-008.']
  encumbrance_status varchar [note: 'Current lifecycle status of the encumbrance indicating whether it remains a cloud on title or has been resolved (e.g., active, released, satisfied, subordinated, expired, disputed, pending cure).']
  encumbrance_type varchar [note: 'Classification of the encumbrance by legal instrument type (e.g., tax lien, mechanics lien, judgment lien, HOA lien, lis pendens, deed of trust, mortgage, UCC filing, easement, CC&R, encroachment).']
  execution_date date [note: 'Date the encumbrance instrument was signed or executed by the parties. Distinct from recording_date; may precede recording by days or weeks. Required per VREQ-008.']
  fips_county_code varchar [note: 'Five-digit FIPS county code identifying the county jurisdiction where the encumbrance is recorded. Used for jurisdiction routing, regulatory reporting, and county plant searches.']
  grantee_name varchar [note: 'Name of the grantee (creditor, lender, beneficiary, or lienholder) as it appears on the recorded instrument. Used in grantor/grantee index searches and lien holder identification.']
  grantor_name varchar [note: 'Name of the grantor (obligor, debtor, or property owner) as it appears on the recorded instrument creating this encumbrance. Used in grantor/grantee index searches.']
  hoa_name varchar [note: 'Name of the homeowners association asserting an HOA assessment lien against the property. Applicable to HOA lien encumbrance type. Used for curative demand letter routing.']
  interest_rate decimal(8,6) [note: 'Annual interest rate applicable to the encumbrance as stated in the underlying instrument. Expressed as a decimal (e.g., 0.065 = 6.5%). Null for non-interest-bearing encumbrances.']
  is_curative_required boolean [note: 'Indicates whether a curative action (payoff, release, subordination, or other clearance) is required to resolve this encumbrance prior to or at closing. Drives requirement generation.']
  is_insured_exception boolean [note: 'Indicates whether this encumbrance has been listed as a Schedule B-II exception in an issued title commitment or policy. True = exception taken; False = not excepted or insured over.']
  lien_position_number varchar [note: 'Numeric ordinal position of this lien among all liens on the parcel (1 = first lien, 2 = second lien, etc.). Supports automated priority ordering and chain-of-title analysis.']
  lien_priority varchar [note: 'Priority position of the lien or encumbrance relative to other encumbrances on the same parcel (e.g., first, second, junior, senior, subordinate). Critical for underwriting and foreclosure analysis.']
  loan_number varchar [note: 'Lender-assigned loan number associated with the mortgage or deed of trust encumbrance. Used to correlate with lender systems for payoff demand and subordination requests.']
  maturity_date date [note: 'Date on which the underlying obligation (mortgage, deed of trust, or lien) is scheduled to mature or expire. Null for perpetual encumbrances such as easements or CC&Rs.']
  mers_min varchar [note: '18-digit MERS Mortgage Identification Number assigned when the mortgage or deed of trust is registered with MERS. Enables electronic tracking of beneficial ownership and servicing transfers.']
  notes varchar [note: 'Free-text examiner or underwriter notes describing the nature, history, or curative requirements of this encumbrance. Supports title examination workflow and underwriting referral documentation.']
  number varchar [note: 'Externally assigned or internally generated reference number uniquely identifying this encumbrance within the title production system (e.g., SoftPro/RamQuest lien reference).']
  original_principal_amount decimal(18,2) [note: 'Original face amount of the lien, mortgage, deed of trust, or judgment as stated in the recorded instrument. Expressed in USD. Null for non-monetary encumbrances such as easements or CC&Rs.']
  payoff_demand_amount decimal(18,2) [note: 'Total amount required to fully satisfy and release this encumbrance as stated in the payoff demand letter, valid through payoff_good_through_date. Used in settlement statement preparation.']
  payoff_good_through_date date [note: 'Date through which the payoff demand amount is valid. After this date, a new payoff demand must be obtained. Critical for closing coordination and settlement statement preparation.']
  per_diem_interest_amount decimal(10,2) [note: 'Daily interest accrual amount on the encumbrance, used to calculate payoff amounts at closing. Expressed in USD. Applicable to interest-bearing liens and mortgages.']
  prior_classification varchar [note: 'Previous encumbrance_type or encumbrance_status classification before the most recent reclassification. Preserves lifecycle history and prior classifications per VREQ-007.']
  release_date date [note: 'Date the encumbrance was released, satisfied, or reconveyed as recorded with the county. Populated when encumbrance_status transitions to released or satisfied.']
  release_instrument_number varchar [note: 'Recording instrument number of the release, satisfaction, reconveyance, or discharge document that extinguished this encumbrance. Supports curative evidence and chain-of-title clearance.']
  source_system_reference varchar [note: 'Identifier or reference code from the originating system of record (e.g., Title Plant, DataTrace, TitlePoint, county plant index) where this encumbrance was discovered or sourced.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the jurisdiction where the encumbrance is recorded. Used for state-specific lien law application and regulatory reporting.']
  subtype varchar [note: 'Further classification within the encumbrance type (e.g., federal tax lien vs. state tax lien, purchase money mortgage vs. HELOC, ROW easement vs. utility easement). Supports granular underwriting analysis.']
  tax_lien_serial_number varchar [note: 'IRS or state-assigned serial number for a federal or state tax lien certificate. Used to verify lien identity and obtain payoff or release from the taxing authority.']
  tax_year varchar [note: 'Tax year to which a tax lien or delinquent tax encumbrance applies. Applicable to federal, state, and county tax lien types. Supports tax lien aging and curative prioritization.']
  ucc_filing_number varchar [note: 'Secretary of State filing number for a UCC financing statement encumbering fixtures or personal property associated with the real property. Applicable to UCC filing encumbrance type.']
  updated_timestamp timestamp [note: 'Timestamp when this encumbrance record was last modified. Audit field supporting change tracking, curative workflow monitoring, and data lineage per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for each encumbrance, lien, or cloud on title affecting a parcel or property. Covers tax liens (federal, state, county), mechanics liens, judgment liens, HOA assessment liens, lis pendens (LP), deeds of trust (DOT), mortgages (PMM, HELOC'
}

Table ti_property.easement_restriction {
  easement_restriction_id varchar [pk, note: 'Unique surrogate identifier for each easement, right-of-way, covenant, condition, restriction, or encroachment record affecting a parcel. Primary key.']
  parcel_id varchar [note: 'Reference to the parcel record that is burdened or benefited by this easement or restriction. Core link to the property domain parcel entity.']
  property_id varchar [note: 'Reference to the parent property record associated with this easement or restriction, supporting property-level aggregation and title analysis.']
  recorded_instrument_id varchar [note: 'Reference to the recorded instrument (deed, plat, declaration, or separate easement document) that created or evidences this easement or restriction.']
  title_evidence_id varchar [note: 'Foreign key linking to property.title_evidence. Business justification: Easements and restrictions are discovered through title evidence documents. Replaces STRING evidence_document_ref with proper FK for provenance tracking per VREQ-009.']
  appurtenant_flag boolean [note: 'Indicates whether the easement runs with the land (appurtenant) as opposed to being an easement in gross. True = appurtenant; False = in gross. Affects transferability analysis.']
  area_sq_ft decimal(14,2) [note: 'Total area of the easement or restricted zone in square feet. Supports underwriting assessment of the proportional impact on the insured parcel.']
  benefiting_utility varchar [note: 'Name of the utility company, municipality, HOA, or other entity that holds or benefits from the easement. Relevant for utility, drainage, and ROW easements.']
  blanket_flag boolean [note: 'Indicates whether the easement is a blanket easement covering the entire parcel without a defined corridor. Blanket easements require special underwriting review and Schedule B-II exception language.']
  book_number varchar [note: 'Book or volume number in the county recorder index where the creating instrument is recorded. Used for plant search verification and chain-of-title assembly.']
  cc_r_document_name varchar [note: 'Name or title of the CC&R declaration document that contains the restriction, e.g., Declaration of Covenants, Conditions and Restrictions for [Subdivision Name].']
  classification_change_date date [note: 'Date on which the restriction type or underwriting impact classification was last changed. Supports lifecycle history and audit trail per VREQ-007.']
  curative_action_required boolean [note: 'Indicates whether a curative action (e.g., release, subordination, vacation, or survey correction) is required to resolve or modify this easement or restriction prior to closing.']
  curative_notes varchar [note: 'Free-text notes describing the curative action required or taken to address this easement or restriction, including status of release or vacation proceedings.']
  dominant_estate_description varchar [note: 'Legal description or narrative identifying the dominant tenement (benefited parcel) for appurtenant easements. Null for easements in gross or restrictions with no dominant estate.']
  easement_subtype varchar [note: 'Granular classification within the restriction type, e.g., utility easement, drainage easement, access easement, conservation easement, slope easement, pipeline easement.']
  effective_date date [note: 'Date the easement or restriction became legally effective, which may differ from execution or recording date. Distinct field per VREQ-008.']
  encroachment_description varchar [note: 'Narrative description of any physical encroachment associated with this record, including the encroaching structure, direction, and estimated extent. Populated when restriction_type = encroachment.']
  exception_language varchar [note: 'Verbatim or standardized exception language used in Schedule B-II of the title commitment or policy for this easement or restriction. Sourced from underwriter-approved language library.']
  exclusive_flag boolean [note: 'Indicates whether the easement is exclusive to the grantee, preventing the grantor or other parties from using the same area for the same purpose.']
  execution_date date [note: 'Date the easement or restriction instrument was signed by the grantor. Distinct from recording date and effective date per VREQ-008 date separation requirements.']
  expiration_date date [note: 'Date on which the easement or restriction expires by its own terms, if a fixed term is stated. Null for perpetual easements and restrictions.']
  fips_code varchar [note: 'Five-digit FIPS county code identifying the county where the easement or restriction is recorded. Supports multi-jurisdiction title plant queries and regulatory reporting.']
  grantee_name varchar [note: 'Name of the party who received the easement benefit or is bound by the restriction, as it appears in the recorded instrument. Supports grantee index and benefited-party identification.']
  grantor_name varchar [note: 'Name of the party who granted the easement or imposed the restriction, as it appears in the recorded instrument. Supports grantor/grantee index and chain-of-title analysis.']
  hoa_name varchar [note: 'Name of the Homeowners Association (HOA) that administers or enforces the CC&Rs or restriction, if applicable. Supports HOA lien and assessment tracking.']
  instrument_number varchar [note: 'County recorder assigned instrument or document number for the creating instrument. Primary external reference for eRecording and plant search systems.']
  location_description varchar [note: 'Narrative or metes-and-bounds description of the physical location and extent of the easement area or restricted zone on the parcel, as stated in the recorded instrument.']
  notes varchar [note: 'Free-text notes entered by the title examiner or underwriter regarding the nature, impact, or disposition of this easement or restriction. Supports examination workflow.']
  page_number varchar [note: 'Page number within the deed book where the creating instrument is recorded. Used together with book_number for precise plant index reference.']
  permitted_use varchar [note: 'Description of the specific use or activity permitted under the easement, e.g., installation and maintenance of underground utilities, pedestrian access, drainage.']
  prior_classification varchar [note: 'Previous restriction_type or underwriting_impact classification before the most recent reclassification. Preserves lifecycle history per VREQ-007 material lifecycle transition requirements.']
  prohibited_use varchar [note: 'Description of uses or activities expressly prohibited by the restriction or covenant, e.g., no structures within easement area, no commercial use, no subdivision below minimum lot size.']
  recording_date date [note: 'Date the instrument creating this easement or restriction was recorded with the county recorder or register of deeds. Establishes constructive notice and priority. Distinct field per VREQ-008.']
  reference_number varchar [note: 'Externally assigned identifier for this easement or restriction as recorded in the county plant or title plant index, e.g., instrument number, document number, or plant reference.']
  release_date date [note: 'Date on which the easement or restriction was formally released, vacated, or extinguished by recorded instrument. Supports lifecycle history and curative clearance tracking.']
  release_instrument_number varchar [note: 'County recorder instrument number of the recorded release, satisfaction, or vacation document that extinguished this easement or restriction.']
  restriction_status varchar [note: 'Current lifecycle state of the easement or restriction. Drives title clearance workflow and Schedule B-II exception inclusion or removal decisions.']
  restriction_text varchar [note: 'Verbatim or summarized text of the restriction, covenant, or easement purpose as stated in the recorded instrument. Used for Schedule B-II exception drafting and underwriting review.']
  restriction_type varchar [note: 'High-level classification of the use restriction. Drives underwriting treatment and Schedule B-II exception language. [ENUM-REF-CANDIDATE: easement|right_of_way|covenant|encroachment|cc_and_r|restriction|license|profit_a_prendre — promote to reference']
  schedule_b2_exception_flag boolean [note: 'Indicates whether this easement or restriction is included as a printed exception in Schedule B-II of the title commitment or policy. True = included as exception.']
  servient_estate_description varchar [note: 'Legal description or narrative identifying the servient tenement (burdened parcel) for appurtenant easements. Confirms which parcel bears the burden when multiple parcels are involved.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the easement or restriction is recorded. Supports state-level regulatory and underwriting rule application.']
  survey_reference varchar [note: 'Reference to the ALTA/NSPS land title survey or plat map that depicts the easement or encroachment, including surveyor name, date, and job number where available.']
  underwriting_impact varchar [note: 'Underwriting determination of how this easement or restriction affects insurability. Drives Schedule B-II exception inclusion, referral routing, and curative action assignment.']
  width_ft decimal(10,2) [note: 'Width of the easement corridor or restricted strip in feet, as stated in the recorded instrument. Used for survey verification and encroachment analysis.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for easements, rights-of-way (ROW), covenants, conditions and restrictions (CC&Rs), encroachments, and other use restrictions affecting a parcel.'
}

Table ti_property.tax_assessment {
  tax_assessment_id varchar [pk, note: 'Unique surrogate identifier for each tax assessment record in the title insurance property domain. Primary key for the tax_assessment product.']
  parcel_id varchar [note: 'Reference to the parcel entity for which this tax assessment applies. Links the assessment to the authoritative parcel record in the property domain.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Tax assessments roll up to property level for title clearance analysis. While tax_assessment → parcel exists for the legal unit, property-level aggregation is needed for reporting']
  annual_tax_amount decimal(18,2) [note: 'Total annual property tax levy billed for the parcel for the tax year, computed from net taxable value and tax rate. Used in settlement statement (CD/HUD-1) proration calculations.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor to uniquely identify the taxable parcel. Also known as PIN (Parcel Identification Number) in some jurisdictions.']
  appeal_adjusted_value decimal(18,2) [note: 'Revised total assessed value as determined by the county appeals board following a successful appeal. Replaces total_assessed_value for billing if appeal is resolved.']
  appeal_filed_date date [note: 'Date on which the assessment appeal was filed with the county appeals board. Populated only when appeal_flag is true.']
  appeal_flag boolean [note: 'Indicates whether a formal appeal of the assessed value has been filed with the county assessment appeals board for this tax year.']
  appeal_resolution_date date [note: 'Date on which the assessment appeal was resolved by the county appeals board. Null if appeal is still pending.']
  assessment_date date [note: 'Date on which the county assessor established the assessed value for this tax year. Represents the principal real-world event date for this assessment record.']
  assessment_status varchar [note: 'Current lifecycle status of the assessment record: preliminary (not yet certified), certified (official), appealed (under formal appeal), adjusted (post-appeal change), or final.']
  assessment_type varchar [note: 'Classification of the assessment: annual (regular cycle), supplemental (triggered by ownership change or improvement), corrected, escaped (omitted prior year), or special district levy.']
  certified_date date [note: 'Date the county assessor officially certified the assessment roll for this parcel and tax year. Marks transition from preliminary to certified status.']
  data_as_of_date date [note: 'Date as of which the assessment data was retrieved or last refreshed from the county assessor or property information system. Indicates data currency for title examination.']
  delinquent_amount decimal(18,2) [note: 'Outstanding delinquent tax balance including penalties and interest as of the most recent update. A non-zero value triggers a title requirement for payoff at closing.']
  effective_date date [note: 'Date from which this assessment record is operative for billing and lien purposes. Distinct from assessment_date (valuation date) and lien_date (lien attachment date).']
  exemption_amount decimal(18,2) [note: 'Dollar amount of assessed value exempted from taxation (e.g., homestead, veteran, senior, or nonprofit exemptions). Reduces the net taxable value.']
  exemption_type varchar [note: 'Classification of the exemption applied to this assessment: homestead, veteran, senior, nonprofit, agricultural, or none. Affects net taxable value and lien exposure.']
  fips_code varchar [note: 'Five-digit FIPS code identifying the state and county of the taxing jurisdiction. Used for jurisdictional routing and regulatory reporting.']
  first_installment_amount decimal(18,2) [note: 'Amount due for the first installment of the annual property tax bill. Relevant for escrow proration and closing disclosure preparation.']
  first_installment_due_date date [note: 'Due date for the first installment of the property tax bill. Used to determine delinquency status and escrow disbursement timing.']
  improvement_assessed_value decimal(18,2) [note: 'County assessor\'s assessed value allocated to structures and improvements on the parcel, exclusive of land. Supports LTV and coverage analysis.']
  interest_amount decimal(18,2) [note: 'Interest charges accrued on delinquent taxes as assessed by the county tax collector. Included in payoff demand for title clearance.']
  land_assessed_value decimal(18,2) [note: 'County assessor\'s assessed value allocated to the land component of the parcel, exclusive of improvements. Used in underwriting and title risk analysis.']
  lien_date date [note: 'Date on which the property tax lien attaches to the parcel by operation of law. Critical for title examination to determine priority of tax liens relative to other encumbrances.']
  net_taxable_value decimal(18,2) [note: 'Assessed value after deducting all applicable exemptions. This is the base upon which the tax levy is calculated by the taxing authority.']
  paid_amount decimal(18,2) [note: 'Total dollar amount paid against this tax assessment to date. Supports partial payment tracking and delinquency calculation.']
  paid_date date [note: 'Date on which the property tax was paid in full or the most recent installment was paid. Used to confirm tax clearance at closing.']
  payment_status varchar [note: 'Current payment status of the tax bill: paid, unpaid, partial, delinquent, or in_redemption (tax sale redemption period). Drives title clearance and lien exception decisions.']
  penalty_amount decimal(18,2) [note: 'Penalty charges accrued on delinquent taxes as assessed by the county tax collector. Included in payoff demand for title clearance.']
  prior_year_assessed_value decimal(18,2) [note: 'Total assessed value from the immediately preceding tax year. Supports year-over-year valuation trend analysis and appeal basis determination.']
  record_created_timestamp timestamp [note: 'Timestamp when this tax assessment record was first created in the title insurance data platform. Audit field for data lineage and provenance tracking.']
  record_updated_timestamp timestamp [note: 'Timestamp when this tax assessment record was most recently updated in the title insurance data platform. Supports change tracking and data freshness monitoring.']
  redemption_expiry_date date [note: 'Date by which the prior owner must redeem the parcel after a tax sale. After this date, the tax deed purchaser obtains clear title. Critical for title examination.']
  second_installment_amount decimal(18,2) [note: 'Amount due for the second installment of the annual property tax bill. Relevant for escrow proration and closing disclosure preparation.']
  second_installment_due_date date [note: 'Due date for the second installment of the property tax bill. Used to determine delinquency status and escrow disbursement timing.']
  source_system_ref varchar [note: 'Identifier or reference code from the originating county assessor or property information system (e.g., DataTrace, TitlePoint) from which this record was sourced.']
  special_assessment_amount decimal(18,2) [note: 'Annual dollar amount of special assessments levied against the parcel (e.g., Mello-Roos CFD, local improvement district). Disclosed on the closing disclosure.']
  special_assessment_flag boolean [note: 'Indicates whether a special assessment (e.g., Mello-Roos, improvement district, HOA assessment lien) is levied against the parcel in addition to general property taxes.']
  tax_bill_number varchar [note: 'Externally assigned tax bill or statement number issued by the county tax collector for this assessment year. Used for payment tracking and lien verification.']
  tax_district_code varchar [note: 'Code identifying the tax rate area or tax district within the county that governs the composite mill rate applied to this parcel.']
  tax_rate decimal(10,6) [note: 'Composite tax rate (mill rate) applied to the net taxable value to compute the annual tax levy. Expressed as a decimal (e.g., 0.012500 = 1.25%). Includes all overlapping taxing districts.']
  tax_sale_date date [note: 'Date of the tax sale at which the parcel was or is scheduled to be sold for delinquent taxes. Populated only when tax_sale_flag is true.']
  tax_sale_flag boolean [note: 'Indicates whether the parcel has been sold or is scheduled for sale at a tax sale due to delinquency. A true value is a critical title defect requiring curative action.']
  tax_year varchar [note: 'Calendar or fiscal year for which this tax assessment applies. Supports year-by-year valuation and payment history tracking per the SSOT mandate.']
  taxing_authority_name varchar [note: 'Name of the primary taxing authority (county tax collector or treasurer) responsible for billing and collecting property taxes for this parcel.']
  total_assessed_value decimal(18,2) [note: 'Sum of land and improvement assessed values as certified by the county assessor for the tax year. Authoritative valuation figure for tax billing and title underwriting.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Annual or supplemental tax and assessment record for a parcel, sourced from the county assessor and tax collector. This product is the AUTHORITATIVE SSOT for year-by-year valuation and payment history; parcel carries only current/point-in-time summary'
}

Table ti_property.lifecycle_event {
  lifecycle_event_id varchar [pk, note: 'Unique surrogate identifier for each property lifecycle event record in the Property Information and County Data System.']
  easement_restriction_id varchar [note: 'Foreign key linking to property.easement_restriction. Business justification: Lifecycle events track easement and restriction changes (grants, releases, modifications).']
  encumbrance_id varchar [note: 'Foreign key linking to property.encumbrance. Business justification: Lifecycle events track lien recordings, releases, and encumbrance status changes. Direct FK to specific encumbrance record needed for complete lifecycle tracking per VREQ-007.']
  legal_description_id varchar [note: 'Reference to the legal_description entity affected by this event. Populated when the event involves a legal description amendment or replacement.']
  ownership_interest_id varchar [note: 'Reference to the ownership_interest record created or superseded by this lifecycle event. Supports effective-dated ownership chain per VREQ-005.']
  parcel_id varchar [note: 'Reference to the parcel entity affected by this lifecycle event. Populated when the event is parcel-specific (e.g., parcel split/merge, APN reassignment).']
  property_id varchar [note: 'Reference to the property entity that is the subject of this lifecycle event. Establishes the authoritative property context for the event.']
  recording_submission_id varchar [note: 'Foreign key linking to recording.recording_submission. Business justification: Lifecycle events track recording submission outcomes (acceptance, rejection, gap periods)—operational workflow for monitoring recording status, gap coverage periods, and policy']
  superseded_event_id varchar [note: 'Self-referencing identifier of the prior lifecycle event that this record supersedes or amends. Null for original events. Preserves revision history and prior classifications per VREQ-007.']
  tax_assessment_id varchar [note: 'Foreign key linking to property.tax_assessment. Business justification: Tax assessment changes (supplemental assessments, appeals, tax lien filings) are material lifecycle events.']
  title_evidence_id varchar [note: 'Foreign key linking to property.title_evidence. Business justification: Lifecycle events are triggered by or documented through title evidence. Links the event to its source evidence document for provenance per VREQ-009 evidence and provenance']
  title_order_id varchar [note: 'Reference to the title order in the Title Production System (e.g., SoftPro/RamQuest) that triggered or is associated with this lifecycle event. Supports end-to-end title workflow traceability.']
  acceptance_date date [note: 'Date the county recorder formally accepted the instrument for recording. Per VREQ-008, distinct from submission_date and recording_date. Null if not yet accepted or rejected.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor at the time of this lifecycle event. Captures the APN as it existed at event time, supporting parcel split/merge history.']
  book_number varchar [note: 'Official deed book or volume number assigned by the county recorder where the instrument is indexed. Used in conjunction with page_number for traditional county recording references.']
  chain_of_title_break boolean [note: 'Indicates whether this lifecycle event introduces or resolves a break in the chain of title. True signals a COT defect requiring curative action or underwriting review.']
  consideration_amount decimal(18,2) [note: 'Dollar amount of consideration stated in the instrument evidencing this lifecycle event (e.g., purchase price on a deed). Used for transfer tax calculation and underwriting risk assessment.']
  created_timestamp timestamp [note: 'Timestamp when this lifecycle event record was first created in the lakehouse Silver layer. Audit field distinct from event_timestamp (the real-world event time).']
  curative_required boolean [note: 'Indicates whether this lifecycle event requires curative processing to clear a defect, lien, or encumbrance before title can be insured. Drives curative workflow initiation.']
  curative_status varchar [note: 'Current status of curative processing for this lifecycle event. Tracks progress from identification through clearance or waiver. Null when curative_required is false.']
  effective_date date [note: 'Calendar date on which the lifecycle change becomes legally effective for title and ownership purposes. Per VREQ-008, distinct from execution_date, recording_date, and other document date fields.']
  encumbrance_type varchar [note: 'Type of encumbrance, easement, or restriction associated with this lifecycle event. Populated for encumbrance_attachment and encumbrance_release event types.']
  erecording_flag boolean [note: 'Indicates whether the instrument associated with this lifecycle event was submitted and recorded electronically via an eRecording gateway (e.g., Simplifile, CSC eRecording).']
  event_notes varchar [note: 'Free-text field for examiner or processor notes describing the nature, context, or significance of this lifecycle event. Supports curative and underwriting review workflows.']
  event_number varchar [note: 'Externally visible, human-readable identifier for this lifecycle event (e.g., LE-2024-00123). Used for cross-system traceability and audit references.']
  event_status varchar [note: 'Current workflow state of this lifecycle event record. Superseded indicates a later event has replaced this one; voided indicates the event was recorded in error.']
  event_subtype varchar [note: 'Secondary classification providing finer granularity within an event_type (e.g., within vesting_change: joint_tenancy_to_tenancy_in_common, addition_of_co_owner). Free-form or controlled per event_type.']
  event_timestamp timestamp [note: 'The precise date and time the real-world lifecycle transition occurred or was legally effective. This is the principal business event time, distinct from record audit timestamps.']
  event_type varchar [note: 'Categorical discriminator identifying the kind of material lifecycle transition captured. [ENUM-REF-CANDIDATE']
  evidence_document_ref varchar [note: 'Reference identifier or URI to the supporting evidence document in the Document Management and Imaging System (e.g., scanned deed, recorded instrument image). Supports evidence provenance per VREQ-007.']
  execution_date date [note: 'Date the underlying instrument or document evidencing this lifecycle event was signed/executed by the parties. Per VREQ-008, distinct from effective_date and recording_date.']
  fips_code varchar [note: 'Five-digit FIPS county code identifying the jurisdiction where this lifecycle event was recorded. Supports county-level reporting and routing to the correct recorder office.']
  gap_period_flag boolean [note: 'Indicates whether this lifecycle event falls within a gap period between the effective date of a title search and the recording of the insured instrument. Supports GAP coverage analysis.']
  grantee_name varchar [note: 'Name of the grantee (receiving party) associated with the instrument evidencing this lifecycle event. Supports grantor/grantee index and chain-of-title assembly.']
  grantor_name varchar [note: 'Name of the grantor (transferring party) associated with the instrument evidencing this lifecycle event. Supports grantor/grantee index and chain-of-title assembly.']
  instrument_number varchar [note: 'Official document/instrument number assigned by the county recorder upon recording. Used to cross-reference the recorded instrument in the county index and title plant.']
  instrument_type varchar [note: 'Type of recorded instrument evidencing this lifecycle event (e.g., WD, QCD, SWD, DOT, reconveyance). [ENUM-REF-CANDIDATE']
  lien_amount decimal(18,2) [note: 'Dollar amount of the lien, encumbrance, or judgment associated with this lifecycle event (e.g., mechanics lien, tax lien, HOA assessment). Null for non-lien event types.']
  new_classification varchar [note: 'The property type, vesting form, parcel status, or legal description classification established by this lifecycle event. Paired with prior_classification to document the transition.']
  new_vesting varchar [note: 'The vesting language or tenancy form established by this lifecycle event. Null for non-vesting event types. Supports chain-of-title and ownership interest analysis.']
  notarization_type varchar [note: 'Method by which the instrument was notarized: traditional in-person, Remote Online Notarization (RON), or In-Person Electronic Notarization (IPEN). Supports compliance and validity tracking.']
  notary_name varchar [note: 'Name of the notary public who acknowledged the instrument associated with this lifecycle event. Supports document validity verification and RON/IPEN compliance tracking.']
  page_number varchar [note: 'Official page number within the deed book assigned by the county recorder. Used with book_number for traditional county recording cross-reference.']
  prior_apn varchar [note: 'The APN that existed before a parcel split, merge, or reassignment event. Null for non-parcel-change events. Supports parcel lineage and chain-of-title continuity.']
  prior_classification varchar [note: 'The property type, vesting form, parcel status, or legal description classification that existed immediately before this lifecycle event. Preserves prior state per VREQ-007 for chain-of-title and audit analysis.']
  prior_vesting varchar [note: 'The vesting language or tenancy form (e.g., joint tenancy, tenancy in common, community property) in effect before a vesting_change event. Null for non-vesting event types.']
  recorded_by_party varchar [note: 'Name of the party (individual, title company, or attorney) who submitted the instrument for recording with the county recorder. Supports recording accountability and audit.']
  recording_date date [note: 'Date the instrument evidencing this lifecycle event was recorded with the county recorder or register of deeds. Per VREQ-008, distinct from execution_date and effective_date.']
  revision_number varchar [note: 'Sequential revision counter for this lifecycle event record. Starts at 1 for the original event; increments with each amendment. Supports lifecycle history tracking per VREQ-007.']
  revision_reason varchar [note: 'Free-text explanation of why this lifecycle event record was revised or superseded (e.g., corrective deed recorded, APN reassigned by assessor). Required when revision_number > 1.']
  source_system_event_code varchar [note: 'Native identifier of this lifecycle event in the originating operational system (e.g., DataTrace event ID, Simplifile submission ID). Supports cross-system reconciliation and provenance.']
  submission_date date [note: 'Date the instrument was submitted to the county recorder for recording. Per VREQ-008, distinct from acceptance_date and recording_date. Supports recording rejection and resubmission tracking.']
  transfer_tax_amount decimal(18,2) [note: 'Documentary transfer tax or deed stamp tax assessed on this lifecycle event by the county or state. Relevant for deed-type events; null for non-transfer events.']
  updated_timestamp timestamp [note: 'Timestamp when this lifecycle event record was last modified in the lakehouse Silver layer. Supports change data capture, audit trails, and incremental processing.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Transactional record capturing material lifecycle transitions and reclassifications for a property, parcel, or ownership interest per VREQ-007. Event types include: property type reclassification, parcel split/merge, legal description amendment, vesting'
}

Table ti_property.grantor_grantee_index {
  grantor_grantee_index_id varchar [pk, note: 'Unique surrogate identifier for each grantor-grantee index record linking a grantor and grantee party to a recorded instrument affecting a parcel or property.']
  grantor_grantee_party_id varchar [note: 'Reference to the party record representing the grantee (transferee, mortgagee, lienholder) named in the recorded instrument.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Each grantor/grantee index entry references specific legal description (property being conveyed).']
  parcel_id varchar [note: 'Reference to the parcel record affected by the recorded instrument captured in this grantor-grantee index entry.']
  primary_grantor_party_id varchar [note: 'Reference to the party record representing the grantor (transferor, mortgagor, lienor) named in the recorded instrument.']
  prior_index_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding grantor-grantee index entry in the chain of title for this parcel, enabling linked-list traversal of ownership history.']
  property_id varchar [note: 'Reference to the property record associated with this grantor-grantee index entry, providing the authoritative property context for the instrument.']
  recorded_instrument_id varchar [note: 'Reference to the recorded instrument (deed, mortgage, release, lien, etc.) that this grantor-grantee index entry indexes.']
  apn varchar [note: 'Assessor\'s Parcel Number as it appears on the recorded instrument or in the county index, used to link the index entry to the parcel record and support property-specific chain-of-title searches.']
  book_number varchar [note: 'Official deed book or volume number assigned by the county recorder where the instrument is physically or digitally recorded, used for traditional book-and-page citation.']
  chain_of_title_sequence varchar [note: 'Ordinal sequence number of this index entry within the chain of title for the parcel, enabling ordered traversal of ownership history from earliest to most recent conveyance.']
  consideration_amount decimal(18,2) [note: 'Dollar amount of consideration stated in the instrument (e.g., purchase price on a deed). May be nominal ($1.00) or actual; used for transfer tax calculation and market value analysis.']
  consideration_currency varchar [note: 'ISO 4217 three-letter currency code for the consideration amount stated in the instrument. Typically USD for domestic US title transactions.']
  cot_break_description varchar [note: 'Free-text description of the nature of the chain-of-title break detected at this index entry, used by examiners to document the defect and initiate curative processing.']
  cot_break_flag boolean [note: 'Indicates a detected break or gap in the chain of title at this index entry (e.g., grantor does not match prior grantee), triggering curative action or underwriting referral.']
  county_name varchar [note: 'Name of the county or recording jurisdiction where the instrument was recorded, complementing the FIPS code for human-readable identification of the recording authority.']
  created_timestamp timestamp [note: 'Timestamp when this grantor-grantee index record was first created in the system of record, used for audit trail and data provenance tracking.']
  effective_date date [note: 'Date the instrument becomes legally effective, which may differ from execution or recording date. Distinct from execution_date, recording_date, submission_date, and acceptance_date per VREQ-008.']
  estate_type varchar [note: 'Type of estate or interest conveyed by the instrument (e.g., fee simple, life estate, leasehold, easement), used to classify the nature of the ownership interest transferred.']
  execution_date date [note: 'Date the instrument was signed/executed by the grantor. Distinct from recording date, effective date, and acceptance date per VREQ-008 date separation requirements.']
  fips_code varchar [note: 'Five-digit FIPS county code identifying the county where the instrument was recorded, used to route searches to the correct county recorder index and title plant.']
  grantee_entity_type varchar [note: 'Classification of the grantee as an individual person or legal entity type, used to assess vesting capacity and taking title. [ENUM-REF-CANDIDATE: individual|corporation|llc|trust|partnership|government|estate|other — promote to reference product]']
  grantee_name_as_indexed varchar [note: 'Full name of the grantee exactly as it appears in the county recorder or title plant grantor-grantee index, preserving original spelling for chain-of-title search accuracy.']
  grantee_name_standardized varchar [note: 'Normalized/standardized form of the grantee name used for fuzzy matching and chain-of-title continuity analysis across index entries with spelling variations.']
  grantor_entity_type varchar [note: 'Classification of the grantor as an individual person or legal entity type, used to assess vesting capacity and authority to convey. [ENUM-REF-CANDIDATE: individual|corporation|llc|trust|partnership|government|estate|other — promote to reference product]']
  grantor_name_as_indexed varchar [note: 'Full name of the grantor exactly as it appears in the county recorder or title plant grantor-grantee index, preserving original spelling for chain-of-title search accuracy.']
  grantor_name_standardized varchar [note: 'Normalized/standardized form of the grantor name used for fuzzy matching and chain-of-title continuity analysis across index entries with spelling variations.']
  index_entry_date date [note: 'Date this grantor-grantee index record was entered into the title plant or internal system, which may differ from the county recording date for plant-lag tracking.']
  index_source varchar [note: 'Source system or authority from which this grantor-grantee index entry was obtained (e.g., county recorder direct, DataTrace title plant, TitlePoint). Supports evidence provenance tracking.']
  index_status varchar [note: 'Current lifecycle status of this grantor-grantee index record. \'Superseded\' indicates a corrected or amended instrument has replaced this entry in the chain of title.']
  instrument_number varchar [note: 'Official instrument number or document number assigned by the county recorder or register of deeds at the time of recording, used as the primary external reference for the recorded instrument.']
  instrument_type varchar [note: 'Type of recorded instrument captured by this index entry (e.g., Warranty Deed (WD), Quit Claim Deed (QCD), Deed of Trust (DOT), mortgage, release, lien). [ENUM-REF-CANDIDATE']
  lien_position varchar [note: 'Priority position of the lien or encumbrance created by the instrument (1 = first lien, 2 = second lien, etc.), determined by recording date and any subordination agreements.']
  loan_amount decimal(18,2) [note: 'Original principal loan amount secured by the instrument (applicable to deeds of trust, mortgages, HELOCs). Used for lien priority analysis and Loan-to-Value (LTV) assessment.']
  nominal_consideration_flag boolean [note: 'Indicates whether the stated consideration is nominal (e.g., $1.00 or \'love and affection\') rather than the actual market value, signaling a non-arm\'s-length transfer for underwriting review.']
  notary_commission_expiry_date date [note: 'Expiration date of the notary\'s commission at the time of acknowledgment, used to verify the notary was duly commissioned when the instrument was executed.']
  notary_name varchar [note: 'Name of the notary public who acknowledged the grantor\'s signature on the instrument, as recorded in the acknowledgment clause. Used to verify proper execution.']
  page_number varchar [note: 'Official page number within the deed book or volume where the instrument is recorded, completing the book-and-page citation used in chain-of-title references.']
  recording_date date [note: 'Date the instrument was officially recorded by the county recorder or register of deeds. Distinct from execution date and effective date; establishes priority in the chain of title.']
  recording_timestamp timestamp [note: 'Exact date and time the instrument was stamped as recorded by the county recorder, used for priority determination when multiple instruments are recorded on the same date.']
  release_instrument_number varchar [note: 'Instrument number of the recorded release, reconveyance, or satisfaction that discharged the lien or encumbrance created by this instrument, if applicable.']
  release_recording_date date [note: 'Date the release, reconveyance, or satisfaction of the instrument was recorded, confirming the lien or encumbrance has been discharged from the chain of title.']
  source_reference_number varchar [note: 'External reference number assigned by the source system (county recorder, title plant, or eRecording gateway) for this index entry, used for reconciliation and audit traceability.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state where the instrument was recorded, used for jurisdiction routing and regulatory compliance.']
  transfer_tax_amount decimal(18,2) [note: 'Documentary transfer tax or deed stamp tax amount paid at recording, as noted on the instrument face. Used for consideration verification and tax compliance reporting.']
  updated_timestamp timestamp [note: 'Timestamp when this grantor-grantee index record was last modified in the system of record, supporting change tracking and lifecycle history preservation per VREQ-007.']
  vesting_type varchar [note: 'Form of title vesting by which the grantee takes ownership (e.g., joint tenancy, tenancy in common, community property), critical for ownership interest modeling and survivorship analysis.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Index record linking a grantor party and a grantee party to a recorded instrument affecting a parcel or property, supporting grantor/grantee name-index searches as performed against the title plant and county recorder indices.'
}

Table ti_underwriting.title_finding {
  title_finding_id varchar [pk, note: 'Unique surrogate primary key for each title finding record. Globally unique identifier assigned by the Title Production System upon discovery of a defect, encumbrance, lien, or anomaly during title examination.']
  operations_title_examination_id varchar [note: 'Foreign key reference to the title examination session during which this finding was identified. Preserves provenance of the examiner review that produced the finding.']
  parcel_id varchar [note: 'Reference to the parcel record affected by this finding. Links the finding to the specific parcel (APN/PIN) in the Property Information and County Data System. Supports property-level defect and lien analysis.']
  party_id varchar [note: 'Reference to the title examiner (party) who identified and documented this finding during the examination. Supports examiner productivity and quality metrics. Maps to the party entity per VREQ-006.']
  title_evidence_id varchar [note: 'Reference to the primary supporting document or recorded instrument in the Document Management and Imaging System that is the evidentiary basis for this finding. Supports evidence completeness and provenance per VREQ-007.']
  title_order_id varchar [note: 'Foreign key reference to the parent title order under which this finding was discovered. Links the finding to the originating order intake record for end-to-end lifecycle traceability.']
  title_search_id varchar [note: 'Foreign key reference to the title search that surfaced the underlying instrument or record giving rise to this finding. Maintains evidence provenance from search through examination.']
  affects_full_parcel boolean [note: 'Flag indicating whether this finding affects the entire parcel or only a portion of it. When false, the partial_area_description field provides the specific affected area. Relevant for easements, encroachments, and partial liens.']
  book_volume varchar [note: 'Book or volume number in the county recorder index where the instrument is recorded. Part of the official recording reference used to locate the instrument in the title plant or county records.']
  cleared_date date [note: 'Date the finding was resolved and cleared through curative action, payoff, release, or satisfaction. Null if finding remains open. Used to calculate curative cycle time and clearance effectiveness metrics.']
  cot_break_indicator boolean [note: 'Flag indicating whether this finding represents a break or gap in the chain of title (COT). A true value triggers mandatory underwriting review and curative action before commitment issuance. Key metric per VREQ-016.']
  created_timestamp timestamp [note: 'Timestamp when this title finding record was first created in the lakehouse Silver layer. Represents the RECORD_AUDIT_CREATED category. Used for data lineage and ingestion audit purposes.']
  curative_action_required boolean [note: 'Flag indicating whether this finding requires a curative action (CPM/GAPcure) to clear the defect before the title commitment or policy can be issued. Drives curative aging and effectiveness metrics.']
  curative_deadline_date date [note: 'Target date by which curative action must be completed to meet the closing schedule. Used to identify aging and at-risk findings that may delay closing readiness. Supports closing readiness metrics per VREQ-016.']
  curative_notes varchar [note: 'Free-text notes documenting curative actions taken, outstanding items, and resolution steps for this finding. Maintained by the curative processor throughout the clearance lifecycle.']
  discovery_date date [note: 'Date the finding was identified during title examination. Represents the principal business event date (BUSINESS_EVENT_TIMESTAMP category). Used to calculate curative aging and open-requirement aging metrics per VREQ-016.']
  document_number varchar [note: 'County recorder-assigned document or instrument number for the recorded instrument. Primary reference used in eRecording and title plant lookups (DataTrace/TitlePoint). May substitute or supplement book/page.']
  finding_description varchar [note: 'Free-text narrative description of the title defect, encumbrance, lien, cloud, or anomaly as documented by the examiner. Captures the specific nature of the issue including parties, amounts, and legal basis.']
  finding_number varchar [note: 'Human-readable business identifier for the finding, typically assigned by the Title Production System (e.g., SoftPro/RamQuest). Used in examiner notes, curative memos, and commitment schedules for cross-reference.']
  finding_status varchar [note: 'Current lifecycle status of the title finding. Drives open/aging requirement metrics and curative action tracking. Transitions from open through curative processing to cleared, excepted on Schedule B-II, or waived.']
  finding_type varchar [note: 'Categorical classification of the title defect or encumbrance discovered. [ENUM-REF-CANDIDATE: tax_lien|judgment_lien|mechanics_lien|lis_pendens|ucc_filing|easement|encroachment|cot_break|vesting_defect|hoa_lien|deed_of_trust|mortgage|cc_and_r|row|other —']
  gap_period_indicator boolean [note: 'Flag indicating whether this finding falls within the gap period between the effective date of the title search and the recording of the insured instrument. Triggers gap coverage (GAPcure) analysis.']
  grantee_name varchar [note: 'Name of the grantee, creditor, or beneficiary on the instrument giving rise to this finding. Used in chain-of-title assembly and lien holder identification.']
  grantor_name varchar [note: 'Name of the grantor, debtor, or obligor on the instrument giving rise to this finding. Used in chain-of-title analysis and vesting verification. Not a direct personal identifier in the context of recorded public instruments.']
  instrument_date date [note: 'Date the underlying instrument giving rise to this finding was executed or created. Distinct from recording date; used in chain-of-title analysis and lien priority determination.']
  instrument_type varchar [note: 'Type of recorded or filed instrument that is the source of the finding (e.g., Deed of Trust, Warranty Deed, Quit Claim Deed, Judgment, Tax Certificate, UCC-1, Lis Pendens, Mechanics Lien).']
  is_active boolean [note: 'Flag indicating whether this is the current active version of the finding record. Supports soft-delete and record versioning patterns in the Silver layer. False indicates the record has been superseded or logically deleted.']
  lien_amount decimal(18,2) [note: 'Dollar amount of the lien, judgment, or monetary encumbrance associated with this finding. Applicable for tax liens, judgment liens, mechanics liens, HOA assessments, and mortgage/DOT balances. Null for non-monetary findings.']
  lien_amount_currency varchar [note: 'ISO 4217 three-letter currency code for the lien_amount. Defaults to USD for domestic US title transactions. Included for completeness and potential commercial cross-border transactions.']
  lien_priority varchar [note: 'Numeric priority rank of the lien or encumbrance relative to other encumbrances on the property. Lower number indicates higher priority. Used in underwriting analysis and payoff sequencing at settlement.']
  page_number varchar [note: 'Page number in the county recorder index where the instrument is recorded. Combined with book_volume forms the complete recording reference for the source instrument.']
  partial_area_description varchar [note: 'Legal or narrative description of the portion of the parcel affected by this finding when affects_full_parcel is false. Used for easements, encroachments, rights-of-way, and partial lien coverage analysis.']
  prior_classification varchar [note: 'Previous finding_type or risk_classification value before the most recent reclassification. Preserves material prior classifications per VREQ-007 to support lifecycle history and audit trail without a separate history table.']
  reclassification_date date [note: 'Date on which the finding was reclassified from its prior_classification to the current finding_type or risk_classification. Null if no reclassification has occurred. Supports lifecycle revision history per VREQ-007.']
  reclassification_reason varchar [note: 'Business reason or justification for reclassifying this finding from its prior classification. Documents the examiner or underwriter rationale for the change to support audit and provenance requirements per VREQ-007.']
  recording_date date [note: 'Date the instrument was recorded or filed with the county recorder or register of deeds. Establishes constructive notice and lien priority in the chain of title. Distinct from instrument_date per VREQ-008.']
  risk_classification varchar [note: 'Underwriting determination of whether the finding renders title insurable, marketable, or requires curative action or referral. Supports insurable/marketable-title determination metrics per VREQ-016.']
  schedule_b_disposition varchar [note: 'Disposition of this finding on the title commitment Schedule B. A value of \'requirement\' places it on Schedule B-I; \'exception\' places it on Schedule B-II. Legally distinct per VREQ-002 and VREQ-017.']
  severity varchar [note: 'Underwriter-assigned severity level indicating the risk impact of the finding on insurability or marketability of title. Critical findings typically require curative action or underwriting referral before commitment issuance.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this finding originated (e.g., SoftPro Select, RamQuest Horizon, Qualia, DataTrace, TitlePoint). Supports data lineage and SoR traceability.']
  source_system_finding_ref varchar [note: 'Native identifier or reference number assigned to this finding by the originating operational system of record (e.g., SoftPro finding ID, RamQuest defect code). Enables reconciliation back to the SoR.']
  updated_timestamp timestamp [note: 'Timestamp when this title finding record was last modified in the lakehouse Silver layer. Represents the RECORD_AUDIT_UPDATED category. Used to detect stale records and track curative progress over time.']
  uw_referral_required boolean [note: 'Flag indicating whether this finding requires escalation to an underwriting referral (UWR) for senior underwriter review and approval before the commitment can be issued. Supports UW referral rate metrics.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Authoritative SSOT for every defect, encumbrance, lien, cloud, or anomaly discovered during title examination. Each record captures the finding type (tax lien, judgment lien, mechanics lien, LP, UCC, easement, encroachment, chain-of-title break, vesting'
}

Table ti_underwriting.title_requirement {
  title_requirement_id varchar [pk, note: 'Unique surrogate primary key for the title requirement record (Schedule B-I item). Globally unique across all requirement records in the title production system.']
  operations_title_examination_id varchar [note: 'Reference to the title examination session during which this requirement was identified. Supports provenance tracing from examination to curative action.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Requirements often apply to specific parcels (tax liens, easements, boundary issues). Parcel-level tracking enables curative action targeting, Schedule B exception mapping by parcel']
  prior_requirement_title_requirement_id varchar [note: 'Self-referencing link to the previous version of this requirement record when a material revision occurred. Preserves lifecycle history per VREQ-007.']
  title_commitment_id varchar [note: 'Reference to the title commitment on which this requirement appears as a Schedule B-I item. Null if requirement predates commitment issuance.']
  title_finding_id varchar [note: 'Reference to the specific title finding (defect, lien, encumbrance, or cloud on title) that necessitated this Schedule B-I requirement. Core provenance link.']
  title_order_id varchar [note: 'Foreign key reference to the originating title order that generated this Schedule B-I requirement. Links the requirement to its parent transaction context.']
  title_search_id varchar [note: 'Foreign key linking to operations.title_search. Business justification: Requirements often cite specific search findings (instrument references, recording dates).']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record if this requirement triggered a formal UWR. Null when is_underwriter_referral is False.']
  added_to_commitment_date date [note: 'Date this requirement was formally added to the title commitment as a Schedule B-I item. May differ from identified_date if added during a commitment revision.']
  applies_to_policy_type varchar [note: 'Indicates whether this requirement applies to the owner policy (OTP), lender policy (LTP), or both. Supports owner-versus-lender coverage analysis per VREQ-010.']
  assigned_curative_processor varchar [note: 'Name or identifier of the internal curative processor or title officer assigned to manage resolution of this requirement. Supports workload and aging analysis.']
  commitment_schedule_section varchar [note: 'Identifies the commitment schedule section where this item appears. Title requirements appear in Schedule B-I (requirements to be satisfied before policy issuance).']
  confirmed_payoff_amount decimal(18,2) [note: 'Confirmed dollar amount from the payoff demand letter or lien release documentation. Supersedes estimated_payoff_amount once verified. Used for final settlement reconciliation.']
  created_timestamp timestamp [note: 'Timestamp when this title requirement record was first created in the system. Used for audit trail and curative aging baseline calculations.']
  curative_action_type varchar [note: 'Specific curative action being taken to resolve this requirement (e.g., obtain payoff, order release, record document). Aligns with CPM/GAPcure workflow steps. [ENUM-REF-CANDIDATE: promote to reference product]']
  curative_memo_reference varchar [note: 'Reference number or identifier of the Curative Processing Memo (CPM) associated with the resolution effort for this requirement. Links to document management system.']
  due_date date [note: 'Target date by which this requirement must be satisfied to support the scheduled closing date. Used for curative aging and closing readiness dashboards.']
  estimated_payoff_amount decimal(18,2) [note: 'Estimated dollar amount required to satisfy this requirement (e.g., mortgage payoff, tax lien amount, judgment amount). Used for settlement statement preparation and escrow funding.']
  evidence_document_reference varchar [note: 'Document management system reference (document ID or URL) for the evidence supporting satisfaction of this requirement (e.g., recorded release, payoff confirmation letter).']
  gap_coverage_required boolean [note: 'Indicates whether gap coverage is required for this requirement, meaning the curative action must address the gap period between search date and recording date (GAPcure).']
  grantee_name varchar [note: 'Name of the grantee on the instrument underlying this requirement. Used for chain-of-title verification and vesting confirmation.']
  grantor_name varchar [note: 'Name of the grantor on the instrument underlying this requirement (e.g., lender to be paid off, judgment creditor). Used for lien identification and payoff demand.']
  identified_date date [note: 'Calendar date on which this requirement was first identified during title examination. Start point for curative aging calculations and SLA tracking.']
  instrument_reference varchar [note: 'Recording reference (book/page, document number, or instrument number) of the recorded instrument underlying this requirement. Supports chain-of-title tracing.']
  is_active_version boolean [note: 'Indicates whether this record is the current active version of the requirement. False for superseded versions retained for lifecycle history. Supports bi-temporal querying.']
  is_closing_condition boolean [note: 'Indicates whether this requirement must be satisfied before closing can proceed. True = hard closing block; False = may be satisfied post-closing with escrow holdback.']
  is_underwriter_referral boolean [note: 'Indicates whether this requirement was escalated to the underwriter for a formal underwriting referral (UWR) decision. Supports UW referral rate metrics.']
  lien_type varchar [note: 'Type of lien or encumbrance underlying this requirement when the requirement involves lien clearance (e.g., DOT, tax lien, mechanics lien, HOA). [ENUM-REF-CANDIDATE: promote to reference product]']
  notes varchar [note: 'Free-text operational notes entered by the curative processor or examiner regarding the status, contacts, or special handling instructions for this requirement.']
  payoff_good_through_date date [note: 'Date through which the confirmed payoff amount is valid. Closing must occur on or before this date to honor the payoff figure. Critical for closing scheduling.']
  priority_level varchar [note: 'Operational priority assigned to this requirement for curative processing. Critical items block closing; high items require expedited action before commitment expiry.']
  recording_reference varchar [note: 'County recorder book/page or instrument number for the document recorded to satisfy this requirement (e.g., recorded deed of reconveyance, release of lien). Supports chain-of-title.']
  requirement_category varchar [note: 'Broad grouping of the requirement for reporting and aging analysis (e.g., lien clearance, vesting, survey, tax). Supports open/aging requirement metrics. [ENUM-REF-CANDIDATE: promote to reference product]']
  requirement_description varchar [note: 'Full narrative text of the Schedule B-I requirement as it appears on the commitment. Describes the specific curative action required of the parties before policy issuance.']
  requirement_number varchar [note: 'Human-readable Schedule B-I item number as it appears on the commitment (e.g., B-I-1, B-I-2). Used for external communication with parties and lenders.']
  requirement_source varchar [note: 'Identifies who or what system originated this requirement (examiner, underwriter, lender instruction, automated search engine). Supports provenance and audit.']
  requirement_status varchar [note: 'Current lifecycle state of the Schedule B-I requirement. Drives closing readiness and open/aging requirement dashboards. Transitions: open → in_progress → satisfied or waived.']
  requirement_type varchar [note: 'Categorical classification of the curative action required (e.g., payoff, release, satisfaction, subordination). Drives workflow routing and curative processing.']
  responsible_party_role varchar [note: 'Role of the party responsible for satisfying this requirement (e.g., seller must provide payoff, buyer must provide survey). Drives task assignment in curative workflow.']
  revision_number varchar [note: 'Sequential revision number tracking changes to this requirement across commitment revisions. Version 1 = original; increments with each material change. Supports commitment revision frequency metrics.']
  satisfaction_date date [note: 'Date on which this requirement was confirmed as satisfied (e.g., payoff received, release recorded). Null if not yet satisfied. Used for curative effectiveness metrics.']
  satisfaction_method varchar [note: 'Method by which this requirement was ultimately satisfied or resolved (e.g., payoff and release, recorded release, affidavit, court order, underwriter waiver, escrow holdback).']
  source_system_requirement_code varchar [note: 'Native identifier of this requirement in the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Used for system-of-record reconciliation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this title requirement record. Used for change detection, audit trail, and incremental data pipeline processing.']
  waiver_authority varchar [note: 'Name or identifier of the underwriter or authorized officer who approved the waiver of this requirement. Required when requirement_status is waived. Supports audit trail.']
  waiver_date date [note: 'Date on which this requirement was formally waived by the underwriter or authorized officer. Null if not waived. Requires waiver_authority and waiver_reason to be populated.']
  waiver_reason varchar [note: 'Narrative explanation for why this requirement was waived rather than satisfied. Required for audit and regulatory compliance when a Schedule B-I item is removed without curative action.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'SSOT for Schedule B-I requirements — the curative actions that must be satisfied before a title commitment can be issued or a policy can be written. Each record links to the originating title_finding, specifies the required action (payoff, release'
}

Table ti_underwriting.policy_exception {
  policy_exception_id varchar [pk, note: 'Unique surrogate identifier for a Schedule B-II policy exception record. Primary key for the policy_exception entity in the underwriting domain.']
  party_id varchar [note: 'Reference to the party record for the title examiner who identified and entered this exception during the examination process. Supports examiner workload and quality metrics.']
  prior_exception_policy_exception_id varchar [note: 'Self-referencing identifier pointing to the prior version of this exception record when it was revised or superseded. Preserves revision history and prior classifications per VREQ-007.']
  title_commitment_id varchar [note: 'Reference to the title commitment under which this Schedule B-II exception was first issued. Links the exception to its originating commitment lifecycle.']
  title_evidence_id varchar [note: 'Reference to the document management system identifier for the source instrument image or evidence document supporting this exception. Preserves provenance per VREQ-007.']
  title_finding_id varchar [note: 'Reference to the title_finding record that gave rise to this Schedule B-II exception. Preserves evidence and provenance linkage from examination to exception.']
  title_order_id varchar [note: 'Reference to the originating title order. Enables end-to-end traceability from order intake through exception issuance and policy production.']
  title_policy_id varchar [note: 'Reference to the issued title policy (OTP or LTP) that carries this exception. Null if the exception exists only at commitment stage and has not yet been carried into a policy.']
  added_date date [note: 'Calendar date on which this exception was first added to the commitment or policy Schedule B-II. Used for aging analysis and open exception tracking.']
  affects_description varchar [note: 'Narrative description of the portion of the insured property affected by this exception (e.g., \'the northerly 10 feet\', \'the entire parcel\', \'as shown on survey\'). Supports partial-coverage analysis.']
  carried_to_policy_date date [note: 'Date on which this exception was formally carried from the commitment into the issued title policy. Supports policy issuance lag and closing readiness metrics.']
  commitment_revision_number varchar [note: 'The revision number of the title commitment on which this exception was active. Supports commitment revision frequency metrics and lifecycle history preservation per VREQ-007.']
  commitment_schedule_section varchar [note: 'Identifies the schedule section of the commitment where this item appears: Schedule B-II (exceptions from coverage) versus Schedule B-I (requirements). Enforces legal distinction per VREQ-002 and VREQ-017.']
  created_timestamp timestamp [note: 'Timestamp when this policy_exception record was first created in the lakehouse Silver layer. Supports audit trail and record lineage.']
  curative_action_required boolean [note: 'Indicates whether a curative action (CPM/GAPcure) is required to address or remove this exception prior to policy issuance. Supports curative aging and effectiveness metrics.']
  curative_action_status varchar [note: 'Current status of the curative processing effort associated with this exception: not_required, pending, in_progress, completed, or failed. Supports curative aging and effectiveness metrics.']
  curative_completion_date date [note: 'Date on which the curative action for this exception was completed (e.g., release recorded, satisfaction filed). Used to measure curative cycle time and effectiveness.']
  deleted_date date [note: 'Calendar date on which this exception was removed from the commitment or policy Schedule B-II (e.g., after curative action, endorsement, or underwriter waiver). Null if still open.']
  endorsement_available boolean [note: 'Indicates whether an ALTA endorsement (e.g., ALTA 9, ALTA 8.1, ALTA 22) is available to insure over or modify this exception, reducing its coverage impact.']
  endorsement_type varchar [note: 'Identifies the ALTA endorsement type (e.g., ALTA 9, ALTA 8.1, ALTA 22) that insures over or modifies this exception, if applicable. Null if no endorsement applies.']
  exception_number varchar [note: 'Sequential alphanumeric identifier assigned to this exception within the commitment or policy Schedule B-II (e.g., \'1\', \'2a\', \'3\'). Used for referencing in closing and curative documents.']
  exception_status varchar [note: 'Current lifecycle status of the exception: open (active on commitment), deleted (removed prior to policy), carried_to_policy (included in issued policy), waived (underwriter waived), subordinated (subordination obtained).']
  exception_text varchar [note: 'Full verbatim text of the Schedule B-II exception as it appears in the commitment or policy. This is the legally operative language that defines the scope of the exclusion from coverage.']
  exception_type varchar [note: 'Categorical classification of the exception matter (e.g., easement, CC&R, ROW, HOA, survey matter, mineral rights, tax lien, mechanics lien). [ENUM-REF-CANDIDATE']
  gap_coverage_applicable boolean [note: 'Indicates whether gap coverage (GAP) applies to this exception, covering the period between the effective date of the commitment and the recording of the insured instruments.']
  grantee_name varchar [note: 'Name of the grantee party on the source instrument underlying this exception (e.g., the beneficiary of the easement or the lender on the deed of trust).']
  grantor_name varchar [note: 'Name of the grantor party on the source instrument underlying this exception (e.g., the party who granted the easement or executed the deed of trust).']
  is_deleted boolean [note: 'Logical deletion flag indicating this exception record has been superseded or removed from the active Schedule B-II. Preserves lifecycle history per VREQ-007 without physical deletion.']
  is_standard_exception boolean [note: 'Indicates whether this exception is a standard pre-printed ALTA exception (true) or a special/typed exception specific to this property or transaction (false).']
  is_survey_exception boolean [note: 'Indicates whether this exception relates to survey matters (encroachments, overlaps, boundary disputes, or facts that an accurate survey would disclose). Relevant to ALTA 9 endorsement eligibility.']
  lien_amount decimal(18,2) [note: 'Dollar amount of the lien or encumbrance underlying this exception (e.g., judgment amount, tax lien balance, mechanics lien claim). Null for non-monetary exceptions such as easements or CC&Rs.']
  lien_amount_currency varchar [note: 'ISO 4217 three-letter currency code for the lien amount (e.g., USD). Defaults to USD for domestic US title transactions.']
  policy_type varchar [note: 'Indicates whether this exception applies to the Owner\'s Title Policy (OTP), Lender\'s Title Policy (LTP), or both. Supports owner-versus-lender coverage analysis per VREQ-010.']
  priority_position varchar [note: 'Numeric lien priority position of the encumbrance underlying this exception (e.g., 1 = first lien, 2 = second lien). Relevant for subordination analysis and LTV/CLTV underwriting.']
  recording_date date [note: 'Date the source instrument was recorded or filed with the county recorder or register of deeds. Distinct from execution date per VREQ-008.']
  revision_reason varchar [note: 'Reason code explaining why this exception record was created or revised: initial entry, curative update, underwriter waiver, endorsement added, commitment revision, or error correction.']
  source_instrument_date date [note: 'Execution or effective date of the source instrument underlying this exception. Used in chain-of-title analysis and exception provenance.']
  source_instrument_reference varchar [note: 'Recording reference (book/page, document number, or instrument number) of the instrument that is the basis for this exception, as recorded in the county recorder or register of deeds.']
  source_instrument_type varchar [note: 'Type of recorded or filed instrument that is the basis for this exception (e.g., deed, mortgage, DOT, easement agreement, plat, judgment, tax certificate, UCC filing, HOA document, survey).']
  source_system_exception_code varchar [note: 'Native identifier for this exception record in the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Supports system-of-record traceability and reconciliation.']
  standard_exception_code varchar [note: 'Underwriter-assigned code identifying whether this is a standard pre-printed exception (e.g., ALTA standard exceptions 1–5) or a special/typed exception unique to this transaction.']
  underwriter_notes varchar [note: 'Free-text notes entered by the underwriter documenting the rationale for the underwriting decision on this exception, including any conditions or limitations applied.']
  underwriting_decision varchar [note: 'Underwriting disposition for this exception: insure_over (coverage provided), take_exception (excluded from coverage), delete (removed), refer_to_underwriter (escalated for UWR review), waive (underwriter waived requirement).']
  underwriting_referral_id varchar [note: 'Reference to the underwriting referral record if this exception required escalation to an underwriter for a risk decision. Supports UWR rate and exception rate metrics.']
  updated_timestamp timestamp [note: 'Timestamp when this policy_exception record was last modified in the lakehouse Silver layer. Supports change detection and incremental processing.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'SSOT for Schedule B-II exceptions — matters that are excluded from coverage in the issued title policy. Each record identifies the exception type (easement, CC&R, ROW, HOA, survey matter, mineral rights, etc.), its source instrument, whether it is a'
}

Table ti_underwriting.title_commitment {
  title_commitment_id varchar [pk, note: 'Unique surrogate identifier for each title commitment version record. Primary key for the title_commitment entity in the underwriting domain.']
  agent_profile_id varchar [note: 'Reference to the independent agent or branch entity that issued this commitment. Null for direct underwriter issuance. Supports agency oversight and remittance tracking.']
  legal_description_id varchar [note: 'Reference to the legal_description record used in Schedule A of this commitment. Captures the metes-and-bounds, PLSS, or plat/subdivision description of the insured estate.']
  operations_title_examination_id varchar [note: 'Reference to the title examination that produced the findings, requirements, and exceptions reflected in this commitment\'s Schedule B-I and B-II.']
  party_id varchar [note: 'Reference to the title examiner or attorney who performed the examination underlying this commitment. Supports evidence and provenance tracking per VREQ-007.']
  prior_commitment_title_commitment_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding commitment version. Null for initial issuance. Preserves full revision lineage per VREQ-007.']
  property_id varchar [note: 'Reference to the property entity representing the real property subject to this commitment. Supports the three-entity property/parcel/legal_description model per VREQ-004.']
  title_order_id varchar [note: 'Reference to the originating title order that triggered this commitment. Every title_commitment must trace back to a title_order per VREQ-002 and VREQ-013.']
  underwriter_id varchar [note: 'Reference to the title underwriter (e.g., FNF, FAF, STC, ORI) on whose paper this commitment is issued. Required for policy issuance and claims administration.']
  channel_type varchar [note: 'Business channel through which this commitment was produced: direct branch, centralized lender channel, or independent agent. Drives agency remittance and split calculations.']
  closing_date_actual date [note: 'Date on which the transaction actually closed and settlement occurred. Null until closing is completed. Used to measure title clearance cycle time per VREQ-016.']
  closing_date_scheduled date [note: 'Anticipated closing/settlement date for the transaction. Used for closing readiness tracking and commitment expiration management per VREQ-016.']
  closing_protection_letter_flag boolean [note: 'Indicates whether a Closing Protection Letter (CPL) / Insured Closing Letter has been issued in connection with this commitment, protecting the lender against settlement agent fraud or negligence.']
  commitment_number varchar [note: 'Externally-known alphanumeric identifier assigned to this commitment by the title production system (e.g., SoftPro/RamQuest/Qualia). Printed on the commitment document delivered to parties.']
  commitment_status varchar [note: 'Current lifecycle state of this commitment version. Tracks progression from draft through issuance, revision, expiration, and closure. [ENUM-REF-CANDIDATE: draft|issued|revised|extended|expired|cancelled|closed — promote to reference product]']
  commitment_type varchar [note: 'Classification of the underlying real estate transaction type for which the commitment is issued: purchase, refinance (REFI), home equity (HELOC), construction, or commercial.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) county code for the county in which the subject property is located. Used for recording jurisdiction routing and county plant lookups.']
  cpl_issue_date date [note: 'Date on which the Closing Protection Letter (CPL) was issued for this commitment. Null if no CPL was issued. Distinct from commitment issue_date per VREQ-008.']
  created_timestamp timestamp [note: 'Timestamp when this commitment version record was first created in the title production system (SoftPro/RamQuest/Qualia). Audit trail for record provenance per VREQ-007.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this commitment. Defaults to USD for domestic US transactions.']
  effective_date date [note: 'Date through which the title search underlying this commitment is current. Defines the gap period start for GAP coverage purposes. Distinct from issue_date per VREQ-008.']
  estate_type varchar [note: 'Type of estate or interest in the land to be insured as stated in Schedule A (e.g., fee simple, leasehold). Determines the scope of coverage under the owner and lender policies.']
  expiration_date date [note: 'Date on which this commitment expires if the transaction has not closed. After this date the commitment must be extended or reissued. Supports closing readiness metrics per VREQ-016.']
  gap_coverage_flag boolean [note: 'Indicates whether gap coverage (GAPcure) is provided under this commitment, protecting against instruments recorded between the effective date and the recording of the insured documents.']
  insurable_title_determination varchar [note: 'Underwriter\'s determination of whether title is insurable, insurable with exceptions, or not insurable at the time of commitment issuance. Core underwriting output.']
  issue_date date [note: 'Calendar date on which this commitment version was formally issued and delivered to the proposed insured and lender. The principal business event date for the commitment instrument.']
  loan_amount decimal(18,2) [note: 'Principal loan amount secured by the mortgage or deed of trust (DOT) to be insured under the lender policy. Used for LTV and CLTV calculations and underwriting risk assessment.']
  loan_policy_amount decimal(18,2) [note: 'Dollar amount of lender\'s title policy (LTP) coverage proposed in Schedule A. Typically equals the loan amount. Supports owner-versus-lender coverage metrics per VREQ-016.']
  loan_premium_amount decimal(18,2) [note: 'Calculated title insurance premium for the lender\'s policy (LTP) based on the applicable state rate schedule and liability amount. Used for premium remittance and revenue recognition.']
  marketable_title_flag boolean [note: 'Indicates whether the examiner has determined that title is marketable (free from reasonable doubt as to validity) in addition to being insurable. Supports chain-of-title break metrics.']
  open_exceptions_count varchar [note: 'Count of Schedule B-II exceptions (policy_exception records) listed on this commitment version. Supports unresolved defects/liens and exception rate metrics per VREQ-016.']
  open_requirements_count varchar [note: 'Count of uncleared Schedule B-I requirements (title_requirement records) at the time this commitment version was issued. Supports open/aging requirements metrics per VREQ-016.']
  owner_policy_amount decimal(18,2) [note: 'Dollar amount of owner\'s title policy (OTP) coverage proposed in Schedule A. Typically equals the purchase price. Supports owner-versus-lender coverage metrics per VREQ-016.']
  owner_premium_amount decimal(18,2) [note: 'Calculated title insurance premium for the owner\'s policy (OTP) based on the applicable state rate schedule and liability amount. Used for premium remittance and revenue recognition.']
  policy_form_code varchar [note: 'Code identifying the ALTA policy form version to be issued (e.g., ALTA 2006, ALTA 2016, state-specific form). Determines coverage terms and endorsement eligibility.']
  proposed_insured_lender varchar [note: 'Name of the proposed insured lender/mortgagee as it appears in Schedule A of the commitment (LTP). Includes MERS nominee language where applicable.']
  proposed_insured_owner varchar [note: 'Name of the proposed insured owner as it appears in Schedule A of the commitment (OTP). Reflects vesting as it will appear on the deed. Distinct from lender insured.']
  purchase_price decimal(18,2) [note: 'Agreed purchase price of the property as stated in the purchase contract. Used to set OTP liability amount and for underwriting risk assessment. Null for refinance transactions.']
  rate_schedule_code varchar [note: 'Code identifying the state-filed rate schedule applied to calculate premiums on this commitment. Varies by state, transaction type, and underwriter. Required for regulatory premium reporting.']
  reissue_rate_flag boolean [note: 'Indicates whether a reissue/refinance premium rate applies based on a prior policy within the qualifying period. Affects premium calculation and rate schedule selection.']
  revision_date date [note: 'Date on which this revision was prepared and issued. Null for the initial issuance version. Distinct from issue_date to preserve the amendment timeline per VREQ-007 and VREQ-008.']
  revision_number varchar [note: 'Sequential integer indicating which version of the commitment this record represents. Initial issuance = 1; each amendment increments by 1. Supports commitment revision frequency metrics per VREQ-016.']
  revision_reason varchar [note: 'Free-text or coded explanation for why this revision was issued (e.g., new lien found, requirement cleared, insured name correction, loan amount change). Supports revision frequency analysis per VREQ-016.']
  schedule_a_notes varchar [note: 'Free-text notes or special conditions appearing in Schedule A of the commitment beyond the standard fields (e.g., vesting instructions, special estate language, survey requirements).']
  simultaneous_issue_flag boolean [note: 'Indicates whether the owner and lender policies are being issued simultaneously, qualifying for a simultaneous issue premium discount under state rate schedules.']
  source_system_commitment_ref varchar [note: 'Native commitment identifier from the originating title production system (e.g., SoftPro order/commitment number, RamQuest file number). Enables cross-system reconciliation.']
  state_code varchar [note: 'Two-letter US state code (FIPS) for the jurisdiction in which the subject property is located. Determines applicable rate schedule, regulatory requirements, and underwriting guidelines.']
  underwriting_referral_id varchar [note: 'Reference to the underwriting referral record if this commitment required escalation to the underwriter for risk review or exception approval. Null if no referral was required.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this commitment version record in the source system. Supports change detection and incremental lakehouse ingestion.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'SSOT for the title commitment instrument — the conditional promise to issue a title policy. Each record represents a distinct commitment version (initial issuance plus each revision/amendment), capturing Schedule A data (proposed insured, estate/interest'
}

Table ti_underwriting.title_policy {
  title_policy_id varchar [pk, note: 'Unique surrogate identifier for the title insurance policy record. Primary key for the title_policy entity.']
  agent_profile_id varchar [note: 'Reference to the independent title agent or direct branch that issued the policy. Used for agency remittance timeliness and oversight metrics.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Every title policy insures a specific property. Direct link is fundamental for policy-to-property traceability, claim analysis by property characteristics, loss ratio calculation by']
  title_commitment_id varchar [note: 'Reference to the title commitment (Schedule A/B-I/B-II) from which this policy was issued. Links policy to the approved commitment that preceded it.']
  title_order_id varchar [note: 'Reference to the originating title order that initiated the search, examination, commitment, and policy production workflow. Every title_policy must trace to a title_order.']
  agent_premium_split_amount decimal(18,2) [note: 'Dollar portion of the net premium retained by the independent title agent per the agency agreement split schedule. Used for remittance reconciliation.']
  cancellation_date date [note: 'Date the policy was cancelled, if applicable. Null for active policies. Supports lifecycle history preservation per VREQ-007.']
  cancellation_reason varchar [note: 'Reason code for policy cancellation. Supports lifecycle audit and underwriting exception analysis per VREQ-007.']
  companion_policy_number varchar [note: 'Policy number of the simultaneously issued companion policy (OTP companion to LTP or vice versa). Supports simultaneous issue rate validation and owner-vs-lender coverage analysis.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) county code for the county where the insured property is located. Used for recording jurisdiction and regulatory reporting.']
  created_timestamp timestamp [note: 'Timestamp when this title_policy record was first created in the system of record (title production system). Audit trail for record provenance per VREQ-007.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this policy. Typically USD for domestic US title transactions.']
  effective_date date [note: 'Date and time as of which the policy insures title, typically the date and time of recording of the insured instrument. Distinct from issue_date per VREQ-008.']
  effective_time timestamp [note: 'Time component of the policy effective date (HH:mm:ss) as recorded on Schedule A. Title insurance coverage attaches at a specific time of day on the effective date.']
  endorsement_count varchar [note: 'Number of ALTA endorsements attached to this policy at issuance (e.g., ALTA 9, ALTA 8.1, ALTA 22). Supports owner-versus-lender coverage and endorsement analysis.']
  estate_or_interest varchar [note: 'Nature of the estate or interest in the land insured under Schedule A (e.g., fee simple, leasehold). Defines the scope of title coverage.']
  execution_date date [note: 'Date the policy document was executed (signed/authorized) by the issuing agent or underwriter. Distinct from effective_date and issue_date per VREQ-008.']
  gap_coverage_flag boolean [note: 'Indicates whether gap coverage (GAP) is provided under this policy, insuring against defects arising in the gap period between commitment and recording.']
  insurable_title_flag boolean [note: 'Indicates whether title was determined insurable (though not necessarily marketable) at policy issuance. Distinct from marketable_title_flag for underwriting risk classification.']
  insured_name varchar [note: 'Full legal name of the insured party as it appears on Schedule A of the policy. For OTP this is the buyer/owner; for LTP this is the lender/mortgagee.']
  insured_type varchar [note: 'Classification of the insured party: individual person, legal entity (LLC/Corp), trust, estate, or government body. Drives vesting and coverage analysis.']
  issue_date date [note: 'Date the title policy was formally issued by the underwriter or issuing agent. Principal business event date for policy issuance lag metrics.']
  lender_name varchar [note: 'Name of the lender/mortgagee insured under an LTP policy as shown on Schedule A. Null for OTP policies.']
  liability_amount decimal(18,2) [note: 'Maximum dollar amount of coverage (face amount) for which the underwriter is liable under this policy. For OTP equals purchase price; for LTP equals loan amount.']
  loan_amount decimal(18,2) [note: 'Principal loan amount secured by the insured mortgage, applicable to LTP policies only. Equals the LTP liability amount and is used for LTV and coverage analysis.']
  loan_number varchar [note: 'Lender-assigned loan number for the mortgage insured under an LTP policy. Used to cross-reference with lender systems and MERS registration.']
  marketable_title_flag boolean [note: 'Indicates whether the underwriter determined title to be marketable at the time of policy issuance. Supports insurable vs. marketable title determination tracking.']
  net_premium_amount decimal(18,2) [note: 'Premium amount after applying reissue credits and other adjustments. Represents the actual premium collected and subject to remittance split.']
  policy_exception_count varchar [note: 'Number of Schedule B-II exceptions (policy_exception records) carried on this policy at issuance. Supports unresolved defect and exception rate metrics per VREQ-016.']
  policy_form_code varchar [note: 'ALTA or state-specific policy form identifier (e.g., ALTA 2021 Owner\'s Policy, ALTA 2021 Loan Policy, ALTA Homeowner\'s Policy 2013). Governs coverage terms.']
  policy_issuance_lag_days varchar [note: 'Number of calendar days between the recording_date of the insured instrument and the policy issue_date. Key metric for policy issuance lag after recording per VREQ-016.']
  policy_number varchar [note: 'Externally-known unique policy number assigned by the underwriter or title production system (e.g., SoftPro/RamQuest). Used for claims, endorsements, and regulatory reporting.']
  policy_status varchar [note: 'Current lifecycle state of the title policy. Tracks progression from draft through issuance, and captures cancellations or reissuances for revision history per VREQ-007.']
  policy_type varchar [note: 'Discriminates between Owner\'s Title Policy (OTP) and Lender\'s/Loan Title Policy (LTP). Owner and lender policies are stored as separate records with separate policy_type values per VREQ-010.']
  premium_amount decimal(18,2) [note: 'Gross title insurance premium charged for this policy before any splits or adjustments. Used for premium revenue recognition and remittance calculations.']
  prior_policy_date date [note: 'Issue date of the prior title policy referenced for reissue credit calculation. Required by state rate filings to validate reissue credit eligibility.']
  prior_policy_number varchar [note: 'Policy number of a previously issued title policy on the same property, used to establish reissue credit eligibility and chain-of-coverage continuity.']
  production_channel varchar [note: 'Channel through which the policy was produced: direct branch, centralized lender channel, or independent title agent. Drives remittance, oversight, and performance metrics.']
  recording_date date [note: 'Date the insured instrument (deed or mortgage) was recorded at the county recorder/register of deeds. Anchors the gap period and effective date. Distinct per VREQ-008.']
  reissue_credit_amount decimal(18,2) [note: 'Dollar credit applied to the premium when a prior policy exists on the same property and a reissue rate is applicable. Reduces net premium charged.']
  reissue_flag boolean [note: 'Indicates whether this policy was issued at a reissue rate based on a prior policy. Triggers reissue credit calculation and prior policy validation.']
  remittance_date date [note: 'Actual date the underwriter\'s premium share was remitted by the agent. Null if not yet remitted. Used to calculate remittance lag.']
  remittance_due_date date [note: 'Date by which the agent must remit the underwriter\'s share of the premium per the agency agreement. Used for remittance timeliness tracking.']
  remittance_status varchar [note: 'Current status of the underwriter premium remittance for this policy. Supports agency remittance timeliness metrics per VREQ-016.']
  simultaneous_issue_flag boolean [note: 'Indicates whether this policy was issued simultaneously with a companion OTP or LTP policy on the same transaction, qualifying for a simultaneous issue rate discount.']
  source_system_policy_ref varchar [note: 'Native policy identifier from the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Enables traceability back to the system of record.']
  state_code varchar [note: 'Two-letter US state code where the insured property is located. Governs applicable rate filings, policy forms, and regulatory reporting jurisdiction.']
  transaction_type varchar [note: 'Type of real estate transaction underlying the policy (purchase, refinance, HELOC, construction, home equity, commercial). Drives rate, form, and coverage selection.']
  underwriter_code varchar [note: 'Code identifying the title underwriter (e.g., FNF, FAF, STC, ORI) that backs this policy. Required for regulatory reporting and loss ratio analysis.']
  underwriter_premium_split_amount decimal(18,2) [note: 'Dollar portion of the net premium remitted to the underwriter per the agency agreement split schedule. Drives remittance timeliness metrics.']
  underwriting_referral_flag boolean [note: 'Indicates whether this policy required an underwriting referral (UWR) to the underwriter\'s home office or senior underwriter prior to issuance. Drives UWR rate metrics.']
  updated_timestamp timestamp [note: 'Timestamp when this title_policy record was last modified in the system of record. Supports change detection and lifecycle history per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'SSOT for issued title insurance policies. Owner (OTP) and lender (LTP) policies are stored as separate records with separate policy_type values, satisfying VREQ-010.'
}

Table ti_underwriting.endorsement {
  endorsement_id varchar [pk, note: 'Unique surrogate identifier for each ALTA endorsement record attached to an owner or lender title policy. Primary key for the endorsement entity.']
  agent_profile_id varchar [note: 'Reference to the independent title agent or direct branch that issued this endorsement on behalf of the underwriter. Supports agency remittance and authority oversight.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Endorsements modify coverage for specific properties (zoning, access, survey). Direct property link enables endorsement analysis by property type/transaction, premium analysis by property']
  superseded_by_endorsement_id varchar [note: 'Reference to the replacement endorsement record when this endorsement has been superseded by a revised version. Preserves revision lineage per VREQ-007. Null if not superseded.']
  title_order_id varchar [note: 'Reference to the originating title order that produced the parent policy. Supports end-to-end traceability from order intake through endorsement issuance.']
  title_policy_id varchar [note: 'Reference to the parent title policy (owner or lender) to which this endorsement is attached. Every endorsement must be associated with exactly one title policy.']
  additional_premium_amount decimal(15,2) [note: 'Additional premium charged for this endorsement, expressed in USD. Added to the base policy premium. Used for premium revenue recognition and agency remittance calculations.']
  agent_premium_split_pct decimal(5,4) [note: 'Contractual percentage of the endorsement premium retained by the issuing agent per the agency agreement (split). Expressed as a decimal (e.g., 0.7000 = 70%). Supports remittance reconciliation.']
  alta_form_number varchar [note: 'Standardized ALTA endorsement form number identifying the endorsement type (e.g., ALTA 9, ALTA 8.1, ALTA 22, ALTA 28, ALTA 3.1). Drives coverage scope and premium calculation.']
  cancellation_date date [note: 'Date the endorsement was cancelled, if applicable. Null for active endorsements. Supports lifecycle history preservation per VREQ-007.']
  cancellation_reason varchar [note: 'Reason code explaining why the endorsement was cancelled. Null for active endorsements. Supports lifecycle audit and revision frequency analysis per VREQ-007.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county in which the insured property is located. Used for county-level regulatory reporting and recording jurisdiction identification.']
  coverage_category varchar [note: 'Broad category of risk coverage provided by the endorsement. [ENUM-REF-CANDIDATE: access|environmental|survey|zoning|tax|mechanics_lien|usury|variable_rate|other — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this endorsement record was first created in the lakehouse Silver layer. Audit field supporting data lineage and record provenance per VREQ-007.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this endorsement record. Defaults to USD for domestic US title transactions.']
  document_image_ref varchar [note: 'Reference key or URI to the scanned or electronic image of the executed endorsement document stored in the Document Management and Imaging System. Supports evidence and provenance.']
  effective_date date [note: 'Date on which the endorsement coverage becomes effective. Per VREQ-008, this is distinct from execution, submission, acceptance, and recording dates. Typically aligns with policy effective date.']
  electronic_delivery boolean [note: 'Indicates whether this endorsement was delivered electronically to the insured or lender rather than in paper form. Supports eRecording and digital closing workflow tracking.']
  endorsement_description varchar [note: 'Full narrative description of the coverage provided by this endorsement, including any specific conditions, limitations, or property-specific language added by the underwriter.']
  endorsement_name varchar [note: 'Human-readable name or short title of the endorsement form (e.g., \'Restrictions, Encroachments, Minerals\', \'Environmental Protection Lien\', \'Location\'). Complements the ALTA form number.']
  endorsement_status varchar [note: 'Current lifecycle state of the endorsement. Tracks progression from draft through issuance or cancellation. Supports commitment revision frequency and policy issuance lag metrics.']
  endorsement_type varchar [note: 'Indicates whether this endorsement applies to an Owner\'s Title Policy (OTP), a Lender\'s Title Policy (LTP), or both. Supports owner-versus-lender coverage analysis per VREQ-010.']
  execution_date date [note: 'Date the endorsement was executed (signed/authorized) by the authorized underwriting officer. Per VREQ-008, distinct from effective, submission, acceptance, and recording dates.']
  gl_account_code varchar [note: 'General ledger account code to which the endorsement premium revenue is posted. Supports ERP/GL integration for premium revenue recognition and financial reporting.']
  issuance_date date [note: 'Date the endorsement was formally issued and delivered to the insured or lender. Used to measure policy issuance lag after recording and endorsement production cycle time.']
  issuing_officer_name varchar [note: 'Name of the authorized title officer or underwriting officer who executed and issued this endorsement. Supports audit trail and authority verification.']
  issuing_underwriter_code varchar [note: 'Code identifying the title underwriter (e.g., FNF, FAF, STC, ORI) that issued this endorsement. Supports underwriter-level premium and loss ratio reporting.']
  liability_amount decimal(15,2) [note: 'Maximum insured liability amount covered by this endorsement in USD. May differ from the parent policy amount for endorsements with limited coverage scope.']
  notes varchar [note: 'Free-text field for underwriter or title officer notes regarding special circumstances, conditions, or property-specific language associated with this endorsement.']
  number varchar [note: 'Externally-known alphanumeric identifier assigned to this endorsement by the title production system (e.g., SoftPro, RamQuest). Used for referencing in policy documents and correspondence.']
  premium_basis varchar [note: 'Method used to calculate the endorsement premium (e.g., flat fee, rate per thousand of liability, percentage of policy amount, or no additional charge). Drives premium calculation logic.']
  prior_endorsement_id varchar [note: 'Reference to the prior version of this endorsement that was superseded. Enables full revision chain traversal. Null for original issuances. Supports VREQ-007 lifecycle history.']
  production_channel varchar [note: 'Channel through which this endorsement was produced: direct branch, centralized lender channel, or independent title agent. Supports channel-level performance and remittance analysis.']
  remittance_date date [note: 'Date the endorsement premium was included in the agent\'s remittance to the underwriter. Null until remitted. Supports agency remittance timeliness metrics per VREQ-016.']
  remittance_included boolean [note: 'Indicates whether the endorsement premium has been included in the agent\'s premium remittance to the underwriter. Supports agency remittance timeliness and settlement reconciliation.']
  revision_number varchar [note: 'Sequential revision counter for this endorsement. Starts at 1 for original issuance; increments with each material revision. Supports commitment revision frequency metrics.']
  source_system_code varchar [note: 'Code identifying the title production system of record from which this endorsement record was sourced (e.g., SoftPro Select, RamQuest Horizon, Qualia). Supports data lineage.']
  source_system_endorsement_ref varchar [note: 'Native identifier for this endorsement record in the originating title production system (SoftPro, RamQuest, Qualia). Enables reconciliation and traceability back to the system of record.']
  state_code varchar [note: 'Two-letter US state code for the jurisdiction in which the insured property is located. Drives state-specific rate filings, form requirements, and regulatory reporting.']
  transaction_type varchar [note: 'Type of real estate transaction to which the parent policy and this endorsement apply. [ENUM-REF-CANDIDATE: purchase|refinance|heloc|construction|commercial|home_equity — promote to reference product]']
  underwriter_premium_split_pct decimal(5,4) [note: 'Contractual percentage of the endorsement premium remitted to the underwriter per the agency agreement. Expressed as a decimal (e.g., 0.3000 = 30%). Complements agent split.']
  underwriting_conditions varchar [note: 'Narrative description of any conditions imposed by the underwriter as part of an approved-with-conditions decision for this endorsement. Null if no conditions apply.']
  underwriting_decision varchar [note: 'Underwriting decision outcome for this endorsement when a referral was required. Null if no referral was needed. Supports UW exception rate and referral analysis.']
  underwriting_referral_required boolean [note: 'Indicates whether this endorsement required an underwriting referral (UWR) for approval before issuance. Supports UW referral and exception rate metrics per VREQ-016.']
  updated_timestamp timestamp [note: 'Timestamp when this endorsement record was last modified in the lakehouse Silver layer. Audit field supporting change tracking and lifecycle history per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Records each ALTA endorsement attached to an owner or lender title policy. Each record captures the endorsement form number (ALTA 9, ALTA 8.1, ALTA 22, ALTA 28, etc.), endorsement description, additional premium, effective date, and the parent'
}

Table ti_underwriting.uw_referral {
  uw_referral_id varchar [pk, note: 'Unique surrogate identifier for the underwriting referral record. Primary key for the uw_referral entity.']
  agent_profile_id varchar [note: 'Identifier of the independent title agent, if the referral originates from an independent agency channel. Null for direct branch or centralized lender orders.']
  policy_exception_id varchar [note: 'Reference to the policy_exception record created as a result of this underwriting referral decision. Populated when exception_scheduled is True.']
  prior_referral_id varchar [note: 'Self-referential link to the previous version of this referral when revision_number > 1. Preserves material lifecycle history and revision chain per VREQ-007.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Referrals are triggered by property-specific risks (title defects, chain breaks, high liability).']
  title_commitment_id varchar [note: 'Reference to the title commitment associated with this referral, if the referral arises at or after commitment stage. Nullable when referral precedes commitment issuance.']
  title_finding_id varchar [note: 'Reference to the specific title finding (defect, lien, encumbrance, or cloud on title) that is the primary subject of this underwriting referral.']
  title_order_id varchar [note: 'Reference to the title order that triggered this underwriting referral. Every UWR must trace back to an originating title order.']
  underwriting_title_examination_id varchar [note: 'Reference to the title examination that surfaced the defect or risk condition prompting this underwriting referral.']
  uw_assigned_underwriter_party_id varchar [note: 'Identifier of the underwriter assigned to review and decide on this referral. Supports underwriter workload, cycle time, and decision-rate analytics.']
  uw_party_id varchar [note: 'Identifier of the title examiner or branch staff member who initiated the underwriting referral. Supports examiner-level UWR rate and workload analytics.']
  channel varchar [note: 'Business channel through which the originating title order was produced: direct branch, centralized lender, or independent agent. Supports channel-level UWR rate reporting.']
  closing_date_impact boolean [note: 'Indicates whether this underwriting referral caused or is at risk of causing a delay to the scheduled closing date. Supports closing readiness metrics per VREQ-016.']
  conditions_imposed varchar [note: 'Free-text description of conditions, requirements, or curative actions imposed by the underwriter as part of an approved-with-conditions decision. Maps to Schedule B-I requirements.']
  created_timestamp timestamp [note: 'Timestamp when this underwriting referral record was first created in the lakehouse Silver layer. Audit trail for data lineage and provenance per VREQ-007.']
  curative_action_description varchar [note: 'Narrative description of the curative processing steps required to clear the title defect or satisfy underwriting conditions. Supports curative aging and effectiveness metrics.']
  curative_action_required boolean [note: 'Indicates whether the underwriting decision requires curative processing (CPM/GAPcure) before the commitment or policy can be issued. True = curative action required.']
  curative_completed_date date [note: 'Date on which all required curative actions were confirmed as completed and accepted by the underwriter. Used to measure curative effectiveness and cycle time.']
  curative_deadline_date date [note: 'Target date by which curative actions must be completed to maintain the scheduled closing date. Drives curative aging and closing readiness metrics.']
  defect_description varchar [note: 'Detailed narrative of the title defect, cloud on title, lien, or encumbrance under underwriting review. Provides examiner context for the underwriter\'s risk assessment.']
  endorsement_required boolean [note: 'Indicates whether the underwriting decision requires one or more ALTA endorsements (e.g., ALTA 9, ALTA 8.1, ALTA 22) to be attached to the policy.']
  endorsement_types varchar [note: 'Comma-separated list of ALTA endorsement form numbers required as a result of this referral decision (e.g., ALTA 9, ALTA 8.1, ALTA 22). Populated when endorsement_required is True.']
  escalation_count varchar [note: 'Number of times this referral has been escalated to a higher underwriting authority level. Supports complexity and exception rate analytics.']
  exception_scheduled boolean [note: 'Indicates whether the underwriting decision resulted in a Schedule B-II policy exception being added to the commitment or policy. True = exception scheduled.']
  gap_period_end_date date [note: 'End date of the gap coverage period under review, typically the anticipated recording date. Defines the gap window for which underwriting approval is sought.']
  gap_period_start_date date [note: 'Start date of the gap coverage period under review, applicable when referral_type is gap_coverage. Represents the date through which the title search was completed.']
  insurable_title_determination varchar [note: 'Underwriter\'s determination of the title\'s insurability or marketability following review. Core output of the UWR process; drives policy issuance eligibility.']
  liability_amount decimal(18,2) [note: 'Total insured liability amount (policy face value) associated with the transaction at the time of referral. High-liability thresholds are a primary UWR trigger. USD.']
  liability_threshold_exceeded boolean [note: 'Indicates whether the transaction liability amount exceeded the underwriter\'s authority threshold, triggering mandatory referral. True = threshold exceeded.']
  policy_type_requested varchar [note: 'Indicates whether the referral pertains to an owner title policy (OTP), lender title policy (LTP), or both. Supports owner-versus-lender coverage metrics per VREQ-010.']
  prior_claim_reference varchar [note: 'Reference number of a prior title insurance claim on the same property or related parties that contributed to this referral trigger. Links to claims administration history.']
  referral_date date [note: 'Calendar date on which the underwriting referral was formally submitted for review. Principal business event date; used as the start point for UWR cycle time measurement.']
  referral_number varchar [note: 'Human-readable, externally referenceable identifier for this underwriting referral, formatted as UWR-YYYY-NNNNNN. Used in correspondence with underwriters and in audit trails.']
  referral_status varchar [note: 'Current lifecycle state of the underwriting referral. Drives open/aging UWR metrics and commitment readiness. [ENUM-REF-CANDIDATE: open|pending_uw_review|approved|approved_with_conditions|declined|withdrawn — promote to reference product]']
  referral_timestamp timestamp [note: 'Precise date-time when the underwriting referral was submitted. Provides intraday precision for SLA measurement and audit trail beyond the referral_date.']
  referral_trigger_reason varchar [note: 'Free-text narrative describing the specific condition, defect, or risk factor that triggered escalation to underwriting review. Complements referral_type with examiner detail.']
  referral_type varchar [note: 'Classification of the primary reason for escalation to underwriting review. Supports UWR rate analytics by trigger category. [ENUM-REF-CANDIDATE: promote to reference product]']
  revision_number varchar [note: 'Sequential revision counter for this underwriting referral, incremented when material changes are submitted for re-review. Supports commitment revision frequency metrics per VREQ-016.']
  risk_category varchar [note: 'Categorical classification of the title risk type under review. Aligns with title-risk cause taxonomy used in claim frequency and severity reporting. [ENUM-REF-CANDIDATE: promote to reference product]']
  sla_breach boolean [note: 'Indicates whether the underwriting decision was rendered after the sla_target_days threshold. True = SLA breached. Supports aging and cycle time reporting.']
  sla_target_days varchar [note: 'Number of business days within which the underwriting decision is contractually or operationally required. Baseline for UWR cycle time SLA compliance measurement.']
  source_system_ref varchar [note: 'Identifier of this referral record in the originating Underwriting Risk and Policy Management System (e.g., SoftPro, RamQuest, or proprietary UW system). Supports SoR reconciliation.']
  transaction_type varchar [note: 'Type of real estate transaction associated with the referral (e.g., purchase, REFI, HELOC, construction, commercial). Supports segmentation of UWR rates by transaction type.']
  updated_timestamp timestamp [note: 'Timestamp when this underwriting referral record was last modified in the lakehouse Silver layer. Supports change detection and audit trail for lifecycle transitions.']
  uw_authority_level varchar [note: 'Level of underwriting authority required to approve this referral (branch, regional, national, or reinsurance). Reflects the risk complexity and liability amount thresholds.']
  uw_decision varchar [note: 'Final underwriting decision rendered on this referral. Drives commitment issuance, exception scheduling, and curative action requirements.']
  uw_decision_date date [note: 'Date on which the underwriter rendered a decision (approved, approved with conditions, or declined) on this referral. Used to compute UWR cycle time.']
  uw_decision_rationale varchar [note: 'Narrative explanation provided by the underwriter supporting the decision. Required for declined and approved-with-conditions outcomes for audit and regulatory review.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Tracks underwriting referral (UWR) events — the escalation of a title order or commitment to an underwriter for risk review. Each record captures the referral trigger (high-liability amount, complex defect, gap coverage, prior claim, commercial'
}

Table ti_underwriting.curative_action {
  curative_action_id varchar [pk, note: 'Unique surrogate identifier for each discrete curative action record within the title underwriting workflow.']
  assigned_party_id varchar [note: 'Reference to the party (examiner, curative specialist, attorney, or vendor) responsible for executing this curative action.']
  decision_id varchar [note: 'Foreign key linking to underwriting.underwriting_decision. Business justification: Curative actions may be triggered by or result from formal underwriting decisions.']
  operations_title_examination_id varchar [note: 'Reference to the title examination that identified the defect or issue requiring this curative action.']
  prior_action_id varchar [note: 'Self-referencing identifier pointing to the previous curative action attempt for the same requirement or finding. Preserves lifecycle history and re-attempt lineage per VREQ-007.']
  recording_submission_id varchar [note: 'Reference to the eRecording submission record if this curative action required recording a document with the county recorder or register of deeds.']
  title_evidence_id varchar [note: 'Reference to the document management record containing the evidence (release, satisfaction, affidavit, recorded instrument) that proves this curative action was completed.']
  title_finding_id varchar [note: 'Reference to the title examination finding (defect, lien, encumbrance) that this curative action is resolving. Null if action is linked only to a requirement.']
  title_order_id varchar [note: 'Reference to the parent title order under which this curative action is being performed. Links the action to the originating transaction.']
  title_requirement_id varchar [note: 'Reference to the Schedule B-I title requirement this curative action is intended to satisfy. Null if action is linked only to a finding.']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record created when this curative action required underwriter review or exception approval.']
  action_number varchar [note: 'Externally visible business identifier for this curative action, used in correspondence, CPM memos, and production system tracking (e.g., CA-2024-000123).']
  action_status varchar [note: 'Current lifecycle state of the curative action. Drives open/aging requirement metrics and curative effectiveness reporting. [ENUM-REF-CANDIDATE: open|in_progress|pending_response|completed|waived|escalated|cancelled — 7 candidates stripped; promote to']
  action_subtype varchar [note: 'Further classification within the action type (e.g., within lien_release: tax_lien_release, mechanics_lien_release, judgment_lien_release, HOA_lien_release). Supports granular curative aging analysis.']
  action_type varchar [note: 'Classification of the curative step being taken (e.g., payoff request, lien release, affidavit of heirship, probate filing, survey correction, GAPcure, CPM memo).']
  attempt_number varchar [note: 'Sequential count of attempts made to complete this curative action. Values greater than 1 indicate re-attempts after prior failure or rejection. Supports curative effectiveness metrics.']
  completed_date date [note: 'Calendar date on which this curative action was fully resolved and the requirement or finding was satisfied. Null if still open.']
  created_timestamp timestamp [note: 'Timestamp when this curative action record was first created in the lakehouse Silver layer. Audit trail for record provenance.']
  curative_cost decimal(18,2) [note: 'Actual cost incurred to complete this curative action (e.g., recording fees, attorney fees, court filing fees, survey costs). USD. Used for curative cost analysis.']
  days_open varchar [note: 'Number of calendar days this curative action has been open as of the last refresh date. Supports curative aging and SLA reporting. Sourced from production system; not a real-time calculation.']
  defect_category varchar [note: 'Category of the underlying title defect or cloud being cured (e.g., lien, chain-of-title break, vesting defect, gap). Supports unresolved defect and lien metrics.']
  due_date date [note: 'Target date by which this curative action must be completed to maintain closing readiness and commitment validity.']
  escalated_date date [note: 'Date on which this curative action was escalated to underwriting review or senior curative staff due to complexity or aging. Null if not escalated.']
  failure_reason varchar [note: 'Reason this curative action attempt failed or was rejected, triggering a re-attempt. Null if action was completed successfully. [ENUM-REF-CANDIDATE']
  initiated_date date [note: 'Calendar date on which this curative action was formally initiated or assigned. Used as the start point for curative aging calculations.']
  instrument_type varchar [note: 'Type of legal instrument or document expected to be obtained or recorded to complete this curative action (e.g., release, satisfaction, reconveyance, affidavit, deed).']
  is_chain_of_title_break boolean [note: 'Indicates whether this curative action is addressing a break in the chain of title (COT). Supports chain-of-title break metrics and evidence completeness reporting.']
  is_gap_cure boolean [note: 'Indicates whether this curative action specifically addresses a gap period coverage issue between the effective date of the commitment and the recording of the insured instrument.']
  is_marketable_title_impairment boolean [note: 'Indicates whether the underlying defect being cured rises to the level of a marketable title impairment, requiring resolution before the transaction can close.']
  is_sla_breached boolean [note: 'Indicates whether this curative action has exceeded its SLA target days without completion. True = SLA breached; False = within SLA.']
  notes varchar [note: 'Free-text operational notes entered by the curative specialist or examiner documenting correspondence, follow-up activity, or special circumstances for this action.']
  payoff_amount decimal(18,2) [note: 'Dollar amount required to satisfy a lien, mortgage, or judgment as part of this curative action. Applicable for payoff_request and lien_release action types. USD.']
  payoff_good_through_date date [note: 'Expiration date of the payoff quote obtained from the lienholder. After this date, a new payoff demand must be requested. Critical for closing readiness.']
  priority varchar [note: 'Operational priority assigned to this curative action, used to triage workload and ensure closing-readiness timelines are met.']
  requires_uw_approval boolean [note: 'Indicates whether this curative action requires formal underwriter approval before the requirement can be marked satisfied. Drives UWR referral rate metrics.']
  resolution_method varchar [note: 'Method by which this curative action was ultimately resolved (e.g., document obtained and recorded, payoff confirmed, waived by underwriter, insured over).']
  responsible_party_type varchar [note: 'Classification of the party responsible for fulfilling this curative action (e.g., seller must provide release, buyer must provide affidavit, title company handles recording).']
  sla_target_days varchar [note: 'Contractual or operational SLA target in calendar days for completing this type of curative action. Used to measure curative effectiveness against benchmarks.']
  source_system_action_code varchar [note: 'Native identifier for this curative action record in the originating title production system (SoftPro, RamQuest, Qualia). Enables reconciliation with the system of record.']
  updated_timestamp timestamp [note: 'Timestamp when this curative action record was last modified in the lakehouse Silver layer. Supports change detection and incremental processing.']
  vendor_name varchar [note: 'Name of the external vendor, attorney, or service provider engaged to perform or facilitate this curative action (e.g., lien release service, probate attorney).']
  vendor_reference_number varchar [note: 'External reference or tracking number assigned by the vendor or third-party service provider for this curative action. Used for follow-up and reconciliation.']
  waived_date date [note: 'Date on which the underwriter formally waived this curative requirement, allowing the transaction to proceed without full cure. Null if not waived.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Tracks each discrete curative step taken to satisfy an open title_requirement or resolve a title_finding. Each record captures the action type (payoff request, lien release, affidavit of heirship, probate filing, survey correction, GAPcure, CPM memo'
}

Table ti_underwriting.underwriting_title_examination {
  underwriting_title_examination_id varchar [pk, note: 'Unique surrogate identifier for the title examination record. Primary key for the underwriting_title_examination entity in the Silver layer.']
  examiner_party_id varchar [note: 'Reference to the party record for the licensed title examiner or attorney who performed the examination. Supports examiner identity and workload analytics.']
  prior_examination_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding examination record for this order. Preserves revision lineage and material lifecycle transitions (VREQ-007).']
  title_order_id varchar [note: 'Reference to the originating title order that triggered this examination. Every examination must trace back to a title order per ALTA workflow standards.']
  title_search_id varchar [note: 'Reference to the title search record whose assembled chain-of-title results are being examined. Examination is legally distinct from search per VREQ-017.']
  apn varchar [note: 'Assessor\'s Parcel Number (APN) or Parcel Identification Number (PIN) assigned by the county assessor for the subject property. Key cross-reference to property and parcel records.']
  chain_of_title_break_flag boolean [note: 'Indicates whether the examiner identified a break or gap in the chain of title (COT) during examination. Key metric for unresolved defect and lien reporting (VREQ-016).']
  created_timestamp timestamp [note: 'Date and time when this examination record was first created in the system. Audit field supporting record provenance and SLA measurement from order intake.']
  curative_action_required boolean [note: 'Indicates whether one or more curative processing actions (CPM/GAPcure) are required to clear title defects identified in this examination before commitment issuance.']
  curative_action_type varchar [note: 'Classification of the primary curative action required (e.g., lien release, reconveyance, satisfaction, gap cure, quiet title). [ENUM-REF-CANDIDATE: lien_release|reconveyance|satisfaction|gap_cure|quiet_title|subordination — promote to reference product]']
  curative_deadline_date date [note: 'Target date by which all curative actions must be completed to meet the scheduled closing date. Supports curative action aging and effectiveness metrics (VREQ-016).']
  estate_type varchar [note: 'Type of estate or interest in the property being insured as identified during examination: fee simple, leasehold, life estate, or easement. Populates Schedule A of the commitment.']
  examination_completion_timestamp timestamp [note: 'Precise date and time the examiner finalized the examination and released findings. Used to compute title clearance cycle time and examiner throughput metrics.']
  examination_date date [note: 'Calendar date on which the title examiner completed the formal review of the assembled search results. Principal business event date for cycle-time measurement.']
  examination_number varchar [note: 'Externally visible alphanumeric identifier assigned to this examination by the title production system (e.g., SoftPro/RamQuest). Used for cross-system traceability.']
  examination_scope_notes varchar [note: 'Free-text notes describing the scope, limitations, or special conditions of the examination (e.g., limited search period, missing instruments, county plant gaps). Supports evidence provenance.']
  examination_start_timestamp timestamp [note: 'Precise date and time the examiner began reviewing the search package. Used with completion timestamp to compute title clearance cycle time (VREQ-016).']
  examination_status varchar [note: 'Current lifecycle state of the title examination record. Drives workflow routing and closing-readiness metrics. [ENUM-REF-CANDIDATE: pending|in_review|completed|revised|cancelled — promote to reference product if states expand]']
  examination_type varchar [note: 'Classification of the scope of examination: full chain-of-title review, limited/O&E, update/bring-down, or gap-period examination. Drives examiner effort and risk assessment.']
  examiner_license_number varchar [note: 'State-issued license or bar number of the title examiner or attorney who performed the examination. Required for regulatory compliance and examiner credential verification.']
  examiner_opinion varchar [note: 'Formal written opinion or summary conclusion of the title examiner regarding the state of title, including any qualifications or conditions. Core evidence and provenance field (VREQ-007).']
  examiner_state_code varchar [note: 'Two-letter US state code where the examiner is licensed to perform title examinations. Ensures jurisdiction-appropriate examination standards are applied.']
  exception_count varchar [note: 'Number of Schedule B-II policy exceptions (policy_exception records) identified during examination. Supports owner-versus-lender coverage and exception rate metrics.']
  finding_count varchar [note: 'Total number of title_finding records generated from this examination. Supports open/aging defect metrics and examiner productivity reporting (VREQ-016).']
  gap_coverage_required boolean [note: 'Indicates whether gap coverage is required between the search-through date and the anticipated recording date. Triggers gap curative (GAPcure) workflow.']
  judgment_lien_identified boolean [note: 'Indicates whether a judgment lien against the vested owner or property was identified during examination. Requires curative clearance before policy issuance.']
  lien_search_included boolean [note: 'Indicates whether a lien search (judgment liens, tax liens, mechanics liens, HOA assessments) was included in the examination scope. Affects unresolved lien metrics.']
  lis_pendens_identified boolean [note: 'Indicates whether a lis pendens (LP) — notice of pending litigation — was identified against the subject property during examination. Significant underwriting risk factor.']
  marketable_title_determination varchar [note: 'Examiner\'s determination of title quality: marketable, insurable (with exceptions), uninsurable, or conditional pending curative action. Drives underwriting referral and commitment issuance.']
  mechanics_lien_identified boolean [note: 'Indicates whether a mechanics lien or materialman\'s lien was identified against the subject property during examination. Common in construction transactions.']
  open_requirement_count varchar [note: 'Number of Schedule B-I title requirements (title_requirement records) that remain open/uncleared at the time of last update. Drives open and aging requirements metric (VREQ-016).']
  prior_policy_date date [note: 'Effective date of the prior owner\'s title policy identified during examination. Used to determine prior policy rate eligibility and search period requirements.']
  prior_policy_number varchar [note: 'Policy number of any prior owner\'s title policy (OTP) identified during examination. Used for prior policy rate eligibility and evidence of prior insured title.']
  property_county_fips varchar [note: 'Five-digit FIPS county code for the county in which the subject property is located. Used for county recorder routing, plant access, and jurisdiction-level reporting.']
  property_state_code varchar [note: 'Two-letter US state code of the subject property being examined. Determines applicable state title law, recording requirements, and underwriting guidelines.']
  revision_number varchar [note: 'Sequential revision counter for this examination record. Increments when the examination is updated due to new search results, curative completions, or examiner corrections. Supports lifecycle history (VREQ-007).']
  revision_reason varchar [note: 'Reason for revising a prior examination (e.g., updated search results, curative completion, examiner correction, new lien discovered). Supports commitment revision frequency metric (VREQ-016).']
  search_from_date date [note: 'The earliest date from which the chain-of-title search was assembled. Together with search_through_date defines the full search period examined.']
  search_through_date date [note: 'The effective date through which the title search was run and the examiner reviewed. Defines the gap period boundary for gap coverage (GAP) analysis.']
  source_system_code varchar [note: 'Code identifying the title production system of record from which this examination record originated (e.g., SoftPro Select, RamQuest Horizon, Qualia). Supports data lineage.']
  source_system_exam_ref varchar [note: 'Native identifier for this examination record in the originating title production system (SoftPro/RamQuest/Qualia). Enables cross-system reconciliation and audit traceability.']
  tax_lien_identified boolean [note: 'Indicates whether a federal or state tax lien was identified against the subject property or vested owner during examination. Triggers curative requirement.']
  transaction_type varchar [note: 'Type of real-estate transaction driving the examination: purchase, refinance (REFI), home-equity line of credit (HELOC), construction, or commercial. Affects examination scope and underwriting risk.']
  underwriting_referral_reason varchar [note: 'Free-text or coded reason explaining why the examination was escalated for underwriting review (e.g., chain-of-title break, unresolved lien, high-risk vesting). Supports UWR rate analysis.']
  underwriting_referral_required boolean [note: 'Indicates whether this examination requires escalation to an underwriter for risk review (UWR). Drives underwriting referral rate metric (VREQ-016).']
  updated_timestamp timestamp [note: 'Date and time when this examination record was last modified. Audit field supporting change detection, incremental ETL, and lifecycle history tracking (VREQ-007).']
  vesting_type varchar [note: 'Form of title vesting identified during examination (e.g., joint tenancy, tenancy in common, community property, sole ownership, trust). Drives Schedule A vesting language.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'SSOT for the title examination record — the formal examiner review of assembled search results that produces title_findings and drives title_requirements. Each record captures examiner identity, examination date, examination type (full, limited'
}

Table ti_underwriting.decision {
  decision_id varchar [pk, note: 'Unique surrogate identifier for each discrete underwriting decision record. Primary key for the underwriting_decision entity.']
  agent_profile_id varchar [note: 'Reference to the independent title agent profile associated with this underwriting decision, when the order was produced through the independent agent channel.']
  operations_title_examination_id varchar [note: 'Foreign key linking to operations.title_examination. Business justification: Underwriting decisions require evidence provenance per VREQ-009. Direct link to operations examination establishes chain-of-custody for title findings and supports underwriting']
  party_id varchar [note: 'Reference to the party record of the underwriter who rendered this decision. Supports UW authority tracking and workload analytics.']
  prior_decision_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding version of this underwriting decision. Preserves full revision history per VREQ-007.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Underwriting decisions assess insurability of specific properties. Direct property link enables risk analysis by property characteristics, transaction type correlation, and claim frequency']
  title_commitment_id varchar [note: 'Reference to the title commitment associated with this underwriting decision, if the decision was rendered in the context of a commitment issuance or revision.']
  title_evidence_id varchar [note: 'Reference to the primary supporting evidence document in the document management system that substantiates this underwriting decision. Supports evidence provenance per VREQ-007.']
  title_finding_id varchar [note: 'Reference to the specific title finding that is the subject of this underwriting decision, when the decision is finding-specific rather than order-level.']
  title_order_id varchar [note: 'Reference to the title order for which this underwriting decision was rendered. Every underwriting decision must trace back to an originating title order.']
  uw_referral_id varchar [note: 'Reference to the uw_referral event that triggered this underwriting decision. A decision may exist without a referral for routine authority-level approvals.']
  conditions_imposed varchar [note: 'Free-text description of conditions, requirements, or curative actions imposed by the underwriter as part of a conditional approval. Drives Schedule B-I requirement generation.']
  cot_break_indicator boolean [note: 'Indicates whether a chain-of-title break was identified as part of the risk subject to this underwriting decision. Supports chain-of-title break metrics per VREQ-016.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) code identifying the county in which the subject property is located. Used for jurisdiction-level risk and regulatory reporting.']
  curative_action_required boolean [note: 'Indicates whether the underwriting decision mandates one or more curative actions (CPM/GAPcure) before title can be insured or the commitment can be issued.']
  curative_deadline_date date [note: 'Date by which all curative actions mandated by this underwriting decision must be completed. Drives curative aging and SLA breach metrics per VREQ-016.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this decision record. Defaults to USD for domestic US title transactions.']
  decision_date date [note: 'Calendar date on which the underwriter rendered the formal decision. Principal business event date for this entity; distinct from the decision timestamp.']
  decision_number varchar [note: 'Externally visible alphanumeric identifier for this underwriting decision, used in correspondence, commitment schedules, and audit trails. Business-facing reference number.']
  decision_status varchar [note: 'Current workflow state of the underwriting decision record. Drives commitment issuance eligibility and curative action requirements.']
  decision_timestamp timestamp [note: 'Precise date and time (with timezone offset) at which the underwriting decision was recorded in the system. Supports SLA measurement and audit trail requirements.']
  decision_type varchar [note: 'Classification of the decision rendered. Distinguishes insurable/marketable title determinations from risk acceptances, declinations, and conditional approvals.']
  defect_category varchar [note: 'Primary category of title defect or risk that is the subject of this underwriting decision. [ENUM-REF-CANDIDATE: lien|encumbrance|cot_break|gap_period|vesting_defect|easement|encroachment|judgment|tax_lien|mechanics_lien — promote to reference product]']
  effective_date date [note: 'Date from which this underwriting decision is legally effective. Per VREQ-008, kept distinct from decision_date, expiration_date, and revision dates.']
  endorsement_required boolean [note: 'Indicates whether the underwriting decision requires issuance of one or more ALTA endorsements as a condition of insuring title.']
  endorsement_types varchar [note: 'Comma-separated list of ALTA endorsement form numbers required by this decision (e.g., ALTA 9, ALTA 8.1, ALTA 22). Populated when endorsement_required is true.']
  escalation_count varchar [note: 'Number of times this underwriting decision was escalated to a higher authority level. Supports UW referral and exception rate metrics per VREQ-016.']
  exception_scheduled boolean [note: 'Indicates whether the underwriting decision resulted in a Schedule B-II exception being carried to the commitment or policy rather than cured.']
  expiration_date date [note: 'Date after which this underwriting decision is no longer valid and must be re-evaluated. Supports commitment expiration and closing readiness tracking.']
  gap_period_indicator boolean [note: 'Indicates whether a gap period risk was identified and is subject to this underwriting decision. Supports gap coverage tracking and curative action requirements.']
  insurable_title_determination varchar [note: 'Formal determination of whether title is insurable as of the decision date. SSOT for insurable title status; distinct from marketable title determination.']
  is_exception_approval boolean [note: 'Indicates whether this decision constitutes a policy exception approval (PE) — an approval granted outside standard underwriting guidelines. Supports UW exception rate metrics.']
  liability_amount decimal(18,2) [note: 'Total dollar amount of title insurance liability subject to this underwriting decision. Used for authority-level thresholds and risk exposure reporting.']
  marketable_title_determination varchar [note: 'Formal determination of whether title meets the marketable title standard. Legally distinct from insurable title; both must be tracked per VREQ-007.']
  outcome varchar [note: 'The formal outcome of the underwriting review. Distinct from decision_status (workflow state) — this is the substantive risk determination result.']
  policy_type_requested varchar [note: 'Indicates whether the underwriting decision covers an Owner\'s Title Policy (OTP), Lender\'s Title Policy (LTP), or both. Supports owner-versus-lender coverage metrics per VREQ-016.']
  prior_claim_reference varchar [note: 'Reference number or identifier of any prior title claim on the subject property that influenced this underwriting decision. Supports claim frequency and risk history analysis.']
  production_channel varchar [note: 'Channel through which the title order was originated, indicating whether the underwriting decision was rendered for a direct branch, centralized lender, or independent agent transaction.']
  rationale varchar [note: 'Detailed narrative explanation of the underwriter\'s reasoning, risk analysis, and basis for the decision outcome. Preserved for audit, legal, and regulatory review.']
  referral_date date [note: 'Date on which the underwriting referral or risk matter was submitted to the underwriter for decision. Used to calculate UW turnaround time and referral aging metrics.']
  referral_trigger_reason varchar [note: 'Narrative or coded reason that caused this matter to require an underwriting decision, e.g., liability threshold exceeded, chain-of-title break, prior claim, gap period.']
  revision_number varchar [note: 'Sequential revision counter for this underwriting decision. Increments each time the decision is modified. Supports commitment revision frequency metrics per VREQ-016.']
  revision_reason varchar [note: 'Narrative explanation for why this underwriting decision was revised from the prior version. Required when revision_number > 1 to preserve material lifecycle transitions per VREQ-007.']
  risk_category varchar [note: 'Risk tier assigned by the underwriter based on defect severity, lien exposure, chain-of-title integrity, and other risk factors identified during examination.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this underwriting decision record originated (e.g., SoftPro, RamQuest, Qualia). Supports data lineage and SoR traceability.']
  source_system_decision_ref varchar [note: 'Native identifier of this underwriting decision in the originating source system. Enables cross-system reconciliation between the lakehouse and the title production or UW risk system.']
  state_code varchar [note: 'Two-letter USPS state code for the state in which the subject property is located. Determines applicable state insurance regulations and underwriting guidelines.']
  transaction_type varchar [note: 'Type of real estate transaction for which the underwriting decision was rendered. Drives applicable risk standards and policy form selection.']
  underwriter_notes varchar [note: 'Supplemental free-text notes entered by the underwriter, distinct from the formal decision rationale. May include internal guidance, caveats, or follow-up instructions.']
  uw_authority_level varchar [note: 'Authority tier at which this decision was rendered. Tracks escalation path and ensures decisions are within the underwriter\'s delegated authority limits.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'SSOT for discrete underwriting decisions and the AUTHORITATIVE insurable/marketable-title determination — the formal risk-acceptance determinations made by an underwriter, kept distinct from the uw_referral event that may trigger them and from the'
}

Table ti_settlement.closing_order {
  closing_order_id varchar [pk, note: 'Unique surrogate identifier for the closing order record. Primary key for the settlement domain closing engagement entity.']
  agency_agreement_id varchar [note: 'Foreign key linking to agency.agreement. Business justification: Closing orders produced under agency agreements require agreement reference for authority limit validation, geographic scope enforcement, transaction type authorization verification, and']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Closing orders produced by agents require agent identification for authority verification, CPL issuance validation, escrow authority enforcement, oversight review sampling, and']
  closing_escrow_officer_party_id varchar [note: 'Reference to the party record for the escrow officer (EOT) responsible for managing trust funds and coordinating the closing. Supports IOLTA accountability.']
  closing_lender_party_id varchar [note: 'Reference to the party record for the lending institution funding this transaction. Drives lender-specific closing instructions, wire instructions, and CPL requirements.']
  cpl_issuance_id varchar [note: 'Reference to the CPL issuance record in the agency management system. Links closing order to the specific CPL issued for lender protection.']
  escrow_ledger_id varchar [note: 'Reference to the escrow trust ledger associated with this closing order. Supports receipt-to-disbursement reconciliation and three-way trust accounting.']
  primary_closing_agent_party_id varchar [note: 'Reference to the party record for the closing agent or settlement agent conducting the closing. May differ from escrow officer in some jurisdictions.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Closing order is executed for a specific property. Currently closing_order links to title_order which links to parcel, but adding direct property_id FK strengthens the model by providing']
  settlement_statement_id varchar [note: 'Reference to the settlement statement (CD/HUD-1/ALTA) prepared for this closing. Kept as a distinct entity per VREQ-003.']
  title_commitment_id varchar [note: 'Reference to the title commitment issued for this transaction. Drives closing-readiness validation against Schedule B-I requirements.']
  title_order_id varchar [note: 'Reference to the parent title order that initiated this closing engagement. Links the closing event to the upstream title production workflow.']
  title_policy_id varchar [note: 'Foreign key linking to underwriting.title_policy. Business justification: Closing orders track which policies were issued at closing for CPL coverage determination, gap coverage validation, post-closing audit trails, and agency remittance reporting.']
  actual_closing_timestamp timestamp [note: 'Date and time the closing was actually executed (all documents signed). Distinct from scheduled time; used to measure closing cycle time and SLA adherence.']
  all_requirements_cleared boolean [note: 'Indicates whether all Schedule B-I title requirements have been satisfied and cleared prior to closing. Key closing-readiness gate control.']
  cancellation_date date [note: 'Date on which the closing order was cancelled. Used for pipeline fallout reporting and earnest money deposit disposition tracking.']
  cancellation_reason varchar [note: 'Free-text or coded reason for cancellation of the closing order. Populated only when closing_status is cancelled. Supports fallout analysis and pipeline reporting.']
  cash_to_close_amount decimal(15,2) [note: 'Net amount of funds the buyer must bring to closing after credits, deposits, and loan proceeds. Key figure on the Closing Disclosure under TRID.']
  cd_acknowledged_date date [note: 'Date the borrower acknowledged receipt of the Closing Disclosure. Starts the mandatory 3-business-day waiting period under TRID.']
  cd_delivery_date date [note: 'Date the Closing Disclosure (CD) was delivered to the borrower. TRID requires delivery at least 3 business days before consummation.']
  channel_type varchar [note: 'Production channel through which this closing order was originated. Determines agency remittance rules, CPL issuance authority, and premium split schedules.']
  closing_location_type varchar [note: 'Type of physical or virtual location where the closing is conducted. Supports operational capacity planning and RON/IPEN compliance tracking.']
  closing_method varchar [note: 'Execution method for document signing at closing. Wet-sign is traditional in-person; RON (Remote Online Notarization) and IPEN (In-Person Electronic Notarization) are electronic alternatives.']
  closing_readiness_status varchar [note: 'Operational readiness state indicating whether all title requirements, funding conditions, and document preparation steps are satisfied for closing to proceed.']
  closing_status varchar [note: 'Current lifecycle state of the closing order. Drives closing-readiness dashboards and workflow routing. [ENUM-REF-CANDIDATE: scheduled|in_progress|closed|cancelled|on_hold|pending_funding — promote to reference product]']
  cpl_issued boolean [note: 'Indicates whether a Closing Protection Letter (CPL) was issued for this closing engagement. CPL protects the lender against escrow officer fraud or failure.']
  created_timestamp timestamp [note: 'Timestamp when the closing order record was first created in the title production system. Audit trail anchor for lifecycle tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this closing order. Defaults to USD for domestic US transactions.']
  disbursement_date date [note: 'Date on which escrow funds were disbursed to payees (seller, lienholders, service providers). Must follow funding and recording per state good-funds laws.']
  earnest_money_deposit_amount decimal(15,2) [note: 'Amount of the earnest money deposit (EMD) held in escrow trust. Applied as a credit to the buyer at closing on the settlement statement.']
  effective_date date [note: 'The contractual effective date of the transaction (e.g., purchase agreement effective date). Distinct from execution, recording, and disbursement dates per VREQ-008.']
  execution_date date [note: 'Date on which closing documents were executed (signed) by all parties. Distinct from effective, recording, and disbursement dates per VREQ-008.']
  funding_date date [note: 'Date on which loan proceeds were disbursed by the lender into the escrow trust account. Critical for disbursement authorization and gap coverage period calculation.']
  gap_coverage_end_date date [note: 'End date of the gap coverage period, typically the date of recording. Marks the close of the insured gap window.']
  gap_coverage_required boolean [note: 'Indicates whether gap coverage is required for the period between closing and recording. Relevant in states where simultaneous recording is not guaranteed.']
  gap_coverage_start_date date [note: 'Start date of the gap coverage period, typically the date of closing/execution. Marks the beginning of the insured gap between closing and recording.']
  iolta_account_flag boolean [note: 'Indicates whether the escrow trust account for this closing is an IOLTA account. Relevant for attorney-agent states with IOLTA compliance requirements.']
  lender_closing_instructions_date date [note: 'Date on which lender closing instructions were received by the settlement agent. Used to measure lead time and closing preparation cycle.']
  lender_closing_instructions_received boolean [note: 'Indicates whether lender closing instructions have been received and acknowledged by the settlement agent. A prerequisite for closing readiness.']
  loan_amount decimal(15,2) [note: 'Principal loan amount being funded at closing. Used for LTV calculation, lender policy premium computation, and settlement statement line items.']
  ltv_ratio decimal(6,4) [note: 'Loan-to-Value ratio computed as loan amount divided by purchase price or appraised value. Used for underwriting risk assessment and lender policy coverage determination.']
  number varchar [note: 'Externally visible alphanumeric identifier for the closing engagement, used in lender, agent, and consumer communications. Sourced from the title production system (SoftPro/Qualia).']
  positive_pay_submitted boolean [note: 'Indicates whether positive pay files were submitted to the escrow trust bank for check disbursements at closing. Supports ALTA Best Practices Pillar 5 reconciliation controls.']
  purchase_price_amount decimal(15,2) [note: 'Gross purchase price of the real property as stated in the purchase agreement. Base amount for premium calculation, transfer tax, and settlement statement preparation.']
  recording_date date [note: 'Date the deed and/or deed of trust were recorded with the county recorder/register of deeds. Distinct from execution, funding, and disbursement dates per VREQ-008.']
  scheduled_closing_date date [note: 'The calendar date on which the closing event is scheduled to occur. Used for closing-readiness tracking and SLA measurement.']
  scheduled_closing_time timestamp [note: 'Precise date and time the closing appointment is scheduled, including timezone offset. Supports RON/IPEN session coordination and notary scheduling.']
  settlement_form_type varchar [note: 'Type of settlement statement form required for this closing. CD (Closing Disclosure) applies under TRID; HUD-1 applies to pre-TRID or exempt transactions; ALTA Settlement Statement for cash/commercial.']
  three_way_reconciliation_status varchar [note: 'Status of the three-way escrow trust account reconciliation (bank balance vs. book balance vs. trial balance). Required under ALTA Best Practices Pillar 5.']
  title_premium_lender_amount decimal(15,2) [note: 'Premium charged for the lender\'s title insurance policy (LTP). Separately tracked from owner premium per VREQ-010 and TRID disclosure requirements.']
  title_premium_owner_amount decimal(15,2) [note: 'Premium charged for the owner\'s title insurance policy (OTP). Feeds premium remittance calculation and agency split schedule.']
  total_settlement_charges_amount decimal(15,2) [note: 'Total closing costs and settlement charges as reflected on the settlement statement. Supports TRID tolerance monitoring and consumer disclosure compliance.']
  transaction_type varchar [note: 'Classification of the real-estate transaction driving this closing. Determines applicable regulatory disclosures (TRID/RESPA) and settlement statement form (CD vs HUD-1 vs ALTA).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the closing order record. Supports change detection, incremental ETL, and audit compliance.']
  wire_instructions_verified boolean [note: 'Indicates whether wire instructions for disbursement have been independently verified per ALTA Best Practices fraud prevention controls. Actual wire details stored in NPPI Vault.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for a closing/settlement engagement, representing the scheduling and coordination of a closing event tied to a title order. Tracks closing type (purchase, refinance, HELOC, construction), closing method (wet-sign, RON, IPEN, hybrid)'
}

Table ti_settlement.settlement_statement {
  settlement_statement_id varchar [pk, note: 'Unique surrogate identifier for the settlement statement record. Primary key for the settlement_statement entity in the Silver layer lakehouse.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Settlement statements reference the legal description for property identification on HUD-1/CD forms and Schedule A consistency verification before closing; ensures settlement agent']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Settlement statements require specific parcel APN for property tax proration calculations, legal description Schedule A accuracy verification, recording jurisdiction determination, and']
  prior_statement_settlement_statement_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding version of this settlement statement. Enables full revision chain traversal and prior classification preservation per VREQ-007.']
  title_commitment_id varchar [note: 'Reference to the title commitment that underpins the closing. Ties the settlement statement to the underwriting commitment in force at closing.']
  title_order_id varchar [note: 'Reference to the title order that initiated this closing transaction. Links the settlement statement to the originating order intake record.']
  title_policy_id varchar [note: 'Foreign key linking to underwriting.title_policy. Business justification: Settlement statements must reference the issued owner and/or lender policy for premium reconciliation, IRS 1099-S reporting, regulatory compliance, and post-closing audit trails.']
  acceptance_date date [note: 'Date on which the settlement statement was accepted or approved by the lender or counterparty. Distinct field per VREQ-008.']
  cash_to_close decimal(15,2) [note: 'Net cash amount the borrower must bring to closing (or receive back) after all credits and debits are applied. Key closing-readiness metric. Positive = cash due from borrower; negative = cash back to borrower.']
  closing_date date [note: 'The scheduled or actual date on which the real estate closing and settlement occurred. Principal business event date for the settlement transaction. Distinct from execution, effective, and recording dates per VREQ-008.']
  closing_location varchar [note: 'Physical address or description of the location where the closing was conducted (e.g., branch office address, attorney office, remote/RON). Supports audit and notarization compliance.']
  closing_method varchar [note: 'Method by which the closing documents were executed. wet_sign = traditional in-person wet signature; ron = Remote Online Notarization; ipen = In-Person Electronic Notarization; mail_away = documents mailed for signature.']
  cpl_issued boolean [note: 'Indicates whether a Closing Protection Letter (CPL) was issued for this closing. CPL protects the lender against settlement agent fraud or failure to follow closing instructions.']
  created_timestamp timestamp [note: 'Timestamp when this settlement statement record was first created in the system. Audit trail field supporting SOX and SOC 2 compliance.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this settlement statement. Defaults to USD for domestic U.S. real estate transactions.']
  disbursement_date date [note: 'Date on which escrow funds were disbursed to all payees following closing. May differ from closing date in refinance transactions due to rescission period. Distinct from closing_date per VREQ-008.']
  earnest_money_deposit decimal(15,2) [note: 'Earnest money deposit amount credited to the borrower/buyer on the settlement statement. Reflects funds held in escrow prior to closing and applied at settlement.']
  effective_date date [note: 'Date on which the settlement statement terms become legally effective. May differ from execution date in certain transaction types. Distinct field per VREQ-008.']
  execution_date date [note: 'Date on which the settlement statement was signed/executed by the parties. Distinct from effective, submission, acceptance, and recording dates per VREQ-008.']
  gross_amount_due_borrower decimal(15,2) [note: 'Total gross amount due from the borrower at closing before credits and adjustments. Corresponds to Section 100 of HUD-1 or borrower-side summary on CD/ALTA statement.']
  hoa_dues_prorated decimal(15,2) [note: 'Prorated HOA dues credited or debited between buyer and seller at closing. Reflects the HOA assessment allocation through the closing date.']
  irs_1099s_required boolean [note: 'Indicates whether IRS Form 1099-S reporting is required for this real estate transaction. Driven by sales price threshold and seller exemption status.']
  lender_title_premium decimal(15,2) [note: 'Premium charged for the lender\'s title insurance policy (LTP) as shown on the settlement statement. Supports premium revenue recognition and owner-vs-lender policy coverage metrics per VREQ-016.']
  loan_amount decimal(15,2) [note: 'Principal loan amount being funded at closing as stated on the settlement statement. Used for LTV calculation, premium computation, and lender policy coverage amount.']
  owner_title_premium decimal(15,2) [note: 'Premium charged for the owner\'s title insurance policy (OTP) as shown on the settlement statement. Supports premium revenue recognition and owner-vs-lender policy coverage metrics per VREQ-016.']
  payoff_first_mortgage decimal(15,2) [note: 'Payoff amount for the existing first mortgage or deed of trust (DOT) being satisfied at closing. Includes principal, accrued interest, and per diem through disbursement date.']
  payoff_second_mortgage decimal(15,2) [note: 'Payoff amount for any existing second mortgage or home equity line of credit (HELOC) being satisfied at closing. Null if no second lien exists.']
  production_channel varchar [note: 'Channel through which the title order and closing were produced. Drives agency remittance, premium split, and CPL applicability. direct_branch, centralized_lender, or independent_agent.']
  prorated_taxes decimal(15,2) [note: 'Property tax proration amount credited or debited between buyer and seller based on the closing date within the tax year. Disclosed on the settlement statement.']
  real_estate_commission decimal(15,2) [note: 'Total real estate brokerage commission paid at closing, typically from seller proceeds. Disclosed on the settlement statement. Null for refinance transactions.']
  recording_date date [note: 'Date on which the associated deed and/or mortgage instruments were recorded with the county recorder. Distinct field per VREQ-008. Supports policy issuance lag metric.']
  recording_fees decimal(15,2) [note: 'Total fees paid to the county recorder for recording the deed, mortgage/deed of trust, and any other instruments at closing. Disclosed as a zero-tolerance item under TRID.']
  rescission_expiry_date date [note: 'Date on which the borrower\'s right of rescission expires for refinance transactions under TILA. Disbursement is held until this date. Null for purchase transactions.']
  revision_number varchar [note: 'Sequential integer revision counter for this settlement statement. Increments with each material change. Supports lifecycle history per VREQ-007 and TRID tolerance cure tracking.']
  revision_reason varchar [note: 'Free-text or coded reason for the most recent revision to this settlement statement (e.g., changed loan terms, corrected fee, tolerance cure). Preserves material lifecycle transitions per VREQ-007.']
  sales_price decimal(15,2) [note: 'Contract purchase price of the real property as stated on the settlement statement. Applicable to purchase transactions. Null for refinance. Reported on Schedule A and IRS Form 1099-S.']
  seller_net_proceeds decimal(15,2) [note: 'Net amount disbursed to the seller after payoff of existing liens, commissions, and closing costs. Applicable to purchase transactions. Null for refinance.']
  settlement_agent_name varchar [note: 'Name of the settlement agent or escrow officer responsible for conducting the closing and preparing the settlement statement. Disclosed on the CD/HUD-1/ALTA statement.']
  settlement_fee decimal(15,2) [note: 'Fee charged by the settlement agent or escrow officer for conducting the closing. Disclosed on the settlement statement as a title service fee under TRID Section B or C.']
  statement_form_type varchar [note: 'Regulatory form type used for this settlement statement. CD = Closing Disclosure (TRID/TILA-RESPA), HUD-1 = legacy RESPA settlement statement, ALTA = ALTA Settlement Statement for non-TRID transactions.']
  statement_number varchar [note: 'Externally visible alphanumeric identifier assigned to this settlement statement by the title production or escrow system (e.g., SoftPro file number suffix). Used for audit and regulatory reference.']
  statement_status varchar [note: 'Current lifecycle status of the settlement statement. Tracks progression from draft preparation through final execution and any post-closing void or correction.']
  submission_date date [note: 'Date on which the settlement statement was submitted to the lender or relevant party for review or approval. Distinct field per VREQ-008.']
  three_day_waiting_period_met boolean [note: 'Indicates whether the mandatory three-business-day waiting period between CD delivery and consummation was satisfied under TRID. Critical compliance flag for CFPB examination.']
  tolerance_cure_amount decimal(15,2) [note: 'Dollar amount of any tolerance cure credit applied to the borrower due to TRID fee tolerance violations. Disclosed on the final CD. Zero if no cure was required.']
  total_closing_costs_borrower decimal(15,2) [note: 'Total closing costs charged to the borrower as summarized on the settlement statement. Includes origination charges, title fees, recording fees, prepaid items, and escrow reserves.']
  total_closing_costs_seller decimal(15,2) [note: 'Total closing costs charged to the seller as summarized on the settlement statement. Includes real estate commissions, seller-paid title fees, and payoff amounts. Null for refinance.']
  total_credits_borrower decimal(15,2) [note: 'Total credits applied to the borrower\'s side of the settlement statement including earnest money deposit (EMD), seller credits, and loan proceeds. Corresponds to Section 200 of HUD-1.']
  transaction_type varchar [note: 'Classification of the real estate transaction type. Drives applicable regulatory form requirements and settlement line-item structure. [ENUM-REF-CANDIDATE: purchase|refinance|home_equity|construction|commercial — promote to reference product]']
  transfer_tax_amount decimal(15,2) [note: 'State and/or county real estate transfer tax or documentary stamp tax charged at closing. Allocated between buyer and seller per local custom and disclosed on the settlement statement.']
  trid_applicable boolean [note: 'Indicates whether TRID disclosure rules apply to this transaction. True for most consumer mortgage transactions; False for cash, commercial, or exempt transactions requiring HUD-1 or ALTA form.']
  updated_timestamp timestamp [note: 'Timestamp when this settlement statement record was most recently modified. Supports change detection, audit trail, and revision history per VREQ-007.']
  wire_amount_borrower decimal(15,2) [note: 'Dollar amount of the wire transfer received from or sent to the borrower at closing. Sensitive financial data per VREQ-012. Reconciled against escrow ledger receipts.']
  wire_amount_lender decimal(15,2) [note: 'Dollar amount of the loan proceeds wire received from the lender at closing. Sensitive financial data per VREQ-012. Reconciled against escrow ledger receipts.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Legally and operationally distinct settlement statement record capturing the final financial accounting of a real estate closing. Stores statement form type (CD/Closing Disclosure, HUD-1, ALTA Settlement Statement), statement version and revision number'
}

Table ti_settlement.escrow_ledger {
  escrow_ledger_id varchar [pk, note: 'Unique surrogate identifier for the escrow trust account ledger record. Primary key for this entity.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Escrow ledgers managed by agents require agent identification for escrow authority verification, IOLTA compliance validation, three-way reconciliation oversight, trust account audit, and']
  cpl_issuance_id varchar [note: 'Reference to the CPL issuance record in the agency domain. Links the escrow ledger to the specific CPL protecting this closing.']
  party_id varchar [note: 'Reference to the escrow officer or trust officer responsible for managing this ledger and authorizing disbursements.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Escrow ledgers track funds for specific property transactions; essential for three-way reconciliation, trust accounting regulatory audits, and property-level escrow balance reporting']
  settlement_statement_id varchar [note: 'Reference to the associated settlement statement (CD/HUD-1/ALTA). Distinct from the escrow ledger per VREQ-003; linked for reconciliation purposes.']
  title_order_id varchar [note: 'Reference to the title order that initiated this escrow ledger. Links the escrow trust account to the originating transaction.']
  title_policy_id varchar [note: 'Foreign key linking to underwriting.title_policy. Business justification: Escrow ledgers track premium collection and disbursement tied to specific policies for three-way reconciliation, agency remittance reporting, and regulatory compliance.']
  actual_closing_date date [note: 'Date on which the closing actually occurred and disbursements were authorized. May differ from scheduled_closing_date.']
  branch_code varchar [note: 'Reference to the direct branch, centralized lender channel, or independent agent office responsible for this escrow ledger.']
  buyer_funds_amount decimal(18,2) [note: 'Total cash-to-close funds received from the buyer/borrower into escrow, net of any earnest money deposit already credited.']
  cpl_issued boolean [note: 'Indicates whether a Closing Protection Letter (CPL/Insured Closing Letter) was issued for this closing, protecting the lender against escrow officer fraud or misapplication of funds.']
  created_timestamp timestamp [note: 'Timestamp when this escrow ledger record was first created in the system of record. Audit trail for record provenance.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this ledger. Typically USD for US title transactions.']
  current_balance decimal(18,2) [note: 'Current book balance of the escrow trust account ledger (total receipts minus total disbursements). Should equal zero at ledger close.']
  disbursement_authorization_method varchar [note: 'Method required to authorize disbursements from this escrow ledger (e.g., dual signature, single signature, electronic approval). Controls disbursement risk.']
  emd_amount decimal(18,2) [note: 'Dollar amount of the earnest money deposit received into escrow. Key component of the receipt-to-disbursement reconciliation for purchase transactions.']
  emd_received_date date [note: 'Date the earnest money deposit was received into the escrow trust account. Key milestone for purchase transactions.']
  escrow_fee_amount decimal(18,2) [note: 'Fee charged by the settlement/escrow agent for closing services, collected through escrow and disbursed to the title company.']
  gl_account_code varchar [note: 'General ledger account code to which this escrow ledger maps in the ERP/GL system for premium revenue recognition and financial reporting.']
  holdback_amount decimal(18,2) [note: 'Amount withheld in escrow post-closing for a specific purpose (e.g., repair holdback, construction draw, or curative holdback). Released upon condition satisfaction.']
  holdback_release_date date [note: 'Date on which the escrow holdback amount was or is scheduled to be released upon satisfaction of the holdback condition.']
  iolta_account_flag boolean [note: 'Indicates whether the trust account holding these escrow funds is an IOLTA account. Relevant for interest remittance to state bar foundation.']
  last_updated_timestamp timestamp [note: 'Timestamp when this escrow ledger record was most recently modified. Supports change detection and audit trail.']
  ledger_close_date date [note: 'Date the escrow ledger was formally closed after all disbursements, reconciliation, and any holdback releases were completed.']
  ledger_number varchar [note: 'Externally-known alphanumeric identifier for this escrow trust account ledger, assigned by the escrow/trust accounting system (e.g., SoftPro Trust Accounting).']
  ledger_status varchar [note: 'Current lifecycle state of the escrow ledger. Tracks progression from open through reconciliation and closure. [ENUM-REF-CANDIDATE: open|pending_close|closed|reconciled|voided|suspended — promote to reference product]']
  ledger_type varchar [note: 'Classification of the escrow ledger by transaction type: purchase, refinance, HELOC, construction, commercial, or home equity. Drives workflow and disbursement rules.']
  loan_proceeds_amount decimal(18,2) [note: 'Amount of lender loan proceeds wired into the escrow trust account for disbursement at closing.']
  opening_date date [note: 'Date the escrow trust account ledger was opened and funds were first authorized to be received for this closing.']
  out_of_balance_amount decimal(18,2) [note: 'Dollar variance identified during three-way reconciliation between the bank statement balance, book balance, and individual ledger balances. Zero when balanced.']
  out_of_balance_reason varchar [note: 'Narrative explanation for any out-of-balance condition identified during three-way reconciliation. Required for audit and remediation tracking.']
  payoff_amount decimal(18,2) [note: 'Total amount disbursed from escrow to satisfy existing mortgage(s), deed(s) of trust, or other liens on the property at closing.']
  positive_pay_enrolled boolean [note: 'Indicates whether this escrow trust account is enrolled in the bank\'s positive pay fraud prevention program for check disbursements.']
  recording_fee_amount decimal(18,2) [note: 'Total recording fees collected through escrow for submission of deed, deed of trust, and other instruments to the county recorder.']
  scheduled_closing_date date [note: 'Anticipated date on which the closing and final disbursement of escrow funds is expected to occur.']
  seller_proceeds_amount decimal(18,2) [note: 'Net proceeds disbursed to the seller from escrow after payoff of existing liens, prorations, and closing costs.']
  source_system_ledger_ref varchar [note: 'Native ledger or file number assigned by the escrow/trust accounting system of record (e.g., SoftPro Trust Accounting, RamQuest). Supports SoR traceability.']
  three_way_reconciliation_date date [note: 'Date the most recent three-way reconciliation was performed: bank statement balance vs. book balance vs. individual ledger balances.']
  three_way_reconciliation_status varchar [note: 'Result of the most recent three-way reconciliation. Indicates whether the bank statement, book balance, and individual ledger balances are in agreement.']
  title_premium_amount decimal(18,2) [note: 'Total title insurance premium collected through escrow for owner and/or lender policies, to be remitted to the underwriter per the premium split schedule.']
  total_disbursements_amount decimal(18,2) [note: 'Cumulative gross amount of all funds disbursed from the escrow trust account for this ledger, including payoffs, proceeds, and fees.']
  total_receipts_amount decimal(18,2) [note: 'Cumulative gross amount of all funds received into the escrow trust account for this ledger, including EMD, loan proceeds, and buyer funds.']
  transfer_tax_amount decimal(18,2) [note: 'State and/or county transfer tax or documentary stamp tax collected through escrow and disbursed to the taxing authority at closing.']
  trust_account_bank_name varchar [note: 'Name of the financial institution holding the IOLTA/escrow trust account for this closing.']
  trust_account_number varchar [note: 'Bank account number of the IOLTA/escrow trust account holding funds for this closing. Restricted per VREQ-012 and GLBA as sensitive financial account data.']
  trust_account_routing_number varchar [note: 'ABA routing/transit number for the IOLTA/escrow trust account bank. Restricted per VREQ-012 as sensitive wire/bank instruction data.']
  wire_instruction_verified boolean [note: 'Indicates whether outgoing wire instructions for this escrow ledger have been independently verified per ALTA Best Practices wire fraud prevention procedures.']
  wire_verification_method varchar [note: 'Method used to verify outgoing wire instructions (e.g., phone callback to known number, secure portal confirmation, in-person). Supports wire fraud prevention audit.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Legally and operationally distinct escrow trust account ledger tracking every receipt and disbursement within the IOLTA/trust account for a specific closing.'
}

Table ti_settlement.disbursement {
  disbursement_id varchar [pk, note: 'Unique system-generated identifier for a single outgoing payment from the escrow trust account. Primary key for the disbursement record.']
  escrow_ledger_id varchar [note: 'Reference to the escrow trust account ledger from which this disbursement is drawn. Links the disbursement to its parent escrow ledger for three-way reconciliation.']
  payee_party_id varchar [note: 'Reference to the party record for the disbursement recipient. Links to the party master for role-based access and NPPI protection of payee details.']
  payee_party_role_id varchar [note: 'Foreign key linking to operations.party_role. Business justification: Disbursements require role context (seller proceeds, lender payoff, vendor payment) for settlement statement line-item mapping, 1099-S reporting, and role-specific disbursement rules.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Disbursements are property-specific for 1099-S reporting, transfer tax jurisdiction determination, recording fee calculation by county, and settlement statement line-item validation against']
  settlement_statement_id varchar [note: 'Reference to the settlement statement (CD/HUD-1/ALTA) that authorizes and documents this disbursement. Links disbursement to the closing disclosure line item.']
  title_order_id varchar [note: 'Reference to the title order associated with this disbursement, enabling traceability from disbursement back to the originating transaction order.']
  title_policy_id varchar [note: 'Foreign key linking to underwriting.title_policy. Business justification: Disbursements for policy-related costs (endorsement fees, curative actions paid by underwriter, premium refunds) must link to the policy for cost allocation, loss ratio analysis']
  aba_routing_number varchar [note: 'Nine-digit American Bankers Association (ABA) routing transit number for the receiving bank. Required for wire and ACH disbursements. Classified confidential as a partial banking identifier.']
  adjustment_amount decimal(15,2) [note: 'Any post-issuance adjustment applied to the disbursement (e.g., correction, proration true-up, fee revision). Negative values indicate reductions. Zero if no adjustment.']
  amount decimal(15,2) [note: 'Gross amount of the outgoing payment in the transaction currency. Represents the face value of the check or wire before any adjustments. Core monetary field for escrow reconciliation.']
  authorization_timestamp timestamp [note: 'Date and time the disbursement was formally authorized by the escrow officer or closing manager. Distinct from the issued date; captures the approval event for audit trail.']
  authorized_by varchar [note: 'Name or identifier of the escrow officer or authorized signatory who approved this disbursement. Required for dual-control and audit compliance under ALTA Best Practices.']
  bank_account_ref varchar [note: 'Vault reference token for the destination bank account used for ACH or wire disbursements, stored in the NPPI Vault. Actual account number is never stored in this table per VREQ-012.']
  bank_name varchar [note: 'Name of the receiving financial institution for wire or ACH disbursements. Non-sensitive identifier used for routing verification and audit trail without exposing account details.']
  cleared_date date [note: 'Date the disbursement was confirmed as cleared by the bank (check presented and paid, or wire confirmed received). Used for three-way reconciliation and positive-pay matching.']
  cost_center_code varchar [note: 'Internal cost center or branch code responsible for this disbursement. Used for branch-level P&L reporting and operational cost allocation.']
  created_timestamp timestamp [note: 'Date and time the disbursement record was first created in the escrow trust accounting system. Audit field for record provenance and lifecycle tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the disbursement amount (e.g., USD). Supports multi-currency escrow accounts in commercial transactions.']
  disbursement_status varchar [note: 'Current lifecycle state of the disbursement: pending (authorized but not yet issued), issued (sent), cleared (confirmed by bank), voided, returned, or stopped. Drives reconciliation and exception workflows.']
  disbursement_type varchar [note: 'Categorical classification of the disbursement purpose (e.g., payoff/reconveyance, seller proceeds, commission, recording fee, title premium, HOA assessment).']
  escrow_trust_account_number varchar [note: 'Identifier of the specific IOLTA or escrow trust bank account from which the disbursement is drawn. Supports multi-account escrow operations and three-way reconciliation.']
  gl_account_code varchar [note: 'General Ledger account code to which this disbursement is posted in the ERP/finance system. Supports premium revenue recognition, agent settlement, and AP/AR reconciliation.']
  is_gap_period_disbursement boolean [note: 'Indicates whether this disbursement was issued during the gap period between closing and recording. True flags disbursements subject to gap coverage risk per title commitment terms.']
  issued_date date [note: 'Actual date the check was printed or the wire/ACH was initiated from the escrow trust account. May differ from scheduled date due to funding delays or corrections.']
  loan_payoff_amount decimal(15,2) [note: 'For payoff disbursements, the per-diem-adjusted loan payoff amount as confirmed by the lender\'s payoff statement. Null for non-payoff disbursements. Supports lien clearance verification.']
  memo varchar [note: 'Free-text memo or description printed on the check or included in the wire/ACH addenda record. Describes the purpose of the disbursement for payee and audit reference.']
  net_disbursement_amount decimal(15,2) [note: 'Final net amount disbursed after applying any adjustments to the gross disbursement amount. Used for final reconciliation against the escrow ledger balance.']
  number varchar [note: 'Externally visible, human-readable check or wire reference number assigned by the escrow trust accounting system (e.g., check number, wire sequence number). Used for positive-pay and bank reconciliation.']
  payee_name varchar [note: 'Full legal name of the individual or entity receiving the disbursement as it appears on the check or wire instruction. Required for positive-pay and 1099 reporting.']
  payee_tax_id_ref varchar [note: 'Vault reference token for the payee\'s Tax Identification Number (TIN/SSN/EIN) stored in the NPPI Vault. Used for IRS 1099-S reporting. Actual TIN is never stored in this table.']
  payee_type varchar [note: 'Classification of the payee role in the transaction (e.g., seller, lender payoff, borrower, real estate agent/broker, HOA, taxing authority). [ENUM-REF-CANDIDATE: seller|lender|borrower|agent|broker|attorney|hoa|taxing_authority|title_company|other —']
  payment_method varchar [note: 'Instrument used to execute the disbursement: check, wire transfer, ACH, internal ledger transfer, or cashier\'s check. Drives positive-pay and bank reconciliation workflows.']
  payoff_good_through_date date [note: 'Expiration date of the lender\'s payoff statement through which the loan_payoff_amount is valid. Disbursement must be received by lender on or before this date to satisfy the lien.']
  positive_pay_exception boolean [note: 'Indicates whether the bank flagged this disbursement as a positive-pay exception (mismatch between issued check details and presented check). True triggers manual review.']
  positive_pay_submitted boolean [note: 'Indicates whether this disbursement has been submitted to the bank\'s positive-pay fraud prevention system. True if submitted; False if not yet submitted or not applicable (e.g., wire).']
  recording_fee_jurisdiction varchar [note: 'County or jurisdiction name to which a recording fee disbursement is directed. Null for non-recording-fee disbursements. Supports recording submission reconciliation.']
  remittance_type varchar [note: 'For premium-related disbursements, classifies the remittance category (e.g., title premium, agent split, underwriter split, CPL fee). Null for non-premium disbursements. Supports agency remittance reporting.']
  return_date date [note: 'Date a returned check or ACH return was received by the escrow trust account. Null if not returned. Triggers re-issuance workflow and ledger reversal.']
  return_reason_code varchar [note: 'NACHA ACH return reason code or bank-issued check return reason (e.g., R01 insufficient funds, R02 account closed). Null for non-returned disbursements.']
  scheduled_disbursement_date date [note: 'Date on which the disbursement is authorized and scheduled to be issued from the escrow trust account, typically the closing date or a specified post-closing date.']
  settlement_statement_line_ref varchar [note: 'Line item reference number or code on the settlement statement (CD/HUD-1/ALTA) that authorizes this disbursement (e.g., line 103, line 504). Enables traceability from disbursement to closing disclosure.']
  source_system_code varchar [note: 'Unique identifier of this disbursement record in the originating escrow trust accounting system (e.g., SoftPro Trust Accounting, RamQuest). Enables lineage tracing and SoR reconciliation.']
  source_system_name varchar [note: 'Name of the operational system of record from which this disbursement record was ingested (e.g., SoftPro, RamQuest, Qualia). Supports multi-system lakehouse lineage.']
  updated_timestamp timestamp [note: 'Date and time the disbursement record was last modified in the source system or lakehouse silver layer. Supports change detection and incremental ETL processing.']
  void_date date [note: 'Date the disbursement was voided, if applicable. Null if not voided. A voided disbursement requires a corresponding reversal entry in the escrow ledger.']
  void_reason varchar [note: 'Reason code explaining why the disbursement was voided (e.g., stale check, incorrect amount, wire rejected). Required when disbursement_status is voided for audit and reconciliation.']
  wire_confirmation_number varchar [note: 'Bank-issued IMAD/OMAD or confirmation reference number for wire transfer disbursements. Null for check or ACH disbursements. Used to confirm wire receipt with receiving bank.']
  wire_instruction_ref varchar [note: 'Vault reference token pointing to the encrypted wire instruction record (bank name, ABA routing, account number) in the NPPI Vault. Actual banking details are never stored in this table per VREQ-012.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Individual disbursement record representing a single outgoing payment from the escrow trust account at or after closing. Captures disbursement type (payoff/reconveyance, seller proceeds, commission, recording fee, title premium, HOA assessment, tax'
}

Table ti_settlement.wire_instruction {
  wire_instruction_id varchar [pk, note: 'Unique surrogate identifier for a wire transfer instruction record within the escrow and settlement system.']
  closing_order_id varchar [note: 'Reference to the title order or closing file to which this wire instruction is associated, linking disbursement instructions to the settlement transaction.']
  disbursement_id varchar [note: 'Reference to the escrow ledger disbursement record that consumed this wire instruction when the wire was actually sent. Links instruction to execution.']
  party_id varchar [note: 'Reference to the party (seller, borrower, lender, payoff lender, HOA, commission recipient) for whom this wire instruction is on file.']
  prior_instruction_wire_instruction_id varchar [note: 'Self-referencing identifier of the previous wire instruction record that this record supersedes. Preserves the revision history and chain of custody for audit purposes.']
  aba_routing_number_token varchar [note: 'Tokenized or encrypted ABA/routing transit number (9-digit) of the receiving bank. Stored as a token referencing the NPPI Vault; never stored in plaintext per GLBA and ALTA Best Practices Pillar 3.']
  account_number_token varchar [note: 'Tokenized or encrypted beneficiary bank account number. Stored as a reference token to the NPPI Vault; never stored in plaintext per GLBA and ALTA Best Practices Pillar 3.']
  account_type varchar [note: 'Type of bank account to which the wire is directed (e.g., checking, savings). Required by some receiving banks for proper routing.']
  approved_by varchar [note: 'Name or identifier of the escrow officer or supervisor who approved the wire instruction for disbursement.']
  approved_timestamp timestamp [note: 'Date and time when the wire instruction was formally approved for disbursement by an authorized escrow officer or supervisor.']
  bank_address_line1 varchar [note: 'Primary street address of the receiving bank branch. Required for domestic wire instructions and correspondent bank identification.']
  bank_city varchar [note: 'City of the receiving bank branch used for wire routing verification and correspondent bank identification.']
  bank_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the receiving bank. Distinguishes domestic (USA) from international wire instructions.']
  bank_name varchar [note: 'Full legal name of the receiving financial institution where the beneficiary account is held. Used for wire routing verification.']
  bank_state varchar [note: 'Two-letter US state code of the receiving bank branch per USPS/FIPS standards.']
  beneficiary_name varchar [note: 'Full legal name of the wire beneficiary as it must appear on the outgoing wire transfer. Required for bank matching and fraud prevention.']
  change_reason varchar [note: 'Business reason documented for changing or replacing a previously verified wire instruction (e.g., bank account change, payoff amount update). Required when is_change_request is true.']
  created_timestamp timestamp [note: 'Date and time when this wire instruction record was first created in the escrow and trust accounting system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the wire amount. Defaults to USD for domestic US title transactions.']
  delivery_channel varchar [note: 'Channel through which the wire instruction was received from the party. Secure portal and encrypted email are preferred per ALTA Best Practices Pillar 2.']
  expected_wire_amount decimal(18,2) [note: 'Expected gross USD amount to be wired per the settlement statement or payoff demand. Used for pre-wire verification and positive-pay controls.']
  expiration_date date [note: 'Date after which the wire instruction is no longer valid and must be re-verified before use. Supports fraud prevention and stale-instruction controls.']
  fraud_alert_flag boolean [note: 'Indicates whether a fraud alert or suspicious activity flag has been raised against this wire instruction (e.g., BEC/business email compromise indicators). Triggers enhanced review.']
  fraud_alert_notes varchar [note: 'Free-text notes describing the nature of the fraud alert or suspicious activity associated with this wire instruction. Populated when fraud_alert_flag is true.']
  further_credit_account_token varchar [note: 'Tokenized further-credit (FFC) sub-account number at the receiving bank. Stored as a token referencing the NPPI Vault.']
  further_credit_name varchar [note: 'Name on the further-credit (FFC) sub-account when the wire must be credited to a sub-account at the receiving bank (common for lender payoffs and HOA accounts).']
  instruction_number varchar [note: 'Externally visible reference number assigned to this wire instruction record by the escrow or trust accounting system (e.g., SoftPro Trust Accounting).']
  instruction_status varchar [note: 'Current lifecycle state of the wire instruction. [ENUM-REF-CANDIDATE: draft|pending_verification|verified|approved|used|cancelled|expired — promote to reference product]']
  intermediary_aba_token varchar [note: 'Tokenized ABA routing number of the intermediary (correspondent) bank. Stored as a token referencing the NPPI Vault.']
  intermediary_bank_name varchar [note: 'Name of the intermediary (correspondent) bank required when the receiving bank cannot accept wires directly. Used for complex domestic or international routing.']
  is_change_request boolean [note: 'Indicates whether this wire instruction record represents a change or update to a previously verified instruction. Change requests require re-verification per ALTA Best Practices Pillar 2 fraud controls.']
  nppi_vault_ref varchar [note: 'Token or reference key pointing to the encrypted NPPI Vault record that holds the plaintext ABA routing number and account number for this wire instruction per GLBA and ALTA Best Practices Pillar 3.']
  party_role varchar [note: 'Role of the party in the closing transaction for whom this wire instruction applies (e.g., seller proceeds, borrower refund, payoff lender). [ENUM-REF-CANDIDATE: seller|borrower|lender|payoff_lender|hoa|commission_recipient|other — promote to reference']
  positive_pay_submitted boolean [note: 'Indicates whether this wire instruction has been submitted to the bank positive-pay or wire-confirmation system prior to disbursement. Supports escrow trust account controls.']
  received_timestamp timestamp [note: 'Date and time when the wire instruction was first received from the party (via secure email, portal, or in-person). Establishes the start of the verification workflow.']
  source_document_ref varchar [note: 'Reference identifier or document management system link to the original wire instruction document (e.g., signed wire authorization form, secure portal submission record) stored in the Document Management and Imaging System.']
  swift_bic_code varchar [note: 'Society for Worldwide Interbank Financial Telecommunication (SWIFT) Bank Identifier Code (BIC) for international wire transfers. Required when bank_country_code is not USA.']
  updated_timestamp timestamp [note: 'Date and time when this wire instruction record was last modified. Supports audit trail and lifecycle tracking.']
  verification_method varchar [note: 'Method used to independently verify the wire instructions prior to disbursement (e.g., callback to known number, secure portal submission). Supports ALTA Best Practices Pillar 2 fraud controls.']
  verification_timestamp timestamp [note: 'Date and time when the wire instruction was independently verified by the escrow officer per ALTA Best Practices Pillar 2 callback or secure-channel protocol.']
  verified_by varchar [note: 'Name or identifier of the escrow officer or staff member who completed the independent verification of the wire instructions.']
  wire_purpose varchar [note: 'Business purpose of the wire disbursement as it relates to the closing (e.g., seller proceeds, mortgage payoff, EMD). [ENUM-REF-CANDIDATE: seller_proceeds|payoff|earnest_money|commission|tax_proration|hoa_dues|other — promote to reference product]']
  wire_reference_memo varchar [note: 'Free-text reference or memo line to be included on the outgoing wire (e.g., loan number, file number, property address). Assists receiving bank in applying the funds.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for wire transfer instructions associated with a closing party (seller, borrower, lender, payoff lender, HOA, commission recipient). Captures beneficiary name, bank name, ABA routing number, account number (encrypted/tokenized per NPPI'
}

Table ti_settlement.premium_charge {
  premium_charge_id varchar [pk, note: 'Unique surrogate identifier for a premium charge record within the title insurance settlement system.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Premium charges require agent identification for premium split calculation, agent remittance reconciliation, and revenue allocation.']
  endorsement_id varchar [note: 'Reference to the ALTA endorsement for which this charge is assessed. Populated only when charge_type is endorsement fee.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Premium rate schedules vary by county FIPS code and tax district; parcel_id provides jurisdiction for accurate rate application, simultaneous issue determination, and county-specific']
  premium_split_schedule_id varchar [note: 'Foreign key linking to agency.premium_split_schedule. Business justification: Premium charges must reference the applicable split schedule to determine agent versus underwriter premium shares.']
  prior_version_charge_premium_charge_id varchar [note: 'Reference to the previous version of this charge record when a revision or adjustment has been made, preserving the full revision history per VREQ-007.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Premium rate schedules vary by property transaction type, jurisdiction, and assessed value; required for accurate rate application, reissue credit calculation, and revenue recognition by']
  settlement_statement_id varchar [note: 'Reference to the settlement statement (CD/HUD-1/ALTA) on which this charge appears, linking the charge to the closing disclosure.']
  title_order_id varchar [note: 'Reference to the title order for which this premium or fee charge is assessed, linking the charge to the originating transaction.']
  title_policy_id varchar [note: 'Reference to the title policy (owner or lender) for which this premium charge is assessed. Null for non-policy charges such as search or exam fees.']
  adjustment_amount decimal(18,2) [note: 'Net adjustment applied to the base premium, including simultaneous issue discounts, reissue credits, or regulatory adjustments. Negative values represent credits.']
  agent_premium_split_amount decimal(18,2) [note: 'Dollar amount of the net charge allocated to the independent title agent per the applicable agency agreement premium split schedule.']
  authorized_by varchar [note: 'Name or identifier of the underwriter or branch authority who approved a waiver, adjustment, or exception to the standard filed rate for this charge.']
  base_premium_amount decimal(18,2) [note: 'Gross base premium amount calculated from the applicable rate schedule before any adjustments, discounts, or simultaneous issue credits.']
  cd_line_item_code varchar [note: 'TRID Closing Disclosure (CD) line item code identifying where this charge appears on the CD form (e.g., Section B, C, or H line reference).']
  charge_date date [note: 'The business event date on which the premium charge was assessed or calculated, typically the closing date or commitment date.']
  charge_number varchar [note: 'Externally visible business identifier for this premium charge record, assigned by the title production system (e.g., SoftPro/RamQuest charge line reference).']
  charge_status varchar [note: 'Current lifecycle status of the premium charge: calculated (computed but not yet assessed), assessed, invoiced, collected, waived, adjusted, or voided. [ENUM-REF-CANDIDATE: calculated|assessed|invoiced|collected|waived|adjusted|voided — 7 candidates']
  charge_type varchar [note: 'Classification of the charge: OTP (Owner\'s Title Policy) premium, LTP (Lender\'s Title Policy) premium, endorsement fee, search fee, exam fee, or settlement fee.']
  collected_date date [note: 'Date on which the premium charge was collected from the responsible party at or after closing. Null if not yet collected.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) county code for the property location, used for rate jurisdiction and regulatory reporting.']
  created_timestamp timestamp [note: 'Timestamp when this premium charge record was first created in the system, used for audit trail and lifecycle tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this charge record. Typically USD for domestic US title transactions.']
  endorsement_type_code varchar [note: 'ALTA endorsement form number or code (e.g., ALTA 9, ALTA 8.1, ALTA 22) when charge_type is endorsement_fee. Null for non-endorsement charges.']
  gl_account_code varchar [note: 'General Ledger (GL) account code to which this premium charge is posted for revenue recognition and financial reporting purposes.']
  hud1_line_number varchar [note: 'HUD-1 Settlement Statement line number where this charge appears, applicable for transactions governed by legacy RESPA HUD-1 disclosure requirements.']
  liability_amount decimal(18,2) [note: 'The insured amount or coverage liability used as the basis for premium calculation (e.g., purchase price for OTP, loan amount for LTP).']
  net_charge_amount decimal(18,2) [note: 'Final assessed charge amount after all adjustments (base_premium_amount + adjustment_amount). This is the amount appearing on the settlement statement.']
  notes varchar [note: 'Free-text notes or comments entered by the settlement officer regarding special circumstances, rate justifications, or instructions for this charge.']
  paid_by_party varchar [note: 'Identifies which transaction party is responsible for paying this charge: buyer, seller, lender, or split between parties.']
  policy_type varchar [note: 'Indicates whether the charge relates to an Owner\'s Title Policy (OTP), Lender\'s Title Policy (LTP), both (simultaneous issue), or is not applicable for non-policy charges.']
  prior_policy_amount decimal(18,2) [note: 'Liability amount of the prior existing title policy used as the basis for calculating a reissue credit. Populated only when reissue_credit_flag is true.']
  prior_policy_date date [note: 'Effective date of the prior title policy used for reissue credit eligibility determination. Must fall within the state-mandated lookback period.']
  production_channel varchar [note: 'Channel through which the title order was produced: direct branch, centralized lender, or independent agent. Drives premium split and remittance calculations.']
  rate_per_thousand decimal(10,6) [note: 'The filed premium rate expressed as a dollar amount per $1,000 of liability amount, sourced from the applicable state-filed rate schedule.']
  rate_schedule_code varchar [note: 'Code identifying the filed rate schedule or rate table used to calculate the base premium, as maintained in the underwriting rate management system.']
  reissue_credit_flag boolean [note: 'Indicates whether a reissue credit was applied to this charge based on a prior existing title policy covering the same property.']
  remittance_due_date date [note: 'Date by which the agent\'s underwriter premium split must be remitted to the underwriter per the agency agreement remittance schedule.']
  remittance_status varchar [note: 'Current status of the underwriter premium remittance for this charge: pending, remitted, overdue, or waived.']
  revenue_recognition_date date [note: 'Date on which the premium charge is recognized as earned revenue in the general ledger, per applicable accounting standards.']
  simultaneous_issue_flag boolean [note: 'Indicates whether this charge benefits from a simultaneous issue discount, applicable when both an OTP and LTP are issued for the same transaction at the same time.']
  source_system_charge_ref varchar [note: 'Native charge or fee line identifier from the originating title production system (SoftPro Select, RamQuest Horizon, or Qualia) for traceability.']
  split_percentage decimal(5,2) [note: 'Agent\'s percentage share of the net premium charge as defined in the premium split schedule. Expressed as a percentage (e.g., 70.00 for 70%).']
  state_code varchar [note: 'Two-letter US state code where the insured property is located, determining the applicable filed rate schedule and regulatory requirements.']
  transaction_type varchar [note: 'Type of real estate transaction for which the charge is assessed: purchase, refinance (REFI), home equity line of credit (HELOC), construction, or commercial.']
  underwriter_premium_split_amount decimal(18,2) [note: 'Dollar amount of the net charge retained by or remitted to the underwriter per the applicable agency agreement premium split schedule.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this premium charge record, supporting audit trail and change detection.']
  version_number varchar [note: 'Incremental version counter for this charge record, supporting lifecycle revision tracking per VREQ-007 when charges are recalculated or adjusted.']
  waiver_reason varchar [note: 'Business justification for waiving or reducing this charge. Populated only when charge_status is waived or adjustment_amount is negative.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Transactional record capturing the title insurance premium and related fee charges calculated and assessed at closing for a specific transaction. Tracks charge type (OTP owner title premium, LTP lender title premium, endorsement fee, search fee, exam fee'
}

Table ti_settlement.closing_document {
  closing_document_id varchar [pk, note: 'Unique surrogate identifier for each closing document record in the settlement domain. Primary key for the closing_document entity.']
  closing_order_id varchar [note: 'Reference to the closing event or closing session during which this document was executed or collected. Supports grouping all documents from a single closing table.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Recorded instruments must incorporate the approved Schedule A legal description; critical for deed preparation, mortgage legal sufficiency, title policy accuracy, and ensuring']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Recording documents require exact parcel identification (APN/PIN) for county recorder indexing, grantor-grantee index accuracy, and automated recording system validation; critical for']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Closing documents convey or encumber specific properties; fundamental for recording package assembly, legal description consistency checks, deed preparation, and mortgage legal sufficiency']
  recording_submission_id varchar [note: 'Unique identifier assigned by the eRecording gateway (e.g., Simplifile, CSC eRecording) for the electronic submission of this document. Supports rejection and resubmission tracking.']
  settlement_statement_id varchar [note: 'Reference to the settlement statement (CD/HUD-1/ALTA) associated with this closing document, where applicable. Maintains the distinct settlement_statement entity per VREQ-003.']
  superseded_by_closing_document_id varchar [note: 'Reference to the closing_document record that supersedes this version, if applicable. Preserves prior document versions in the lifecycle history per VREQ-007.']
  title_order_id varchar [note: 'Reference to the title order under which this closing document was collected or executed. Links the document to the originating order lifecycle.']
  title_policy_id varchar [note: 'Foreign key linking to underwriting.title_policy. Business justification: Recorded deeds and mortgages must link to the policy that insured them for claims investigation, coverage determination, and chain-of-title validation.']
  acceptance_date date [note: 'Date the county recorder or filing authority formally accepted the document for recording. Distinct per VREQ-008 from submission and recording dates.']
  consideration_amount decimal(18,2) [note: 'Dollar amount of consideration stated in the deed or transfer instrument. Used for transfer tax calculation, 1099-S reporting, and transaction value analytics.']
  created_timestamp timestamp [note: 'Timestamp when this closing document record was first created in the title production system. Supports audit trail and closing-readiness cycle time metrics per VREQ-016.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this document (e.g., USD). Supports multi-currency reporting for commercial transactions.']
  document_number varchar [note: 'Externally visible business identifier assigned to this closing document by the title production system (e.g., SoftPro Select / Qualia). Used for tracking and reference in correspondence.']
  document_page_count varchar [note: 'Total number of pages in the closing document. Used for recording fee calculation (many jurisdictions charge per page) and document completeness verification.']
  document_source varchar [note: 'Originating party or system that provided or prepared this closing document (e.g., lender loan package, title company, borrower-provided identity document).']
  document_status varchar [note: 'Current lifecycle state of the closing document within the settlement workflow. Drives closing-readiness assessment and document completeness tracking.']
  document_subtype varchar [note: 'Secondary classification providing finer granularity within a document type (e.g., within affidavit: title affidavit, gap affidavit, name affidavit, marital status affidavit). Supports detailed reporting.']
  document_title varchar [note: 'Human-readable name or title of the document as it appears on the face of the instrument (e.g., \'Warranty Deed\', \'Closing Disclosure\', \'Affidavit of Title\').']
  document_type varchar [note: 'Classification of the closing document by legal or operational category. Drives routing, execution requirements, and retention rules. [ENUM-REF-CANDIDATE']
  document_version varchar [note: 'Version number of this document, incremented when a document is revised or superseded during the closing lifecycle. Supports lifecycle revision tracking per VREQ-007.']
  effective_date date [note: 'Date on which the document becomes legally operative or binding, which may differ from execution date. Distinct per VREQ-008 (e.g., deed effective date vs. signing date).']
  erecording_status varchar [note: 'Current status of the document within the eRecording gateway workflow. Drives recording rejection and resubmission rate metrics per VREQ-016.']
  execution_date date [note: 'Date the document was signed or executed by the required parties at closing. Distinct from effective, submission, acceptance, and recording dates per VREQ-008.']
  execution_method varchar [note: 'Method by which the document was executed: wet signature, Remote Online Notarization (RON), In-Person Electronic Notarization (IPEN), or full eClose. Supports RON/IPEN compliance tracking.']
  fips_code varchar [note: 'Five-digit FIPS code identifying the county of recording jurisdiction. Used for geographic routing, regulatory reporting, and county-level analytics.']
  grantee_name varchar [note: 'Name of the grantee (buyer/transferee) as it appears on the face of the instrument. Required for vesting, chain-of-title (COT) integrity, and policy issuance.']
  grantor_name varchar [note: 'Name of the grantor (seller/transferor) as it appears on the face of the instrument. Required for chain-of-title (COT) integrity and recording index matching.']
  imaging_document_ref varchar [note: 'Identifier or URI referencing the scanned or electronic image of this document in the Document Management and Imaging System. Supports evidence and provenance capture per VREQ-007.']
  irs_1099s_filed boolean [note: 'Indicates whether the 1099-S form has been filed with the IRS for this closing document. Supports tax compliance audit and regulatory reporting.']
  loan_amount decimal(18,2) [note: 'Principal loan amount associated with loan documents executed at closing. Used for lender policy coverage verification and TRID/RESPA compliance.']
  notarization_date date [note: 'Date the document was notarized. Relevant for deeds, affidavits, and other instruments requiring notarial acknowledgment. Supports gap period and recording readiness analysis.']
  notarization_required boolean [note: 'Indicates whether this document requires notarization as a condition of validity or recordability. Drives closing coordination and notary scheduling.']
  notary_commission_expiry_date date [note: 'Expiration date of the notary\'s state commission. Used to validate that the notary was active at the time of notarization, preventing recording rejections.']
  notary_commission_number varchar [note: 'State-issued commission number of the notary public. Required for recording compliance verification and notary credential audit.']
  notary_name varchar [note: 'Full name of the notary public who acknowledged or witnessed execution of this document. Required for recording compliance and audit trail.']
  poa_document_ref varchar [note: 'Reference number or identifier for the power of attorney document used in execution, if applicable. Links to the POA instrument in the document management system.']
  power_of_attorney_used boolean [note: 'Indicates whether a power of attorney was used in the execution of this document. Triggers additional underwriting review and POA document collection requirements.']
  recording_date date [note: 'Date the document was officially recorded in the public record by the county recorder. Distinct per VREQ-008 from execution, effective, submission, and acceptance dates.']
  recording_fee_amount decimal(10,2) [note: 'Fee charged by the county recorder for recording this document. Included in the settlement statement and escrow disbursement. Supports escrow reconciliation.']
  recording_jurisdiction varchar [note: 'Name of the county or jurisdiction where the document is to be or was recorded (e.g., \'Cook County, IL\'). Drives eRecording gateway routing and FIPS code assignment.']
  recording_rejection_reason varchar [note: 'Reason code or description provided by the county recorder when a document submission is rejected. Supports root-cause analysis of recording rejection rates per VREQ-016.']
  requires_1099s boolean [note: 'Indicates whether this document triggers a 1099-S real estate proceeds reporting obligation to the IRS. Drives tax reporting workflow and compliance tracking.']
  requires_recording boolean [note: 'Indicates whether this document must be submitted to the county recorder as part of the closing process (e.g., deeds, deeds of trust). Drives recording workflow initiation.']
  resubmission_count varchar [note: 'Number of times this document has been resubmitted to the county recorder after an initial rejection. Supports recording rejection and resubmission rate metrics per VREQ-016.']
  submission_date date [note: 'Date the document was submitted to the county recorder or relevant authority for recording or filing. Distinct per VREQ-008 from execution, effective, acceptance, and recording dates.']
  transfer_tax_amount decimal(18,2) [note: 'State or county transfer tax assessed on the conveyance as reflected in the transfer tax declaration. Supports settlement statement reconciliation and regulatory reporting.']
  updated_timestamp timestamp [note: 'Timestamp when this closing document record was last modified in the title production system. Supports change tracking and lifecycle history per VREQ-007.']
  vesting_type varchar [note: 'Form of title vesting for the grantee as stated in the deed or closing document (e.g., joint tenancy, tenancy in common, community property). Drives ownership interest modeling per VREQ-005.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for each document executed or collected during the closing event (loan documents, deeds, affidavits, title affidavits, ALTA statements, 1099-S forms, transfer tax declarations, power of attorney, identity documents).'
}

Table ti_settlement.escrow_reconciliation {
  escrow_reconciliation_id varchar [pk, note: 'Unique surrogate identifier for the escrow trust account three-way reconciliation record. Primary key for this entity.']
  approved_by_supervisor_party_id varchar [note: 'Reference to the supervising manager or compliance officer who reviewed and approved this reconciliation record per ALTA dual-control requirements.']
  escrow_ledger_id varchar [note: 'Reference to the escrow trust account (IOLTA or dedicated trust account) being reconciled in this record.']
  party_id varchar [note: 'Reference to the escrow officer or trust accounting staff member who performed and submitted this reconciliation for supervisory review.']
  account_type varchar [note: 'Classification of the escrow trust account being reconciled. IOLTA accounts hold client funds earning interest for legal aid; dedicated trust accounts are file-specific.']
  adjusted_bank_balance decimal(18,2) [note: 'Bank statement balance plus outstanding deposits minus outstanding checks. Represents the reconciled bank-side balance for comparison to the escrow ledger balance.']
  approval_date date [note: 'Date on which the supervising manager or compliance officer formally approved this reconciliation record as complete and accurate.']
  approval_notes varchar [note: 'Free-text notes entered by the approving supervisor at the time of reconciliation approval, documenting any conditions, exceptions, or follow-up actions required.']
  bank_account_number_masked varchar [note: 'Masked bank account number showing only the last four digits, used for display and audit purposes. Full account number stored in the Identity and NPPI Vault per GLBA.']
  bank_name varchar [note: 'Name of the financial institution holding the escrow trust account being reconciled (e.g., Wells Fargo, JPMorgan Chase).']
  bank_routing_number varchar [note: 'ABA routing transit number of the financial institution holding the escrow trust account. Used to identify the bank for reconciliation and wire verification purposes.']
  bank_statement_balance decimal(18,2) [note: 'Ending balance per the bank statement for the reconciliation period. First leg of the three-way reconciliation. Denominated in USD.']
  bank_statement_date date [note: 'The statement date of the bank statement used as the primary source for the bank-side leg of the three-way reconciliation.']
  bank_to_ledger_variance decimal(18,2) [note: 'Difference between the adjusted bank balance and the escrow ledger balance. A non-zero value indicates a discrepancy requiring investigation and resolution.']
  branch_code varchar [note: 'Reference to the direct branch or closing office responsible for the escrow trust account being reconciled.']
  created_timestamp timestamp [note: 'Timestamp when this escrow reconciliation record was first created in the system. Supports audit trail and lifecycle tracking.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this reconciliation record. Typically USD for domestic US title transactions.']
  days_to_reconcile varchar [note: 'Number of calendar days elapsed between the reconciliation period end date and the date the reconciliation was completed. Supports cycle-time analytics per VREQ-016.']
  escrow_ledger_balance decimal(18,2) [note: 'Total balance per the escrow trust accounting ledger as of the reconciliation period end date. Second leg of the three-way reconciliation.']
  is_balanced boolean [note: 'Indicates whether all three legs of the reconciliation (bank, ledger, open files) agree within the defined tolerance threshold. True when fully balanced.']
  is_regulatory_reportable boolean [note: 'Indicates whether this reconciliation record or its variance must be reported to a state Department of Insurance or other regulatory body per applicable state requirements.']
  ledger_to_file_variance decimal(18,2) [note: 'Difference between the escrow ledger balance and the aggregate of open file balances. A non-zero value indicates unallocated funds or file balance errors.']
  open_file_balance_aggregate decimal(18,2) [note: 'Sum of all individual open escrow file (order) balances as of the reconciliation period end date. Third leg of the three-way reconciliation per ALTA Best Practices.']
  open_file_count varchar [note: 'Number of individual escrow files (title orders) with open balances included in the open file balance aggregate for this reconciliation period.']
  outstanding_check_count varchar [note: 'Number of individual checks or disbursement items issued but not yet cleared the bank as of the reconciliation date.']
  outstanding_checks_amount decimal(18,2) [note: 'Total of checks or wire disbursements issued but not yet cleared the bank as of the reconciliation date. Adjusts bank balance downward.']
  outstanding_deposits_amount decimal(18,2) [note: 'Total of deposits recorded in the escrow ledger but not yet reflected on the bank statement as of the reconciliation date. Adjusts bank balance upward.']
  positive_pay_submission_date date [note: 'Date on which the positive pay file was submitted to the bank for the reconciliation period. Null if positive pay was not submitted.']
  positive_pay_submitted boolean [note: 'Indicates whether a positive pay file was submitted to the bank for this reconciliation period to prevent check fraud on the escrow trust account.']
  prior_period_variance_amount decimal(18,2) [note: 'Unresolved variance amount carried forward from the immediately preceding reconciliation period. Non-zero values indicate aging discrepancies requiring escalation.']
  reconciliation_date date [note: 'The business date on which the three-way reconciliation was performed by the escrow officer or trust accounting staff.']
  reconciliation_number varchar [note: 'Externally-known business identifier for this reconciliation run, typically formatted as RECON-YYYY-MM-NNNNNN. Used for audit trail and operational reference.']
  reconciliation_period_end_date date [note: 'Last calendar date of the reconciliation period covered by this record, typically the last day of the statement month.']
  reconciliation_period_start_date date [note: 'First calendar date of the reconciliation period covered by this record, typically the first day of the statement month.']
  reconciliation_status varchar [note: 'Current lifecycle state of the reconciliation record. Balanced indicates all three legs agree within tolerance; out_of_balance triggers investigation workflow.']
  reconciliation_type varchar [note: 'Classification of the reconciliation procedure performed. Three-way compares bank statement, escrow ledger, and open file balances simultaneously per ALTA Best Practices.']
  regulatory_report_date date [note: 'Date on which this reconciliation or its associated variance was reported to the applicable state regulatory authority. Null if not yet reported or not required.']
  source_system_code varchar [note: 'Code identifying the escrow and trust accounting system of record from which this reconciliation data was extracted (e.g., SoftPro Trust Accounting, RamQuest).']
  source_system_recon_ref varchar [note: 'Native reconciliation record identifier from the originating escrow trust accounting system (SoftPro, RamQuest, etc.) for lineage and cross-system traceability.']
  stale_check_amount decimal(18,2) [note: 'Total dollar value of outstanding checks that have exceeded the stale-date threshold and are subject to escheatment or reissuance review.']
  stale_check_count varchar [note: 'Number of outstanding checks that have exceeded the stale-date threshold (typically 90–180 days) and require escheatment review or reissuance action.']
  tolerance_amount decimal(18,2) [note: 'Maximum allowable variance in USD between reconciliation legs before the record is flagged as out-of-balance. Typically set to $0.00 for trust accounts per ALTA.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this escrow reconciliation record. Supports change detection and audit trail requirements.']
  variance_explanation varchar [note: 'Free-text explanation provided by the escrow officer or supervisor describing the cause of any out-of-balance condition and the planned resolution steps.']
  variance_resolution_status varchar [note: 'Current status of the investigation and resolution effort for any out-of-balance variance identified in this reconciliation record.']
  variance_resolved_date date [note: 'Date on which the out-of-balance variance was fully resolved and the reconciliation was confirmed as balanced. Null if variance remains open.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Periodic three-way reconciliation record for the escrow trust account, comparing the escrow ledger balance against the bank statement balance and the aggregate of open file balances.'
}

Table ti_settlement.escrow_receipt {
  escrow_receipt_id varchar [pk, note: 'Unique surrogate identifier for each escrow trust account receipt record. Primary key for the escrow_receipt entity.']
  escrow_ledger_id varchar [note: 'Reference to the escrow/IOLTA trust ledger into which this receipt is posted. Links the receipt to the closing-level ledger balance.']
  escrow_officer_party_id varchar [note: 'Reference to the escrow officer (EOT) responsible for receiving and posting this receipt. Supports accountability, audit, and closing-readiness tracking.']
  party_id varchar [note: 'Reference to the party (buyer, seller, lender, agent, HOA) who remitted the funds. Supports multi-role party model.']
  prior_receipt_escrow_receipt_id varchar [note: 'Self-referencing link to the original receipt record when this record represents a correction, repost, or replacement. Preserves lifecycle history per VREQ-007.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Receipts (earnest money deposits, buyer funds, loan proceeds) are collected for specific property transactions; needed for escrow accounting reconciliation, funds-to-property traceability']
  remitter_party_role_id varchar [note: 'Foreign key linking to operations.party_role. Business justification: Receipts from parties in specific roles (buyer earnest money, borrower down payment, lender loan proceeds) require role context for proper settlement statement allocation, TRID']
  settlement_statement_id varchar [note: 'Reference to the settlement statement (CD/HUD-1/ALTA) to which this receipt is applied, supporting TRID/RESPA reconciliation.']
  title_order_id varchar [note: 'Reference to the title order associated with this escrow receipt, enabling traceability from receipt to the originating transaction.']
  wire_instruction_id varchar [note: 'Reference to the verified wire instruction record that authorized this incoming wire receipt. Supports fraud prevention and wire verification audit trail.']
  ach_trace_number varchar [note: 'NACHA-assigned trace number for ACH credit entries received into the trust account. Populated only when funds_type is \'ach\'; supports return and NOC processing.']
  adjustment_amount decimal(18,2) [note: 'Adjustment applied to the gross receipt amount (e.g., bank return fee, wire shortfall correction). Negative value indicates a deduction; zero if no adjustment.']
  branch_code varchar [note: 'Reference to the direct branch or centralized lender channel office where this receipt was processed. Supports channel-level reconciliation and reporting.']
  check_number varchar [note: 'Check number from the remitter\'s instrument when funds_type is check, cashiers_check, or certified_check. Used for positive-pay matching and bank reconciliation.']
  created_timestamp timestamp [note: 'Audit timestamp when this escrow receipt record was first created in the system of record (SoftPro Trust Accounting / RamQuest).']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the receipt amount (e.g., USD). Required for multi-currency trust account compliance.']
  emd_contract_date date [note: 'Date of the purchase contract requiring the EMD. Populated only when emd_flag is true; used to verify timely EMD receipt per contract terms.']
  emd_flag boolean [note: 'Indicates whether this receipt represents an Earnest Money Deposit (EMD). True when receipt_type is \'emd\'; drives EMD tracking and forfeiture/return workflows.']
  expected_receipt_amount decimal(18,2) [note: 'Amount expected to be received per the settlement statement or wire instruction. Compared against receipt_amount to detect shortfalls or overages at closing.']
  fraud_alert_flag boolean [note: 'Indicates whether a fraud alert has been raised on this receipt (e.g., suspicious wire origin, mismatched remitter, business email compromise indicator).']
  fraud_alert_notes varchar [note: 'Free-text description of the fraud alert reason or investigation notes when fraud_alert_flag is true. Supports escrow officer review and SAR filing if required.']
  funds_type varchar [note: 'Method by which the funds were remitted: wire transfer, personal check, ACH, cashier\'s check, certified check, cash, or electronic transfer. Governs availability and positive-pay rules.']
  gl_account_code varchar [note: 'General ledger account code to which this receipt is mapped in the ERP/GL system for premium revenue recognition and trust account accounting.']
  iolta_account_flag boolean [note: 'Indicates whether the receiving trust account is an Interest on Lawyers Trust Account (IOLTA). True when IOLTA rules apply to interest disposition.']
  memo varchar [note: 'Free-text memo or description entered by the escrow officer at the time of receipt posting, capturing remitter instructions or special handling notes.']
  net_receipt_amount decimal(18,2) [note: 'Net funds credited to the escrow ledger after adjustments (receipt_amount + adjustment_amount). Used in three-way reconciliation and ledger balance calculations.']
  positive_pay_submitted_flag boolean [note: 'Indicates whether this receipt was submitted to the bank\'s positive-pay system for check verification. Applicable when funds_type is check or cashiers_check.']
  posted_timestamp timestamp [note: 'Date and time the receipt was posted to the escrow ledger in the trust accounting system, which may differ from received_timestamp due to processing lag.']
  receipt_amount decimal(18,2) [note: 'Gross amount of funds received into the escrow trust account for this receipt record. Base monetary fact before any adjustments or reversals.']
  receipt_date date [note: 'Calendar date on which the funds were physically or electronically received into the escrow/IOLTA trust account. Principal business event date for this receipt.']
  receipt_number varchar [note: 'Externally visible, human-readable receipt number assigned by the escrow/trust accounting system (e.g., SoftPro Trust Accounting) for audit and reconciliation.']
  receipt_status varchar [note: 'Current lifecycle status of the receipt within the trust accounting workflow. Drives reconciliation and positive-pay processing.']
  receipt_type varchar [note: 'Classification of the incoming funds: EMD (Earnest Money Deposit), loan proceeds wire-in, buyer cash-to-close, seller contribution, HOA/payoff overfund return, or other.']
  received_timestamp timestamp [note: 'Precise date and time the funds were confirmed received into the trust account, including timezone offset. Used for same-day wire cutoff and positive-pay validation.']
  remitter_account_token varchar [note: 'Tokenized reference to the remitter\'s bank account number stored in the NPPI/Identity Vault. Never stores raw account number; token resolves to vault record per GLBA.']
  remitter_bank_name varchar [note: 'Name of the financial institution from which the funds originated. Used for fraud screening and wire verification per ALTA Best Practices Pillar 3.']
  remitter_name varchar [note: 'Full legal name of the individual or entity remitting the funds. NPPI/PII — stored with restricted classification per GLBA and CFPB requirements.']
  remitter_party_role varchar [note: 'Role of the party remitting the funds at the time of this receipt (buyer, seller, lender, independent agent, HOA, third party). Contextual role per VREQ-006.']
  reversal_date date [note: 'Date on which the receipt reversal was processed. Populated only when reversal_flag is true; used to calculate net trust account balance impact.']
  reversal_flag boolean [note: 'Indicates whether this receipt has been reversed (e.g., returned check, wire recall, ACH return). True triggers a corresponding reversal entry in the escrow ledger.']
  reversal_reason varchar [note: 'Reason code for the reversal when reversal_flag is true: NSF, stop payment, wire recall, ACH return, duplicate posting, data entry error, or other. [ENUM-REF-CANDIDATE: nsf|stop_payment|wire_recall|ach_return|duplicate|error|other — 7 candidates stripped']
  source_system_receipt_ref varchar [note: 'Native receipt identifier from the originating escrow/trust accounting system (SoftPro Trust Accounting, RamQuest) for lineage and reconciliation back to the system of record.']
  trust_account_bank_name varchar [note: 'Name of the financial institution holding the escrow/IOLTA trust account. Required for three-way reconciliation and state insurance department reporting.']
  trust_account_number varchar [note: 'Escrow/IOLTA trust bank account number into which the receipt was deposited. Restricted per GLBA and ALTA Best Practices Pillar 2 trust account segregation requirements.']
  updated_timestamp timestamp [note: 'Audit timestamp of the most recent modification to this escrow receipt record, supporting change tracking and three-way reconciliation audit trails.']
  variance_amount decimal(18,2) [note: 'Difference between receipt_amount and expected_receipt_amount (receipt_amount minus expected_receipt_amount). Non-zero values trigger escrow officer review and reconciliation action.']
  wire_reference_number varchar [note: 'Fedwire or CHIPS reference number assigned to the incoming wire transfer. Populated only when funds_type is \'wire\'; used for bank reconciliation and fraud verification.']
  wire_verification_method varchar [note: 'Method used to verify the incoming wire against the authorized instruction: callback, secure portal, verbal, written confirmation, or not applicable for non-wire receipts.']
  wire_verified_flag boolean [note: 'Indicates whether the incoming wire was verified against the authorized wire instruction prior to posting. Required by ALTA Best Practices Pillar 3 fraud controls.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Individual incoming funds-received record representing a single deposit into the escrow/IOLTA trust account for a specific closing (EMD/earnest money receipt, loan proceeds wire-in, buyer cash-to-close, seller contribution, HOA/payoff overfund return).'
}

Table ti_recording.recording_submission {
  recording_submission_id varchar [pk, note: 'Unique surrogate identifier for each recording submission record. Primary key for the recording_submission entity in the title insurance recording domain.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Recording submissions prepared by independent agents must track the agent for oversight metrics (rejection rates, turnaround time), remittance reconciliation, and quality control.']
  jurisdiction_id varchar [note: 'Foreign key linking to recording.jurisdiction. Business justification: Recording submissions are sent to a specific county recorder/register of deeds office.']
  prior_submission_recording_submission_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding submission record for this package, enabling full resubmission chain traceability per VREQ-007.']
  settlement_statement_id varchar [note: 'Reference to the settlement statement (CD/HUD-1/ALTA) associated with the closing that produced the documents in this submission.']
  submitted_by_party_id varchar [note: 'Reference to the party (closing agent, escrow officer, title agent, or attorney) who submitted the recording package to the county recorder or eRecording gateway.']
  title_commitment_id varchar [note: 'Reference to the title commitment under which the documents in this submission were required. Supports commitment-to-recording traceability.']
  title_order_id varchar [note: 'Reference to the parent title order that originated this recording submission. Links the recording event back to the full title production lifecycle.']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record created when a recording issue required underwriter review. Null if no referral was required.']
  acceptance_date date [note: 'Date the county recorder or eRecording gateway formally accepted the submission package for recording review. Distinct from submission_date and recording_date per VREQ-008.']
  book_number varchar [note: 'Official book number assigned by the county recorder for the recorded instrument (used in book/page recording reference systems). Null for jurisdictions using instrument numbers.']
  channel_type varchar [note: 'Production channel through which the title order was originated: direct branch, centralized lender, or independent agent. Supports channel-level recording performance metrics.']
  consideration_amount decimal(15,2) [note: 'Purchase price or loan amount stated on the primary instrument, used for transfer tax calculation and underwriting risk assessment. Confidential financial data.']
  created_timestamp timestamp [note: 'Date and time this recording_submission record was first created in the system of record. Audit field supporting data lineage and provenance per VREQ-007.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this submission record. Defaults to USD for domestic US title transactions.']
  document_count varchar [note: 'Total number of individual instruments included in this recording submission package. Supports fee calculation and completeness validation.']
  effective_date date [note: 'Date the primary instrument in this submission takes legal effect, which may differ from execution or recording date. Distinct per VREQ-008.']
  erecording_gateway varchar [note: 'eRecording gateway vendor used to transmit documents electronically to the county recorder (e.g., Simplifile, CSC eRecording). Null or \'none\' for physical submissions.']
  erecording_transaction_id varchar [note: 'Unique transaction identifier assigned by the eRecording gateway (Simplifile, CSC) for this submission. Used for gateway-level status tracking and reconciliation.']
  execution_date date [note: 'Date the primary instrument in this submission was signed/executed by the parties. Distinct from effective_date, submission_date, acceptance_date, and recording_date per VREQ-008.']
  gap_close_date date [note: 'Date the gap coverage period closed, set to the confirmed recording_date. Null until recording is confirmed. Drives gap-period duration calculation.']
  gap_coverage_flag boolean [note: 'Indicates whether gap (GAP) coverage is in effect for this submission, protecting the insured during the period between closing and confirmed recording.']
  gap_open_date date [note: 'Date the gap coverage period opened, typically the closing/disbursement date. Marks the start of the unrecorded instrument risk window.']
  instrument_number varchar [note: 'Sequential instrument number assigned by the county recorder upon recording. Primary recording reference in jurisdictions that do not use book/page systems.']
  last_rejection_date date [note: 'Date of the most recent rejection of this submission by the county recorder or eRecording gateway. Used for resubmission SLA tracking.']
  last_rejection_reason_code varchar [note: 'Standardized code for the most recent rejection reason returned by the county recorder or eRecording gateway (e.g., MISSING_NOTARY, INCORRECT_FEE, ILLEGIBLE_DOCUMENT).']
  last_rejection_reason_description varchar [note: 'Free-text description of the most recent rejection reason as returned by the county recorder or eRecording gateway. Supports curative action and resubmission workflow.']
  notes varchar [note: 'Free-text operational notes entered by the closing agent or recording coordinator regarding special instructions, curative actions, or county-specific requirements for this submission.']
  page_number varchar [note: 'Official page number assigned by the county recorder for the recorded instrument (used in book/page recording reference systems). Null for jurisdictions using instrument numbers.']
  policy_issuance_lag_days varchar [note: 'Number of calendar days between the confirmed recording_date and the title policy issue date. Key metric for policy-issuance-lag-after-recording per VREQ-016.']
  primary_document_type varchar [note: 'Type of the lead instrument in the submission (e.g., Warranty Deed, Deed of Trust, Mortgage, Quit Claim Deed, Reconveyance, Satisfaction). [ENUM-REF-CANDIDATE']
  recording_date date [note: 'Official date on which the county recorder stamped and recorded the submitted instruments. Closes the GAP coverage period and triggers policy-issuance-lag measurement. Distinct per VREQ-008.']
  recording_reference_number varchar [note: 'Official reference number assigned by the county recorder upon successful recording (instrument number, document number, or reception number). Null until recorded.']
  recording_timestamp timestamp [note: 'Precise date and time the county recorder confirmed recording of all instruments in this submission. Used for gap-period close and policy issuance lag calculations.']
  rejection_count varchar [note: 'Cumulative number of times this submission has been rejected by the county recorder or eRecording gateway. Key numerator for recording rejection rate metric per VREQ-016.']
  resubmission_date date [note: 'Date on which a corrected package was resubmitted to the county recorder following a rejection. Null on first submission. Supports resubmission rate and cycle-time metrics.']
  submission_date date [note: 'Calendar date on which the recording submission package was transmitted to the county recorder or eRecording gateway. Distinct from execution_date, effective_date, acceptance_date, and recording_date per VREQ-008.']
  submission_method varchar [note: 'Method by which documents were submitted to the county recorder: eRecording via gateway (Simplifile, CSC), physical counter delivery, mail, or courier.']
  submission_number varchar [note: 'Externally-known business identifier assigned to this recording submission, used for tracking with the eRecording gateway and county recorder. Unique per submission attempt.']
  submission_status varchar [note: 'Current lifecycle state of the recording submission. Drives recording rejection/resubmission rate and policy-issuance-lag metrics. [ENUM-REF-CANDIDATE: draft|submitted|pending_review|accepted|rejected|resubmitted|recorded|cancelled — promote to reference']
  submission_timestamp timestamp [note: 'Precise date and time the recording submission was transmitted to the eRecording gateway or county recorder. Supports SLA measurement and gap-period calculation.']
  submitter_role varchar [note: 'Role of the party who submitted the recording package (e.g., closing agent, escrow officer, title agent, attorney). Supports agency oversight and audit.']
  total_recording_fee_amount decimal(12,2) [note: 'Aggregate recording fees charged by the county recorder for all instruments in this submission, in USD. Feeds settlement statement disbursement and escrow reconciliation.']
  total_transfer_tax_amount decimal(12,2) [note: 'Aggregate transfer tax (documentary stamp tax, deed tax) collected and remitted for all instruments in this submission, in USD.']
  transaction_type varchar [note: 'Real estate transaction type that generated this recording submission (e.g., purchase, refinance, HELOC, construction). Supports channel and product-mix analytics.']
  updated_timestamp timestamp [note: 'Date and time this recording_submission record was last modified in the system of record. Supports change tracking and lifecycle history per VREQ-007.']
  uw_referral_required boolean [note: 'Indicates whether a recording-related issue (e.g., extended gap, rejection) triggered an underwriting referral. Supports UW referral rate metric per VREQ-016.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Authoritative SSOT for each document recording submission sent to a county recorder or register of deeds via an eRecording gateway (Simplifile, CSC eRecording) or physical delivery.'
}

Table ti_recording.recorded_instrument {
  recorded_instrument_id varchar [pk, note: 'Unique surrogate primary key for each recorded instrument accepted and stamped by the county recorder or register of deeds. SSOT identifier for downstream policy, title lifecycle, and provenance linkage.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Recorded instruments originated by agents require agent tracking for premium split calculation, remittance line attribution, claim provenance, and oversight reporting.']
  gateway_transaction_id varchar [note: 'Unique transaction identifier assigned by the eRecording gateway (e.g., Simplifile transaction ID) for this instrument. Used for gateway reconciliation and rejection/resubmission tracking.']
  operations_title_examination_id varchar [note: 'Foreign key linking to operations.title_examination. Business justification: Recorded instruments result from title examinations that cleared defects. Provenance tracking required by VREQ-009 for material title findings.']
  parcel_id varchar [note: 'Reference to the parcel record identifying the land affected by this instrument. Supports chain-of-title assembly and grantor/grantee index queries.']
  recording_submission_id varchar [note: 'Reference to the recording_submission record that originated this instrument. Links the accepted instrument back to the eRecording gateway submission event for gap-period and resubmission tracking.']
  title_claim_id varchar [note: 'Foreign key linking to claim.title_claim. Business justification: Recorded instruments trigger claims when post-recording defects surface (forgery, fraud, prior liens).']
  title_finding_id varchar [note: 'Foreign key linking to underwriting.title_finding. Business justification: Instruments recorded to cure specific title findings (liens, judgments, chain-of-title breaks) require direct traceability for curative-action effectiveness analysis']
  title_order_id varchar [note: 'Reference to the title order under which this instrument was prepared and submitted for recording. Supports closing-readiness and policy-issuance-lag metrics.']
  acceptance_date date [note: 'Date the county recorder formally accepted the instrument for recording (prior to official stamping). Distinct from execution_date, effective_date, submission_date, and recording_date per VREQ-008.']
  apn varchar [note: 'Assessor\'s Parcel Number assigned by the county assessor to the property affected by this instrument. Also known as PIN in some jurisdictions. Used for property tax lien searches and parcel cross-reference.']
  book_number varchar [note: 'Official book (volume) number assigned by the county recorder where the instrument is indexed. Used with page_number to form the traditional book/page recording reference in non-instrument-number jurisdictions.']
  chain_of_title_break_flag boolean [note: 'Indicates whether this instrument introduces a break in the chain of title (e.g., missing link in grantor/grantee index, gap in vesting). Set by title examination logic. Drives curative action and underwriting referral workflows.']
  consideration_amount decimal(18,2) [note: 'Stated monetary consideration for the conveyance as shown on the instrument (e.g., purchase price on a deed). Used for transfer tax calculation and LTV analysis. May be nominal for non-arm\'s-length transfers.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county where the instrument was recorded. Standard geographic identifier for jurisdiction routing, fee schedule lookup, and regulatory reporting.']
  created_timestamp timestamp [note: 'Timestamp when this recorded instrument record was first created in the lakehouse Silver layer. Supports audit trail and data lineage per SOC 2 and ALTA Best Practices.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this instrument (consideration_amount, loan_amount, recording_fee_amount, transfer_tax_amount). Defaults to USD for domestic US transactions.']
  document_image_reference varchar [note: 'URI or document management system reference to the scanned or electronic image of the recorded instrument as returned by the county recorder. Supports evidence and provenance requirements per VREQ-007.']
  effective_date date [note: 'Date the legal rights conveyed by the instrument take effect, which may differ from execution or recording date. Distinct from execution_date, submission_date, acceptance_date, and recording_date per VREQ-008.']
  erecording_gateway varchar [note: 'Electronic recording gateway or method used to submit and confirm this instrument (e.g., Simplifile, CSC eRecording). Null for paper-recorded instruments. Supports eRecording adoption and rejection-rate metrics.']
  execution_date date [note: 'Date the instrument was signed by the grantor(s) or obligor(s). Distinct from effective_date, submission_date, acceptance_date, and recording_date per VREQ-008. Required for chain-of-title validity analysis.']
  gap_coverage_flag boolean [note: 'Indicates whether this instrument falls within an active gap-coverage period (GAP) between the last title search and confirmed recording. True triggers gap-period monitoring and potential underwriting referral.']
  grantee_name varchar [note: 'Full legal name of the grantee (buyer, beneficiary, mortgagee, or receiving party) as it appears on the recorded instrument. Critical for grantor/grantee index and chain-of-title assembly.']
  grantor_name varchar [note: 'Full legal name of the grantor (seller, trustor, mortgagor, or conveying party) as it appears on the recorded instrument. Critical for grantor/grantee index and chain-of-title assembly.']
  instrument_number varchar [note: 'Official instrument number assigned by the county recorder or register of deeds upon acceptance. Primary externally-known identifier for the recorded instrument. Also called document number in some jurisdictions.']
  instrument_status varchar [note: 'Current lifecycle status of the recorded instrument as confirmed by the county recorder. Accepted = stamped and indexed; Released = lien released; Superseded = replaced by corrective instrument; Voided = expunged by court order.']
  instrument_subtype varchar [note: 'Further classification within the instrument type (e.g., Warranty Deed (WD), Quit Claim Deed (QCD), Special Warranty Deed (SWD), Purchase Money Mortgage (PMM), HELOC, Deed of Trust). Refines title examination and underwriting analysis.']
  instrument_type varchar [note: 'Legal classification of the recorded instrument (e.g., deed, deed of trust, mortgage, release, reconveyance, assignment, lis pendens, easement, UCC). Drives chain-of-title analysis and defect identification.']
  legal_description varchar [note: 'Full legal description of the property as it appears on the recorded instrument (metes and bounds, PLSS township/range/section, or plat/subdivision lot reference). Critical for chain-of-title and Schedule A verification.']
  lien_priority varchar [note: 'Priority position of the lien instrument relative to other encumbrances on the property (first, second, subordinate). Determined by recording date and any subordination agreements. Critical for lender policy coverage analysis.']
  lien_type varchar [note: 'Classification of the encumbrance type for lien instruments (e.g., mortgage, deed of trust, tax lien, mechanics lien, judgment lien, HOA lien, UCC). Null for conveyance instruments. Supports open-lien and aging-defect metrics.']
  loan_amount decimal(18,2) [note: 'Original principal amount of the loan secured by a deed of trust or mortgage as stated on the instrument. Used for LTV/CLTV analysis and lender policy coverage verification.']
  mers_min varchar [note: '18-digit MERS Mortgage Identification Number assigned to a deed of trust or mortgage registered on the MERS system. Null for non-MERS instruments. Required for lender policy and assignment chain verification.']
  notarization_type varchar [note: 'Method of notarization used for this instrument: traditional in-person, Remote Online Notarization (RON), In-Person Electronic Notarization (IPEN), or Remote Ink Notarization (RIN). Affects recording acceptance in some jurisdictions.']
  notary_commission_expiration_date date [note: 'Expiration date of the notary\'s commission at the time of acknowledgment. Used to validate that the notarization was performed within an active commission period, preventing recording defects.']
  notary_name varchar [note: 'Full name of the notary public who acknowledged the instrument. Required for recording validity verification and E&O compliance review.']
  page_count varchar [note: 'Total number of pages in the recorded instrument as accepted by the county recorder. Used to calculate per-page recording fees and verify fee reconciliation.']
  page_number varchar [note: 'Official page number within the recording book where the instrument is indexed. Combined with book_number to form the complete book/page recording reference used in chain-of-title searches.']
  prior_instrument_number varchar [note: 'Recording reference number of the instrument being released, reconveyed, assigned, or superseded by this instrument. Establishes the chain-of-title link between successive instruments for lien release and satisfaction tracking.']
  recording_date date [note: 'Official date the instrument was accepted and stamped by the county recorder or register of deeds. Distinct from execution_date, effective_date, submission_date, and acceptance_date. Anchors gap-period close and policy-issuance-lag calculation.']
  recording_fee_amount decimal(10,2) [note: 'Total fee paid to the county recorder for recording this instrument, including per-page fees and any indexing fees. Reconciled against the settlement statement disbursement.']
  recording_jurisdiction_name varchar [note: 'Human-readable name of the county recorder or register of deeds office where the instrument was recorded (e.g., \'Cook County Recorder of Deeds\'). Complements county_fips_code for display and reporting.']
  recording_timestamp timestamp [note: 'Precise date and time the instrument was stamped by the county recorder, including time zone offset. Used for priority determination in same-day recording conflicts and gap-period close precision.']
  release_satisfaction_flag boolean [note: 'Indicates whether this instrument is a release, satisfaction, or reconveyance that extinguishes a prior lien or encumbrance. Used to update open-lien status in the title examination and chain-of-title analysis.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the instrument was recorded. Used for state-level regulatory reporting, transfer tax rate lookup, and jurisdiction routing.']
  submission_date date [note: 'Date the instrument package was submitted to the county recorder or eRecording gateway. Distinct from execution_date, effective_date, acceptance_date, and recording_date per VREQ-008. Used in recording cycle-time analysis.']
  transfer_tax_amount decimal(10,2) [note: 'Documentary transfer tax or deed stamp tax collected at recording, calculated on the consideration amount per applicable state and county rates. Reconciled against settlement statement.']
  updated_timestamp timestamp [note: 'Timestamp when this recorded instrument record was last modified in the lakehouse Silver layer. Supports change tracking, lifecycle history preservation per VREQ-007, and audit compliance.']
  vesting_type varchar [note: 'Form of title vesting under which the grantee takes ownership (e.g., joint tenancy, tenancy in common, community property, trust, entity). Drives ownership interest modeling and underwriting analysis.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Authoritative SSOT for each individual legal instrument (deed, deed of trust, mortgage, release, reconveyance, assignment, UCC, lis pendens, easement) accepted and stamped by the county recorder or register of deeds.'
}

Table ti_recording.submission_document {
  submission_document_id varchar [pk, note: 'Unique surrogate identifier for each individual document line item within a recording submission package. Primary key for the submission_document entity.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Individual documents within agent-originated submissions must track the preparing agent for document-level quality audits, notarization compliance reviews, and oversight sampling.']
  gateway_transaction_id varchar [note: 'Unique transaction identifier assigned by the eRecording gateway (e.g., Simplifile transaction ID) for this document submission. Used for gateway reconciliation and rejection tracking.']
  recording_submission_id varchar [note: 'Foreign key reference to the parent recording_submission package that contains this document. Establishes the header-detail relationship for multi-document submissions.']
  title_order_id varchar [note: 'Reference to the originating title order associated with this document, enabling traceability from recording back through the full title lifecycle.']
  acceptance_date date [note: 'Date the county recorder or eRecording gateway formally accepted this document for recording. Marks the start of the gap-period (GAP) closure window. Distinct per VREQ-008.']
  book_number varchar [note: 'Book number assigned by the county recorder as part of the book/page recording reference system. Used in jurisdictions that index by book and page rather than instrument number.']
  consideration_amount decimal(15,2) [note: 'Dollar amount of consideration stated on the face of the conveyance instrument (e.g., purchase price on a deed). Used for transfer tax calculation and chain-of-title value analysis.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) code identifying the county or county-equivalent jurisdiction where the document is recorded. Enables multi-jurisdiction reporting.']
  created_timestamp timestamp [note: 'Timestamp when this submission_document record was first created in the system of record. Supports audit trail and lifecycle tracking per VREQ-007.']
  document_image_reference varchar [note: 'Reference identifier or URI pointing to the scanned or electronic image of this document in the Document Management and Imaging System. Supports evidence and provenance requirements.']
  document_sequence_number varchar [note: 'Ordinal position of this document within the parent recording submission package. Determines recording priority order (e.g., deed records before deed of trust).']
  document_status varchar [note: 'Current lifecycle status of this individual document within the recording workflow. Tracks progression from pending through recorded or rejected/resubmitted states.']
  document_subtype varchar [note: 'Further classification within the document type (e.g., Warranty Deed vs. Quit Claim Deed vs. Special Warranty Deed). Supports granular chain-of-title analysis. [ENUM-REF-CANDIDATE: promote to reference product]']
  document_title varchar [note: 'Human-readable title or caption of the legal instrument as it appears on the face of the document (e.g., \'Warranty Deed\', \'Deed of Trust and Security Agreement\').']
  document_type varchar [note: 'Classification of the legal instrument being submitted for recording (e.g., Warranty Deed, Deed of Trust, Release/Reconveyance, Subordination Agreement). [ENUM-REF-CANDIDATE']
  effective_date date [note: 'Date the legal instrument becomes operative and binding between the parties. May differ from execution date and recording date. Distinct per VREQ-008.']
  erecording_gateway varchar [note: 'Identifies the eRecording gateway or submission channel used to transmit this document to the county recorder (e.g., Simplifile, CSC eRecording, direct paper). Supports gateway performance metrics.']
  execution_date date [note: 'Date the document was signed/executed by the parties. Distinct from effective date, submission date, acceptance date, and recording date per VREQ-008.']
  gap_close_date date [note: 'Date the gap coverage period closed for this document, set equal to the confirmed recording_date. A null value indicates the gap period remains open and the document has not yet been confirmed recorded.']
  gap_coverage_flag boolean [note: 'Indicates whether gap coverage (GAP) is in effect for this document, covering the period between closing/execution and confirmed recording. True when gap period is open and insured.']
  gap_open_date date [note: 'Date the gap coverage period opened for this document, typically the closing/disbursement date. The gap period runs from this date until the recording_date is confirmed.']
  grantee_name varchar [note: 'Name of the grantee (transferee/beneficiary/mortgagee) as it appears on the face of the document. Used for chain-of-title indexing and grantor-grantee index matching at the county recorder.']
  grantor_name varchar [note: 'Name of the grantor (transferor/trustor/mortgagor) as it appears on the face of the document. Used for chain-of-title indexing and grantor-grantee index matching at the county recorder.']
  instrument_number varchar [note: 'Sequential instrument number assigned by the county recorder in jurisdictions that use instrument-number indexing rather than book/page. Unique within a county and recording year.']
  is_erecording_eligible boolean [note: 'Indicates whether this document type and jurisdiction combination supports electronic recording (eRecording). False indicates paper recording is required for this document.']
  loan_amount decimal(15,2) [note: 'Principal loan amount secured by a deed of trust or mortgage instrument as stated on the face of the document. Used for lender policy coverage verification and lien priority analysis.']
  notarization_type varchar [note: 'Method by which the document was notarized: traditional in-person, Remote Online Notarization (RON), or In-Person Electronic Notarization (IPEN). Affects county recorder acceptance requirements.']
  notary_commission_expiration_date date [note: 'Expiration date of the notary public\'s commission at the time of notarization. Validates that the notary was duly commissioned when the document was executed, preventing recording rejection.']
  notary_name varchar [note: 'Full name of the notary public who acknowledged or witnessed the execution of this document. Required for recording acceptance in most jurisdictions.']
  page_count varchar [note: 'Total number of pages in this individual document as submitted for recording. Used to calculate per-page recording fees and verify completeness against the recorded instrument.']
  page_number varchar [note: 'Page number assigned by the county recorder as part of the book/page recording reference system. Used alongside book_number in jurisdictions that index by book and page.']
  policy_issuance_lag_days varchar [note: 'Number of calendar days elapsed between the confirmed recording_date and the issuance of the associated title policy. Supports the policy-issuance-lag-after-recording metric per VREQ-016.']
  priority_recording_flag boolean [note: 'Indicates this document requires expedited or priority recording to protect lien priority or close the gap period within a time-sensitive window (e.g., same-day recording required).']
  recording_date date [note: 'Official date the document was recorded in the public record by the county recorder or register of deeds. Closes the GAP coverage window. Distinct per VREQ-008.']
  recording_fee_amount decimal(12,2) [note: 'Dollar amount of the recording fee assessed by the county recorder for this individual document, typically calculated based on page count and document type per the jurisdiction fee schedule.']
  recording_jurisdiction_name varchar [note: 'Name of the county recorder, register of deeds, or other recording jurisdiction office where this document is submitted (e.g., \'Cook County Recorder of Deeds\').']
  recording_reference_number varchar [note: 'Official recording reference assigned by the county recorder upon recording (e.g., instrument number, document number). The primary public-record identifier for the recorded instrument.']
  recording_timestamp timestamp [note: 'Precise date and time the document was stamped as recorded by the county recorder, including time-of-day priority for same-day recordings. Critical for lien priority determination.']
  rejection_count varchar [note: 'Cumulative number of times this document has been rejected by the county recorder or eRecording gateway. Supports recording rejection and resubmission rate metrics per VREQ-016.']
  rejection_reason_code varchar [note: 'Standardized code returned by the county recorder or eRecording gateway explaining why this document was rejected (e.g., missing notary, incorrect fee, illegible). Drives resubmission workflow.']
  rejection_reason_description varchar [note: 'Free-text description of the rejection reason as provided by the county recorder or eRecording gateway. Supplements the rejection_reason_code with human-readable detail for curative action.']
  resubmission_date date [note: 'Date this document was most recently resubmitted to the county recorder following a prior rejection. Used to calculate resubmission turnaround time and recording rejection rate metrics.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the document is recorded. Supports state-level regulatory reporting and recording fee schedules.']
  submission_date date [note: 'Date this document was submitted to the county recorder or eRecording gateway for recording. Distinct from execution, effective, acceptance, and recording dates per VREQ-008.']
  transfer_tax_amount decimal(12,2) [note: 'Documentary transfer tax or deed tax assessed on this document at the time of recording, typically applicable to conveyance instruments. Reported on the Closing Disclosure (CD).']
  updated_timestamp timestamp [note: 'Timestamp when this submission_document record was most recently modified in the system of record. Supports change tracking and lifecycle history preservation per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Line-item entity representing each individual document within a recording_submission (e.g., a deed, deed of trust, release, and subordination agreement as separate documents), each with its own document type, page count, recording fee, execution date'
}

Table ti_recording.rejection_event {
  rejection_event_id varchar [pk, note: 'Unique surrogate identifier for each discrete rejection notice event returned by a county recorder or eRecording gateway for a recording submission or individual submission document.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Recording rejections on agent files must route curative actions to the responsible agent and track rejection rates by agent for oversight reviews, authority adjustments, and training']
  gateway_transaction_id varchar [note: 'Transaction identifier assigned by the eRecording gateway (Simplifile or CSC) for the submission batch or document that was rejected, enabling reconciliation with gateway records.']
  operations_curative_action_id varchar [note: 'Foreign key linking to operations.operations_curative_action. Business justification: Recording rejections (missing notarization, signature defects, margin errors) trigger curative actions. Tracks curative action aging and effectiveness per VREQ-016.']
  rejection_recording_submission_id varchar [note: 'Reference to the parent recording_submission record against which this rejection was issued. Establishes the submission-level context for the rejection event.']
  rejection_resubmission_submission_recording_submission_id varchar [note: 'Reference to the new recording_submission record created as a result of resubmitting the corrected document after this rejection, enabling chain-of-resubmission tracking.']
  submission_document_id varchar [note: 'Reference to the specific submission_document within the parent submission that triggered this rejection, when the rejection is document-level rather than submission-level. Null for submission-level rejections.']
  title_order_id varchar [note: 'Reference to the title order associated with this rejection event, enabling cross-domain traceability from recording back to the originating order and lifecycle.']
  assigned_to_user varchar [note: 'Username or employee identifier of the recording specialist or closer assigned to resolve this rejection event. Supports workload management and accountability tracking.']
  corrected_fee_amount decimal(12,2) [note: 'Corrected recording fee amount (in USD) required by the county recorder to accept the resubmission, when the rejection was due to an incorrect fee. Supports settlement reconciliation.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) code uniquely identifying the county or jurisdiction of the recording office that issued the rejection.']
  county_name varchar [note: 'Name of the county or jurisdiction whose recorder or register of deeds issued the rejection notice. Supports jurisdiction-level rejection rate analysis.']
  created_timestamp timestamp [note: 'Date and time when this rejection_event record was first captured in the system of record (eRecording gateway or title production system). Audit trail field.']
  curative_action_description varchar [note: 'Description of the specific curative action required to resolve this rejection (e.g., re-execute deed, correct legal description, obtain notary re-acknowledgment, pay correct recording fee).']
  curative_action_required boolean [note: 'Indicates whether this rejection requires a curative action (document correction, re-execution, or additional evidence) before resubmission can occur. Drives curative workflow routing.']
  days_open varchar [note: 'Number of calendar days this rejection event has been in an open/unresolved state, calculated from received_timestamp to current date or resolution_timestamp. Supports aging and SLA reporting.']
  document_reference_number varchar [note: 'The document-level tracking number or identifier assigned by the eRecording gateway or county recorder to the specific document that was rejected, for traceability.']
  document_type varchar [note: 'Type of instrument or document that was rejected (e.g., Deed of Trust, Warranty Deed, Quit Claim Deed, Mortgage, Release, Assignment). Relevant for document-level rejections. [ENUM-REF-CANDIDATE: promote to reference product]']
  erecording_gateway_name varchar [note: 'Name of the eRecording gateway or submission channel through which the document was submitted and rejected (e.g., Simplifile, CSC eRecording, or direct county submission).']
  escalated_to_underwriting boolean [note: 'Indicates whether this rejection event was escalated to the underwriting team for risk assessment or exception handling, particularly when the rejection creates a title defect or cloud on title.']
  escalation_timestamp timestamp [note: 'Date and time when this rejection event was escalated to underwriting or management for review. Null if not escalated. Supports escalation rate and aging metrics.']
  gap_period_days varchar [note: 'Number of calendar days of gap coverage exposure attributable to this rejection event, measured from the original submission date to the resubmission or resolution date.']
  gap_period_impacted boolean [note: 'Indicates whether this rejection event extended or created a gap coverage period (GAP) between the closing date and confirmed recording date, triggering additional underwriting risk exposure.']
  notes varchar [note: 'Free-text operational notes entered by the recording specialist regarding the rejection event, curative steps taken, communications with the county recorder, or other relevant context.']
  number varchar [note: 'Externally assigned or internally generated business identifier for this rejection notice, as returned by the eRecording gateway (e.g., Simplifile or CSC) or county recorder office.']
  original_submission_date date [note: 'Date on which the original recording submission was first submitted to the county recorder or eRecording gateway, prior to this rejection. Used to calculate total recording cycle time.']
  policy_issuance_impacted boolean [note: 'Indicates whether this rejection event delayed or blocked the issuance of the owner or lender title policy, contributing to the policy-issuance-lag-after-recording metric.']
  received_timestamp timestamp [note: 'Date and time when the rejection notice was received from the county recorder or eRecording gateway. Principal business event timestamp for this rejection event; anchors aging and SLA calculations.']
  recording_fee_amount decimal(12,2) [note: 'Recording fee amount (in USD) associated with the rejected submission or document, relevant when the rejection reason involves incorrect fee payment or fee recalculation.']
  rejection_category varchar [note: 'High-level classification of the rejection reason (e.g., legal_description_error, missing_signature, incorrect_fee, formatting_defect, vesting_mismatch, notarization_defect). [ENUM-REF-CANDIDATE: promote to reference product]']
  rejection_grain varchar [note: 'Explicit grain discriminator indicating whether this rejection applies to the entire recording submission (submission-level) or to a single document within the submission (document-level).']
  rejection_notice_date date [note: 'Calendar date stated on the official rejection notice issued by the county recorder or eRecording gateway. Distinct from received_timestamp; reflects the official notice date for legal purposes.']
  rejection_notice_text varchar [note: 'Full verbatim text of the rejection notice as received from the county recorder or eRecording gateway, preserved for evidence, provenance, and curative action guidance.']
  rejection_reason_code varchar [note: 'Standardized code assigned by the county recorder or eRecording gateway identifying the specific reason for rejection (e.g., county-specific error codes from Simplifile or CSC rejection notice).']
  rejection_reason_description varchar [note: 'Free-text narrative description of the rejection reason as returned by the county recorder or eRecording gateway, preserving the verbatim rejection notice language for curative reference.']
  rejection_sequence_number varchar [note: 'Ordinal sequence of this rejection event within the parent recording submission, enabling tracking of repeated rejections (1st rejection, 2nd rejection, etc.) for resubmission rate metrics.']
  rejection_source varchar [note: 'The authority or system that issued the rejection notice — county recorder, eRecording gateway (Simplifile/CSC), register of deeds, or state-level recording office.']
  rejection_status varchar [note: 'Current workflow state of this rejection event. Drives recording rejection/resubmission rate metrics and aging analysis. [ENUM-REF-CANDIDATE: open|resolved|resubmitted|waived|escalated|closed — promote to reference product]']
  resolution_method varchar [note: 'Method by which this rejection was resolved: resubmission of corrected document, waiver granted by county, withdrawal of submission, escalation to underwriter, or county-initiated override.']
  resolution_timestamp timestamp [note: 'Date and time when this rejection event was resolved (either by successful resubmission, waiver, or closure). Used to calculate rejection resolution cycle time.']
  resubmission_date date [note: 'Actual date on which the corrected document was resubmitted to the county recorder or eRecording gateway following resolution of this rejection event.']
  resubmission_deadline_date date [note: 'Date by which the corrected document must be resubmitted to the county recorder to preserve GAP coverage and avoid policy issuance delays. Critical for gap-period risk management.']
  sla_breached boolean [note: 'Indicates whether the resolution of this rejection event exceeded the SLA target days, signaling a recording delay that may impact closing readiness and policy issuance timelines.']
  sla_target_days varchar [note: 'Number of business or calendar days within which this rejection must be resolved per internal SLA or lender/client agreement. Baseline for SLA breach detection.']
  source_system_rejection_code varchar [note: 'Native identifier for this rejection event as assigned by the originating system of record (eRecording gateway such as Simplifile or CSC, or title production system). Supports reconciliation.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the recording office is located. Supports state-level regulatory reporting and rejection rate metrics.']
  updated_timestamp timestamp [note: 'Date and time when this rejection_event record was last modified, supporting audit trail and change tracking for the rejection lifecycle.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Transactional SSOT for each discrete rejection notice returned for a recording submission or an individual submission_document, carrying an explicit grain flag (submission-level vs document-level).'
}

Table ti_recording.gap_coverage_period {
  gap_coverage_period_id varchar [pk, note: 'Unique surrogate identifier for the GAP coverage period record tracking the interval between closing/last search date and confirmed recording date for a title order.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: Gap coverage authority is delegated to agents under specific limits. Tracking the agent managing each gap period is required for authority compliance monitoring, gap risk reporting, and']
  recording_submission_id varchar [note: 'Reference to the recording submission that, upon acceptance, closes the GAP coverage window. Links to the eRecording gateway submission record.']
  title_claim_id varchar [note: 'Foreign key linking to claim.title_claim. Business justification: Gap coverage periods generate claims when intervening liens or defects arise during the gap. Claims adjuster must reference the gap period to validate coverage and determine liability.']
  title_commitment_id varchar [note: 'Reference to the title commitment under which GAP coverage is extended. Identifies the commitment version in effect at closing.']
  title_order_id varchar [note: 'Reference to the title order for which this GAP coverage period is being tracked. Links the GAP window to the originating order intake record.']
  title_policy_id varchar [note: 'Reference to the title policy (owner or lender) that incorporates or is affected by this GAP coverage period. Populated after policy issuance.']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record created when the GAP window exceeded allowed thresholds or required non-standard resolution. Null if no referral was required.']
  acceptance_date date [note: 'The date on which the county recorder formally accepted the submitted instruments for recording. Distinct from submission_date and recording_date per VREQ-008.']
  book_number varchar [note: 'The official book number assigned by the county recorder upon acceptance of the recorded instrument. Part of the recording reference (book/page) that closes the GAP window.']
  channel_type varchar [note: 'Production channel through which the title order was originated. Distinguishes direct branch, centralized lender, and independent agent channels for GAP performance analysis.']
  closing_date date [note: 'The date on which the real estate transaction closed and insured instruments were executed. Serves as the primary anchor for the GAP coverage start when later than last search date.']
  created_timestamp timestamp [note: 'Timestamp when this GAP coverage period record was first created in the system. Supports audit trail and lifecycle history preservation per VREQ-007.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the gap coverage amount. Defaults to USD for domestic US title insurance transactions.']
  erecording_gateway varchar [note: 'The eRecording gateway or submission method used to submit instruments to the county recorder. Identifies Simplifile, CSC eRecording, or direct county submission for operational tracking.']
  gap_close_date date [note: 'The date on which the GAP coverage period was formally closed, either by confirmed recording, waiver, or expiration. Distinct from recording_date to accommodate non-recording closures.']
  gap_coverage_amount decimal(18,2) [note: 'The dollar amount of title insurance coverage extended during the GAP period. Typically equals the policy amount for the insured instruments pending recording.']
  gap_cure_method varchar [note: 'The method by which the GAP coverage period was resolved or cured. Recording confirmation is standard; affidavit, indemnity, waiver, or endorsement may be used in exceptional cases.']
  gap_cure_notes varchar [note: 'Free-text notes documenting the circumstances of GAP cure, including any non-standard resolution methods, underwriting exceptions, or curative actions taken to close the window.']
  gap_duration_days varchar [note: 'Number of calendar days between gap_start_date and gap_close_date (or current date if still open). Drives the policy-issuance-lag-after-recording and GAP aging metrics.']
  gap_escalation_date date [note: 'The date on which the open GAP coverage period was escalated to underwriting or management review due to exceeding the maximum allowed duration or elevated risk classification.']
  gap_reference_number varchar [note: 'Externally assigned or internally generated reference number uniquely identifying this GAP coverage period for operational tracking and audit purposes.']
  gap_risk_flag boolean [note: 'Underwriting risk classification assigned to this GAP period based on duration, jurisdiction, instrument type, and rejection history. Drives escalation and monitoring workflows.']
  gap_start_date date [note: 'The date on which the GAP coverage window opens. Typically the closing date or the date of the last title search, whichever is later, per ALTA gap coverage standards.']
  gap_status varchar [note: 'Current lifecycle status of the GAP coverage window. Open indicates recording not yet confirmed; closed indicates recording confirmed; expired indicates coverage lapsed without recording.']
  gap_type varchar [note: 'Classification of the GAP coverage period by transaction type. Distinguishes standard purchase GAP from construction, HELOC, or refinance GAP windows with different risk profiles.']
  instrument_number varchar [note: 'The unique instrument or document number assigned by the county recorder upon recording. Used as the primary recording reference in jurisdictions that do not use book/page.']
  insured_instrument_type varchar [note: 'Type of the primary instrument pending recording that is covered during the GAP period. Examples include Warranty Deed (WD), Deed of Trust (DOT), or mortgage.']
  is_gap_exceeded boolean [note: 'Indicates whether the GAP coverage window has exceeded the maximum allowed duration. True triggers underwriting escalation and potential coverage review per policy guidelines.']
  jurisdiction_fips_code varchar [note: 'Five-digit FIPS code identifying the county or jurisdiction where recording is required. Drives jurisdiction-specific GAP duration rules and recording turnaround benchmarks.']
  last_rejection_reason varchar [note: 'The most recent reason provided by the county recorder for rejecting the recording submission. Supports root-cause analysis of recording delays that extend the GAP window.']
  last_search_date date [note: 'The date through which the title search was last run prior to closing. Used to establish the beginning of the GAP period when it precedes the closing date.']
  max_allowed_gap_days varchar [note: 'The maximum number of calendar days the GAP coverage window is permitted to remain open per underwriting guidelines or state regulatory requirements before escalation is required.']
  page_number varchar [note: 'The official page number assigned by the county recorder upon acceptance of the recorded instrument. Combined with book_number forms the complete recording reference.']
  policy_issuance_lag_days varchar [note: 'Number of calendar days between the confirmed recording_date and the date the title policy was issued. Directly supports the policy-issuance-lag-after-recording metric per VREQ-016.']
  policy_issue_date date [note: 'The date on which the title policy was issued following confirmed recording. Used to compute policy_issuance_lag_days and to confirm the GAP window is fully resolved.']
  policy_type varchar [note: 'Indicates whether the GAP coverage applies to the Owner Title Policy (OTP), Lender Title Policy (LTP), or both. Drives separate owner-versus-lender coverage tracking per VREQ-010.']
  record_version varchar [note: 'Monotonically incrementing version number for this GAP coverage period record. Supports optimistic concurrency control and revision history tracking per VREQ-007.']
  recording_confirmed_timestamp timestamp [note: 'Precise timestamp when recording confirmation was received from the eRecording gateway or county recorder, marking the official close of the GAP coverage window.']
  recording_date date [note: 'The date on which the insured instruments were officially recorded by the county recorder or register of deeds, closing the GAP coverage window. Null until recording is confirmed.']
  rejection_count varchar [note: 'Number of times the recording submission was rejected by the county recorder prior to acceptance. Feeds the recording rejection and resubmission rate metric per VREQ-016.']
  resubmission_date date [note: 'The date of the most recent resubmission of instruments to the county recorder following a rejection. Null if no rejection has occurred.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this GAP coverage period record originated. Supports data lineage and provenance tracking across the title lifecycle.']
  state_code varchar [note: 'Two-letter US state abbreviation for the jurisdiction where the property is located and recording is performed. Used for state-level regulatory and underwriting rule application.']
  submission_date date [note: 'The date on which the insured instruments were submitted to the county recorder or eRecording gateway. Distinct from closing_date, recording_date, and gap_start_date per VREQ-008.']
  transaction_type varchar [note: 'Classification of the underlying real estate transaction. Distinguishes purchase, refinance (REFI), HELOC, construction, and commercial transactions for GAP risk segmentation.']
  updated_timestamp timestamp [note: 'Timestamp when this GAP coverage period record was last modified. Supports change tracking, audit trail, and lifecycle history preservation per VREQ-007.']
  uw_referral_required boolean [note: 'Indicates whether the extended GAP duration or non-standard cure method triggered an underwriting referral (UWR). True when gap_duration_days exceeds max_allowed_gap_days.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Tracks the GAP coverage window for each title order — the legally significant interval between the closing date (or last search date) and the confirmed recording date of the insured instruments.'
}

Table ti_recording.fee {
  fee_id varchar [pk, note: 'Unique surrogate identifier for a recording fee schedule record. Primary key for the fee reference master.']
  jurisdiction_id varchar [note: 'Foreign key linking to recording.jurisdiction. Business justification: Fee schedules are jurisdiction-specific. The fee table currently has denormalized jurisdiction attributes (county_fips_code, state_code, recording_jurisdiction_name) that should be']
  prior_fee_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding fee schedule record that this version supersedes. Enables chain-of-version navigation for audit and historical fee reconstruction.']
  base_fee_amount decimal(12,2) [note: 'Flat base fee charged per document submission regardless of page count, expressed in USD. Represents the minimum recording charge for the instrument type in this jurisdiction.']
  consideration_threshold_amount decimal(14,2) [note: 'Minimum consideration amount above which transfer tax or documentary stamp tax applies. Transactions at or below this threshold may be exempt from the tax component.']
  created_timestamp timestamp [note: 'Timestamp when this fee schedule record was first created in the system. Supports audit trail and data lineage per ALTA Best Practices and SOC 2 requirements.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary fee amounts in this record. Defaults to USD for domestic US recording jurisdictions.']
  documentary_stamp_rate decimal(10,6) [note: 'Ad valorem rate applied to the consideration or loan amount to compute documentary stamp tax, expressed as a decimal. Common in Florida and other southeastern states.']
  effective_date date [note: 'Date on which this fee schedule version becomes effective and must be applied to recording submissions. Supports lifecycle management and historical fee lookups.']
  enacted_date date [note: 'Date the underlying statute, ordinance, or county resolution authorizing this fee schedule was enacted or signed into law. Supports regulatory audit and provenance.']
  erecording_gateway varchar [note: 'Name of the eRecording gateway or submission channel accepted by this jurisdiction for electronic document submission (e.g., Simplifile, CSC eRecording, direct county portal).']
  erecording_supported boolean [note: 'Indicates whether the recording jurisdiction accepts electronic recording (eRecording) submissions via gateways such as Simplifile or CSC eRecording for this instrument type.']
  expiration_date date [note: 'Date on which this fee schedule version expires and is superseded. Null indicates the record is open-ended and currently active. Supports bi-temporal fee lookups.']
  fee_code varchar [note: 'Alphanumeric code assigned by the jurisdiction or the title production system (e.g., SoftPro/RamQuest) to uniquely identify this fee line within the county fee schedule.']
  fee_description varchar [note: 'Detailed narrative description of the fee, including statutory basis, applicability conditions, and any special instructions from the county recorder.']
  fee_name varchar [note: 'Human-readable name of the fee as published by the recording jurisdiction or as labeled in the title production system (e.g., \'Deed Recording Fee\', \'Per-Page Surcharge\').']
  fee_status varchar [note: 'Lifecycle status of this fee schedule record: active (currently in effect), inactive (no longer applicable), pending (approved but not yet effective), superseded (replaced by a newer version).']
  fee_type varchar [note: 'Classification of the fee component: base_recording (flat per-document fee), per_page (per-page charge), transfer_tax (deed transfer tax), documentary_stamp (documentary stamp tax), mortgage_tax (mortgage recording tax), indexing (indexing/data-entry fee).']
  included_pages varchar [note: 'Number of pages included in the base recording fee before per-page charges apply. A value of zero means per-page fees apply from the first page.']
  indexing_fee_amount decimal(10,2) [note: 'Flat fee charged by the county recorder for indexing the document in the grantor-grantee index, expressed in USD. May be per-name or per-document depending on jurisdiction.']
  indexing_fee_basis varchar [note: 'Basis on which the indexing fee is assessed: per_document (flat per submission), per_name (per grantor or grantee name indexed), or per_parcel (per APN/PIN indexed).']
  instrument_type varchar [note: 'Category of recorded instrument to which this fee applies (e.g., Deed of Trust, Warranty Deed, Mortgage, Release, Assignment, Lien). [ENUM-REF-CANDIDATE']
  last_verified_date date [note: 'Date on which the fee schedule was last confirmed accurate against the official county recorder or state revenue department source. Supports data quality monitoring.']
  max_pages varchar [note: 'Maximum number of pages accepted under this fee schedule tier. Null indicates no page cap. Used to determine if a document requires a higher fee tier or split submission.']
  mortgage_tax_rate decimal(10,6) [note: 'Ad valorem rate applied to the loan amount to compute mortgage recording tax, expressed as a decimal. Applicable in states such as New York, Florida, and Alabama.']
  notes varchar [note: 'Free-text field for operational notes, special instructions, or known exceptions related to this fee schedule entry (e.g., \'Surcharge applies only to commercial deeds over $1M\').']
  paper_recording_accepted boolean [note: 'Indicates whether the jurisdiction still accepts paper (physical) document submissions in addition to or instead of eRecording for this instrument type.']
  per_page_fee_amount decimal(10,2) [note: 'Additional fee charged per page of the recorded document beyond any included pages, expressed in USD. Used to calculate total recording fee based on page_count.']
  source_reference_url varchar [note: 'URL of the official county recorder or state revenue department web page where this fee schedule is published. Supports provenance and verification of fee amounts.']
  statutory_authority varchar [note: 'Citation of the statute, code section, or county ordinance that authorizes this fee (e.g., \'Cal. Gov. Code § 27361\', \'Fla. Stat. § 28.24\'). Supports compliance and audit.']
  transfer_tax_exemption_available boolean [note: 'Indicates whether statutory exemptions from transfer tax are available in this jurisdiction for qualifying transactions (e.g., inter-spousal transfers, government conveyances).']
  transfer_tax_exemption_codes varchar [note: 'Comma-separated list of jurisdiction-defined exemption codes that may be cited on the deed to claim transfer tax exemption (e.g., \'R11,R12\' for California). Null if no exemptions apply.']
  transfer_tax_per_unit_amount decimal(10,4) [note: 'Fixed transfer tax amount per unit of consideration (e.g., per $500 or per $1,000 of consideration), used in jurisdictions with tiered or per-unit transfer tax structures.']
  transfer_tax_rate decimal(10,6) [note: 'Ad valorem rate applied to the consideration amount to compute deed transfer tax, expressed as a decimal (e.g., 0.001100 = 0.11%). Null if transfer tax is not applicable for this fee type.']
  transfer_tax_unit_basis decimal(10,2) [note: 'The consideration increment (e.g., 500.00 or 1000.00 USD) used as the denominator for per-unit transfer tax calculations. Null if rate-based rather than per-unit.']
  updated_timestamp timestamp [note: 'Timestamp when this fee schedule record was last modified. Used to detect stale fee data and trigger re-verification workflows.']
  verified_by varchar [note: 'Name or identifier of the staff member, vendor, or automated process that last verified this fee schedule against the official source.']
  version_number varchar [note: 'Sequential version number for this fee schedule record within the same jurisdiction and instrument type. Increments each time the county updates its fee schedule, supporting history retention per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Reference master for county-level and instrument-type-level recording fee schedules maintained per jurisdiction (FIPS county code). Captures fee type (base recording fee, per-page fee, transfer tax, documentary stamp tax, mortgage tax, indexing fee), fee'
}

Table ti_recording.jurisdiction {
  jurisdiction_id varchar [pk, note: 'Unique surrogate identifier for each county recorder or register of deeds jurisdiction record in the title insurance recording master reference.']
  erecording_jurisdiction_id varchar [note: 'The jurisdiction identifier assigned by the eRecording gateway (e.g., Simplifile county code) used to route electronic submissions. Distinct from the FIPS code; required for gateway API calls.']
  accepted_document_types varchar [note: 'Comma-delimited list of document types accepted for recording by this jurisdiction (e.g., deed, deed_of_trust, mortgage, release, assignment, lien). Used for submission validation and routing.']
  avg_recording_turnaround_days varchar [note: 'Typical number of business days from submission to acceptance/recording confirmation for this jurisdiction. Used to estimate gap-period duration and policy issuance lag after recording.']
  base_recording_fee_amount decimal(10,2) [note: 'Standard base recording fee charged by this jurisdiction per document submission, in USD. Used for settlement statement (CD/HUD-1/ALTA) fee estimation and escrow disbursement calculation.']
  common_rejection_reasons varchar [note: 'Free-text or comma-delimited list of the most frequent rejection reasons observed for this jurisdiction (e.g., missing notary seal, incorrect fee, margin violation). Used for submission quality improvement.']
  county_name varchar [note: 'Official name of the county or county-equivalent (e.g., parish, borough, independent city) as designated by the state government. Used for display, reporting, and document preparation.']
  cover_sheet_required boolean [note: 'Indicates whether this jurisdiction requires a standardized cover sheet (e.g., ALTA or county-specific) to be attached to each document submission. Drives document preparation workflow.']
  cover_sheet_template_code varchar [note: 'Internal code identifying the cover sheet template required by this jurisdiction. Used by the document preparation system to auto-attach the correct cover sheet to recording submissions.']
  created_timestamp timestamp [note: 'Timestamp when this jurisdiction record was first created in the system. Supports audit trail and record provenance tracking per ALTA Best Practices data governance requirements.']
  data_source varchar [note: 'Source from which this jurisdiction record\'s details were obtained or last refreshed (e.g., Simplifile county list, CSC eRecording, county website, PRIA directory, manual entry). Supports data lineage.']
  erecording_accepted boolean [note: 'Indicates whether this jurisdiction accepts electronic recording (eRecording) submissions via an approved gateway such as Simplifile or CSC eRecording. Drives submission channel routing logic.']
  erecording_gateway varchar [note: 'Name of the eRecording gateway platform used to submit documents to this jurisdiction (e.g., Simplifile, CSC eRecording). Drives API routing and submission tracking integration.']
  fee_effective_date date [note: 'Date on which the current recording fee schedule (base_recording_fee_amount, fee_per_page_amount, transfer_tax_rate) became effective for this jurisdiction. Supports fee schedule versioning.']
  fee_expiration_date date [note: 'Date on which the current recording fee schedule expires or is superseded. Null indicates the fee schedule is open-ended. Used for fee schedule lifecycle management.']
  fee_per_page_amount decimal(10,2) [note: 'Additional recording fee charged per page beyond the base fee, in USD. Used to calculate total recording fees for multi-page instruments on the settlement statement.']
  fips_county_code varchar [note: 'Five-digit FIPS code uniquely identifying the county or county-equivalent jurisdiction per NIST FIPS 6-4. Used as the primary geographic key for recording office lookup and eRecording gateway routing.']
  font_size_minimum_pt decimal(4,1) [note: 'Minimum font size in points required for text in documents submitted to this jurisdiction. Enforced during document preparation to prevent rejection due to illegibility.']
  gap_coverage_applicable boolean [note: 'Indicates whether gap coverage (GAP) is applicable in this jurisdiction, covering the period between closing and confirmed recording. Drives gap-period risk monitoring and policy issuance lag tracking.']
  in_person_submission_accepted boolean [note: 'Indicates whether this jurisdiction accepts in-person document submission at the recording office counter. Used for same-day recording needs and courier delivery.']
  ipen_accepted boolean [note: 'Indicates whether this jurisdiction accepts documents notarized via In-Person Electronic Notarization (IPEN). Used alongside ron_accepted to determine eligible closing modalities.']
  last_updated_timestamp timestamp [note: 'Timestamp when this jurisdiction record was most recently modified. Used to detect stale fee schedules, outdated submission channel flags, or changed office contact information.']
  last_verified_date date [note: 'Date on which the jurisdiction record details (fees, channels, contact info) were last verified against the official county recorder source. Supports data quality monitoring and stale-reference alerting.']
  mail_submission_accepted boolean [note: 'Indicates whether this jurisdiction accepts document submissions via postal mail. Used as a fallback channel when eRecording is unavailable or rejected.']
  margin_requirement_inches decimal(4,2) [note: 'Minimum margin size in inches required on all pages of documents submitted to this jurisdiction. Non-compliant margins are a common rejection cause; used in document preparation validation.']
  max_pages_base_fee varchar [note: 'Number of pages included in the base recording fee before per-page charges apply. Used with fee_per_page_amount to compute total recording fees for documents exceeding the base page threshold.']
  notarization_required boolean [note: 'Indicates whether notarization is required for documents submitted to this jurisdiction. Drives closing workflow requirements for notary scheduling and RON/IPEN eligibility.']
  office_address_line1 varchar [note: 'Primary street address line of the recording office, used for mail and in-person document submission. Required when eRecording is unavailable or rejected documents must be physically resubmitted.']
  office_address_line2 varchar [note: 'Secondary address line (suite, floor, room number) for the recording office. Supplements office_address_line1 for precise physical delivery of documents.']
  office_city varchar [note: 'City in which the recording office is physically located. Used in conjunction with state_code and office_zip_code for mail submission addressing and courier routing.']
  office_email varchar [note: 'Official email address for the recording office, used for submission inquiries, rejection notices, and correspondence regarding recorded instruments.']
  office_fax varchar [note: 'Fax number for the recording office, used in jurisdictions that accept fax-based document submission or rejection notice delivery.']
  office_hours varchar [note: 'Standard business hours of the recording office (e.g., \'Mon-Fri 08:00-17:00 CT\'). Used to determine same-day recording eligibility and courier delivery scheduling.']
  office_phone varchar [note: 'Primary telephone number for the recording office, used to resolve rejection inquiries, confirm receipt of mailed documents, and coordinate resubmission.']
  office_status varchar [note: 'Current operational status of the recording jurisdiction. Inactive or merged jurisdictions are retained for historical recording reference but blocked from new submission routing.']
  office_website_url varchar [note: 'Public website URL for the recording office, providing access to fee schedules, accepted document formats, cover-sheet requirements, and online search portals.']
  office_zip_code varchar [note: 'USPS ZIP or ZIP+4 code for the recording office mailing address. Used for mail submission routing and courier delivery confirmation.']
  plant_coverage_available boolean [note: 'Indicates whether a title plant (DataTrace, TitlePoint, or county plant index) provides automated search coverage for this jurisdiction. Drives search channel selection in the title production system.']
  plant_provider_name varchar [note: 'Name of the title plant or automated search provider covering this jurisdiction (e.g., DataTrace, TitlePoint). Used for search order routing and vendor management.']
  recording_act_type varchar [note: 'Type of recording act governing priority of recorded instruments in this jurisdiction: race (first to record wins), notice (subsequent BFP without notice wins), or race_notice (both conditions required). Critical for chain-of-title analysis.']
  recording_office_name varchar [note: 'Official name of the county recorder, register of deeds, or equivalent recording authority (e.g., \'Travis County Clerk\', \'Cook County Recorder of Deeds\'). Used on cover sheets and submission routing.']
  recording_office_type varchar [note: 'Classification of the recording authority type, which varies by state (e.g., county_recorder in CA, register_of_deeds in MI, county_clerk in TX). Drives cover-sheet template and fee schedule selection.']
  recording_reference_format varchar [note: 'Format used by this jurisdiction to assign recording references to accepted instruments (e.g., book/page, instrument number, document number). Determines how recording_reference_number is parsed and stored.']
  rejection_rate_pct decimal(5,2) [note: 'Observed percentage of document submissions rejected by this jurisdiction, based on historical submission data. Used for recording rejection/resubmission rate metrics and operational risk monitoring.']
  ron_accepted boolean [note: 'Indicates whether this jurisdiction accepts documents notarized via Remote Online Notarization (RON). Drives closing channel eligibility and notarization workflow routing.']
  same_day_recording_cutoff_time timestamp [note: 'Local time (HH:MM, 24-hour) by which a document must be submitted to qualify for same-day recording in this jurisdiction. Critical for gap-period management and closing scheduling.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which this recording jurisdiction is located (e.g., TX, CA, FL). Used for state-level recording rule application and regulatory routing.']
  state_specific_notes varchar [note: 'Free-text field capturing jurisdiction-specific recording requirements, exceptions, or procedural notes not captured in structured fields (e.g., special deed tax stamps, unique cover sheet rules, holiday closures).']
  time_zone varchar [note: 'IANA time zone identifier for the recording office (e.g., \'America/Chicago\'). Used to calculate same-day recording cutoff times and gap-period timestamps accurately.']
  transfer_tax_basis varchar [note: 'Specifies the taxable basis for documentary transfer tax in this jurisdiction (e.g., full consideration, equity only, loan amount). Required for accurate transfer tax calculation on the settlement statement.']
  transfer_tax_rate decimal(10,6) [note: 'Documentary transfer tax rate applied to the consideration amount for deed recordings in this jurisdiction, expressed as a decimal (e.g., 0.001100 for $1.10 per $1,000). Used for settlement fee calculation.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master reference for every county recorder or register of deeds office that the business submits documents to. Captures FIPS county code, state, office name, recording office address, accepted submission channels (eRecording, mail, in-person), eRecording'
}

Table ti_recording.submission_status_history {
  submission_status_history_id varchar [pk, note: 'Unique surrogate identifier for each immutable status transition record in the recording submission lifecycle history. Primary key of this append-only event log.']
  gateway_transaction_id varchar [note: 'External transaction identifier assigned by the eRecording gateway for this specific status event or acknowledgment message, enabling reconciliation with gateway logs.']
  party_id varchar [note: 'Foreign key linking to operations.party. Business justification: Tracks which party (closer, examiner, agent, underwriter) initiated each submission status transition. Operational accountability and audit trail for recording workflow.']
  recording_submission_id varchar [note: 'Foreign key reference to the parent recording_submission record whose lifecycle this history row documents. Every history row belongs to exactly one submission.']
  submission_document_id varchar [note: 'Reference to the specific submission_document record associated with this status transition, linking the history event to the individual instrument being tracked.']
  title_order_id varchar [note: 'Reference to the originating title order that initiated the recording workflow, enabling end-to-end traceability from order intake through recording confirmation.']
  acceptance_date date [note: 'Date on which the county recorder or eRecording gateway formally accepted the submission for processing, distinct from the recording_date and submission_date per VREQ-008.']
  book_number varchar [note: 'Official book number assigned by the county recorder at recording, part of the book/page reference used in traditional deed indexing systems. Populated only upon confirmed recording.']
  county_acknowledgment_code varchar [note: 'Acknowledgment or confirmation code returned by the county recorder or eRecording gateway for this status event, used for reconciliation and dispute resolution with the recording authority.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county recorder or register of deeds jurisdiction where this recording submission status event applies. Supports jurisdiction-level reporting.']
  created_timestamp timestamp [note: 'Timestamp when this status history record was first written to the data store. Immutable audit field supporting append-only event log integrity and RECORD_AUDIT_CREATED requirement.']
  curative_action_description varchar [note: 'Description of the specific corrective action taken or required to resolve the rejection and enable resubmission, supporting curative aging and effectiveness tracking.']
  curative_action_required boolean [note: 'Indicates whether this rejection or status transition requires a curative action (document correction, fee adjustment, re-notarization) before resubmission can proceed.']
  curative_completed_date date [note: 'Date on which the curative action addressing a rejection was completed, enabling measurement of curative cycle time between rejection and resubmission readiness.']
  days_in_prior_status varchar [note: 'Number of calendar days the submission spent in status_from before transitioning to status_to. Supports title clearance cycle time and recording aging metrics per VREQ-016.']
  document_type varchar [note: 'Type of instrument being tracked in this status history event (e.g., Deed of Trust, Warranty Deed, Release). Supports document-type-level rejection rate analysis.']
  erecording_gateway varchar [note: 'The electronic recording gateway or channel through which this submission status event was transmitted or received (e.g., Simplifile, CSC eRecording). Supports gateway-level rejection rate analysis.']
  event_source varchar [note: 'System or actor that triggered this status transition. Identifies whether the change originated from the eRecording gateway, county recorder response, internal workflow, or manual override. Core EVENT_SOURCE_REFERENCE.']
  event_timestamp timestamp [note: 'Exact date and time (with timezone offset) when this status transition occurred, as recorded by the eRecording gateway or internal processing system. Core EVENT_TIMESTAMP for this log.']
  fee_correction_flag boolean [note: 'Indicates whether a recording fee correction was applied at this status transition, distinguishing fee-related rejections and corrections from other rejection types in root-cause analysis.']
  gap_close_date date [note: 'Date on which the GAP coverage period closed, typically upon confirmed recording. A null value indicates the gap remains open and the instrument is not yet confirmed recorded.']
  gap_coverage_active boolean [note: 'Indicates whether the GAP coverage period (between closing and confirmed recording) is active at the time of this status event, supporting gap-period risk monitoring.']
  gap_duration_days varchar [note: 'Number of calendar days the GAP coverage period was open as of this status event, calculated from gap_open_date. Supports gap-period aging and policy-issuance-lag-after-recording metrics.']
  gap_open_date date [note: 'Date on which the GAP coverage period opened (typically the closing/disbursement date), marking the start of the unrecorded instrument risk window for this submission.']
  initiated_by_role varchar [note: 'Business role of the actor who triggered this status transition, distinguishing automated gateway events from manual escrow officer or recording specialist actions for workflow analysis.']
  initiated_by_user varchar [note: 'Username or system account identifier of the person or automated process that triggered this status transition, supporting audit trail and accountability for manual overrides.']
  instrument_number varchar [note: 'Sequential instrument number assigned by the county recorder upon recording, used as the primary public index reference in jurisdictions that use instrument-number indexing rather than book/page.']
  is_resubmission boolean [note: 'Indicates whether this status transition represents a resubmission following a prior rejection, distinguishing initial submissions from corrective resubmissions in workflow analytics.']
  is_terminal_state boolean [note: 'Indicates whether status_to represents a terminal (final) state in the submission lifecycle (RECORDED or CANCELLED), enabling efficient filtering for open versus closed submissions.']
  notes varchar [note: 'Free-text notes entered by the recording specialist or system at the time of this status transition, capturing context not covered by structured fields (e.g., verbal county instructions).']
  page_number varchar [note: 'Official page number assigned by the county recorder at recording, completing the book/page reference. Populated only upon confirmed recording.']
  policy_issuance_lag_days varchar [note: 'Number of calendar days elapsed between the confirmed recording_date and the date a title policy was issued, as captured at this status event. Supports the policy-issuance-lag-after-recording metric per VREQ-016.']
  recording_date date [note: 'Official date on which the instrument was recorded by the county recorder, as confirmed at this status transition. Populated only when status_to = RECORDED. Distinct from submission_date and acceptance_date per VREQ-008.']
  recording_fee_amount decimal(12,2) [note: 'Recording fee amount (USD) applicable at this status transition, which may differ from the original submission if a fee correction was required to resolve a rejection.']
  recording_jurisdiction_name varchar [note: 'Human-readable name of the county recorder or register of deeds office (e.g., \'Cook County Recorder of Deeds\') associated with this status event, complementing the FIPS code.']
  recording_reference_number varchar [note: 'Official reference number assigned by the county recorder upon confirmed recording (e.g., instrument number, document number). Populated when status_to = RECORDED; null for pre-recording events.']
  rejection_category varchar [note: 'Normalized classification of the rejection cause, grouping raw rejection codes into analytical categories for rejection root-cause analysis and resubmission rate metrics.']
  rejection_reason_code varchar [note: 'Standardized code assigned by the county recorder or eRecording gateway identifying the specific reason for rejection at this transition (e.g., missing notary, incorrect fee, illegible document).']
  rejection_reason_description varchar [note: 'Free-text description of the rejection reason as returned by the county recorder or eRecording gateway, providing human-readable context for curative action and resubmission.']
  sla_breach_flag boolean [note: 'Indicates whether the time spent in the prior status exceeded the applicable SLA threshold for that status, supporting recording turnaround SLA compliance monitoring.']
  sla_threshold_days varchar [note: 'The SLA threshold in calendar days applicable to the prior status at the time of this transition, against which days_in_prior_status is evaluated for breach determination.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the recording jurisdiction, supporting state-level regulatory reporting and recording rejection rate metrics.']
  status_from varchar [note: 'The submission lifecycle status immediately before this transition. Enables full before/after audit trail. [ENUM-REF-CANDIDATE: DRAFT|SUBMITTED|PENDING_REVIEW|REJECTED|CORRECTED|RESUBMITTED|ACCEPTED|RECORDED|CANCELLED — promote to reference product]']
  status_to varchar [note: 'The submission lifecycle status entered as a result of this transition. Together with status_from, defines the complete state machine arc. [ENUM-REF-CANDIDATE: DRAFT|SUBMITTED|PENDING_REVIEW|REJECTED|CORRECTED|RESUBMITTED|ACCEPTED|RECORDED|CANCELLED —']
  submission_attempt_number varchar [note: 'Sequential count of the submission attempt associated with this status event (1 = initial, 2 = first resubmission, etc.). Supports recording rejection and resubmission rate metrics.']
  submission_date date [note: 'Date on which the recording package was submitted to the county recorder or eRecording gateway for this attempt, distinct from acceptance_date and recording_date per VREQ-008.']
  transition_type varchar [note: 'Categorical classification of the nature of this status change, distinguishing initial submissions from rejections, corrections, resubmissions, and final recording confirmations for workflow analytics.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Immutable lifecycle history table preserving every status transition for a recording_submission — from initial submission through any rejections, curative corrections, resubmissions, and final acceptance or recording confirmation.'
}

Table ti_recording.gateway_transaction {
  gateway_transaction_id varchar [pk, note: 'Unique surrogate identifier for each eRecording gateway transaction exchange record. Primary key for the gateway_transaction entity.']
  party_id varchar [note: 'Identifier of the title company user or system account that initiated the gateway submission. Supports audit trail and accountability for recording submissions.']
  prior_gateway_transaction_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding gateway transaction for the same recording_submission. Enables chain-of-resubmission traceability and lifecycle history preservation.']
  recording_submission_id varchar [note: 'Reference to the parent recording_submission that initiated this gateway transaction. Links the gateway exchange back to the title lifecycle recording event.']
  acknowledgment_code varchar [note: 'Gateway-issued acknowledgment code: ACK indicates the package was received and queued for county review; NACK indicates the package failed gateway pre-screen and was not forwarded.']
  acknowledgment_timestamp timestamp [note: 'Date and time the eRecording gateway issued an ACK (acknowledgment) or NACK (negative acknowledgment) confirming receipt of the submitted package.']
  closing_date date [note: 'Date the real estate transaction closed, establishing the start of the GAP coverage window. Distinct from submission_timestamp and recording_date per VREQ-008.']
  county_response_code varchar [note: 'Machine-readable response code returned by the county recorder system indicating acceptance, rejection, or return status. Format varies by jurisdiction.']
  county_response_message varchar [note: 'Free-text message returned by the county recorder describing the acceptance confirmation, rejection reason, or return instructions for this gateway transaction.']
  county_response_timestamp timestamp [note: 'Date and time the county recorder or register of deeds returned an acceptance, rejection, or return response to the gateway for this transaction.']
  created_timestamp timestamp [note: 'Date and time this gateway_transaction record was first created in the system of record. Audit timestamp distinct from the business event submission_timestamp.']
  document_count varchar [note: 'Number of individual documents included in the gateway submission package for this transaction. A single submission may contain a deed, deed of trust, and other instruments.']
  document_type_codes varchar [note: 'Comma-delimited list of document type codes included in the submission package (e.g., WD, DOT, RECONVEYANCE, RELEASE). Supports instrument-level recording analysis.']
  erecording_method varchar [note: 'Indicates whether the document was submitted electronically (eRecording), as a paper document, or via a hybrid method. Supports eRecording adoption tracking.']
  fee_payment_method varchar [note: 'Method used to remit the recording fee to the county recorder via the gateway (e.g., ACH, credit card, pre-funded gateway account, escrow account draw).']
  fee_payment_reference varchar [note: 'Transaction reference number or confirmation code for the recording fee payment submitted with this gateway transaction. Used for fee reconciliation and dispute resolution.']
  gap_coverage_days varchar [note: 'Number of calendar days elapsed between the closing date and the confirmed recording_date, representing the GAP coverage exposure window. Computed at recording confirmation; null while gap_period_open is true.']
  gap_period_open boolean [note: 'Indicates whether the GAP coverage period (between closing and confirmed recording) remains open for this transaction. True until recording_date is confirmed and provenance fed back to the policy.']
  gateway_account_code varchar [note: 'Account identifier assigned by the eRecording gateway vendor to the submitting organization. Used for gateway billing, fee reconciliation, and access control.']
  gateway_api_version varchar [note: 'Version of the eRecording gateway API used for this transaction. Tracks API compatibility and supports troubleshooting of format or protocol changes.']
  gateway_package_code varchar [note: 'Externally assigned package identifier issued by the eRecording gateway vendor (e.g., Simplifile package ID, CSC eRecording package number) for this submission bundle.']
  gateway_session_code varchar [note: 'Session or connection identifier assigned by the eRecording gateway for the API or portal session during which this transaction was submitted. Supports gateway audit and troubleshooting.']
  gateway_vendor varchar [note: 'Name of the eRecording gateway vendor used to transmit documents to the county recorder or register of deeds (e.g., Simplifile, CSC eRecording, ePN).']
  is_expedited boolean [note: 'Indicates whether this gateway transaction was flagged for expedited or priority recording processing at the county recorder. Used to track SLA performance for rush recordings.']
  jurisdiction_fips_code varchar [note: 'Five-digit FIPS code identifying the county or jurisdiction to which the document package was submitted for recording. Enables jurisdiction-level recording performance analysis.']
  jurisdiction_name varchar [note: 'Human-readable name of the county recorder or register of deeds office receiving the submission (e.g., \'Cook County Recorder of Deeds\'). Complements the FIPS code for display and reporting.']
  order_number varchar [note: 'Title production system order number associated with this gateway transaction. Provides cross-reference to the originating title order for end-to-end lifecycle traceability.']
  package_page_count varchar [note: 'Total number of pages across all documents in the gateway submission package. Used for recording fee calculation and county intake validation.']
  policy_issuance_lag_days varchar [note: 'Number of calendar days between the confirmed recording_date and the date the title policy was issued. Key metric per VREQ-016 for policy issuance lag after recording.']
  prescreen_failure_reason varchar [note: 'Textual description of the reason the gateway pre-screen failed, as returned by the gateway vendor. Null when prescreen_status is PASSED or BYPASSED.']
  prescreen_status varchar [note: 'Result of the gateway vendor pre-screen validation applied before forwarding to the county recorder. FAILED indicates a format, fee, or completeness error caught at the gateway level.']
  provenance_fed_back boolean [note: 'Indicates whether the confirmed recording reference number and recording_date have been fed back to the title policy and title lifecycle records. Supports evidence completeness and provenance tracking.']
  provenance_feedback_timestamp timestamp [note: 'Date and time the recording reference number and recording_date were successfully fed back to the title production system and policy records. Null until provenance_fed_back is true.']
  recording_date date [note: 'Official date the document was recorded by the county recorder, as stamped on the recorded instrument. Distinct from submission_timestamp. Drives GAP coverage window closure and policy issuance lag metrics.']
  recording_fee_amount decimal(12,2) [note: 'Total recording fee amount submitted to the county recorder with this gateway transaction, in US dollars. Includes per-page and per-document fees as applicable by jurisdiction.']
  recording_fee_currency varchar [note: 'ISO 4217 three-letter currency code for the recording fee amount. Typically USD for domestic US title transactions.']
  recording_reference_number varchar [note: 'Official recording reference number assigned by the county recorder upon acceptance, including book and page or instrument number. Null until county acceptance is confirmed.']
  recording_timestamp timestamp [note: 'Precise date and time the document was officially recorded by the county recorder, including time-of-day where available. Supports GAP period calculation at minute-level precision.']
  rejection_reason_code varchar [note: 'Standardized code categorizing the reason for county rejection (e.g., insufficient fee, missing notary, incorrect legal description). Drives rejection root-cause analysis. [ENUM-REF-CANDIDATE: promote to reference product]']
  rejection_reason_description varchar [note: 'Human-readable description of the county rejection reason, supplementing the rejection_reason_code with narrative detail for curative action and resubmission planning.']
  resubmission_attempt_number varchar [note: 'Sequential count of resubmission attempts for the parent recording_submission. Value is 0 for the initial submission and increments by 1 for each subsequent resubmission. Supports resubmission rate metrics.']
  sla_actual_hours decimal(6,2) [note: 'Actual elapsed hours from submission_timestamp to county_response_timestamp for this transaction. Compared against sla_target_hours to assess recording cycle time performance.']
  sla_target_hours decimal(6,2) [note: 'Service level agreement target turnaround time in hours from submission to county acceptance for this transaction, based on jurisdiction and transaction type.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the jurisdiction where the document is being recorded. Used for state-level regulatory reporting and recording fee schedules.']
  submission_timestamp timestamp [note: 'Date and time the document package was transmitted outbound to the eRecording gateway. Principal business event timestamp for this transaction. Used to measure recording cycle time.']
  submitter_organization varchar [note: 'Name of the title company, branch, or independent agent organization that submitted the gateway transaction. Relevant for agency channel recording oversight.']
  transaction_status varchar [note: 'Current lifecycle status of this gateway transaction as reported by the eRecording gateway or county recorder. Drives recording rejection and resubmission rate metrics.']
  transaction_type varchar [note: 'Classifies the nature of the gateway exchange: initial submission, resubmission after rejection, withdrawal, status inquiry, or rejection response. [ENUM-REF-CANDIDATE: promote if values expand]']
  updated_timestamp timestamp [note: 'Date and time this gateway_transaction record was last modified, such as when a county response was received or provenance was fed back. Supports lifecycle history preservation per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Transactional SSOT for each eRecording gateway exchange (Simplifile, CSC eRecording, ePN) associated with a recording_submission. Captures the gateway package identifier, gateway vendor, outbound submission acknowledgment (ACK/NACK), gateway pre-screen'
}

Table ti_agency.agent_authority {
  agent_authority_id varchar [pk, note: 'Unique surrogate identifier for the effective-dated agent authority record. Primary key for the agent_authority product in the Agency Management and Remittance System.']
  agency_agreement_id varchar [note: 'Reference to the parent agency agreement under which this authority level is granted. Links authority record to the governing contractual relationship between agent and underwriter.']
  agent_profile_id varchar [note: 'Reference to the independent title agent party record. Identifies the licensed agent entity to whom this underwriting authority is granted.']
  prior_authority_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding authority record that this record supersedes. Enables chain-of-authority history and lifecycle revision tracking per VREQ-007.']
  agent_premium_split_pct decimal(5,4) [note: 'Contractual percentage of gross title insurance premium retained by the agent (the \'split\') under this authority agreement. Expressed as a decimal (e.g., 0.7000 = 70%). Confidential commercial term.']
  approval_date date [note: 'Date on which the underwriter formally approved this authority grant. Distinct from effective_date — approval may precede the authority\'s effective start date.']
  approval_status varchar [note: 'Underwriter approval workflow status for this authority grant. Distinct from authority_status — captures the internal approval lifecycle before the authority becomes active.']
  approved_by varchar [note: 'Name or identifier of the underwriter representative who approved this authority grant. Provides audit trail for authority approval decisions.']
  authority_notes varchar [note: 'Free-text field for underwriter-recorded conditions, restrictions, or special instructions associated with this authority grant not captured in structured fields.']
  authority_number varchar [note: 'Externally-known alphanumeric identifier assigned by the underwriter to this specific authority grant. Used in policy jackets, CPL issuance, and remittance reconciliation as the SSOT reference code.']
  authority_status varchar [note: 'Current lifecycle state of this authority record. Controls whether the agent may issue policies under this authority grant. Drives compliance monitoring and oversight workflows.']
  authority_tier varchar [note: 'Classification of the underwriting authority level granted to the agent. Determines the scope of transactions the agent may independently underwrite without referral.']
  channel_type varchar [note: 'Distribution channel classification for this authority record. Distinguishes independent title agents from direct branch operations and centralized lender channel partners.']
  commercial_max_insured_amount decimal(18,2) [note: 'Maximum insured amount for commercial real estate transactions specifically. May differ from max_insured_amount which applies to residential. Null if commercial transactions are not authorized.']
  county_fips_code varchar [note: 'Five-digit FIPS county code further restricting the geographic scope of this authority to a specific county or set of counties. Null if authority applies statewide.']
  cpl_authority_flag boolean [note: 'Indicates whether the agent is authorized to issue Closing Protection Letters (CPLs) under this authority grant. CPL issuance requires explicit underwriter authorization separate from policy issuance authority.']
  created_timestamp timestamp [note: 'Timestamp when this authority record was first created in the Agency Management and Remittance System. Audit trail for record provenance per SOC 2 and ALTA Best Practices.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable to the max_insured_amount and premium split thresholds. Typically USD for domestic US title transactions.']
  effective_date date [note: 'Date on which this authority grant becomes binding and the agent is authorized to issue policies under its terms. Start of the effective-dated authority period per VREQ-008.']
  endorsement_authority_flag boolean [note: 'Indicates whether the agent is authorized to issue ALTA endorsements (e.g., ALTA 9, ALTA 8.1, ALTA 22) independently without underwriter countersignature under this authority grant.']
  eo_coverage_amount decimal(18,2) [note: 'Dollar amount of E&O insurance coverage in force for the agent at the time this authority was granted. Must meet underwriter minimum requirements for the authority tier.']
  eo_expiration_date date [note: 'Expiration date of the agent\'s E&O insurance policy. Monitoring this date against authority_status supports ongoing compliance oversight and lapse detection.']
  eo_policy_number varchar [note: 'Policy number of the agent\'s Errors and Omissions (E&O) insurance policy verified at the time this authority was granted. Required by underwriters as a condition of agency appointment.']
  escrow_authority_flag boolean [note: 'Indicates whether the agent is authorized to conduct escrow and settlement services (hold IOLTA/trust funds, disburse proceeds) under this authority grant.']
  expiration_date date [note: 'Date on which this authority grant expires and the agent\'s authorization to issue policies under its terms ends. Null indicates an open-ended authority subject to agreement termination.']
  gap_coverage_authority_flag boolean [note: 'Indicates whether the agent is authorized to provide gap coverage (GAP) — insuring the period between closing and recording — under this authority grant without underwriter countersignature.']
  license_expiration_date date [note: 'Expiration date of the agent\'s state title insurance license. Authority cannot remain active beyond license expiration. Supports compliance monitoring and oversight workflows.']
  license_number varchar [note: 'State-issued title insurance agent or title company license number verified at the time this authority was granted. Required for regulatory compliance in the applicable state jurisdiction.']
  max_insured_amount decimal(18,2) [note: 'Maximum single-transaction insured amount (in USD) the agent is authorized to underwrite independently under this authority tier without escalating to the underwriter for approval.']
  oversight_review_date date [note: 'Date of the most recent underwriter oversight review or audit of the agent\'s compliance with this authority. Supports ongoing agency oversight and compliance monitoring workflows.']
  oversight_review_result varchar [note: 'Outcome of the most recent underwriter oversight review of the agent under this authority. Drives escalation, suspension, or remediation workflows per ALTA Best Practices Pillar 6.']
  policy_type_scope varchar [note: 'Specifies whether the agent is authorized to issue owner title policies (OTP), lender title policies (LTP), or both under this authority grant. Aligns with VREQ-010 owner/lender policy distinction.']
  remittance_due_day varchar [note: 'Day of the month (1–31) by which the agent must submit the remittance report and payment to the underwriter for the prior period. Used to calculate remittance timeliness and aging.']
  remittance_frequency varchar [note: 'Contractual frequency at which the agent must remit the underwriter\'s premium share. Drives agency remittance-timeliness metrics per VREQ-016.']
  revision_number varchar [note: 'Sequential revision counter for this authority record within the same agency agreement. Increments each time authority terms are amended. Supports lifecycle history per VREQ-007.']
  revision_reason varchar [note: 'Free-text explanation of why this authority record was created as a revision of the prior record (e.g., tier upgrade, max amount increase, geographic expansion, compliance correction).']
  state_code varchar [note: 'Two-letter US state code identifying the jurisdiction in which this authority is granted. Authority is state-specific due to state-level insurance licensing and regulatory requirements.']
  termination_date date [note: 'Date on which this authority was explicitly terminated prior to its scheduled expiration. Populated only when authority is revoked or cancelled mid-term. Distinct from expiration_date per lifecycle preservation (VREQ-007).']
  termination_reason varchar [note: 'Reason code explaining why this authority was terminated before its scheduled expiration. Supports oversight reporting and regulatory compliance. [ENUM-REF-CANDIDATE: promote if reasons expand beyond 6]']
  transaction_type_scope varchar [note: 'Defines which transaction types the agent is authorized to handle under this authority. Restricts or expands the agent\'s operational scope. [ENUM-REF-CANDIDATE: promote if transaction types expand]']
  underwriter_code varchar [note: 'Reference to the title underwriter (carrier) granting this authority. Identifies which underwriting company has authorized the agent to issue policies on its behalf.']
  underwriter_premium_split_pct decimal(5,4) [note: 'Contractual percentage of gross title insurance premium remitted to the underwriter (the underwriter\'s share of the split). Must sum to 1.0 with agent_premium_split_pct. Confidential commercial term.']
  updated_timestamp timestamp [note: 'Timestamp when this authority record was last modified in the Agency Management and Remittance System. Supports change detection and audit trail for lifecycle transitions per VREQ-007.']
  uwref_threshold_amount decimal(18,2) [note: 'Transaction insured amount above which the agent must refer the transaction to the underwriter for approval before issuing a commitment or policy. Supports underwriting referral rate metrics per VREQ-016.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Effective-dated authority record defining the specific underwriting authority level granted to an independent title agent under an agency agreement, including authority tier (standard, limited, expanded, commercial), maximum insured amount, transaction'
}

Table ti_agency.agent_license {
  agent_license_id varchar [pk, note: 'Unique surrogate identifier for each effective-dated agent license record in the agency management system.']
  agent_profile_id varchar [note: 'Reference to the agent entity (individual producer or agency firm) that holds this license. Supports one agent holding multiple licenses across states.']
  appointing_underwriter_code varchar [note: 'Reference to the title underwriter entity that holds the active appointment for this license with the state DOI. An agent may be appointed by multiple underwriters.']
  appointment_date date [note: 'Date on which the appointing underwriter filed the agent appointment with the state DOI for this license. Required for authority validation.']
  appointment_termination_date date [note: 'Date on which the underwriter appointment for this license was terminated with the state DOI. Null if appointment is currently active.']
  authority_hold_flag boolean [note: 'Indicates whether this license is currently subject to an authority hold that prevents the agent from issuing commitments or policies under this license.']
  authority_hold_reason varchar [note: 'Free-text description of the reason an authority hold has been placed on this license (e.g., expired E&O, CE deficiency, DOI investigation). Null when no hold is active.']
  background_check_date date [note: 'Date on which the most recent background check was completed for the agent associated with this license. Drives re-screening schedule compliance.']
  background_check_status varchar [note: 'Status of the background check conducted on the agent in connection with this license. Required for ALTA Best Practices Pillar 3 onboarding compliance.']
  ce_compliance_status varchar [note: 'Current CE compliance status for this license\'s renewal cycle. Drives proactive outreach and authority hold workflows when deficient.']
  ce_credit_hours_completed decimal(5,2) [note: 'Number of continuing education credit hours completed by the agent toward the current renewal cycle requirement. Used for compliance gap monitoring.']
  ce_credit_hours_required decimal(5,2) [note: 'Number of continuing education credit hours required by the state for renewal of this license in the current renewal cycle.']
  continuing_education_required boolean [note: 'Indicates whether the state requires continuing education (CE) credits for renewal of this license. Drives CE compliance tracking workflows.']
  domicile_state_code varchar [note: 'Two-letter USPS code for the agent\'s home state of domicile. Used to distinguish resident from non-resident licenses and to apply reciprocity rules.']
  effective_date date [note: 'Date on which this license record version becomes effective. Supports effective-dated history when a license is renewed, reinstated, or reclassified.']
  eo_carrier_name varchar [note: 'Name of the insurance carrier providing the E&O coverage associated with this agent license. Used for coverage verification and oversight.']
  eo_coverage_amount decimal(18,2) [note: 'Dollar amount of E&O coverage in force for this agent license. Verified against minimum coverage thresholds required by the underwriter or state DOI.']
  eo_expiration_date date [note: 'Date on which the E&O insurance policy associated with this agent license expires. Triggers renewal verification workflow before expiration.']
  eo_policy_number varchar [note: 'Policy number of the Errors and Omissions (E&O) insurance policy covering this agent license. Required for ALTA Best Practices compliance verification.']
  eo_verified_date date [note: 'Date on which E&O coverage for this license was last verified by the agency oversight team. Supports ALTA Best Practices audit evidence.']
  expiration_date date [note: 'Date on which this license expires and must be renewed to remain in good standing. Used for proactive renewal tracking and authority suspension workflows.']
  issue_date date [note: 'Date on which the state DOI originally issued this license to the agent entity. Establishes the start of the license\'s initial effective period.']
  license_change_reason varchar [note: 'Reason code describing why this license record version was created or updated. Preserves material lifecycle transitions per VREQ-007. [ENUM-REF-CANDIDATE: initial_issuance|renewal|reinstatement|class_change|suspension|revocation|correction — 7 candidates']
  license_class varchar [note: 'Classification of the license type as defined by the issuing state DOI. Distinguishes title agent, title producer, escrow agent, settlement agent, and notary signing agent authorizations.']
  license_number varchar [note: 'State-issued title insurance producer or agent license number as assigned by the state Department of Insurance. Primary external business identifier for this license record.']
  license_revision_number varchar [note: 'Sequential revision counter incremented each time this license record is updated (renewal, reinstatement, class change). Supports lifecycle history per VREQ-007.']
  license_status varchar [note: 'Current lifecycle status of the license as reported by the issuing state DOI. Drives agent authority eligibility checks and oversight workflows.']
  license_type varchar [note: 'Indicates whether the license is held by an individual producer, a business entity (agency firm), or a branch office. Drives onboarding and authority workflows.']
  license_verification_source varchar [note: 'Source used to verify the license status (e.g., NIPR national producer database, state DOI portal, manual review). Supports evidence provenance per VREQ-007.']
  license_verified_date date [note: 'Date on which the license status was last verified against the authoritative source (NIPR or state DOI). Drives re-verification scheduling.']
  lines_of_authority varchar [note: 'Comma-delimited list of insurance lines of authority granted under this license (e.g., Title, Escrow, Settlement). Sourced from state DOI appointment records.']
  nipr_producer_number varchar [note: 'NIPR-assigned national producer number (NPN) for the agent, used to cross-reference license records across states in the NAIC national database.']
  prior_license_number varchar [note: 'Previous state-issued license number superseded by this record, if applicable. Preserves chain-of-license history for lifecycle traceability per VREQ-007.']
  record_created_timestamp timestamp [note: 'Timestamp when this agent license record was first created in the lakehouse silver layer. Supports audit trail and data lineage.']
  record_updated_timestamp timestamp [note: 'Timestamp when this agent license record was last modified in the lakehouse silver layer. Supports change detection and incremental processing.']
  regulatory_action_description varchar [note: 'Brief description of any active or historical regulatory action taken by the state DOI against this license. Null when no regulatory action exists.']
  regulatory_action_flag boolean [note: 'Indicates whether the state DOI has taken or initiated a regulatory action (investigation, consent order, fine) against this license. Triggers escalated oversight.']
  reinstatement_date date [note: 'Date on which a previously suspended or expired license was reinstated by the state DOI. Null if the license has never been reinstated.']
  renewal_date date [note: 'Date on which the license was most recently renewed by the state DOI. Null if the license has never been renewed since original issuance.']
  resident_nonresident_flag boolean [note: 'Indicates whether this is a resident license (agent domiciled in the issuing state) or a non-resident license (agent licensed in a state other than domicile).']
  revocation_date date [note: 'Date on which the state DOI permanently revoked this license. Null if not revoked. Preserved for lifecycle history and regulatory reporting.']
  source_system_license_key varchar [note: 'Natural key or record identifier for this license as stored in the Agency Management and Remittance System (e.g., SoftPro, RamQuest). Supports lineage and reconciliation.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the issuing jurisdiction (e.g., TX, CA, FL). Human-readable complement to state_fips_code for reporting and display.']
  state_fips_code varchar [note: 'Two-digit FIPS code identifying the U.S. state or territory that issued this license. Used for jurisdiction-level compliance reporting and authority scoping.']
  suspension_date date [note: 'Date on which the state DOI suspended this license, if applicable. Null when license is not suspended. Supports lifecycle history per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Effective-dated record of each state-issued title insurance producer or agent license held by an agent entity, including license number, state FIPS code, license class, issue date, expiration date, renewal date, and current status (active, suspended'
}

Table ti_agency.agent_profile {
  agent_profile_id varchar [pk, note: 'Unique surrogate identifier for the agent profile record. Primary key for the agent_profile entity in the agency domain.']
  agency_agreement_number varchar [note: 'Unique identifier of the executed agency agreement between the independent title agent and the underwriter. Links to the agreement document in the Document Management System.']
  agent_code varchar [note: 'Unique alphanumeric code assigned by the underwriter to identify the agent in the Agency Management and Remittance System. Used on remittance reports, policy registers, and premium splits.']
  agent_premium_split_pct decimal(5,4) [note: 'Contractual percentage of collected title insurance premium retained by the agent per the agency agreement. The remainder is remitted to the underwriter. Expressed as a decimal (e.g., 0.8000 = 80%).']
  agent_status varchar [note: 'Current lifecycle status of the agent appointment with the underwriter. Controls whether the agent may issue commitments, policies, and CPLs. Drives oversight and compliance monitoring.']
  agent_type varchar [note: 'Legal entity structure of the agent (individual, corporation, LLC, partnership, or government entity). Determines tax reporting obligations, E&O requirements, and agency agreement terms.']
  alta_best_practices_certified boolean [note: 'Indicates whether the agent has obtained a current ALTA Best Practices certification from an approved third-party assessor. Required by many lender clients and underwriters for active status.']
  alta_certification_date date [note: 'Date the agent most recently received ALTA Best Practices certification. Used to track certification currency and trigger recertification workflows.']
  alta_certification_expiration_date date [note: 'Expiration date of the agents current ALTA Best Practices certification. Triggers recertification alerts and may affect agent authority level if expired.']
  appointment_effective_date date [note: 'Date the underwriter appointment became effective, authorizing the agent to issue title commitments and policies on behalf of the underwriter. Distinct from onboarding date.']
  appointment_expiration_date date [note: 'Date the current underwriter appointment expires or is scheduled for renewal. Null for perpetual appointments. Used to trigger renewal workflows and compliance alerts.']
  authority_level varchar [note: 'Underwriter-assigned authority level controlling the types and amounts of title commitments, policies, and CPLs the agent may issue without referral. Drives underwriting workflow routing.']
  channel_type varchar [note: 'Classifies the agent as an independent title agent (ITA), direct branch, centralized lender channel partner, or commercial channel. Drives routing, remittance, and oversight rules.']
  cpl_authority_flag boolean [note: 'Indicates whether the agent is authorized to issue Closing Protection Letters (CPLs) on behalf of the underwriter. CPL authority is separately granted and tracked per ALTA CPL standards.']
  created_timestamp timestamp [note: 'Timestamp when the agent profile record was first created in the Agency Management and Remittance System. Supports audit trail and record provenance per VREQ-007.']
  dba_name varchar [note: 'Trade or assumed name under which the agent operates, if different from the legal entity name. Required for marketing materials, closing documents, and consumer-facing disclosures.']
  eo_carrier_name varchar [note: 'Name of the insurance carrier providing the agents Errors and Omissions (E&O) professional liability coverage. Required by ALTA Best Practices and underwriter agency agreements.']
  eo_coverage_amount decimal(18,2) [note: 'Maximum coverage limit of the agents E&O policy in USD. Underwriter verifies this meets minimum thresholds per agency agreement and ALTA Best Practices Pillar 3 requirements.']
  eo_expiration_date date [note: 'Expiration date of the agents current E&O insurance policy. Triggers compliance alerts when approaching expiration. Agent authority may be suspended if E&O lapses.']
  eo_policy_number varchar [note: 'Policy number of the agents current E&O professional liability insurance policy. Required for underwriter oversight and ALTA Best Practices compliance verification.']
  escrow_account_verified_date date [note: 'Most recent date the underwriter verified the agents escrow/trust account compliance per ALTA Best Practices Pillar 2. Used for ongoing oversight and audit scheduling.']
  fidelity_bond_amount decimal(18,2) [note: 'Coverage amount of the agents fidelity bond or employee dishonesty insurance in USD. Required by many underwriters and state regulations to protect against employee theft of escrow funds.']
  fidelity_bond_expiration_date date [note: 'Expiration date of the agents fidelity bond or employee dishonesty coverage. Used to trigger renewal alerts and compliance monitoring.']
  fips_county_code varchar [note: 'Five-digit FIPS county code for the county in which the agents primary office is located. Used for geographic segmentation, county-level reporting, and plant access authorization.']
  iolta_account_flag boolean [note: 'Indicates whether the agent maintains a separate IOLTA or escrow trust account as required by ALTA Best Practices Pillar 2 and applicable state bar or insurance regulations.']
  last_audit_date date [note: 'Date of the most recent underwriter compliance audit or examination of the agent. Used to schedule next audit and track oversight cadence per ALTA Best Practices and agency agreement.']
  last_audit_result varchar [note: 'Outcome of the most recent underwriter compliance audit. Drives agent status changes, remediation workflows, and authority level adjustments.']
  last_updated_timestamp timestamp [note: 'Timestamp when the agent profile record was most recently modified. Supports change tracking, audit trail, and lifecycle history preservation per VREQ-007.']
  legal_entity_name varchar [note: 'Full legal name of the independent title agent, direct branch, or lender-channel partner as registered with the state and underwriter. Used for licensing, remittance, and policy issuance.']
  max_policy_liability_amount decimal(18,2) [note: 'Maximum single-transaction policy liability amount in USD the agent is authorized to issue without underwriter referral. Transactions exceeding this threshold require Underwriting Referral (UWR).']
  naic_company_code varchar [note: 'Five-digit NAIC company code assigned to the agent entity for regulatory reporting and state filing purposes. Required for NAIC annual statement submissions.']
  office_address_line1 varchar [note: 'Street address line 1 of the agents primary office location. Used for regulatory filings, policy documents, and consumer-facing disclosures.']
  office_address_line2 varchar [note: 'Street address line 2 (suite, unit, floor) of the agents primary office location. Supplemental to office_address_line1 for complete mailing address.']
  office_city varchar [note: 'City of the agents primary office location. Used for geographic segmentation, regulatory filings, and market analysis.']
  office_state varchar [note: 'Two-letter USPS state abbreviation for the agents primary office location. Determines applicable state insurance regulations, rate filings, and remittance rules.']
  office_zip_code varchar [note: 'ZIP or ZIP+4 postal code of the agents primary office location. Used for geographic analysis, regulatory filings, and market segmentation.']
  onboarding_date date [note: 'Date the agent completed onboarding and was approved to conduct business under the agency agreement. Marks the start of the agent relationship for remittance timeliness and oversight tracking.']
  operating_states varchar [note: 'Comma-delimited list of two-letter state abbreviations where the agent is licensed and authorized to conduct title insurance business. Drives multi-state authority and compliance monitoring.']
  primary_contact_email varchar [note: 'Business email address of the primary contact at the agent office. Used for underwriter communications, remittance notices, compliance alerts, and CPL issuance notifications.']
  primary_contact_name varchar [note: 'Full name of the primary business contact at the agent office responsible for underwriter communications, remittance, and compliance matters.']
  primary_contact_phone varchar [note: 'Business phone number of the primary contact at the agent office. Used for underwriter communications and compliance outreach.']
  primary_license_expiration_date date [note: 'Expiration date of the agents primary state title insurance license. Used to trigger renewal alerts and suspend authority if license lapses.']
  primary_license_state varchar [note: 'Two-letter USPS state abbreviation for the state in which the agent holds their primary title insurance license. Governs applicable regulatory requirements and remittance rules.']
  primary_state_license_number varchar [note: 'State-issued title insurance producer or agency license number for the agents primary state of operation. Required for appointment filings and regulatory compliance verification.']
  remittance_due_day varchar [note: 'Day of the month (1-31) by which the agent must submit premium remittance to the underwriter per the agency agreement. Used to calculate remittance timeliness metrics.']
  remittance_schedule_type varchar [note: 'Frequency at which the agent is required to remit collected title insurance premiums to the underwriter. Drives remittance timeliness monitoring and agency settlement processing.']
  tax_id_reference varchar [note: 'Tokenized reference to the agents Federal Tax Identification Number (TIN/EIN) stored in the Identity and NPPI Vault. Used for IRS 1099 reporting and premium remittance reconciliation. Raw TIN not stored here.']
  termination_date date [note: 'Date the agency relationship was formally terminated. Null for active agents. Required for lifecycle history preservation per VREQ-007 and regulatory reporting.']
  termination_reason varchar [note: 'Reason code for the termination of the agency relationship. Required for regulatory reporting to state departments of insurance and underwriter risk management.']
  underwriter_split_pct decimal(5,4) [note: 'Contractual percentage of collected title insurance premium remitted to the underwriter per the agency agreement. Should sum to 1.0000 with agent_premium_split_pct.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record and SSOT for every independent title agent (ITA), direct branch, and lender-channel partner in the distribution network. Captures agent identity, legal entity name, DBA, NAIC code, state license numbers, E&O carrier/policy references'
}

Table ti_agency.agreement {
  agreement_id varchar [pk, note: 'Unique surrogate identifier for the agency agreement record in the title insurance system of record.']
  agent_profile_id varchar [note: 'Reference to the independent title agent or direct-branch party that is a signatory to this agency agreement.']
  party_id varchar [note: 'Reference to the title underwriter (e.g., FNF, FAF, STC, ORI) that is the issuing underwriter party to this agency agreement.']
  prior_agreement_id varchar [note: 'Reference to the predecessor agency agreement record that this agreement supersedes or renews. Null for initial agreements. Preserves chain-of-agreement history per VREQ-007.']
  agent_premium_split_pct decimal(5,4) [note: 'Contractual percentage of gross title premium retained by the agent (e.g., 0.8000 = 80%). The underwriter retains the remainder. Drives remittance calculation.']
  aggregate_liability_limit decimal(18,2) [note: 'Maximum aggregate insured liability (in USD) the agent may carry in a rolling 12-month period before mandatory underwriter review. Supports risk-exposure monitoring.']
  agreement_status varchar [note: 'Current lifecycle state of the agency agreement. Controls whether the agent may issue commitments and policies under this agreement. [ENUM-REF-CANDIDATE: draft|active|suspended|terminated|expired|pending_renewal — promote to reference product]']
  agreement_type varchar [note: 'Classification of the agency relationship: independent agent, direct branch, centralized lender channel, or affiliated agency. Drives authority and remittance rules.']
  amendment_count varchar [note: 'Running count of formal amendments executed against this agency agreement. Supports lifecycle revision tracking per VREQ-007.']
  audit_frequency varchar [note: 'Contractual frequency at which the underwriter is entitled to conduct an agency audit of the agent\'s books, records, and escrow accounts under this agreement.']
  authority_level varchar [note: 'Scope of underwriting authority granted to the agent: full authority to issue all products, limited to specific transaction types, conditional on referral, or suspended.']
  auto_renewal_flag boolean [note: 'Indicates whether the agency agreement automatically renews at expiration unless either party provides notice of non-renewal within the notice period.']
  channel_type varchar [note: 'Distribution channel classification for this agreement: direct branch, independent agent, or centralized lender channel. Aligns with order-routing and premium-reporting segmentation.']
  commercial_authority_flag boolean [note: 'Indicates whether the agent is authorized to handle commercial real-estate transactions under this agreement. False restricts agent to residential transactions only.']
  cpl_authority_flag boolean [note: 'Indicates whether the agent is authorized to issue Closing Protection Letters (CPLs) under this agreement. True = CPL authority granted.']
  created_timestamp timestamp [note: 'Timestamp when this agency agreement record was first created in the Agency Management and Remittance System. Audit trail for record provenance.']
  current_version_number varchar [note: 'Version identifier of the current executed agreement document (e.g., \'1.0\', \'2.3\'). Incremented with each amendment. Supports revision history per VREQ-007.']
  document_reference_code varchar [note: 'Identifier of the executed agreement document in the Document Management and Imaging System. Enables retrieval of the signed agreement for audit and legal review.']
  effective_date date [note: 'Date on which the agency agreement becomes legally binding and the agent is authorized to issue title products. Distinct from execution date per VREQ-008.']
  endorsement_authority_flag boolean [note: 'Indicates whether the agent is authorized to issue ALTA endorsements (e.g., ALTA 9, ALTA 8.1, ALTA 22) without underwriter pre-approval under this agreement.']
  eo_carrier_name varchar [note: 'Name of the insurance carrier providing the agent\'s E&O coverage. Used for underwriter oversight and ALTA Best Practices Pillar 3 audit.']
  eo_coverage_amount decimal(18,2) [note: 'Minimum required E&O coverage amount (in USD) as stipulated in the agency agreement. Verified at onboarding and each renewal cycle.']
  eo_expiration_date date [note: 'Expiration date of the agent\'s current E&O insurance policy. Agreement may be suspended if E&O lapses. Drives compliance-monitoring alerts.']
  eo_policy_number varchar [note: 'Policy number of the agent\'s Errors and Omissions (E&O) insurance policy required under the agency agreement. Supports ALTA Best Practices Pillar 3 compliance verification.']
  escrow_authority_flag boolean [note: 'Indicates whether the agent is authorized to conduct escrow closings and hold trust funds under this agreement. Drives IOLTA compliance monitoring.']
  execution_date date [note: 'Date on which all parties physically or electronically signed the agency agreement. Distinct from effective date per VREQ-008.']
  expiration_date date [note: 'Date on which the agency agreement is scheduled to expire unless renewed. Null for perpetual agreements. Used for renewal-pipeline and compliance-monitoring metrics.']
  fidelity_bond_amount decimal(18,2) [note: 'Face amount (in USD) of the fidelity/surety bond held by the agent. Null if no bond is required under this agreement.']
  fidelity_bond_expiration_date date [note: 'Expiration date of the agent\'s fidelity bond. Null if no bond is required. Monitored alongside E&O expiration for compliance continuity.']
  fidelity_bond_number varchar [note: 'Bond number of the agent\'s fidelity/surety bond if required by the underwriter or state regulator as a condition of the agency agreement.']
  geographic_territory varchar [note: 'Description or code of the geographic territory (state(s), county FIPS codes, or MSA) within which the agent is authorized to issue title products under this agreement.']
  governing_law_state varchar [note: 'Two-letter US state code identifying the state whose laws govern interpretation and enforcement of this agency agreement.']
  last_audit_date date [note: 'Date of the most recently completed underwriter audit of this agent under this agreement. Used to calculate days-since-last-audit for oversight metrics.']
  max_liability_amount decimal(18,2) [note: 'Maximum insured amount (in USD) the agent is authorized to issue on a single title policy without underwriter referral. Enforces per-transaction authority ceiling.']
  next_audit_due_date date [note: 'Scheduled or calculated due date for the next underwriter audit of this agent. Derived from last_audit_date and audit_frequency but stored for operational scheduling.']
  notes varchar [note: 'Free-text field for underwriter or compliance officer notes regarding special conditions, waivers, or observations associated with this agency agreement.']
  notice_period_days varchar [note: 'Number of calendar days of written notice required by either party to terminate the agency agreement without cause, as specified in the agreement terms.']
  number varchar [note: 'Externally-known unique alphanumeric identifier assigned to this agency agreement by the underwriter, used in remittance and compliance correspondence.']
  oversight_risk_tier varchar [note: 'Underwriter-assigned risk tier for this agent based on volume, compliance history, and audit findings. Drives audit frequency and enhanced monitoring requirements.']
  remittance_due_days varchar [note: 'Number of calendar days after the close of the remittance period within which the agent must submit the remittance report and payment to the underwriter.']
  remittance_frequency varchar [note: 'Contractual frequency at which the agent must remit the underwriter\'s share of collected premiums. Drives remittance-timeliness metric and agency settlement schedule.']
  renewal_date date [note: 'Date on which the agency agreement was most recently renewed. Null if never renewed. Supports renewal-cycle tracking and remittance-timeliness metrics.']
  state_codes varchar [note: 'Comma-separated list of two-letter US state codes in which the agent is licensed and authorized to issue title products under this agreement (e.g., \'TX,OK,NM\').']
  termination_date date [note: 'Actual date on which the agency agreement was terminated prior to or at expiration. Null if agreement is still active or expired naturally.']
  termination_reason varchar [note: 'Reason code for agreement termination. Supports agency oversight reporting and regulatory compliance. [ENUM-REF-CANDIDATE: voluntary|non_renewal|compliance_violation|underwriter_action|license_lapse|eo_lapse|mutual_consent — promote to reference product]']
  transaction_types_authorized varchar [note: 'Comma-separated list of transaction types the agent may handle: purchase, refinance, HELOC, construction, commercial. Null means all types permitted per authority_level.']
  underwriter_premium_split_pct decimal(5,4) [note: 'Contractual percentage of gross title premium remitted to the underwriter (e.g., 0.2000 = 20%). Must sum to 1.0 with agent_premium_split_pct.']
  updated_timestamp timestamp [note: 'Timestamp when this agency agreement record was most recently modified. Used for change-data-capture and incremental lakehouse ingestion.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Formal agency agreement between the title underwriter and an independent title agent or direct branch, governing the scope of authority, geographic territory, transaction types, premium split schedule, remittance terms, and compliance obligations.'
}

Table ti_agency.eo_coverage {
  eo_coverage_id varchar [pk, note: 'Unique surrogate identifier for an E&O insurance coverage record associated with an independent title agent. Primary key for this entity.']
  agency_agreement_id varchar [note: 'Reference to the agency agreement under which this E&O coverage requirement applies. Links the coverage record to the specific contractual authority relationship between agent and underwriter.']
  agent_profile_id varchar [note: 'Reference to the independent title agent entity for whom this E&O coverage record is maintained. Links coverage to the agent profile in the Agency Management System.']
  additional_insured_flag boolean [note: 'Indicates whether the underwriter or title company is listed as an additional insured on the agent\'s E&O policy. Some underwriter agency agreements require additional insured status.']
  aggregate_limit decimal(18,2) [note: 'Maximum total dollar amount the E&O policy will pay across all covered claims during the policy period. Used to assess overall coverage adequacy relative to agent transaction volume.']
  cancellation_date date [note: 'Date on which the E&O policy was cancelled by the carrier or agent, if applicable. Null for active or expired policies. Triggers immediate agent authority review and potential suspension.']
  cancellation_reason varchar [note: 'Reason code for policy cancellation when coverage_status is cancelled. Used to assess whether cancellation was voluntary or involuntary and to inform agent risk classification.']
  carrier_naic_code varchar [note: 'Five-digit NAIC company code assigned to the E&O carrier. Enables regulatory lookup of carrier licensing, financial ratings, and admitted status by state.']
  carrier_name varchar [note: 'Legal name of the insurance carrier underwriting the E&O policy. Used to assess carrier financial strength and validate coverage acceptability per underwriter requirements.']
  certificate_holder_name varchar [note: 'Name of the certificate holder listed on the E&O certificate of insurance, typically the underwriter or title company requiring proof of coverage from the independent agent.']
  certificate_number varchar [note: 'Number from the ACORD certificate of insurance or equivalent document provided as evidence of E&O coverage. Used to cross-reference the physical or electronic certificate on file.']
  coverage_gap_days varchar [note: 'Number of calendar days of lapsed E&O coverage between the prior policy expiration and the current policy effective date. Zero or null when no gap exists. Used for risk scoring.']
  coverage_gap_flag boolean [note: 'Indicates whether a gap in continuous E&O coverage exists between the prior policy expiration and the current policy effective date. A gap may expose the agent and underwriter to uninsured risk.']
  coverage_status varchar [note: 'Current lifecycle status of the E&O coverage record. Drives agent authority eligibility; an agent with non-active status may be suspended from issuing commitments or policies.']
  coverage_type varchar [note: 'Indicates whether the E&O policy is written on a claims-made, occurrence, or claims-made-and-reported basis. Affects how claims are triggered and reported under the policy.']
  created_timestamp timestamp [note: 'Timestamp when this E&O coverage record was first created in the Agency Management and Remittance System. Supports audit trail and record provenance per VREQ-007.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary limit and deductible amounts on this E&O coverage record. Typically USD for domestic title agents.']
  days_until_expiration varchar [note: 'Number of calendar days remaining until the E&O policy expires, calculated from the current date. Used for aging and expiration-risk dashboards in agency oversight reporting.']
  deductible_amount decimal(18,2) [note: 'Dollar amount the agent is responsible for paying per claim before E&O coverage applies. Relevant to underwriter risk assessment and agent financial responsibility evaluation.']
  document_reference_code varchar [note: 'Identifier referencing the stored certificate of insurance or policy document in the Document Management and Imaging System. Enables retrieval of the source evidence for audit purposes.']
  effective_date date [note: 'Date on which the E&O policy coverage begins. Used to determine whether coverage was in force at the time of a specific title transaction or claim event.']
  expiration_date date [note: 'Date on which the E&O policy coverage expires. Triggers renewal workflow and agent authority suspension if not renewed prior to expiration.']
  extended_reporting_end_date date [note: 'End date of the extended reporting period (tail coverage) if applicable. Null when no ERP endorsement is in effect. Used to determine whether late-reported claims remain eligible.']
  extended_reporting_period_flag boolean [note: 'Indicates whether an extended reporting period (tail coverage) endorsement is in effect, allowing claims to be reported after policy expiration for acts occurring during the policy period.']
  meets_minimum_requirements boolean [note: 'Computed flag indicating whether the current E&O coverage meets all underwriter-mandated minimum requirements for per-occurrence limit, aggregate limit, and policy status. Drives authority eligibility.']
  minimum_required_aggregate decimal(18,2) [note: 'Underwriter-mandated minimum aggregate coverage limit required for this agent\'s authority level. Used to flag coverage deficiency when actual aggregate limit falls below threshold.']
  minimum_required_per_occurrence decimal(18,2) [note: 'Underwriter-mandated minimum per-occurrence coverage limit required for this agent\'s authority level. Used to flag coverage deficiency when actual per-occurrence limit falls below threshold.']
  named_insured varchar [note: 'Legal name of the entity or individual listed as the named insured on the E&O policy. Must match the agent entity name on file to confirm coverage applies to the correct party.']
  notes varchar [note: 'Free-text field for agency oversight staff to record observations, exceptions, or follow-up actions related to this E&O coverage record. Not used for structured data.']
  per_occurrence_limit decimal(18,2) [note: 'Maximum dollar amount the E&O policy will pay for a single covered claim or occurrence. Compared against underwriter minimum coverage thresholds for agent authority approval.']
  policy_number varchar [note: 'The carrier-assigned policy number for the E&O insurance policy. Used as the primary external business identifier for the coverage record and referenced during agent oversight audits.']
  prior_policy_number varchar [note: 'Policy number of the immediately preceding E&O policy for this agent. Supports chain-of-coverage analysis and retroactive date continuity verification for claims-made policies.']
  renewal_reminder_date date [note: 'Date on which the renewal reminder notification was sent to the agent. Null if no reminder has been sent. Used to track compliance outreach timing relative to expiration date.']
  renewal_reminder_sent_flag boolean [note: 'Indicates whether a renewal reminder notification has been sent to the agent prior to policy expiration. Supports proactive compliance management and prevents inadvertent coverage lapses.']
  retroactive_date date [note: 'For claims-made policies, the earliest date from which covered acts or omissions are eligible for coverage. Critical for determining whether prior title work is covered under the current policy.']
  source_record_code varchar [note: 'Native identifier of this E&O coverage record in the originating source system. Used for reconciliation between the lakehouse Silver layer and the upstream Agency Management System.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this E&O coverage record originated, such as the Agency Management and Remittance System or CRM. Supports data lineage tracking.']
  state_code varchar [note: 'Two-letter USPS state code for the state in which the E&O policy is primarily applicable or where the agent is licensed. Some states impose minimum E&O requirements by regulation.']
  state_minimum_required_flag boolean [note: 'Indicates whether the state in which the agent operates mandates a minimum E&O coverage level by regulation. Used to distinguish regulatory minimums from underwriter contractual minimums.']
  updated_timestamp timestamp [note: 'Timestamp when this E&O coverage record was most recently modified. Used to detect stale records and to sequence updates during incremental data loads to the Silver layer.']
  verification_date date [note: 'Date on which the E&O coverage was most recently verified as active and compliant by the agency oversight team. Used to track verification currency and schedule re-verification.']
  verification_method varchar [note: 'Method used to verify the E&O coverage, such as review of a certificate of insurance, direct carrier confirmation, or third-party database lookup. Affects verification reliability scoring.']
  verification_status varchar [note: 'Status of the internal verification process confirming the E&O policy is valid, in force, and meets underwriter minimum requirements. Drives agent onboarding and ongoing compliance workflows.']
  verified_by varchar [note: 'Name or identifier of the staff member or automated process that performed the most recent E&O coverage verification. Supports audit trail for agency compliance oversight.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Errors and Omissions (E&O) insurance coverage record for an independent title agent, capturing carrier name, policy number, coverage effective date, expiration date, per-occurrence limit, aggregate limit, deductible, and verification status.'
}

Table ti_agency.premium_split_schedule {
  premium_split_schedule_id varchar [pk, note: 'Unique surrogate identifier for a premium split schedule record defining contractual agent/underwriter split rates for an agency agreement.']
  agency_agreement_id varchar [note: 'Reference to the agency agreement under which this premium split schedule is defined. Links the split schedule to the governing contractual relationship.']
  agent_profile_id varchar [note: 'Reference to the independent title agent or agency entity to which this split schedule applies. Supports agent-level remittance and oversight reporting.']
  party_id varchar [note: 'Reference to the title underwriter (e.g., FNF, FAF, STC, ORI) that is the counterparty to the agent in this split arrangement.']
  superseded_by_schedule_premium_split_schedule_id varchar [note: 'Reference to the newer premium_split_schedule record that replaced this one. Null if this is the current active schedule. Preserves revision history per VREQ-007.']
  agent_split_rate decimal(7,6) [note: 'Contractual proportion of gross premium retained by the independent title agent, expressed as a decimal (e.g., 0.800000 = 80%). Core metric for remittance-timeliness analysis.']
  approval_date date [note: 'Date on which this split schedule received final internal approval. Distinct from effective_date; a schedule may be approved before it becomes effective.']
  approval_status varchar [note: 'Internal workflow approval status of this split schedule before it becomes operative. Tracks underwriting and compliance sign-off on negotiated split terms.']
  approved_by varchar [note: 'Name or identifier of the underwriter authority or compliance officer who approved this split schedule. Supports audit trail and SOX controls.']
  channel_type varchar [note: 'Distribution channel to which this split schedule applies: independent agent, direct branch, or centralized lender channel. Supports channel-level remittance analytics.']
  cpl_fee_split_rate decimal(7,6) [note: 'Agent\'s contractual split rate applied to Closing Protection Letter (CPL) fees collected. Distinct from policy premium split rates.']
  created_timestamp timestamp [note: 'Timestamp when this premium split schedule record was first created in the data platform. Supports audit trail and record provenance.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this schedule. Typically USD for US domestic title operations.']
  effective_date date [note: 'Date on which this premium split schedule becomes contractually binding and applicable to new policy transactions. Supports effective-dated rate lookup.']
  endorsement_split_rate decimal(7,6) [note: 'Agent\'s contractual split rate applied specifically to ALTA endorsement premiums (e.g., ALTA 9, ALTA 8.1, ALTA 22). May differ from base policy split rate.']
  expiration_date date [note: 'Date on which this premium split schedule ceases to apply. Null indicates an open-ended schedule with no defined end date.']
  is_tiered_schedule boolean [note: 'Indicates whether this schedule is one tier within a multi-tier split structure. True when premium_floor_amount and premium_ceiling_amount define a band.']
  minimum_agent_remittance_amount decimal(15,2) [note: 'Minimum dollar amount the agent must remit to the underwriter per remittance cycle, regardless of split calculation. Null if no minimum applies.']
  notes varchar [note: 'Free-text operational notes or special conditions associated with this split schedule, such as volume incentive clauses or underwriter-specific exceptions.']
  policy_type varchar [note: 'Indicates whether this split schedule applies to the Owner\'s Title Policy (OTP), Lender\'s Title Policy (LTP), or both. Owner and lender policies carry distinct split rates per VREQ-010.']
  premium_ceiling_amount decimal(15,2) [note: 'Maximum gross premium threshold above which this split schedule no longer applies. Null indicates no upper bound. Supports tiered split structures.']
  premium_floor_amount decimal(15,2) [note: 'Minimum gross premium threshold below which this split schedule applies. Supports tiered split structures where rates change at premium breakpoints.']
  property_type_scope varchar [note: 'Indicates whether this split schedule applies to residential, commercial, or both property types. Commercial transactions may carry different negotiated split rates.']
  rate_source varchar [note: 'Indicates whether the split rates are derived from state-filed rates, individually negotiated contract terms, or a statutory minimum/maximum rate schedule.']
  reissue_credit_applies boolean [note: 'Indicates whether reissue/refinance credit discounts are factored into the premium base before applying the split rates under this schedule.']
  remittance_due_days varchar [note: 'Number of calendar days after the close of the remittance period by which the agent must submit payment to the underwriter. Used for timeliness monitoring.']
  remittance_frequency varchar [note: 'Contractual frequency at which the agent must remit the underwriter\'s share of collected premiums. Drives remittance-timeliness metric calculations.']
  revision_number varchar [note: 'Sequential revision counter for this split schedule within the agency agreement. Version 1 is the original; increments with each amendment. Supports lifecycle history per VREQ-007.']
  revision_reason varchar [note: 'Free-text explanation for why this split schedule was created or amended (e.g., state rate filing change, contract renegotiation, regulatory directive).']
  schedule_name varchar [note: 'Human-readable name or label for this split schedule (e.g., \'Residential Standard 80/20 — TX 2024\'). Aids identification in the agency management system.']
  schedule_number varchar [note: 'Externally-known alphanumeric identifier for this split schedule, as referenced in the agency agreement and remittance system. Used for audit and reconciliation.']
  schedule_status varchar [note: 'Current lifecycle status of the split schedule. \'superseded\' indicates a newer schedule has replaced this one; \'terminated\' indicates the agreement ended.']
  simultaneous_issue_rate_applies boolean [note: 'Indicates whether the simultaneous issue (owner + lender issued together) discounted premium rate applies as the basis for split calculation under this schedule.']
  source_record_code varchar [note: 'Native primary key or record identifier from the originating source system. Enables lineage tracing and reconciliation back to the agency management system.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this split schedule record was sourced (e.g., agency management and remittance system identifier).']
  split_basis varchar [note: 'Defines the premium base on which the split rates are applied: gross collected premium, net premium after deductions, or the state-filed statutory rate.']
  state_code varchar [note: 'Two-letter US state postal code identifying the jurisdiction in which this split schedule applies. Split rates are state-regulated and vary by state.']
  supersedes_schedule_id varchar [note: 'Reference to the prior premium_split_schedule record that this schedule replaced. Null if this is the original schedule. Supports chain-of-revision traceability.']
  termination_date date [note: 'Date on which this split schedule was formally terminated, if applicable. Distinct from expiration_date; termination may occur before the scheduled expiry.']
  termination_reason varchar [note: 'Reason for early termination of this split schedule (e.g., agency agreement cancelled, agent license revoked, underwriter withdrawal from state).']
  tier_sequence varchar [note: 'Ordinal position of this tier within a tiered split schedule (1 = lowest premium band). Null for non-tiered schedules. Used to apply the correct rate band.']
  transaction_type varchar [note: 'Category of real estate transaction to which this split rate applies (e.g., residential purchase, REFI, HELOC, construction, commercial). Rates may differ by transaction type.']
  underwriter_split_rate decimal(7,6) [note: 'Contractual proportion of gross premium remitted to the underwriter, expressed as a decimal (e.g., 0.200000 = 20%). Must sum to 1.0 with agent_split_rate.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this premium split schedule record. Used for change detection and incremental data loading in the Silver layer.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Reference (non-transactional) schedule defining contractual agent/underwriter premium split rates for an agency agreement, segmented by transaction type (residential purchase, refinance, HELOC, commercial), policy type (owner OTP vs lender LTP), state'
}

Table ti_agency.cpl_issuance {
  cpl_issuance_id varchar [pk, note: 'Unique surrogate identifier for a Closing Protection Letter (CPL) issuance record in the agency management system.']
  agency_agreement_id varchar [note: 'Reference to the agency agreement under which the independent agent is authorized to conduct closings covered by this CPL.']
  agent_profile_id varchar [note: 'Reference to the independent title agent on whose behalf the CPL is issued by the underwriter, as registered in the agency management system.']
  cpl_insured_lender_party_id varchar [note: 'Reference to the lender or institutional party named as the insured on this CPL, typically the mortgage lender funding the transaction.']
  cpl_party_id varchar [note: 'Reference to the title underwriter entity (e.g., FNF, FAF, STC, ORI) that issued and is liable under this CPL.']
  insured_ownership_interest_id varchar [note: 'Foreign key linking to property.ownership_interest. Business justification: CPL is issued at closing when ownership interest transfers. Links CPL to the specific ownership interest being insured (buyer\'s new interest or lender\'s lien).']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: CPL documents must reference the legal description that defines the insured property. Legal description is the authoritative definition of what the CPL covers.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: CPL (Closing Protection Letter) is issued for a specific property parcel. Currently cpl_issuance has denormalized property address fields but no FK to the authoritative property.parcel.']
  superseded_by_cpl_cpl_issuance_id varchar [note: 'Self-referencing identifier pointing to the replacement CPL issuance record when this CPL has been superseded by a revised or corrected version.']
  title_order_id varchar [note: 'Reference to the title order for which this CPL was issued, linking the CPL to the underlying transaction in the title production system.']
  actual_closing_date date [note: 'Date on which the real estate closing actually occurred under this CPL. Null if closing has not yet taken place.']
  agent_license_number varchar [note: 'State-issued title insurance agent license number for the independent agent at time of CPL issuance, confirming active licensure.']
  agent_name varchar [note: 'Legal business name of the independent title agent on whose behalf the CPL is issued, as it appears on the CPL document.']
  agent_state_code varchar [note: 'Two-letter USPS state code for the state in which the agent is licensed and appointed to issue this CPL.']
  cancellation_date date [note: 'Date on which the CPL was cancelled prior to expiration, if applicable. Null when the CPL was not cancelled.']
  cancellation_reason varchar [note: 'Reason code explaining why the CPL was cancelled. [ENUM-REF-CANDIDATE: transaction_cancelled|policy_issued|superseded|agent_request|underwriter_request|other — promote to reference product]']
  claim_made_indicator boolean [note: 'Indicates whether a claim has been made against this CPL by the insured lender, triggering claims administration workflow.']
  closing_location varchar [note: 'Address or description of the location where the closing is scheduled to occur, as referenced in the CPL.']
  closing_officer_name varchar [note: 'Name of the closing or escrow officer at the agent office who will conduct the closing covered by this CPL.']
  cpl_fee_amount decimal(18,2) [note: 'Fee charged for issuance of this CPL, as filed with the applicable state Department of Insurance. May be zero in states where CPLs are issued at no charge.']
  cpl_fee_collected boolean [note: 'Indicates whether the CPL issuance fee has been collected from the insured lender or applicable party at time of issuance.']
  cpl_form_version varchar [note: 'Version identifier of the ALTA CPL form used for this issuance (e.g., ALTA 2016 CPL Form), ensuring regulatory and form-version traceability.']
  cpl_number varchar [note: 'Externally-known alphanumeric identifier assigned to this CPL by the underwriter or agency management system, used for tracking and reference across parties.']
  cpl_status varchar [note: 'Current lifecycle status of the CPL issuance record: draft, issued, cancelled, expired, or superseded by a revised CPL.']
  cpl_type varchar [note: 'Classifies the CPL by the party protected: lender, buyer, seller, or combined lender and buyer, per ALTA CPL form options.']
  created_timestamp timestamp [note: 'Date and time at which this CPL issuance record was first created in the system, used for audit trail and record provenance.']
  delivery_confirmation_ref varchar [note: 'Confirmation number, email message ID, or portal acknowledgment reference confirming successful delivery of the CPL to the insured lender.']
  delivery_method varchar [note: 'Method by which the CPL was delivered to the insured lender: email, fax, mail, lender portal, or electronic transmission.']
  delivery_timestamp timestamp [note: 'Date and time at which the CPL was transmitted or delivered to the insured lender, used for timeliness tracking and audit.']
  document_image_ref varchar [note: 'Reference key or URI to the signed CPL document image stored in the document management and imaging system for evidence and provenance.']
  effective_date date [note: 'Date on which CPL coverage becomes effective, which may differ from the issue date. Governs the start of underwriter liability under the letter.']
  eo_coverage_verified boolean [note: 'Indicates whether the agent\'s Errors and Omissions (E&O) insurance coverage was verified as active and sufficient at the time of CPL issuance.']
  eo_policy_number varchar [note: 'E&O insurance policy number for the independent agent at time of CPL issuance, confirming required coverage per ALTA Best Practices Pillar 3.']
  expiration_date date [note: 'Date on which the CPL coverage expires if the closing has not occurred. Null indicates the CPL remains open until cancelled or superseded.']
  insured_lender_address varchar [note: 'Full mailing address of the insured lender as stated on the CPL, used for delivery and regulatory record-keeping.']
  insured_lender_name varchar [note: 'Full legal name of the lender or institutional party named as the insured on the CPL, as it appears on the issued CPL document.']
  issue_date date [note: 'Calendar date on which the CPL was formally issued by the underwriter, representing the principal business event date for this record.']
  loan_amount decimal(18,2) [note: 'Dollar amount of the mortgage loan associated with this CPL, used to establish the scope of underwriter liability. Denominated in USD.']
  prior_cpl_id varchar [note: 'Reference to the prior CPL issuance record that this record supersedes, preserving the revision chain for lifecycle history per VREQ-007.']
  purchase_price decimal(18,2) [note: 'Contract purchase price of the subject property for purchase transactions, as stated on the CPL or associated sales contract. Null for refinance transactions.']
  revision_number varchar [note: 'Sequential integer tracking the revision version of this CPL within the same transaction, starting at 1 for the original issuance.']
  scheduled_closing_date date [note: 'Anticipated date of the real estate closing for which this CPL provides protection, used for expiration and pipeline management.']
  source_system_ref varchar [note: 'Identifier of the originating record in the agency management or title production system (e.g., SoftPro, RamQuest) for lineage and reconciliation.']
  state_specific_form_indicator boolean [note: 'Indicates whether a state-mandated or state-approved CPL form was used instead of the standard ALTA form, as required by certain state Departments of Insurance.']
  transaction_type varchar [note: 'Classification of the underlying real estate transaction type for which the CPL is issued: purchase, refinance, HELOC, construction, commercial, or home equity.']
  underwriter_name varchar [note: 'Legal name of the title underwriter issuing the CPL (e.g., Fidelity National Title, Stewart Title Guaranty), as it appears on the CPL document.']
  updated_timestamp timestamp [note: 'Date and time at which this CPL issuance record was most recently modified, supporting change tracking and audit compliance.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Closing Protection Letter (CPL) issuance record representing a specific CPL issued by the underwriter on behalf of an independent title agent for a given transaction or lender.'
}

Table ti_agency.oversight_review {
  oversight_review_id varchar [pk, note: 'Unique surrogate identifier for the oversight review record. Primary key for the agency compliance and performance review entity.']
  agency_agreement_id varchar [note: 'Reference to the agency agreement under which the agent operates, providing contractual context for the review scope and authority.']
  agent_profile_id varchar [note: 'Reference to the independent title agent or agency entity that is the subject of this oversight review.']
  prior_review_oversight_review_id varchar [note: 'Reference to the immediately preceding oversight review record for this agent, enabling review history chain and trend analysis.']
  title_order_id varchar [note: 'Foreign key linking to operations.title_order. Business justification: Oversight reviews sample specific order files to audit agent compliance, title examination quality, escrow handling, and closing procedures.']
  authority_action_taken varchar [note: 'Regulatory or contractual action taken against the agent\'s authority as a result of this review: none, warning, restriction, suspension, termination, or DOI referral.']
  completion_date date [note: 'Date on which all review activities, including agent response and finding resolution, were finalized and the review was closed.']
  corrective_action_due_date date [note: 'Deadline by which the agent must submit or complete the corrective action plan in response to findings from this review.']
  corrective_action_received_date date [note: 'Date on which the agent\'s corrective action plan or response was received by the underwriter oversight team.']
  corrective_action_required_flag boolean [note: 'Indicates whether the review findings require the agent to submit a formal corrective action plan (CAP) to address identified deficiencies.']
  corrective_action_status varchar [note: 'Current status of the corrective action plan: not_required, pending, received, accepted, rejected, or overdue. Tracks remediation lifecycle.']
  created_timestamp timestamp [note: 'Timestamp when this oversight review record was first created in the agency management system. Supports audit trail and record provenance.']
  critical_finding_flag boolean [note: 'Indicates whether the review identified at least one critical finding requiring immediate escalation, remediation, or potential authority suspension.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable to monetary amounts in this review record. Typically USD for domestic US title operations.']
  document_reference_code varchar [note: 'Reference to the document management system record containing the formal review report, supporting evidence, and agent correspondence.']
  eo_coverage_status varchar [note: 'Status of the agent\'s E&O coverage as determined during this review: current, expiring_soon, expired, below_minimum, or not_verified.']
  eo_verified_flag boolean [note: 'Indicates whether the agent\'s E&O insurance coverage was verified as current and meeting minimum requirements during this review.']
  escrow_audit_flag boolean [note: 'Indicates whether this review included an examination of the agent\'s escrow/trust account records for compliance with IOLTA and state trust accounting rules.']
  escrow_compliance_status varchar [note: 'Outcome of the escrow/trust account audit component: compliant, shortfall, overage, reconciliation_gap, or not_audited if escrow was not in scope.']
  files_sampled_count varchar [note: 'Number of title order files or transaction records selected for review during a random file review or annual audit. Supports sampling methodology documentation.']
  files_with_findings_count varchar [note: 'Number of sampled files in which one or more compliance findings or deficiencies were identified. Used to compute deficiency rate.']
  finding_categories varchar [note: 'Comma-separated list of finding category codes identified (e.g., remittance_late, eo_lapsed, escrow_shortfall, licensing_gap, file_deficiency). Supports trend analysis.']
  findings_summary varchar [note: 'Narrative summary of key findings identified during the review, including deficiencies, exceptions, and areas of non-compliance observed.']
  license_compliance_status varchar [note: 'Licensing compliance determination from this review: compliant, deficient (missing states), expired, suspended, or not_verified.']
  license_verified_flag boolean [note: 'Indicates whether the agent\'s title insurance license(s) were verified as active and in good standing in all applicable states during this review.']
  next_review_due_date date [note: 'Scheduled due date for the next oversight review of this agent, determined by risk tier, audit frequency in the agency agreement, and findings from this review.']
  overall_rating varchar [note: 'Composite compliance and performance rating assigned at the conclusion of the review: satisfactory, needs_improvement, unsatisfactory, or critical.']
  period_end_date date [note: 'End date of the business activity period under review. Together with period_start_date defines the audit window.']
  period_start_date date [note: 'Start date of the business activity period under review (e.g., the remittance period, file production period, or licensing period being audited).']
  regulatory_referral_date date [note: 'Date on which the regulatory referral was submitted to the state DOI or other authority. Populated only when regulatory_referral_flag is true.']
  regulatory_referral_flag boolean [note: 'Indicates whether findings from this review were referred to a state Department of Insurance or other regulatory body for further action.']
  remittance_audit_flag boolean [note: 'Indicates whether this review included an audit of the agent\'s premium remittance records and timeliness against the agency agreement schedule.']
  remittance_compliance_status varchar [note: 'Outcome of the remittance audit component: compliant, late_remittances, underpayment, overpayment, or not_audited if remittance was not in scope.']
  remittance_variance_amount decimal(18,2) [note: 'Dollar amount of identified remittance discrepancy (underpayment or overpayment) discovered during the remittance audit component of this review.']
  review_date date [note: 'The date on which the oversight review was conducted or initiated. Principal business event date for scheduling, aging, and timeliness metrics.']
  review_method varchar [note: 'Method by which the oversight review was conducted: on_site (at agent office), remote (virtual/electronic), desk_review (document submission only), or hybrid.']
  review_notes varchar [note: 'Free-text notes recorded by the reviewer capturing context, agent responses, mitigating circumstances, or follow-up actions not captured in structured fields.']
  review_number varchar [note: 'Externally visible, human-readable identifier assigned to this oversight review. Used in correspondence, audit trails, and regulatory submissions.']
  review_scope varchar [note: 'Narrative description of the scope of the review, including which files, periods, processes, or compliance areas were examined.']
  review_status varchar [note: 'Current lifecycle state of the oversight review: scheduled, in_progress, pending_response (awaiting agent reply), completed, cancelled, or escalated to underwriter compliance.']
  review_type varchar [note: 'Classification of the review: annual audit, random file review, E&O verification, licensing check, remittance audit, or for-cause review. [ENUM-REF-CANDIDATE']
  reviewer_department varchar [note: 'Organizational department or unit responsible for conducting the review (e.g., Agency Compliance, Underwriting Oversight, Internal Audit).']
  reviewer_employee_code varchar [note: 'Internal employee identifier of the reviewer conducting the oversight review. Links to HR/identity systems for access control and audit.']
  reviewer_name varchar [note: 'Full name of the underwriter compliance officer, auditor, or oversight analyst who conducted the review. Supports accountability and audit trail.']
  risk_tier_after varchar [note: 'Agent oversight risk tier classification assigned as a result of this review. Compared to risk_tier_before to track risk migration.']
  risk_tier_before varchar [note: 'Agent oversight risk tier classification assigned prior to this review. Used to measure risk tier migration resulting from review findings.']
  scheduled_date date [note: 'The originally planned date for the oversight review. Compared against review_date to measure scheduling adherence and overdue reviews.']
  state_code varchar [note: 'Two-letter US state code identifying the primary state jurisdiction under which this oversight review was conducted and findings apply.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this oversight review record. Used for change detection, incremental ETL, and audit trail.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Periodic compliance and performance oversight review record for an independent title agent, capturing review type (annual audit, random file review, E&O verification, licensing check, remittance audit), review date, reviewer identity, findings summary'
}

Table ti_agency.agent_remittance {
  agent_remittance_id varchar [pk, note: 'Unique surrogate identifier for the agent remittance header record. Primary key for the agency settlement cycle transaction.']
  agency_agreement_id varchar [note: 'Reference to the governing agency agreement under which this remittance is processed, establishing the contractual basis for the premium split.']
  agent_profile_id varchar [note: 'Reference to the independent title agent entity submitting or receiving this remittance. Links to the agent profile master record.']
  premium_split_schedule_id varchar [note: 'Reference to the premium split schedule that governs agent and underwriter share calculations applied to this remittance period.']
  prior_remittance_agent_remittance_id varchar [note: 'Reference to the previous remittance record that this corrected or supplemental remittance supersedes. Supports lifecycle revision history per VREQ-007.']
  acceptance_date date [note: 'Date the underwriter formally accepted and validated the remittance submission. Distinct from submission_date per VREQ-008 date separation requirements.']
  agent_retained_amount decimal(18,2) [note: 'Dollar amount of gross premium retained by the agent per the applicable premium split schedule. Equals gross premium multiplied by the agent split rate.']
  amount_received decimal(18,2) [note: 'Actual dollar amount received by the underwriter from the agent for this remittance. May differ from net_remittance_amount if partial payment or overpayment occurred.']
  channel_type varchar [note: 'Distribution channel through which the business was produced: independent agent, direct branch, or centralized lender channel. Supports channel-level remittance analytics.']
  cpl_fee_amount decimal(18,2) [note: 'Total Closing Protection Letter (CPL) fees collected by the agent during the remittance period, subject to the CPL fee split rate in the premium split schedule.']
  created_timestamp timestamp [note: 'System timestamp when this remittance record was first created in the agency management system. Supports audit trail and record provenance per VREQ-007.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this remittance record. Typically USD for domestic US title insurance transactions.']
  days_past_due varchar [note: 'Number of calendar days the remittance submission or payment is past the contractual due_date. Used for agency remittance timeliness metrics per VREQ-016.']
  due_date date [note: 'Contractual deadline by which the agent must submit and fund this remittance per the agency agreement remittance schedule terms.']
  endorsement_premium_amount decimal(18,2) [note: 'Total premium collected for ALTA endorsements (e.g., ALTA 9, ALTA 8.1, ALTA 22) issued during the remittance period, reported separately from base policy premium.']
  exception_flag boolean [note: 'Indicates this remittance has been flagged for manual review due to variance, missing policies, late submission, or other discrepancy requiring underwriter investigation.']
  exception_reason varchar [note: 'Free-text or coded description of the reason this remittance was flagged as an exception, such as variance, missing policy detail, or suspected fraud indicator.']
  gl_batch_reference varchar [note: 'Reference to the ERP/GL batch or journal entry number created when this remittance was posted to the general ledger for premium revenue recognition.']
  gross_premium_amount decimal(18,2) [note: 'Total gross title insurance premium collected by the agent for all policies in the remittance period before any splits, credits, or adjustments are applied.']
  is_late boolean [note: 'Indicates whether this remittance was submitted or funded after the contractual due date. True when submission_date or settlement_date exceeds due_date.']
  late_fee_amount decimal(18,2) [note: 'Contractual late fee assessed against the agent for failure to remit by the due date, per the agency agreement penalty terms.']
  ltp_count varchar [note: 'Number of Lender\'s Title Policies (LTP) included in this remittance period. Supports owner-versus-lender policy coverage analytics per VREQ-016.']
  net_remittance_amount decimal(18,2) [note: 'Final net amount due to the underwriter after applying all credits, adjustments, and split calculations. This is the amount the agent must fund to settle the remittance.']
  notes varchar [note: 'Free-text operational notes entered by the underwriter or agency oversight team regarding this remittance, such as dispute details, follow-up actions, or audit observations.']
  otp_count varchar [note: 'Number of Owner\'s Title Policies (OTP) included in this remittance period. Supports owner-versus-lender policy coverage analytics per VREQ-016.']
  payment_method varchar [note: 'Method by which the agent funded the remittance to the underwriter (e.g., wire transfer, ACH, check). Relevant for reconciliation and fraud controls.']
  payment_reference varchar [note: 'Bank or payment system reference number (wire confirmation, ACH trace number, check number) associated with the funds transfer for this remittance settlement.']
  period_end_date date [note: 'Last calendar date of the remittance reporting period. Defines the inclusive end of the policy issuance window covered by this remittance batch.']
  period_start_date date [note: 'First calendar date of the remittance reporting period. Defines the inclusive start of the policy issuance window covered by this remittance batch.']
  policy_count varchar [note: 'Total number of title insurance policies (owner and lender combined) included in this remittance period. Used for frequency and volume analytics.']
  reconciliation_date date [note: 'Date on which the remittance was fully reconciled against the underwriter\'s policy registry and general ledger. Null if reconciliation is not yet complete.']
  reconciliation_status varchar [note: 'Current reconciliation state of the remittance against the underwriter\'s policy registry and GL. Drives escrow receipt-disbursement reconciliation metrics per VREQ-016.']
  reissue_credit_amount decimal(18,2) [note: 'Total reissue credit adjustments applied to the gross premium in this remittance period, reducing the remittable premium where prior policies qualify for reissue rates.']
  remittance_frequency varchar [note: 'Contractual frequency at which the agent is required to submit remittances per the agency agreement. Drives due-date calculation and timeliness monitoring.']
  remittance_number varchar [note: 'Externally visible, human-readable identifier assigned to this remittance batch by the agency management system. Used for reconciliation and audit trail.']
  remittance_status varchar [note: 'Current lifecycle state of the remittance record. Drives workflow routing and aging metrics for agency remittance timeliness reporting. [ENUM-REF-CANDIDATE: draft|submitted|under_review|accepted|rejected|settled|voided — promote to reference product]']
  remittance_type varchar [note: 'Classification of the remittance submission: periodic (scheduled cycle), supplemental (out-of-cycle), corrected (amendment to prior), final (contract close-out), or advance.']
  revision_number varchar [note: 'Sequential revision counter for corrected or amended remittance submissions. Version 1 is the original; increments with each correction per lifecycle history requirements.']
  revision_reason varchar [note: 'Business justification for a corrected or amended remittance submission, such as policy count correction, premium recalculation, or split rate adjustment.']
  settlement_date date [note: 'Date on which funds were actually transferred and the remittance was financially settled between the agent and the underwriter.']
  simultaneous_issue_credit_amount decimal(18,2) [note: 'Total simultaneous issue rate credits applied when owner and lender policies are issued concurrently, reducing the combined premium in this remittance period.']
  state_code varchar [note: 'Two-letter USPS state code identifying the primary state jurisdiction for this remittance. Determines applicable state DOI remittance rules and rate filings.']
  submission_date date [note: 'Calendar date on which the agent formally submitted this remittance to the underwriter. Used to calculate remittance timeliness against contractual due dates.']
  transaction_type_scope varchar [note: 'Primary real estate transaction type(s) covered by this remittance period (e.g., purchase, refinance, HELOC). Supports transaction-mix analytics and rate-filing compliance.']
  underwriter_code varchar [note: 'Reference to the title underwriter entity receiving the remittance. Supports multi-underwriter agency relationships and underwriter-level remittance analytics.']
  underwriter_due_amount decimal(18,2) [note: 'Dollar amount of gross premium owed to the underwriter per the premium split schedule. Equals gross premium minus agent retained amount before adjustments.']
  updated_timestamp timestamp [note: 'System timestamp of the most recent modification to this remittance record. Used for change detection, audit, and incremental data pipeline processing.']
  variance_amount decimal(18,2) [note: 'Difference between net_remittance_amount and amount_received. Positive value indicates underpayment; negative indicates overpayment. Drives exception and follow-up workflows.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Transactional header record for a periodic premium remittance submitted by (or billed to) an independent title agent to the underwriter, representing the agency-settlement cycle.'
}

Table ti_agency.remittance_line {
  remittance_line_id varchar [pk, note: 'Unique surrogate identifier for a single remittance line record within an agent premium remittance batch. Primary key for the remittance_line entity.']
  agency_agreement_id varchar [note: 'Reference to the agency agreement under which this remittance line is processed. Establishes the contractual authority for the agent/underwriter relationship.']
  agent_profile_id varchar [note: 'Reference to the independent title agent submitting this remittance line. Supports agent-level remittance timeliness and split reconciliation reporting.']
  agent_remittance_id varchar [note: 'Foreign key reference to the parent agent_remittance header record. Links this line to the remittance batch submitted by the independent agent to the underwriter.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Remittance lines report premium on policies covering specific parcels. Parcel is the fundamental unit of title insurance; linking enables premium reconciliation by jurisdiction']
  premium_split_schedule_id varchar [note: 'Reference to the premium_split_schedule governing the agent/underwriter split rates applied to this line. Ensures split calculation is traceable to the approved schedule.']
  property_id varchar [note: 'Foreign key linking to property.property. Business justification: Remittance lines track premium by property transaction. Essential for reconciling premium to title orders, analyzing revenue by property type/transaction type, detecting duplicate']
  title_order_id varchar [note: 'Reference to the title order associated with this remittance line. Enables traceability from premium remittance back to the originating title order.']
  title_policy_id varchar [note: 'Reference to the issued title policy (owner or lender) for which premium is being remitted. Core link for policy-level remittance reconciliation.']
  accepted_date date [note: 'Date the underwriter formally accepted this remittance line as correct and complete. Marks the completion of the remittance reconciliation lifecycle for this line. Distinct from submission date.']
  adjustment_amount decimal(18,2) [note: 'Dollar amount of any post-submission adjustment applied to this remittance line (e.g., correction for rate error, credit memo, or dispute resolution). Negative values indicate credits.']
  adjustment_reason varchar [note: 'Reason code for any adjustment applied to this remittance line. Required when adjustment_amount is non-zero. Supports audit trail and dispute resolution workflows.']
  agent_premium_share decimal(18,2) [note: 'Computed dollar amount retained by the agent: net_premium_amount multiplied by agent_split_rate. Represents the agent\'s earned commission on this policy line.']
  agent_split_rate decimal(7,6) [note: 'Decimal rate representing the agent\'s share of net premium per the applicable premium_split_schedule (e.g., 0.800000 = 80%). Captured at line level for audit and dispute resolution.']
  channel_type varchar [note: 'Distribution channel through which the underlying title order and policy were originated. Supports channel-level remittance analytics and split schedule applicability validation.']
  closing_date date [note: 'Date the real estate transaction closed. Anchors the remittance timeliness calculation; remittance due date is typically computed relative to closing date per the agency agreement.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) county code for the property location. Supports county-level remittance analysis and regulatory reporting.']
  cpl_fee_amount decimal(18,2) [note: 'Fee charged for the Closing Protection Letter (CPL) associated with this transaction, if applicable. Subject to its own split rate per the premium_split_schedule.']
  cpl_underwriter_share decimal(18,2) [note: 'Underwriter\'s share of the CPL fee computed using the CPL fee split rate from the premium_split_schedule. Included in total underwriter remittance for this line.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this line. Defaults to USD for domestic US title transactions. Required for multi-currency compliance.']
  days_past_due varchar [note: 'Number of calendar days between remittance_due_date and remittance_submitted_date. Positive values indicate late remittance; zero or negative indicates on-time or early submission.']
  endorsement_premium_amount decimal(18,2) [note: 'Total premium charged for all ALTA endorsements attached to this policy (e.g., ALTA 9, ALTA 8.1, ALTA 22). Tracked separately from base policy premium for endorsement revenue analysis.']
  endorsement_underwriter_share decimal(18,2) [note: 'Underwriter\'s share of endorsement premium computed using the endorsement split rate from the premium_split_schedule. Included in total underwriter remittance for this line.']
  gl_account_code varchar [note: 'General ledger account code to which the underwriter premium share for this line is posted in the ERP/GL system. Supports premium revenue recognition and financial reconciliation.']
  gross_premium_amount decimal(18,2) [note: 'Total gross title insurance premium charged to the insured for this policy before any reissue credit, simultaneous issue discount, or split allocation. Basis for split calculation.']
  insured_amount decimal(18,2) [note: 'The face amount of insurance coverage provided by this policy (purchase price for OTP, loan amount for LTP). Used to validate premium calculation against filed rate tables.']
  is_late_remittance boolean [note: 'Indicates whether this remittance line was submitted after the contractual remittance due date. True when remittance_submitted_date exceeds remittance_due_date. Drives timeliness compliance reporting.']
  is_reissue_credit_applied boolean [note: 'Indicates whether a reissue credit was applied to reduce the gross premium on this line. When true, reissue_credit_amount must be populated and greater than zero.']
  is_simultaneous_issue boolean [note: 'Indicates whether this policy line is part of a simultaneous owner/lender policy issuance on the same transaction. Affects premium calculation and split schedule applicability.']
  line_sequence varchar [note: 'Sequential line number within the parent remittance batch, starting at 1. Used for ordering, display, and reconciliation of individual policy lines within a remittance.']
  line_status varchar [note: 'Current processing status of this remittance line. Drives reconciliation workflow: pending=awaiting underwriter acceptance; accepted=confirmed; rejected=disputed; adjusted=corrected; reversed=backed out; voided=cancelled.']
  net_premium_amount decimal(18,2) [note: 'Net title insurance premium after deducting reissue credit and simultaneous issue credit from gross premium. This is the base amount to which the agent/underwriter split rates are applied.']
  notes varchar [note: 'Free-text notes or comments entered by the agent or underwriter regarding this remittance line. Used for exception documentation, dispute context, or manual override explanations.']
  policy_effective_date date [note: 'Date the title policy became effective (typically the closing/recording date). Used to determine the applicable rate filing period and remittance due date calculation.']
  policy_issue_date date [note: 'Date the title policy was formally issued by the agent. Distinct from effective date; used to measure policy issuance lag and remittance timeliness from issuance.']
  policy_number varchar [note: 'The externally-known title policy number (e.g., OTP or LTP policy number) for which premium is being remitted. Denormalized for reconciliation without requiring a policy join.']
  policy_type varchar [note: 'Type of title insurance policy or coverage instrument being remitted. OTP (Owner\'s Title Policy), LTP (Lender\'s Title Policy), CPL (Closing Protection Letter), or endorsement premium.']
  prior_policy_number varchar [note: 'Policy number of the prior title policy used as the basis for a reissue credit calculation. Required when is_reissue_credit_applied is true for audit and rate compliance verification.']
  rate_filing_reference varchar [note: 'Reference to the state-filed rate schedule used to calculate the gross premium for this line (e.g., state filing number or rate manual version). Supports regulatory audit and rate compliance.']
  reissue_credit_amount decimal(18,2) [note: 'Dollar amount of reissue credit applied to reduce the gross premium when a prior policy exists on the same property. Reduces the net premium base subject to split.']
  rejection_reason varchar [note: 'Reason provided by the underwriter when this remittance line is rejected or disputed (e.g., incorrect split rate, missing policy number, rate calculation error). Populated when line_status is rejected.']
  remittance_due_date date [note: 'Date by which the underwriter share for this line must be remitted per the agency agreement remittance schedule. Key date for remittance timeliness metric calculation.']
  remittance_submitted_date date [note: 'Actual date this remittance line was submitted to the underwriter as part of the agent remittance batch. Used to compute days-late for remittance timeliness reporting.']
  simultaneous_issue_credit_amount decimal(18,2) [note: 'Dollar credit applied when owner and lender policies are issued simultaneously on the same transaction. Reduces the lesser policy premium per ALTA simultaneous issue rate rules.']
  source_system_line_ref varchar [note: 'Native line identifier from the Agency Management and Remittance System (e.g., SoftPro, RamQuest) that originated this remittance line. Enables traceability back to the system of record.']
  split_basis varchar [note: 'Basis on which the agent/underwriter premium split is calculated for this line: net_premium (after credits), gross_premium (before credits), or flat_fee. Sourced from the premium_split_schedule.']
  state_code varchar [note: 'Two-letter US state code for the property jurisdiction where the policy was issued. Determines applicable state rate filing, split schedule, and regulatory remittance requirements.']
  total_underwriter_remittance decimal(18,2) [note: 'Total amount due to the underwriter for this line: sum of underwriter_premium_share, endorsement_underwriter_share, and cpl_underwriter_share. The controlling remittance amount for this line.']
  transaction_type varchar [note: 'Real estate transaction type underlying the policy being remitted. Supports segmentation of remittance analytics by transaction category (purchase, REFI, HELOC, construction, commercial).']
  underwriter_code varchar [note: 'Reference to the title underwriter (e.g., FNF, FAF, STC, ORI) receiving the remittance for this line. Required for multi-underwriter agent scenarios and underwriter-level settlement reporting.']
  underwriter_premium_share decimal(18,2) [note: 'Computed dollar amount due to the underwriter: net_premium_amount multiplied by underwriter_split_rate. This is the amount being remitted to the underwriter for this line.']
  underwriter_split_rate decimal(7,6) [note: 'Decimal rate representing the underwriter\'s share of net premium per the applicable premium_split_schedule (e.g., 0.200000 = 20%). Must sum to 1.0 with agent_split_rate.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Line-level detail of an agent_remittance, one row per policy/transaction premium being remitted. Captures source policy or order reference, policy type (owner/lender), gross premium, applied premium_split_schedule rate, computed underwriter share'
}

Table ti_claim.title_claim {
  title_claim_id varchar [pk, note: 'Unique surrogate identifier for each title insurance claim record. Primary key for the title_claim entity in the Claims Administration System.']
  agent_profile_id varchar [note: 'Reference to the independent title agent entity if the underlying policy was issued through an independent agent channel. Null for direct-branch or lender-channel policies.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Claims often hinge on legal description gaps, metes-and-bounds errors, or Schedule A variances.']
  property_id varchar [note: 'Reference to the property entity representing the real property subject to the insured title. Links the claim to the property information domain for location and parcel context.']
  title_assigned_counsel_party_id varchar [note: 'Reference to the party record for outside or in-house legal counsel assigned to defend or prosecute matters related to this claim.']
  title_claimant_party_id varchar [note: 'Reference to the party entity representing the insured claimant (owner or lender) who filed the claim. Supports party-role contextual modeling.']
  title_commitment_id varchar [note: 'Foreign key linking to underwriting.title_commitment. Business justification: Claims investigation and coverage analysis routinely retrieve the commitment to compare Schedule B exceptions, requirements, and insurable title determination against the']
  title_order_id varchar [note: 'Reference to the originating title order associated with the insured transaction. Enables traceability from claim back to the original title production workflow.']
  title_party_id varchar [note: 'Reference to the internal party or employee record for the claims examiner assigned to investigate and manage this claim through resolution.']
  title_policy_id varchar [note: 'Reference to the issued Owner\'s Title Policy (OTP) or Lender\'s Title Policy (LTP) against which this claim is filed. Links claim to the insuring policy.']
  underwriting_title_examination_id varchar [note: 'Foreign key linking to underwriting.underwriting_title_examination. Business justification: Claims investigation reviews the original examination to determine if the defect was missed, improperly cleared, or outside the examination scope.']
  case_reserve_amount decimal(18,2) [note: 'Current actuarially-set case reserve representing the estimated ultimate indemnity liability for this specific open claim. Updated as investigation progresses.']
  chain_of_title_break_flag boolean [note: 'Indicates whether the claim involves a break or gap in the chain of title (COT) as identified during examination or investigation. Key metric for title clearance quality analysis.']
  claim_number varchar [note: 'Externally-known alphanumeric identifier assigned to the claim at FNOL intake. Used in all correspondence, regulatory reporting, and system-of-record references.']
  claim_status varchar [note: 'Current lifecycle state of the claim. Drives workflow routing, reserve management, and regulatory reporting. [ENUM-REF-CANDIDATE: open|under_investigation|reserved|settled|closed|denied|reopened — promote to reference product]']
  claim_type varchar [note: 'Classification of the title risk cause giving rise to the claim (e.g., title defect, lien, encumbrance, encroachment, forgery, fraud, survey, access, CC&R).']
  claimed_loss_amount decimal(18,2) [note: 'Gross dollar amount of loss asserted by the claimant at FNOL intake. May differ from the ultimately reserved or paid amount after investigation.']
  closure_date date [note: 'Date the claim was formally closed in the Claims Administration System. Reserves are released upon closure. Used for claim lifecycle duration and aging analysis.']
  closure_reason varchar [note: 'Reason the claim was closed, distinguishing between indemnity payment, curative resolution, coverage denial, claimant withdrawal, or no-coverage determination.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county where the insured property is located. Used for geographic loss analysis and county recorder jurisdiction identification.']
  coverage_analysis_outcome varchar [note: 'Result of the underwriter\'s coverage analysis determining whether the claimed loss falls within the policy\'s insuring provisions. Drives reserve setting and payment authorization.']
  coverage_denial_reason varchar [note: 'Explanation of why coverage was denied or limited, referencing the specific policy exclusion, Schedule B exception, or condition. Populated when coverage_analysis_outcome is denied or partially_covered.']
  created_timestamp timestamp [note: 'Timestamp when the claim record was first created in the Claims Administration System. Audit field for record provenance and data lineage tracking.']
  curative_action_description varchar [note: 'Narrative describing the curative steps taken to resolve the title defect or adverse matter underlying the claim (e.g., lien release, quiet title action, corrective deed).']
  curative_resolution_flag boolean [note: 'Indicates whether the claim was resolved through curative action (e.g., obtaining a release, reconveyance, or corrective deed) rather than monetary indemnity payment.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this claim record. Defaults to USD for domestic US title insurance transactions.']
  expense_reserve_amount decimal(18,2) [note: 'Reserve set aside for allocated loss adjustment expenses (ALAE) including legal fees, curative costs, and investigation expenses associated with this claim.']
  fnol_date date [note: 'Date the insured first notified the company of the claim event. The principal business event date for claim intake; distinct from investigation and payment dates.']
  fnol_received_timestamp timestamp [note: 'Precise timestamp when the FNOL was received and logged in the Claims Administration System. Used for SLA measurement and regulatory timeliness reporting.']
  gap_coverage_flag boolean [note: 'Indicates whether the claim involves a loss arising during the gap period between the effective date of the commitment and the recording of the insured instrument.']
  insured_amount decimal(18,2) [note: 'The face amount of insurance coverage under the policy at the time of the claim, representing the maximum indemnity exposure. Sourced from the policy\'s Schedule A.']
  investigation_close_date date [note: 'Date the claim investigation was formally concluded and findings documented. Marks transition to coverage determination and reserve finalization.']
  investigation_start_date date [note: 'Date the formal claim investigation was initiated by the assigned examiner. Used to measure investigation cycle time and regulatory timeliness compliance.']
  investigation_status varchar [note: 'Current state of the claim investigation workflow. Tracks whether the examiner has begun, completed, or paused the factual and legal review of the claimed loss.']
  litigation_flag boolean [note: 'Indicates whether the claim has resulted in or is subject to active litigation. Triggers legal hold requirements and escalated reserve review.']
  loss_date date [note: 'Date the insured title loss or adverse claim event actually occurred or was discovered. May differ from FNOL date; used for IBNR analysis and loss cause dating.']
  loss_description varchar [note: 'Narrative description of the title defect, lien, encumbrance, or other adverse matter giving rise to the claim. Captures the factual basis of the insured\'s loss.']
  policy_type varchar [note: 'Indicates whether the claim is filed against an Owner\'s Title Policy (OTP) or a Lender\'s/Loan Title Policy (LTP). Required for owner-versus-lender coverage analysis per VREQ-010.']
  producing_channel varchar [note: 'The business channel through which the underlying title order and policy were produced. Supports loss ratio and frequency analysis by channel (direct, lender, independent agent).']
  recovery_amount decimal(18,2) [note: 'Total amounts recovered through subrogation, salvage, or other recovery actions against responsible third parties. Reduces net loss for loss ratio calculation.']
  regulatory_report_flag boolean [note: 'Indicates whether this claim has been included in a regulatory loss report submitted to the NAIC or a state Department of Insurance. Supports compliance audit trail.']
  reopen_count varchar [note: 'Number of times this claim has been reopened after a prior closure. Supports lifecycle history preservation per VREQ-007 and identifies complex or recurring loss events.']
  reserve_last_updated_date date [note: 'Date the case reserve or expense reserve was most recently reviewed and updated by the examiner or actuary. Supports reserve aging and adequacy monitoring.']
  settlement_date date [note: 'Date on which the claim was formally settled and the settlement agreement executed between the insurer and the claimant. Distinct from payment disbursement date.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the jurisdiction where the insured property is located. Drives state-specific regulatory reporting to Departments of Insurance.']
  subrogation_flag boolean [note: 'Indicates whether subrogation rights have been asserted against a responsible third party following indemnity payment. Triggers recovery tracking workflow.']
  subrogation_status varchar [note: 'Current state of subrogation or recovery action against a responsible third party. Supports recovery tracking and net loss reporting per NAIC requirements.']
  title_risk_cause_code varchar [note: 'Standardized code classifying the root cause of the title risk (e.g., forgery, undisclosed heir, survey error, lien not released). Used for NAIC loss cause reporting and frequency/severity by cause.']
  total_paid_expense_amount decimal(18,2) [note: 'Cumulative allocated loss adjustment expense (ALAE) payments made to date for this claim, including legal, curative, and investigation costs.']
  total_paid_indemnity_amount decimal(18,2) [note: 'Cumulative indemnity loss payments made to the claimant to date. Represents the sum of all indemnity disbursements; used for loss ratio and severity analysis.']
  transaction_type varchar [note: 'Type of real estate transaction underlying the insured policy (purchase, refinance, HELOC, construction, commercial). Supports frequency and severity segmentation by transaction type.']
  updated_timestamp timestamp [note: 'Timestamp when the claim record was most recently modified in the Claims Administration System. Supports change detection, audit, and incremental data loading.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for every title-insurance claim filed against an issued OTP or LTP. Captures FNOL intake details, claim type (title defect, lien, encumbrance, encroachment, forgery, fraud, survey, access, etc.), coverage analysis outcome, policy linkage'
}

Table ti_claim.event {
  event_id varchar [pk, note: 'Unique surrogate identifier for each immutable lifecycle event record in the claim event log. Primary key of the claim_event product.']
  agent_profile_id varchar [note: 'Reference to the independent title agent party record if the policy was issued through an independent agent channel. Null for direct-branch or centralized-lender production.']
  event_claimant_party_id varchar [note: 'Reference to the party record for the claimant (insured owner or lender) asserting the title insurance claim at this event. Supports contextual party role modeling per VREQ-006.']
  event_party_id varchar [note: 'Reference to the internal staff party record for the claims examiner or adjuster assigned to handle this claim at the time of the event. Tracks assignment changes.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Claim events track title defects and reserve changes at parcel granularity for regulatory loss reporting by jurisdiction (county FIPS) and for reserve adequacy analysis by property']
  title_claim_id varchar [note: 'Foreign key reference to the parent title insurance claim record. Links every event to its governing claim in the Claims Administration System.']
  title_order_id varchar [note: 'Reference to the originating title order associated with the claim. Enables end-to-end traceability from order intake through claim resolution.']
  title_policy_id varchar [note: 'Reference to the issued Owner\'s Title Policy (OTP) or Lender\'s Title Policy (LTP) under which the claim is made. Supports owner-versus-lender policy coverage analysis.']
  claim_number varchar [note: 'Externally visible, human-readable claim identifier assigned by the Claims Administration System at First Notice of Loss (FNOL). Used in all regulatory and correspondence references.']
  claimed_loss_amount decimal(18,2) [note: 'Amount of loss asserted by the claimant at the time of FNOL or as updated at this event. May differ from the ultimate reserve or paid loss amount.']
  coverage_decision varchar [note: 'Underwriting coverage determination recorded at this event: whether the claimed loss is covered, denied, partially covered, or pending analysis under the OTP or LTP.']
  coverage_denial_reason varchar [note: 'Reason code or narrative explaining why coverage was denied or limited at this event. Required for regulatory reporting and claimant adverse-action notices.']
  created_timestamp timestamp [note: 'Timestamp when this event record was first written to the Silver layer lakehouse. Distinct from event_timestamp (business event time). Supports audit and data lineage.']
  curative_action_required boolean [note: 'Indicates whether this claim event triggered a curative processing action (e.g., lien release, deed correction, quiet title) rather than a direct indemnity payment.']
  curative_action_type varchar [note: 'Type of curative action initiated at this event (e.g., lien_release, deed_correction, quiet_title, reconveyance, satisfaction). [ENUM-REF-CANDIDATE: lien_release|deed_correction|quiet_title|reconveyance|satisfaction|gap_cure|subordination — promote to']
  curative_resolution_date date [note: 'Date the curative action associated with this claim event was completed and the title defect resolved. Null if curative action is still open. Supports curative aging analysis.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts on this event record. Defaults to USD for domestic US title insurance transactions.']
  event_description varchar [note: 'Free-text narrative describing the specific action, decision, or observation recorded in this event. Supports investigator notes, coverage rationale, and curative resolution details.']
  event_timestamp timestamp [note: 'Precise date and time (ISO 8601 with timezone offset) at which the claim lifecycle event occurred in the Claims Administration System. Immutable once written.']
  event_type varchar [note: 'Discriminator classifying the kind of lifecycle event recorded. [ENUM-REF-CANDIDATE: fnol_intake|status_change|coverage_decision|reserve_movement|loss_payment|recovery_receipt|assignment_change|investigation_update|curative_action|closure — promote to']
  expense_amount decimal(18,2) [note: 'Defense, investigation, or allocated loss adjustment expense (ALAE) amount in USD incurred at this event. Tracked separately from indemnity for loss ratio analysis.']
  fnol_date date [note: 'Date the claimant first reported the title loss or defect to the insurer. Anchors claim frequency and aging calculations. Distinct from event_timestamp.']
  ibnr_flag boolean [note: 'Indicates whether this event is associated with an IBNR reserve estimate rather than a reported claim. Supports actuarial IBNR development and NAIC Schedule P reporting.']
  insured_amount decimal(18,2) [note: 'Face amount of the title insurance policy (purchase price for OTP or loan amount for LTP) at the time of policy issuance. Provides exposure context for severity analysis.']
  investigation_start_date date [note: 'Date the formal claim investigation was initiated. Used to measure investigation cycle time and compliance with state prompt-payment statutes.']
  loss_date date [note: 'Date the underlying title defect, encumbrance, or adverse claim event occurred or was discovered. Used for policy-year loss development and IBNR estimation.']
  loss_payment_amount decimal(18,2) [note: 'Indemnity payment amount in USD disbursed to the claimant at this event. Zero for non-payment events. Feeds claim severity and loss ratio calculations.']
  new_claim_status varchar [note: 'Claim lifecycle status resulting from this event. Together with prior_claim_status, captures every material status transition for regulatory and operational reporting.']
  policy_effective_date date [note: 'Effective date of the title insurance policy under which the claim is made. Denormalized here to support policy-year loss ratio analysis without joining to title_policy.']
  policy_type varchar [note: 'Indicates whether the claim is against an Owner\'s Title Policy (OTP) or a Lender\'s Title Policy (LTP). Supports owner-versus-lender policy coverage analysis per VREQ-010.']
  prior_claim_status varchar [note: 'Claim lifecycle status immediately before this event was applied. Preserved for lifecycle history and transition auditing per VREQ-007. [ENUM-REF-CANDIDATE: open|under_investigation|reserved|pending_payment|subrogation|closed|reopened — 7 candidates']
  prior_reserve_amount decimal(18,2) [note: 'Case reserve amount in USD immediately before this reserve movement event. Enables calculation of reserve development and supports IBNR analysis.']
  production_channel varchar [note: 'Channel through which the original title order and policy were produced (direct branch, centralized lender, or independent agent). Enables loss ratio analysis by distribution channel.']
  recovery_amount decimal(18,2) [note: 'Amount in USD recovered through subrogation, salvage, or other recovery actions recorded at this event. Reduces net loss and feeds recovery ratio reporting.']
  regulatory_report_period varchar [note: 'Reporting period (e.g., 2024-Q3, 2024-FY) to which this claim event is attributed for NAIC Annual Statement and state Department of Insurance loss reporting.']
  reserve_amount decimal(18,2) [note: 'Case reserve amount in USD established or adjusted at this event. Represents the estimated ultimate loss for the claim at this point in time. Supports reserve movement tracking.']
  reserve_change_amount decimal(18,2) [note: 'Net change in case reserve at this event (new minus prior). Positive indicates reserve strengthening; negative indicates reserve reduction. Used in loss development reporting.']
  sequence varchar [note: 'Monotonically increasing integer ordering events within a single claim. Enables reconstruction of the full claim lifecycle in chronological order.']
  source_reference_code varchar [note: 'Native identifier of this event in the originating source system (e.g., Claims Administration System transaction ID). Enables reconciliation and lineage tracing back to the SoR.']
  subrogation_initiated boolean [note: 'Indicates whether a subrogation or recovery action was initiated at or before this event. Supports recovery tracking and net loss reporting.']
  subrogation_status varchar [note: 'Current status of the subrogation or recovery action as of this event. Tracks progression from initiation through recovery or closure without recovery.']
  title_risk_cause_code varchar [note: 'Standardized code identifying the root cause of the title defect or loss (e.g., forged deed, undisclosed lien, chain-of-title break, encroachment). Drives loss ratio by title-risk cause analytics.']
  title_risk_cause_description varchar [note: 'Human-readable description of the title risk cause associated with this claim event. Complements the structured cause code with examiner narrative.']
  transaction_type varchar [note: 'Type of real estate transaction underlying the insured policy (e.g., purchase, refinance, HELOC, construction). Supports loss frequency and severity segmentation by transaction type.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'Identity of the user, service account, or automated process that wrote this event record to the lakehouse. Supports SOC 2 audit trail and data governance requirements.']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Immutable lifecycle-event log for a title claim, preserving every material status transition, coverage decision, assignment change, and reserve movement as a timestamped event record.'
}

Table ti_claim.reserve {
  reserve_id varchar [pk, note: 'Unique surrogate identifier for this effective-dated claim reserve record within the Claims Administration System.']
  approved_by_user_party_id varchar [note: 'Internal user identifier of the supervisor or underwriting authority who approved this reserve, required when reserve exceeds authority threshold.']
  party_id varchar [note: 'Internal user identifier of the claims examiner, underwriter, or actuary who established or last revised this reserve record.']
  prior_reserve_id varchar [note: 'Reference to the immediately preceding reserve record that this record revises or supersedes, enabling a full audit chain of reserve movements.']
  title_claim_id varchar [note: 'Reference to the parent title-insurance claim to which this reserve record belongs. Links reserve to FNOL and claim lifecycle.']
  title_policy_id varchar [note: 'Reference to the issued title-insurance policy (OTP or LTP) under which this claim and reserve are established.']
  accident_year varchar [note: 'Year in which the title defect or loss event is deemed to have occurred for actuarial loss development triangle and IBNR estimation purposes.']
  actuarial_method_code varchar [note: 'Actuarial development method used to estimate IBNR or bulk reserve amounts: chain ladder, Bornhuetter-Ferguson, expected loss, frequency-severity, or judgment.']
  adequacy_review_date date [note: 'Date of the most recent periodic reserve adequacy review performed by the actuary or claims supervisor for this claim reserve record.']
  alae_reserve_amount decimal(18,2) [note: 'Reserve for allocated loss adjustment expenses directly attributable to this claim, such as attorney fees, curative costs, and investigation expenses.']
  approval_date date [note: 'Date on which the required supervisory or underwriting approval for this reserve was granted. Null if approval was not required or is pending.']
  approval_required boolean [note: 'Indicates whether this reserve amount exceeded the claims examiner authority threshold and required supervisory or underwriting approval before activation.']
  basis varchar [note: 'Indicates whether this reserve record represents the initial establishment, a subsequent revision, or the final reserve set at claim closure.']
  case_reserve_amount decimal(18,2) [note: 'Estimated total indemnity and expense amount reserved for this specific claim based on current investigation findings. Denominated in currency_code.']
  created_timestamp timestamp [note: 'System timestamp when this reserve record was first created in the Claims Administration System. Immutable audit field.']
  curative_action_pending boolean [note: 'Indicates whether an active curative action (e.g., quiet title, lien release, deed correction) is in progress that may reduce or eliminate the reserve.']
  curative_resolution_date date [note: 'Date on which the curative action was completed and the title defect resolved, triggering a reserve reduction or closure review.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary reserve amounts on this record (e.g., USD). Title operations are predominantly USD.']
  effective_date date [note: 'Date on which this reserve record becomes operative for financial reporting and loss triangle purposes. Supports effective-dated reserve history.']
  expiration_date date [note: 'Date on which this reserve record is superseded by a revision or closed. Null if this is the current active reserve. Enables bi-temporal reserve history.']
  ibnr_reserve_amount decimal(18,2) [note: 'Actuarially estimated reserve for losses incurred but not yet reported or fully developed on this claim or cohort. Zero for case reserves.']
  large_loss_flag boolean [note: 'Indicates whether this reserve meets or exceeds the underwriter-defined large-loss threshold, triggering enhanced oversight and executive reporting.']
  large_loss_threshold_amount decimal(18,2) [note: 'Dollar threshold in effect at the time this reserve was set that determines large-loss classification. Preserved for audit and threshold-change analysis.']
  litigation_flag boolean [note: 'Indicates whether this claim has entered active litigation (e.g., quiet title action, foreclosure defense), which typically elevates ALAE reserve requirements.']
  loss_reserve_amount decimal(18,2) [note: 'Indemnity-only component of the case reserve, representing estimated title-loss payment to the insured, excluding allocated loss adjustment expenses.']
  net_reserve_amount decimal(18,2) [note: 'Gross case reserve less reinsurance recoverable and subrogation reserve, representing the net retained reserve exposure for statutory reporting.']
  policy_liability_amount decimal(18,2) [note: 'Face amount of the title-insurance policy (Schedule A liability) against which this claim is made. Used to compute reserve-to-liability ratio.']
  policy_type varchar [note: 'Indicates whether the underlying policy is an Owner\'s Title Policy (OTP) or a Lender\'s/Loan Title Policy (LTP), driving coverage analysis and loss reporting.']
  policy_year varchar [note: 'Year in which the underlying title-insurance policy was issued. Used for cohort-based loss ratio and frequency/severity analysis by policy vintage.']
  reinsurance_recoverable_amount decimal(18,2) [note: 'Estimated amount recoverable from reinsurance treaties or facultative placements applicable to this claim, reducing net reserve exposure.']
  reporting_period_quarter varchar [note: 'Fiscal quarter (1–4) within the reporting year to which this reserve record is assigned for quarterly statutory and management reporting.']
  reporting_period_year varchar [note: 'Calendar or accident year to which this reserve is assigned for NAIC statutory loss triangle and state Department of Insurance reporting purposes.']
  reserve_number varchar [note: 'Externally visible, human-readable identifier for this reserve record as assigned by the Claims Administration System (e.g., RES-2024-000123).']
  reserve_status varchar [note: 'Current lifecycle state of this reserve record: open (active), revised (superseded by a newer record), closed, reinstated, or voided.']
  reserve_type varchar [note: 'Classification of the reserve: case (specific claim), IBNR (Incurred But Not Reported), bulk, salvage, subrogation recovery, or unallocated loss reserve.']
  revision_notes varchar [note: 'Free-text examiner notes documenting the rationale for establishing or revising this reserve, including key facts from investigation or curative status.']
  revision_reason_code varchar [note: 'Coded reason for this reserve revision: new information, settlement update, curative resolution, court order, actuarial review, periodic review, or closure.']
  revision_sequence varchar [note: 'Monotonically increasing integer indicating the revision number of this reserve for the parent claim (1 = initial, 2 = first revision, etc.).']
  set_by_role varchar [note: 'Role of the individual who established or last revised this reserve: claims examiner, underwriter, actuary, supervisor, or automated system rule.']
  set_date date [note: 'Calendar date on which the reserve was formally established or revised by the authorized examiner, underwriter, or actuary in the Claims Administration System.']
  state_code varchar [note: 'Two-letter USPS state abbreviation of the insured property jurisdiction, used for state Department of Insurance loss reporting and regulatory segmentation.']
  subrogation_reserve_amount decimal(18,2) [note: 'Estimated recoverable amount through subrogation or salvage rights against responsible third parties, netted against gross reserve for loss ratio reporting.']
  title_risk_cause_code varchar [note: 'Standardized code classifying the root cause of the title defect driving this claim (e.g., forgery, undisclosed heir, survey error, lien, encroachment). [ENUM-REF-CANDIDATE']
  title_risk_cause_description varchar [note: 'Free-text narrative describing the specific title defect, encumbrance, or chain-of-title break that is the basis for the claim and reserve.']
  to_liability_pct decimal(7,4) [note: 'Ratio of total case reserve to policy face liability, expressed as a decimal (e.g., 0.4500 = 45%). Supports severity and adequacy monitoring.']
  transaction_type varchar [note: 'Type of real-estate transaction underlying the insured policy: purchase, refinance (REFI), HELOC, construction, commercial, or home equity.']
  updated_timestamp timestamp [note: 'System timestamp of the most recent modification to this reserve record in the Claims Administration System. Supports audit trail and change detection.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Effective-dated reserve record for a title claim, capturing case reserve and IBNR reserve amounts, reserve type (case, IBNR, bulk), currency, reserve basis (initial, revised, final), set-by underwriter or actuary, effective date, expiration date, and'
}

Table ti_claim.loss_payment {
  loss_payment_id varchar [pk, note: 'Unique surrogate identifier for each indemnity disbursement record in the claims administration system. Primary key for the loss_payment entity.']
  agent_profile_id varchar [note: 'Foreign key linking to agency.agent_profile. Business justification: When agent error or negligence contributes to a title loss, underwriters track the producing agent for E&O subrogation analysis, agency oversight review escalation, and loss-by-agent']
  curative_action_id varchar [note: 'Reference to the curative processing action (e.g., lien release, deed correction, quiet title) funded by this payment when payment_type is curative_cost. Null for indemnity payments.']
  disbursement_id varchar [note: 'Foreign key linking to settlement.disbursement. Business justification: When claims result in corrective disbursements or when original settlement disbursements are disputed, linking loss payments to the original disbursement tracks remediation, enables']
  loss_party_id varchar [note: 'Reference to the claims examiner, underwriter, or officer who authorized this loss payment. Supports segregation-of-duties audit and authority-level compliance.']
  loss_payee_party_id varchar [note: 'Reference to the party entity receiving this loss payment (claimant, lender, attorney, curative vendor, or court). Supports party-role contextual modeling.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Loss payments are allocated to specific parcels for loss-ratio analysis by jurisdiction (county FIPS), property type (land use code), and assessed value band.']
  prior_payment_loss_payment_id varchar [note: 'Self-referencing link to the original payment record if this record represents a replacement, reissuance, or correction of a prior payment. Null for original disbursements.']
  recovery_receipt_id varchar [note: 'Reference to the associated subrogation or recovery record if a recovery action has been initiated against a third party for this loss payment. Null if no recovery pursued.']
  title_claim_id varchar [note: 'Foreign key reference to the parent title insurance claim against which this loss payment is disbursed. Links payment to the claim lifecycle.']
  title_policy_id varchar [note: 'Reference to the issued title insurance policy (OTP or LTP) under which this loss payment is made. Supports owner-versus-lender policy coverage analysis.']
  approval_authority_level varchar [note: 'Organizational authority tier required and used to approve this payment (examiner, supervisor, manager, VP, executive). Driven by payment amount thresholds per claims authority matrix.']
  approval_date date [note: 'Date on which the loss payment was formally approved by the authorized claims examiner or underwriting officer prior to disbursement.']
  approved_amount decimal(18,2) [note: 'Amount formally authorized by the claims examiner or underwriter for disbursement. May differ from payment_amount if partial payment or adjustment was applied post-approval.']
  bank_account_ref varchar [note: 'Tokenized or masked reference to the destination bank account used for wire or ACH disbursement. Full account details stored in the NPPI Vault per VREQ-012 and GLBA.']
  channel_type varchar [note: 'Business production channel through which the underlying title order was originated: direct branch, centralized lender, or independent agent. Supports loss frequency and severity by channel.']
  claim_number varchar [note: 'Human-readable claim identifier from the claims administration system, denormalized onto the payment record for operational reporting without requiring a join to the claim entity.']
  cleared_date date [note: 'Date on which the disbursed payment was confirmed cleared by the financial institution (check cleared, wire settled, ACH confirmed). Used for bank reconciliation.']
  cost_center_code varchar [note: 'Finance cost center to which this loss payment expense is allocated. Supports branch-level, channel-level, and underwriter-level loss ratio reporting.']
  county_fips_code varchar [note: 'Five-digit FIPS code identifying the county of the insured property. Supports geographic loss concentration analysis and county-level regulatory reporting.']
  created_timestamp timestamp [note: 'Timestamp when this loss payment record was first created in the claims administration system. Audit trail anchor for record provenance.']
  cumulative_paid_amount decimal(18,2) [note: 'Running total of all loss payments disbursed on the parent claim as of this payment record. Supports policy limit exhaustion monitoring and severity tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the payment amount (e.g., USD). Title insurance in the US is predominantly USD; retained for multi-currency commercial transactions.']
  gl_account_code varchar [note: 'General ledger account code to which this loss payment is posted in the ERP/finance system. Supports premium revenue recognition, loss expense allocation, and SOX financial controls.']
  irs_1099_required boolean [note: 'Indicates whether this loss payment requires IRS Form 1099 reporting to the payee and the IRS. Driven by payment type, payee tax status, and IRS threshold rules.']
  is_final_payment boolean [note: 'Indicates whether this disbursement is the final loss payment on the claim, signaling that the claim is ready for closure after this payment clears. True = final payment.']
  naic_loss_cause_code varchar [note: 'NAIC-standardized loss cause code used in Annual Statement Schedule T and state DOI regulatory filings. Maps internal title risk cause to the NAIC reporting taxonomy.']
  payee_name varchar [note: 'Full legal name of the individual or entity receiving the loss payment as it appears on the disbursement instrument (check payee line or wire beneficiary name).']
  payee_type varchar [note: 'Classification of the payee role for this disbursement: claimant, lender (mortgagee), attorney, curative vendor, court, or insured. Supports loss-cause and payee-mix analytics.']
  payment_amount decimal(18,2) [note: 'Gross amount disbursed in this loss payment transaction, expressed in the payment currency. Core monetary fact for claim severity and loss ratio analysis.']
  payment_date date [note: 'Calendar date on which the loss payment was actually disbursed to the payee. Principal business event date for claim payment lag and loss ratio period assignment.']
  payment_method varchar [note: 'Instrument used to disburse the loss payment: wire transfer, paper check, ACH electronic transfer, or escrow disbursement. Drives reconciliation and positive-pay controls.']
  payment_notes varchar [note: 'Free-text examiner notes documenting the basis for this payment, any conditions, partial payment rationale, or special handling instructions. Supports claims audit trail.']
  payment_number varchar [note: 'Externally visible, human-readable identifier for this loss payment disbursement, assigned by the claims administration system (e.g., LP-2024-000123).']
  payment_reference_number varchar [note: 'External reference number assigned by the bank, wire network, or check processor for this disbursement (e.g., wire confirmation number, check number, ACH trace ID).']
  payment_status varchar [note: 'Current lifecycle state of the loss payment: pending (awaiting approval), approved, issued (disbursed), cleared (bank confirmed), voided, or returned (funds recovered).']
  payment_type varchar [note: 'Classification of the disbursement purpose: indemnity (direct loss), curative_cost (title defect cure), defense_cost (legal defense), settlement (negotiated resolution), or court_ordered.']
  policy_liability_limit decimal(18,2) [note: 'Maximum insured amount under the linked title policy at the time of payment. Provides context for whether payment approaches or exhausts policy limits.']
  policy_number varchar [note: 'Human-readable title policy number denormalized onto the payment record for regulatory loss reporting and policy-level loss ratio analysis without requiring a join.']
  policy_type varchar [note: 'Indicates whether the loss payment is made under an Owner\'s Title Policy (OTP) or a Loan/Lender\'s Title Policy (LTP). Supports owner-versus-lender coverage analysis per VREQ-010.']
  reserve_release_amount decimal(18,2) [note: 'Portion of the case reserve released upon issuance of this payment. Used to reconcile reserve movements against actual loss payments for IBNR and loss ratio reporting.']
  state_code varchar [note: 'Two-letter USPS state code for the property jurisdiction where the insured title risk is located. Required for state Department of Insurance regulatory loss reporting.']
  subrogation_flag boolean [note: 'Indicates whether this loss payment has an associated subrogation or recovery right that the insurer may pursue against a responsible third party after indemnifying the insured.']
  tax_withholding_amount decimal(18,2) [note: 'Amount withheld from the gross payment for IRS backup withholding or other tax obligations. Relevant for payments to non-exempt payees. Supports 1099 reporting.']
  title_risk_cause_code varchar [note: 'Standardized code identifying the title defect or risk cause driving this loss payment (e.g., forged deed, undisclosed lien, survey error, chain-of-title break).']
  title_risk_cause_description varchar [note: 'Free-text narrative describing the specific title defect, encumbrance, or chain-of-title issue that gave rise to this loss payment. Complements the structured risk cause code.']
  transaction_type varchar [note: 'Real estate transaction type underlying the insured policy: purchase, refinance (REFI), home equity line of credit (HELOC), construction, or commercial. Supports loss frequency by transaction segment.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this loss payment record. Supports change detection, audit, and incremental lakehouse ingestion.']
  void_date date [note: 'Date on which the payment was voided, if applicable. Null for non-voided payments. Supports lifecycle history preservation per VREQ-007.']
  wire_instruction_ref varchar [note: 'Tokenized reference to the wire instruction set used for this disbursement. Full wire details (routing, account, SWIFT) stored in the NPPI Vault per VREQ-012 and GLBA.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Transactional record of each indemnity disbursement made on a title claim, including payment type (indemnity, curative cost, defense cost, settlement, court-ordered), payee party, payment method (wire, check, ACH), payment amount, currency, payment date'
}

Table ti_claim.recovery_receipt {
  recovery_receipt_id varchar [pk, note: 'Unique surrogate identifier for each recovery or subrogation receipt record within the claims administration system.']
  party_id varchar [note: 'Reference to the claims examiner or adjuster responsible for managing the recovery action and recording this receipt in the claims administration system.']
  recovery_counsel_party_id varchar [note: 'Reference to the outside or staff counsel engaged to pursue subrogation litigation or negotiation on behalf of the title insurer for this recovery action.']
  recovery_source_party_id varchar [note: 'Reference to the party from whom the recovery proceeds were collected (e.g., prior owner, grantor, tortfeasor, reinsurer, co-insurer, or responsible third party).']
  reversed_receipt_recovery_receipt_id varchar [note: 'Reference to the original recovery receipt record that this record reverses. Populated only when reversal_indicator = True. Preserves audit trail of corrections.']
  title_claim_id varchar [note: 'Reference to the title insurance claim against which this recovery receipt is applied. Links recovery proceeds to the originating loss event.']
  title_policy_id varchar [note: 'Reference to the issued owner or lender title policy (OTP/LTP) under which the underlying claim was made and recovery is being tracked.']
  agent_recovery_share_amount decimal(18,2) [note: 'Portion of the recovery proceeds allocated to the independent title agent under the agency agreement premium split, when the underlying policy was issued through an agent channel.']
  applied_to_loss_amount decimal(18,2) [note: 'Portion of the recovery receipt amount that has been applied to reduce the recorded claim loss or indemnity payment balance. May differ from recovery_amount if partial application.']
  bank_reference_number varchar [note: 'Bank-assigned reference or wire confirmation number for the recovery funds receipt. Restricted due to financial transaction sensitivity. Used for bank reconciliation.']
  check_number varchar [note: 'Check number of the recovery payment instrument when recovery_method = check. Restricted financial data used for payment reconciliation and audit trail.']
  created_timestamp timestamp [note: 'Timestamp when this recovery receipt record was first created in the claims administration system. Used for audit trail and record provenance per VREQ-007.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the recovery amount (e.g., USD). Title insurance is predominantly USD; retained for multi-currency commercial transactions.']
  expected_recovery_amount decimal(18,2) [note: 'Estimated total recovery amount anticipated from this recovery action at the time of demand or suit filing. Used to track recovery realization rate versus expectation.']
  expense_recovery_amount decimal(18,2) [note: 'Portion of the recovery receipt allocated to recovery of claim-related loss adjustment expenses (LAE), such as legal fees and investigation costs, separate from indemnity loss recovery.']
  gl_account_code varchar [note: 'GL account code to which the recovery receipt is posted in the ERP/financial system, enabling reconciliation between claims administration and financial reporting.']
  gl_posting_date date [note: 'Date on which the recovery receipt was posted to the general ledger for financial reporting purposes. May differ from receipt_date due to accounting period cutoffs.']
  is_final_receipt boolean [note: 'Indicates whether this is the final recovery receipt for the claim (True), signaling that no further recovery proceeds are expected and the recovery action is closed.']
  is_full_recovery boolean [note: 'Indicates whether this receipt represents full recovery of the total claim indemnity paid (True) or a partial recovery (False). Drives claim closure eligibility assessment.']
  naic_recovery_code varchar [note: 'NAIC-defined code classifying the recovery type for statutory annual statement Schedule F and loss reporting purposes. Aligns with NAIC Title Insurance Annual Statement requirements.']
  net_recovery_amount decimal(18,2) [note: 'Recovery amount net of recovery-related expenses (legal fees, collection costs) incurred to obtain the proceeds. Equals recovery_amount minus recovery expense deductions.']
  payor_tax_identifier varchar [note: 'Federal Tax Identification Number (TIN/EIN/SSN) of the party remitting the recovery payment. Required for IRS 1099 reporting on recoveries. Stored in NPPI Vault.']
  policy_type varchar [note: 'Indicates whether the underlying policy is an Owner\'s Title Policy (OTP) or Lender\'s/Loan Title Policy (LTP), supporting owner-versus-lender recovery analysis per VREQ-016.']
  receipt_date date [note: 'Calendar date on which the recovery funds were actually received by the title insurer or its claims administrator. Principal business event date for this transaction.']
  receipt_number varchar [note: 'Externally visible, human-readable reference number assigned to this recovery receipt by the claims administration system for tracking and correspondence.']
  recovery_amount decimal(18,2) [note: 'Gross monetary amount of the recovery or subrogation proceeds received in this receipt, expressed in the transaction currency. Used in loss ratio and recovery rate calculations.']
  recovery_expense_amount decimal(18,2) [note: 'Total costs incurred to pursue and collect this recovery (attorney fees, court costs, investigation expenses). Deducted from gross recovery to derive net recovery.']
  recovery_method varchar [note: 'Mechanism by which recovery funds were collected: wire transfer, check, ACH, offset against amounts owed, court judgment enforcement, or negotiated settlement agreement.']
  recovery_notes varchar [note: 'Free-text narrative describing the circumstances of the recovery, negotiation details, or special conditions associated with this receipt. Entered by the claims examiner.']
  recovery_rate_pct decimal(7,4) [note: 'Percentage of the original claim indemnity payment recovered through this receipt (recovery_amount / total indemnity paid). Supports recovery effectiveness analytics.']
  recovery_source_name varchar [note: 'Name of the entity or individual from whom recovery proceeds were collected (e.g., prior grantor, judgment debtor, reinsurer name). Denormalized for reporting when party record is unavailable.']
  recovery_source_type varchar [note: 'Classification of the party from whom recovery was collected, supporting analysis of recovery patterns by source category (e.g., prior owner subrogation vs. reinsurer recovery).']
  recovery_status varchar [note: 'Current lifecycle status of the recovery receipt: pending (expected but not yet received), received (funds in hand), applied (posted to claim reserve/loss), reversed, or written off.']
  recovery_type varchar [note: 'Classification of the recovery mechanism: subrogation (rights against third party), contribution (co-insurer share), salvage (asset recovery), reinsurance recovery, or indemnification from responsible party.']
  reinsurance_treaty_reference varchar [note: 'Identifier of the reinsurance treaty or facultative certificate under which a reinsurance recovery receipt was collected. Populated only when recovery_type = reinsurance_recovery.']
  reserve_reduction_amount decimal(18,2) [note: 'Amount by which the claim case reserve was reduced upon application of this recovery receipt. Supports reserve adequacy and IBNR analysis.']
  reversal_indicator boolean [note: 'Indicates whether this recovery receipt record represents a reversal of a previously posted receipt (True). Supports lifecycle history preservation per VREQ-007.']
  settlement_agreement_date date [note: 'Date on which a settlement agreement was executed between the title insurer and the recovery source party, formalizing the recovery amount and terms.']
  source_system_code varchar [note: 'Native record identifier from the originating claims administration system (e.g., SoftPro, RamQuest) for lineage tracing and reconciliation with the system of record.']
  state_of_recovery varchar [note: 'Two-letter US state code for the jurisdiction in which the recovery action was pursued. Supports state-level regulatory loss reporting to Departments of Insurance.']
  subrogation_demand_date date [note: 'Date on which the formal subrogation demand letter was issued to the responsible third party, initiating the recovery action. Used to measure recovery cycle time.']
  subrogation_suit_filed_date date [note: 'Date on which a subrogation lawsuit was filed in court against the responsible party, if litigation was required to enforce recovery rights.']
  title_risk_cause_code varchar [note: 'Standardized code identifying the title defect or risk category that gave rise to the underlying claim (e.g., forged deed, undisclosed lien, survey defect). Supports loss ratio by title-risk cause.']
  transaction_type varchar [note: 'Type of real estate transaction underlying the insured policy (purchase, refinance, HELOC, construction, commercial). Supports segmentation of recovery metrics by transaction type.']
  underwriter_recovery_share_amount decimal(18,2) [note: 'Portion of the recovery proceeds retained by the title underwriter after deducting the agent share and recovery expenses. Used in underwriter loss ratio reporting.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this recovery receipt record. Supports change tracking and lifecycle history preservation per VREQ-007.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Transactional record of each recovery or subrogation receipt collected on a title claim, capturing recovery type (subrogation, contribution, salvage, reinsurance recovery), recovery source party, recovery amount, currency, receipt date, recovery method'
}

Table ti_claim.investigation {
  investigation_id varchar [pk, note: 'Unique surrogate identifier for the title claim investigation record. Primary key for the investigation entity within the Claims Administration System.']
  agent_profile_id varchar [note: 'Reference to the independent title agent involved in the originating transaction, if applicable. Used for agency oversight, E&O review, and remittance impact analysis.']
  investigation_assigned_counsel_party_id varchar [note: 'Reference to the outside legal counsel or panel attorney assigned to support the investigation when litigation or curative legal action is required.']
  investigation_party_id varchar [note: 'Reference to the internal staff member or external counsel assigned as lead investigator for this claim investigation. Supports workload management and investigator performance reporting.']
  legal_description_id varchar [note: 'Foreign key linking to property.legal_description. Business justification: Investigations validate legal descriptions against recorded instruments, prior commitments, and surveys.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Investigations require parcel-level legal description, recording jurisdiction, and APN for evidence retrieval, chain-of-title reconstruction, and curative action planning.']
  recorded_instrument_id varchar [note: 'Foreign key linking to recording.recorded_instrument. Business justification: Claim investigations examine the recorded instrument evidencing the defect (deed, mortgage, lien). Investigators pull instrument to analyze chain of title breaks and forgery.']
  title_claim_id varchar [note: 'Foreign key reference to the parent title insurance claim record. Links the investigation to its originating First Notice of Loss (FNOL) claim intake record.']
  title_commitment_id varchar [note: 'Foreign key linking to underwriting.title_commitment. Business justification: Investigators retrieve the commitment to compare Schedule B exceptions and requirements against the claimed defect, verify insurable title determination, and assess whether the']
  title_order_id varchar [note: 'Reference to the originating title order associated with the insured transaction. Enables traceability from claim investigation back to the original title production workflow.']
  title_policy_id varchar [note: 'Reference to the issued Owner\'s Title Policy (OTP) or Lender\'s Title Policy (LTP) under which the claim is being investigated. Supports coverage analysis and policy-to-claim linkage.']
  underwriting_title_examination_id varchar [note: 'Foreign key linking to underwriting.underwriting_title_examination. Business justification: Investigators review examination workpapers to assess whether the examiner identified the defect, whether the examination scope was adequate, and whether the']
  agency_involved_flag boolean [note: 'Indicates whether an independent title agent was involved in the originating transaction. Triggers agency oversight review and potential E&O coverage analysis.']
  apn varchar [note: 'Assessor\'s Parcel Number (APN) or Parcel Identification Number (PIN) assigned by the county assessor for the subject property. Supports property data linkage and county record research.']
  chain_of_title_break_flag boolean [note: 'Indicates whether the investigation identified a break or gap in the chain of title (COT) as a contributing factor to the claim. Supports chain-of-title break metrics.']
  claimant_name varchar [note: 'Full legal name of the party asserting the claim, which may differ from the named insured (e.g., successor, lender assignee). NPPI — handle per GLBA and CCPA/CPRA.']
  completion_date date [note: 'Calendar date on which the investigation was formally concluded and findings were documented. Null if investigation is still open. Used to compute investigation duration.']
  county_fips_code varchar [note: 'Five-digit Federal Information Processing Standards (FIPS) code identifying the county in which the subject property is located. Used for jurisdictional routing and regulatory reporting.']
  coverage_analysis_narrative varchar [note: 'Free-text narrative documenting the underwriter or claims examiner\'s analysis of policy coverage applicability, including Schedule B exceptions and endorsement review.']
  coverage_determination varchar [note: 'Outcome of the coverage analysis phase of the investigation. Indicates whether the claimed loss is within the scope of the issued title policy. Drives reserving and payment decisions.']
  created_timestamp timestamp [note: 'Timestamp when the investigation record was first created in the Claims Administration System. Audit field supporting record provenance and lifecycle tracking.']
  curative_action_required_flag boolean [note: 'Indicates whether the investigation determined that curative processing (e.g., lien release, deed correction, quiet title action) is required to resolve the title defect underlying the claim.']
  curative_action_status varchar [note: 'Current status of curative processing activities initiated as a result of the investigation findings. Supports curative action aging and effectiveness metrics.']
  curative_completion_date date [note: 'Date on which all curative actions required to resolve the title defect were completed. Null if curative action is not required or still in progress.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this investigation record. Defaults to USD for domestic US title insurance transactions.']
  document_receipt_date date [note: 'Date on which all requested documents and evidence were received from the claimant or third parties, enabling the investigation to proceed from pending_docs status.']
  document_request_date date [note: 'Date on which the investigator issued a formal request for additional documents or evidence from the claimant or third parties. Supports pending_docs status tracking.']
  eo_coverage_flag boolean [note: 'Indicates whether the claim may be covered under an Errors and Omissions (E&O) policy held by the agent or closing attorney, potentially reducing net loss to the underwriter.']
  estimated_loss_amount decimal(18,2) [note: 'Investigator\'s estimate of the total monetary loss exposure identified during the investigation, in USD. Used to inform initial reserve setting and severity analysis.']
  evidence_complete_flag boolean [note: 'Indicates whether all required evidentiary documents (deeds, instruments, search results, affidavits) have been received and reviewed. Supports evidence completeness and provenance metrics.']
  findings_narrative varchar [note: 'Detailed free-text narrative summarizing the investigation findings, including chain-of-title defects identified, evidence reviewed, and conclusions reached by the investigator.']
  forgery_fraud_flag boolean [note: 'Indicates whether the investigation identified forgery, fraud, or misrepresentation as a contributing cause of the title defect or loss. Triggers FinCEN SAR filing review.']
  insured_name varchar [note: 'Full legal name of the insured party (owner or lender) under the title policy as of the investigation. Captured for claim correspondence and regulatory reporting. NPPI — handle per GLBA.']
  investigation_status varchar [note: 'Current lifecycle state of the investigation. Drives workflow routing and SLA tracking. Values: open, pending_docs, pending_legal, complete, closed.']
  investigation_type varchar [note: 'Classification of the investigation by title-risk cause category. Supports claim frequency and severity analysis by title-risk cause. [ENUM-REF-CANDIDATE: title_defect|lien|encumbrance|forgery|fraud|boundary|access|other — promote to reference product]']
  last_activity_date date [note: 'Date of the most recent documented activity or update on the investigation. Used to identify stale or aging investigations requiring follow-up.']
  litigation_flag boolean [note: 'Indicates whether the claim investigation has escalated to active litigation or legal proceedings. Triggers assignment of outside counsel and legal hold procedures.']
  number varchar [note: 'Externally visible, human-readable identifier assigned to the investigation by the Claims Administration System. Used in correspondence, regulatory filings, and audit trails.']
  policy_amount decimal(18,2) [note: 'The face amount of insurance stated in the title policy under which the claim is filed, in USD. Establishes the maximum indemnity exposure for coverage analysis.']
  policy_type varchar [note: 'Indicates whether the claim is filed under an Owner\'s Title Policy (OTP) or a Lender\'s/Loan Title Policy (LTP). Supports owner-versus-lender policy coverage analytics.']
  priority varchar [note: 'Priority level assigned to the investigation based on exposure amount, litigation risk, and regulatory deadlines. Drives workload prioritization and escalation workflows.']
  property_address varchar [note: 'Full street address of the insured property subject to the claim investigation. Denormalized for investigation reporting; authoritative address is on the property/parcel record.']
  recommended_reserve_amount decimal(18,2) [note: 'Reserve amount recommended by the investigator based on investigation findings, in USD. Feeds into the reserving workflow for case reserve establishment or adjustment.']
  regulatory_reporting_required_flag boolean [note: 'Indicates whether this investigation triggers mandatory regulatory reporting to NAIC, state Department of Insurance, or other regulatory bodies based on loss amount or claim type thresholds.']
  start_date date [note: 'Calendar date on which the formal investigation was opened and assigned. Used to measure investigation cycle time and SLA compliance from FNOL intake.']
  state_code varchar [note: 'Two-letter USPS state abbreviation for the state in which the subject property is located. Used for state Department of Insurance regulatory reporting and jurisdiction routing.']
  subrogation_potential_flag boolean [note: 'Indicates whether the investigation identified potential subrogation or recovery rights against a third party (e.g., prior owner, agent, attorney, surveyor) responsible for the title defect.']
  subrogation_target_party varchar [note: 'Name or description of the third party against whom subrogation or recovery rights may be pursued based on investigation findings. Populated when subrogation_potential_flag is true.']
  target_completion_date date [note: 'Internally assigned target date by which the investigation should be completed per SLA or claim handling guidelines. Supports aging and SLA breach reporting.']
  title_risk_cause_code varchar [note: 'Standardized code identifying the root cause of the title defect or loss (e.g., forgery, undisclosed heir, survey error, lien not released). Used for NAIC loss cause reporting and frequency/severity analytics.']
  underwriter_opinion varchar [note: 'Formal coverage opinion issued by the underwriting department following referral. Informs the final coverage determination and claim resolution strategy.']
  underwriter_referral_date date [note: 'Date on which the investigation was referred to the underwriting department for coverage opinion or risk assessment. Null if no underwriter referral was made.']
  underwriter_referral_flag boolean [note: 'Indicates whether the investigation was escalated to the underwriting department for coverage opinion or risk referral due to complexity or exposure threshold breach.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the investigation record in the Claims Administration System. Supports change detection, audit trails, and incremental data loading.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'Master record for the investigation phase of a title claim, capturing investigation status (open, pending_docs, pending_legal, complete), assigned investigator, investigation start and completion dates, investigation findings narrative, documents'
}

Table ti_claim.claim_curative_action {
  claim_curative_action_id varchar [pk, note: 'Unique surrogate identifier for each curative action record within the claims administration system. Primary key for the claim_curative_action entity.']
  closing_document_id varchar [note: 'Foreign key linking to settlement.closing_document. Business justification: Curative actions in claims often require re-recording, correcting, or obtaining missing closing documents (deeds, mortgages, affidavits).']
  curative_action_id varchar [note: 'FK to underwriting.curative_action.curative_action_id — Links claim-phase curative to the underwriting curative SSOT with a claim-context discriminator so claim curative aging ties to the single curative source.']
  easement_restriction_id varchar [note: 'Foreign key linking to property.easement_restriction. Business justification: Curative actions for easement disputes, encroachments, or CC&R violations reference specific easement/restriction records.']
  encumbrance_id varchar [note: 'Foreign key linking to property.encumbrance. Business justification: Many curative actions resolve specific encumbrances (mortgage payoffs, lien releases, judgment satisfactions).']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Curative actions (lien releases, corrective deeds, boundary agreements) must reference the specific parcel for recording submission, legal description matching, and APN validation.']
  party_id varchar [note: 'Reference to the internal staff member (claim handler, title examiner, or curative specialist) responsible for executing and tracking this curative action.']
  prior_version_action_id varchar [note: 'Self-referencing identifier pointing to the immediately preceding version of this curative action record, supporting lifecycle revision history and audit trail per VREQ-007.']
  recording_submission_id varchar [note: 'Reference to the eRecording gateway submission record (Simplifile/CSC) tracking the submission, acceptance, or rejection of the curative instrument at the county recorder.']
  title_claim_id varchar [note: 'Reference to the parent title insurance claim under which this curative action was initiated. Links the action to the FNOL and investigation record.']
  title_finding_id varchar [note: 'Reference to the specific title defect, encumbrance, or cloud on title identified during examination or claim investigation that this curative action is intended to resolve.']
  title_policy_id varchar [note: 'Reference to the issued owner or lender title policy (OTP/LTP) under which coverage is being asserted and curative action is being pursued.']
  title_requirement_id varchar [note: 'Reference to the Schedule B-I requirement, if any, that corresponds to this curative action. Null when the action arises solely from a post-policy claim investigation.']
  underwriting_title_examination_id varchar [note: 'Foreign key linking to underwriting.underwriting_title_examination. Business justification: Claim curative teams review the original examination to understand the defect\'s history, prior curative attempts, and whether the defect was identified but not']
  uw_referral_id varchar [note: 'Reference to the underwriting referral or policy exception record created when this curative action requires underwriter approval. Null when uw_referral_required is false.']
  action_description varchar [note: 'Free-text narrative describing the specific curative steps being taken, the parties involved, and the legal instruments or proceedings required to clear the identified defect.']
  action_number varchar [note: 'Externally visible, human-readable identifier for this curative action, used in correspondence with courts, county recorders, and opposing counsel. Format: CA-YYYY-NNNNNN.']
  action_status varchar [note: 'Current lifecycle state of the curative action: open (initiated), in_progress (work underway), pending_recording (instrument prepared, awaiting county acceptance), resolved (defect cleared), withdrawn, or escalated.']
  action_type varchar [note: 'Classification of the curative remedy being pursued. Examples: lien release, deed correction, quiet title suit, probate proceeding, affidavit of heirship, reconveyance.']
  actual_cost_amount decimal(15,2) [note: 'Total actual expenditure incurred to complete this curative action. Compared against estimated cost for reserve accuracy and loss ratio reporting.']
  actual_resolution_date date [note: 'Calendar date on which the curative action was confirmed resolved and the underlying defect or requirement was cleared. Null if still open.']
  chain_of_title_break boolean [note: 'Indicates whether the underlying defect involves a break in the chain of title (COT), such as a missing grantor-grantee link, unrecorded conveyance, or vesting discrepancy.']
  cost_currency_code varchar [note: 'ISO 4217 three-letter currency code for the estimated and actual cost amounts. Typically USD for domestic US title insurance transactions.']
  court_jurisdiction varchar [note: 'Name of the court or judicial jurisdiction (county, state, federal district) in which litigation for this curative action has been filed.']
  created_timestamp timestamp [note: 'System timestamp when this curative action record was first created in the claims administration system. Supports audit trail and provenance requirements.']
  curative_instrument_type varchar [note: 'Type of legal instrument produced or obtained to effect the cure (e.g., release of lien, corrective deed, satisfaction of judgment, reconveyance deed, court order).']
  days_open varchar [note: 'Number of calendar days this curative action has been in an open or in-progress state, calculated from initiated_date. Supports curative action aging and effectiveness metrics per VREQ-016.']
  defect_type varchar [note: 'Classification of the underlying title defect or encumbrance being cured (e.g., mechanics lien, judgment lien, tax lien, HOA lien, chain-of-title break, missing heir, forged deed, encroachment).']
  escalation_date date [note: 'Date on which this curative action was escalated to senior underwriting counsel, litigation, or management due to complexity, aging, or reserve impact. Null if not escalated.']
  estimated_cost_amount decimal(15,2) [note: 'Estimated total cost to complete this curative action, including legal fees, court costs, recording fees, and vendor charges. Used for reserve adequacy and loss exposure analysis.']
  evidence_document_ref varchar [note: 'Reference identifier or URI to the document management system record containing supporting evidence for this curative action (e.g., signed release, court order, recorded instrument image).']
  gap_cure_required boolean [note: 'Indicates whether this curative action specifically addresses a gap period risk — the interval between the last search date and the recording of the insured instrument.']
  initiated_date date [note: 'Calendar date on which this curative action was formally initiated by the claim handler or title examiner. Used to measure curative aging and cycle time.']
  instrument_document_number varchar [note: 'Official document number, book/page reference, or instrument number assigned by the county recorder upon acceptance of the curative instrument.']
  instrument_recording_date date [note: 'Date the curative instrument was officially recorded by the county recorder or register of deeds, establishing constructive notice and clearing the defect of record.']
  is_current_version boolean [note: 'Boolean flag indicating whether this record represents the current active version of the curative action. False for superseded historical revisions. Supports lifecycle history per VREQ-007.']
  last_updated_timestamp timestamp [note: 'System timestamp of the most recent modification to this curative action record. Used for change detection in ETL pipelines and audit compliance.']
  lien_amount decimal(15,2) [note: 'Face amount of the lien, judgment, or encumbrance being cured. Used to assess claim severity and negotiate payoff or release amounts with lienholders.']
  litigation_case_number varchar [note: 'Court-assigned case number for quiet title actions, probate proceedings, or other litigation initiated as part of this curative action. Null for non-litigated cures.']
  outside_counsel_engaged boolean [note: 'Indicates whether outside legal counsel has been retained to pursue this curative action (e.g., quiet title litigation, probate proceedings, or contested lien releases).']
  outside_counsel_firm_name varchar [note: 'Name of the external law firm or attorney retained to handle this curative action. Populated only when outside_counsel_engaged is true.']
  payoff_amount decimal(15,2) [note: 'Negotiated or agreed payoff amount required to obtain a release or satisfaction of the lien or encumbrance. May differ from the original lien amount due to negotiation or accrued interest.']
  priority varchar [note: 'Business priority assigned to this curative action, reflecting urgency relative to closing readiness, policy issuance lag, or claim reserve exposure.']
  recording_required boolean [note: 'Indicates whether the curative instrument must be recorded with the county recorder or register of deeds to be effective against third parties and to clear the title defect.']
  recovery_amount decimal(15,2) [note: 'Amount actually recovered through subrogation, indemnification, or third-party contribution related to this curative action. Reduces net loss on the parent claim.']
  reserve_impact_amount decimal(15,2) [note: 'Dollar amount by which this curative action affects the case reserve on the parent claim. Positive values increase the reserve; negative values reflect reserve reductions upon resolution.']
  resolution_notes varchar [note: 'Free-text notes documenting the outcome of the curative action, including how the defect was cleared, instruments obtained, and any residual risk or exception taken at closing.']
  revision_number varchar [note: 'Sequential revision counter for this curative action record. Increments each time the action is materially updated (e.g., action type change, cost revision, status transition). Supports VREQ-007.']
  subrogation_potential boolean [note: 'Indicates whether the insurer has identified a potential right of subrogation or recovery against a third party (e.g., prior owner, agent, or closing attorney) arising from this curative action.']
  target_resolution_date date [note: 'Internally committed or SLA-driven date by which the curative action is expected to be resolved. Used for aging dashboards and closing readiness reporting.']
  title_risk_cause_code varchar [note: 'Standardized NAIC or underwriter-defined loss cause code categorizing the root title risk driving this curative action. Used for regulatory loss reporting and frequency/severity analytics.']
  uw_referral_required boolean [note: 'Indicates whether this curative action requires escalation to the underwriting department for a formal underwriting referral (UWR) or exception approval before the defect can be insured over.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Tracks each curative action taken to resolve a title defect or requirement identified during a claim investigation or pre-policy examination, including action type (lien release, deed correction, quiet title, probate, affidavit of heirship, reconveyance'
}

Table ti_claim.claim_party {
  claim_party_id varchar [pk, note: 'Unique surrogate identifier for each claim-party association record in the Claims Administration System.']
  party_id varchar [note: 'Reference to the master party record (person or organization) participating in this claim in the specified role.']
  title_claim_id varchar [note: 'Reference to the title-insurance claim to which this party is associated. Links the party record to the parent claim lifecycle.']
  title_policy_id varchar [note: 'Reference to the title-insurance policy (OTP or LTP) under which this party holds insured status or against which the claim is asserted.']
  approved_loss_amount decimal(18,2) [note: 'Dollar amount of loss approved for indemnity payment to this party following investigation and coverage analysis. May differ from claimed_loss_amount.']
  claimed_loss_amount decimal(18,2) [note: 'Dollar amount of loss asserted by this party in their claim submission. Represents the party\'s stated damages before investigation and coverage determination.']
  contact_email varchar [note: 'Primary email address for claim correspondence with this party. NPPI — restricted per GLBA and CCPA/CPRA.']
  contact_phone varchar [note: 'Primary telephone number for claim correspondence with this party. NPPI — restricted per GLBA and CCPA/CPRA.']
  counsel_bar_number varchar [note: 'State bar license number of the attorney representing this party. Validates counsel eligibility and supports defense-cost audit.']
  counsel_firm_name varchar [note: 'Name of the law firm representing this party on the claim. Populated when representation_type is attorney_represented. Used for defense cost tracking.']
  coverage_denial_reason varchar [note: 'Narrative or coded reason for a coverage denial determination for this party. Required for regulatory reporting and adverse-action notice compliance.']
  coverage_determination varchar [note: 'Outcome of the coverage analysis for this party\'s claim. Indicates whether the loss is covered, partially covered, denied, or pending underwriting review.']
  created_timestamp timestamp [note: 'Timestamp when this claim-party association record was first created in the Claims Administration System. Audit trail for record provenance.']
  demand_letter_date date [note: 'Date on which a formal demand letter was received from or sent to this party. Triggers response deadlines and escalation workflows in the claims system.']
  identity_verification_method varchar [note: 'Method used to verify the identity of this party. Supports fraud-control audit trails and regulatory compliance with FinCEN and GLBA requirements.']
  identity_verified_indicator boolean [note: 'Indicates whether the identity of this party has been verified through acceptable documentation (e.g., government-issued ID). Supports fraud controls and NPPI compliance.']
  insured_amount decimal(18,2) [note: 'Dollar amount of coverage applicable to this party under the referenced policy at the time of claim. Drives indemnity exposure calculation for claimants and insured parties.']
  is_adverse_party boolean [note: 'Indicates whether this party is an adverse party asserting a competing interest or title defect against the insured. Drives litigation and curative strategy.']
  is_insured_party boolean [note: 'Indicates whether this party holds insured status under the referenced title policy (OTP or LTP). Distinguishes insured parties from adverse or third-party participants.']
  is_primary_claimant boolean [note: 'Indicates whether this party is the primary claimant on the claim. True for the lead insured asserting the loss; False for co-claimants or other roles.']
  mailing_address_line1 varchar [note: 'First line of the mailing address for this party on the claim file. Used for legal notices and loss-payment correspondence. NPPI — restricted.']
  mailing_address_line2 varchar [note: 'Second line of the mailing address (suite, unit, floor) for this party. Supplements address line 1 for legal notice delivery. NPPI — restricted.']
  mailing_city varchar [note: 'City of the mailing address for this party. Required for legal notice delivery and state regulatory loss reporting. NPPI — restricted.']
  mailing_postal_code varchar [note: 'ZIP or ZIP+4 postal code for the party\'s mailing address. Supports geographic loss analysis and regulatory reporting.']
  mailing_state_code varchar [note: 'Two-letter USPS state abbreviation for the party\'s mailing address. Used for state DOI regulatory reporting and jurisdictional routing.']
  name_alias varchar [note: 'Alternate name, doing-business-as (DBA), or prior legal name for the party. Used in chain-of-title matching and adverse-party identification. NPPI — restricted.']
  notes varchar [note: 'Free-text adjuster or examiner notes specific to this party\'s involvement in the claim. Captures context not represented in structured fields.']
  notice_of_claim_date date [note: 'Date on which this party provided or received formal notice of the claim (FNOL). Anchors the claim reporting timeline and regulatory notice requirements.']
  nppi_vault_reference varchar [note: 'Tokenized reference key to the NPPI Vault record holding SSN/TIN, identity document, and signature data for this party. Actual NPPI is never stored in the lakehouse.']
  party_role varchar [note: 'Contextual role this party holds on the claim. One party may hold multiple simultaneous roles via separate records. [ENUM-REF-CANDIDATE']
  party_type varchar [note: 'Classification of the party as an individual person, legal organization, government entity, trust, or estate. Drives NPPI handling and legal notice requirements.']
  power_of_attorney_indicator boolean [note: 'Indicates whether this party is acting under a power of attorney on behalf of another principal. Triggers additional documentation and identity verification requirements.']
  recovery_amount decimal(18,2) [note: 'Dollar amount recovered or expected to be recovered from this party via subrogation or contribution. Populated when party_role is subrogation_target.']
  release_execution_date date [note: 'Date on which this party executed a release of claims or satisfaction instrument. Required before final loss payment disbursement and claim closure.']
  representation_type varchar [note: 'Indicates how the party is represented on the claim: self-represented, through retained counsel, guardian, power of attorney, or trustee.']
  resolution_status varchar [note: 'Current resolution status of this party\'s involvement in the claim. Tracks progression from open through settlement, release, litigation, or subrogation to closure.']
  role_effective_date date [note: 'Date on which this party\'s role became effective on the claim. Supports effective-dated role history per VREQ-005 and VREQ-007.']
  role_end_date date [note: 'Date on which this party\'s role on the claim ended or was superseded. Null if the role is currently active. Enables lifecycle history preservation.']
  role_status varchar [note: 'Current lifecycle status of this party\'s role on the claim. Tracks whether the party is actively participating, has withdrawn, or has been substituted.']
  settlement_agreement_date date [note: 'Date on which a settlement agreement was executed with this party. Marks the resolution milestone for loss-payment and claim-closure processing.']
  source_system_party_ref varchar [note: 'Identifier assigned to this claim-party association in the originating Claims Administration System (e.g., SoftPro, RamQuest). Supports lineage and reconciliation.']
  subrogation_potential varchar [note: 'Assessment of subrogation or recovery potential against this party. Populated for adverse parties and subrogation targets to support recovery tracking.']
  tax_id_vault_reference varchar [note: 'Tokenized reference key to the NPPI Vault for this party\'s TIN or SSN. Required for IRS 1099-S reporting on loss payments. Actual TIN/SSN never stored in the lakehouse.']
  title_risk_cause_code varchar [note: 'NAIC or internal code classifying the title-risk cause of loss for this party (e.g., forged deed, undisclosed lien, survey defect, chain-of-title break). Drives loss-ratio analytics by cause.']
  updated_timestamp timestamp [note: 'Timestamp when this claim-party association record was last modified. Supports change-data-capture and audit trail requirements.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Association entity linking a party to a title claim in a specific contextual role (claimant, insured_owner, insured_lender, adverse_party, defense_counsel, plaintiff_counsel, expert_witness, adjuster, examiner, subrogation_target), with role effective'
}

Table ti_claim.regulatory_loss_report {
  regulatory_loss_report_id varchar [pk, note: 'Unique surrogate identifier for each regulatory loss report record submitted to NAIC or state Department of Insurance.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Regulatory reports aggregate losses by county FIPS and property characteristics for NAIC statutory reporting.']
  superseded_report_id varchar [note: 'Reference to the prior regulatory_loss_report record that this amended or corrected filing supersedes, preserving revision history per VREQ-007.']
  title_claim_id varchar [note: 'Reference to the title insurance claim record that is the subject of or contributor to this regulatory loss report entry.']
  title_policy_id varchar [note: 'Reference to the issued title insurance policy (OTP or LTP) associated with the reported loss, linking claim to coverage.']
  acceptance_date date [note: 'Calendar date on which the NAIC or state DOI formally accepted this regulatory loss report filing, per VREQ-008 date field separation.']
  actuarial_opinion_date date [note: 'Date on which the qualified actuary signed and certified the actuarial opinion accompanying this regulatory loss report, if applicable.']
  actuary_certification_flag boolean [note: 'Indicates whether this regulatory loss report includes a certified actuarial opinion, required for IBNR actuarial filings and certain state DOI submissions.']
  amendment_number varchar [note: 'Sequential amendment version number for this report filing. Zero (0) indicates the original submission; increments with each amendment or correction filed.']
  average_claim_severity_amt decimal(18,2) [note: 'Average indemnity payment per closed claim with payment during the reporting period for this jurisdiction and policy type, in USD, used for actuarial severity analysis.']
  case_reserve_amt decimal(18,2) [note: 'Total case reserves held for known open claims as of the reporting period end date for this jurisdiction and policy type, in USD.']
  claim_count_closed varchar [note: 'Number of claims closed during the reporting period for this jurisdiction and policy type, including closures with and without payment.']
  claim_count_open_end varchar [note: 'Number of claims remaining open as of the reporting period end date for this jurisdiction and policy type, used for reserve adequacy analysis.']
  claim_count_reported varchar [note: 'Number of new claims reported (FNOL) during the reporting period for this jurisdiction and policy type combination, per NAIC Schedule T requirements.']
  created_timestamp timestamp [note: 'Timestamp when this regulatory loss report record was first created in the claims administration system, in ISO 8601 format with timezone offset.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this report record. Typically USD for U.S. title insurance regulatory filings.']
  direct_losses_paid_amt decimal(18,2) [note: 'Total indemnity and loss payments made to claimants during the reporting period for this jurisdiction, in USD, net of recoveries.']
  direct_premiums_written_amt decimal(18,2) [note: 'Total direct title insurance premiums written during the reporting period for this jurisdiction, in USD, as reported on NAIC Schedule T.']
  effective_date date [note: 'Date on which the data in this regulatory loss report is considered effective for regulatory purposes, per VREQ-008 date field separation.']
  filing_confirmation_number varchar [note: 'Confirmation or acknowledgment number assigned by the NAIC or state DOI system upon receipt of the electronic or portal submission.']
  filing_method varchar [note: 'Method used to submit this regulatory loss report to the regulator: ELECTRONIC (NAIC SERFF/iSite+), PAPER, or state-specific PORTAL.']
  ibnr_reserve_amt decimal(18,2) [note: 'Actuarially estimated reserve for claims incurred but not yet reported (IBNR) as of the reporting period end date, in USD, per actuarial filing requirements.']
  jurisdiction_state_fips varchar [note: 'Two-digit FIPS code identifying the U.S. state or territory to which this regulatory loss report is submitted, per NAIC Schedule T geographic breakdown.']
  jurisdiction_state_name varchar [note: 'Full name of the U.S. state or territory corresponding to the jurisdiction FIPS code, for display and reporting purposes.']
  loss_adjustment_expense_amt decimal(18,2) [note: 'Total allocated and unallocated loss adjustment expenses incurred during the reporting period, including investigation, legal, and curative costs, in USD.']
  loss_ratio decimal(10,6) [note: 'Ratio of net incurred losses to direct premiums written for the reporting period and jurisdiction, expressed as a decimal (e.g., 0.045 = 4.5%), a key regulatory metric.']
  naic_company_code varchar [note: 'Five-digit NAIC-assigned company code identifying the title insurance underwriter entity filing this regulatory loss report.']
  net_losses_amt decimal(18,2) [note: 'Total incurred losses minus recovery and subrogation amounts for the reporting period, representing the net loss retained by the underwriter, in USD.']
  policy_liability_amt decimal(18,2) [note: 'Total face amount of insurance liability (policy amount) across all policies contributing to this report row, representing aggregate exposure, in USD.']
  policy_type varchar [note: 'Type of title insurance policy associated with the reported loss: OWNER (OTP), LENDER/Loan (LTP), or Closing Protection Letter (CPL).']
  preparer_name varchar [note: 'Full name of the individual responsible for preparing and certifying this regulatory loss report filing on behalf of the title insurance company.']
  preparer_title varchar [note: 'Job title or designation of the individual who prepared this regulatory loss report (e.g., Chief Actuary, VP Claims, Compliance Officer).']
  production_channel varchar [note: 'Channel through which the underlying title order was produced: DIRECT_BRANCH, CENTRALIZED_LENDER, or INDEPENDENT_AGENT, for loss attribution by channel.']
  recovery_subrogation_amt decimal(18,2) [note: 'Total amounts recovered through subrogation, salvage, or other recovery actions during the reporting period, reducing net loss exposure, in USD.']
  regulatory_notes varchar [note: 'Free-text notes or explanatory comments accompanying this regulatory loss report, including disclosures, methodology changes, or regulator correspondence summaries.']
  rejection_reason varchar [note: 'Narrative reason provided by the NAIC or state DOI for rejecting this regulatory loss report filing, populated when report_status is REJECTED.']
  report_number varchar [note: 'Externally assigned or internally generated unique report identifier used in regulatory submissions and correspondence with NAIC or state DOI.']
  report_status varchar [note: 'Current lifecycle state of the regulatory loss report: DRAFT (in preparation), SUBMITTED (filed), ACCEPTED, REJECTED, AMENDED, or SUPERSEDED by a later filing.']
  report_type varchar [note: 'Classification of the regulatory filing: NAIC Annual Statement Schedule T, state DOI loss run, IBNR actuarial filing, quarterly loss report, or supplemental. [ENUM-REF-CANDIDATE: promote if values expand]']
  reporting_period_end_date date [note: 'Last calendar date of the reporting period covered by this regulatory loss report (e.g., December 31 of the statement year).']
  reporting_period_start_date date [note: 'First calendar date of the reporting period covered by this regulatory loss report (e.g., January 1 of the statement year).']
  resubmission_due_date date [note: 'Deadline by which a corrected or amended regulatory loss report must be resubmitted following a rejection, as specified by the regulator.']
  statement_year varchar [note: 'Four-digit calendar year of the NAIC Annual Statement or state DOI filing to which this loss report belongs (e.g., 2024).']
  submission_date date [note: 'Calendar date on which this regulatory loss report was submitted to the NAIC or state Department of Insurance, per VREQ-008 date field separation.']
  title_risk_cause_code varchar [note: 'Standardized code classifying the root cause of the title loss (e.g., undisclosed lien, chain-of-title break, forgery, encroachment, tax lien, mechanics lien). [ENUM-REF-CANDIDATE: promote to reference product]']
  title_risk_cause_description varchar [note: 'Narrative description of the title defect or risk cause underlying the reported loss, supplementing the structured cause code for regulatory and actuarial review.']
  total_incurred_losses_amt decimal(18,2) [note: 'Sum of losses paid plus change in case and IBNR reserves for the reporting period, representing total loss exposure incurred, in USD.']
  transaction_type varchar [note: 'Real estate transaction type underlying the insured policy: PURCHASE, REFINANCE (REFI), HOME_EQUITY (HELOC), CONSTRUCTION, or COMMERCIAL.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this regulatory loss report record in the claims administration system, in ISO 8601 format with timezone offset.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']

  Note: 'Periodic regulatory loss-reporting record submitted to NAIC and state Departments of Insurance, capturing reporting period, jurisdiction (state FIPS), report type (NAIC Annual Statement Schedule T, state DOI loss run, IBNR actuarial filing), total claims'
}

Table ti_claim.coverage_decision {
  coverage_decision_id varchar [pk, note: 'Unique surrogate identifier for the coverage decision record. Primary key for the coverage_decision entity within the Claims Administration System.']
  coverage_approving_authority_party_id varchar [note: 'Reference to the supervisor, underwriting manager, or counsel who approved the coverage decision, required when the decision exceeds delegated authority thresholds.']
  coverage_party_id varchar [note: 'Reference to the claims examiner or underwriting counsel who authored and issued the coverage determination. Primary party responsible for the decision.']
  curative_action_id varchar [note: 'Reference to the claim curative action record initiated as part of or in lieu of indemnity payment for this coverage decision.']
  investigation_id varchar [note: 'Reference to the claim investigation that produced the factual and legal basis for this coverage determination.']
  parcel_id varchar [note: 'Foreign key linking to property.parcel. Business justification: Coverage decisions cite Schedule A legal descriptions and exceptions tied to specific parcels.']
  prior_decision_coverage_decision_id varchar [note: 'Reference to the preceding coverage decision record that this record revises or supersedes. Supports lifecycle history and revision chain tracking per VREQ-007.']
  recorded_instrument_id varchar [note: 'Foreign key linking to recording.recorded_instrument. Business justification: Coverage decisions reference specific recorded instruments to determine whether defect falls within Schedule B exceptions or covered risks.']
  title_claim_id varchar [note: 'Reference to the parent title insurance claim for which this coverage determination was made. Links the decision to the full claim lifecycle record.']
  title_commitment_id varchar [note: 'Foreign key linking to underwriting.title_commitment. Business justification: Coverage counsel analyzes the commitment to verify whether the loss cause was excepted in Schedule B, required to be satisfied, or covered.']
  title_finding_id varchar [note: 'Foreign key linking to underwriting.title_finding. Business justification: Coverage analysis traces the claimed defect back to the original title finding to determine if it was disclosed, cured, or excepted.']
  title_policy_id varchar [note: 'Reference to the issued title insurance policy (OTP or LTP) under which coverage is being evaluated. Anchors the decision to the insuring instrument.']
  underwriting_title_examination_id varchar [note: 'Foreign key linking to underwriting.underwriting_title_examination. Business justification: Coverage counsel reviews the examination to assess whether the defect was discoverable, whether the examiner exercised due care, and whether the examination scope']
  uw_referral_id varchar [note: 'Reference to the underwriting referral record when uw_referral_required_flag is true. Links the coverage decision to the formal UW opinion.']
  appeal_deadline_date date [note: 'The date by which the claimant must file an appeal or request reconsideration of the coverage decision, per policy terms and state regulatory requirements.']
  appeal_received_date date [note: 'Date on which a formal appeal or reconsideration request was received from the claimant or their counsel following issuance of the coverage decision.']
  chain_of_title_break_flag boolean [note: 'Indicates whether a break in the chain of title (COT) is the root cause of the covered or denied loss, supporting title-specific defect analytics.']
  coverage_analysis_narrative varchar [note: 'Full text of the coverage analysis explaining the legal and factual basis for the coverage position, including policy provisions, exclusions, and exceptions applied.']
  coverage_position varchar [note: 'Formal coverage determination outcome: covered (full indemnity), denied (no coverage), partial (limited coverage), reservation_of_rights (coverage not yet confirmed), or excess_only.']
  covered_loss_amount decimal(18,2) [note: 'The dollar amount of the claimed loss determined to be covered under the policy. May be less than the claimed loss amount for partial coverage decisions.']
  covered_risk_number varchar [note: 'ALTA policy covered risk number (e.g., Covered Risk 1, 8, 11) that affirmatively supports coverage for the claimed loss, cited in the coverage analysis.']
  curative_resolution_required_flag boolean [note: 'Indicates whether the coverage decision is conditioned on or accompanied by a curative action to resolve the underlying title defect before or after indemnity.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this coverage decision record. Defaults to USD for domestic U.S. title transactions.']
  decision_date date [note: 'Calendar date on which the formal coverage position was determined and documented by the claims examiner or underwriting counsel.']
  decision_number varchar [note: 'Externally-visible alphanumeric identifier assigned to this coverage decision by the Claims Administration System. Used in correspondence and regulatory reporting.']
  decision_status varchar [note: 'Current lifecycle state of the coverage decision. Tracks progression from initial draft through issuance, any appeal or revision, and final disposition.']
  decision_timestamp timestamp [note: 'Precise date and time the coverage decision record was created in the Claims Administration System. Supports audit trail and SLA measurement.']
  decision_type varchar [note: 'Classifies the decision as initial (first determination), supplemental (additional coverage analysis), revised (updated position), or final (closing determination).']
  denial_reason_code varchar [note: 'Standardized code identifying the primary reason for a coverage denial or limitation (e.g., known_defect, policy_exclusion, schedule_b_exception, no_insured_loss).']
  denial_reason_description varchar [note: 'Free-text explanation of the denial reason, supplementing the denial_reason_code with specific facts and policy language supporting the denial.']
  denied_loss_amount decimal(18,2) [note: 'The dollar amount of the claimed loss determined not to be covered under the policy. Supports partial coverage and denial analytics.']
  endorsement_applicability_flag boolean [note: 'Indicates whether one or more ALTA endorsements attached to the policy affect the scope of coverage for this claim (e.g., ALTA 9, ALTA 8.1, ALTA 22).']
  endorsement_references varchar [note: 'Comma-separated list of ALTA endorsement numbers (e.g., ALTA 9, ALTA 8.1) that expand or restrict coverage and are cited in this coverage determination.']
  exception_item_reference varchar [note: 'Specific Schedule B-II exception item number or description from the issued policy that limits or bars coverage for the claimed loss.']
  excess_amount decimal(18,2) [note: 'For excess_only coverage positions, the dollar amount of loss that falls above the primary coverage layer and is subject to excess policy terms.']
  exclusion_number varchar [note: 'Specific exclusion number from the ALTA policy form (e.g., Exclusion 3(a), Exclusion 5) cited as the basis for a denial or limitation of coverage.']
  gap_coverage_flag boolean [note: 'Indicates whether the claim arises from a gap period between the effective date of the title search and the recording of the insured instrument.']
  issued_timestamp timestamp [note: 'Date and time the coverage decision was formally communicated to the claimant or their counsel. Distinct from the internal decision date.']
  last_updated_timestamp timestamp [note: 'Date and time the coverage decision record was most recently modified. Supports change tracking and audit compliance.']
  litigation_flag boolean [note: 'Indicates whether the coverage decision is associated with active or anticipated litigation, triggering legal hold and outside counsel engagement protocols.']
  outside_counsel_engaged_flag boolean [note: 'Indicates whether outside legal counsel has been retained to support the coverage analysis, defense, or curative resolution associated with this decision.']
  partial_coverage_description varchar [note: 'Narrative describing the scope and limitations of partial coverage when coverage_position is \'partial\', specifying what is and is not covered.']
  policy_liability_amount decimal(18,2) [note: 'The face amount of insurance coverage under the policy at the time of the coverage decision. Establishes the maximum indemnity ceiling for this claim.']
  policy_type varchar [note: 'Indicates whether the policy under review is an Owner\'s Title Policy (OTP) or a Loan/Lender\'s Title Policy (LTP), per ALTA policy form classification.']
  prompt_pay_compliant_flag boolean [note: 'Indicates whether the coverage decision was issued within the state-mandated prompt-pay deadline. Supports regulatory compliance monitoring and DOI reporting.']
  regulatory_prompt_pay_deadline date [note: 'State-mandated deadline by which the insurer must issue a coverage decision or payment following receipt of a complete proof of loss, per state prompt-pay statutes.']
  revision_reason varchar [note: 'Explanation of why this coverage decision was revised from the prior version, such as new evidence, appeal outcome, or change in legal interpretation.']
  revision_sequence varchar [note: 'Sequential integer indicating the revision number of this coverage decision for the associated claim. Value 1 = initial decision; increments with each revision.']
  ror_basis_description varchar [note: 'Explanation of the legal and factual basis for issuing a reservation of rights letter when coverage_position is \'reservation_of_rights\', pending further investigation.']
  schedule_a_reference varchar [note: 'Citation to the Schedule A provision of the title policy (insured estate, vesting, legal description) relied upon in the coverage analysis.']
  schedule_b_section varchar [note: 'Identifies which Schedule B section is implicated: B-I (Requirements), B-II (Exceptions), both, or none. Drives the legal basis for denial or limitation.']
  state_code varchar [note: 'Two-letter USPS state code for the jurisdiction governing the policy and coverage decision. Determines applicable state DOI regulations and reporting requirements.']
  title_risk_cause_code varchar [note: 'Standardized code classifying the root title defect or risk giving rise to the claim (e.g., forgery, undisclosed lien, chain-of-title break, encroachment). Used for loss ratio analytics.']
  uw_referral_required_flag boolean [note: 'Indicates whether this coverage decision required escalation to the underwriting department for a formal underwriting opinion before the position could be issued.']
  change_date timestamp [note: 'Date and time when this record was last modified']
  changed_by varchar [note: 'User or process that last modified this record']
  created_by varchar [note: 'User or process that created this record']
  creation_date timestamp [note: 'Date and time when this record was created']
  valid_from timestamp [note: 'Start date when this record version became effective']
  valid_to timestamp [note: 'End date when this record version ceased to be effective (NULL if current)']

  Note: 'First-class coverage determination record for a title claim, capturing the formal coverage position (covered, denied, partial, reservation_of_rights, excess_only), the policy provision or exclusion relied upon (Schedule A/B reference, exclusion number'
}

