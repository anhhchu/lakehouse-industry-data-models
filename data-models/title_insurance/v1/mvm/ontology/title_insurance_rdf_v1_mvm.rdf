# RDFS Schema for Business: Title_Insurance

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/title_insurance#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Title_Insurance ---
ind:TitleInsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Title_Insurance' ;
    rdfs:comment 'A United States title-insurance and settlement-services business serving residential purchase, refinance, home-equity, construction, and selected commercial real-estate transactions. Services include title-order intake, title search and examination, curative processing, underwriting, commitments, owner and lender policies, endorsements, closing, settlement, escrow, recording, property information, independent-agent oversight, premium remittance, and claims administration. Business is produced through direct branches, centralized lender channels, and independent title agents. The model must preserve evidence, provenance, effective-dated ownership interests, lifecycle history, and the legal and operational distinctions among searches, examinations, findings, requirements, exceptions, commitments, policies, settlement statements, and escrow ledgers.' .

# --- Domain Classes ---
ind:Operations rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Operations' ;
    rdfs:comment 'Core operational backbone owning the title-production transaction spine: title-order intake and channel routing (direct branch, centralized lender, independent agent), order lifecycle and status tracking, transaction-type classification (purchase' .

ind:Property rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Property' ;
    rdfs:comment 'Authoritative SSOT for real-property identity and reference data, modeled as three legally distinct entities: property, parcel, and legal_description. Owns APN/PIN identifiers, FIPS county codes, legal descriptions (metes-and-bounds, PLSS' .

ind:Underwriting rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Underwriting' ;
    rdfs:comment 'Owns the title underwriting risk and policy lifecycle as legally distinct entities: title_finding, title_requirement (Schedule B-I), policy_exception (Schedule B-II), curative actions (CPM/GAPcure), underwriting referrals (UWR) and underwriting decisions' .

ind:Settlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Settlement' ;
    rdfs:comment 'Revenue-adjacent, customer-facing domain owning the closing and settlement lifecycle with settlement_statement and escrow_ledger kept as distinct, separate entities.' .

ind:Recording rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Recording' ;
    rdfs:comment 'Manages post-closing document recording as legally distinct recording_submission and recorded_instrument entities. Owns submission to county recorders / registers of deeds via eRecording gateways, acceptance/rejection/resubmission workflows, recording' .

ind:Agency rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Agency' ;
    rdfs:comment 'Owns the independent title-agent channel and distribution relationships: agent onboarding, licensing and E&O verification, agency-agreement and authority-level management, CPL issuance, ongoing oversight and compliance monitoring, premium remittance' .

ind:Claim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:TitleInsurance ;
    rdfs:label 'Claim' ;
    rdfs:comment 'Administers the full title-insurance claims lifecycle: FNOL intake, investigation, coverage analysis, reserving (case and IBNR), loss payment, recovery/subrogation, and claim closure.' .

# --- Data Product Classes (Tables) ---
ind:TitleFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Title Finding' ;
    rdfs:comment 'Authoritative SSOT for every defect, encumbrance, lien, cloud, or anomaly discovered during title examination. Each record captures the finding type (tax lien, judgment lien, mechanics lien, LP, UCC, easement, encroachment, chain-of-title break, vesting' .

ind:TitleRequirement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Title Requirement' ;
    rdfs:comment 'SSOT for Schedule B-I requirements — the curative actions that must be satisfied before a title commitment can be issued or a policy can be written. Each record links to the originating title_finding, specifies the required action (payoff, release' .

ind:PolicyException rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Policy Exception' ;
    rdfs:comment 'SSOT for Schedule B-II exceptions — matters that are excluded from coverage in the issued title policy. Each record identifies the exception type (easement, CC&R, ROW, HOA, survey matter, mineral rights, etc.), its source instrument, whether it is a' .

ind:TitleCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Title Commitment' ;
    rdfs:comment 'SSOT for the title commitment instrument — the conditional promise to issue a title policy. Each record represents a distinct commitment version (initial issuance plus each revision/amendment), capturing Schedule A data (proposed insured, estate/interest' .

ind:TitlePolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Title Policy' ;
    rdfs:comment 'SSOT for issued title insurance policies. Owner (OTP) and lender (LTP) policies are stored as separate records with separate policy_type values, satisfying VREQ-010.' .

ind:Endorsement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Endorsement' ;
    rdfs:comment 'Records each ALTA endorsement attached to an owner or lender title policy. Each record captures the endorsement form number (ALTA 9, ALTA 8.1, ALTA 22, ALTA 28, etc.), endorsement description, additional premium, effective date, and the parent' .

ind:UwReferral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Uw Referral' ;
    rdfs:comment 'Tracks underwriting referral (UWR) events — the escalation of a title order or commitment to an underwriter for risk review. Each record captures the referral trigger (high-liability amount, complex defect, gap coverage, prior claim, commercial' .

ind:CurativeAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Curative Action' ;
    rdfs:comment 'Tracks each discrete curative step taken to satisfy an open title_requirement or resolve a title_finding. Each record captures the action type (payoff request, lien release, affidavit of heirship, probate filing, survey correction, GAPcure, CPM memo' .

ind:UnderwritingTitleExamination rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Underwriting Title Examination' ;
    rdfs:comment 'SSOT for the title examination record — the formal examiner review of assembled search results that produces title_findings and drives title_requirements. Each record captures examiner identity, examination date, examination type (full, limited' .

ind:AgentAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Agent Authority' ;
    rdfs:comment 'Effective-dated authority record defining the specific underwriting authority level granted to an independent title agent under an agency agreement, including authority tier (standard, limited, expanded, commercial), maximum insured amount, transaction' .

ind:AgentLicense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Agent License' ;
    rdfs:comment 'Effective-dated record of each state-issued title insurance producer or agent license held by an agent entity, including license number, state FIPS code, license class, issue date, expiration date, renewal date, and current status (active, suspended' .

ind:AgentProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Agent Profile' ;
    rdfs:comment 'Master record and SSOT for every independent title agent (ITA), direct branch, and lender-channel partner in the distribution network. Captures agent identity, legal entity name, DBA, NAIC code, state license numbers, E&O carrier/policy references' .

ind:Agreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Agreement' ;
    rdfs:comment 'Formal agency agreement between the title underwriter and an independent title agent or direct branch, governing the scope of authority, geographic territory, transaction types, premium split schedule, remittance terms, and compliance obligations.' .

ind:EoCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Eo Coverage' ;
    rdfs:comment 'Errors and Omissions (E&O) insurance coverage record for an independent title agent, capturing carrier name, policy number, coverage effective date, expiration date, per-occurrence limit, aggregate limit, deductible, and verification status.' .

ind:PremiumSplitSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Premium Split Schedule' ;
    rdfs:comment 'Reference (non-transactional) schedule defining contractual agent/underwriter premium split rates for an agency agreement, segmented by transaction type (residential purchase, refinance, HELOC, commercial), policy type (owner OTP vs lender LTP), state' .

ind:CplIssuance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Cpl Issuance' ;
    rdfs:comment 'Closing Protection Letter (CPL) issuance record representing a specific CPL issued by the underwriter on behalf of an independent title agent for a given transaction or lender.' .

ind:OversightReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Oversight Review' ;
    rdfs:comment 'Periodic compliance and performance oversight review record for an independent title agent, capturing review type (annual audit, random file review, E&O verification, licensing check, remittance audit), review date, reviewer identity, findings summary' .

ind:RecordingSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Recording Submission' ;
    rdfs:comment 'Authoritative SSOT for each document recording submission sent to a county recorder or register of deeds via an eRecording gateway (Simplifile, CSC eRecording) or physical delivery.' .

ind:RecordedInstrument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Recorded Instrument' ;
    rdfs:comment 'Authoritative SSOT for each individual legal instrument (deed, deed of trust, mortgage, release, reconveyance, assignment, UCC, lis pendens, easement) accepted and stamped by the county recorder or register of deeds.' .

ind:SubmissionDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Submission Document' ;
    rdfs:comment 'Line-item entity representing each individual document within a recording_submission (e.g., a deed, deed of trust, release, and subordination agreement as separate documents), each with its own document type, page count, recording fee, execution date' .

ind:RejectionEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Rejection Event' ;
    rdfs:comment 'Transactional SSOT for each discrete rejection notice returned for a recording submission or an individual submission_document, carrying an explicit grain flag (submission-level vs document-level).' .

ind:GapCoveragePeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Gap Coverage Period' ;
    rdfs:comment 'Tracks the GAP coverage window for each title order — the legally significant interval between the closing date (or last search date) and the confirmed recording date of the insured instruments.' .

ind:Fee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Fee' ;
    rdfs:comment 'Reference master for county-level and instrument-type-level recording fee schedules maintained per jurisdiction (FIPS county code). Captures fee type (base recording fee, per-page fee, transfer tax, documentary stamp tax, mortgage tax, indexing fee), fee' .

ind:Jurisdiction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Master reference for every county recorder or register of deeds office that the business submits documents to. Captures FIPS county code, state, office name, recording office address, accepted submission channels (eRecording, mail, in-person), eRecording' .

ind:SubmissionStatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Submission Status History' ;
    rdfs:comment 'Immutable lifecycle history table preserving every status transition for a recording_submission — from initial submission through any rejections, curative corrections, resubmissions, and final acceptance or recording confirmation.' .

ind:TitleOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Title Order' ;
    rdfs:comment 'Core transaction spine for the operations domain. Represents a single title-insurance order from intake through closing, capturing transaction type (purchase, refinance, HELOC, construction, commercial), channel routing (direct branch, centralized lender' .

ind:Party rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Party' ;
    rdfs:comment 'Master entity for every natural person or legal entity participating in a title transaction. Stores identity attributes (name, entity type, tax-ID reference, contact information, address) without embedding a role.' .

ind:PartyRole rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Party Role' ;
    rdfs:comment 'Association entity assigning a party (party_id) to a specific contextual role on a specific title_order, enabling one party to hold multiple simultaneous roles (e.g., buyer and borrower, or seller and trustee) per VREQ-006.' .

ind:TitleSearch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Title Search' ;
    rdfs:comment 'Legally and operationally distinct entity representing the execution of a title search against public records and the title plant for a specific order. Captures search type (full, update, O&E, two-owner, 30-year), search vendor or plant source (DataTrace' .

ind:OperationsTitleExamination rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Operations Title Examination' ;
    rdfs:comment 'Legally and operationally distinct entity representing the examiner\'s review and analysis of search results for a specific title order. Captures examiner identity, examination date, examination status (in-progress, complete, referred), overall title' .

ind:OrderStatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Order Status History' ;
    rdfs:comment 'Lifecycle history entity that preserves every status transition of a title order from intake through closing and post-closing. Captures prior status, new status, transition timestamp, triggering user or system, transition reason code, and any SLA' .

ind:OperationsCurativeAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Operations Curative Action' ;
    rdfs:comment 'Operational entity tracking each curative step taken to clear a title requirement or defect identified during examination. Captures the linked title requirement (owned by underwriting domain), curative action type (obtain release, record reconveyance' .

ind:OrderChannel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Order Channel' ;
    rdfs:comment 'Reference master classifying the origination and routing channels through which title orders are received and processed (direct branch, centralized lender, independent agent, consumer direct, wholesale).' .

ind:TitleClaim rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Title Claim' ;
    rdfs:comment 'Master record for every title-insurance claim filed against an issued OTP or LTP. Captures FNOL intake details, claim type (title defect, lien, encumbrance, encroachment, forgery, fraud, survey, access, etc.), coverage analysis outcome, policy linkage' .

ind:Event rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Event' ;
    rdfs:comment 'Immutable lifecycle-event log for a title claim, preserving every material status transition, coverage decision, assignment change, and reserve movement as a timestamped event record.' .

ind:Reserve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Reserve' ;
    rdfs:comment 'Effective-dated reserve record for a title claim, capturing case reserve and IBNR reserve amounts, reserve type (case, IBNR, bulk), currency, reserve basis (initial, revised, final), set-by underwriter or actuary, effective date, expiration date, and' .

ind:LossPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Loss Payment' ;
    rdfs:comment 'Transactional record of each indemnity disbursement made on a title claim, including payment type (indemnity, curative cost, defense cost, settlement, court-ordered), payee party, payment method (wire, check, ACH), payment amount, currency, payment date' .

ind:RecoveryReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Recovery Receipt' ;
    rdfs:comment 'Transactional record of each recovery or subrogation receipt collected on a title claim, capturing recovery type (subrogation, contribution, salvage, reinsurance recovery), recovery source party, recovery amount, currency, receipt date, recovery method' .

ind:Investigation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Investigation' ;
    rdfs:comment 'Master record for the investigation phase of a title claim, capturing investigation status (open, pending_docs, pending_legal, complete), assigned investigator, investigation start and completion dates, investigation findings narrative, documents' .

ind:ClaimCurativeAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Claim Curative Action' ;
    rdfs:comment 'Tracks each curative action taken to resolve a title defect or requirement identified during a claim investigation or pre-policy examination, including action type (lien release, deed correction, quiet title, probate, affidavit of heirship, reconveyance' .

ind:ClaimParty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Claim Party' ;
    rdfs:comment 'Association entity linking a party to a title claim in a specific contextual role (claimant, insured_owner, insured_lender, adverse_party, defense_counsel, plaintiff_counsel, expert_witness, adjuster, examiner, subrogation_target), with role effective' .

ind:RegulatoryLossReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Regulatory Loss Report' ;
    rdfs:comment 'Periodic regulatory loss-reporting record submitted to NAIC and state Departments of Insurance, capturing reporting period, jurisdiction (state FIPS), report type (NAIC Annual Statement Schedule T, state DOI loss run, IBNR actuarial filing), total claims' .

ind:ClosingOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Closing Order' ;
    rdfs:comment 'Master record for a closing/settlement engagement, representing the scheduling and coordination of a closing event tied to a title order. Tracks closing type (purchase, refinance, HELOC, construction), closing method (wet-sign, RON, IPEN, hybrid)' .

ind:SettlementStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Settlement Statement' ;
    rdfs:comment 'Legally and operationally distinct settlement statement record capturing the final financial accounting of a real estate closing. Stores statement form type (CD/Closing Disclosure, HUD-1, ALTA Settlement Statement), statement version and revision number' .

ind:EscrowLedger rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Escrow Ledger' ;
    rdfs:comment 'Legally and operationally distinct escrow trust account ledger tracking every receipt and disbursement within the IOLTA/trust account for a specific closing.' .

ind:Disbursement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Disbursement' ;
    rdfs:comment 'Individual disbursement record representing a single outgoing payment from the escrow trust account at or after closing. Captures disbursement type (payoff/reconveyance, seller proceeds, commission, recording fee, title premium, HOA assessment, tax' .

ind:WireInstruction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Wire Instruction' ;
    rdfs:comment 'Master record for wire transfer instructions associated with a closing party (seller, borrower, lender, payoff lender, HOA, commission recipient). Captures beneficiary name, bank name, ABA routing number, account number (encrypted/tokenized per NPPI' .

ind:PremiumCharge rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Premium Charge' ;
    rdfs:comment 'Transactional record capturing the title insurance premium and related fee charges calculated and assessed at closing for a specific transaction. Tracks charge type (OTP owner title premium, LTP lender title premium, endorsement fee, search fee, exam fee' .

ind:ClosingDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Closing Document' ;
    rdfs:comment 'Master record for each document executed or collected during the closing event (loan documents, deeds, affidavits, title affidavits, ALTA statements, 1099-S forms, transfer tax declarations, power of attorney, identity documents).' .

ind:EscrowReconciliation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Escrow Reconciliation' ;
    rdfs:comment 'Periodic three-way reconciliation record for the escrow trust account, comparing the escrow ledger balance against the bank statement balance and the aggregate of open file balances.' .

ind:Property rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Property' ;
    rdfs:comment 'Authoritative SSOT master record for a real-property asset as a legally distinct entity separate from parcel and legal_description. Captures the property type (residential, commercial, condo, co-op, vacant land, construction), transaction type (purchase' .

ind:Parcel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Parcel' ;
    rdfs:comment 'Legally distinct entity representing the assessor parcel as defined by the county recorder or assessor office. Owns the APN (Assessor\'s Parcel Number), PIN (Parcel Identification Number), FIPS county code, tax account number, acreage, lot dimensions, and' .

ind:LegalDescription rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Legal Description' ;
    rdfs:comment 'Legally distinct entity capturing the full text and structured components of the property\'s legal description as it appears in recorded instruments and title commitments (Schedule A).' .

ind:OwnershipInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Ownership Interest' ;
    rdfs:comment 'Effective-dated ownership interest record representing a vested ownership stake in a property held by a party (individual, trust, entity, or co-owner). Implements VREQ-005: ownership is modeled as a set of time-bounded interest records supported by' .

ind:TitleEvidence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Title Evidence' ;
    rdfs:comment 'Provenance and evidence record capturing each source document or data artifact used to establish or support an ownership interest, encumbrance, easement, survey/plat, or chain-of-title link.' .

ind:Encumbrance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Encumbrance' ;
    rdfs:comment 'Master record for each encumbrance, lien, or cloud on title affecting a parcel or property. Covers tax liens (federal, state, county), mechanics liens, judgment liens, HOA assessment liens, lis pendens (LP), deeds of trust (DOT), mortgages (PMM, HELOC' .

ind:EasementRestriction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Easement Restriction' ;
    rdfs:comment 'Master record for easements, rights-of-way (ROW), covenants, conditions and restrictions (CC&Rs), encroachments, and other use restrictions affecting a parcel.' .

ind:TaxAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Tax Assessment' ;
    rdfs:comment 'Annual or supplemental tax and assessment record for a parcel, sourced from the county assessor and tax collector. This product is the AUTHORITATIVE SSOT for year-by-year valuation and payment history; parcel carries only current/point-in-time summary' .

ind:LifecycleEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Lifecycle Event' ;
    rdfs:comment 'Transactional record capturing material lifecycle transitions and reclassifications for a property, parcel, or ownership interest per VREQ-007. Event types include: property type reclassification, parcel split/merge, legal description amendment, vesting' .

ind:ServiceLevel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Operations ;
    rdfs:label 'Service Level' ;
    rdfs:comment 'Reference/master entity defining service-level agreements and turn-time commitments applied to title orders by channel, transaction type, and product tier.' .

ind:GatewayTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Recording ;
    rdfs:label 'Gateway Transaction' ;
    rdfs:comment 'Transactional SSOT for each eRecording gateway exchange (Simplifile, CSC eRecording, ePN) associated with a recording_submission. Captures the gateway package identifier, gateway vendor, outbound submission acknowledgment (ACK/NACK), gateway pre-screen' .

ind:AgentRemittance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Agent Remittance' ;
    rdfs:comment 'Transactional header record for a periodic premium remittance submitted by (or billed to) an independent title agent to the underwriter, representing the agency-settlement cycle.' .

ind:RemittanceLine rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Agency ;
    rdfs:label 'Remittance Line' ;
    rdfs:comment 'Line-level detail of an agent_remittance, one row per policy/transaction premium being remitted. Captures source policy or order reference, policy type (owner/lender), gross premium, applied premium_split_schedule rate, computed underwriter share' .

ind:CoverageDecision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Claim ;
    rdfs:label 'Coverage Decision' ;
    rdfs:comment 'First-class coverage determination record for a title claim, capturing the formal coverage position (covered, denied, partial, reservation_of_rights, excess_only), the policy provision or exclusion relied upon (Schedule A/B reference, exclusion number' .

ind:EscrowReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Settlement ;
    rdfs:label 'Escrow Receipt' ;
    rdfs:comment 'Individual incoming funds-received record representing a single deposit into the escrow/IOLTA trust account for a specific closing (EMD/earnest money receipt, loan proceeds wire-in, buyer cash-to-close, seller contribution, HOA/payoff overfund return).' .

ind:GrantorGranteeIndex rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Property ;
    rdfs:label 'Grantor Grantee Index' ;
    rdfs:comment 'Index record linking a grantor party and a grantee party to a recorded instrument affecting a parcel or property, supporting grantor/grantee name-index searches as performed against the title plant and county recorder indices.' .

ind:Decision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Underwriting ;
    rdfs:label 'Decision' ;
    rdfs:comment 'SSOT for discrete underwriting decisions and the AUTHORITATIVE insurable/marketable-title determination — the formal risk-acceptance determinations made by an underwriter, kept distinct from the uw_referral event that may trigger them and from the' .

# --- Attribute Properties ---
ind:agentAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Agent Authority Id' ;
    rdfs:comment 'Unique surrogate identifier for the effective-dated agent authority record. Primary key for the agent_authority product in the Agency Management and Remittance System.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agencyAgreementId rdf:type rdf:Property ;
    rdfs:label 'Agency Agreement Id' ;
    rdfs:comment 'Reference to the parent agency agreement under which this authority level is granted. Links authority record to the governing contractual relationship between agent and underwriter.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agreement .

ind:agentProfileId rdf:type rdf:Property ;
    rdfs:label 'Agent Profile Id' ;
    rdfs:comment 'Reference to the independent title agent party record. Identifies the licensed agent entity to whom this underwriting authority is granted.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AgentProfile .

ind:priorAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Prior Authority Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding authority record that this record supersedes. Enables chain-of-authority history and lifecycle revision tracking per VREQ-007.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AgentAuthority .

ind:agentPremiumSplitPct rdf:type rdf:Property ;
    rdfs:label 'Agent Premium Split Pct' ;
    rdfs:comment 'Contractual percentage of gross title insurance premium retained by the agent (the \'split\') under this authority agreement. Expressed as a decimal (e.g., 0.7000 = 70%). Confidential commercial term.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalDate rdf:type rdf:Property ;
    rdfs:label 'Approval Date' ;
    rdfs:comment 'Date on which the underwriter formally approved this authority grant. Distinct from effective_date — approval may precede the authority\'s effective start date.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Underwriter approval workflow status for this authority grant. Distinct from authority_status — captures the internal approval lifecycle before the authority becomes active.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedBy rdf:type rdf:Property ;
    rdfs:label 'Approved By' ;
    rdfs:comment 'Name or identifier of the underwriter representative who approved this authority grant. Provides audit trail for authority approval decisions.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityNotes rdf:type rdf:Property ;
    rdfs:label 'Authority Notes' ;
    rdfs:comment 'Free-text field for underwriter-recorded conditions, restrictions, or special instructions associated with this authority grant not captured in structured fields.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityNumber rdf:type rdf:Property ;
    rdfs:label 'Authority Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned by the underwriter to this specific authority grant. Used in policy jackets, CPL issuance, and remittance reconciliation as the SSOT reference code.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityStatus rdf:type rdf:Property ;
    rdfs:label 'Authority Status' ;
    rdfs:comment 'Current lifecycle state of this authority record. Controls whether the agent may issue policies under this authority grant. Drives compliance monitoring and oversight workflows.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityTier rdf:type rdf:Property ;
    rdfs:label 'Authority Tier' ;
    rdfs:comment 'Classification of the underwriting authority level granted to the agent. Determines the scope of transactions the agent may independently underwrite without referral.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelType rdf:type rdf:Property ;
    rdfs:label 'Channel Type' ;
    rdfs:comment 'Distribution channel classification for this authority record. Distinguishes independent title agents from direct branch operations and centralized lender channel partners.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commercialMaxInsuredAmount rdf:type rdf:Property ;
    rdfs:label 'Commercial Max Insured Amount' ;
    rdfs:comment 'Maximum insured amount for commercial real estate transactions specifically. May differ from max_insured_amount which applies to residential. Null if commercial transactions are not authorized.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countyFipsCode rdf:type rdf:Property ;
    rdfs:label 'County Fips Code' ;
    rdfs:comment 'Five-digit FIPS county code further restricting the geographic scope of this authority to a specific county or set of counties. Null if authority applies statewide.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Cpl Authority Flag' ;
    rdfs:comment 'Indicates whether the agent is authorized to issue Closing Protection Letters (CPLs) under this authority grant. CPL issuance requires explicit underwriter authorization separate from policy issuance authority.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:createdTimestamp rdf:type rdf:Property ;
    rdfs:label 'Created Timestamp' ;
    rdfs:comment 'Timestamp when this authority record was first created in the Agency Management and Remittance System. Audit trail for record provenance per SOC 2 and ALTA Best Practices.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:currencyCode rdf:type rdf:Property ;
    rdfs:label 'Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code applicable to the max_insured_amount and premium split thresholds. Typically USD for domestic US title transactions.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'Date on which this authority grant becomes binding and the agent is authorized to issue policies under its terms. Start of the effective-dated authority period per VREQ-008.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endorsementAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Endorsement Authority Flag' ;
    rdfs:comment 'Indicates whether the agent is authorized to issue ALTA endorsements (e.g., ALTA 9, ALTA 8.1, ALTA 22) independently without underwriter countersignature under this authority grant.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Amount' ;
    rdfs:comment 'Dollar amount of E&O insurance coverage in force for the agent at the time this authority was granted. Must meet underwriter minimum requirements for the authority tier.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eoExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Eo Expiration Date' ;
    rdfs:comment 'Expiration date of the agent\'s E&O insurance policy. Monitoring this date against authority_status supports ongoing compliance oversight and lapse detection.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eoPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Eo Policy Number' ;
    rdfs:comment 'Policy number of the agent\'s Errors and Omissions (E&O) insurance policy verified at the time this authority was granted. Required by underwriters as a condition of agency appointment.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Escrow Authority Flag' ;
    rdfs:comment 'Indicates whether the agent is authorized to conduct escrow and settlement services (hold IOLTA/trust funds, disburse proceeds) under this authority grant.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date on which this authority grant expires and the agent\'s authorization to issue policies under its terms ends. Null indicates an open-ended authority subject to agreement termination.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapCoverageAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Authority Flag' ;
    rdfs:comment 'Indicates whether the agent is authorized to provide gap coverage (GAP) — insuring the period between closing and recording — under this authority grant without underwriter countersignature.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:licenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'License Expiration Date' ;
    rdfs:comment 'Expiration date of the agent\'s state title insurance license. Authority cannot remain active beyond license expiration. Supports compliance monitoring and oversight workflows.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseNumber rdf:type rdf:Property ;
    rdfs:label 'License Number' ;
    rdfs:comment 'State-issued title insurance agent or title company license number verified at the time this authority was granted. Required for regulatory compliance in the applicable state jurisdiction.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxInsuredAmount rdf:type rdf:Property ;
    rdfs:label 'Max Insured Amount' ;
    rdfs:comment 'Maximum single-transaction insured amount (in USD) the agent is authorized to underwrite independently under this authority tier without escalating to the underwriter for approval.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oversightReviewDate rdf:type rdf:Property ;
    rdfs:label 'Oversight Review Date' ;
    rdfs:comment 'Date of the most recent underwriter oversight review or audit of the agent\'s compliance with this authority. Supports ongoing agency oversight and compliance monitoring workflows.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oversightReviewResult rdf:type rdf:Property ;
    rdfs:label 'Oversight Review Result' ;
    rdfs:comment 'Outcome of the most recent underwriter oversight review of the agent under this authority. Drives escalation, suspension, or remediation workflows per ALTA Best Practices Pillar 6.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTypeScope rdf:type rdf:Property ;
    rdfs:label 'Policy Type Scope' ;
    rdfs:comment 'Specifies whether the agent is authorized to issue owner title policies (OTP), lender title policies (LTP), or both under this authority grant. Aligns with VREQ-010 owner/lender policy distinction.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceDueDay rdf:type rdf:Property ;
    rdfs:label 'Remittance Due Day' ;
    rdfs:comment 'Day of the month (1–31) by which the agent must submit the remittance report and payment to the underwriter for the prior period. Used to calculate remittance timeliness and aging.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remittanceFrequency rdf:type rdf:Property ;
    rdfs:label 'Remittance Frequency' ;
    rdfs:comment 'Contractual frequency at which the agent must remit the underwriter\'s premium share. Drives agency remittance-timeliness metrics per VREQ-016.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'Sequential revision counter for this authority record within the same agency agreement. Increments each time authority terms are amended. Supports lifecycle history per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Free-text explanation of why this authority record was created as a revision of the prior record (e.g., tier upgrade, max amount increase, geographic expansion, compliance correction).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateCode rdf:type rdf:Property ;
    rdfs:label 'State Code' ;
    rdfs:comment 'Two-letter US state code identifying the jurisdiction in which this authority is granted. Authority is state-specific due to state-level insurance licensing and regulatory requirements.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'Date on which this authority was explicitly terminated prior to its scheduled expiration. Populated only when authority is revoked or cancelled mid-term. Distinct from expiration_date per lifecycle preservation (VREQ-007).' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:terminationReason rdf:type rdf:Property ;
    rdfs:label 'Termination Reason' ;
    rdfs:comment 'Reason code explaining why this authority was terminated before its scheduled expiration. Supports oversight reporting and regulatory compliance. [ENUM-REF-CANDIDATE: promote if reasons expand beyond 6]' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTypeScope rdf:type rdf:Property ;
    rdfs:label 'Transaction Type Scope' ;
    rdfs:comment 'Defines which transaction types the agent is authorized to handle under this authority. Restricts or expands the agent\'s operational scope. [ENUM-REF-CANDIDATE: promote if transaction types expand]' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterCode rdf:type rdf:Property ;
    rdfs:label 'Underwriter Code' ;
    rdfs:comment 'Reference to the title underwriter (carrier) granting this authority. Identifies which underwriting company has authorized the agent to issue policies on its behalf.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterPremiumSplitPct rdf:type rdf:Property ;
    rdfs:label 'Underwriter Premium Split Pct' ;
    rdfs:comment 'Contractual percentage of gross title insurance premium remitted to the underwriter (the underwriter\'s share of the split). Must sum to 1.0 with agent_premium_split_pct. Confidential commercial term.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:updatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Updated Timestamp' ;
    rdfs:comment 'Timestamp when this authority record was last modified in the Agency Management and Remittance System. Supports change detection and audit trail for lifecycle transitions per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uwrefThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Uwref Threshold Amount' ;
    rdfs:comment 'Transaction insured amount above which the agent must refer the transaction to the underwriter for approval before issuing a commitment or policy. Supports underwriting referral rate metrics per VREQ-016.' ;
    rdfs:domain ind:AgentAuthority ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeDate rdf:type rdf:Property ;
    rdfs:label 'Change Date' ;
    rdfs:comment 'Date and time when this record was last modified' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:changedBy rdf:type rdf:Property ;
    rdfs:label 'Changed By' ;
    rdfs:comment 'User or process that last modified this record' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User or process that created this record' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creationDate rdf:type rdf:Property ;
    rdfs:label 'Creation Date' ;
    rdfs:comment 'Date and time when this record was created' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validFrom rdf:type rdf:Property ;
    rdfs:label 'Valid From' ;
    rdfs:comment 'Start date when this record version became effective' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:validTo rdf:type rdf:Property ;
    rdfs:label 'Valid To' ;
    rdfs:comment 'End date when this record version ceased to be effective (NULL if current)' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:agentLicenseId rdf:type rdf:Property ;
    rdfs:label 'Agent License Id' ;
    rdfs:comment 'Unique surrogate identifier for each effective-dated agent license record in the agency management system.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appointingUnderwriterCode rdf:type rdf:Property ;
    rdfs:label 'Appointing Underwriter Code' ;
    rdfs:comment 'Reference to the title underwriter entity that holds the active appointment for this license with the state DOI. An agent may be appointed by multiple underwriters.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appointmentDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Date' ;
    rdfs:comment 'Date on which the appointing underwriter filed the agent appointment with the state DOI for this license. Required for authority validation.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Termination Date' ;
    rdfs:comment 'Date on which the underwriter appointment for this license was terminated with the state DOI. Null if appointment is currently active.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorityHoldFlag rdf:type rdf:Property ;
    rdfs:label 'Authority Hold Flag' ;
    rdfs:comment 'Indicates whether this license is currently subject to an authority hold that prevents the agent from issuing commitments or policies under this license.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:authorityHoldReason rdf:type rdf:Property ;
    rdfs:label 'Authority Hold Reason' ;
    rdfs:comment 'Free-text description of the reason an authority hold has been placed on this license (e.g., expired E&O, CE deficiency, DOI investigation). Null when no hold is active.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backgroundCheckDate rdf:type rdf:Property ;
    rdfs:label 'Background Check Date' ;
    rdfs:comment 'Date on which the most recent background check was completed for the agent associated with this license. Drives re-screening schedule compliance.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backgroundCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Background Check Status' ;
    rdfs:comment 'Status of the background check conducted on the agent in connection with this license. Required for ALTA Best Practices Pillar 3 onboarding compliance.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ce Compliance Status' ;
    rdfs:comment 'Current CE compliance status for this license\'s renewal cycle. Drives proactive outreach and authority hold workflows when deficient.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceCreditHoursCompleted rdf:type rdf:Property ;
    rdfs:label 'Ce Credit Hours Completed' ;
    rdfs:comment 'Number of continuing education credit hours completed by the agent toward the current renewal cycle requirement. Used for compliance gap monitoring.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ceCreditHoursRequired rdf:type rdf:Property ;
    rdfs:label 'Ce Credit Hours Required' ;
    rdfs:comment 'Number of continuing education credit hours required by the state for renewal of this license in the current renewal cycle.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:continuingEducationRequired rdf:type rdf:Property ;
    rdfs:label 'Continuing Education Required' ;
    rdfs:comment 'Indicates whether the state requires continuing education (CE) credits for renewal of this license. Drives CE compliance tracking workflows.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:domicileStateCode rdf:type rdf:Property ;
    rdfs:label 'Domicile State Code' ;
    rdfs:comment 'Two-letter USPS code for the agent\'s home state of domicile. Used to distinguish resident from non-resident licenses and to apply reciprocity rules.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCarrierName rdf:type rdf:Property ;
    rdfs:label 'Eo Carrier Name' ;
    rdfs:comment 'Name of the insurance carrier providing the E&O coverage associated with this agent license. Used for coverage verification and oversight.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Eo Verified Date' ;
    rdfs:comment 'Date on which E&O coverage for this license was last verified by the agency oversight team. Supports ALTA Best Practices audit evidence.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'Date on which the state DOI originally issued this license to the agent entity. Establishes the start of the license\'s initial effective period.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseChangeReason rdf:type rdf:Property ;
    rdfs:label 'License Change Reason' ;
    rdfs:comment 'Reason code describing why this license record version was created or updated. Preserves material lifecycle transitions per VREQ-007. [ENUM-REF-CANDIDATE: initial_issuance|renewal|reinstatement|class_change|suspension|revocation|correction — 7 candidates' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseClass rdf:type rdf:Property ;
    rdfs:label 'License Class' ;
    rdfs:comment 'Classification of the license type as defined by the issuing state DOI. Distinguishes title agent, title producer, escrow agent, settlement agent, and notary signing agent authorizations.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseRevisionNumber rdf:type rdf:Property ;
    rdfs:label 'License Revision Number' ;
    rdfs:comment 'Sequential revision counter incremented each time this license record is updated (renewal, reinstatement, class change). Supports lifecycle history per VREQ-007.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:licenseStatus rdf:type rdf:Property ;
    rdfs:label 'License Status' ;
    rdfs:comment 'Current lifecycle status of the license as reported by the issuing state DOI. Drives agent authority eligibility checks and oversight workflows.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Indicates whether the license is held by an individual producer, a business entity (agency firm), or a branch office. Drives onboarding and authority workflows.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseVerificationSource rdf:type rdf:Property ;
    rdfs:label 'License Verification Source' ;
    rdfs:comment 'Source used to verify the license status (e.g., NIPR national producer database, state DOI portal, manual review). Supports evidence provenance per VREQ-007.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'License Verified Date' ;
    rdfs:comment 'Date on which the license status was last verified against the authoritative source (NIPR or state DOI). Drives re-verification scheduling.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:linesOfAuthority rdf:type rdf:Property ;
    rdfs:label 'Lines Of Authority' ;
    rdfs:comment 'Comma-delimited list of insurance lines of authority granted under this license (e.g., Title, Escrow, Settlement). Sourced from state DOI appointment records.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:niprProducerNumber rdf:type rdf:Property ;
    rdfs:label 'Nipr Producer Number' ;
    rdfs:comment 'NIPR-assigned national producer number (NPN) for the agent, used to cross-reference license records across states in the NAIC national database.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Prior License Number' ;
    rdfs:comment 'Previous state-issued license number superseded by this record, if applicable. Preserves chain-of-license history for lifecycle traceability per VREQ-007.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Timestamp when this agent license record was first created in the lakehouse silver layer. Supports audit trail and data lineage.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Timestamp when this agent license record was last modified in the lakehouse silver layer. Supports change detection and incremental processing.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryActionDescription rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Description' ;
    rdfs:comment 'Brief description of any active or historical regulatory action taken by the state DOI against this license. Null when no regulatory action exists.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Flag' ;
    rdfs:comment 'Indicates whether the state DOI has taken or initiated a regulatory action (investigation, consent order, fine) against this license. Triggers escalated oversight.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinstatementDate rdf:type rdf:Property ;
    rdfs:label 'Reinstatement Date' ;
    rdfs:comment 'Date on which a previously suspended or expired license was reinstated by the state DOI. Null if the license has never been reinstated.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Date on which the license was most recently renewed by the state DOI. Null if the license has never been renewed since original issuance.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:residentNonresidentFlag rdf:type rdf:Property ;
    rdfs:label 'Resident Nonresident Flag' ;
    rdfs:comment 'Indicates whether this is a resident license (agent domiciled in the issuing state) or a non-resident license (agent licensed in a state other than domicile).' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date on which the state DOI permanently revoked this license. Null if not revoked. Preserved for lifecycle history and regulatory reporting.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemLicenseKey rdf:type rdf:Property ;
    rdfs:label 'Source System License Key' ;
    rdfs:comment 'Natural key or record identifier for this license as stored in the Agency Management and Remittance System (e.g., SoftPro, RamQuest). Supports lineage and reconciliation.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateFipsCode rdf:type rdf:Property ;
    rdfs:label 'State Fips Code' ;
    rdfs:comment 'Two-digit FIPS code identifying the U.S. state or territory that issued this license. Used for jurisdiction-level compliance reporting and authority scoping.' ;
    rdfs:domain ind:AgentLicense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionDate rdf:type rdf:Property ;
    rdfs:label 'Suspension Date' ;
    rdfs:comment 'Date on which the state DOI suspended this license, if applicable. Null when license is not suspended. Supports lifecycle history per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agencyAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agency Agreement Number' ;
    rdfs:comment 'Unique identifier of the executed agency agreement between the independent title agent and the underwriter. Links to the agreement document in the Document Management System.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentCode rdf:type rdf:Property ;
    rdfs:label 'Agent Code' ;
    rdfs:comment 'Unique alphanumeric code assigned by the underwriter to identify the agent in the Agency Management and Remittance System. Used on remittance reports, policy registers, and premium splits.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentStatus rdf:type rdf:Property ;
    rdfs:label 'Agent Status' ;
    rdfs:comment 'Current lifecycle status of the agent appointment with the underwriter. Controls whether the agent may issue commitments, policies, and CPLs. Drives oversight and compliance monitoring.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentType rdf:type rdf:Property ;
    rdfs:label 'Agent Type' ;
    rdfs:comment 'Legal entity structure of the agent (individual, corporation, LLC, partnership, or government entity). Determines tax reporting obligations, E&O requirements, and agency agreement terms.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:altaBestPracticesCertified rdf:type rdf:Property ;
    rdfs:label 'Alta Best Practices Certified' ;
    rdfs:comment 'Indicates whether the agent has obtained a current ALTA Best Practices certification from an approved third-party assessor. Required by many lender clients and underwriters for active status.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:altaCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Alta Certification Date' ;
    rdfs:comment 'Date the agent most recently received ALTA Best Practices certification. Used to track certification currency and trigger recertification workflows.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:altaCertificationExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Alta Certification Expiration Date' ;
    rdfs:comment 'Expiration date of the agents current ALTA Best Practices certification. Triggers recertification alerts and may affect agent authority level if expired.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Effective Date' ;
    rdfs:comment 'Date the underwriter appointment became effective, authorizing the agent to issue title commitments and policies on behalf of the underwriter. Distinct from onboarding date.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appointmentExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Expiration Date' ;
    rdfs:comment 'Date the current underwriter appointment expires or is scheduled for renewal. Null for perpetual appointments. Used to trigger renewal workflows and compliance alerts.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:authorityLevel rdf:type rdf:Property ;
    rdfs:label 'Authority Level' ;
    rdfs:comment 'Underwriter-assigned authority level controlling the types and amounts of title commitments, policies, and CPLs the agent may issue without referral. Drives underwriting workflow routing.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dbaName rdf:type rdf:Property ;
    rdfs:label 'Dba Name' ;
    rdfs:comment 'Trade or assumed name under which the agent operates, if different from the legal entity name. Required for marketing materials, closing documents, and consumer-facing disclosures.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAccountVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Verified Date' ;
    rdfs:comment 'Most recent date the underwriter verified the agents escrow/trust account compliance per ALTA Best Practices Pillar 2. Used for ongoing oversight and audit scheduling.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fidelityBondAmount rdf:type rdf:Property ;
    rdfs:label 'Fidelity Bond Amount' ;
    rdfs:comment 'Coverage amount of the agents fidelity bond or employee dishonesty insurance in USD. Required by many underwriters and state regulations to protect against employee theft of escrow funds.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fidelityBondExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Fidelity Bond Expiration Date' ;
    rdfs:comment 'Expiration date of the agents fidelity bond or employee dishonesty coverage. Used to trigger renewal alerts and compliance monitoring.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fipsCountyCode rdf:type rdf:Property ;
    rdfs:label 'Fips County Code' ;
    rdfs:comment 'Five-digit FIPS county code for the county in which the agents primary office is located. Used for geographic segmentation, county-level reporting, and plant access authorization.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ioltaAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Iolta Account Flag' ;
    rdfs:comment 'Indicates whether the agent maintains a separate IOLTA or escrow trust account as required by ALTA Best Practices Pillar 2 and applicable state bar or insurance regulations.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'Date of the most recent underwriter compliance audit or examination of the agent. Used to schedule next audit and track oversight cadence per ALTA Best Practices and agency agreement.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastAuditResult rdf:type rdf:Property ;
    rdfs:label 'Last Audit Result' ;
    rdfs:comment 'Outcome of the most recent underwriter compliance audit. Drives agent status changes, remediation workflows, and authority level adjustments.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Updated Timestamp' ;
    rdfs:comment 'Timestamp when the agent profile record was most recently modified. Supports change tracking, audit trail, and lifecycle history preservation per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Full legal name of the independent title agent, direct branch, or lender-channel partner as registered with the state and underwriter. Used for licensing, remittance, and policy issuance.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxPolicyLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Max Policy Liability Amount' ;
    rdfs:comment 'Maximum single-transaction policy liability amount in USD the agent is authorized to issue without underwriter referral. Transactions exceeding this threshold require Underwriting Referral (UWR).' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naicCompanyCode rdf:type rdf:Property ;
    rdfs:label 'Naic Company Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to the agent entity for regulatory reporting and state filing purposes. Required for NAIC annual statement submissions.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Office Address Line1' ;
    rdfs:comment 'Street address line 1 of the agents primary office location. Used for regulatory filings, policy documents, and consumer-facing disclosures.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Office Address Line2' ;
    rdfs:comment 'Street address line 2 (suite, unit, floor) of the agents primary office location. Supplemental to office_address_line1 for complete mailing address.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeCity rdf:type rdf:Property ;
    rdfs:label 'Office City' ;
    rdfs:comment 'City of the agents primary office location. Used for geographic segmentation, regulatory filings, and market analysis.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeState rdf:type rdf:Property ;
    rdfs:label 'Office State' ;
    rdfs:comment 'Two-letter USPS state abbreviation for the agents primary office location. Determines applicable state insurance regulations, rate filings, and remittance rules.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeZipCode rdf:type rdf:Property ;
    rdfs:label 'Office Zip Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code of the agents primary office location. Used for geographic analysis, regulatory filings, and market segmentation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onboardingDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Date' ;
    rdfs:comment 'Date the agent completed onboarding and was approved to conduct business under the agency agreement. Marks the start of the agent relationship for remittance timeliness and oversight tracking.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operatingStates rdf:type rdf:Property ;
    rdfs:label 'Operating States' ;
    rdfs:comment 'Comma-delimited list of two-letter state abbreviations where the agent is licensed and authorized to conduct title insurance business. Drives multi-state authority and compliance monitoring.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Business email address of the primary contact at the agent office. Used for underwriter communications, remittance notices, compliance alerts, and CPL issuance notifications.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactName rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Name' ;
    rdfs:comment 'Full name of the primary business contact at the agent office responsible for underwriter communications, remittance, and compliance matters.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Business phone number of the primary contact at the agent office. Used for underwriter communications and compliance outreach.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryLicenseExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Primary License Expiration Date' ;
    rdfs:comment 'Expiration date of the agents primary state title insurance license. Used to trigger renewal alerts and suspend authority if license lapses.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:primaryLicenseState rdf:type rdf:Property ;
    rdfs:label 'Primary License State' ;
    rdfs:comment 'Two-letter USPS state abbreviation for the state in which the agent holds their primary title insurance license. Governs applicable regulatory requirements and remittance rules.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryStateLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Primary State License Number' ;
    rdfs:comment 'State-issued title insurance producer or agency license number for the agents primary state of operation. Required for appointment filings and regulatory compliance verification.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceScheduleType rdf:type rdf:Property ;
    rdfs:label 'Remittance Schedule Type' ;
    rdfs:comment 'Frequency at which the agent is required to remit collected title insurance premiums to the underwriter. Drives remittance timeliness monitoring and agency settlement processing.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdReference rdf:type rdf:Property ;
    rdfs:label 'Tax Id Reference' ;
    rdfs:comment 'Tokenized reference to the agents Federal Tax Identification Number (TIN/EIN) stored in the Identity and NPPI Vault. Used for IRS 1099 reporting and premium remittance reconciliation. Raw TIN not stored here.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterSplitPct rdf:type rdf:Property ;
    rdfs:label 'Underwriter Split Pct' ;
    rdfs:comment 'Contractual percentage of collected title insurance premium remitted to the underwriter per the agency agreement. Should sum to 1.0000 with agent_premium_split_pct.' ;
    rdfs:domain ind:AgentProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agentRemittanceId rdf:type rdf:Property ;
    rdfs:label 'Agent Remittance Id' ;
    rdfs:comment 'Unique surrogate identifier for the agent remittance header record. Primary key for the agency settlement cycle transaction.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AgentRemittance .

ind:premiumSplitScheduleId rdf:type rdf:Property ;
    rdfs:label 'Premium Split Schedule Id' ;
    rdfs:comment 'Reference to the premium split schedule that governs agent and underwriter share calculations applied to this remittance period.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumSplitSchedule .

ind:priorRemittanceAgentRemittanceId rdf:type rdf:Property ;
    rdfs:label 'Prior Remittance Agent Remittance Id' ;
    rdfs:comment 'Reference to the previous remittance record that this corrected or supplemental remittance supersedes. Supports lifecycle revision history per VREQ-007.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AgentRemittance .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'Date the underwriter formally accepted and validated the remittance submission. Distinct from submission_date per VREQ-008 date separation requirements.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agentRetainedAmount rdf:type rdf:Property ;
    rdfs:label 'Agent Retained Amount' ;
    rdfs:comment 'Dollar amount of gross premium retained by the agent per the applicable premium split schedule. Equals gross premium multiplied by the agent split rate.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amountReceived rdf:type rdf:Property ;
    rdfs:label 'Amount Received' ;
    rdfs:comment 'Actual dollar amount received by the underwriter from the agent for this remittance. May differ from net_remittance_amount if partial payment or overpayment occurred.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cplFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Cpl Fee Amount' ;
    rdfs:comment 'Total Closing Protection Letter (CPL) fees collected by the agent during the remittance period, subject to the CPL fee split rate in the premium split schedule.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysPastDue rdf:type rdf:Property ;
    rdfs:label 'Days Past Due' ;
    rdfs:comment 'Number of calendar days the remittance submission or payment is past the contractual due_date. Used for agency remittance timeliness metrics per VREQ-016.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Contractual deadline by which the agent must submit and fund this remittance per the agency agreement remittance schedule terms.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endorsementPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Endorsement Premium Amount' ;
    rdfs:comment 'Total premium collected for ALTA endorsements (e.g., ALTA 9, ALTA 8.1, ALTA 22) issued during the remittance period, reported separately from base policy premium.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Flag' ;
    rdfs:comment 'Indicates this remittance has been flagged for manual review due to variance, missing policies, late submission, or other discrepancy requiring underwriter investigation.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionReason rdf:type rdf:Property ;
    rdfs:label 'Exception Reason' ;
    rdfs:comment 'Free-text or coded description of the reason this remittance was flagged as an exception, such as variance, missing policy detail, or suspected fraud indicator.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glBatchReference rdf:type rdf:Property ;
    rdfs:label 'Gl Batch Reference' ;
    rdfs:comment 'Reference to the ERP/GL batch or journal entry number created when this remittance was posted to the general ledger for premium revenue recognition.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Premium Amount' ;
    rdfs:comment 'Total gross title insurance premium collected by the agent for all policies in the remittance period before any splits, credits, or adjustments are applied.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isLate rdf:type rdf:Property ;
    rdfs:label 'Is Late' ;
    rdfs:comment 'Indicates whether this remittance was submitted or funded after the contractual due date. True when submission_date or settlement_date exceeds due_date.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Contractual late fee assessed against the agent for failure to remit by the due date, per the agency agreement penalty terms.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ltpCount rdf:type rdf:Property ;
    rdfs:label 'Ltp Count' ;
    rdfs:comment 'Number of Lender\'s Title Policies (LTP) included in this remittance period. Supports owner-versus-lender policy coverage analytics per VREQ-016.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netRemittanceAmount rdf:type rdf:Property ;
    rdfs:label 'Net Remittance Amount' ;
    rdfs:comment 'Final net amount due to the underwriter after applying all credits, adjustments, and split calculations. This is the amount the agent must fund to settle the remittance.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notes rdf:type rdf:Property ;
    rdfs:label 'Notes' ;
    rdfs:comment 'Free-text operational notes entered by the underwriter or agency oversight team regarding this remittance, such as dispute details, follow-up actions, or audit observations.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otpCount rdf:type rdf:Property ;
    rdfs:label 'Otp Count' ;
    rdfs:comment 'Number of Owner\'s Title Policies (OTP) included in this remittance period. Supports owner-versus-lender policy coverage analytics per VREQ-016.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentMethod rdf:type rdf:Property ;
    rdfs:label 'Payment Method' ;
    rdfs:comment 'Method by which the agent funded the remittance to the underwriter (e.g., wire transfer, ACH, check). Relevant for reconciliation and fraud controls.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Bank or payment system reference number (wire confirmation, ACH trace number, check number) associated with the funds transfer for this remittance settlement.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'Last calendar date of the remittance reporting period. Defines the inclusive end of the policy issuance window covered by this remittance batch.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'First calendar date of the remittance reporting period. Defines the inclusive start of the policy issuance window covered by this remittance batch.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyCount rdf:type rdf:Property ;
    rdfs:label 'Policy Count' ;
    rdfs:comment 'Total number of title insurance policies (owner and lender combined) included in this remittance period. Used for frequency and volume analytics.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'Date on which the remittance was fully reconciled against the underwriter\'s policy registry and general ledger. Null if reconciliation is not yet complete.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Current reconciliation state of the remittance against the underwriter\'s policy registry and GL. Drives escrow receipt-disbursement reconciliation metrics per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Reissue Credit Amount' ;
    rdfs:comment 'Total reissue credit adjustments applied to the gross premium in this remittance period, reducing the remittable premium where prior policies qualify for reissue rates.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remittanceNumber rdf:type rdf:Property ;
    rdfs:label 'Remittance Number' ;
    rdfs:comment 'Externally visible, human-readable identifier assigned to this remittance batch by the agency management system. Used for reconciliation and audit trail.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceStatus rdf:type rdf:Property ;
    rdfs:label 'Remittance Status' ;
    rdfs:comment 'Current lifecycle state of the remittance record. Drives workflow routing and aging metrics for agency remittance timeliness reporting. [ENUM-REF-CANDIDATE: draft|submitted|under_review|accepted|rejected|settled|voided — promote to reference product]' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceType rdf:type rdf:Property ;
    rdfs:label 'Remittance Type' ;
    rdfs:comment 'Classification of the remittance submission: periodic (scheduled cycle), supplemental (out-of-cycle), corrected (amendment to prior), final (contract close-out), or advance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'Date on which funds were actually transferred and the remittance was financially settled between the agent and the underwriter.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:simultaneousIssueCreditAmount rdf:type rdf:Property ;
    rdfs:label 'Simultaneous Issue Credit Amount' ;
    rdfs:comment 'Total simultaneous issue rate credits applied when owner and lender policies are issued concurrently, reducing the combined premium in this remittance period.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'Calendar date on which the agent formally submitted this remittance to the underwriter. Used to calculate remittance timeliness against contractual due dates.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:underwriterDueAmount rdf:type rdf:Property ;
    rdfs:label 'Underwriter Due Amount' ;
    rdfs:comment 'Dollar amount of gross premium owed to the underwriter per the premium split schedule. Equals gross premium minus agent retained amount before adjustments.' ;
    rdfs:domain ind:AgentRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Difference between net_remittance_amount and amount_received. Positive value indicates underpayment; negative indicates overpayment. Drives exception and follow-up workflows.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agreementId rdf:type rdf:Property ;
    rdfs:label 'Agreement Id' ;
    rdfs:comment 'Unique surrogate identifier for the agency agreement record in the title insurance system of record.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:partyId rdf:type rdf:Property ;
    rdfs:label 'Party Id' ;
    rdfs:comment 'Reference to the title underwriter (e.g., FNF, FAF, STC, ORI) that is the issuing underwriter party to this agency agreement.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorAgreementId rdf:type rdf:Property ;
    rdfs:label 'Prior Agreement Id' ;
    rdfs:comment 'Reference to the predecessor agency agreement record that this agreement supersedes or renews. Null for initial agreements. Preserves chain-of-agreement history per VREQ-007.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Agreement .

ind:aggregateLiabilityLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Liability Limit' ;
    rdfs:comment 'Maximum aggregate insured liability (in USD) the agent may carry in a rolling 12-month period before mandatory underwriter review. Supports risk-exposure monitoring.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the agency agreement. Controls whether the agent may issue commitments and policies under this agreement. [ENUM-REF-CANDIDATE: draft|active|suspended|terminated|expired|pending_renewal — promote to reference product]' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Classification of the agency relationship: independent agent, direct branch, centralized lender channel, or affiliated agency. Drives authority and remittance rules.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentCount rdf:type rdf:Property ;
    rdfs:label 'Amendment Count' ;
    rdfs:comment 'Running count of formal amendments executed against this agency agreement. Supports lifecycle revision tracking per VREQ-007.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditFrequency rdf:type rdf:Property ;
    rdfs:label 'Audit Frequency' ;
    rdfs:comment 'Contractual frequency at which the underwriter is entitled to conduct an agency audit of the agent\'s books, records, and escrow accounts under this agreement.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether the agency agreement automatically renews at expiration unless either party provides notice of non-renewal within the notice period.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commercialAuthorityFlag rdf:type rdf:Property ;
    rdfs:label 'Commercial Authority Flag' ;
    rdfs:comment 'Indicates whether the agent is authorized to handle commercial real-estate transactions under this agreement. False restricts agent to residential transactions only.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currentVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Current Version Number' ;
    rdfs:comment 'Version identifier of the current executed agreement document (e.g., \'1.0\', \'2.3\'). Incremented with each amendment. Supports revision history per VREQ-007.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Document Reference Code' ;
    rdfs:comment 'Identifier of the executed agreement document in the Document Management and Imaging System. Enables retrieval of the signed agreement for audit and legal review.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date on which all parties physically or electronically signed the agency agreement. Distinct from effective date per VREQ-008.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fidelityBondNumber rdf:type rdf:Property ;
    rdfs:label 'Fidelity Bond Number' ;
    rdfs:comment 'Bond number of the agent\'s fidelity/surety bond if required by the underwriter or state regulator as a condition of the agency agreement.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicTerritory rdf:type rdf:Property ;
    rdfs:label 'Geographic Territory' ;
    rdfs:comment 'Description or code of the geographic territory (state(s), county FIPS codes, or MSA) within which the agent is authorized to issue title products under this agreement.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawState rdf:type rdf:Property ;
    rdfs:label 'Governing Law State' ;
    rdfs:comment 'Two-letter US state code identifying the state whose laws govern interpretation and enforcement of this agency agreement.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Max Liability Amount' ;
    rdfs:comment 'Maximum insured amount (in USD) the agent is authorized to issue on a single title policy without underwriter referral. Enforces per-transaction authority ceiling.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextAuditDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Due Date' ;
    rdfs:comment 'Scheduled or calculated due date for the next underwriter audit of this agent. Derived from last_audit_date and audit_frequency but stored for operational scheduling.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Notice Period Days' ;
    rdfs:comment 'Number of calendar days of written notice required by either party to terminate the agency agreement without cause, as specified in the agreement terms.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:number rdf:type rdf:Property ;
    rdfs:label 'Number' ;
    rdfs:comment 'Externally-known unique alphanumeric identifier assigned to this agency agreement by the underwriter, used in remittance and compliance correspondence.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oversightRiskTier rdf:type rdf:Property ;
    rdfs:label 'Oversight Risk Tier' ;
    rdfs:comment 'Underwriter-assigned risk tier for this agent based on volume, compliance history, and audit findings. Drives audit frequency and enhanced monitoring requirements.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceDueDays rdf:type rdf:Property ;
    rdfs:label 'Remittance Due Days' ;
    rdfs:comment 'Number of calendar days after the close of the remittance period within which the agent must submit the remittance report and payment to the underwriter.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stateCodes rdf:type rdf:Property ;
    rdfs:label 'State Codes' ;
    rdfs:comment 'Comma-separated list of two-letter US state codes in which the agent is licensed and authorized to issue title products under this agreement (e.g., \'TX,OK,NM\').' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionTypesAuthorized rdf:type rdf:Property ;
    rdfs:label 'Transaction Types Authorized' ;
    rdfs:comment 'Comma-separated list of transaction types the agent may handle: purchase, refinance, HELOC, construction, commercial. Null means all types permitted per authority_level.' ;
    rdfs:domain ind:Agreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplIssuanceId rdf:type rdf:Property ;
    rdfs:label 'Cpl Issuance Id' ;
    rdfs:comment 'Unique surrogate identifier for a Closing Protection Letter (CPL) issuance record in the agency management system.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CplIssuance .

ind:cplInsuredLenderPartyId rdf:type rdf:Property ;
    rdfs:label 'Cpl Insured Lender Party Id' ;
    rdfs:comment 'Reference to the lender or institutional party named as the insured on this CPL, typically the mortgage lender funding the transaction.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:cplPartyId rdf:type rdf:Property ;
    rdfs:label 'Cpl Party Id' ;
    rdfs:comment 'Reference to the title underwriter entity (e.g., FNF, FAF, STC, ORI) that issued and is liable under this CPL.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:insuredOwnershipInterestId rdf:type rdf:Property ;
    rdfs:label 'Insured Ownership Interest Id' ;
    rdfs:comment 'Foreign key linking to property.ownership_interest. Business justification: CPL is issued at closing when ownership interest transfers. Links CPL to the specific ownership interest being insured (buyer\'s new interest or lender\'s lien).' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OwnershipInterest .

ind:legalDescriptionId rdf:type rdf:Property ;
    rdfs:label 'Legal Description Id' ;
    rdfs:comment 'Foreign key linking to property.legal_description. Business justification: CPL documents must reference the legal description that defines the insured property. Legal description is the authoritative definition of what the CPL covers.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LegalDescription .

ind:parcelId rdf:type rdf:Property ;
    rdfs:label 'Parcel Id' ;
    rdfs:comment 'Foreign key linking to property.parcel. Business justification: CPL (Closing Protection Letter) is issued for a specific property parcel. Currently cpl_issuance has denormalized property address fields but no FK to the authoritative property.parcel.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Parcel .

ind:supersededByCplCplIssuanceId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Cpl Cpl Issuance Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the replacement CPL issuance record when this CPL has been superseded by a revised or corrected version.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CplIssuance .

ind:titleOrderId rdf:type rdf:Property ;
    rdfs:label 'Title Order Id' ;
    rdfs:comment 'Reference to the title order for which this CPL was issued, linking the CPL to the underlying transaction in the title production system.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleOrder .

ind:actualClosingDate rdf:type rdf:Property ;
    rdfs:label 'Actual Closing Date' ;
    rdfs:comment 'Date on which the real estate closing actually occurred under this CPL. Null if closing has not yet taken place.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:agentLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Agent License Number' ;
    rdfs:comment 'State-issued title insurance agent license number for the independent agent at time of CPL issuance, confirming active licensure.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentName rdf:type rdf:Property ;
    rdfs:label 'Agent Name' ;
    rdfs:comment 'Legal business name of the independent title agent on whose behalf the CPL is issued, as it appears on the CPL document.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentStateCode rdf:type rdf:Property ;
    rdfs:label 'Agent State Code' ;
    rdfs:comment 'Two-letter USPS state code for the state in which the agent is licensed and appointed to issue this CPL.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date on which the CPL was cancelled prior to expiration, if applicable. Null when the CPL was not cancelled.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Reason code explaining why the CPL was cancelled. [ENUM-REF-CANDIDATE: transaction_cancelled|policy_issued|superseded|agent_request|underwriter_request|other — promote to reference product]' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimMadeIndicator rdf:type rdf:Property ;
    rdfs:label 'Claim Made Indicator' ;
    rdfs:comment 'Indicates whether a claim has been made against this CPL by the insured lender, triggering claims administration workflow.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closingLocation rdf:type rdf:Property ;
    rdfs:label 'Closing Location' ;
    rdfs:comment 'Address or description of the location where the closing is scheduled to occur, as referenced in the CPL.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingOfficerName rdf:type rdf:Property ;
    rdfs:label 'Closing Officer Name' ;
    rdfs:comment 'Name of the closing or escrow officer at the agent office who will conduct the closing covered by this CPL.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplFeeCollected rdf:type rdf:Property ;
    rdfs:label 'Cpl Fee Collected' ;
    rdfs:comment 'Indicates whether the CPL issuance fee has been collected from the insured lender or applicable party at time of issuance.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cplFormVersion rdf:type rdf:Property ;
    rdfs:label 'Cpl Form Version' ;
    rdfs:comment 'Version identifier of the ALTA CPL form used for this issuance (e.g., ALTA 2016 CPL Form), ensuring regulatory and form-version traceability.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplNumber rdf:type rdf:Property ;
    rdfs:label 'Cpl Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to this CPL by the underwriter or agency management system, used for tracking and reference across parties.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplStatus rdf:type rdf:Property ;
    rdfs:label 'Cpl Status' ;
    rdfs:comment 'Current lifecycle status of the CPL issuance record: draft, issued, cancelled, expired, or superseded by a revised CPL.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplType rdf:type rdf:Property ;
    rdfs:label 'Cpl Type' ;
    rdfs:comment 'Classifies the CPL by the party protected: lender, buyer, seller, or combined lender and buyer, per ALTA CPL form options.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryConfirmationRef rdf:type rdf:Property ;
    rdfs:label 'Delivery Confirmation Ref' ;
    rdfs:comment 'Confirmation number, email message ID, or portal acknowledgment reference confirming successful delivery of the CPL to the insured lender.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Method by which the CPL was delivered to the insured lender: email, fax, mail, lender portal, or electronic transmission.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryTimestamp rdf:type rdf:Property ;
    rdfs:label 'Delivery Timestamp' ;
    rdfs:comment 'Date and time at which the CPL was transmitted or delivered to the insured lender, used for timeliness tracking and audit.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:documentImageRef rdf:type rdf:Property ;
    rdfs:label 'Document Image Ref' ;
    rdfs:comment 'Reference key or URI to the signed CPL document image stored in the document management and imaging system for evidence and provenance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCoverageVerified rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Verified' ;
    rdfs:comment 'Indicates whether the agent\'s Errors and Omissions (E&O) insurance coverage was verified as active and sufficient at the time of CPL issuance.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuredLenderAddress rdf:type rdf:Property ;
    rdfs:label 'Insured Lender Address' ;
    rdfs:comment 'Full mailing address of the insured lender as stated on the CPL, used for delivery and regulatory record-keeping.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredLenderName rdf:type rdf:Property ;
    rdfs:label 'Insured Lender Name' ;
    rdfs:comment 'Full legal name of the lender or institutional party named as the insured on the CPL, as it appears on the issued CPL document.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanAmount rdf:type rdf:Property ;
    rdfs:label 'Loan Amount' ;
    rdfs:comment 'Dollar amount of the mortgage loan associated with this CPL, used to establish the scope of underwriter liability. Denominated in USD.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorCplId rdf:type rdf:Property ;
    rdfs:label 'Prior Cpl Id' ;
    rdfs:comment 'Reference to the prior CPL issuance record that this record supersedes, preserving the revision chain for lifecycle history per VREQ-007.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:purchasePrice rdf:type rdf:Property ;
    rdfs:label 'Purchase Price' ;
    rdfs:comment 'Contract purchase price of the subject property for purchase transactions, as stated on the CPL or associated sales contract. Null for refinance transactions.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledClosingDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Closing Date' ;
    rdfs:comment 'Anticipated date of the real estate closing for which this CPL provides protection, used for expiration and pipeline management.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemRef rdf:type rdf:Property ;
    rdfs:label 'Source System Ref' ;
    rdfs:comment 'Identifier of the originating record in the agency management or title production system (e.g., SoftPro, RamQuest) for lineage and reconciliation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateSpecificFormIndicator rdf:type rdf:Property ;
    rdfs:label 'State Specific Form Indicator' ;
    rdfs:comment 'Indicates whether a state-mandated or state-approved CPL form was used instead of the standard ALTA form, as required by certain state Departments of Insurance.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Classification of the underlying real estate transaction type for which the CPL is issued: purchase, refinance, HELOC, construction, commercial, or home equity.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterName rdf:type rdf:Property ;
    rdfs:label 'Underwriter Name' ;
    rdfs:comment 'Legal name of the title underwriter issuing the CPL (e.g., Fidelity National Title, Stewart Title Guaranty), as it appears on the CPL document.' ;
    rdfs:domain ind:CplIssuance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoCoverageId rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Id' ;
    rdfs:comment 'Unique surrogate identifier for an E&O insurance coverage record associated with an independent title agent. Primary key for this entity.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:additionalInsuredFlag rdf:type rdf:Property ;
    rdfs:label 'Additional Insured Flag' ;
    rdfs:comment 'Indicates whether the underwriter or title company is listed as an additional insured on the agent\'s E&O policy. Some underwriter agency agreements require additional insured status.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit' ;
    rdfs:comment 'Maximum total dollar amount the E&O policy will pay across all covered claims during the policy period. Used to assess overall coverage adequacy relative to agent transaction volume.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carrierNaicCode rdf:type rdf:Property ;
    rdfs:label 'Carrier Naic Code' ;
    rdfs:comment 'Five-digit NAIC company code assigned to the E&O carrier. Enables regulatory lookup of carrier licensing, financial ratings, and admitted status by state.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carrierName rdf:type rdf:Property ;
    rdfs:label 'Carrier Name' ;
    rdfs:comment 'Legal name of the insurance carrier underwriting the E&O policy. Used to assess carrier financial strength and validate coverage acceptability per underwriter requirements.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateHolderName rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Name' ;
    rdfs:comment 'Name of the certificate holder listed on the E&O certificate of insurance, typically the underwriter or title company requiring proof of coverage from the independent agent.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateNumber rdf:type rdf:Property ;
    rdfs:label 'Certificate Number' ;
    rdfs:comment 'Number from the ACORD certificate of insurance or equivalent document provided as evidence of E&O coverage. Used to cross-reference the physical or electronic certificate on file.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageGapDays rdf:type rdf:Property ;
    rdfs:label 'Coverage Gap Days' ;
    rdfs:comment 'Number of calendar days of lapsed E&O coverage between the prior policy expiration and the current policy effective date. Zero or null when no gap exists. Used for risk scoring.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageGapFlag rdf:type rdf:Property ;
    rdfs:label 'Coverage Gap Flag' ;
    rdfs:comment 'Indicates whether a gap in continuous E&O coverage exists between the prior policy expiration and the current policy effective date. A gap may expose the agent and underwriter to uninsured risk.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current lifecycle status of the E&O coverage record. Drives agent authority eligibility; an agent with non-active status may be suspended from issuing commitments or policies.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'Indicates whether the E&O policy is written on a claims-made, occurrence, or claims-made-and-reported basis. Affects how claims are triggered and reported under the policy.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysUntilExpiration rdf:type rdf:Property ;
    rdfs:label 'Days Until Expiration' ;
    rdfs:comment 'Number of calendar days remaining until the E&O policy expires, calculated from the current date. Used for aging and expiration-risk dashboards in agency oversight reporting.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Dollar amount the agent is responsible for paying per claim before E&O coverage applies. Relevant to underwriter risk assessment and agent financial responsibility evaluation.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extendedReportingEndDate rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting End Date' ;
    rdfs:comment 'End date of the extended reporting period (tail coverage) if applicable. Null when no ERP endorsement is in effect. Used to determine whether late-reported claims remain eligible.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:extendedReportingPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Extended Reporting Period Flag' ;
    rdfs:comment 'Indicates whether an extended reporting period (tail coverage) endorsement is in effect, allowing claims to be reported after policy expiration for acts occurring during the policy period.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetsMinimumRequirements rdf:type rdf:Property ;
    rdfs:label 'Meets Minimum Requirements' ;
    rdfs:comment 'Computed flag indicating whether the current E&O coverage meets all underwriter-mandated minimum requirements for per-occurrence limit, aggregate limit, and policy status. Drives authority eligibility.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumRequiredAggregate rdf:type rdf:Property ;
    rdfs:label 'Minimum Required Aggregate' ;
    rdfs:comment 'Underwriter-mandated minimum aggregate coverage limit required for this agent\'s authority level. Used to flag coverage deficiency when actual aggregate limit falls below threshold.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumRequiredPerOccurrence rdf:type rdf:Property ;
    rdfs:label 'Minimum Required Per Occurrence' ;
    rdfs:comment 'Underwriter-mandated minimum per-occurrence coverage limit required for this agent\'s authority level. Used to flag coverage deficiency when actual per-occurrence limit falls below threshold.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:namedInsured rdf:type rdf:Property ;
    rdfs:label 'Named Insured' ;
    rdfs:comment 'Legal name of the entity or individual listed as the named insured on the E&O policy. Must match the agent entity name on file to confirm coverage applies to the correct party.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:perOccurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit' ;
    rdfs:comment 'Maximum dollar amount the E&O policy will pay for a single covered claim or occurrence. Compared against underwriter minimum coverage thresholds for agent authority approval.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'The carrier-assigned policy number for the E&O insurance policy. Used as the primary external business identifier for the coverage record and referenced during agent oversight audits.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Number' ;
    rdfs:comment 'Policy number of the immediately preceding E&O policy for this agent. Supports chain-of-coverage analysis and retroactive date continuity verification for claims-made policies.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalReminderDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Reminder Date' ;
    rdfs:comment 'Date on which the renewal reminder notification was sent to the agent. Null if no reminder has been sent. Used to track compliance outreach timing relative to expiration date.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalReminderSentFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Reminder Sent Flag' ;
    rdfs:comment 'Indicates whether a renewal reminder notification has been sent to the agent prior to policy expiration. Supports proactive compliance management and prevents inadvertent coverage lapses.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'For claims-made policies, the earliest date from which covered acts or omissions are eligible for coverage. Critical for determining whether prior title work is covered under the current policy.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source Record Code' ;
    rdfs:comment 'Native identifier of this E&O coverage record in the originating source system. Used for reconciliation between the lakehouse Silver layer and the upstream Agency Management System.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Code identifying the operational system of record from which this E&O coverage record originated, such as the Agency Management and Remittance System or CRM. Supports data lineage tracking.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateMinimumRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'State Minimum Required Flag' ;
    rdfs:comment 'Indicates whether the state in which the agent operates mandates a minimum E&O coverage level by regulation. Used to distinguish regulatory minimums from underwriter contractual minimums.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the E&O coverage was most recently verified as active and compliant by the agency oversight team. Used to track verification currency and schedule re-verification.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify the E&O coverage, such as review of a certificate of insurance, direct carrier confirmation, or third-party database lookup. Affects verification reliability scoring.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Status of the internal verification process confirming the E&O policy is valid, in force, and meets underwriter minimum requirements. Drives agent onboarding and ongoing compliance workflows.' ;
    rdfs:domain ind:EoCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or identifier of the staff member or automated process that performed the most recent E&O coverage verification. Supports audit trail for agency compliance oversight.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oversightReviewId rdf:type rdf:Property ;
    rdfs:label 'Oversight Review Id' ;
    rdfs:comment 'Unique surrogate identifier for the oversight review record. Primary key for the agency compliance and performance review entity.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorReviewOversightReviewId rdf:type rdf:Property ;
    rdfs:label 'Prior Review Oversight Review Id' ;
    rdfs:comment 'Reference to the immediately preceding oversight review record for this agent, enabling review history chain and trend analysis.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OversightReview .

ind:authorityActionTaken rdf:type rdf:Property ;
    rdfs:label 'Authority Action Taken' ;
    rdfs:comment 'Regulatory or contractual action taken against the agent\'s authority as a result of this review: none, warning, restriction, suspension, termination, or DOI referral.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date on which all review activities, including agent response and finding resolution, were finalized and the review was closed.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Due Date' ;
    rdfs:comment 'Deadline by which the agent must submit or complete the corrective action plan in response to findings from this review.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Received Date' ;
    rdfs:comment 'Date on which the agent\'s corrective action plan or response was received by the underwriter oversight team.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:correctiveActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Required Flag' ;
    rdfs:comment 'Indicates whether the review findings require the agent to submit a formal corrective action plan (CAP) to address identified deficiencies.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctiveActionStatus rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Status' ;
    rdfs:comment 'Current status of the corrective action plan: not_required, pending, received, accepted, rejected, or overdue. Tracks remediation lifecycle.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Finding Flag' ;
    rdfs:comment 'Indicates whether the review identified at least one critical finding requiring immediate escalation, remediation, or potential authority suspension.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eoCoverageStatus rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Status' ;
    rdfs:comment 'Status of the agent\'s E&O coverage as determined during this review: current, expiring_soon, expired, below_minimum, or not_verified.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eoVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Eo Verified Flag' ;
    rdfs:comment 'Indicates whether the agent\'s E&O insurance coverage was verified as current and meeting minimum requirements during this review.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Escrow Audit Flag' ;
    rdfs:comment 'Indicates whether this review included an examination of the agent\'s escrow/trust account records for compliance with IOLTA and state trust accounting rules.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Escrow Compliance Status' ;
    rdfs:comment 'Outcome of the escrow/trust account audit component: compliant, shortfall, overage, reconciliation_gap, or not_audited if escrow was not in scope.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filesSampledCount rdf:type rdf:Property ;
    rdfs:label 'Files Sampled Count' ;
    rdfs:comment 'Number of title order files or transaction records selected for review during a random file review or annual audit. Supports sampling methodology documentation.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:filesWithFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Files With Findings Count' ;
    rdfs:comment 'Number of sampled files in which one or more compliance findings or deficiencies were identified. Used to compute deficiency rate.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:findingCategories rdf:type rdf:Property ;
    rdfs:label 'Finding Categories' ;
    rdfs:comment 'Comma-separated list of finding category codes identified (e.g., remittance_late, eo_lapsed, escrow_shortfall, licensing_gap, file_deficiency). Supports trend analysis.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingsSummary rdf:type rdf:Property ;
    rdfs:label 'Findings Summary' ;
    rdfs:comment 'Narrative summary of key findings identified during the review, including deficiencies, exceptions, and areas of non-compliance observed.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'License Compliance Status' ;
    rdfs:comment 'Licensing compliance determination from this review: compliant, deficient (missing states), expired, suspended, or not_verified.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:licenseVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'License Verified Flag' ;
    rdfs:comment 'Indicates whether the agent\'s title insurance license(s) were verified as active and in good standing in all applicable states during this review.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextReviewDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Due Date' ;
    rdfs:comment 'Scheduled due date for the next oversight review of this agent, determined by risk tier, audit frequency in the agency agreement, and findings from this review.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallRating rdf:type rdf:Property ;
    rdfs:label 'Overall Rating' ;
    rdfs:comment 'Composite compliance and performance rating assigned at the conclusion of the review: satisfactory, needs_improvement, unsatisfactory, or critical.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReferralDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Referral Date' ;
    rdfs:comment 'Date on which the regulatory referral was submitted to the state DOI or other authority. Populated only when regulatory_referral_flag is true.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Referral Flag' ;
    rdfs:comment 'Indicates whether findings from this review were referred to a state Department of Insurance or other regulatory body for further action.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remittanceAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Remittance Audit Flag' ;
    rdfs:comment 'Indicates whether this review included an audit of the agent\'s premium remittance records and timeliness against the agency agreement schedule.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remittanceComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Remittance Compliance Status' ;
    rdfs:comment 'Outcome of the remittance audit component: compliant, late_remittances, underpayment, overpayment, or not_audited if remittance was not in scope.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Remittance Variance Amount' ;
    rdfs:comment 'Dollar amount of identified remittance discrepancy (underpayment or overpayment) discovered during the remittance audit component of this review.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'The date on which the oversight review was conducted or initiated. Principal business event date for scheduling, aging, and timeliness metrics.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewMethod rdf:type rdf:Property ;
    rdfs:label 'Review Method' ;
    rdfs:comment 'Method by which the oversight review was conducted: on_site (at agent office), remote (virtual/electronic), desk_review (document submission only), or hybrid.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Free-text notes recorded by the reviewer capturing context, agent responses, mitigating circumstances, or follow-up actions not captured in structured fields.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewNumber rdf:type rdf:Property ;
    rdfs:label 'Review Number' ;
    rdfs:comment 'Externally visible, human-readable identifier assigned to this oversight review. Used in correspondence, audit trails, and regulatory submissions.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewScope rdf:type rdf:Property ;
    rdfs:label 'Review Scope' ;
    rdfs:comment 'Narrative description of the scope of the review, including which files, periods, processes, or compliance areas were examined.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current lifecycle state of the oversight review: scheduled, in_progress, pending_response (awaiting agent reply), completed, cancelled, or escalated to underwriter compliance.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewType rdf:type rdf:Property ;
    rdfs:label 'Review Type' ;
    rdfs:comment 'Classification of the review: annual audit, random file review, E&O verification, licensing check, remittance audit, or for-cause review. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerDepartment rdf:type rdf:Property ;
    rdfs:label 'Reviewer Department' ;
    rdfs:comment 'Organizational department or unit responsible for conducting the review (e.g., Agency Compliance, Underwriting Oversight, Internal Audit).' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerEmployeeCode rdf:type rdf:Property ;
    rdfs:label 'Reviewer Employee Code' ;
    rdfs:comment 'Internal employee identifier of the reviewer conducting the oversight review. Links to HR/identity systems for access control and audit.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewerName rdf:type rdf:Property ;
    rdfs:label 'Reviewer Name' ;
    rdfs:comment 'Full name of the underwriter compliance officer, auditor, or oversight analyst who conducted the review. Supports accountability and audit trail.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTierAfter rdf:type rdf:Property ;
    rdfs:label 'Risk Tier After' ;
    rdfs:comment 'Agent oversight risk tier classification assigned as a result of this review. Compared to risk_tier_before to track risk migration.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTierBefore rdf:type rdf:Property ;
    rdfs:label 'Risk Tier Before' ;
    rdfs:comment 'Agent oversight risk tier classification assigned prior to this review. Used to measure risk tier migration resulting from review findings.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'The originally planned date for the oversight review. Compared against review_date to measure scheduling adherence and overdue reviews.' ;
    rdfs:domain ind:OversightReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersededBySchedulePremiumSplitScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Schedule Premium Split Schedule Id' ;
    rdfs:comment 'Reference to the newer premium_split_schedule record that replaced this one. Null if this is the current active schedule. Preserves revision history per VREQ-007.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumSplitSchedule .

ind:agentSplitRate rdf:type rdf:Property ;
    rdfs:label 'Agent Split Rate' ;
    rdfs:comment 'Contractual proportion of gross premium retained by the independent title agent, expressed as a decimal (e.g., 0.800000 = 80%). Core metric for remittance-timeliness analysis.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cplFeeSplitRate rdf:type rdf:Property ;
    rdfs:label 'Cpl Fee Split Rate' ;
    rdfs:comment 'Agent\'s contractual split rate applied to Closing Protection Letter (CPL) fees collected. Distinct from policy premium split rates.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementSplitRate rdf:type rdf:Property ;
    rdfs:label 'Endorsement Split Rate' ;
    rdfs:comment 'Agent\'s contractual split rate applied specifically to ALTA endorsement premiums (e.g., ALTA 9, ALTA 8.1, ALTA 22). May differ from base policy split rate.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isTieredSchedule rdf:type rdf:Property ;
    rdfs:label 'Is Tiered Schedule' ;
    rdfs:comment 'Indicates whether this schedule is one tier within a multi-tier split structure. True when premium_floor_amount and premium_ceiling_amount define a band.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAgentRemittanceAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Agent Remittance Amount' ;
    rdfs:comment 'Minimum dollar amount the agent must remit to the underwriter per remittance cycle, regardless of split calculation. Null if no minimum applies.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Indicates whether this split schedule applies to the Owner\'s Title Policy (OTP), Lender\'s Title Policy (LTP), or both. Owner and lender policies carry distinct split rates per VREQ-010.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumCeilingAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Ceiling Amount' ;
    rdfs:comment 'Maximum gross premium threshold above which this split schedule no longer applies. Null indicates no upper bound. Supports tiered split structures.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:premiumFloorAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Floor Amount' ;
    rdfs:comment 'Minimum gross premium threshold below which this split schedule applies. Supports tiered split structures where rates change at premium breakpoints.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyTypeScope rdf:type rdf:Property ;
    rdfs:label 'Property Type Scope' ;
    rdfs:comment 'Indicates whether this split schedule applies to residential, commercial, or both property types. Commercial transactions may carry different negotiated split rates.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateSource rdf:type rdf:Property ;
    rdfs:label 'Rate Source' ;
    rdfs:comment 'Indicates whether the split rates are derived from state-filed rates, individually negotiated contract terms, or a statutory minimum/maximum rate schedule.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueCreditApplies rdf:type rdf:Property ;
    rdfs:label 'Reissue Credit Applies' ;
    rdfs:comment 'Indicates whether reissue/refinance credit discounts are factored into the premium base before applying the split rates under this schedule.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Human-readable name or label for this split schedule (e.g., \'Residential Standard 80/20 — TX 2024\'). Aids identification in the agency management system.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this split schedule, as referenced in the agency agreement and remittance system. Used for audit and reconciliation.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the split schedule. \'superseded\' indicates a newer schedule has replaced this one; \'terminated\' indicates the agreement ended.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:simultaneousIssueRateApplies rdf:type rdf:Property ;
    rdfs:label 'Simultaneous Issue Rate Applies' ;
    rdfs:comment 'Indicates whether the simultaneous issue (owner + lender issued together) discounted premium rate applies as the basis for split calculation under this schedule.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:splitBasis rdf:type rdf:Property ;
    rdfs:label 'Split Basis' ;
    rdfs:comment 'Defines the premium base on which the split rates are applied: gross collected premium, net premium after deductions, or the state-filed statutory rate.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersedesScheduleId rdf:type rdf:Property ;
    rdfs:label 'Supersedes Schedule Id' ;
    rdfs:comment 'Reference to the prior premium_split_schedule record that this schedule replaced. Null if this is the original schedule. Supports chain-of-revision traceability.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierSequence rdf:type rdf:Property ;
    rdfs:label 'Tier Sequence' ;
    rdfs:comment 'Ordinal position of this tier within a tiered split schedule (1 = lowest premium band). Null for non-tiered schedules. Used to apply the correct rate band.' ;
    rdfs:domain ind:PremiumSplitSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:underwriterSplitRate rdf:type rdf:Property ;
    rdfs:label 'Underwriter Split Rate' ;
    rdfs:comment 'Contractual proportion of gross premium remitted to the underwriter, expressed as a decimal (e.g., 0.200000 = 20%). Must sum to 1.0 with agent_split_rate.' ;
    rdfs:domain ind:Agency ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remittanceLineId rdf:type rdf:Property ;
    rdfs:label 'Remittance Line Id' ;
    rdfs:comment 'Unique surrogate identifier for a single remittance line record within an agent premium remittance batch. Primary key for the remittance_line entity.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyId rdf:type rdf:Property ;
    rdfs:label 'Property Id' ;
    rdfs:comment 'Foreign key linking to property.property. Business justification: Remittance lines track premium by property transaction. Essential for reconciling premium to title orders, analyzing revenue by property type/transaction type, detecting duplicate' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Property .

ind:titlePolicyId rdf:type rdf:Property ;
    rdfs:label 'Title Policy Id' ;
    rdfs:comment 'Reference to the issued title policy (owner or lender) for which premium is being remitted. Core link for policy-level remittance reconciliation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitlePolicy .

ind:acceptedDate rdf:type rdf:Property ;
    rdfs:label 'Accepted Date' ;
    rdfs:comment 'Date the underwriter formally accepted this remittance line as correct and complete. Marks the completion of the remittance reconciliation lifecycle for this line. Distinct from submission date.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'Dollar amount of any post-submission adjustment applied to this remittance line (e.g., correction for rate error, credit memo, or dispute resolution). Negative values indicate credits.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason' ;
    rdfs:comment 'Reason code for any adjustment applied to this remittance line. Required when adjustment_amount is non-zero. Supports audit trail and dispute resolution workflows.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentPremiumShare rdf:type rdf:Property ;
    rdfs:label 'Agent Premium Share' ;
    rdfs:comment 'Computed dollar amount retained by the agent: net_premium_amount multiplied by agent_split_rate. Represents the agent\'s earned commission on this policy line.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closingDate rdf:type rdf:Property ;
    rdfs:label 'Closing Date' ;
    rdfs:comment 'Date the real estate transaction closed. Anchors the remittance timeliness calculation; remittance due date is typically computed relative to closing date per the agency agreement.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cplUnderwriterShare rdf:type rdf:Property ;
    rdfs:label 'Cpl Underwriter Share' ;
    rdfs:comment 'Underwriter\'s share of the CPL fee computed using the CPL fee split rate from the premium_split_schedule. Included in total underwriter remittance for this line.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementUnderwriterShare rdf:type rdf:Property ;
    rdfs:label 'Endorsement Underwriter Share' ;
    rdfs:comment 'Underwriter\'s share of endorsement premium computed using the endorsement split rate from the premium_split_schedule. Included in total underwriter remittance for this line.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'General ledger account code to which the underwriter premium share for this line is posted in the ERP/GL system. Supports premium revenue recognition and financial reconciliation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredAmount rdf:type rdf:Property ;
    rdfs:label 'Insured Amount' ;
    rdfs:comment 'The face amount of insurance coverage provided by this policy (purchase price for OTP, loan amount for LTP). Used to validate premium calculation against filed rate tables.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isLateRemittance rdf:type rdf:Property ;
    rdfs:label 'Is Late Remittance' ;
    rdfs:comment 'Indicates whether this remittance line was submitted after the contractual remittance due date. True when remittance_submitted_date exceeds remittance_due_date. Drives timeliness compliance reporting.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReissueCreditApplied rdf:type rdf:Property ;
    rdfs:label 'Is Reissue Credit Applied' ;
    rdfs:comment 'Indicates whether a reissue credit was applied to reduce the gross premium on this line. When true, reissue_credit_amount must be populated and greater than zero.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSimultaneousIssue rdf:type rdf:Property ;
    rdfs:label 'Is Simultaneous Issue' ;
    rdfs:comment 'Indicates whether this policy line is part of a simultaneous owner/lender policy issuance on the same transaction. Affects premium calculation and split schedule applicability.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lineSequence rdf:type rdf:Property ;
    rdfs:label 'Line Sequence' ;
    rdfs:comment 'Sequential line number within the parent remittance batch, starting at 1. Used for ordering, display, and reconciliation of individual policy lines within a remittance.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lineStatus rdf:type rdf:Property ;
    rdfs:label 'Line Status' ;
    rdfs:comment 'Current processing status of this remittance line. Drives reconciliation workflow: pending=awaiting underwriter acceptance; accepted=confirmed; rejected=disputed; adjusted=corrected; reversed=backed out; voided=cancelled.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Net Premium Amount' ;
    rdfs:comment 'Net title insurance premium after deducting reissue credit and simultaneous issue credit from gross premium. This is the base amount to which the agent/underwriter split rates are applied.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Policy Effective Date' ;
    rdfs:comment 'Date the title policy became effective (typically the closing/recording date). Used to determine the applicable rate filing period and remittance due date calculation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyIssueDate rdf:type rdf:Property ;
    rdfs:label 'Policy Issue Date' ;
    rdfs:comment 'Date the title policy was formally issued by the agent. Distinct from effective date; used to measure policy issuance lag and remittance timeliness from issuance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rateFilingReference rdf:type rdf:Property ;
    rdfs:label 'Rate Filing Reference' ;
    rdfs:comment 'Reference to the state-filed rate schedule used to calculate the gross premium for this line (e.g., state filing number or rate manual version). Supports regulatory audit and rate compliance.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Reason provided by the underwriter when this remittance line is rejected or disputed (e.g., incorrect split rate, missing policy number, rate calculation error). Populated when line_status is rejected.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceDueDate rdf:type rdf:Property ;
    rdfs:label 'Remittance Due Date' ;
    rdfs:comment 'Date by which the underwriter share for this line must be remitted per the agency agreement remittance schedule. Key date for remittance timeliness metric calculation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceSubmittedDate rdf:type rdf:Property ;
    rdfs:label 'Remittance Submitted Date' ;
    rdfs:comment 'Actual date this remittance line was submitted to the underwriter as part of the agent remittance batch. Used to compute days-late for remittance timeliness reporting.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemLineRef rdf:type rdf:Property ;
    rdfs:label 'Source System Line Ref' ;
    rdfs:comment 'Native line identifier from the Agency Management and Remittance System (e.g., SoftPro, RamQuest) that originated this remittance line. Enables traceability back to the system of record.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalUnderwriterRemittance rdf:type rdf:Property ;
    rdfs:label 'Total Underwriter Remittance' ;
    rdfs:comment 'Total amount due to the underwriter for this line: sum of underwriter_premium_share, endorsement_underwriter_share, and cpl_underwriter_share. The controlling remittance amount for this line.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwriterPremiumShare rdf:type rdf:Property ;
    rdfs:label 'Underwriter Premium Share' ;
    rdfs:comment 'Computed dollar amount due to the underwriter: net_premium_amount multiplied by underwriter_split_rate. This is the amount being remitted to the underwriter for this line.' ;
    rdfs:domain ind:RemittanceLine ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCurativeActionId rdf:type rdf:Property ;
    rdfs:label 'Claim Curative Action Id' ;
    rdfs:comment 'Unique surrogate identifier for each curative action record within the claims administration system. Primary key for the claim_curative_action entity.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closingDocumentId rdf:type rdf:Property ;
    rdfs:label 'Closing Document Id' ;
    rdfs:comment 'Foreign key linking to settlement.closing_document. Business justification: Curative actions in claims often require re-recording, correcting, or obtaining missing closing documents (deeds, mortgages, affidavits).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClosingDocument .

ind:curativeActionId rdf:type rdf:Property ;
    rdfs:label 'Curative Action Id' ;
    rdfs:comment 'FK to underwriting.curative_action.curative_action_id — Links claim-phase curative to the underwriting curative SSOT with a claim-context discriminator so claim curative aging ties to the single curative source.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CurativeAction .

ind:easementRestrictionId rdf:type rdf:Property ;
    rdfs:label 'Easement Restriction Id' ;
    rdfs:comment 'Foreign key linking to property.easement_restriction. Business justification: Curative actions for easement disputes, encroachments, or CC&R violations reference specific easement/restriction records.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EasementRestriction .

ind:encumbranceId rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Id' ;
    rdfs:comment 'Foreign key linking to property.encumbrance. Business justification: Many curative actions resolve specific encumbrances (mortgage payoffs, lien releases, judgment satisfactions).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Encumbrance .

ind:priorVersionActionId rdf:type rdf:Property ;
    rdfs:label 'Prior Version Action Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding version of this curative action record, supporting lifecycle revision history and audit trail per VREQ-007.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClaimCurativeAction .

ind:recordingSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Recording Submission Id' ;
    rdfs:comment 'Reference to the eRecording gateway submission record (Simplifile/CSC) tracking the submission, acceptance, or rejection of the curative instrument at the county recorder.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecordingSubmission .

ind:titleClaimId rdf:type rdf:Property ;
    rdfs:label 'Title Claim Id' ;
    rdfs:comment 'Reference to the parent title insurance claim under which this curative action was initiated. Links the action to the FNOL and investigation record.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleClaim .

ind:titleFindingId rdf:type rdf:Property ;
    rdfs:label 'Title Finding Id' ;
    rdfs:comment 'Reference to the specific title defect, encumbrance, or cloud on title identified during examination or claim investigation that this curative action is intended to resolve.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleFinding .

ind:titleRequirementId rdf:type rdf:Property ;
    rdfs:label 'Title Requirement Id' ;
    rdfs:comment 'Reference to the Schedule B-I requirement, if any, that corresponds to this curative action. Null when the action arises solely from a post-policy claim investigation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleRequirement .

ind:underwritingTitleExaminationId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Title Examination Id' ;
    rdfs:comment 'Foreign key linking to underwriting.underwriting_title_examination. Business justification: Claim curative teams review the original examination to understand the defect\'s history, prior curative attempts, and whether the defect was identified but not' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnderwritingTitleExamination .

ind:uwReferralId rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Id' ;
    rdfs:comment 'Reference to the underwriting referral or policy exception record created when this curative action requires underwriter approval. Null when uw_referral_required is false.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwReferral .

ind:actionDescription rdf:type rdf:Property ;
    rdfs:label 'Action Description' ;
    rdfs:comment 'Free-text narrative describing the specific curative steps being taken, the parties involved, and the legal instruments or proceedings required to clear the identified defect.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionNumber rdf:type rdf:Property ;
    rdfs:label 'Action Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for this curative action, used in correspondence with courts, county recorders, and opposing counsel. Format: CA-YYYY-NNNNNN.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current lifecycle state of the curative action: open (initiated), in_progress (work underway), pending_recording (instrument prepared, awaiting county acceptance), resolved (defect cleared), withdrawn, or escalated.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Classification of the curative remedy being pursued. Examples: lien release, deed correction, quiet title suit, probate proceeding, affidavit of heirship, reconveyance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Cost Amount' ;
    rdfs:comment 'Total actual expenditure incurred to complete this curative action. Compared against estimated cost for reserve accuracy and loss ratio reporting.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Date' ;
    rdfs:comment 'Calendar date on which the curative action was confirmed resolved and the underlying defect or requirement was cleared. Null if still open.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chainOfTitleBreak rdf:type rdf:Property ;
    rdfs:label 'Chain Of Title Break' ;
    rdfs:comment 'Indicates whether the underlying defect involves a break in the chain of title (COT), such as a missing grantor-grantee link, unrecorded conveyance, or vesting discrepancy.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the estimated and actual cost amounts. Typically USD for domestic US title insurance transactions.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Court Jurisdiction' ;
    rdfs:comment 'Name of the court or judicial jurisdiction (county, state, federal district) in which litigation for this curative action has been filed.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeInstrumentType rdf:type rdf:Property ;
    rdfs:label 'Curative Instrument Type' ;
    rdfs:comment 'Type of legal instrument produced or obtained to effect the cure (e.g., release of lien, corrective deed, satisfaction of judgment, reconveyance deed, court order).' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysOpen rdf:type rdf:Property ;
    rdfs:label 'Days Open' ;
    rdfs:comment 'Number of calendar days this curative action has been in an open or in-progress state, calculated from initiated_date. Supports curative action aging and effectiveness metrics per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defectType rdf:type rdf:Property ;
    rdfs:label 'Defect Type' ;
    rdfs:comment 'Classification of the underlying title defect or encumbrance being cured (e.g., mechanics lien, judgment lien, tax lien, HOA lien, chain-of-title break, missing heir, forged deed, encroachment).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationDate rdf:type rdf:Property ;
    rdfs:label 'Escalation Date' ;
    rdfs:comment 'Date on which this curative action was escalated to senior underwriting counsel, litigation, or management due to complexity, aging, or reserve impact. Null if not escalated.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedCostAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost Amount' ;
    rdfs:comment 'Estimated total cost to complete this curative action, including legal fees, court costs, recording fees, and vendor charges. Used for reserve adequacy and loss exposure analysis.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evidenceDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Evidence Document Ref' ;
    rdfs:comment 'Reference identifier or URI to the document management system record containing supporting evidence for this curative action (e.g., signed release, court order, recorded instrument image).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapCureRequired rdf:type rdf:Property ;
    rdfs:label 'Gap Cure Required' ;
    rdfs:comment 'Indicates whether this curative action specifically addresses a gap period risk — the interval between the last search date and the recording of the insured instrument.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initiatedDate rdf:type rdf:Property ;
    rdfs:label 'Initiated Date' ;
    rdfs:comment 'Calendar date on which this curative action was formally initiated by the claim handler or title examiner. Used to measure curative aging and cycle time.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentDocumentNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Document Number' ;
    rdfs:comment 'Official document number, book/page reference, or instrument number assigned by the county recorder upon acceptance of the curative instrument.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentRecordingDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Recording Date' ;
    rdfs:comment 'Date the curative instrument was officially recorded by the county recorder or register of deeds, establishing constructive notice and clearing the defect of record.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCurrentVersion rdf:type rdf:Property ;
    rdfs:label 'Is Current Version' ;
    rdfs:comment 'Boolean flag indicating whether this record represents the current active version of the curative action. False for superseded historical revisions. Supports lifecycle history per VREQ-007.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienAmount rdf:type rdf:Property ;
    rdfs:label 'Lien Amount' ;
    rdfs:comment 'Face amount of the lien, judgment, or encumbrance being cured. Used to assess claim severity and negotiate payoff or release amounts with lienholders.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:litigationCaseNumber rdf:type rdf:Property ;
    rdfs:label 'Litigation Case Number' ;
    rdfs:comment 'Court-assigned case number for quiet title actions, probate proceedings, or other litigation initiated as part of this curative action. Null for non-litigated cures.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outsideCounselEngaged rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Engaged' ;
    rdfs:comment 'Indicates whether outside legal counsel has been retained to pursue this curative action (e.g., quiet title litigation, probate proceedings, or contested lien releases).' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outsideCounselFirmName rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Firm Name' ;
    rdfs:comment 'Name of the external law firm or attorney retained to handle this curative action. Populated only when outside_counsel_engaged is true.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payoffAmount rdf:type rdf:Property ;
    rdfs:label 'Payoff Amount' ;
    rdfs:comment 'Negotiated or agreed payoff amount required to obtain a release or satisfaction of the lien or encumbrance. May differ from the original lien amount due to negotiation or accrued interest.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Business priority assigned to this curative action, reflecting urgency relative to closing readiness, policy issuance lag, or claim reserve exposure.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingRequired rdf:type rdf:Property ;
    rdfs:label 'Recording Required' ;
    rdfs:comment 'Indicates whether the curative instrument must be recorded with the county recorder or register of deeds to be effective against third parties and to clear the title defect.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Amount' ;
    rdfs:comment 'Amount actually recovered through subrogation, indemnification, or third-party contribution related to this curative action. Reduces net loss on the parent claim.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Impact Amount' ;
    rdfs:comment 'Dollar amount by which this curative action affects the case reserve on the parent claim. Positive values increase the reserve; negative values reflect reserve reductions upon resolution.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Free-text notes documenting the outcome of the curative action, including how the defect was cleared, instruments obtained, and any residual risk or exception taken at closing.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationPotential rdf:type rdf:Property ;
    rdfs:label 'Subrogation Potential' ;
    rdfs:comment 'Indicates whether the insurer has identified a potential right of subrogation or recovery against a third party (e.g., prior owner, agent, or closing attorney) arising from this curative action.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Date' ;
    rdfs:comment 'Internally committed or SLA-driven date by which the curative action is expected to be resolved. Used for aging dashboards and closing readiness reporting.' ;
    rdfs:domain ind:ClaimCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titleRiskCauseCode rdf:type rdf:Property ;
    rdfs:label 'Title Risk Cause Code' ;
    rdfs:comment 'Standardized NAIC or underwriter-defined loss cause code categorizing the root title risk driving this curative action. Used for regulatory loss reporting and frequency/severity analytics.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwReferralRequired rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Required' ;
    rdfs:comment 'Indicates whether this curative action requires escalation to the underwriting department for a formal underwriting referral (UWR) or exception approval before the defect can be insured over.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventId rdf:type rdf:Property ;
    rdfs:label 'Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each immutable lifecycle event record in the claim event log. Primary key of the claim_event product.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventClaimantPartyId rdf:type rdf:Property ;
    rdfs:label 'Event Claimant Party Id' ;
    rdfs:comment 'Reference to the party record for the claimant (insured owner or lender) asserting the title insurance claim at this event. Supports contextual party role modeling per VREQ-006.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:eventPartyId rdf:type rdf:Property ;
    rdfs:label 'Event Party Id' ;
    rdfs:comment 'Reference to the internal staff party record for the claims examiner or adjuster assigned to handle this claim at the time of the event. Tracks assignment changes.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:claimNumber rdf:type rdf:Property ;
    rdfs:label 'Claim Number' ;
    rdfs:comment 'Externally visible, human-readable claim identifier assigned by the Claims Administration System at First Notice of Loss (FNOL). Used in all regulatory and correspondence references.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Claimed Loss Amount' ;
    rdfs:comment 'Amount of loss asserted by the claimant at the time of FNOL or as updated at this event. May differ from the ultimate reserve or paid loss amount.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageDecision rdf:type rdf:Property ;
    rdfs:label 'Coverage Decision' ;
    rdfs:comment 'Underwriting coverage determination recorded at this event: whether the claimed loss is covered, denied, partially covered, or pending analysis under the OTP or LTP.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDenialReason rdf:type rdf:Property ;
    rdfs:label 'Coverage Denial Reason' ;
    rdfs:comment 'Reason code or narrative explaining why coverage was denied or limited at this event. Required for regulatory reporting and claimant adverse-action notices.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeActionRequired rdf:type rdf:Property ;
    rdfs:label 'Curative Action Required' ;
    rdfs:comment 'Indicates whether this claim event triggered a curative processing action (e.g., lien release, deed correction, quiet title) rather than a direct indemnity payment.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:curativeActionType rdf:type rdf:Property ;
    rdfs:label 'Curative Action Type' ;
    rdfs:comment 'Type of curative action initiated at this event (e.g., lien_release, deed_correction, quiet_title, reconveyance, satisfaction). [ENUM-REF-CANDIDATE: lien_release|deed_correction|quiet_title|reconveyance|satisfaction|gap_cure|subordination — promote to' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Curative Resolution Date' ;
    rdfs:comment 'Date the curative action associated with this claim event was completed and the title defect resolved. Null if curative action is still open. Supports curative aging analysis.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventDescription rdf:type rdf:Property ;
    rdfs:label 'Event Description' ;
    rdfs:comment 'Free-text narrative describing the specific action, decision, or observation recorded in this event. Supports investigator notes, coverage rationale, and curative resolution details.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Precise date and time (ISO 8601 with timezone offset) at which the claim lifecycle event occurred in the Claims Administration System. Immutable once written.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventType rdf:type rdf:Property ;
    rdfs:label 'Event Type' ;
    rdfs:comment 'Discriminator classifying the kind of lifecycle event recorded. [ENUM-REF-CANDIDATE: fnol_intake|status_change|coverage_decision|reserve_movement|loss_payment|recovery_receipt|assignment_change|investigation_update|curative_action|closure — promote to' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Amount' ;
    rdfs:comment 'Defense, investigation, or allocated loss adjustment expense (ALAE) amount in USD incurred at this event. Tracked separately from indemnity for loss ratio analysis.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fnolDate rdf:type rdf:Property ;
    rdfs:label 'Fnol Date' ;
    rdfs:comment 'Date the claimant first reported the title loss or defect to the insurer. Anchors claim frequency and aging calculations. Distinct from event_timestamp.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ibnrFlag rdf:type rdf:Property ;
    rdfs:label 'Ibnr Flag' ;
    rdfs:comment 'Indicates whether this event is associated with an IBNR reserve estimate rather than a reported claim. Supports actuarial IBNR development and NAIC Schedule P reporting.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationStartDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Start Date' ;
    rdfs:comment 'Date the formal claim investigation was initiated. Used to measure investigation cycle time and compliance with state prompt-payment statutes.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossDate rdf:type rdf:Property ;
    rdfs:label 'Loss Date' ;
    rdfs:comment 'Date the underlying title defect, encumbrance, or adverse claim event occurred or was discovered. Used for policy-year loss development and IBNR estimation.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Payment Amount' ;
    rdfs:comment 'Indemnity payment amount in USD disbursed to the claimant at this event. Zero for non-payment events. Feeds claim severity and loss ratio calculations.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newClaimStatus rdf:type rdf:Property ;
    rdfs:label 'New Claim Status' ;
    rdfs:comment 'Claim lifecycle status resulting from this event. Together with prior_claim_status, captures every material status transition for regulatory and operational reporting.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorClaimStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Claim Status' ;
    rdfs:comment 'Claim lifecycle status immediately before this event was applied. Preserved for lifecycle history and transition auditing per VREQ-007. [ENUM-REF-CANDIDATE: open|under_investigation|reserved|pending_payment|subrogation|closed|reopened — 7 candidates' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Reserve Amount' ;
    rdfs:comment 'Case reserve amount in USD immediately before this reserve movement event. Enables calculation of reserve development and supports IBNR analysis.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionChannel rdf:type rdf:Property ;
    rdfs:label 'Production Channel' ;
    rdfs:comment 'Channel through which the original title order and policy were produced (direct branch, centralized lender, or independent agent). Enables loss ratio analysis by distribution channel.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportPeriod rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Period' ;
    rdfs:comment 'Reporting period (e.g., 2024-Q3, 2024-FY) to which this claim event is attributed for NAIC Annual Statement and state Department of Insurance loss reporting.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Amount' ;
    rdfs:comment 'Case reserve amount in USD established or adjusted at this event. Represents the estimated ultimate loss for the claim at this point in time. Supports reserve movement tracking.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Change Amount' ;
    rdfs:comment 'Net change in case reserve at this event (new minus prior). Positive indicates reserve strengthening; negative indicates reserve reduction. Used in loss development reporting.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sequence rdf:type rdf:Property ;
    rdfs:label 'Sequence' ;
    rdfs:comment 'Monotonically increasing integer ordering events within a single claim. Enables reconstruction of the full claim lifecycle in chronological order.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Source Reference Code' ;
    rdfs:comment 'Native identifier of this event in the originating source system (e.g., Claims Administration System transaction ID). Enables reconciliation and lineage tracing back to the SoR.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationInitiated rdf:type rdf:Property ;
    rdfs:label 'Subrogation Initiated' ;
    rdfs:comment 'Indicates whether a subrogation or recovery action was initiated at or before this event. Supports recovery tracking and net loss reporting.' ;
    rdfs:domain ind:Event ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subrogationStatus rdf:type rdf:Property ;
    rdfs:label 'Subrogation Status' ;
    rdfs:comment 'Current status of the subrogation or recovery action as of this event. Tracks progression from initiation through recovery or closure without recovery.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleRiskCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Title Risk Cause Description' ;
    rdfs:comment 'Human-readable description of the title risk cause associated with this claim event. Complements the structured cause code with examiner narrative.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimPartyId rdf:type rdf:Property ;
    rdfs:label 'Claim Party Id' ;
    rdfs:comment 'Unique surrogate identifier for each claim-party association record in the Claims Administration System.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Loss Amount' ;
    rdfs:comment 'Dollar amount of loss approved for indemnity payment to this party following investigation and coverage analysis. May differ from claimed_loss_amount.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Primary email address for claim correspondence with this party. NPPI — restricted per GLBA and CCPA/CPRA.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary telephone number for claim correspondence with this party. NPPI — restricted per GLBA and CCPA/CPRA.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counselBarNumber rdf:type rdf:Property ;
    rdfs:label 'Counsel Bar Number' ;
    rdfs:comment 'State bar license number of the attorney representing this party. Validates counsel eligibility and supports defense-cost audit.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counselFirmName rdf:type rdf:Property ;
    rdfs:label 'Counsel Firm Name' ;
    rdfs:comment 'Name of the law firm representing this party on the claim. Populated when representation_type is attorney_represented. Used for defense cost tracking.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageDetermination rdf:type rdf:Property ;
    rdfs:label 'Coverage Determination' ;
    rdfs:comment 'Outcome of the coverage analysis for this party\'s claim. Indicates whether the loss is covered, partially covered, denied, or pending underwriting review.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:demandLetterDate rdf:type rdf:Property ;
    rdfs:label 'Demand Letter Date' ;
    rdfs:comment 'Date on which a formal demand letter was received from or sent to this party. Triggers response deadlines and escalation workflows in the claims system.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Method' ;
    rdfs:comment 'Method used to verify the identity of this party. Supports fraud-control audit trails and regulatory compliance with FinCEN and GLBA requirements.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityVerifiedIndicator rdf:type rdf:Property ;
    rdfs:label 'Identity Verified Indicator' ;
    rdfs:comment 'Indicates whether the identity of this party has been verified through acceptable documentation (e.g., government-issued ID). Supports fraud controls and NPPI compliance.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isAdverseParty rdf:type rdf:Property ;
    rdfs:label 'Is Adverse Party' ;
    rdfs:comment 'Indicates whether this party is an adverse party asserting a competing interest or title defect against the insured. Drives litigation and curative strategy.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInsuredParty rdf:type rdf:Property ;
    rdfs:label 'Is Insured Party' ;
    rdfs:comment 'Indicates whether this party holds insured status under the referenced title policy (OTP or LTP). Distinguishes insured parties from adverse or third-party participants.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryClaimant rdf:type rdf:Property ;
    rdfs:label 'Is Primary Claimant' ;
    rdfs:comment 'Indicates whether this party is the primary claimant on the claim. True for the lead insured asserting the loss; False for co-claimants or other roles.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailingAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line1' ;
    rdfs:comment 'First line of the mailing address for this party on the claim file. Used for legal notices and loss-payment correspondence. NPPI — restricted.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Mailing Address Line2' ;
    rdfs:comment 'Second line of the mailing address (suite, unit, floor) for this party. Supplements address line 1 for legal notice delivery. NPPI — restricted.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCity rdf:type rdf:Property ;
    rdfs:label 'Mailing City' ;
    rdfs:comment 'City of the mailing address for this party. Required for legal notice delivery and state regulatory loss reporting. NPPI — restricted.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingPostalCode rdf:type rdf:Property ;
    rdfs:label 'Mailing Postal Code' ;
    rdfs:comment 'ZIP or ZIP+4 postal code for the party\'s mailing address. Supports geographic loss analysis and regulatory reporting.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingStateCode rdf:type rdf:Property ;
    rdfs:label 'Mailing State Code' ;
    rdfs:comment 'Two-letter USPS state abbreviation for the party\'s mailing address. Used for state DOI regulatory reporting and jurisdictional routing.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameAlias rdf:type rdf:Property ;
    rdfs:label 'Name Alias' ;
    rdfs:comment 'Alternate name, doing-business-as (DBA), or prior legal name for the party. Used in chain-of-title matching and adverse-party identification. NPPI — restricted.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeOfClaimDate rdf:type rdf:Property ;
    rdfs:label 'Notice Of Claim Date' ;
    rdfs:comment 'Date on which this party provided or received formal notice of the claim (FNOL). Anchors the claim reporting timeline and regulatory notice requirements.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nppiVaultReference rdf:type rdf:Property ;
    rdfs:label 'Nppi Vault Reference' ;
    rdfs:comment 'Tokenized reference key to the NPPI Vault record holding SSN/TIN, identity document, and signature data for this party. Actual NPPI is never stored in the lakehouse.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyRole rdf:type rdf:Property ;
    rdfs:label 'Party Role' ;
    rdfs:comment 'Contextual role this party holds on the claim. One party may hold multiple simultaneous roles via separate records. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyType rdf:type rdf:Property ;
    rdfs:label 'Party Type' ;
    rdfs:comment 'Classification of the party as an individual person, legal organization, government entity, trust, or estate. Drives NPPI handling and legal notice requirements.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerOfAttorneyIndicator rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Indicator' ;
    rdfs:comment 'Indicates whether this party is acting under a power of attorney on behalf of another principal. Triggers additional documentation and identity verification requirements.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:releaseExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Release Execution Date' ;
    rdfs:comment 'Date on which this party executed a release of claims or satisfaction instrument. Required before final loss payment disbursement and claim closure.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:representationType rdf:type rdf:Property ;
    rdfs:label 'Representation Type' ;
    rdfs:comment 'Indicates how the party is represented on the claim: self-represented, through retained counsel, guardian, power of attorney, or trustee.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Resolution Status' ;
    rdfs:comment 'Current resolution status of this party\'s involvement in the claim. Tracks progression from open through settlement, release, litigation, or subrogation to closure.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Role Effective Date' ;
    rdfs:comment 'Date on which this party\'s role became effective on the claim. Supports effective-dated role history per VREQ-005 and VREQ-007.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:roleEndDate rdf:type rdf:Property ;
    rdfs:label 'Role End Date' ;
    rdfs:comment 'Date on which this party\'s role on the claim ended or was superseded. Null if the role is currently active. Enables lifecycle history preservation.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:roleStatus rdf:type rdf:Property ;
    rdfs:label 'Role Status' ;
    rdfs:comment 'Current lifecycle status of this party\'s role on the claim. Tracks whether the party is actively participating, has withdrawn, or has been substituted.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Agreement Date' ;
    rdfs:comment 'Date on which a settlement agreement was executed with this party. Marks the resolution milestone for loss-payment and claim-closure processing.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemPartyRef rdf:type rdf:Property ;
    rdfs:label 'Source System Party Ref' ;
    rdfs:comment 'Identifier assigned to this claim-party association in the originating Claims Administration System (e.g., SoftPro, RamQuest). Supports lineage and reconciliation.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdVaultReference rdf:type rdf:Property ;
    rdfs:label 'Tax Id Vault Reference' ;
    rdfs:comment 'Tokenized reference key to the NPPI Vault for this party\'s TIN or SSN. Required for IRS 1099-S reporting on loss payments. Actual TIN/SSN never stored in the lakehouse.' ;
    rdfs:domain ind:ClaimParty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveId rdf:type rdf:Property ;
    rdfs:label 'Reserve Id' ;
    rdfs:comment 'Unique surrogate identifier for this effective-dated claim reserve record within the Claims Administration System.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByUserPartyId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Party Id' ;
    rdfs:comment 'Internal user identifier of the supervisor or underwriting authority who approved this reserve, required when reserve exceeds authority threshold.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorReserveId rdf:type rdf:Property ;
    rdfs:label 'Prior Reserve Id' ;
    rdfs:comment 'Reference to the immediately preceding reserve record that this record revises or supersedes, enabling a full audit chain of reserve movements.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Reserve .

ind:accidentYear rdf:type rdf:Property ;
    rdfs:label 'Accident Year' ;
    rdfs:comment 'Year in which the title defect or loss event is deemed to have occurred for actuarial loss development triangle and IBNR estimation purposes.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialMethodCode rdf:type rdf:Property ;
    rdfs:label 'Actuarial Method Code' ;
    rdfs:comment 'Actuarial development method used to estimate IBNR or bulk reserve amounts: chain ladder, Bornhuetter-Ferguson, expected loss, frequency-severity, or judgment.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adequacyReviewDate rdf:type rdf:Property ;
    rdfs:label 'Adequacy Review Date' ;
    rdfs:comment 'Date of the most recent periodic reserve adequacy review performed by the actuary or claims supervisor for this claim reserve record.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alaeReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Alae Reserve Amount' ;
    rdfs:comment 'Reserve for allocated loss adjustment expenses directly attributable to this claim, such as attorney fees, curative costs, and investigation expenses.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalRequired rdf:type rdf:Property ;
    rdfs:label 'Approval Required' ;
    rdfs:comment 'Indicates whether this reserve amount exceeded the claims examiner authority threshold and required supervisory or underwriting approval before activation.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:basis rdf:type rdf:Property ;
    rdfs:label 'Basis' ;
    rdfs:comment 'Indicates whether this reserve record represents the initial establishment, a subsequent revision, or the final reserve set at claim closure.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Amount' ;
    rdfs:comment 'Estimated total indemnity and expense amount reserved for this specific claim based on current investigation findings. Denominated in currency_code.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curativeActionPending rdf:type rdf:Property ;
    rdfs:label 'Curative Action Pending' ;
    rdfs:comment 'Indicates whether an active curative action (e.g., quiet title, lien release, deed correction) is in progress that may reduce or eliminate the reserve.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ibnrReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Ibnr Reserve Amount' ;
    rdfs:comment 'Actuarially estimated reserve for losses incurred but not yet reported or fully developed on this claim or cohort. Zero for case reserves.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:largeLossFlag rdf:type rdf:Property ;
    rdfs:label 'Large Loss Flag' ;
    rdfs:comment 'Indicates whether this reserve meets or exceeds the underwriter-defined large-loss threshold, triggering enhanced oversight and executive reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:largeLossThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Large Loss Threshold Amount' ;
    rdfs:comment 'Dollar threshold in effect at the time this reserve was set that determines large-loss classification. Preserved for audit and threshold-change analysis.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:litigationFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Flag' ;
    rdfs:comment 'Indicates whether this claim has entered active litigation (e.g., quiet title action, foreclosure defense), which typically elevates ALAE reserve requirements.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Loss Reserve Amount' ;
    rdfs:comment 'Indemnity-only component of the case reserve, representing estimated title-loss payment to the insured, excluding allocated loss adjustment expenses.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Net Reserve Amount' ;
    rdfs:comment 'Gross case reserve less reinsurance recoverable and subrogation reserve, representing the net retained reserve exposure for statutory reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Policy Liability Amount' ;
    rdfs:comment 'Face amount of the title-insurance policy (Schedule A liability) against which this claim is made. Used to compute reserve-to-liability ratio.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyYear rdf:type rdf:Property ;
    rdfs:label 'Policy Year' ;
    rdfs:comment 'Year in which the underlying title-insurance policy was issued. Used for cohort-based loss ratio and frequency/severity analysis by policy vintage.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reinsuranceRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Recoverable Amount' ;
    rdfs:comment 'Estimated amount recoverable from reinsurance treaties or facultative placements applicable to this claim, reducing net reserve exposure.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingPeriodQuarter rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Quarter' ;
    rdfs:comment 'Fiscal quarter (1–4) within the reporting year to which this reserve record is assigned for quarterly statutory and management reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportingPeriodYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Year' ;
    rdfs:comment 'Calendar or accident year to which this reserve is assigned for NAIC statutory loss triangle and state Department of Insurance reporting purposes.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveNumber rdf:type rdf:Property ;
    rdfs:label 'Reserve Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for this reserve record as assigned by the Claims Administration System (e.g., RES-2024-000123).' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveStatus rdf:type rdf:Property ;
    rdfs:label 'Reserve Status' ;
    rdfs:comment 'Current lifecycle state of this reserve record: open (active), revised (superseded by a newer record), closed, reinstated, or voided.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveType rdf:type rdf:Property ;
    rdfs:label 'Reserve Type' ;
    rdfs:comment 'Classification of the reserve: case (specific claim), IBNR (Incurred But Not Reported), bulk, salvage, subrogation recovery, or unallocated loss reserve.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionNotes rdf:type rdf:Property ;
    rdfs:label 'Revision Notes' ;
    rdfs:comment 'Free-text examiner notes documenting the rationale for establishing or revising this reserve, including key facts from investigation or curative status.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Revision Reason Code' ;
    rdfs:comment 'Coded reason for this reserve revision: new information, settlement update, curative resolution, court order, actuarial review, periodic review, or closure.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionSequence rdf:type rdf:Property ;
    rdfs:label 'Revision Sequence' ;
    rdfs:comment 'Monotonically increasing integer indicating the revision number of this reserve for the parent claim (1 = initial, 2 = first revision, etc.).' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:setByRole rdf:type rdf:Property ;
    rdfs:label 'Set By Role' ;
    rdfs:comment 'Role of the individual who established or last revised this reserve: claims examiner, underwriter, actuary, supervisor, or automated system rule.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:setDate rdf:type rdf:Property ;
    rdfs:label 'Set Date' ;
    rdfs:comment 'Calendar date on which the reserve was formally established or revised by the authorized examiner, underwriter, or actuary in the Claims Administration System.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Subrogation Reserve Amount' ;
    rdfs:comment 'Estimated recoverable amount through subrogation or salvage rights against responsible third parties, netted against gross reserve for loss ratio reporting.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toLiabilityPct rdf:type rdf:Property ;
    rdfs:label 'To Liability Pct' ;
    rdfs:comment 'Ratio of total case reserve to policy face liability, expressed as a decimal (e.g., 0.4500 = 45%). Supports severity and adequacy monitoring.' ;
    rdfs:domain ind:Reserve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageDecisionId rdf:type rdf:Property ;
    rdfs:label 'Coverage Decision Id' ;
    rdfs:comment 'Unique surrogate identifier for the coverage decision record. Primary key for the coverage_decision entity within the Claims Administration System.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageApprovingAuthorityPartyId rdf:type rdf:Property ;
    rdfs:label 'Coverage Approving Authority Party Id' ;
    rdfs:comment 'Reference to the supervisor, underwriting manager, or counsel who approved the coverage decision, required when the decision exceeds delegated authority thresholds.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:coveragePartyId rdf:type rdf:Property ;
    rdfs:label 'Coverage Party Id' ;
    rdfs:comment 'Reference to the claims examiner or underwriting counsel who authored and issued the coverage determination. Primary party responsible for the decision.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:investigationId rdf:type rdf:Property ;
    rdfs:label 'Investigation Id' ;
    rdfs:comment 'Reference to the claim investigation that produced the factual and legal basis for this coverage determination.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investigation .

ind:priorDecisionCoverageDecisionId rdf:type rdf:Property ;
    rdfs:label 'Prior Decision Coverage Decision Id' ;
    rdfs:comment 'Reference to the preceding coverage decision record that this record revises or supersedes. Supports lifecycle history and revision chain tracking per VREQ-007.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageDecision .

ind:recordedInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Recorded Instrument Id' ;
    rdfs:comment 'Foreign key linking to recording.recorded_instrument. Business justification: Coverage decisions reference specific recorded instruments to determine whether defect falls within Schedule B exceptions or covered risks.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecordedInstrument .

ind:titleCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Title Commitment Id' ;
    rdfs:comment 'Foreign key linking to underwriting.title_commitment. Business justification: Coverage counsel analyzes the commitment to verify whether the loss cause was excepted in Schedule B, required to be satisfied, or covered.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleCommitment .

ind:appealDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Deadline Date' ;
    rdfs:comment 'The date by which the claimant must file an appeal or request reconsideration of the coverage decision, per policy terms and state regulatory requirements.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Received Date' ;
    rdfs:comment 'Date on which a formal appeal or reconsideration request was received from the claimant or their counsel following issuance of the coverage decision.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chainOfTitleBreakFlag rdf:type rdf:Property ;
    rdfs:label 'Chain Of Title Break Flag' ;
    rdfs:comment 'Indicates whether a break in the chain of title (COT) is the root cause of the covered or denied loss, supporting title-specific defect analytics.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverageAnalysisNarrative rdf:type rdf:Property ;
    rdfs:label 'Coverage Analysis Narrative' ;
    rdfs:comment 'Full text of the coverage analysis explaining the legal and factual basis for the coverage position, including policy provisions, exclusions, and exceptions applied.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveragePosition rdf:type rdf:Property ;
    rdfs:label 'Coverage Position' ;
    rdfs:comment 'Formal coverage determination outcome: covered (full indemnity), denied (no coverage), partial (limited coverage), reservation_of_rights (coverage not yet confirmed), or excess_only.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coveredLossAmount rdf:type rdf:Property ;
    rdfs:label 'Covered Loss Amount' ;
    rdfs:comment 'The dollar amount of the claimed loss determined to be covered under the policy. May be less than the claimed loss amount for partial coverage decisions.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coveredRiskNumber rdf:type rdf:Property ;
    rdfs:label 'Covered Risk Number' ;
    rdfs:comment 'ALTA policy covered risk number (e.g., Covered Risk 1, 8, 11) that affirmatively supports coverage for the claimed loss, cited in the coverage analysis.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeResolutionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Curative Resolution Required Flag' ;
    rdfs:comment 'Indicates whether the coverage decision is conditioned on or accompanied by a curative action to resolve the underlying title defect before or after indemnity.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:decisionDate rdf:type rdf:Property ;
    rdfs:label 'Decision Date' ;
    rdfs:comment 'Calendar date on which the formal coverage position was determined and documented by the claims examiner or underwriting counsel.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionNumber rdf:type rdf:Property ;
    rdfs:label 'Decision Number' ;
    rdfs:comment 'Externally-visible alphanumeric identifier assigned to this coverage decision by the Claims Administration System. Used in correspondence and regulatory reporting.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionStatus rdf:type rdf:Property ;
    rdfs:label 'Decision Status' ;
    rdfs:comment 'Current lifecycle state of the coverage decision. Tracks progression from initial draft through issuance, any appeal or revision, and final disposition.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Decision Timestamp' ;
    rdfs:comment 'Precise date and time the coverage decision record was created in the Claims Administration System. Supports audit trail and SLA measurement.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:decisionType rdf:type rdf:Property ;
    rdfs:label 'Decision Type' ;
    rdfs:comment 'Classifies the decision as initial (first determination), supplemental (additional coverage analysis), revised (updated position), or final (closing determination).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialReasonCode rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Code' ;
    rdfs:comment 'Standardized code identifying the primary reason for a coverage denial or limitation (e.g., known_defect, policy_exclusion, schedule_b_exception, no_insured_loss).' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:denialReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Denial Reason Description' ;
    rdfs:comment 'Free-text explanation of the denial reason, supplementing the denial_reason_code with specific facts and policy language supporting the denial.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deniedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Denied Loss Amount' ;
    rdfs:comment 'The dollar amount of the claimed loss determined not to be covered under the policy. Supports partial coverage and denial analytics.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsementApplicabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Endorsement Applicability Flag' ;
    rdfs:comment 'Indicates whether one or more ALTA endorsements attached to the policy affect the scope of coverage for this claim (e.g., ALTA 9, ALTA 8.1, ALTA 22).' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endorsementReferences rdf:type rdf:Property ;
    rdfs:label 'Endorsement References' ;
    rdfs:comment 'Comma-separated list of ALTA endorsement numbers (e.g., ALTA 9, ALTA 8.1) that expand or restrict coverage and are cited in this coverage determination.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionItemReference rdf:type rdf:Property ;
    rdfs:label 'Exception Item Reference' ;
    rdfs:comment 'Specific Schedule B-II exception item number or description from the issued policy that limits or bars coverage for the claimed loss.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excessAmount rdf:type rdf:Property ;
    rdfs:label 'Excess Amount' ;
    rdfs:comment 'For excess_only coverage positions, the dollar amount of loss that falls above the primary coverage layer and is subject to excess policy terms.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionNumber rdf:type rdf:Property ;
    rdfs:label 'Exclusion Number' ;
    rdfs:comment 'Specific exclusion number from the ALTA policy form (e.g., Exclusion 3(a), Exclusion 5) cited as the basis for a denial or limitation of coverage.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Flag' ;
    rdfs:comment 'Indicates whether the claim arises from a gap period between the effective date of the title search and the recording of the insured instrument.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Issued Timestamp' ;
    rdfs:comment 'Date and time the coverage decision was formally communicated to the claimant or their counsel. Distinct from the internal decision date.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:outsideCounselEngagedFlag rdf:type rdf:Property ;
    rdfs:label 'Outside Counsel Engaged Flag' ;
    rdfs:comment 'Indicates whether outside legal counsel has been retained to support the coverage analysis, defense, or curative resolution associated with this decision.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partialCoverageDescription rdf:type rdf:Property ;
    rdfs:label 'Partial Coverage Description' ;
    rdfs:comment 'Narrative describing the scope and limitations of partial coverage when coverage_position is \'partial\', specifying what is and is not covered.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:promptPayCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Prompt Pay Compliant Flag' ;
    rdfs:comment 'Indicates whether the coverage decision was issued within the state-mandated prompt-pay deadline. Supports regulatory compliance monitoring and DOI reporting.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryPromptPayDeadline rdf:type rdf:Property ;
    rdfs:label 'Regulatory Prompt Pay Deadline' ;
    rdfs:comment 'State-mandated deadline by which the insurer must issue a coverage decision or payment following receipt of a complete proof of loss, per state prompt-pay statutes.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rorBasisDescription rdf:type rdf:Property ;
    rdfs:label 'Ror Basis Description' ;
    rdfs:comment 'Explanation of the legal and factual basis for issuing a reservation of rights letter when coverage_position is \'reservation_of_rights\', pending further investigation.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleAReference rdf:type rdf:Property ;
    rdfs:label 'Schedule A Reference' ;
    rdfs:comment 'Citation to the Schedule A provision of the title policy (insured estate, vesting, legal description) relied upon in the coverage analysis.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleBSection rdf:type rdf:Property ;
    rdfs:label 'Schedule B Section' ;
    rdfs:comment 'Identifies which Schedule B section is implicated: B-I (Requirements), B-II (Exceptions), both, or none. Drives the legal basis for denial or limitation.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwReferralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Required Flag' ;
    rdfs:comment 'Indicates whether this coverage decision required escalation to the underwriting department for a formal underwriting opinion before the position could be issued.' ;
    rdfs:domain ind:CoverageDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investigationAssignedCounselPartyId rdf:type rdf:Property ;
    rdfs:label 'Investigation Assigned Counsel Party Id' ;
    rdfs:comment 'Reference to the outside legal counsel or panel attorney assigned to support the investigation when litigation or curative legal action is required.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:investigationPartyId rdf:type rdf:Property ;
    rdfs:label 'Investigation Party Id' ;
    rdfs:comment 'Reference to the internal staff member or external counsel assigned as lead investigator for this claim investigation. Supports workload management and investigator performance reporting.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:agencyInvolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Agency Involved Flag' ;
    rdfs:comment 'Indicates whether an independent title agent was involved in the originating transaction. Triggers agency oversight review and potential E&O coverage analysis.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:apn rdf:type rdf:Property ;
    rdfs:label 'Apn' ;
    rdfs:comment 'Assessor\'s Parcel Number (APN) or Parcel Identification Number (PIN) assigned by the county assessor for the subject property. Supports property data linkage and county record research.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimantName rdf:type rdf:Property ;
    rdfs:label 'Claimant Name' ;
    rdfs:comment 'Full legal name of the party asserting the claim, which may differ from the named insured (e.g., successor, lender assignee). NPPI — handle per GLBA and CCPA/CPRA.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeActionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Curative Action Required Flag' ;
    rdfs:comment 'Indicates whether the investigation determined that curative processing (e.g., lien release, deed correction, quiet title action) is required to resolve the title defect underlying the claim.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:curativeActionStatus rdf:type rdf:Property ;
    rdfs:label 'Curative Action Status' ;
    rdfs:comment 'Current status of curative processing activities initiated as a result of the investigation findings. Supports curative action aging and effectiveness metrics.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Curative Completion Date' ;
    rdfs:comment 'Date on which all curative actions required to resolve the title defect were completed. Null if curative action is not required or still in progress.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentReceiptDate rdf:type rdf:Property ;
    rdfs:label 'Document Receipt Date' ;
    rdfs:comment 'Date on which all requested documents and evidence were received from the claimant or third parties, enabling the investigation to proceed from pending_docs status.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentRequestDate rdf:type rdf:Property ;
    rdfs:label 'Document Request Date' ;
    rdfs:comment 'Date on which the investigator issued a formal request for additional documents or evidence from the claimant or third parties. Supports pending_docs status tracking.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eoCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Eo Coverage Flag' ;
    rdfs:comment 'Indicates whether the claim may be covered under an Errors and Omissions (E&O) policy held by the agent or closing attorney, potentially reducing net loss to the underwriter.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Loss Amount' ;
    rdfs:comment 'Investigator\'s estimate of the total monetary loss exposure identified during the investigation, in USD. Used to inform initial reserve setting and severity analysis.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evidenceCompleteFlag rdf:type rdf:Property ;
    rdfs:label 'Evidence Complete Flag' ;
    rdfs:comment 'Indicates whether all required evidentiary documents (deeds, instruments, search results, affidavits) have been received and reviewed. Supports evidence completeness and provenance metrics.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingsNarrative rdf:type rdf:Property ;
    rdfs:label 'Findings Narrative' ;
    rdfs:comment 'Detailed free-text narrative summarizing the investigation findings, including chain-of-title defects identified, evidence reviewed, and conclusions reached by the investigator.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forgeryFraudFlag rdf:type rdf:Property ;
    rdfs:label 'Forgery Fraud Flag' ;
    rdfs:comment 'Indicates whether the investigation identified forgery, fraud, or misrepresentation as a contributing cause of the title defect or loss. Triggers FinCEN SAR filing review.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuredName rdf:type rdf:Property ;
    rdfs:label 'Insured Name' ;
    rdfs:comment 'Full legal name of the insured party (owner or lender) under the title policy as of the investigation. Captured for claim correspondence and regulatory reporting. NPPI — handle per GLBA.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current lifecycle state of the investigation. Drives workflow routing and SLA tracking. Values: open, pending_docs, pending_legal, complete, closed.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investigationType rdf:type rdf:Property ;
    rdfs:label 'Investigation Type' ;
    rdfs:comment 'Classification of the investigation by title-risk cause category. Supports claim frequency and severity analysis by title-risk cause. [ENUM-REF-CANDIDATE: title_defect|lien|encumbrance|forgery|fraud|boundary|access|other — promote to reference product]' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the most recent documented activity or update on the investigation. Used to identify stale or aging investigations requiring follow-up.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyAmount rdf:type rdf:Property ;
    rdfs:label 'Policy Amount' ;
    rdfs:comment 'The face amount of insurance stated in the title policy under which the claim is filed, in USD. Establishes the maximum indemnity exposure for coverage analysis.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyAddress rdf:type rdf:Property ;
    rdfs:label 'Property Address' ;
    rdfs:comment 'Full street address of the insured property subject to the claim investigation. Denormalized for investigation reporting; authoritative address is on the property/parcel record.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendedReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Recommended Reserve Amount' ;
    rdfs:comment 'Reserve amount recommended by the investigator based on investigation findings, in USD. Feeds into the reserving workflow for case reserve establishment or adjustment.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether this investigation triggers mandatory regulatory reporting to NAIC, state Department of Insurance, or other regulatory bodies based on loss amount or claim type thresholds.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:startDate rdf:type rdf:Property ;
    rdfs:label 'Start Date' ;
    rdfs:comment 'Calendar date on which the formal investigation was opened and assigned. Used to measure investigation cycle time and SLA compliance from FNOL intake.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationPotentialFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Potential Flag' ;
    rdfs:comment 'Indicates whether the investigation identified potential subrogation or recovery rights against a third party (e.g., prior owner, agent, attorney, surveyor) responsible for the title defect.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subrogationTargetParty rdf:type rdf:Property ;
    rdfs:label 'Subrogation Target Party' ;
    rdfs:comment 'Name or description of the third party against whom subrogation or recovery rights may be pursued based on investigation findings. Populated when subrogation_potential_flag is true.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Internally assigned target date by which the investigation should be completed per SLA or claim handling guidelines. Supports aging and SLA breach reporting.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:underwriterOpinion rdf:type rdf:Property ;
    rdfs:label 'Underwriter Opinion' ;
    rdfs:comment 'Formal coverage opinion issued by the underwriting department following referral. Informs the final coverage determination and claim resolution strategy.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterReferralDate rdf:type rdf:Property ;
    rdfs:label 'Underwriter Referral Date' ;
    rdfs:comment 'Date on which the investigation was referred to the underwriting department for coverage opinion or risk assessment. Null if no underwriter referral was made.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:underwriterReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Underwriter Referral Flag' ;
    rdfs:comment 'Indicates whether the investigation was escalated to the underwriting department for coverage opinion or risk referral due to complexity or exposure threshold breach.' ;
    rdfs:domain ind:Investigation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossPaymentId rdf:type rdf:Property ;
    rdfs:label 'Loss Payment Id' ;
    rdfs:comment 'Unique surrogate identifier for each indemnity disbursement record in the claims administration system. Primary key for the loss_payment entity.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:disbursementId rdf:type rdf:Property ;
    rdfs:label 'Disbursement Id' ;
    rdfs:comment 'Foreign key linking to settlement.disbursement. Business justification: When claims result in corrective disbursements or when original settlement disbursements are disputed, linking loss payments to the original disbursement tracks remediation, enables' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Disbursement .

ind:lossPartyId rdf:type rdf:Property ;
    rdfs:label 'Loss Party Id' ;
    rdfs:comment 'Reference to the claims examiner, underwriter, or officer who authorized this loss payment. Supports segregation-of-duties audit and authority-level compliance.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:lossPayeePartyId rdf:type rdf:Property ;
    rdfs:label 'Loss Payee Party Id' ;
    rdfs:comment 'Reference to the party entity receiving this loss payment (claimant, lender, attorney, curative vendor, or court). Supports party-role contextual modeling.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorPaymentLossPaymentId rdf:type rdf:Property ;
    rdfs:label 'Prior Payment Loss Payment Id' ;
    rdfs:comment 'Self-referencing link to the original payment record if this record represents a replacement, reissuance, or correction of a prior payment. Null for original disbursements.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LossPayment .

ind:recoveryReceiptId rdf:type rdf:Property ;
    rdfs:label 'Recovery Receipt Id' ;
    rdfs:comment 'Reference to the associated subrogation or recovery record if a recovery action has been initiated against a third party for this loss payment. Null if no recovery pursued.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecoveryReceipt .

ind:approvalAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Authority Level' ;
    rdfs:comment 'Organizational authority tier required and used to approve this payment (examiner, supervisor, manager, VP, executive). Driven by payment amount thresholds per claims authority matrix.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Amount' ;
    rdfs:comment 'Amount formally authorized by the claims examiner or underwriter for disbursement. May differ from payment_amount if partial payment or adjustment was applied post-approval.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankAccountRef rdf:type rdf:Property ;
    rdfs:label 'Bank Account Ref' ;
    rdfs:comment 'Tokenized or masked reference to the destination bank account used for wire or ACH disbursement. Full account details stored in the NPPI Vault per VREQ-012 and GLBA.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearedDate rdf:type rdf:Property ;
    rdfs:label 'Cleared Date' ;
    rdfs:comment 'Date on which the disbursed payment was confirmed cleared by the financial institution (check cleared, wire settled, ACH confirmed). Used for bank reconciliation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'Finance cost center to which this loss payment expense is allocated. Supports branch-level, channel-level, and underwriter-level loss ratio reporting.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Paid Amount' ;
    rdfs:comment 'Running total of all loss payments disbursed on the parent claim as of this payment record. Supports policy limit exhaustion monitoring and severity tracking.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irs1099Required rdf:type rdf:Property ;
    rdfs:label 'Irs 1099 Required' ;
    rdfs:comment 'Indicates whether this loss payment requires IRS Form 1099 reporting to the payee and the IRS. Driven by payment type, payee tax status, and IRS threshold rules.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFinalPayment rdf:type rdf:Property ;
    rdfs:label 'Is Final Payment' ;
    rdfs:comment 'Indicates whether this disbursement is the final loss payment on the claim, signaling that the claim is ready for closure after this payment clears. True = final payment.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicLossCauseCode rdf:type rdf:Property ;
    rdfs:label 'Naic Loss Cause Code' ;
    rdfs:comment 'NAIC-standardized loss cause code used in Annual Statement Schedule T and state DOI regulatory filings. Maps internal title risk cause to the NAIC reporting taxonomy.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeName rdf:type rdf:Property ;
    rdfs:label 'Payee Name' ;
    rdfs:comment 'Full legal name of the individual or entity receiving the loss payment as it appears on the disbursement instrument (check payee line or wire beneficiary name).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payeeType rdf:type rdf:Property ;
    rdfs:label 'Payee Type' ;
    rdfs:comment 'Classification of the payee role for this disbursement: claimant, lender (mortgagee), attorney, curative vendor, court, or insured. Supports loss-cause and payee-mix analytics.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Gross amount disbursed in this loss payment transaction, expressed in the payment currency. Core monetary fact for claim severity and loss ratio analysis.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDate rdf:type rdf:Property ;
    rdfs:label 'Payment Date' ;
    rdfs:comment 'Calendar date on which the loss payment was actually disbursed to the payee. Principal business event date for claim payment lag and loss ratio period assignment.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentNotes rdf:type rdf:Property ;
    rdfs:label 'Payment Notes' ;
    rdfs:comment 'Free-text examiner notes documenting the basis for this payment, any conditions, partial payment rationale, or special handling instructions. Supports claims audit trail.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for this loss payment disbursement, assigned by the claims administration system (e.g., LP-2024-000123).' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Reference Number' ;
    rdfs:comment 'External reference number assigned by the bank, wire network, or check processor for this disbursement (e.g., wire confirmation number, check number, ACH trace ID).' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentStatus rdf:type rdf:Property ;
    rdfs:label 'Payment Status' ;
    rdfs:comment 'Current lifecycle state of the loss payment: pending (awaiting approval), approved, issued (disbursed), cleared (bank confirmed), voided, or returned (funds recovered).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the disbursement purpose: indemnity (direct loss), curative_cost (title defect cure), defense_cost (legal defense), settlement (negotiated resolution), or court_ordered.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyLiabilityLimit rdf:type rdf:Property ;
    rdfs:label 'Policy Liability Limit' ;
    rdfs:comment 'Maximum insured amount under the linked title policy at the time of payment. Provides context for whether payment approaches or exhausts policy limits.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveReleaseAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Release Amount' ;
    rdfs:comment 'Portion of the case reserve released upon issuance of this payment. Used to reconcile reserve movements against actual loss payments for IBNR and loss ratio reporting.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subrogationFlag rdf:type rdf:Property ;
    rdfs:label 'Subrogation Flag' ;
    rdfs:comment 'Indicates whether this loss payment has an associated subrogation or recovery right that the insurer may pursue against a responsible third party after indemnifying the insured.' ;
    rdfs:domain ind:Claim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxWithholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Amount' ;
    rdfs:comment 'Amount withheld from the gross payment for IRS backup withholding or other tax obligations. Relevant for payments to non-exempt payees. Supports 1099 reporting.' ;
    rdfs:domain ind:LossPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voidDate rdf:type rdf:Property ;
    rdfs:label 'Void Date' ;
    rdfs:comment 'Date on which the payment was voided, if applicable. Null for non-voided payments. Supports lifecycle history preservation per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:wireInstructionRef rdf:type rdf:Property ;
    rdfs:label 'Wire Instruction Ref' ;
    rdfs:comment 'Tokenized reference to the wire instruction set used for this disbursement. Full wire details (routing, account, SWIFT) stored in the NPPI Vault per VREQ-012 and GLBA.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryCounselPartyId rdf:type rdf:Property ;
    rdfs:label 'Recovery Counsel Party Id' ;
    rdfs:comment 'Reference to the outside or staff counsel engaged to pursue subrogation litigation or negotiation on behalf of the title insurer for this recovery action.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:recoverySourcePartyId rdf:type rdf:Property ;
    rdfs:label 'Recovery Source Party Id' ;
    rdfs:comment 'Reference to the party from whom the recovery proceeds were collected (e.g., prior owner, grantor, tortfeasor, reinsurer, co-insurer, or responsible third party).' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:reversedReceiptRecoveryReceiptId rdf:type rdf:Property ;
    rdfs:label 'Reversed Receipt Recovery Receipt Id' ;
    rdfs:comment 'Reference to the original recovery receipt record that this record reverses. Populated only when reversal_indicator = True. Preserves audit trail of corrections.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecoveryReceipt .

ind:agentRecoveryShareAmount rdf:type rdf:Property ;
    rdfs:label 'Agent Recovery Share Amount' ;
    rdfs:comment 'Portion of the recovery proceeds allocated to the independent title agent under the agency agreement premium split, when the underlying policy was issued through an agent channel.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appliedToLossAmount rdf:type rdf:Property ;
    rdfs:label 'Applied To Loss Amount' ;
    rdfs:comment 'Portion of the recovery receipt amount that has been applied to reduce the recorded claim loss or indemnity payment balance. May differ from recovery_amount if partial application.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Reference Number' ;
    rdfs:comment 'Bank-assigned reference or wire confirmation number for the recovery funds receipt. Restricted due to financial transaction sensitivity. Used for bank reconciliation.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkNumber rdf:type rdf:Property ;
    rdfs:label 'Check Number' ;
    rdfs:comment 'Check number of the recovery payment instrument when recovery_method = check. Restricted financial data used for payment reconciliation and audit trail.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Recovery Amount' ;
    rdfs:comment 'Estimated total recovery amount anticipated from this recovery action at the time of demand or suit filing. Used to track recovery realization rate versus expectation.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Recovery Amount' ;
    rdfs:comment 'Portion of the recovery receipt allocated to recovery of claim-related loss adjustment expenses (LAE), such as legal fees and investigation costs, separate from indemnity loss recovery.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'Date on which the recovery receipt was posted to the general ledger for financial reporting purposes. May differ from receipt_date due to accounting period cutoffs.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isFinalReceipt rdf:type rdf:Property ;
    rdfs:label 'Is Final Receipt' ;
    rdfs:comment 'Indicates whether this is the final recovery receipt for the claim (True), signaling that no further recovery proceeds are expected and the recovery action is closed.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFullRecovery rdf:type rdf:Property ;
    rdfs:label 'Is Full Recovery' ;
    rdfs:comment 'Indicates whether this receipt represents full recovery of the total claim indemnity paid (True) or a partial recovery (False). Drives claim closure eligibility assessment.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:naicRecoveryCode rdf:type rdf:Property ;
    rdfs:label 'Naic Recovery Code' ;
    rdfs:comment 'NAIC-defined code classifying the recovery type for statutory annual statement Schedule F and loss reporting purposes. Aligns with NAIC Title Insurance Annual Statement requirements.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Net Recovery Amount' ;
    rdfs:comment 'Recovery amount net of recovery-related expenses (legal fees, collection costs) incurred to obtain the proceeds. Equals recovery_amount minus recovery expense deductions.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payorTaxIdentifier rdf:type rdf:Property ;
    rdfs:label 'Payor Tax Identifier' ;
    rdfs:comment 'Federal Tax Identification Number (TIN/EIN/SSN) of the party remitting the recovery payment. Required for IRS 1099 reporting on recoveries. Stored in NPPI Vault.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'Calendar date on which the recovery funds were actually received by the title insurer or its claims administrator. Principal business event date for this transaction.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receiptNumber rdf:type rdf:Property ;
    rdfs:label 'Receipt Number' ;
    rdfs:comment 'Externally visible, human-readable reference number assigned to this recovery receipt by the claims administration system for tracking and correspondence.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Recovery Expense Amount' ;
    rdfs:comment 'Total costs incurred to pursue and collect this recovery (attorney fees, court costs, investigation expenses). Deducted from gross recovery to derive net recovery.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'Mechanism by which recovery funds were collected: wire transfer, check, ACH, offset against amounts owed, court judgment enforcement, or negotiated settlement agreement.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryNotes rdf:type rdf:Property ;
    rdfs:label 'Recovery Notes' ;
    rdfs:comment 'Free-text narrative describing the circumstances of the recovery, negotiation details, or special conditions associated with this receipt. Entered by the claims examiner.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryRatePct rdf:type rdf:Property ;
    rdfs:label 'Recovery Rate Pct' ;
    rdfs:comment 'Percentage of the original claim indemnity payment recovered through this receipt (recovery_amount / total indemnity paid). Supports recovery effectiveness analytics.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoverySourceName rdf:type rdf:Property ;
    rdfs:label 'Recovery Source Name' ;
    rdfs:comment 'Name of the entity or individual from whom recovery proceeds were collected (e.g., prior grantor, judgment debtor, reinsurer name). Denormalized for reporting when party record is unavailable.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoverySourceType rdf:type rdf:Property ;
    rdfs:label 'Recovery Source Type' ;
    rdfs:comment 'Classification of the party from whom recovery was collected, supporting analysis of recovery patterns by source category (e.g., prior owner subrogation vs. reinsurer recovery).' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Current lifecycle status of the recovery receipt: pending (expected but not yet received), received (funds in hand), applied (posted to claim reserve/loss), reversed, or written off.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryType rdf:type rdf:Property ;
    rdfs:label 'Recovery Type' ;
    rdfs:comment 'Classification of the recovery mechanism: subrogation (rights against third party), contribution (co-insurer share), salvage (asset recovery), reinsurance recovery, or indemnification from responsible party.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceTreatyReference rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Treaty Reference' ;
    rdfs:comment 'Identifier of the reinsurance treaty or facultative certificate under which a reinsurance recovery receipt was collected. Populated only when recovery_type = reinsurance_recovery.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveReductionAmount rdf:type rdf:Property ;
    rdfs:label 'Reserve Reduction Amount' ;
    rdfs:comment 'Amount by which the claim case reserve was reduced upon application of this recovery receipt. Supports reserve adequacy and IBNR analysis.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reversalIndicator rdf:type rdf:Property ;
    rdfs:label 'Reversal Indicator' ;
    rdfs:comment 'Indicates whether this recovery receipt record represents a reversal of a previously posted receipt (True). Supports lifecycle history preservation per VREQ-007.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateOfRecovery rdf:type rdf:Property ;
    rdfs:label 'State Of Recovery' ;
    rdfs:comment 'Two-letter US state code for the jurisdiction in which the recovery action was pursued. Supports state-level regulatory loss reporting to Departments of Insurance.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subrogationDemandDate rdf:type rdf:Property ;
    rdfs:label 'Subrogation Demand Date' ;
    rdfs:comment 'Date on which the formal subrogation demand letter was issued to the responsible third party, initiating the recovery action. Used to measure recovery cycle time.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subrogationSuitFiledDate rdf:type rdf:Property ;
    rdfs:label 'Subrogation Suit Filed Date' ;
    rdfs:comment 'Date on which a subrogation lawsuit was filed in court against the responsible party, if litigation was required to enforce recovery rights.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:underwriterRecoveryShareAmount rdf:type rdf:Property ;
    rdfs:label 'Underwriter Recovery Share Amount' ;
    rdfs:comment 'Portion of the recovery proceeds retained by the title underwriter after deducting the agent share and recovery expenses. Used in underwriter loss ratio reporting.' ;
    rdfs:domain ind:RecoveryReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryLossReportId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Loss Report Id' ;
    rdfs:comment 'Unique surrogate identifier for each regulatory loss report record submitted to NAIC or state Department of Insurance.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededReportId rdf:type rdf:Property ;
    rdfs:label 'Superseded Report Id' ;
    rdfs:comment 'Reference to the prior regulatory_loss_report record that this amended or corrected filing supersedes, preserving revision history per VREQ-007.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryLossReport .

ind:actuarialOpinionDate rdf:type rdf:Property ;
    rdfs:label 'Actuarial Opinion Date' ;
    rdfs:comment 'Date on which the qualified actuary signed and certified the actuarial opinion accompanying this regulatory loss report, if applicable.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actuaryCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Actuary Certification Flag' ;
    rdfs:comment 'Indicates whether this regulatory loss report includes a certified actuarial opinion, required for IBNR actuarial filings and certain state DOI submissions.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential amendment version number for this report filing. Zero (0) indicates the original submission; increments with each amendment or correction filed.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageClaimSeverityAmt rdf:type rdf:Property ;
    rdfs:label 'Average Claim Severity Amt' ;
    rdfs:comment 'Average indemnity payment per closed claim with payment during the reporting period for this jurisdiction and policy type, in USD, used for actuarial severity analysis.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseReserveAmt rdf:type rdf:Property ;
    rdfs:label 'Case Reserve Amt' ;
    rdfs:comment 'Total case reserves held for known open claims as of the reporting period end date for this jurisdiction and policy type, in USD.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:claimCountClosed rdf:type rdf:Property ;
    rdfs:label 'Claim Count Closed' ;
    rdfs:comment 'Number of claims closed during the reporting period for this jurisdiction and policy type, including closures with and without payment.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimCountOpenEnd rdf:type rdf:Property ;
    rdfs:label 'Claim Count Open End' ;
    rdfs:comment 'Number of claims remaining open as of the reporting period end date for this jurisdiction and policy type, used for reserve adequacy analysis.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:claimCountReported rdf:type rdf:Property ;
    rdfs:label 'Claim Count Reported' ;
    rdfs:comment 'Number of new claims reported (FNOL) during the reporting period for this jurisdiction and policy type combination, per NAIC Schedule T requirements.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:directLossesPaidAmt rdf:type rdf:Property ;
    rdfs:label 'Direct Losses Paid Amt' ;
    rdfs:comment 'Total indemnity and loss payments made to claimants during the reporting period for this jurisdiction, in USD, net of recoveries.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:directPremiumsWrittenAmt rdf:type rdf:Property ;
    rdfs:label 'Direct Premiums Written Amt' ;
    rdfs:comment 'Total direct title insurance premiums written during the reporting period for this jurisdiction, in USD, as reported on NAIC Schedule T.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:filingConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Filing Confirmation Number' ;
    rdfs:comment 'Confirmation or acknowledgment number assigned by the NAIC or state DOI system upon receipt of the electronic or portal submission.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filingMethod rdf:type rdf:Property ;
    rdfs:label 'Filing Method' ;
    rdfs:comment 'Method used to submit this regulatory loss report to the regulator: ELECTRONIC (NAIC SERFF/iSite+), PAPER, or state-specific PORTAL.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ibnrReserveAmt rdf:type rdf:Property ;
    rdfs:label 'Ibnr Reserve Amt' ;
    rdfs:comment 'Actuarially estimated reserve for claims incurred but not yet reported (IBNR) as of the reporting period end date, in USD, per actuarial filing requirements.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jurisdictionStateFips rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Fips' ;
    rdfs:comment 'Two-digit FIPS code identifying the U.S. state or territory to which this regulatory loss report is submitted, per NAIC Schedule T geographic breakdown.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionStateName rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction State Name' ;
    rdfs:comment 'Full name of the U.S. state or territory corresponding to the jurisdiction FIPS code, for display and reporting purposes.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossAdjustmentExpenseAmt rdf:type rdf:Property ;
    rdfs:label 'Loss Adjustment Expense Amt' ;
    rdfs:comment 'Total allocated and unallocated loss adjustment expenses incurred during the reporting period, including investigation, legal, and curative costs, in USD.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossRatio rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio' ;
    rdfs:comment 'Ratio of net incurred losses to direct premiums written for the reporting period and jurisdiction, expressed as a decimal (e.g., 0.045 = 4.5%), a key regulatory metric.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netLossesAmt rdf:type rdf:Property ;
    rdfs:label 'Net Losses Amt' ;
    rdfs:comment 'Total incurred losses minus recovery and subrogation amounts for the reporting period, representing the net loss retained by the underwriter, in USD.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyLiabilityAmt rdf:type rdf:Property ;
    rdfs:label 'Policy Liability Amt' ;
    rdfs:comment 'Total face amount of insurance liability (policy amount) across all policies contributing to this report row, representing aggregate exposure, in USD.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preparerName rdf:type rdf:Property ;
    rdfs:label 'Preparer Name' ;
    rdfs:comment 'Full name of the individual responsible for preparing and certifying this regulatory loss report filing on behalf of the title insurance company.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparerTitle rdf:type rdf:Property ;
    rdfs:label 'Preparer Title' ;
    rdfs:comment 'Job title or designation of the individual who prepared this regulatory loss report (e.g., Chief Actuary, VP Claims, Compliance Officer).' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoverySubrogationAmt rdf:type rdf:Property ;
    rdfs:label 'Recovery Subrogation Amt' ;
    rdfs:comment 'Total amounts recovered through subrogation, salvage, or other recovery actions during the reporting period, reducing net loss exposure, in USD.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryNotes rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notes' ;
    rdfs:comment 'Free-text notes or explanatory comments accompanying this regulatory loss report, including disclosures, methodology changes, or regulator correspondence summaries.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportNumber rdf:type rdf:Property ;
    rdfs:label 'Report Number' ;
    rdfs:comment 'Externally assigned or internally generated unique report identifier used in regulatory submissions and correspondence with NAIC or state DOI.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportStatus rdf:type rdf:Property ;
    rdfs:label 'Report Status' ;
    rdfs:comment 'Current lifecycle state of the regulatory loss report: DRAFT (in preparation), SUBMITTED (filed), ACCEPTED, REJECTED, AMENDED, or SUPERSEDED by a later filing.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportType rdf:type rdf:Property ;
    rdfs:label 'Report Type' ;
    rdfs:comment 'Classification of the regulatory filing: NAIC Annual Statement Schedule T, state DOI loss run, IBNR actuarial filing, quarterly loss report, or supplemental. [ENUM-REF-CANDIDATE: promote if values expand]' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'Last calendar date of the reporting period covered by this regulatory loss report (e.g., December 31 of the statement year).' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start Date' ;
    rdfs:comment 'First calendar date of the reporting period covered by this regulatory loss report (e.g., January 1 of the statement year).' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resubmissionDueDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Due Date' ;
    rdfs:comment 'Deadline by which a corrected or amended regulatory loss report must be resubmitted following a rejection, as specified by the regulator.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:statementYear rdf:type rdf:Property ;
    rdfs:label 'Statement Year' ;
    rdfs:comment 'Four-digit calendar year of the NAIC Annual Statement or state DOI filing to which this loss report belongs (e.g., 2024).' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalIncurredLossesAmt rdf:type rdf:Property ;
    rdfs:label 'Total Incurred Losses Amt' ;
    rdfs:comment 'Sum of losses paid plus change in case and IBNR reserves for the reporting period, representing total loss exposure incurred, in USD.' ;
    rdfs:domain ind:RegulatoryLossReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:titleAssignedCounselPartyId rdf:type rdf:Property ;
    rdfs:label 'Title Assigned Counsel Party Id' ;
    rdfs:comment 'Reference to the party record for outside or in-house legal counsel assigned to defend or prosecute matters related to this claim.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:titleClaimantPartyId rdf:type rdf:Property ;
    rdfs:label 'Title Claimant Party Id' ;
    rdfs:comment 'Reference to the party entity representing the insured claimant (owner or lender) who filed the claim. Supports party-role contextual modeling.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:titlePartyId rdf:type rdf:Property ;
    rdfs:label 'Title Party Id' ;
    rdfs:comment 'Reference to the internal party or employee record for the claims examiner assigned to investigate and manage this claim through resolution.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:claimStatus rdf:type rdf:Property ;
    rdfs:label 'Claim Status' ;
    rdfs:comment 'Current lifecycle state of the claim. Drives workflow routing, reserve management, and regulatory reporting. [ENUM-REF-CANDIDATE: open|under_investigation|reserved|settled|closed|denied|reopened — promote to reference product]' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimType rdf:type rdf:Property ;
    rdfs:label 'Claim Type' ;
    rdfs:comment 'Classification of the title risk cause giving rise to the claim (e.g., title defect, lien, encumbrance, encroachment, forgery, fraud, survey, access, CC&R).' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date the claim was formally closed in the Claims Administration System. Reserves are released upon closure. Used for claim lifecycle duration and aging analysis.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Reason the claim was closed, distinguishing between indemnity payment, curative resolution, coverage denial, claimant withdrawal, or no-coverage determination.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageAnalysisOutcome rdf:type rdf:Property ;
    rdfs:label 'Coverage Analysis Outcome' ;
    rdfs:comment 'Result of the underwriter\'s coverage analysis determining whether the claimed loss falls within the policy\'s insuring provisions. Drives reserve setting and payment authorization.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeActionDescription rdf:type rdf:Property ;
    rdfs:label 'Curative Action Description' ;
    rdfs:comment 'Narrative describing the curative steps taken to resolve the title defect or adverse matter underlying the claim (e.g., lien release, quiet title action, corrective deed).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeResolutionFlag rdf:type rdf:Property ;
    rdfs:label 'Curative Resolution Flag' ;
    rdfs:comment 'Indicates whether the claim was resolved through curative action (e.g., obtaining a release, reconveyance, or corrective deed) rather than monetary indemnity payment.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expenseReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Reserve Amount' ;
    rdfs:comment 'Reserve set aside for allocated loss adjustment expenses (ALAE) including legal fees, curative costs, and investigation expenses associated with this claim.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fnolReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fnol Received Timestamp' ;
    rdfs:comment 'Precise timestamp when the FNOL was received and logged in the Claims Administration System. Used for SLA measurement and regulatory timeliness reporting.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:investigationCloseDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Close Date' ;
    rdfs:comment 'Date the claim investigation was formally concluded and findings documented. Marks transition to coverage determination and reserve finalization.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossDescription rdf:type rdf:Property ;
    rdfs:label 'Loss Description' ;
    rdfs:comment 'Narrative description of the title defect, lien, encumbrance, or other adverse matter giving rise to the claim. Captures the factual basis of the insured\'s loss.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:producingChannel rdf:type rdf:Property ;
    rdfs:label 'Producing Channel' ;
    rdfs:comment 'The business channel through which the underlying title order and policy were produced. Supports loss ratio and frequency analysis by channel (direct, lender, independent agent).' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Flag' ;
    rdfs:comment 'Indicates whether this claim has been included in a regulatory loss report submitted to the NAIC or a state Department of Insurance. Supports compliance audit trail.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reopenCount rdf:type rdf:Property ;
    rdfs:label 'Reopen Count' ;
    rdfs:comment 'Number of times this claim has been reopened after a prior closure. Supports lifecycle history preservation per VREQ-007 and identifies complex or recurring loss events.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reserveLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Last Updated Date' ;
    rdfs:comment 'Date the case reserve or expense reserve was most recently reviewed and updated by the examiner or actuary. Supports reserve aging and adequacy monitoring.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalPaidExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Total Paid Expense Amount' ;
    rdfs:comment 'Cumulative allocated loss adjustment expense (ALAE) payments made to date for this claim, including legal, curative, and investigation costs.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPaidIndemnityAmount rdf:type rdf:Property ;
    rdfs:label 'Total Paid Indemnity Amount' ;
    rdfs:comment 'Cumulative indemnity loss payments made to the claimant to date. Represents the sum of all indemnity disbursements; used for loss ratio and severity analysis.' ;
    rdfs:domain ind:TitleClaim ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationsCurativeActionId rdf:type rdf:Property ;
    rdfs:label 'Operations Curative Action Id' ;
    rdfs:comment 'Unique surrogate identifier for each curative action record within the title production operations domain. Primary key for this entity.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OperationsCurativeAction .

ind:assignedToPartyId rdf:type rdf:Property ;
    rdfs:label 'Assigned To Party Id' ;
    rdfs:comment 'Reference to the party (curative specialist, title examiner, or external vendor) responsible for executing this curative action. Supports workload and aging analysis.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:operationsTitleExaminationId rdf:type rdf:Property ;
    rdfs:label 'Operations Title Examination Id' ;
    rdfs:comment 'Reference to the title examination during which the defect or requirement necessitating this curative action was identified.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OperationsTitleExamination .

ind:titleEvidenceId rdf:type rdf:Property ;
    rdfs:label 'Title Evidence Id' ;
    rdfs:comment 'Reference to the document management record containing the curative evidence (e.g., recorded release, satisfaction, affidavit) that proves the defect has been cleared.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleEvidence .

ind:actionNotes rdf:type rdf:Property ;
    rdfs:label 'Action Notes' ;
    rdfs:comment 'Free-text operational notes entered by the curative specialist documenting correspondence, status updates, obstacles, and resolution details for this curative action.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearanceMethod rdf:type rdf:Property ;
    rdfs:label 'Clearance Method' ;
    rdfs:comment 'Method by which the title defect or requirement was ultimately cleared. Supports curative action effectiveness analysis and underwriting exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Calendar date on which the curative action was marked complete and the associated requirement or defect was cleared. Null if not yet completed.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cotBreakIndicator rdf:type rdf:Property ;
    rdfs:label 'Cot Break Indicator' ;
    rdfs:comment 'Indicates whether this curative action is specifically addressing a chain-of-title break (gap in the grantor-grantee index or missing conveyance). Supports COT break metrics per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defectSeverity rdf:type rdf:Property ;
    rdfs:label 'Defect Severity' ;
    rdfs:comment 'Underwriter-assigned severity rating of the title defect being cured. Critical defects block commitment issuance; high defects require UW referral; medium and low may be handled operationally.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingUsed rdf:type rdf:Property ;
    rdfs:label 'Erecording Used' ;
    rdfs:comment 'Indicates whether the curative instrument was submitted via electronic recording (eRecording) gateway (e.g., Simplifile, CSC eRecording) rather than physical submission.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalatedDate rdf:type rdf:Property ;
    rdfs:label 'Escalated Date' ;
    rdfs:comment 'Date on which this curative action was escalated to underwriting, management, or legal due to inability to clear within standard processing. Null if not escalated.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:evidenceReceived rdf:type rdf:Property ;
    rdfs:label 'Evidence Received' ;
    rdfs:comment 'Indicates whether the documentary evidence required to confirm clearance of the defect or requirement has been received and imaged into the document management system.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Evidence Received Date' ;
    rdfs:comment 'Date on which the curative evidence document was received and confirmed by the title operations team. Supports evidence completeness and provenance metrics per VREQ-016.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fipsCode rdf:type rdf:Property ;
    rdfs:label 'Fips Code' ;
    rdfs:comment 'Five-digit FIPS code identifying the county jurisdiction for recording the curative instrument. Used for jurisdiction routing and regulatory reporting.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapCoverageRequired rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Required' ;
    rdfs:comment 'Indicates whether gap coverage is required for this curative action due to the period between the effective date of the title search and the recording of the insured instrument.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Acceptance Date' ;
    rdfs:comment 'Date the county recorder or relevant authority accepted the curative instrument for recording. Distinct from execution, effective, submission, and recording dates per VREQ-008.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Effective Date' ;
    rdfs:comment 'Date the curative instrument becomes legally effective, which may differ from execution or recording date. Distinct from execution, submission, acceptance, and recording dates per VREQ-008.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Execution Date' ;
    rdfs:comment 'Date the curative instrument (release, reconveyance, satisfaction, etc.) was signed or executed by the relevant party. Distinct from effective, submission, acceptance, and recording dates per VREQ-008.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Reference Number' ;
    rdfs:comment 'Recording number, document number, or external reference identifier of the instrument obtained or recorded as part of this curative action. Supports evidence provenance tracking.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Submission Date' ;
    rdfs:comment 'Date the curative instrument was submitted to the county recorder or relevant authority for recording or filing. Distinct from execution, effective, acceptance, and recording dates per VREQ-008.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentType rdf:type rdf:Property ;
    rdfs:label 'Instrument Type' ;
    rdfs:comment 'Type of legal instrument required or obtained to cure the defect (e.g., release, reconveyance, satisfaction, subordination, affidavit, court order, deed). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderLoanNumber rdf:type rdf:Property ;
    rdfs:label 'Lienholder Loan Number' ;
    rdfs:comment 'Loan or account number assigned by the lienholder to the obligation being cured. Used to obtain payoff demands and track correspondence with the lienholder.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienholderName rdf:type rdf:Property ;
    rdfs:label 'Lienholder Name' ;
    rdfs:comment 'Name of the lienholder, creditor, or encumbrancer whose interest must be released or satisfied as part of this curative action (e.g., lender, taxing authority, HOA, judgment creditor).' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mersMin rdf:type rdf:Property ;
    rdfs:label 'Mers Min' ;
    rdfs:comment '18-digit MERS Mortgage Identification Number for the mortgage or deed of trust being released or reconveyed as part of this curative action, if registered with MERS.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openedDate rdf:type rdf:Property ;
    rdfs:label 'Opened Date' ;
    rdfs:comment 'Calendar date on which this curative action was opened and assigned. Used as the start point for curative action aging and clearance cycle-time calculations.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payoffGoodThroughDate rdf:type rdf:Property ;
    rdfs:label 'Payoff Good Through Date' ;
    rdfs:comment 'Expiration date of the payoff quote obtained from the lienholder. After this date, a new payoff demand must be obtained before disbursement.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorActionStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Action Status' ;
    rdfs:comment 'Previous lifecycle status of this curative action before the most recent status transition. Preserves material lifecycle transitions per VREQ-007 for audit and revision history.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Recording Jurisdiction' ;
    rdfs:comment 'County and state jurisdiction where the curative instrument was or will be recorded (e.g., \'Cook County, IL\'). Used for eRecording routing and recording fee calculation.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyRole rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Role' ;
    rdfs:comment 'Role of the party assigned to execute this curative action within the title production workflow. Supports contextual role assignment per VREQ-006.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaBreached rdf:type rdf:Property ;
    rdfs:label 'Sla Breached' ;
    rdfs:comment 'Indicates whether this curative action exceeded its SLA target days without completion. True when days_open exceeds sla_target_days and action_status is not completed or waived.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaTargetDays rdf:type rdf:Property ;
    rdfs:label 'Sla Target Days' ;
    rdfs:comment 'Maximum number of calendar days allowed to complete this curative action per the applicable service level agreement or internal processing standard.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusChangedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Status Changed Timestamp' ;
    rdfs:comment 'Timestamp of the most recent status transition for this curative action. Supports lifecycle history preservation per VREQ-007 and SLA breach detection.' ;
    rdfs:domain ind:OperationsCurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:waivedDate rdf:type rdf:Property ;
    rdfs:label 'Waived Date' ;
    rdfs:comment 'Date on which the requirement or defect was formally waived by the underwriter, allowing the transaction to proceed without full cure. Null if not waived.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderChannelId rdf:type rdf:Property ;
    rdfs:label 'Order Channel Id' ;
    rdfs:comment 'Unique surrogate identifier for each order origination and routing channel record. Primary key for the order_channel reference master. [REFERENCE_LOOKUP: canonical_skip_reason — this entity is a REFERENCE_LOOKUP classifying origination channels; per-role' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrderChannel .

ind:affiliatedBusinessArrangement rdf:type rdf:Property ;
    rdfs:label 'Affiliated Business Arrangement' ;
    rdfs:comment 'Indicates whether this channel involves an affiliated business arrangement as defined under RESPA Section 8(c)(4). True = AfBA disclosure required at order intake. Supports regulatory compliance tracking.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:channelCategory rdf:type rdf:Property ;
    rdfs:label 'Channel Category' ;
    rdfs:comment 'Broader grouping of channels for management reporting: retail (branch/consumer), institutional (lender/wholesale), agency (independent agent), or digital (online/consumer-direct). Supports segment-level performance analysis.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelCode rdf:type rdf:Property ;
    rdfs:label 'Channel Code' ;
    rdfs:comment 'Short, system-recognized alphanumeric code uniquely identifying the channel (e.g., DIR_BRANCH, CENT_LENDER, IND_AGENT, CONS_DIRECT, WHOLESALE). Used as the operational lookup key in title production and CRM routing systems.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelDescription rdf:type rdf:Property ;
    rdfs:label 'Channel Description' ;
    rdfs:comment 'Free-text narrative describing the channel\'s business purpose, scope, and operational characteristics. Used for onboarding documentation and internal reference.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelName rdf:type rdf:Property ;
    rdfs:label 'Channel Name' ;
    rdfs:comment 'Human-readable business name of the origination channel (e.g., \'Direct Branch\', \'Centralized Lender\', \'Independent Agent\', \'Consumer Direct\', \'Wholesale\'). Displayed in dashboards, reports, and order intake screens.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelOwnerEmail rdf:type rdf:Property ;
    rdfs:label 'Channel Owner Email' ;
    rdfs:comment 'Business email address of the internal channel owner. Used for operational notifications, SLA breach alerts, and governance communications. Classified confidential as internal business contact.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelOwnerName rdf:type rdf:Property ;
    rdfs:label 'Channel Owner Name' ;
    rdfs:comment 'Name of the internal business owner or manager responsible for this channel\'s performance, configuration, and compliance. Used for escalation routing and governance accountability.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:channelStatus rdf:type rdf:Property ;
    rdfs:label 'Channel Status' ;
    rdfs:comment 'Current operational lifecycle status of the channel record. \'active\' channels accept new orders; \'inactive\' are retired; \'suspended\' are temporarily halted; \'pending\' are awaiting activation approval.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingDisclosureFormType rdf:type rdf:Property ;
    rdfs:label 'Closing Disclosure Form Type' ;
    rdfs:comment 'Settlement statement form type required for closings through this channel: cd (Closing Disclosure / TRID), hud1 (HUD-1 for pre-TRID or exempt transactions), alta_ss (ALTA Settlement Statement), or none.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultTransactionType rdf:type rdf:Property ;
    rdfs:label 'Default Transaction Type' ;
    rdfs:comment 'The predominant real-estate transaction type associated with this channel (purchase, refinance, HELOC, construction, commercial). Used to pre-populate order intake forms and apply channel-specific underwriting rules.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingEnabled rdf:type rdf:Property ;
    rdfs:label 'Erecording Enabled' ;
    rdfs:comment 'Indicates whether electronic recording submission is enabled for orders originating through this channel. True = eRecording via Simplifile/CSC gateway is the default submission method.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowHandlingType rdf:type rdf:Property ;
    rdfs:label 'Escrow Handling Type' ;
    rdfs:comment 'Indicates how escrow trust account management is handled for transactions from this channel: in_house (company escrow officer), agent_handled (independent agent manages escrow), lender_controlled, or none (no escrow).' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalChannelRefCode rdf:type rdf:Property ;
    rdfs:label 'External Channel Ref Code' ;
    rdfs:comment 'External identifier for this channel as assigned by a lender, partner, or CRM system (e.g., Salesforce channel ID, lender-assigned branch code). Enables cross-system reconciliation and order traceability.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:glRevenueAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Revenue Account Code' ;
    rdfs:comment 'General Ledger account code to which premium revenue from orders originating through this channel is posted. Enables channel-level revenue recognition and financial reporting in the ERP/GL system.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ioltaRequired rdf:type rdf:Property ;
    rdfs:label 'Iolta Required' ;
    rdfs:comment 'Indicates whether escrow funds for this channel must be held in an IOLTA-compliant trust account. Applies in states where attorney-conducted closings are mandatory. Supports ALTA Best Practices Pillar 1 compliance.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipenEnabled rdf:type rdf:Property ;
    rdfs:label 'Ipen Enabled' ;
    rdfs:comment 'Indicates whether In-Person Electronic Notarization (IPEN) closings are permitted for transactions originating through this channel. Distinct from RON; requires physical presence of notary and signer.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDefaultChannel rdf:type rdf:Property ;
    rdfs:label 'Is Default Channel' ;
    rdfs:comment 'Indicates whether this channel is the system default when no explicit channel is specified at order intake. Only one channel should be flagged as default per production source type. Supports order routing fallback logic.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderIntegrationType rdf:type rdf:Property ;
    rdfs:label 'Lender Integration Type' ;
    rdfs:comment 'Technical integration method used for lender-channel order delivery: API (real-time), file_transfer (batch), portal (manual web entry), or none (not a lender channel). Drives automation and SLA differentiation.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderPlatformName rdf:type rdf:Property ;
    rdfs:label 'Lender Platform Name' ;
    rdfs:comment 'Name of the lender\'s loan origination system or order delivery platform (e.g., Encompass, Blend, ICE Mortgage Technology) used to transmit orders through this channel. Null for non-lender channels.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mersReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Mers Reporting Required' ;
    rdfs:comment 'Indicates whether MERS registration and reporting is required for mortgage instruments originated through this channel. Applies primarily to lender and wholesale channels handling DOT/mortgage instruments.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nppiDataSharingPermitted rdf:type rdf:Property ;
    rdfs:label 'Nppi Data Sharing Permitted' ;
    rdfs:comment 'Indicates whether NPPI (SSN, TIN, bank account, wire instructions) may be shared with counterparties through this channel under applicable GLBA and state privacy agreements. False = NPPI sharing restricted.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:orderIntakeMethod rdf:type rdf:Property ;
    rdfs:label 'Order Intake Method' ;
    rdfs:comment 'Technical method by which orders are received through this channel: API integration, web portal, email, phone, fax, or EDI. Determines automation level and SLA baseline for order intake processing.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumSplitType rdf:type rdf:Property ;
    rdfs:label 'Premium Split Type' ;
    rdfs:comment 'Indicates the premium revenue split model applicable to this channel: direct (100% retained by underwriter), agency (split with independent agent per agency agreement), or net_retained (net premium after agent remittance).' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionSource rdf:type rdf:Property ;
    rdfs:label 'Production Source' ;
    rdfs:comment 'Identifies the business production source model through which orders arrive: branch (direct office), lender_channel (centralized lender integration), independent_agent, consumer_direct, or wholesale. Aligns with ALTA production-source reporting.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceRequired rdf:type rdf:Property ;
    rdfs:label 'Remittance Required' ;
    rdfs:comment 'Indicates whether premium remittance to the underwriter is required for orders originating through this channel. True = remittance required (independent agent channels). Supports agency remittance timeliness metrics.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresAgencyAgreement rdf:type rdf:Property ;
    rdfs:label 'Requires Agency Agreement' ;
    rdfs:comment 'Indicates whether orders originating through this channel require a valid independent agent agreement on file before order acceptance. True = agency agreement mandatory (applies to independent agent channels).' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresCpl rdf:type rdf:Property ;
    rdfs:label 'Requires Cpl' ;
    rdfs:comment 'Indicates whether a Closing Protection Letter (CPL) must be issued for transactions originating through this channel. CPLs protect lenders against agent fraud or dishonesty. Mandatory for most lender and agent channels.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:respaApplicable rdf:type rdf:Property ;
    rdfs:label 'Respa Applicable' ;
    rdfs:comment 'Indicates whether RESPA requirements apply to transactions originating through this channel. Governs settlement service provider disclosures, affiliated business arrangements, and kickback prohibitions.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ronEnabled rdf:type rdf:Property ;
    rdfs:label 'Ron Enabled' ;
    rdfs:comment 'Indicates whether Remote Online Notarization (RON) closings are permitted for transactions originating through this channel. Drives closing coordination workflow and notary assignment logic.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:routingPriority rdf:type rdf:Property ;
    rdfs:label 'Routing Priority' ;
    rdfs:comment 'Numeric priority rank (lower value = higher priority) used by the order routing engine to assign orders from this channel to processing queues, branches, or examiners. Supports SLA-driven workload balancing.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaCommitmentHours rdf:type rdf:Property ;
    rdfs:label 'Sla Commitment Hours' ;
    rdfs:comment 'Maximum number of business hours from completed examination to title commitment issuance for this channel. Supports closing readiness and commitment revision frequency metrics.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaIntakeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Intake Hours' ;
    rdfs:comment 'Maximum number of business hours allowed from order receipt to order acknowledgment/acceptance for this channel. Drives title clearance cycle-time SLA monitoring and operational reporting.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaSearchHours rdf:type rdf:Property ;
    rdfs:label 'Sla Search Hours' ;
    rdfs:comment 'Maximum number of business hours from order acceptance to title search delivery for this channel. Used to measure and report title clearance cycle time by channel.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:soxControlApplicable rdf:type rdf:Property ;
    rdfs:label 'Sox Control Applicable' ;
    rdfs:comment 'Indicates whether SOX internal controls over financial reporting apply to revenue and premium transactions originating through this channel. Supports ERP/GL audit trail requirements.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stateJurisdictionScope rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction Scope' ;
    rdfs:comment 'Comma-delimited list of US state codes (e.g., \'CA,TX,FL\') in which this channel is authorized to originate title orders. Null or \'ALL\' indicates nationwide authorization. Supports state-level regulatory reporting.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsCommercial rdf:type rdf:Property ;
    rdfs:label 'Supports Commercial' ;
    rdfs:comment 'Indicates whether this channel is authorized to originate commercial real-estate title orders. True = commercial orders accepted. Commercial orders typically require elevated underwriting referral thresholds.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsResidential rdf:type rdf:Property ;
    rdfs:label 'Supports Residential' ;
    rdfs:comment 'Indicates whether this channel is authorized to originate residential title orders (purchase, refinance, HELOC). True = residential orders accepted; False = residential orders not routed through this channel.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:suspensionReason rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason' ;
    rdfs:comment 'Free-text explanation of why this channel was suspended (e.g., regulatory action, compliance failure, contract termination). Null if channel has never been suspended. Supports audit and lifecycle history.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tridApplicable rdf:type rdf:Property ;
    rdfs:label 'Trid Applicable' ;
    rdfs:comment 'Indicates whether TRID disclosure requirements (Closing Disclosure / Loan Estimate) apply to transactions originating through this channel. True for most residential purchase and refinance lender channels.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwriterReferralThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Underwriter Referral Threshold Usd' ;
    rdfs:comment 'Liability amount in USD above which orders from this channel must be referred to the underwriter for risk review. Supports underwriting referral and exception rate metrics by channel.' ;
    rdfs:domain ind:OrderChannel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:versionNumber rdf:type rdf:Property ;
    rdfs:label 'Version Number' ;
    rdfs:comment 'Monotonically incrementing version counter for this channel record. Incremented on each configuration change. Supports lifecycle revision history and prior classification preservation per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orderStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Order Status History Id' ;
    rdfs:comment 'Unique surrogate identifier for each status transition record in the title order lifecycle history. Primary key of this append-only event log.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceEventOrderStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Source Event Order Status History Id' ;
    rdfs:comment 'Unique event or transaction identifier from the originating Title Production System (SoftPro/RamQuest/Qualia) for this status change. Supports lineage and deduplication.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OrderStatusHistory .

ind:closingReadinessStatus rdf:type rdf:Property ;
    rdfs:label 'Closing Readiness Status' ;
    rdfs:comment 'Operational assessment of the order\'s readiness to proceed to closing at the time of this transition. Supports closing readiness metrics per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentRevisionNumber rdf:type rdf:Property ;
    rdfs:label 'Commitment Revision Number' ;
    rdfs:comment 'Revision number of the title commitment in effect at the time of this status transition. Supports commitment revision frequency metrics per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cotBreakIdentified rdf:type rdf:Property ;
    rdfs:label 'Cot Break Identified' ;
    rdfs:comment 'Indicates whether a chain-of-title break was identified at or before this status transition. Supports chain-of-title break metrics per VREQ-016.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:durationInPriorStatusHours rdf:type rdf:Property ;
    rdfs:label 'Duration In Prior Status Hours' ;
    rdfs:comment 'Number of hours the title order spent in the prior_status before this transition. Supports clearance cycle-time and stage-level throughput analytics.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escrowOfficerName rdf:type rdf:Property ;
    rdfs:label 'Escrow Officer Name' ;
    rdfs:comment 'Name of the escrow officer assigned to this title order at the time of this status transition. Denormalized for operational reporting without requiring a party join.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCurrent rdf:type rdf:Property ;
    rdfs:label 'Is Current' ;
    rdfs:comment 'Indicates whether this record represents the most recent status of the title order. Facilitates efficient current-state queries without full history scan.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegression rdf:type rdf:Property ;
    rdfs:label 'Is Regression' ;
    rdfs:comment 'Indicates whether this transition represents a backward movement in the title order lifecycle (e.g., from cleared_to_close back to requirements_open). Flags rework events.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newStatus rdf:type rdf:Property ;
    rdfs:label 'New Status' ;
    rdfs:comment 'Status of the title order after this transition. Represents the current state entered at this point in the lifecycle. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openFindingCount rdf:type rdf:Property ;
    rdfs:label 'Open Finding Count' ;
    rdfs:comment 'Number of unresolved title findings (defects, liens, encumbrances) at the time of this status transition. Supports unresolved defects and liens metrics.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openRequirementCount rdf:type rdf:Property ;
    rdfs:label 'Open Requirement Count' ;
    rdfs:comment 'Number of open Schedule B-I title requirements at the time of this status transition. Supports open and aging title requirements metrics per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orderNumber rdf:type rdf:Property ;
    rdfs:label 'Order Number' ;
    rdfs:comment 'Human-readable title order number from the Title Production System (e.g., SoftPro/RamQuest/Qualia) at the time of this transition. Denormalized for audit traceability.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyExceptionRequired rdf:type rdf:Property ;
    rdfs:label 'Policy Exception Required' ;
    rdfs:comment 'Indicates whether a policy exception was required at this status transition point. Supports underwriting exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Status' ;
    rdfs:comment 'Status of the title order immediately before this transition. Null for the initial intake record. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regressionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Regression Reason Code' ;
    rdfs:comment 'Standardized code explaining why a backward status transition occurred. Populated only when is_regression is true. Supports curative action aging and rework analysis.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Monotonically increasing sequence number of this transition within the title order\'s lifecycle history. Enables ordered reconstruction of the full status timeline.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaBreachHours rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Hours' ;
    rdfs:comment 'Number of hours by which the SLA was exceeded for this status stage. Null if SLA was met. Used for aging and SLA severity reporting.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaDueTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sla Due Timestamp' ;
    rdfs:comment 'Calculated deadline timestamp by which the order must exit the new status to meet SLA. Derived from transition_timestamp plus sla_target_hours at write time.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:slaTargetHours rdf:type rdf:Property ;
    rdfs:label 'Sla Target Hours' ;
    rdfs:comment 'The contracted or configured SLA target in hours for completing the new status stage. Used to measure on-time performance and clearance cycle-time compliance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:titleExaminerName rdf:type rdf:Property ;
    rdfs:label 'Title Examiner Name' ;
    rdfs:comment 'Name of the title examiner assigned to this order at the time of this status transition. Supports examiner workload and cycle-time performance analytics.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Code' ;
    rdfs:comment 'Standardized code identifying the business reason or trigger for this status transition. Supports workflow analytics and SLA root-cause reporting. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Description' ;
    rdfs:comment 'Free-text narrative explaining the reason for the status transition, entered by the user or system. Supplements the reason code with operational context.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transition Timestamp' ;
    rdfs:comment 'Exact date and time (with timezone offset) when the status transition occurred. Principal event time for SLA measurement and clearance cycle-time analytics.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:triggeredBySystem rdf:type rdf:Property ;
    rdfs:label 'Triggered By System' ;
    rdfs:comment 'Name of the operational system that originated this transition event (e.g., SoftPro Select, RamQuest, Qualia, eRecording Gateway, CRM). Supports provenance tracking.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredByType rdf:type rdf:Property ;
    rdfs:label 'Triggered By Type' ;
    rdfs:comment 'Indicates whether the status transition was initiated by a human user, an automated system process, an external integration, a scheduled job, or an underwriter action.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredByUserName rdf:type rdf:Property ;
    rdfs:label 'Triggered By User Name' ;
    rdfs:comment 'Display name of the user or system process that triggered this transition. Denormalized for audit readability without requiring a join to user directory.' ;
    rdfs:domain ind:OrderStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyCode rdf:type rdf:Property ;
    rdfs:label 'Party Code' ;
    rdfs:comment 'Business-facing alphanumeric identifier assigned to the party by the title production system (e.g., SoftPro, RamQuest, Qualia). Used for cross-system reconciliation and CRM lookup.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Date Of Birth' ;
    rdfs:comment 'Birth date of a natural-person party. Used for identity verification, OFAC/FinCEN screening, and distinguishing same-name individuals in chain-of-title searches. Stored per GLBA NPPI controls.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deceasedDate rdf:type rdf:Property ;
    rdfs:label 'Deceased Date' ;
    rdfs:comment 'Date of death for a natural-person party. Used to determine whether a conveyance occurred before or after death, which is critical for chain-of-title validity and estate underwriting.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:entityFormationDate rdf:type rdf:Property ;
    rdfs:label 'Entity Formation Date' ;
    rdfs:comment 'Date on which a legal entity was formally incorporated, organized, or registered. Used to verify the entity existed at the time of a conveyance for chain-of-title validity.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:entityFormationState rdf:type rdf:Property ;
    rdfs:label 'Entity Formation State' ;
    rdfs:comment 'Two-letter US state code where a legal entity (corporation, LLC, trust) was formed or registered. Used to validate authority to convey and underwriting risk assessment for organizational parties.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:faxNumber rdf:type rdf:Property ;
    rdfs:label 'Fax Number' ;
    rdfs:comment 'Fax number for the party, primarily used for lender, attorney, and independent agent communications where fax remains a standard document delivery channel.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'Given name of a natural-person party. Populated only when party_type is individual. Used for closing document preparation and NPPI-controlled communications.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identityDocRef rdf:type rdf:Property ;
    rdfs:label 'Identity Doc Ref' ;
    rdfs:comment 'Vault reference token pointing to the party\'s government-issued identity document (driver\'s license, passport) stored in the NPPI Vault. Required for RON/IPEN and closing identity verification.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDeceased rdf:type rdf:Property ;
    rdfs:label 'Is Deceased' ;
    rdfs:comment 'Indicates the party is deceased. Triggers estate/probate underwriting review, blocks new transaction role assignments, and preserves historical chain-of-title and claims records.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDoNotContact rdf:type rdf:Property ;
    rdfs:label 'Is Do Not Contact' ;
    rdfs:comment 'Indicates the party has opted out of marketing and non-essential communications. Enforced in CRM and title production system routing to comply with TCPA and CCPA opt-out requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isForeignNational rdf:type rdf:Property ;
    rdfs:label 'Is Foreign National' ;
    rdfs:comment 'Indicates whether the party is a non-US citizen or foreign entity. Triggers FIRPTA withholding analysis, additional underwriting review, and FinCEN beneficial ownership disclosure requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNppiConsentGiven rdf:type rdf:Property ;
    rdfs:label 'Is Nppi Consent Given' ;
    rdfs:comment 'Indicates whether the party has provided consent for sharing Non-Public Personal Information (NPPI) with affiliated settlement service providers per GLBA privacy notice requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Surname of a natural-person party. Used in grantor/grantee index searches and chain-of-title assembly. Retained for historical vesting even after legal name change.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal name of the party exactly as it appears on vesting instruments, deeds, or articles of incorporation. Used for title commitment Schedule A vesting and policy issuance.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingCountry rdf:type rdf:Property ;
    rdfs:label 'Mailing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the party\'s mailing address. Relevant for foreign national buyers, foreign lenders, and FIRPTA withholding determination.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mailingState rdf:type rdf:Property ;
    rdfs:label 'Mailing State' ;
    rdfs:comment 'Two-letter US state code for the party\'s mailing address. Used for state-specific regulatory disclosure routing and premium tax jurisdiction determination.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maritalStatus rdf:type rdf:Property ;
    rdfs:label 'Marital Status' ;
    rdfs:comment 'Marital status of a natural-person party at the time of the transaction. Drives spousal signature requirements, homestead rights analysis, and vesting options on title commitment Schedule A.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:middleName rdf:type rdf:Property ;
    rdfs:label 'Middle Name' ;
    rdfs:comment 'Middle name or initial of a natural-person party. Required for grantor/grantee name matching in chain-of-title searches to distinguish parties with common first and last names.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilePhone rdf:type rdf:Property ;
    rdfs:label 'Mobile Phone' ;
    rdfs:comment 'Mobile telephone number for the party. Used for SMS closing alerts, RON session links, and two-factor identity verification during electronic notarization.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nameSuffix rdf:type rdf:Property ;
    rdfs:label 'Name Suffix' ;
    rdfs:comment 'Generational or professional suffix appended to an individual party name (e.g., Jr., Sr., II). Critical for distinguishing same-name grantor/grantee pairs in chain-of-title searches.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nppiConsentDate rdf:type rdf:Property ;
    rdfs:label 'Nppi Consent Date' ;
    rdfs:comment 'Date on which the party provided or last renewed NPPI consent. Used to determine consent currency and trigger re-consent workflows per GLBA annual notice requirements.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacScreenDate rdf:type rdf:Property ;
    rdfs:label 'Ofac Screen Date' ;
    rdfs:comment 'Most recent date on which the party was screened against the OFAC SDN list. Used to determine whether a re-screen is required before closing based on elapsed time thresholds.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ofacScreenResult rdf:type rdf:Property ;
    rdfs:label 'Ofac Screen Result' ;
    rdfs:comment 'Outcome of the most recent OFAC SDN screening for this party. A hit or inconclusive result blocks closing until underwriting review is completed.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ofacScreened rdf:type rdf:Property ;
    rdfs:label 'Ofac Screened' ;
    rdfs:comment 'Indicates whether the party has been screened against the OFAC Specially Designated Nationals (SDN) list. Required for FinCEN compliance and underwriting approval prior to closing.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Legal entity name for organizations, trusts, estates, or government bodies. Populated when party_type is not individual. Used for vesting, lender identification, and agency agreement records.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyStatus rdf:type rdf:Property ;
    rdfs:label 'Party Status' ;
    rdfs:comment 'Current lifecycle state of the party record. Inactive or dissolved parties are retained for historical chain-of-title and claims analysis but excluded from active transaction routing.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'Party\'s preferred channel for receiving closing documents, commitment updates, and settlement communications. Drives automated delivery routing in the title production system.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Email' ;
    rdfs:comment 'Primary email address for the party used for closing coordination, commitment delivery, and TRID/CD disclosures. Classified as NPPI under GLBA for individual parties.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Phone' ;
    rdfs:comment 'Primary telephone number for the party in E.164 format. Used for closing scheduling, RON/IPEN coordination, and identity verification callbacks.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Record Effective Date' ;
    rdfs:comment 'Business-effective date from which this party record version is considered authoritative. Supports bi-temporal modeling for chain-of-title and ownership interest evidence provenance.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Record Expiry Date' ;
    rdfs:comment 'Date on which this party record version is superseded by a newer version. Null indicates the current active version. Supports SCD Type 2 history for party identity changes.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:secondaryEmail rdf:type rdf:Property ;
    rdfs:label 'Secondary Email' ;
    rdfs:comment 'Alternate email address for the party, used when primary email is undeliverable or for routing copies of closing documents to a secondary contact such as a co-borrower or attorney.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPartyCode rdf:type rdf:Property ;
    rdfs:label 'Source System Party Code' ;
    rdfs:comment 'Native identifier for this party in the originating operational system (e.g., SoftPro contact ID, Salesforce Account ID). Used for cross-system reconciliation and master data management.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdRef rdf:type rdf:Property ;
    rdfs:label 'Tax Id Ref' ;
    rdfs:comment 'Tokenized or vault reference to the party\'s Tax Identification Number (TIN) or Social Security Number (SSN). Actual value stored in the NPPI Vault per GLBA. Used for IRS 1099-S reporting and IOLTA compliance.' ;
    rdfs:domain ind:Party ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingType rdf:type rdf:Property ;
    rdfs:label 'Vesting Type' ;
    rdfs:comment 'How the party holds or will hold title to real property (e.g., joint tenancy, tenancy in common, community property). Populates Schedule A of the title commitment and drives survivorship and conveyance rules.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyRoleId rdf:type rdf:Property ;
    rdfs:label 'Party Role Id' ;
    rdfs:comment 'Unique surrogate identifier for each party-role assignment record on a title order. Primary key of the party_role association entity.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByRolePartyRoleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Role Party Role Id' ;
    rdfs:comment 'Reference to the party_role record that replaced this assignment when a role was revised or transferred. Supports lifecycle transition and revision history per VREQ-007.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartyRole .

ind:amlScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Aml Screening Date' ;
    rdfs:comment 'Date on which the most recent AML/OFAC screening was performed for this party in this role. Used for compliance audit and re-screening interval tracking.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amlScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Aml Screening Status' ;
    rdfs:comment 'Result of AML/OFAC/FinCEN screening for this party in this role. Supports fraud controls and regulatory compliance for high-value and cash transactions.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Authority Document Ref' ;
    rdfs:comment 'Reference identifier for the document establishing the party\'s authority (e.g., POA instrument number, trust agreement reference, letters testamentary). Links to document management system.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorityType rdf:type rdf:Property ;
    rdfs:label 'Authority Type' ;
    rdfs:comment 'Basis of authority under which the party acts in this role (e.g., self, power of attorney, trustee, executor, guardian, corporate officer). Drives curative and underwriting requirements.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyRoleCode rdf:type rdf:Property ;
    rdfs:label 'Party Role Code' ;
    rdfs:comment 'Standardized alphanumeric code identifying the role type, aligned with MISMO or ALTA role code conventions (e.g., BUYER, SELLER, BRRWR, LNDR). Used for system integration and reporting.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplRequired rdf:type rdf:Property ;
    rdfs:label 'Cpl Required' ;
    rdfs:comment 'Indicates whether a Closing Protection Letter (CPL) must be issued naming this party in this role. Typically required for lender parties in lender-channel transactions.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firptaWithholdingRequired rdf:type rdf:Property ;
    rdfs:label 'Firpta Withholding Required' ;
    rdfs:comment 'Indicates whether FIRPTA withholding applies to this party in this role (typically seller parties who are foreign nationals). Drives escrow withholding and IRS reporting obligations.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:foreignNationalFlag rdf:type rdf:Property ;
    rdfs:label 'Foreign National Flag' ;
    rdfs:comment 'Indicates whether this party is a foreign national or foreign entity, triggering FIRPTA withholding requirements, FinCEN beneficial ownership reporting, and enhanced due diligence.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Date' ;
    rdfs:comment 'Date on which the party\'s identity was verified for this role assignment. Used for compliance audit trails and fraud control.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identityVerified rdf:type rdf:Property ;
    rdfs:label 'Identity Verified' ;
    rdfs:comment 'Indicates whether the party\'s identity has been verified for this role assignment through an approved identity verification process (e.g., ID check, RON/IPEN verification).' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates whether this party is the primary holder of the role when multiple parties share the same role type on an order (e.g., primary borrower vs. co-borrower).' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isVestingParty rdf:type rdf:Property ;
    rdfs:label 'Is Vesting Party' ;
    rdfs:comment 'Indicates whether this party appears on the vesting (title-holding) instrument for the subject property. Critical for Schedule A vesting language and ownership interest tracking.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noticeDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Notice Delivery Method' ;
    rdfs:comment 'Preferred method for delivering title-related notices and disclosures to this party in this role (email, mail, fax, portal, none). Supports TRID/RESPA disclosure delivery tracking.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nppiVaultRef rdf:type rdf:Property ;
    rdfs:label 'Nppi Vault Ref' ;
    rdfs:comment 'Tokenized reference to the NPPI Vault record holding sensitive identifiers (SSN/TIN, identity documents) for this party in this role. Actual NPPI is never stored here per GLBA/CCPA.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Fractional ownership interest held by this party when vesting type is tenancy in common or similar. Expressed as a decimal (e.g., 0.5000 = 50%). Null for sole ownership.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:partyCapacity rdf:type rdf:Property ;
    rdfs:label 'Party Capacity' ;
    rdfs:comment 'Legal capacity in which the party acts in this role: individual (natural person), entity (corporation/LLC/partnership), trust, estate, government body, or other.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:respaAffiliatedFlag rdf:type rdf:Property ;
    rdfs:label 'Respa Affiliated Flag' ;
    rdfs:comment 'Indicates whether this party has an affiliated business arrangement (AfBA) with the title company in this role, requiring RESPA Section 8 disclosure.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roleCategory rdf:type rdf:Property ;
    rdfs:label 'Role Category' ;
    rdfs:comment 'Broad grouping of the role type for reporting and routing: principal (buyer/seller/borrower), service_provider (agent/attorney/notary), lender, government, or other.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleNotes rdf:type rdf:Property ;
    rdfs:label 'Role Notes' ;
    rdfs:comment 'Free-text notes or instructions specific to this party\'s role on the order (e.g., special handling instructions, POA limitations, trust restrictions). Not for NPPI.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleSequence rdf:type rdf:Property ;
    rdfs:label 'Role Sequence' ;
    rdfs:comment 'Ordinal position when multiple parties share the same role type on a single order (e.g., co-buyer 1, co-buyer 2). Enables ordered display and processing of co-principals.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:roleSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Role Source System' ;
    rdfs:comment 'Originating system from which this party-role assignment was created or imported (e.g., title production system, CRM/order routing platform, lender portal, agency management system).' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleType rdf:type rdf:Property ;
    rdfs:label 'Role Type' ;
    rdfs:comment 'Contextual role the party holds on this title order (e.g., buyer, seller, borrower, lender, trustee, agent). One party may hold multiple simultaneous roles per VREQ-006.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spouseConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Spouse Consent Required' ;
    rdfs:comment 'Indicates whether spousal consent or joinder is required for this party\'s role in the transaction, based on marital status and state community property or homestead laws.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tridDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Trid Disclosure Required' ;
    rdfs:comment 'Indicates whether TRID disclosures (Loan Estimate / Closing Disclosure) must be provided to this party in this role. Typically true for borrower parties on covered loan transactions.' ;
    rdfs:domain ind:PartyRole ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceLevelId rdf:type rdf:Property ;
    rdfs:label 'Service Level Id' ;
    rdfs:comment 'Unique surrogate identifier for a service-level agreement record defining turn-time commitments for title orders by channel, transaction type, and product tier.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachPenaltyApplicable rdf:type rdf:Property ;
    rdfs:label 'Breach Penalty Applicable' ;
    rdfs:comment 'Indicates whether a contractual penalty or credit applies when this SLA is breached. True for lender channel agreements with negotiated service credits.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachPenaltyDescription rdf:type rdf:Property ;
    rdfs:label 'Breach Penalty Description' ;
    rdfs:comment 'Narrative description of the contractual penalty or service credit terms that apply upon SLA breach (e.g., fee waiver, rate reduction). Populated only when breach_penalty_applicable is true.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Business Hours End' ;
    rdfs:comment 'Local time (HH:MM, 24-hour) at which the business day ends for SLA measurement purposes (e.g., \'17:00\'). Used in conjunction with business_hours_start for cycle-time calculations.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessHoursStart rdf:type rdf:Property ;
    rdfs:label 'Business Hours Start' ;
    rdfs:comment 'Local time (HH:MM, 24-hour) at which the business day begins for SLA measurement purposes (e.g., \'08:00\'). Used to calculate business-hour turn-time compliance.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingReadinessHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Closing Readiness Hours Target' ;
    rdfs:comment 'Maximum number of business hours from cleared requirements to confirmed closing readiness (CD/HUD-1/ALTA settlement statement prepared). Supports closing readiness metrics per VREQ-016.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commitmentFormType rdf:type rdf:Property ;
    rdfs:label 'Commitment Form Type' ;
    rdfs:comment 'ALTA commitment form version or state-specific form required for commitments issued under this SLA (e.g., ALTA 2021, ALTA 2016). Governs Schedule A, B-I, B-II structure.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Commitment Hours Target' ;
    rdfs:comment 'Maximum number of business hours from examination completion to issuance of the title commitment (Schedule A, B-I, B-II). Drives commitment revision frequency metrics.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:curativeHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Curative Hours Target' ;
    rdfs:comment 'Maximum number of business hours allocated for curative action processing and clearance of Schedule B-I requirements. Supports curative action aging and effectiveness metrics.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:erecordingRequired rdf:type rdf:Property ;
    rdfs:label 'Erecording Required' ;
    rdfs:comment 'Indicates whether eRecording via gateway (e.g., Simplifile, CSC) is required for orders under this SLA. Affects recording submission turn-time targets and rejection/resubmission tracking.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationThresholdHours rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Hours' ;
    rdfs:comment 'Number of business hours before the total SLA target at which an at-risk order is escalated to a supervisor or account manager. Supports proactive SLA breach prevention.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:examinationHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Examination Hours Target' ;
    rdfs:comment 'Maximum number of business hours from search delivery to completion of title examination and defect identification. Supports open and aging title requirements metrics.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intakeHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Intake Hours Target' ;
    rdfs:comment 'Maximum number of business hours from order receipt to confirmed order intake/acknowledgment. Supports title clearance cycle-time metrics per VREQ-016.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ipenPermitted rdf:type rdf:Property ;
    rdfs:label 'Ipen Permitted' ;
    rdfs:comment 'Indicates whether In-Person Electronic Notarization (IPEN) is permitted for closings governed by this SLA. Distinct from RON; state-specific authorization required.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderName rdf:type rdf:Property ;
    rdfs:label 'Lender Name' ;
    rdfs:comment 'Name of the lender or lender channel for which this SLA is specifically negotiated. Null for generic SLAs not tied to a specific lender. Supports lender-specific cycle-time reporting.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderPlatform rdf:type rdf:Property ;
    rdfs:label 'Lender Platform' ;
    rdfs:comment 'Name of the lender integration platform (e.g., Encompass, Blend, SimpleNexus) through which orders governed by this SLA are received. Supports CRM/order routing platform alignment.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementBasis rdf:type rdf:Property ;
    rdfs:label 'Measurement Basis' ;
    rdfs:comment 'Defines whether SLA turn-time targets are measured in business hours, calendar hours, business days, or calendar days. Critical for accurate cycle-time calculation and lender reporting.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyIssuanceHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Policy Issuance Hours Target' ;
    rdfs:comment 'Maximum number of business hours from recording confirmation to issuance of owner (OTP) and lender (LTP) title policies. Supports policy issuance lag after recording metric per VREQ-016.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:productTier rdf:type rdf:Property ;
    rdfs:label 'Product Tier' ;
    rdfs:comment 'Service tier classification applied to this SLA (e.g., standard, expedited, premium, bulk). Drives turn-time targets and pricing in the title production system.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingSubmissionHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Recording Submission Hours Target' ;
    rdfs:comment 'Maximum number of business hours from closing to submission of documents to the county recorder/register of deeds via eRecording gateway. Supports recording rejection and resubmission rate metrics.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ronPermitted rdf:type rdf:Property ;
    rdfs:label 'Ron Permitted' ;
    rdfs:comment 'Indicates whether Remote Online Notarization (RON) is permitted for closings governed by this SLA. State-specific; affects closing coordination and document execution workflows.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:searchHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Search Hours Target' ;
    rdfs:comment 'Maximum number of business hours from order intake to delivery of completed title search and chain-of-title (COT) assembly. Key metric for clearance cycle-time analysis.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:searchTypeRequired rdf:type rdf:Property ;
    rdfs:label 'Search Type Required' ;
    rdfs:comment 'Minimum search type required for orders under this SLA: full chain-of-title search, two-owner search, update search, Ownership and Encumbrance (O&E) report, or title plant search.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchYearsRequired rdf:type rdf:Property ;
    rdfs:label 'Search Years Required' ;
    rdfs:comment 'Minimum number of years of chain-of-title history required for the title search under this SLA (e.g., 40 years for full search, 2 years for two-owner). Drives evidence completeness metrics.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaCode rdf:type rdf:Property ;
    rdfs:label 'Sla Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this service-level tier (e.g., SLA-REFI-LENDER-GOLD). Used in order routing and lender integration platforms.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDescription rdf:type rdf:Property ;
    rdfs:label 'Sla Description' ;
    rdfs:comment 'Free-text narrative describing the scope, conditions, and special terms of this service-level agreement. Used for lender onboarding documentation and internal reference.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaName rdf:type rdf:Property ;
    rdfs:label 'Sla Name' ;
    rdfs:comment 'Human-readable name for this service-level tier (e.g., \'Lender Gold Refinance 48-Hour\'). Displayed in production system dashboards and lender-facing portals.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaStatus rdf:type rdf:Property ;
    rdfs:label 'Sla Status' ;
    rdfs:comment 'Current lifecycle state of this SLA record: active (in use), draft (pending approval), inactive (suspended), superseded (replaced by newer version), or expired (past end date).' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaVersion rdf:type rdf:Property ;
    rdfs:label 'Sla Version' ;
    rdfs:comment 'Version identifier for this SLA definition, supporting lifecycle revision tracking (e.g., \'1.0\', \'2.3\'). Enables audit of prior SLA terms per VREQ-007.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateJurisdiction rdf:type rdf:Property ;
    rdfs:label 'State Jurisdiction' ;
    rdfs:comment 'Two-letter US state code (FIPS) for the jurisdiction to which this SLA applies. State-specific regulatory requirements (e.g., state DOI rules) may drive different turn-time commitments.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededBySlaCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Sla Code' ;
    rdfs:comment 'SLA code of the newer version that replaced this record when status is \'superseded\'. Enables forward-chaining of SLA revision history per VREQ-007.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the jurisdiction or branch where this SLA is applied (e.g., \'America/Chicago\'). Ensures accurate business-hour turn-time measurement across geographies.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalOrderHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Total Order Hours Target' ;
    rdfs:comment 'Maximum total business hours from order intake to policy issuance, representing the end-to-end title clearance cycle-time commitment. Primary SLA metric for lender channel reporting.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:uwReferralThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Threshold Usd' ;
    rdfs:comment 'Liability amount in USD at or above which orders governed by this SLA require underwriting referral (UWR). Supports underwriting referral and exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:ServiceLevel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorExamOperationsTitleExaminationId rdf:type rdf:Property ;
    rdfs:label 'Prior Exam Operations Title Examination Id' ;
    rdfs:comment 'Reference to a prior title examination record this examination updates or supersedes. Supports lifecycle revision history and bring-down examination traceability per VREQ-007.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OperationsTitleExamination .

ind:titleSearchId rdf:type rdf:Property ;
    rdfs:label 'Title Search Id' ;
    rdfs:comment 'Reference to the title search whose results are being examined. Preserves the legally distinct relationship between search assembly and examiner review.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleSearch .

ind:cotBreakDescription rdf:type rdf:Property ;
    rdfs:label 'Cot Break Description' ;
    rdfs:comment 'Narrative description of the chain-of-title break identified, including the time period affected and the nature of the gap (missing deed, unrecorded conveyance, etc.).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cotBreakDetected rdf:type rdf:Property ;
    rdfs:label 'Cot Break Detected' ;
    rdfs:comment 'Indicates whether the examiner identified a break or gap in the chain-of-title during this examination. Directly supports chain-of-title break metrics per VREQ-016.' ;
    rdfs:domain ind:Operations ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cotStartDate rdf:type rdf:Property ;
    rdfs:label 'Cot Start Date' ;
    rdfs:comment 'Earliest date in the chain-of-title reviewed during this examination. Establishes the historical depth of the title review for marketability analysis.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:countyName rdf:type rdf:Property ;
    rdfs:label 'County Name' ;
    rdfs:comment 'Name of the county or jurisdiction in which the subject property is located. Determines applicable recording requirements and county plant search standards.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectCount rdf:type rdf:Property ;
    rdfs:label 'Defect Count' ;
    rdfs:comment 'Total number of title defects, clouds, or encumbrances identified during this examination. Supports unresolved defect and lien metrics per VREQ-016.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:easementCount rdf:type rdf:Property ;
    rdfs:label 'Easement Count' ;
    rdfs:comment 'Number of easements, rights-of-way (ROW), or CC&Rs identified during the examination. Supports encumbrance completeness and Schedule B-II exception population.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evidenceCompletenessFlag rdf:type rdf:Property ;
    rdfs:label 'Evidence Completeness Flag' ;
    rdfs:comment 'Indicates whether all required supporting evidence (deeds, releases, satisfactions, court orders) was available and reviewed during the examination. Supports evidence completeness metrics per VREQ-016.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:examinationCompleteTimestamp rdf:type rdf:Property ;
    rdfs:label 'Examination Complete Timestamp' ;
    rdfs:comment 'Precise date and time when the examiner marked the examination complete or referred it. Paired with start timestamp to compute examination cycle time.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:examinationDate rdf:type rdf:Property ;
    rdfs:label 'Examination Date' ;
    rdfs:comment 'Calendar date on which the title examiner completed or substantially performed the examination review. Principal business event date for cycle-time measurement.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:examinationNumber rdf:type rdf:Property ;
    rdfs:label 'Examination Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier assigned to this examination by the title production system (e.g., SoftPro/RamQuest exam module). Used for cross-system traceability.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinationStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Examination Start Timestamp' ;
    rdfs:comment 'Precise date and time when the examiner began the title examination in the production system. Used to calculate examination duration and SLA compliance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:examinationStatus rdf:type rdf:Property ;
    rdfs:label 'Examination Status' ;
    rdfs:comment 'Current lifecycle state of the title examination. Drives workflow routing: in_progress (active review), complete (exam finished), referred (sent to underwriter), on_hold, cancelled.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinationType rdf:type rdf:Property ;
    rdfs:label 'Examination Type' ;
    rdfs:comment 'Classification of the examination scope: full chain-of-title review, update/bring-down of prior exam, O&E (Ownership and Encumbrance) report, or gap period review.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinerLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Examiner License Number' ;
    rdfs:comment 'State-issued license or certification number of the title examiner, where applicable. Supports regulatory compliance and examiner qualification tracking.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinerName rdf:type rdf:Property ;
    rdfs:label 'Examiner Name' ;
    rdfs:comment 'Full name of the title examiner who performed the review, captured at time of examination for historical accuracy independent of party record changes.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinerNotes rdf:type rdf:Property ;
    rdfs:label 'Examiner Notes' ;
    rdfs:comment 'Free-text narrative notes entered by the title examiner summarizing findings, concerns, or curative recommendations not captured in structured fields.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionCount rdf:type rdf:Property ;
    rdfs:label 'Exception Count' ;
    rdfs:comment 'Total number of Schedule B-II exceptions identified during this examination. Supports unresolved exception and underwriting referral rate metrics.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:judgmentLienDetected rdf:type rdf:Property ;
    rdfs:label 'Judgment Lien Detected' ;
    rdfs:comment 'Indicates whether a judgment lien against the current owner or a prior owner was identified during the examination. Requires curative action before policy issuance.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienCount rdf:type rdf:Property ;
    rdfs:label 'Lien Count' ;
    rdfs:comment 'Total number of open liens (tax, mechanics, judgment, HOA, HELOC, etc.) identified during the examination. Supports unresolved lien metrics per VREQ-016.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lisPendensDetected rdf:type rdf:Property ;
    rdfs:label 'Lis Pendens Detected' ;
    rdfs:comment 'Indicates whether a lis pendens (LP) was identified during the examination, signaling pending litigation affecting the property title.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mersLienDetected rdf:type rdf:Property ;
    rdfs:label 'Mers Lien Detected' ;
    rdfs:comment 'Indicates whether a MERS-registered mortgage or deed of trust was identified during the examination, requiring MERS-specific curative or release procedures.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:missingEvidenceDescription rdf:type rdf:Property ;
    rdfs:label 'Missing Evidence Description' ;
    rdfs:comment 'Narrative description of any evidence items that were unavailable or incomplete at the time of examination, supporting evidence provenance tracking per VREQ-016.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openLienAmount rdf:type rdf:Property ;
    rdfs:label 'Open Lien Amount' ;
    rdfs:comment 'Aggregate dollar amount of all open liens identified during the examination. Supports lien severity and underwriting risk assessment. Currency: USD.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyStateCode rdf:type rdf:Property ;
    rdfs:label 'Property State Code' ;
    rdfs:comment 'Two-letter USPS state code for the property jurisdiction. Determines applicable state title standards, examination requirements, and regulatory framework.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCount rdf:type rdf:Property ;
    rdfs:label 'Requirement Count' ;
    rdfs:comment 'Total number of Schedule B-I requirements raised by this examination. Supports open and aging title requirements metrics per VREQ-016.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:searchThroughDate rdf:type rdf:Property ;
    rdfs:label 'Search Through Date' ;
    rdfs:comment 'The date through which the underlying title search was run and upon which the examination is based. Defines the temporal boundary of the chain-of-title reviewed.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemExamCode rdf:type rdf:Property ;
    rdfs:label 'Source System Exam Code' ;
    rdfs:comment 'Native identifier for this examination record in the originating title production system (SoftPro, RamQuest, Qualia). Enables cross-system reconciliation and audit traceability.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxLienDetected rdf:type rdf:Property ;
    rdfs:label 'Tax Lien Detected' ;
    rdfs:comment 'Indicates whether a federal, state, or local tax lien was identified during the examination. Triggers curative requirement and potential underwriting referral.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:titleOpinion rdf:type rdf:Property ;
    rdfs:label 'Title Opinion' ;
    rdfs:comment 'Examiner\'s overall title opinion resulting from the examination: marketable, insurable, uninsurable, conditional (subject to requirements), or defective. Core underwriting input.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwReferralReason rdf:type rdf:Property ;
    rdfs:label 'Uw Referral Reason' ;
    rdfs:comment 'Narrative reason the examiner flagged this examination for underwriter review (e.g., unresolved lien, COT break, high-risk encumbrance, complex easement).' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingDeedType rdf:type rdf:Property ;
    rdfs:label 'Vesting Deed Type' ;
    rdfs:comment 'Type of deed by which current ownership is vested as identified during examination (WD, SWD, QCD, etc.). Informs title insurability and Schedule A vesting language.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingDescription rdf:type rdf:Property ;
    rdfs:label 'Vesting Description' ;
    rdfs:comment 'Narrative description of how title is currently vested (e.g., joint tenancy, tenancy in common, community property, trust). Populates Schedule A of the commitment.' ;
    rdfs:domain ind:OperationsTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerName rdf:type rdf:Property ;
    rdfs:label 'Buyer Name' ;
    rdfs:comment 'Full legal name of the buyer (purchase) or borrower (refinance/HELOC). Restricted PII. Used for vesting, policy issuance, and NPPI-controlled workflows.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderLoanNumber rdf:type rdf:Property ;
    rdfs:label 'Lender Loan Number' ;
    rdfs:comment 'Lender-assigned loan number for cross-referencing the title order with the lender\'s origination system. Required for TRID compliance and closing disclosure reconciliation.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderPolicyRequired rdf:type rdf:Property ;
    rdfs:label 'Lender Policy Required' ;
    rdfs:comment 'Indicates whether a lender\'s title policy (LTP) is required for this order. Typically required by the mortgage lender as a condition of the loan.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ltvRatio rdf:type rdf:Property ;
    rdfs:label 'Ltv Ratio' ;
    rdfs:comment 'Ratio of the loan amount to the property sales price or appraised value, expressed as a decimal (e.g., 0.8000 = 80%). Used for underwriting risk tier assignment and referral thresholds.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'Calendar date the title order was received and entered into the Title Production System. Serves as the BUSINESS_EVENT_TIMESTAMP anchor for SLA and cycle-time measurement.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderNotes rdf:type rdf:Property ;
    rdfs:label 'Order Notes' ;
    rdfs:comment 'Free-text operational notes entered by intake staff or processors regarding special instructions, lender requirements, or order-specific conditions.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Order Received Timestamp' ;
    rdfs:comment 'Precise date and time the title order was received by the system, including timezone offset. Used for intraday SLA measurement and intake-to-search cycle-time analytics.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle status of the title order from intake through closing. Drives workflow routing and SLA tracking. [ENUM-REF-CANDIDATE: open|in_search|in_examination|commitment_issued|cleared_to_close|closed|cancelled|on_hold — promote to reference' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerPolicyRequired rdf:type rdf:Property ;
    rdfs:label 'Owner Policy Required' ;
    rdfs:comment 'Indicates whether an owner\'s title policy (OTP) is required or requested for this order. Drives policy issuance workflow and premium calculation.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Order Number' ;
    rdfs:comment 'Order number of a prior title order on the same property, if this order is a continuation, reissue, or refinance of a previous transaction. Supports chain-of-title and reissue rate credit.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Property Address Line1' ;
    rdfs:comment 'Primary street address line of the subject property for this title order. Denormalized here for operational convenience and search/reporting without joining to property.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyCity rdf:type rdf:Property ;
    rdfs:label 'Property City' ;
    rdfs:comment 'City of the subject property. Used for jurisdiction routing, state filing, and geographic reporting.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyZipCode rdf:type rdf:Property ;
    rdfs:label 'Property Zip Code' ;
    rdfs:comment 'Five- or nine-digit ZIP code of the subject property. Used for geographic risk segmentation, rate zone assignment, and county routing.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salesPriceAmount rdf:type rdf:Property ;
    rdfs:label 'Sales Price Amount' ;
    rdfs:comment 'Contract purchase price of the subject property in US dollars. Used for owner policy premium calculation, LTV computation, and underwriting risk assessment. Null for refinance orders.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellerName rdf:type rdf:Property ;
    rdfs:label 'Seller Name' ;
    rdfs:comment 'Full legal name of the property seller. Restricted PII. Applicable to purchase transactions; null for refinance/HELOC. Used for chain-of-title and vesting verification.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaCommitmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Commitment Due Date' ;
    rdfs:comment 'Target date by which the title commitment must be issued per the applicable SLA for this order\'s channel and transaction type. Used for commitment issuance lag reporting.' ;
    rdfs:domain ind:TitleOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:abstractorPartyId rdf:type rdf:Property ;
    rdfs:label 'Abstractor Party Id' ;
    rdfs:comment 'Foreign key linking to operations.party. Business justification: Links the title search to the party master for the abstractor who performed the search. Currently abstractor_name is stored as STRING (denormalized).' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:jurisdictionId rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Id' ;
    rdfs:comment 'Foreign key linking to recording.jurisdiction. Business justification: Searches are performed against specific county recording offices. Jurisdiction determines plant coverage dates, recording fees, erecording capability, and turnaround times.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Jurisdiction .

ind:priorSearchTitleSearchId rdf:type rdf:Property ;
    rdfs:label 'Prior Search Title Search Id' ;
    rdfs:comment 'Reference to a prior title search on the same property or order, enabling update search linkage and chain-of-search provenance. Null for initial full searches.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleSearch .

ind:cancelledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cancelled Timestamp' ;
    rdfs:comment 'Date and time the title search was cancelled, if applicable. Null when search was not cancelled. Supports cancellation rate and reason analysis.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:completedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completed Timestamp' ;
    rdfs:comment 'Date and time the title search results were returned and marked complete. Used to calculate actual search turnaround time against SLA targets.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cotStartYear rdf:type rdf:Property ;
    rdfs:label 'Cot Start Year' ;
    rdfs:comment 'Earliest year from which the chain-of-title was assembled in this search. Supports COT completeness and break detection metrics.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:easementFound rdf:type rdf:Property ;
    rdfs:label 'Easement Found' ;
    rdfs:comment 'Indicates whether one or more easements (ROW, utility, access) were identified during the search. Easements are typically carried as Schedule B-II exceptions.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encroachmentFound rdf:type rdf:Property ;
    rdfs:label 'Encroachment Found' ;
    rdfs:comment 'Indicates whether an encroachment was identified during the search (e.g., from survey or prior instrument). May require survey endorsement or curative action.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gapPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Gap Period End Date' ;
    rdfs:comment 'End date of the gap period, typically the actual recording date. Null until recording is confirmed. Supports gap coverage period duration and risk metrics.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Gap Period Start Date' ;
    rdfs:comment 'Start date of the gap period between the search cutoff date and the anticipated recording date. Used to assess gap coverage risk and coordinate with the recording team.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hoaLienFound rdf:type rdf:Property ;
    rdfs:label 'Hoa Lien Found' ;
    rdfs:comment 'Indicates whether a homeowners association (HOA) lien or delinquent assessment was identified during the search. Requires payoff letter or clearance before closing.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentCount rdf:type rdf:Property ;
    rdfs:label 'Instrument Count' ;
    rdfs:comment 'Total number of recorded instruments (deeds, mortgages, liens, releases, etc.) identified and indexed during this title search. Supports evidence completeness metrics.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isAutomatedSearch rdf:type rdf:Property ;
    rdfs:label 'Is Automated Search' ;
    rdfs:comment 'Indicates whether the search was executed via an automated title plant system (e.g., DataTrace automated pull) versus a manual abstractor. Supports quality and cost analytics.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSlaBreached rdf:type rdf:Property ;
    rdfs:label 'Is Sla Breached' ;
    rdfs:comment 'Indicates whether the title search exceeded its SLA target hours. True when completed_timestamp minus ordered_timestamp exceeds sla_hours_target.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lisPendensFound rdf:type rdf:Property ;
    rdfs:label 'Lis Pendens Found' ;
    rdfs:comment 'Indicates whether a lis pendens (LP) was identified against the property during the search. True requires underwriting review before commitment issuance.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openJudgmentCount rdf:type rdf:Property ;
    rdfs:label 'Open Judgment Count' ;
    rdfs:comment 'Number of open judgment liens against the property or vested owners identified during the search. Distinct from tax and mechanics liens for underwriting triage.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openLienCount rdf:type rdf:Property ;
    rdfs:label 'Open Lien Count' ;
    rdfs:comment 'Number of open or unresolved liens (tax, mechanics, judgment, HOA) identified during the search. Feeds unresolved defect and lien aging metrics.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:orderedDate rdf:type rdf:Property ;
    rdfs:label 'Ordered Date' ;
    rdfs:comment 'Calendar date on which the title search was ordered or requested. Used as the start point for search turnaround and SLA cycle-time measurement.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ordered Timestamp' ;
    rdfs:comment 'Precise date and time the title search was ordered. Supports intraday SLA tracking and search queue prioritization in the title production system.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:plantCoverageFromDate rdf:type rdf:Property ;
    rdfs:label 'Plant Coverage From Date' ;
    rdfs:comment 'Earliest date covered by the title plant or public-record index used in this search. Defines the start of the chain-of-title (COT) period examined.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plantCoverageToDate rdf:type rdf:Property ;
    rdfs:label 'Plant Coverage To Date' ;
    rdfs:comment 'Latest date covered by the title plant or public-record index used in this search. Defines the end of the COT period and the effective search cutoff.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorDeedType rdf:type rdf:Property ;
    rdfs:label 'Prior Deed Type' ;
    rdfs:comment 'Type of the most recent vesting deed identified in the chain of title (WD, SWD, QCD, grant deed, trustee deed). Informs underwriting risk and coverage scope.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Search Fee Amount' ;
    rdfs:comment 'Dollar amount charged by the search vendor or abstractor for this title search. Used for vendor cost tracking, settlement statement line items, and profitability analysis.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:searchFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Search Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the search fee amount. Defaults to USD for domestic transactions; retained for multi-currency reporting consistency.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchFromDate rdf:type rdf:Property ;
    rdfs:label 'Search From Date' ;
    rdfs:comment 'Start date of the title search period as specified in the search order. May differ from plant coverage dates when a specific lookback period is requested.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:searchNumber rdf:type rdf:Property ;
    rdfs:label 'Search Number' ;
    rdfs:comment 'Externally visible, human-readable identifier assigned to this title search by the title production system (e.g., SoftPro, RamQuest). Used in correspondence and audit trails.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchPurpose rdf:type rdf:Property ;
    rdfs:label 'Search Purpose' ;
    rdfs:comment 'Transaction type driving the search request: purchase, refinance, HELOC, construction, commercial, or equity loan. Aligns search scope with underwriting requirements.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchResultDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Search Result Document Ref' ;
    rdfs:comment 'Reference identifier or URL to the search result package stored in the document management and imaging system. Supports evidence completeness and provenance tracking.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchSourceType rdf:type rdf:Property ;
    rdfs:label 'Search Source Type' ;
    rdfs:comment 'Indicates whether the search was performed against a title plant, direct public records, an automated search engine, manual abstractor review, or a hybrid combination.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchStatus rdf:type rdf:Property ;
    rdfs:label 'Search Status' ;
    rdfs:comment 'Current lifecycle status of the title search. Drives clearance cycle-time metrics and search aging dashboards. [ENUM-REF-CANDIDATE: ordered|in_progress|completed|cancelled|on_hold|failed — promote to reference product]' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchToDate rdf:type rdf:Property ;
    rdfs:label 'Search To Date' ;
    rdfs:comment 'End date of the title search period as specified in the search order. Represents the effective date through which public records were reviewed.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:searchType rdf:type rdf:Property ;
    rdfs:label 'Search Type' ;
    rdfs:comment 'Classification of the search scope: full chain-of-title, update, Ownership and Encumbrance (O&E) report, two-owner, 30-year, or current-owner. Determines depth of plant/public-record review.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchVendorCode rdf:type rdf:Property ;
    rdfs:label 'Search Vendor Code' ;
    rdfs:comment 'Code identifying the title plant or search vendor used to execute this search (e.g., DataTrace, TitlePoint, county plant). Supports vendor performance and cost tracking.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:searchVendorName rdf:type rdf:Property ;
    rdfs:label 'Search Vendor Name' ;
    rdfs:comment 'Full name of the title plant or search vendor that performed the search (e.g., DataTrace, TitlePoint). Retained for display and reporting when vendor code alone is insufficient.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaDueDate rdf:type rdf:Property ;
    rdfs:label 'Sla Due Date' ;
    rdfs:comment 'Contractual or operational due date by which the title search must be completed. Derived from ordered_date plus channel SLA hours; stored for direct SLA breach detection.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:slaHoursTarget rdf:type rdf:Property ;
    rdfs:label 'Sla Hours Target' ;
    rdfs:comment 'Number of business hours within which the search must be completed per the applicable channel or product SLA. Enables SLA compliance reporting.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemSearchCode rdf:type rdf:Property ;
    rdfs:label 'Source System Search Code' ;
    rdfs:comment 'Native identifier for this search record in the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Supports system-of-record traceability.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxLienFound rdf:type rdf:Property ;
    rdfs:label 'Tax Lien Found' ;
    rdfs:comment 'Indicates whether a federal or state tax lien was identified against the property or vested owner during the search. Triggers requirement for payoff or release.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uccFilingFound rdf:type rdf:Property ;
    rdfs:label 'Ucc Filing Found' ;
    rdfs:comment 'Indicates whether a UCC filing was identified against the property or owner during the search. Relevant for commercial transactions and fixture filings.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vestingDeedInstrumentNumber rdf:type rdf:Property ;
    rdfs:label 'Vesting Deed Instrument Number' ;
    rdfs:comment 'County recorder instrument number for the most recent vesting deed. Provides direct reference to the recorded instrument for evidence and provenance.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingDeedRecordingDate rdf:type rdf:Property ;
    rdfs:label 'Vesting Deed Recording Date' ;
    rdfs:comment 'Date the most recent vesting deed was recorded in the county recorder\'s office. Establishes the effective date of current ownership in the chain of title.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vestingGranteeName rdf:type rdf:Property ;
    rdfs:label 'Vesting Grantee Name' ;
    rdfs:comment 'Name of the grantee (current vested owner) on the most recent vesting deed. Must match the seller/borrower identity for commitment issuance.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingGrantorName rdf:type rdf:Property ;
    rdfs:label 'Vesting Grantor Name' ;
    rdfs:comment 'Name of the grantor on the most recent vesting deed as found in the grantor-grantee index. Used to verify current ownership and identify potential title defects.' ;
    rdfs:domain ind:TitleSearch ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appurtenantFlag rdf:type rdf:Property ;
    rdfs:label 'Appurtenant Flag' ;
    rdfs:comment 'Indicates whether the easement runs with the land (appurtenant) as opposed to being an easement in gross. True = appurtenant; False = in gross. Affects transferability analysis.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:areaSqFt rdf:type rdf:Property ;
    rdfs:label 'Area Sq Ft' ;
    rdfs:comment 'Total area of the easement or restricted zone in square feet. Supports underwriting assessment of the proportional impact on the insured parcel.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitingUtility rdf:type rdf:Property ;
    rdfs:label 'Benefiting Utility' ;
    rdfs:comment 'Name of the utility company, municipality, HOA, or other entity that holds or benefits from the easement. Relevant for utility, drainage, and ROW easements.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blanketFlag rdf:type rdf:Property ;
    rdfs:label 'Blanket Flag' ;
    rdfs:comment 'Indicates whether the easement is a blanket easement covering the entire parcel without a defined corridor. Blanket easements require special underwriting review and Schedule B-II exception language.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bookNumber rdf:type rdf:Property ;
    rdfs:label 'Book Number' ;
    rdfs:comment 'Book or volume number in the county recorder index where the creating instrument is recorded. Used for plant search verification and chain-of-title assembly.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ccRDocumentName rdf:type rdf:Property ;
    rdfs:label 'Cc R Document Name' ;
    rdfs:comment 'Name or title of the CC&R declaration document that contains the restriction, e.g., Declaration of Covenants, Conditions and Restrictions for [Subdivision Name].' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationChangeDate rdf:type rdf:Property ;
    rdfs:label 'Classification Change Date' ;
    rdfs:comment 'Date on which the restriction type or underwriting impact classification was last changed. Supports lifecycle history and audit trail per VREQ-007.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:curativeNotes rdf:type rdf:Property ;
    rdfs:label 'Curative Notes' ;
    rdfs:comment 'Free-text notes describing the curative action required or taken to address this easement or restriction, including status of release or vacation proceedings.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dominantEstateDescription rdf:type rdf:Property ;
    rdfs:label 'Dominant Estate Description' ;
    rdfs:comment 'Legal description or narrative identifying the dominant tenement (benefited parcel) for appurtenant easements. Null for easements in gross or restrictions with no dominant estate.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementSubtype rdf:type rdf:Property ;
    rdfs:label 'Easement Subtype' ;
    rdfs:comment 'Granular classification within the restriction type, e.g., utility easement, drainage easement, access easement, conservation easement, slope easement, pipeline easement.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encroachmentDescription rdf:type rdf:Property ;
    rdfs:label 'Encroachment Description' ;
    rdfs:comment 'Narrative description of any physical encroachment associated with this record, including the encroaching structure, direction, and estimated extent. Populated when restriction_type = encroachment.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionLanguage rdf:type rdf:Property ;
    rdfs:label 'Exception Language' ;
    rdfs:comment 'Verbatim or standardized exception language used in Schedule B-II of the title commitment or policy for this easement or restriction. Sourced from underwriter-approved language library.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusiveFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusive Flag' ;
    rdfs:comment 'Indicates whether the easement is exclusive to the grantee, preventing the grantor or other parties from using the same area for the same purpose.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:granteeName rdf:type rdf:Property ;
    rdfs:label 'Grantee Name' ;
    rdfs:comment 'Name of the party who received the easement benefit or is bound by the restriction, as it appears in the recorded instrument. Supports grantee index and benefited-party identification.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorName rdf:type rdf:Property ;
    rdfs:label 'Grantor Name' ;
    rdfs:comment 'Name of the party who granted the easement or imposed the restriction, as it appears in the recorded instrument. Supports grantor/grantee index and chain-of-title analysis.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoaName rdf:type rdf:Property ;
    rdfs:label 'Hoa Name' ;
    rdfs:comment 'Name of the Homeowners Association (HOA) that administers or enforces the CC&Rs or restriction, if applicable. Supports HOA lien and assessment tracking.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Number' ;
    rdfs:comment 'County recorder assigned instrument or document number for the creating instrument. Primary external reference for eRecording and plant search systems.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationDescription rdf:type rdf:Property ;
    rdfs:label 'Location Description' ;
    rdfs:comment 'Narrative or metes-and-bounds description of the physical location and extent of the easement area or restricted zone on the parcel, as stated in the recorded instrument.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pageNumber rdf:type rdf:Property ;
    rdfs:label 'Page Number' ;
    rdfs:comment 'Page number within the deed book where the creating instrument is recorded. Used together with book_number for precise plant index reference.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permittedUse rdf:type rdf:Property ;
    rdfs:label 'Permitted Use' ;
    rdfs:comment 'Description of the specific use or activity permitted under the easement, e.g., installation and maintenance of underground utilities, pedestrian access, drainage.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorClassification rdf:type rdf:Property ;
    rdfs:label 'Prior Classification' ;
    rdfs:comment 'Previous restriction_type or underwriting_impact classification before the most recent reclassification. Preserves lifecycle history per VREQ-007 material lifecycle transition requirements.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prohibitedUse rdf:type rdf:Property ;
    rdfs:label 'Prohibited Use' ;
    rdfs:comment 'Description of uses or activities expressly prohibited by the restriction or covenant, e.g., no structures within easement area, no commercial use, no subdivision below minimum lot size.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingDate rdf:type rdf:Property ;
    rdfs:label 'Recording Date' ;
    rdfs:comment 'Date the instrument creating this easement or restriction was recorded with the county recorder or register of deeds. Establishes constructive notice and priority. Distinct field per VREQ-008.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'Externally assigned identifier for this easement or restriction as recorded in the county plant or title plant index, e.g., instrument number, document number, or plant reference.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseDate rdf:type rdf:Property ;
    rdfs:label 'Release Date' ;
    rdfs:comment 'Date on which the easement or restriction was formally released, vacated, or extinguished by recorded instrument. Supports lifecycle history and curative clearance tracking.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:releaseInstrumentNumber rdf:type rdf:Property ;
    rdfs:label 'Release Instrument Number' ;
    rdfs:comment 'County recorder instrument number of the recorded release, satisfaction, or vacation document that extinguished this easement or restriction.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionStatus rdf:type rdf:Property ;
    rdfs:label 'Restriction Status' ;
    rdfs:comment 'Current lifecycle state of the easement or restriction. Drives title clearance workflow and Schedule B-II exception inclusion or removal decisions.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionText rdf:type rdf:Property ;
    rdfs:label 'Restriction Text' ;
    rdfs:comment 'Verbatim or summarized text of the restriction, covenant, or easement purpose as stated in the recorded instrument. Used for Schedule B-II exception drafting and underwriting review.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionType rdf:type rdf:Property ;
    rdfs:label 'Restriction Type' ;
    rdfs:comment 'High-level classification of the use restriction. Drives underwriting treatment and Schedule B-II exception language. [ENUM-REF-CANDIDATE: easement|right_of_way|covenant|encroachment|cc_and_r|restriction|license|profit_a_prendre — promote to reference' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleB2ExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Schedule B2 Exception Flag' ;
    rdfs:comment 'Indicates whether this easement or restriction is included as a printed exception in Schedule B-II of the title commitment or policy. True = included as exception.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:servientEstateDescription rdf:type rdf:Property ;
    rdfs:label 'Servient Estate Description' ;
    rdfs:comment 'Legal description or narrative identifying the servient tenement (burdened parcel) for appurtenant easements. Confirms which parcel bears the burden when multiple parcels are involved.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyReference rdf:type rdf:Property ;
    rdfs:label 'Survey Reference' ;
    rdfs:comment 'Reference to the ALTA/NSPS land title survey or plat map that depicts the easement or encroachment, including surveyor name, date, and job number where available.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingImpact rdf:type rdf:Property ;
    rdfs:label 'Underwriting Impact' ;
    rdfs:comment 'Underwriting determination of how this easement or restriction affects insurability. Drives Schedule B-II exception inclusion, referral routing, and curative action assignment.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:widthFt rdf:type rdf:Property ;
    rdfs:label 'Width Ft' ;
    rdfs:comment 'Width of the easement corridor or restricted strip in feet, as stated in the recorded instrument. Used for survey verification and encroachment analysis.' ;
    rdfs:domain ind:EasementRestriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:balanceAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Balance As Of Date' ;
    rdfs:comment 'Date as of which the current_balance_amount was determined or reported. Required to assess payoff accuracy and staleness of balance information.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:caseNumber rdf:type rdf:Property ;
    rdfs:label 'Case Number' ;
    rdfs:comment 'Court case number associated with a judgment lien, lis pendens, or foreclosure action. Required for judgment lien and LP encumbrance types to support curative research.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationChangedDate rdf:type rdf:Property ;
    rdfs:label 'Classification Changed Date' ;
    rdfs:comment 'Date on which the encumbrance type or status was reclassified. Used with prior_classification to maintain a lightweight lifecycle history without a full audit table.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtName rdf:type rdf:Property ;
    rdfs:label 'Court Name' ;
    rdfs:comment 'Name of the court that entered the judgment or filed the lis pendens. Applicable to judgment lien and lis pendens encumbrance types.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Curative Completed Date' ;
    rdfs:comment 'Date on which the curative action for this encumbrance was completed and the encumbrance was cleared. Populated when curative_status transitions to completed.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:curativeStatus rdf:type rdf:Property ;
    rdfs:label 'Curative Status' ;
    rdfs:comment 'Current status of the curative processing effort for this encumbrance (e.g., not required, pending, in progress, completed, waived, escalated). Supports curative aging and closing readiness metrics.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Current Balance Amount' ;
    rdfs:comment 'Most recently known outstanding balance of the encumbrance as of the balance_as_of_date. Used for payoff estimation and underwriting risk assessment. Null for non-monetary encumbrances.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discoveredDate rdf:type rdf:Property ;
    rdfs:label 'Discovered Date' ;
    rdfs:comment 'Date this encumbrance was first identified during a title search or examination. Supports evidence provenance, search completeness auditing, and chain-of-title gap analysis.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:easementPurpose rdf:type rdf:Property ;
    rdfs:label 'Easement Purpose' ;
    rdfs:comment 'Stated purpose of the easement (e.g., utility, drainage, access, right-of-way, pipeline). Applicable when encumbrance_type is easement. Supports underwriting exception analysis.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementType rdf:type rdf:Property ;
    rdfs:label 'Easement Type' ;
    rdfs:comment 'Classification of easement when encumbrance_type is easement (e.g., appurtenant, in gross, prescriptive, implied, express, ROW). Null or not_applicable for non-easement encumbrance types.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbranceStatus rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Status' ;
    rdfs:comment 'Current lifecycle status of the encumbrance indicating whether it remains a cloud on title or has been resolved (e.g., active, released, satisfied, subordinated, expired, disputed, pending cure).' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:encumbranceType rdf:type rdf:Property ;
    rdfs:label 'Encumbrance Type' ;
    rdfs:comment 'Classification of the encumbrance by legal instrument type (e.g., tax lien, mechanics lien, judgment lien, HOA lien, lis pendens, deed of trust, mortgage, UCC filing, easement, CC&R, encroachment).' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'Annual interest rate applicable to the encumbrance as stated in the underlying instrument. Expressed as a decimal (e.g., 0.065 = 6.5%). Null for non-interest-bearing encumbrances.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCurativeRequired rdf:type rdf:Property ;
    rdfs:label 'Is Curative Required' ;
    rdfs:comment 'Indicates whether a curative action (payoff, release, subordination, or other clearance) is required to resolve this encumbrance prior to or at closing. Drives requirement generation.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isInsuredException rdf:type rdf:Property ;
    rdfs:label 'Is Insured Exception' ;
    rdfs:comment 'Indicates whether this encumbrance has been listed as a Schedule B-II exception in an issued title commitment or policy. True = exception taken; False = not excepted or insured over.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienPositionNumber rdf:type rdf:Property ;
    rdfs:label 'Lien Position Number' ;
    rdfs:comment 'Numeric ordinal position of this lien among all liens on the parcel (1 = first lien, 2 = second lien, etc.). Supports automated priority ordering and chain-of-title analysis.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lienPriority rdf:type rdf:Property ;
    rdfs:label 'Lien Priority' ;
    rdfs:comment 'Priority position of the lien or encumbrance relative to other encumbrances on the same parcel (e.g., first, second, junior, senior, subordinate). Critical for underwriting and foreclosure analysis.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanNumber rdf:type rdf:Property ;
    rdfs:label 'Loan Number' ;
    rdfs:comment 'Lender-assigned loan number associated with the mortgage or deed of trust encumbrance. Used to correlate with lender systems for payoff demand and subordination requests.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maturityDate rdf:type rdf:Property ;
    rdfs:label 'Maturity Date' ;
    rdfs:comment 'Date on which the underlying obligation (mortgage, deed of trust, or lien) is scheduled to mature or expire. Null for perpetual encumbrances such as easements or CC&Rs.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalPrincipalAmount rdf:type rdf:Property ;
    rdfs:label 'Original Principal Amount' ;
    rdfs:comment 'Original face amount of the lien, mortgage, deed of trust, or judgment as stated in the recorded instrument. Expressed in USD. Null for non-monetary encumbrances such as easements or CC&Rs.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payoffDemandAmount rdf:type rdf:Property ;
    rdfs:label 'Payoff Demand Amount' ;
    rdfs:comment 'Total amount required to fully satisfy and release this encumbrance as stated in the payoff demand letter, valid through payoff_good_through_date. Used in settlement statement preparation.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:perDiemInterestAmount rdf:type rdf:Property ;
    rdfs:label 'Per Diem Interest Amount' ;
    rdfs:comment 'Daily interest accrual amount on the encumbrance, used to calculate payoff amounts at closing. Expressed in USD. Applicable to interest-bearing liens and mortgages.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemReference rdf:type rdf:Property ;
    rdfs:label 'Source System Reference' ;
    rdfs:comment 'Identifier or reference code from the originating system of record (e.g., Title Plant, DataTrace, TitlePoint, county plant index) where this encumbrance was discovered or sourced.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subtype rdf:type rdf:Property ;
    rdfs:label 'Subtype' ;
    rdfs:comment 'Further classification within the encumbrance type (e.g., federal tax lien vs. state tax lien, purchase money mortgage vs. HELOC, ROW easement vs. utility easement). Supports granular underwriting analysis.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxLienSerialNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Lien Serial Number' ;
    rdfs:comment 'IRS or state-assigned serial number for a federal or state tax lien certificate. Used to verify lien identity and obtain payoff or release from the taxing authority.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxYear rdf:type rdf:Property ;
    rdfs:label 'Tax Year' ;
    rdfs:comment 'Tax year to which a tax lien or delinquent tax encumbrance applies. Applicable to federal, state, and county tax lien types. Supports tax lien aging and curative prioritization.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uccFilingNumber rdf:type rdf:Property ;
    rdfs:label 'Ucc Filing Number' ;
    rdfs:comment 'Secretary of State filing number for a UCC financing statement encumbering fixtures or personal property associated with the real property. Applicable to UCC filing encumbrance type.' ;
    rdfs:domain ind:Encumbrance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorGranteeIndexId rdf:type rdf:Property ;
    rdfs:label 'Grantor Grantee Index Id' ;
    rdfs:comment 'Unique surrogate identifier for each grantor-grantee index record linking a grantor and grantee party to a recorded instrument affecting a parcel or property.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grantorGranteePartyId rdf:type rdf:Property ;
    rdfs:label 'Grantor Grantee Party Id' ;
    rdfs:comment 'Reference to the party record representing the grantee (transferee, mortgagee, lienholder) named in the recorded instrument.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:primaryGrantorPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Grantor Party Id' ;
    rdfs:comment 'Reference to the party record representing the grantor (transferor, mortgagor, lienor) named in the recorded instrument.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorIndexId rdf:type rdf:Property ;
    rdfs:label 'Prior Index Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding grantor-grantee index entry in the chain of title for this parcel, enabling linked-list traversal of ownership history.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GrantorGranteeIndex .

ind:chainOfTitleSequence rdf:type rdf:Property ;
    rdfs:label 'Chain Of Title Sequence' ;
    rdfs:comment 'Ordinal sequence number of this index entry within the chain of title for the parcel, enabling ordered traversal of ownership history from earliest to most recent conveyance.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:considerationAmount rdf:type rdf:Property ;
    rdfs:label 'Consideration Amount' ;
    rdfs:comment 'Dollar amount of consideration stated in the instrument (e.g., purchase price on a deed). May be nominal ($1.00) or actual; used for transfer tax calculation and market value analysis.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:considerationCurrency rdf:type rdf:Property ;
    rdfs:label 'Consideration Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the consideration amount stated in the instrument. Typically USD for domestic US title transactions.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cotBreakFlag rdf:type rdf:Property ;
    rdfs:label 'Cot Break Flag' ;
    rdfs:comment 'Indicates a detected break or gap in the chain of title at this index entry (e.g., grantor does not match prior grantee), triggering curative action or underwriting referral.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estateType rdf:type rdf:Property ;
    rdfs:label 'Estate Type' ;
    rdfs:comment 'Type of estate or interest conveyed by the instrument (e.g., fee simple, life estate, leasehold, easement), used to classify the nature of the ownership interest transferred.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeEntityType rdf:type rdf:Property ;
    rdfs:label 'Grantee Entity Type' ;
    rdfs:comment 'Classification of the grantee as an individual person or legal entity type, used to assess vesting capacity and taking title. [ENUM-REF-CANDIDATE: individual|corporation|llc|trust|partnership|government|estate|other — promote to reference product]' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeNameAsIndexed rdf:type rdf:Property ;
    rdfs:label 'Grantee Name As Indexed' ;
    rdfs:comment 'Full name of the grantee exactly as it appears in the county recorder or title plant grantor-grantee index, preserving original spelling for chain-of-title search accuracy.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:granteeNameStandardized rdf:type rdf:Property ;
    rdfs:label 'Grantee Name Standardized' ;
    rdfs:comment 'Normalized/standardized form of the grantee name used for fuzzy matching and chain-of-title continuity analysis across index entries with spelling variations.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorEntityType rdf:type rdf:Property ;
    rdfs:label 'Grantor Entity Type' ;
    rdfs:comment 'Classification of the grantor as an individual person or legal entity type, used to assess vesting capacity and authority to convey. [ENUM-REF-CANDIDATE: individual|corporation|llc|trust|partnership|government|estate|other — promote to reference product]' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorNameAsIndexed rdf:type rdf:Property ;
    rdfs:label 'Grantor Name As Indexed' ;
    rdfs:comment 'Full name of the grantor exactly as it appears in the county recorder or title plant grantor-grantee index, preserving original spelling for chain-of-title search accuracy.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grantorNameStandardized rdf:type rdf:Property ;
    rdfs:label 'Grantor Name Standardized' ;
    rdfs:comment 'Normalized/standardized form of the grantor name used for fuzzy matching and chain-of-title continuity analysis across index entries with spelling variations.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexEntryDate rdf:type rdf:Property ;
    rdfs:label 'Index Entry Date' ;
    rdfs:comment 'Date this grantor-grantee index record was entered into the title plant or internal system, which may differ from the county recording date for plant-lag tracking.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indexSource rdf:type rdf:Property ;
    rdfs:label 'Index Source' ;
    rdfs:comment 'Source system or authority from which this grantor-grantee index entry was obtained (e.g., county recorder direct, DataTrace title plant, TitlePoint). Supports evidence provenance tracking.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexStatus rdf:type rdf:Property ;
    rdfs:label 'Index Status' ;
    rdfs:comment 'Current lifecycle status of this grantor-grantee index record. \'Superseded\' indicates a corrected or amended instrument has replaced this entry in the chain of title.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienPosition rdf:type rdf:Property ;
    rdfs:label 'Lien Position' ;
    rdfs:comment 'Priority position of the lien or encumbrance created by the instrument (1 = first lien, 2 = second lien, etc.), determined by recording date and any subordination agreements.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:nominalConsiderationFlag rdf:type rdf:Property ;
    rdfs:label 'Nominal Consideration Flag' ;
    rdfs:comment 'Indicates whether the stated consideration is nominal (e.g., $1.00 or \'love and affection\') rather than the actual market value, signaling a non-arm\'s-length transfer for underwriting review.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notaryCommissionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Notary Commission Expiry Date' ;
    rdfs:comment 'Expiration date of the notary\'s commission at the time of acknowledgment, used to verify the notary was duly commissioned when the instrument was executed.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notaryName rdf:type rdf:Property ;
    rdfs:label 'Notary Name' ;
    rdfs:comment 'Name of the notary public who acknowledged the grantor\'s signature on the instrument, as recorded in the acknowledgment clause. Used to verify proper execution.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Recording Timestamp' ;
    rdfs:comment 'Exact date and time the instrument was stamped as recorded by the county recorder, used for priority determination when multiple instruments are recorded on the same date.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:releaseRecordingDate rdf:type rdf:Property ;
    rdfs:label 'Release Recording Date' ;
    rdfs:comment 'Date the release, reconveyance, or satisfaction of the instrument was recorded, confirming the lien or encumbrance has been discharged from the chain of title.' ;
    rdfs:domain ind:GrantorGranteeIndex ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Source Reference Number' ;
    rdfs:comment 'External reference number assigned by the source system (county recorder, title plant, or eRecording gateway) for this index entry, used for reconciliation and audit traceability.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Amount' ;
    rdfs:comment 'Documentary transfer tax or deed stamp tax amount paid at recording, as noted on the instrument face. Used for consideration verification and tax compliance reporting.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorDescriptionLegalDescriptionId rdf:type rdf:Property ;
    rdfs:label 'Prior Description Legal Description Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding version of this legal description. Enables chain-of-description history and prior classification preservation per VREQ-007.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LegalDescription .

ind:areaAcres rdf:type rdf:Property ;
    rdfs:label 'Area Acres' ;
    rdfs:comment 'Total land area of the described parcel expressed in acres. Used in underwriting risk assessment, policy coverage determination, and commercial transaction analysis.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blockNumber rdf:type rdf:Property ;
    rdfs:label 'Block Number' ;
    rdfs:comment 'Block number within the recorded subdivision or plat. Applicable when description_type is plat_subdivision or lot_block. Used with lot_number for full lot-block identification.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buildingNumber rdf:type rdf:Property ;
    rdfs:label 'Building Number' ;
    rdfs:comment 'Building or phase identifier within a condominium or multi-building development. Supplements unit_number for complex condo legal descriptions.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:descriptionSource rdf:type rdf:Property ;
    rdfs:label 'Description Source' ;
    rdfs:comment 'Origin source from which this legal description was extracted or derived. Supports evidence and provenance capture across the title lifecycle. [ENUM-REF-CANDIDATE: recorded_deed|plat_map|alta_survey|title_plant|assessor_record|prior_policy|other — promote' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:descriptionStatus rdf:type rdf:Property ;
    rdfs:label 'Description Status' ;
    rdfs:comment 'Current lifecycle status of this legal description record. Active indicates the current operative description; superseded preserves prior versions per VREQ-007 lifecycle history requirements.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:descriptionType rdf:type rdf:Property ;
    rdfs:label 'Description Type' ;
    rdfs:comment 'Classification of the legal description format. Metes and bounds (M&B), Public Land Survey System (PLSS) township/range/section, plat/subdivision lot-block, condominium unit, or other.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:descriptionVarianceNotes rdf:type rdf:Property ;
    rdfs:label 'Description Variance Notes' ;
    rdfs:comment 'Narrative notes documenting any discrepancy or variance between this legal description and the description appearing in a prior instrument, commitment, or policy.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fullText rdf:type rdf:Property ;
    rdfs:label 'Full Text' ;
    rdfs:comment 'Complete verbatim text of the legal description as it appears in the recorded instrument or title commitment Schedule A. Authoritative SSOT for the legal description string.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapNotes rdf:type rdf:Property ;
    rdfs:label 'Gap Notes' ;
    rdfs:comment 'Examiner or underwriter notes describing the nature of any identified gap between this legal description and the prior recorded description. Supports curative processing.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hasGapRisk rdf:type rdf:Property ;
    rdfs:label 'Has Gap Risk' ;
    rdfs:comment 'Flags whether a gap exists between the legal description in the current instrument and the prior recorded description, indicating potential chain-of-title break or gap coverage need.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isScheduleAApproved rdf:type rdf:Property ;
    rdfs:label 'Is Schedule A Approved' ;
    rdfs:comment 'Indicates whether this legal description has been reviewed and approved by the examiner or underwriter for use in the title commitment or policy Schedule A.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lotNumber rdf:type rdf:Property ;
    rdfs:label 'Lot Number' ;
    rdfs:comment 'Lot number within the recorded subdivision or plat. Applicable when description_type is plat_subdivision or lot_block. Core identifier for platted parcels.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metesBoundsPointOfBeginning rdf:type rdf:Property ;
    rdfs:label 'Metes Bounds Point Of Beginning' ;
    rdfs:comment 'Narrative description of the point of beginning (POB) for a metes-and-bounds legal description. Applicable when description_type is metes_and_bounds.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platBook rdf:type rdf:Property ;
    rdfs:label 'Plat Book' ;
    rdfs:comment 'Book number or volume of the recorded plat map in the county recorder\'s index. Used to locate the source plat document for title examination.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:platPage rdf:type rdf:Property ;
    rdfs:label 'Plat Page' ;
    rdfs:comment 'Page number within the plat book where the subdivision map is recorded. Used in conjunction with plat_book to locate the source plat document.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plssAliquotParts rdf:type rdf:Property ;
    rdfs:label 'Plss Aliquot Parts' ;
    rdfs:comment 'Aliquot part subdivisions within the PLSS section (e.g., NE1/4 of SW1/4). Applicable when description_type is plss. Provides precise parcel location within a section.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plssPrincipalMeridian rdf:type rdf:Property ;
    rdfs:label 'Plss Principal Meridian' ;
    rdfs:comment 'Name or code of the PLSS principal meridian governing the township/range/section coordinates (e.g., Willamette, Boise, 6th PM). Applicable when description_type is plss.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plssRange rdf:type rdf:Property ;
    rdfs:label 'Plss Range' ;
    rdfs:comment 'Range designation in the PLSS coordinate system (e.g., R3E, R7W). Applicable when description_type is plss. Used in chain-of-title and search indexing.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plssSection rdf:type rdf:Property ;
    rdfs:label 'Plss Section' ;
    rdfs:comment 'Section number (1–36) within the PLSS township/range grid. Applicable when description_type is plss. Core identifier for PLSS-based legal descriptions.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plssState rdf:type rdf:Property ;
    rdfs:label 'Plss State' ;
    rdfs:comment 'Two-letter US state code for the PLSS meridian context. Applicable only when description_type is plss. Identifies the principal meridian jurisdiction.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plssTownship rdf:type rdf:Property ;
    rdfs:label 'Plss Township' ;
    rdfs:comment 'Township designation in the PLSS coordinate system (e.g., T2N, T5S). Applicable when description_type is plss. Used in chain-of-title and search indexing.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingReference rdf:type rdf:Property ;
    rdfs:label 'Recording Reference' ;
    rdfs:comment 'Official recording reference (book/page, document number, or instrument number) of the source instrument from which this legal description derives. Links description to county recorder index.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleAText rdf:type rdf:Property ;
    rdfs:label 'Schedule A Text' ;
    rdfs:comment 'The legal description text as formatted and printed in the title commitment or policy Schedule A. May differ slightly from the raw recorded instrument text due to standardization.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Source Instrument Id' ;
    rdfs:comment 'Reference to the recorded instrument (deed, plat, or other document) from which this legal description was extracted. Supports evidence and provenance capture.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standardizedText rdf:type rdf:Property ;
    rdfs:label 'Standardized Text' ;
    rdfs:comment 'Normalized or standardized version of the legal description text produced by the title plant or search automation system for indexing and comparison purposes.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subdivisionName rdf:type rdf:Property ;
    rdfs:label 'Subdivision Name' ;
    rdfs:comment 'Name of the recorded plat or subdivision as shown on the plat map filed with the county recorder. Applicable when description_type is plat_subdivision or lot_block.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededDate rdf:type rdf:Property ;
    rdfs:label 'Superseded Date' ;
    rdfs:comment 'Date on which this legal description was replaced by a newer version. Null if currently active. Preserves prior classification history per VREQ-007.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyDate rdf:type rdf:Property ;
    rdfs:label 'Survey Date' ;
    rdfs:comment 'Date of the land survey from which the metes-and-bounds or ALTA/NSPS survey legal description was derived. Used to assess description currency and gap risk.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:surveyorLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Surveyor License Number' ;
    rdfs:comment 'State-issued professional license number of the land surveyor who prepared the survey. Supports evidence provenance and regulatory compliance verification.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:surveyorName rdf:type rdf:Property ;
    rdfs:label 'Surveyor Name' ;
    rdfs:comment 'Name of the licensed land surveyor or surveying firm that prepared the survey underlying this legal description. Used for evidence provenance and E&O tracking.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titlePlantIndexKey rdf:type rdf:Property ;
    rdfs:label 'Title Plant Index Key' ;
    rdfs:comment 'Index key or reference code assigned by the title plant or search automation system (e.g., DataTrace, TitlePoint) to locate this legal description in the plant index.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitNumber rdf:type rdf:Property ;
    rdfs:label 'Unit Number' ;
    rdfs:comment 'Unit identifier for condominium or planned unit development descriptions. Applicable when description_type is condo_unit. Used in Schedule A for condo title policies.' ;
    rdfs:domain ind:LegalDescription ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lifecycleEventId rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each property lifecycle event record in the Property Information and County Data System.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownershipInterestId rdf:type rdf:Property ;
    rdfs:label 'Ownership Interest Id' ;
    rdfs:comment 'Reference to the ownership_interest record created or superseded by this lifecycle event. Supports effective-dated ownership chain per VREQ-005.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OwnershipInterest .

ind:supersededEventId rdf:type rdf:Property ;
    rdfs:label 'Superseded Event Id' ;
    rdfs:comment 'Self-referencing identifier of the prior lifecycle event that this record supersedes or amends. Null for original events. Preserves revision history and prior classifications per VREQ-007.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Event .

ind:taxAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Tax Assessment Id' ;
    rdfs:comment 'Foreign key linking to property.tax_assessment. Business justification: Tax assessment changes (supplemental assessments, appeals, tax lien filings) are material lifecycle events.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxAssessment .

ind:curativeRequired rdf:type rdf:Property ;
    rdfs:label 'Curative Required' ;
    rdfs:comment 'Indicates whether this lifecycle event requires curative processing to clear a defect, lien, or encumbrance before title can be insured. Drives curative workflow initiation.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:erecordingFlag rdf:type rdf:Property ;
    rdfs:label 'Erecording Flag' ;
    rdfs:comment 'Indicates whether the instrument associated with this lifecycle event was submitted and recorded electronically via an eRecording gateway (e.g., Simplifile, CSC eRecording).' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventNotes rdf:type rdf:Property ;
    rdfs:label 'Event Notes' ;
    rdfs:comment 'Free-text field for examiner or processor notes describing the nature, context, or significance of this lifecycle event. Supports curative and underwriting review workflows.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Externally visible, human-readable identifier for this lifecycle event (e.g., LE-2024-00123). Used for cross-system traceability and audit references.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventStatus rdf:type rdf:Property ;
    rdfs:label 'Event Status' ;
    rdfs:comment 'Current workflow state of this lifecycle event record. Superseded indicates a later event has replaced this one; voided indicates the event was recorded in error.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSubtype rdf:type rdf:Property ;
    rdfs:label 'Event Subtype' ;
    rdfs:comment 'Secondary classification providing finer granularity within an event_type (e.g., within vesting_change: joint_tenancy_to_tenancy_in_common, addition_of_co_owner). Free-form or controlled per event_type.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Gap Period Flag' ;
    rdfs:comment 'Indicates whether this lifecycle event falls within a gap period between the effective date of a title search and the recording of the insured instrument. Supports GAP coverage analysis.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newClassification rdf:type rdf:Property ;
    rdfs:label 'New Classification' ;
    rdfs:comment 'The property type, vesting form, parcel status, or legal description classification established by this lifecycle event. Paired with prior_classification to document the transition.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newVesting rdf:type rdf:Property ;
    rdfs:label 'New Vesting' ;
    rdfs:comment 'The vesting language or tenancy form established by this lifecycle event. Null for non-vesting event types. Supports chain-of-title and ownership interest analysis.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notarizationType rdf:type rdf:Property ;
    rdfs:label 'Notarization Type' ;
    rdfs:comment 'Method by which the instrument was notarized: traditional in-person, Remote Online Notarization (RON), or In-Person Electronic Notarization (IPEN). Supports compliance and validity tracking.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorApn rdf:type rdf:Property ;
    rdfs:label 'Prior Apn' ;
    rdfs:comment 'The APN that existed before a parcel split, merge, or reassignment event. Null for non-parcel-change events. Supports parcel lineage and chain-of-title continuity.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorVesting rdf:type rdf:Property ;
    rdfs:label 'Prior Vesting' ;
    rdfs:comment 'The vesting language or tenancy form (e.g., joint tenancy, tenancy in common, community property) in effect before a vesting_change event. Null for non-vesting event types.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordedByParty rdf:type rdf:Property ;
    rdfs:label 'Recorded By Party' ;
    rdfs:comment 'Name of the party (individual, title company, or attorney) who submitted the instrument for recording with the county recorder. Supports recording accountability and audit.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemEventCode rdf:type rdf:Property ;
    rdfs:label 'Source System Event Code' ;
    rdfs:comment 'Native identifier of this lifecycle event in the originating operational system (e.g., DataTrace event ID, Simplifile submission ID). Supports cross-system reconciliation and provenance.' ;
    rdfs:domain ind:LifecycleEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorInterestOwnershipInterestId rdf:type rdf:Property ;
    rdfs:label 'Prior Interest Ownership Interest Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding ownership interest record in the chain of title. Enables linked-list traversal of the full ownership history.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OwnershipInterest .

ind:acquisitionType rdf:type rdf:Property ;
    rdfs:label 'Acquisition Type' ;
    rdfs:comment 'Nature of the transaction by which this ownership interest was acquired (e.g., purchase, gift, inheritance, foreclosure). Informs underwriting risk classification and chain-of-title analysis.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cloudOnTitleFlag rdf:type rdf:Property ;
    rdfs:label 'Cloud On Title Flag' ;
    rdfs:comment 'Indicates the presence of a cloud on title — an outstanding claim, encumbrance, or defect that impairs the owner\'s ability to convey clear title. Triggers curative processing.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Legal entity classification of the party holding this ownership interest (e.g., individual, LLC, corporation, trust). Drives authority and capacity verification requirements.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceDocumentId rdf:type rdf:Property ;
    rdfs:label 'Evidence Document Id' ;
    rdfs:comment 'Reference to the recorded instrument or document that evidences this ownership interest (e.g., warranty deed, quit claim deed). Supports VREQ-005 evidence-backed ownership.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insurableTitleFlag rdf:type rdf:Property ;
    rdfs:label 'Insurable Title Flag' ;
    rdfs:comment 'Indicates whether the title associated with this ownership interest is insurable by the underwriter, even if not fully marketable. Distinct from marketable title determination.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestStatus rdf:type rdf:Property ;
    rdfs:label 'Interest Status' ;
    rdfs:comment 'Current lifecycle state of this ownership interest record. Active indicates current vested ownership; superseded indicates a prior record replaced by a subsequent conveyance.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestType rdf:type rdf:Property ;
    rdfs:label 'Interest Type' ;
    rdfs:comment 'Classification of the estate or interest held (e.g., fee simple, life estate, leasehold). Determines the nature and scope of the ownership right conveyed.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketableTitleFlag rdf:type rdf:Property ;
    rdfs:label 'Marketable Title Flag' ;
    rdfs:comment 'Indicates whether the title associated with this ownership interest has been determined to be marketable (free from reasonable doubt as to validity). Set by the title examiner.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mersFlag rdf:type rdf:Property ;
    rdfs:label 'Mers Flag' ;
    rdfs:comment 'Indicates whether the associated mortgage or deed of trust is registered with MERS (Mortgage Electronic Registration Systems), affecting lien holder identification in the chain of title.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reclassificationReason rdf:type rdf:Property ;
    rdfs:label 'Reclassification Reason' ;
    rdfs:comment 'Reason for any change in the ownership interest classification or status (e.g., correction of vesting language, court order, curative deed). Supports lifecycle history per VREQ-007.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateOfFormation rdf:type rdf:Property ;
    rdfs:label 'State Of Formation' ;
    rdfs:comment 'Two-letter US state code where a corporate or LLC entity holding title was formed. Required for entity authority and good-standing verification in underwriting.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trustName rdf:type rdf:Property ;
    rdfs:label 'Trust Name' ;
    rdfs:comment 'Legal name of the trust holding title, if the vesting type is trust. Required for Schedule A vesting language and trustee authority verification.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trusteeName rdf:type rdf:Property ;
    rdfs:label 'Trustee Name' ;
    rdfs:comment 'Full legal name of the trustee acting on behalf of a trust that holds title. Required when vesting_type is trust for Schedule A and authority verification.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingName rdf:type rdf:Property ;
    rdfs:label 'Vesting Name' ;
    rdfs:comment 'Exact vesting language as it appears on the deed or title instrument (e.g., \'John Doe and Jane Doe, as joint tenants\'). Used verbatim in Schedule A of the title commitment and policy.' ;
    rdfs:domain ind:OwnershipInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acreage rdf:type rdf:Property ;
    rdfs:label 'Acreage' ;
    rdfs:comment 'Total land area of the parcel expressed in acres as recorded by the county assessor. Used for property valuation, underwriting risk assessment, and legal description verification.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Tax Amount' ;
    rdfs:comment 'Annual real property tax amount billed for the parcel based on the assessed value and applicable tax rate. Used in settlement statement proration and escrow impound calculations.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessedImprovementValue rdf:type rdf:Property ;
    rdfs:label 'Assessed Improvement Value' ;
    rdfs:comment 'County assessor\'s assessed value of improvements (structures) on the parcel, excluding land. Used with assessed_land_value for total assessed value and tax computation.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessedLandValue rdf:type rdf:Property ;
    rdfs:label 'Assessed Land Value' ;
    rdfs:comment 'County assessor\'s assessed value of the land component of the parcel, excluding improvements. Used for tax calculation, underwriting valuation, and LTV analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessedTotalValue rdf:type rdf:Property ;
    rdfs:label 'Assessed Total Value' ;
    rdfs:comment 'Total assessed value of the parcel (land plus improvements) as determined by the county assessor. Used for property tax billing and underwriting risk analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessmentYear rdf:type rdf:Property ;
    rdfs:label 'Assessment Year' ;
    rdfs:comment 'Tax year for which the assessed values on this parcel record are applicable. Used to track annual assessment changes and historical valuation trends.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Data Effective Date' ;
    rdfs:comment 'Date as of which the parcel data in this record is current and authoritative. Used to track data currency for title search, examination, and ownership interest analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:floodMapPanelNumber rdf:type rdf:Property ;
    rdfs:label 'Flood Map Panel Number' ;
    rdfs:comment 'FEMA Flood Insurance Rate Map (FIRM) panel number applicable to the parcel. Used with flood_zone_code to identify the specific FIRM panel for flood determination documentation.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floodZoneCode rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Code' ;
    rdfs:comment 'FEMA National Flood Insurance Program (NFIP) flood zone designation for the parcel (e.g., AE, X, VE). Used in underwriting risk assessment and lender flood insurance requirements.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hoaFlag rdf:type rdf:Property ;
    rdfs:label 'Hoa Flag' ;
    rdfs:comment 'Indicates whether the parcel is subject to a Homeowners Association (HOA). A true value requires HOA lien search and assessment verification during title examination.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:landUseCode rdf:type rdf:Property ;
    rdfs:label 'Land Use Code' ;
    rdfs:comment 'Assessor land use code assigned to the parcel indicating the specific use classification (e.g., single-family residential, multi-family, commercial retail). Sourced from county assessor records.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the parcel centroid in decimal degrees (WGS84). Used for spatial analysis, flood zone determination, and property information services.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the parcel centroid in decimal degrees (WGS84). Used with latitude for spatial analysis, flood zone determination, and mapping.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lotAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Lot Area Sqft' ;
    rdfs:comment 'Total lot area of the parcel expressed in square feet. Complements acreage for residential and commercial underwriting analysis and property information reporting.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lotDepthFt rdf:type rdf:Property ;
    rdfs:label 'Lot Depth Ft' ;
    rdfs:comment 'Depth of the parcel lot measured in feet as recorded by the county assessor or plat map. Used in legal description verification and encroachment analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lotWidthFt rdf:type rdf:Property ;
    rdfs:label 'Lot Width Ft' ;
    rdfs:comment 'Width of the parcel lot measured in feet as recorded by the county assessor or plat map. Used in legal description verification and encroachment analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parcelStatus rdf:type rdf:Property ;
    rdfs:label 'Parcel Status' ;
    rdfs:comment 'Current lifecycle status of the parcel as maintained by the county assessor. Reflects whether the parcel is active, has been merged into another parcel, split, or retired.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parcelType rdf:type rdf:Property ;
    rdfs:label 'Parcel Type' ;
    rdfs:comment 'Classification of the parcel by land use type as determined by the county assessor. Drives underwriting risk segmentation and policy coverage analysis. [ENUM-REF-CANDIDATE: residential|commercial|industrial|agricultural|vacant|mixed_use|exempt — promote' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pin rdf:type rdf:Property ;
    rdfs:label 'Pin' ;
    rdfs:comment 'Parcel Identification Number as assigned by the county recorder or jurisdiction. May differ from APN in jurisdictions that maintain separate assessor and recorder numbering systems.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:range rdf:type rdf:Property ;
    rdfs:label 'Range' ;
    rdfs:comment 'Range designation within the PLSS grid (e.g., R5E). Used with township and section to form the PLSS legal description for rural and unplatted parcels.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectionNumber rdf:type rdf:Property ;
    rdfs:label 'Section Number' ;
    rdfs:comment 'Section number within the Public Land Survey System (PLSS) township/range grid. Used for metes-and-bounds and PLSS legal descriptions in non-platted rural parcels.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:situsAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Situs Address Line1' ;
    rdfs:comment 'Primary street address line of the parcel\'s physical location (situs address) as recorded by the county assessor. Distinct from mailing address; used for property identification.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:situsAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Situs Address Line2' ;
    rdfs:comment 'Secondary street address line for the parcel\'s physical location (unit, suite, building number). Supplements situs_address_line1 for multi-unit or complex properties.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:situsCity rdf:type rdf:Property ;
    rdfs:label 'Situs City' ;
    rdfs:comment 'City or municipality of the parcel\'s physical situs address as recorded by the county assessor. Used for jurisdictional routing and property information reporting.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:situsZipCode rdf:type rdf:Property ;
    rdfs:label 'Situs Zip Code' ;
    rdfs:comment 'Five-digit or ZIP+4 postal code of the parcel\'s physical situs address. Used for property information, tax routing, and geographic analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemParcelKey rdf:type rdf:Property ;
    rdfs:label 'Source System Parcel Key' ;
    rdfs:comment 'Native parcel identifier from the originating Property Information and County Data System (e.g., DataTrace, TitlePoint). Used for lineage tracing and data refresh reconciliation.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Account Number' ;
    rdfs:comment 'Tax account number assigned by the county tax collector or treasurer for billing and collection of real property taxes associated with this parcel.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxDelinquentAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Delinquent Amount' ;
    rdfs:comment 'Total amount of delinquent property taxes, penalties, and interest outstanding on the parcel. Populated when tax_delinquent_flag is true; drives title requirement and curative action.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxDelinquentFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Delinquent Flag' ;
    rdfs:comment 'Indicates whether the parcel has delinquent property taxes as of the last data refresh. A true value triggers a title requirement for tax payoff prior to closing.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxExemptionType rdf:type rdf:Property ;
    rdfs:label 'Tax Exemption Type' ;
    rdfs:comment 'Type of property tax exemption applied to the parcel by the county assessor (e.g., homestead, senior, veteran). Affects tax proration in settlement and underwriting analysis.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:township rdf:type rdf:Property ;
    rdfs:label 'Township' ;
    rdfs:comment 'Township designation within the PLSS grid (e.g., T2N). Used with range and section to form the PLSS legal description for rural and unplatted parcels.' ;
    rdfs:domain ind:Parcel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:zoningCode rdf:type rdf:Property ;
    rdfs:label 'Zoning Code' ;
    rdfs:comment 'Municipal or county zoning designation for the parcel (e.g., R-1, C-2, M-1). Used in title examination to identify zoning encumbrances and compliance with permitted use.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPropertyId rdf:type rdf:Property ;
    rdfs:label 'Prior Property Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the predecessor property record when this property was created from a split, merger, or re-platting event. Preserves chain-of-title continuity and lifecycle history per VREQ-007.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Property .

ind:assessedValue rdf:type rdf:Property ;
    rdfs:label 'Assessed Value' ;
    rdfs:comment 'Most recent county assessor assessed value of the property in USD. Used as a reference data point for underwriting, policy amount reasonableness checks, and tax lien exposure analysis.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assessedValueYear rdf:type rdf:Property ;
    rdfs:label 'Assessed Value Year' ;
    rdfs:comment 'Tax year for which the assessed_value was determined by the county assessor. Ensures temporal accuracy when comparing assessed values across multiple tax years.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:buildingSqft rdf:type rdf:Property ;
    rdfs:label 'Building Sqft' ;
    rdfs:comment 'Total above-grade finished living area or building footprint in square feet as recorded by the county assessor. Supports AVM, underwriting, and policy coverage amount validation.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ccrFlag rdf:type rdf:Property ;
    rdfs:label 'Ccr Flag' ;
    rdfs:comment 'Indicates whether the property is subject to recorded Covenants, Conditions, and Restrictions (CC&Rs). CC&Rs are listed as Schedule B-II exceptions and reviewed for use restriction violations.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:censusTract rdf:type rdf:Property ;
    rdfs:label 'Census Tract' ;
    rdfs:comment 'US Census Bureau census tract identifier for the property location. Used for HMDA/CRA regulatory reporting, fair lending analysis, and geographic risk segmentation.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:city rdf:type rdf:Property ;
    rdfs:label 'City' ;
    rdfs:comment 'City or municipality in which the property is located. Used for jurisdiction determination, recording fee schedules, and regulatory reporting.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryCode rdf:type rdf:Property ;
    rdfs:label 'Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the property location. Defaults to USA for domestic transactions; supports cross-border commercial title operations.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:easementFlag rdf:type rdf:Property ;
    rdfs:label 'Easement Flag' ;
    rdfs:comment 'Indicates whether one or more recorded easements (e.g., utility, access, ROW) affect the property. Triggers Schedule B-II exception listing and potential ALTA endorsement requirements.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:encroachmentFlag rdf:type rdf:Property ;
    rdfs:label 'Encroachment Flag' ;
    rdfs:comment 'Indicates whether a survey or examination has identified an encroachment onto or from the property. May require ALTA survey, curative action, or endorsement to insure over.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:floodZoneDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Flood Zone Determination Date' ;
    rdfs:comment 'Date on which the current FEMA flood zone determination was made for this property. Required for RESPA flood zone disclosure compliance and underwriting file documentation.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hoaAnnualAssessment rdf:type rdf:Property ;
    rdfs:label 'Hoa Annual Assessment' ;
    rdfs:comment 'Annual HOA assessment amount in USD applicable to this property. Used in settlement statement proration and escrow impound calculations where HOA fees are escrowed.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lotSizeSqft rdf:type rdf:Property ;
    rdfs:label 'Lot Size Sqft' ;
    rdfs:comment 'Total land area of the property lot expressed in square feet as recorded by the county assessor. Used in underwriting risk assessment, AVM inputs, and survey comparison.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValue rdf:type rdf:Property ;
    rdfs:label 'Market Value' ;
    rdfs:comment 'Estimated fair market value of the property in USD, sourced from an AVM, appraisal, or broker price opinion. Used for policy amount validation, LTV calculation, and underwriting risk assessment.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValueSource rdf:type rdf:Property ;
    rdfs:label 'Market Value Source' ;
    rdfs:comment 'Source methodology used to derive the market_value (AVM, appraisal, broker price opinion, assessor, sale price, or other). Required for provenance tracking and underwriting file documentation.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:municipalityName rdf:type rdf:Property ;
    rdfs:label 'Municipality Name' ;
    rdfs:comment 'Name of the incorporated municipality, township, or special district governing the property. Relevant for zoning, building permit history, and local transfer tax determination.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfUnits rdf:type rdf:Property ;
    rdfs:label 'Number Of Units' ;
    rdfs:comment 'Count of residential or commercial units within the property structure (e.g., 1 for single-family, 4 for a quadplex). Determines applicable policy form and underwriting guidelines.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyStatus rdf:type rdf:Property ;
    rdfs:label 'Property Status' ;
    rdfs:comment 'Current lifecycle status of the property master record. Tracks whether the property is active in the title plant, has been merged or split into other parcels, condemned, or demolished. Supports chain-of-title continuity.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyType rdf:type rdf:Property ;
    rdfs:label 'Property Type' ;
    rdfs:comment 'Classification of the real-property asset by use category (e.g., residential single-family, commercial, condominium, co-op, vacant land, construction). Drives underwriting rules, policy forms, and endorsement eligibility.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemPropertyRef rdf:type rdf:Property ;
    rdfs:label 'Source System Property Ref' ;
    rdfs:comment 'The native property identifier or file number assigned by the originating source system (e.g., SoftPro property ID, DataTrace property key). Enables back-reference to the system of record for reconciliation.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'Full street address of the property including house number, street name, unit/suite designator. Primary human-readable location identifier used in title commitments, policies, and settlement statements.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxDelinquencyFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Delinquency Flag' ;
    rdfs:comment 'Indicates whether the property has any outstanding delinquent property tax amounts as of the most recent tax search. A True value triggers a title requirement for payoff prior to or at closing.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'Year in which the primary structure on the property was originally constructed, as recorded by the county assessor. Used in underwriting risk scoring and AVM valuation.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zipCode rdf:type rdf:Property ;
    rdfs:label 'Zip Code' ;
    rdfs:comment 'USPS ZIP or ZIP+4 postal code for the property location. Used for geographic risk segmentation, premium rating, and regulatory reporting.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealAdjustedValue rdf:type rdf:Property ;
    rdfs:label 'Appeal Adjusted Value' ;
    rdfs:comment 'Revised total assessed value as determined by the county appeals board following a successful appeal. Replaces total_assessed_value for billing if appeal is resolved.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealFiledDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Date' ;
    rdfs:comment 'Date on which the assessment appeal was filed with the county appeals board. Populated only when appeal_flag is true.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Flag' ;
    rdfs:comment 'Indicates whether a formal appeal of the assessed value has been filed with the county assessment appeals board for this tax year.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution Date' ;
    rdfs:comment 'Date on which the assessment appeal was resolved by the county appeals board. Null if appeal is still pending.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Date on which the county assessor established the assessed value for this tax year. Represents the principal real-world event date for this assessment record.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current lifecycle status of the assessment record: preliminary (not yet certified), certified (official), appealed (under formal appeal), adjusted (post-appeal change), or final.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Classification of the assessment: annual (regular cycle), supplemental (triggered by ownership change or improvement), corrected, escaped (omitted prior year), or special district levy.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifiedDate rdf:type rdf:Property ;
    rdfs:label 'Certified Date' ;
    rdfs:comment 'Date the county assessor officially certified the assessment roll for this parcel and tax year. Marks transition from preliminary to certified status.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Data As Of Date' ;
    rdfs:comment 'Date as of which the assessment data was retrieved or last refreshed from the county assessor or property information system. Indicates data currency for title examination.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:delinquentAmount rdf:type rdf:Property ;
    rdfs:label 'Delinquent Amount' ;
    rdfs:comment 'Outstanding delinquent tax balance including penalties and interest as of the most recent update. A non-zero value triggers a title requirement for payoff at closing.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exemptionAmount rdf:type rdf:Property ;
    rdfs:label 'Exemption Amount' ;
    rdfs:comment 'Dollar amount of assessed value exempted from taxation (e.g., homestead, veteran, senior, or nonprofit exemptions). Reduces the net taxable value.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exemptionType rdf:type rdf:Property ;
    rdfs:label 'Exemption Type' ;
    rdfs:comment 'Classification of the exemption applied to this assessment: homestead, veteran, senior, nonprofit, agricultural, or none. Affects net taxable value and lien exposure.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstInstallmentAmount rdf:type rdf:Property ;
    rdfs:label 'First Installment Amount' ;
    rdfs:comment 'Amount due for the first installment of the annual property tax bill. Relevant for escrow proration and closing disclosure preparation.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'First Installment Due Date' ;
    rdfs:comment 'Due date for the first installment of the property tax bill. Used to determine delinquency status and escrow disbursement timing.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:improvementAssessedValue rdf:type rdf:Property ;
    rdfs:label 'Improvement Assessed Value' ;
    rdfs:comment 'County assessor\'s assessed value allocated to structures and improvements on the parcel, exclusive of land. Supports LTV and coverage analysis.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Amount' ;
    rdfs:comment 'Interest charges accrued on delinquent taxes as assessed by the county tax collector. Included in payoff demand for title clearance.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:landAssessedValue rdf:type rdf:Property ;
    rdfs:label 'Land Assessed Value' ;
    rdfs:comment 'County assessor\'s assessed value allocated to the land component of the parcel, exclusive of improvements. Used in underwriting and title risk analysis.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lienDate rdf:type rdf:Property ;
    rdfs:label 'Lien Date' ;
    rdfs:comment 'Date on which the property tax lien attaches to the parcel by operation of law. Critical for title examination to determine priority of tax liens relative to other encumbrances.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netTaxableValue rdf:type rdf:Property ;
    rdfs:label 'Net Taxable Value' ;
    rdfs:comment 'Assessed value after deducting all applicable exemptions. This is the base upon which the tax levy is calculated by the taxing authority.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Total dollar amount paid against this tax assessment to date. Supports partial payment tracking and delinquency calculation.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidDate rdf:type rdf:Property ;
    rdfs:label 'Paid Date' ;
    rdfs:comment 'Date on which the property tax was paid in full or the most recent installment was paid. Used to confirm tax clearance at closing.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:penaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Penalty Amount' ;
    rdfs:comment 'Penalty charges accrued on delinquent taxes as assessed by the county tax collector. Included in payoff demand for title clearance.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorYearAssessedValue rdf:type rdf:Property ;
    rdfs:label 'Prior Year Assessed Value' ;
    rdfs:comment 'Total assessed value from the immediately preceding tax year. Supports year-over-year valuation trend analysis and appeal basis determination.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redemptionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Redemption Expiry Date' ;
    rdfs:comment 'Date by which the prior owner must redeem the parcel after a tax sale. After this date, the tax deed purchaser obtains clear title. Critical for title examination.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:secondInstallmentAmount rdf:type rdf:Property ;
    rdfs:label 'Second Installment Amount' ;
    rdfs:comment 'Amount due for the second installment of the annual property tax bill. Relevant for escrow proration and closing disclosure preparation.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:secondInstallmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Second Installment Due Date' ;
    rdfs:comment 'Due date for the second installment of the property tax bill. Used to determine delinquency status and escrow disbursement timing.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:specialAssessmentAmount rdf:type rdf:Property ;
    rdfs:label 'Special Assessment Amount' ;
    rdfs:comment 'Annual dollar amount of special assessments levied against the parcel (e.g., Mello-Roos CFD, local improvement district). Disclosed on the closing disclosure.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialAssessmentFlag rdf:type rdf:Property ;
    rdfs:label 'Special Assessment Flag' ;
    rdfs:comment 'Indicates whether a special assessment (e.g., Mello-Roos, improvement district, HOA assessment lien) is levied against the parcel in addition to general property taxes.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxBillNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Bill Number' ;
    rdfs:comment 'Externally assigned tax bill or statement number issued by the county tax collector for this assessment year. Used for payment tracking and lien verification.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxDistrictCode rdf:type rdf:Property ;
    rdfs:label 'Tax District Code' ;
    rdfs:comment 'Code identifying the tax rate area or tax district within the county that governs the composite mill rate applied to this parcel.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'Composite tax rate (mill rate) applied to the net taxable value to compute the annual tax levy. Expressed as a decimal (e.g., 0.012500 = 1.25%). Includes all overlapping taxing districts.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxSaleDate rdf:type rdf:Property ;
    rdfs:label 'Tax Sale Date' ;
    rdfs:comment 'Date of the tax sale at which the parcel was or is scheduled to be sold for delinquent taxes. Populated only when tax_sale_flag is true.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxSaleFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Sale Flag' ;
    rdfs:comment 'Indicates whether the parcel has been sold or is scheduled for sale at a tax sale due to delinquency. A true value is a critical title defect requiring curative action.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxingAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Taxing Authority Name' ;
    rdfs:comment 'Name of the primary taxing authority (county tax collector or treasurer) responsible for billing and collecting property taxes for this parcel.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAssessedValue rdf:type rdf:Property ;
    rdfs:label 'Total Assessed Value' ;
    rdfs:comment 'Sum of land and improvement assessed values as certified by the county assessor for the tax year. Authoritative valuation figure for tax billing and title underwriting.' ;
    rdfs:domain ind:TaxAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededByEvidenceId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Evidence Id' ;
    rdfs:comment 'Reference to the title_evidence record that supersedes this one when evidence is revised or replaced. Enables forward-chaining of evidence revision history.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleEvidence .

ind:defectDescription rdf:type rdf:Property ;
    rdfs:label 'Defect Description' ;
    rdfs:comment 'Free-text description of the title defect, cloud, or chain-of-title break identified in connection with this evidence record. Populated when defect_indicator_flag is true.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defectIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Defect Indicator Flag' ;
    rdfs:comment 'Indicates whether this evidence record has been flagged as containing or contributing to a title defect, cloud on title, or chain-of-title break requiring curative action.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentImageUrl rdf:type rdf:Property ;
    rdfs:label 'Document Image Url' ;
    rdfs:comment 'URL or path to the scanned or electronic image of the source instrument in the document management or imaging system. Supports evidence completeness and provenance verification.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceNumber rdf:type rdf:Property ;
    rdfs:label 'Evidence Number' ;
    rdfs:comment 'Externally-known business identifier assigned to this evidence record by the title production system or document management system. Used for cross-system traceability.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceStatus rdf:type rdf:Property ;
    rdfs:label 'Evidence Status' ;
    rdfs:comment 'Current lifecycle state of the evidence record. Tracks whether the evidence is active, has been superseded by a later instrument, voided, or archived per retention policy.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceSubtype rdf:type rdf:Property ;
    rdfs:label 'Evidence Subtype' ;
    rdfs:comment 'Further classification within the evidence type (e.g., Warranty Deed, Quit Claim Deed, Deed of Trust, Special Warranty Deed, Mechanics Lien, Tax Lien, Judgment Lien). Supports granular chain-of-title analysis.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evidenceType rdf:type rdf:Property ;
    rdfs:label 'Evidence Type' ;
    rdfs:comment 'Classification of the source document or data artifact (e.g., deed, mortgage, lien, easement, plat, survey). Drives chain-of-title assembly and defect identification.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imageAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Image Available Flag' ;
    rdfs:comment 'Indicates whether a scanned or electronic image of the instrument is available in the document management system. Used for evidence completeness scoring and audit readiness.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionName rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Name' ;
    rdfs:comment 'Name of the county, parish, or recording jurisdiction where the instrument is recorded. Complements the FIPS code for human-readable reporting and routing.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notarizedFlag rdf:type rdf:Property ;
    rdfs:label 'Notarized Flag' ;
    rdfs:comment 'Indicates whether the instrument was notarized at execution. Required for recording eligibility in most jurisdictions and for underwriting evidence completeness.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notaryState rdf:type rdf:Property ;
    rdfs:label 'Notary State' ;
    rdfs:comment 'Two-letter US state code of the state in which the instrument was notarized. Used for notarial authority validation and recording eligibility checks.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorInstrumentNumber rdf:type rdf:Property ;
    rdfs:label 'Prior Instrument Number' ;
    rdfs:comment 'Instrument number of the immediately preceding instrument in the chain of title that this evidence links to or satisfies. Used for chain-of-title continuity and break detection.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseSatisfactionFlag rdf:type rdf:Property ;
    rdfs:label 'Release Satisfaction Flag' ;
    rdfs:comment 'Indicates whether this evidence record represents a release, satisfaction, reconveyance, or discharge of a prior encumbrance. True if this instrument clears a prior lien or encumbrance.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retrievedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Retrieved Timestamp' ;
    rdfs:comment 'Timestamp when this evidence record was retrieved from the source system or plant index. Represents the principal business event time for evidence collection. Used for search cycle time metrics.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ronFlag rdf:type rdf:Property ;
    rdfs:label 'Ron Flag' ;
    rdfs:comment 'Indicates whether the instrument was notarized via Remote Online Notarization (RON). Relevant for recording eligibility and underwriting risk assessment in RON-enabled jurisdictions.' ;
    rdfs:domain ind:TitleEvidence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeId rdf:type rdf:Property ;
    rdfs:label 'Fee Id' ;
    rdfs:comment 'Unique surrogate identifier for a recording fee schedule record. Primary key for the fee reference master.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorFeeId rdf:type rdf:Property ;
    rdfs:label 'Prior Fee Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding fee schedule record that this version supersedes. Enables chain-of-version navigation for audit and historical fee reconstruction.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fee .

ind:baseFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Base Fee Amount' ;
    rdfs:comment 'Flat base fee charged per document submission regardless of page count, expressed in USD. Represents the minimum recording charge for the instrument type in this jurisdiction.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeCode rdf:type rdf:Property ;
    rdfs:label 'Fee Code' ;
    rdfs:comment 'Alphanumeric code assigned by the jurisdiction or the title production system (e.g., SoftPro/RamQuest) to uniquely identify this fee line within the county fee schedule.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:considerationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Consideration Threshold Amount' ;
    rdfs:comment 'Minimum consideration amount above which transfer tax or documentary stamp tax applies. Transactions at or below this threshold may be exempt from the tax component.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeDescription rdf:type rdf:Property ;
    rdfs:label 'Fee Description' ;
    rdfs:comment 'Detailed narrative description of the fee, including statutory basis, applicability conditions, and any special instructions from the county recorder.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentaryStampRate rdf:type rdf:Property ;
    rdfs:label 'Documentary Stamp Rate' ;
    rdfs:comment 'Ad valorem rate applied to the consideration or loan amount to compute documentary stamp tax, expressed as a decimal. Common in Florida and other southeastern states.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enactedDate rdf:type rdf:Property ;
    rdfs:label 'Enacted Date' ;
    rdfs:comment 'Date the underlying statute, ordinance, or county resolution authorizing this fee schedule was enacted or signed into law. Supports regulatory audit and provenance.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:erecordingGateway rdf:type rdf:Property ;
    rdfs:label 'Erecording Gateway' ;
    rdfs:comment 'Name of the eRecording gateway or submission channel accepted by this jurisdiction for electronic document submission (e.g., Simplifile, CSC eRecording, direct county portal).' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingSupported rdf:type rdf:Property ;
    rdfs:label 'Erecording Supported' ;
    rdfs:comment 'Indicates whether the recording jurisdiction accepts electronic recording (eRecording) submissions via gateways such as Simplifile or CSC eRecording for this instrument type.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Status' ;
    rdfs:comment 'Lifecycle status of this fee schedule record: active (currently in effect), inactive (no longer applicable), pending (approved but not yet effective), superseded (replaced by a newer version).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeType rdf:type rdf:Property ;
    rdfs:label 'Fee Type' ;
    rdfs:comment 'Classification of the fee component: base_recording (flat per-document fee), per_page (per-page charge), transfer_tax (deed transfer tax), documentary_stamp (documentary stamp tax), mortgage_tax (mortgage recording tax), indexing (indexing/data-entry fee).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:includedPages rdf:type rdf:Property ;
    rdfs:label 'Included Pages' ;
    rdfs:comment 'Number of pages included in the base recording fee before per-page charges apply. A value of zero means per-page fees apply from the first page.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Indexing Fee Amount' ;
    rdfs:comment 'Flat fee charged by the county recorder for indexing the document in the grantor-grantee index, expressed in USD. May be per-name or per-document depending on jurisdiction.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexingFeeBasis rdf:type rdf:Property ;
    rdfs:label 'Indexing Fee Basis' ;
    rdfs:comment 'Basis on which the indexing fee is assessed: per_document (flat per submission), per_name (per grantor or grantee name indexed), or per_parcel (per APN/PIN indexed).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'Date on which the fee schedule was last confirmed accurate against the official county recorder or state revenue department source. Supports data quality monitoring.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxPages rdf:type rdf:Property ;
    rdfs:label 'Max Pages' ;
    rdfs:comment 'Maximum number of pages accepted under this fee schedule tier. Null indicates no page cap. Used to determine if a document requires a higher fee tier or split submission.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mortgageTaxRate rdf:type rdf:Property ;
    rdfs:label 'Mortgage Tax Rate' ;
    rdfs:comment 'Ad valorem rate applied to the loan amount to compute mortgage recording tax, expressed as a decimal. Applicable in states such as New York, Florida, and Alabama.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeName rdf:type rdf:Property ;
    rdfs:label 'Fee Name' ;
    rdfs:comment 'Human-readable name of the fee as published by the recording jurisdiction or as labeled in the title production system (e.g., \'Deed Recording Fee\', \'Per-Page Surcharge\').' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paperRecordingAccepted rdf:type rdf:Property ;
    rdfs:label 'Paper Recording Accepted' ;
    rdfs:comment 'Indicates whether the jurisdiction still accepts paper (physical) document submissions in addition to or instead of eRecording for this instrument type.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perPageFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Per Page Fee Amount' ;
    rdfs:comment 'Additional fee charged per page of the recorded document beyond any included pages, expressed in USD. Used to calculate total recording fee based on page_count.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceReferenceUrl rdf:type rdf:Property ;
    rdfs:label 'Source Reference Url' ;
    rdfs:comment 'URL of the official county recorder or state revenue department web page where this fee schedule is published. Supports provenance and verification of fee amounts.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statutoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Statutory Authority' ;
    rdfs:comment 'Citation of the statute, code section, or county ordinance that authorizes this fee (e.g., \'Cal. Gov. Code § 27361\', \'Fla. Stat. § 28.24\'). Supports compliance and audit.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferTaxExemptionAvailable rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Exemption Available' ;
    rdfs:comment 'Indicates whether statutory exemptions from transfer tax are available in this jurisdiction for qualifying transactions (e.g., inter-spousal transfers, government conveyances).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transferTaxExemptionCodes rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Exemption Codes' ;
    rdfs:comment 'Comma-separated list of jurisdiction-defined exemption codes that may be cited on the deed to claim transfer tax exemption (e.g., \'R11,R12\' for California). Null if no exemptions apply.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferTaxPerUnitAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Per Unit Amount' ;
    rdfs:comment 'Fixed transfer tax amount per unit of consideration (e.g., per $500 or per $1,000 of consideration), used in jurisdictions with tiered or per-unit transfer tax structures.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferTaxRate rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Rate' ;
    rdfs:comment 'Ad valorem rate applied to the consideration amount to compute deed transfer tax, expressed as a decimal (e.g., 0.001100 = 0.11%). Null if transfer tax is not applicable for this fee type.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferTaxUnitBasis rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Unit Basis' ;
    rdfs:comment 'The consideration increment (e.g., 500.00 or 1000.00 USD) used as the denominator for per-unit transfer tax calculations. Null if rate-based rather than per-unit.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapCoveragePeriodId rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Period Id' ;
    rdfs:comment 'Unique surrogate identifier for the GAP coverage period record tracking the interval between closing/last search date and confirmed recording date for a title order.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gapCloseDate rdf:type rdf:Property ;
    rdfs:label 'Gap Close Date' ;
    rdfs:comment 'The date on which the GAP coverage period was formally closed, either by confirmed recording, waiver, or expiration. Distinct from recording_date to accommodate non-recording closures.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Amount' ;
    rdfs:comment 'The dollar amount of title insurance coverage extended during the GAP period. Typically equals the policy amount for the insured instruments pending recording.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapCureMethod rdf:type rdf:Property ;
    rdfs:label 'Gap Cure Method' ;
    rdfs:comment 'The method by which the GAP coverage period was resolved or cured. Recording confirmation is standard; affidavit, indemnity, waiver, or endorsement may be used in exceptional cases.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapCureNotes rdf:type rdf:Property ;
    rdfs:label 'Gap Cure Notes' ;
    rdfs:comment 'Free-text notes documenting the circumstances of GAP cure, including any non-standard resolution methods, underwriting exceptions, or curative actions taken to close the window.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapDurationDays rdf:type rdf:Property ;
    rdfs:label 'Gap Duration Days' ;
    rdfs:comment 'Number of calendar days between gap_start_date and gap_close_date (or current date if still open). Drives the policy-issuance-lag-after-recording and GAP aging metrics.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gapEscalationDate rdf:type rdf:Property ;
    rdfs:label 'Gap Escalation Date' ;
    rdfs:comment 'The date on which the open GAP coverage period was escalated to underwriting or management review due to exceeding the maximum allowed duration or elevated risk classification.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Gap Reference Number' ;
    rdfs:comment 'Externally assigned or internally generated reference number uniquely identifying this GAP coverage period for operational tracking and audit purposes.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Gap Risk Flag' ;
    rdfs:comment 'Underwriting risk classification assigned to this GAP period based on duration, jurisdiction, instrument type, and rejection history. Drives escalation and monitoring workflows.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gapStartDate rdf:type rdf:Property ;
    rdfs:label 'Gap Start Date' ;
    rdfs:comment 'The date on which the GAP coverage window opens. Typically the closing date or the date of the last title search, whichever is later, per ALTA gap coverage standards.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapStatus rdf:type rdf:Property ;
    rdfs:label 'Gap Status' ;
    rdfs:comment 'Current lifecycle status of the GAP coverage window. Open indicates recording not yet confirmed; closed indicates recording confirmed; expired indicates coverage lapsed without recording.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapType rdf:type rdf:Property ;
    rdfs:label 'Gap Type' ;
    rdfs:comment 'Classification of the GAP coverage period by transaction type. Distinguishes standard purchase GAP from construction, HELOC, or refinance GAP windows with different risk profiles.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredInstrumentType rdf:type rdf:Property ;
    rdfs:label 'Insured Instrument Type' ;
    rdfs:comment 'Type of the primary instrument pending recording that is covered during the GAP period. Examples include Warranty Deed (WD), Deed of Trust (DOT), or mortgage.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGapExceeded rdf:type rdf:Property ;
    rdfs:label 'Is Gap Exceeded' ;
    rdfs:comment 'Indicates whether the GAP coverage window has exceeded the maximum allowed duration. True triggers underwriting escalation and potential coverage review per policy guidelines.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jurisdictionFipsCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Fips Code' ;
    rdfs:comment 'Five-digit FIPS code identifying the county or jurisdiction where recording is required. Drives jurisdiction-specific GAP duration rules and recording turnaround benchmarks.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRejectionReason rdf:type rdf:Property ;
    rdfs:label 'Last Rejection Reason' ;
    rdfs:comment 'The most recent reason provided by the county recorder for rejecting the recording submission. Supports root-cause analysis of recording delays that extend the GAP window.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastSearchDate rdf:type rdf:Property ;
    rdfs:label 'Last Search Date' ;
    rdfs:comment 'The date through which the title search was last run prior to closing. Used to establish the beginning of the GAP period when it precedes the closing date.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maxAllowedGapDays rdf:type rdf:Property ;
    rdfs:label 'Max Allowed Gap Days' ;
    rdfs:comment 'The maximum number of calendar days the GAP coverage window is permitted to remain open per underwriting guidelines or state regulatory requirements before escalation is required.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyIssuanceLagDays rdf:type rdf:Property ;
    rdfs:label 'Policy Issuance Lag Days' ;
    rdfs:comment 'Number of calendar days between the confirmed recording_date and the date the title policy was issued. Directly supports the policy-issuance-lag-after-recording metric per VREQ-016.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordVersion rdf:type rdf:Property ;
    rdfs:label 'Record Version' ;
    rdfs:comment 'Monotonically incrementing version number for this GAP coverage period record. Supports optimistic concurrency control and revision history tracking per VREQ-007.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordingConfirmedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Recording Confirmed Timestamp' ;
    rdfs:comment 'Precise timestamp when recording confirmation was received from the eRecording gateway or county recorder, marking the official close of the GAP coverage window.' ;
    rdfs:domain ind:GapCoveragePeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rejectionCount rdf:type rdf:Property ;
    rdfs:label 'Rejection Count' ;
    rdfs:comment 'Number of times the recording submission was rejected by the county recorder prior to acceptance. Feeds the recording rejection and resubmission rate metric per VREQ-016.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:resubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Date' ;
    rdfs:comment 'The date of the most recent resubmission of instruments to the county recorder following a rejection. Null if no rejection has occurred.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gatewayTransactionId rdf:type rdf:Property ;
    rdfs:label 'Gateway Transaction Id' ;
    rdfs:comment 'Unique surrogate identifier for each eRecording gateway transaction exchange record. Primary key for the gateway_transaction entity.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GatewayTransaction .

ind:priorGatewayTransactionId rdf:type rdf:Property ;
    rdfs:label 'Prior Gateway Transaction Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding gateway transaction for the same recording_submission. Enables chain-of-resubmission traceability and lifecycle history preservation.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GatewayTransaction .

ind:acknowledgmentCode rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Code' ;
    rdfs:comment 'Gateway-issued acknowledgment code: ACK indicates the package was received and queued for county review; NACK indicates the package failed gateway pre-screen and was not forwarded.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgmentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Timestamp' ;
    rdfs:comment 'Date and time the eRecording gateway issued an ACK (acknowledgment) or NACK (negative acknowledgment) confirming receipt of the submitted package.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:countyResponseCode rdf:type rdf:Property ;
    rdfs:label 'County Response Code' ;
    rdfs:comment 'Machine-readable response code returned by the county recorder system indicating acceptance, rejection, or return status. Format varies by jurisdiction.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyResponseMessage rdf:type rdf:Property ;
    rdfs:label 'County Response Message' ;
    rdfs:comment 'Free-text message returned by the county recorder describing the acceptance confirmation, rejection reason, or return instructions for this gateway transaction.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countyResponseTimestamp rdf:type rdf:Property ;
    rdfs:label 'County Response Timestamp' ;
    rdfs:comment 'Date and time the county recorder or register of deeds returned an acceptance, rejection, or return response to the gateway for this transaction.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:documentCount rdf:type rdf:Property ;
    rdfs:label 'Document Count' ;
    rdfs:comment 'Number of individual documents included in the gateway submission package for this transaction. A single submission may contain a deed, deed of trust, and other instruments.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentTypeCodes rdf:type rdf:Property ;
    rdfs:label 'Document Type Codes' ;
    rdfs:comment 'Comma-delimited list of document type codes included in the submission package (e.g., WD, DOT, RECONVEYANCE, RELEASE). Supports instrument-level recording analysis.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingMethod rdf:type rdf:Property ;
    rdfs:label 'Erecording Method' ;
    rdfs:comment 'Indicates whether the document was submitted electronically (eRecording), as a paper document, or via a hybrid method. Supports eRecording adoption tracking.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Method' ;
    rdfs:comment 'Method used to remit the recording fee to the county recorder via the gateway (e.g., ACH, credit card, pre-funded gateway account, escrow account draw).' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePaymentReference rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Reference' ;
    rdfs:comment 'Transaction reference number or confirmation code for the recording fee payment submitted with this gateway transaction. Used for fee reconciliation and dispute resolution.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapCoverageDays rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Days' ;
    rdfs:comment 'Number of calendar days elapsed between the closing date and the confirmed recording_date, representing the GAP coverage exposure window. Computed at recording confirmation; null while gap_period_open is true.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gapPeriodOpen rdf:type rdf:Property ;
    rdfs:label 'Gap Period Open' ;
    rdfs:comment 'Indicates whether the GAP coverage period (between closing and confirmed recording) remains open for this transaction. True until recording_date is confirmed and provenance fed back to the policy.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gatewayAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gateway Account Code' ;
    rdfs:comment 'Account identifier assigned by the eRecording gateway vendor to the submitting organization. Used for gateway billing, fee reconciliation, and access control.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gatewayApiVersion rdf:type rdf:Property ;
    rdfs:label 'Gateway Api Version' ;
    rdfs:comment 'Version of the eRecording gateway API used for this transaction. Tracks API compatibility and supports troubleshooting of format or protocol changes.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gatewayPackageCode rdf:type rdf:Property ;
    rdfs:label 'Gateway Package Code' ;
    rdfs:comment 'Externally assigned package identifier issued by the eRecording gateway vendor (e.g., Simplifile package ID, CSC eRecording package number) for this submission bundle.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gatewaySessionCode rdf:type rdf:Property ;
    rdfs:label 'Gateway Session Code' ;
    rdfs:comment 'Session or connection identifier assigned by the eRecording gateway for the API or portal session during which this transaction was submitted. Supports gateway audit and troubleshooting.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gatewayVendor rdf:type rdf:Property ;
    rdfs:label 'Gateway Vendor' ;
    rdfs:comment 'Name of the eRecording gateway vendor used to transmit documents to the county recorder or register of deeds (e.g., Simplifile, CSC eRecording, ePN).' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isExpedited rdf:type rdf:Property ;
    rdfs:label 'Is Expedited' ;
    rdfs:comment 'Indicates whether this gateway transaction was flagged for expedited or priority recording processing at the county recorder. Used to track SLA performance for rush recordings.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:packagePageCount rdf:type rdf:Property ;
    rdfs:label 'Package Page Count' ;
    rdfs:comment 'Total number of pages across all documents in the gateway submission package. Used for recording fee calculation and county intake validation.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:prescreenFailureReason rdf:type rdf:Property ;
    rdfs:label 'Prescreen Failure Reason' ;
    rdfs:comment 'Textual description of the reason the gateway pre-screen failed, as returned by the gateway vendor. Null when prescreen_status is PASSED or BYPASSED.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prescreenStatus rdf:type rdf:Property ;
    rdfs:label 'Prescreen Status' ;
    rdfs:comment 'Result of the gateway vendor pre-screen validation applied before forwarding to the county recorder. FAILED indicates a format, fee, or completeness error caught at the gateway level.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provenanceFedBack rdf:type rdf:Property ;
    rdfs:label 'Provenance Fed Back' ;
    rdfs:comment 'Indicates whether the confirmed recording reference number and recording_date have been fed back to the title policy and title lifecycle records. Supports evidence completeness and provenance tracking.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:provenanceFeedbackTimestamp rdf:type rdf:Property ;
    rdfs:label 'Provenance Feedback Timestamp' ;
    rdfs:comment 'Date and time the recording reference number and recording_date were successfully fed back to the title production system and policy records. Null until provenance_fed_back is true.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Recording Fee Amount' ;
    rdfs:comment 'Total recording fee amount submitted to the county recorder with this gateway transaction, in US dollars. Includes per-page and per-document fees as applicable by jurisdiction.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordingFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Recording Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the recording fee amount. Typically USD for domestic US title transactions.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Recording Reference Number' ;
    rdfs:comment 'Official recording reference number assigned by the county recorder upon acceptance, including book and page or instrument number. Null until county acceptance is confirmed.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Standardized code categorizing the reason for county rejection (e.g., insufficient fee, missing notary, incorrect legal description). Drives rejection root-cause analysis. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Description' ;
    rdfs:comment 'Human-readable description of the county rejection reason, supplementing the rejection_reason_code with narrative detail for curative action and resubmission planning.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resubmissionAttemptNumber rdf:type rdf:Property ;
    rdfs:label 'Resubmission Attempt Number' ;
    rdfs:comment 'Sequential count of resubmission attempts for the parent recording_submission. Value is 0 for the initial submission and increments by 1 for each subsequent resubmission. Supports resubmission rate metrics.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaActualHours rdf:type rdf:Property ;
    rdfs:label 'Sla Actual Hours' ;
    rdfs:comment 'Actual elapsed hours from submission_timestamp to county_response_timestamp for this transaction. Compared against sla_target_hours to assess recording cycle time performance.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'Date and time the document package was transmitted outbound to the eRecording gateway. Principal business event timestamp for this transaction. Used to measure recording cycle time.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:submitterOrganization rdf:type rdf:Property ;
    rdfs:label 'Submitter Organization' ;
    rdfs:comment 'Name of the title company, branch, or independent agent organization that submitted the gateway transaction. Relevant for agency channel recording oversight.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle status of this gateway transaction as reported by the eRecording gateway or county recorder. Drives recording rejection and resubmission rate metrics.' ;
    rdfs:domain ind:GatewayTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingJurisdictionId rdf:type rdf:Property ;
    rdfs:label 'Erecording Jurisdiction Id' ;
    rdfs:comment 'The jurisdiction identifier assigned by the eRecording gateway (e.g., Simplifile county code) used to route electronic submissions. Distinct from the FIPS code; required for gateway API calls.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Jurisdiction .

ind:acceptedDocumentTypes rdf:type rdf:Property ;
    rdfs:label 'Accepted Document Types' ;
    rdfs:comment 'Comma-delimited list of document types accepted for recording by this jurisdiction (e.g., deed, deed_of_trust, mortgage, release, assignment, lien). Used for submission validation and routing.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:avgRecordingTurnaroundDays rdf:type rdf:Property ;
    rdfs:label 'Avg Recording Turnaround Days' ;
    rdfs:comment 'Typical number of business days from submission to acceptance/recording confirmation for this jurisdiction. Used to estimate gap-period duration and policy issuance lag after recording.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baseRecordingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Base Recording Fee Amount' ;
    rdfs:comment 'Standard base recording fee charged by this jurisdiction per document submission, in USD. Used for settlement statement (CD/HUD-1/ALTA) fee estimation and escrow disbursement calculation.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commonRejectionReasons rdf:type rdf:Property ;
    rdfs:label 'Common Rejection Reasons' ;
    rdfs:comment 'Free-text or comma-delimited list of the most frequent rejection reasons observed for this jurisdiction (e.g., missing notary seal, incorrect fee, margin violation). Used for submission quality improvement.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverSheetRequired rdf:type rdf:Property ;
    rdfs:label 'Cover Sheet Required' ;
    rdfs:comment 'Indicates whether this jurisdiction requires a standardized cover sheet (e.g., ALTA or county-specific) to be attached to each document submission. Drives document preparation workflow.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coverSheetTemplateCode rdf:type rdf:Property ;
    rdfs:label 'Cover Sheet Template Code' ;
    rdfs:comment 'Internal code identifying the cover sheet template required by this jurisdiction. Used by the document preparation system to auto-attach the correct cover sheet to recording submissions.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'Source from which this jurisdiction record\'s details were obtained or last refreshed (e.g., Simplifile county list, CSC eRecording, county website, PRIA directory, manual entry). Supports data lineage.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingAccepted rdf:type rdf:Property ;
    rdfs:label 'Erecording Accepted' ;
    rdfs:comment 'Indicates whether this jurisdiction accepts electronic recording (eRecording) submissions via an approved gateway such as Simplifile or CSC eRecording. Drives submission channel routing logic.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Fee Effective Date' ;
    rdfs:comment 'Date on which the current recording fee schedule (base_recording_fee_amount, fee_per_page_amount, transfer_tax_rate) became effective for this jurisdiction. Supports fee schedule versioning.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Fee Expiration Date' ;
    rdfs:comment 'Date on which the current recording fee schedule expires or is superseded. Null indicates the fee schedule is open-ended. Used for fee schedule lifecycle management.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feePerPageAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Per Page Amount' ;
    rdfs:comment 'Additional recording fee charged per page beyond the base fee, in USD. Used to calculate total recording fees for multi-page instruments on the settlement statement.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fontSizeMinimumPt rdf:type rdf:Property ;
    rdfs:label 'Font Size Minimum Pt' ;
    rdfs:comment 'Minimum font size in points required for text in documents submitted to this jurisdiction. Enforced during document preparation to prevent rejection due to illegibility.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gapCoverageApplicable rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Applicable' ;
    rdfs:comment 'Indicates whether gap coverage (GAP) is applicable in this jurisdiction, covering the period between closing and confirmed recording. Drives gap-period risk monitoring and policy issuance lag tracking.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inPersonSubmissionAccepted rdf:type rdf:Property ;
    rdfs:label 'In Person Submission Accepted' ;
    rdfs:comment 'Indicates whether this jurisdiction accepts in-person document submission at the recording office counter. Used for same-day recording needs and courier delivery.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ipenAccepted rdf:type rdf:Property ;
    rdfs:label 'Ipen Accepted' ;
    rdfs:comment 'Indicates whether this jurisdiction accepts documents notarized via In-Person Electronic Notarization (IPEN). Used alongside ron_accepted to determine eligible closing modalities.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mailSubmissionAccepted rdf:type rdf:Property ;
    rdfs:label 'Mail Submission Accepted' ;
    rdfs:comment 'Indicates whether this jurisdiction accepts document submissions via postal mail. Used as a fallback channel when eRecording is unavailable or rejected.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marginRequirementInches rdf:type rdf:Property ;
    rdfs:label 'Margin Requirement Inches' ;
    rdfs:comment 'Minimum margin size in inches required on all pages of documents submitted to this jurisdiction. Non-compliant margins are a common rejection cause; used in document preparation validation.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxPagesBaseFee rdf:type rdf:Property ;
    rdfs:label 'Max Pages Base Fee' ;
    rdfs:comment 'Number of pages included in the base recording fee before per-page charges apply. Used with fee_per_page_amount to compute total recording fees for documents exceeding the base page threshold.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:notarizationRequired rdf:type rdf:Property ;
    rdfs:label 'Notarization Required' ;
    rdfs:comment 'Indicates whether notarization is required for documents submitted to this jurisdiction. Drives closing workflow requirements for notary scheduling and RON/IPEN eligibility.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:officeEmail rdf:type rdf:Property ;
    rdfs:label 'Office Email' ;
    rdfs:comment 'Official email address for the recording office, used for submission inquiries, rejection notices, and correspondence regarding recorded instruments.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeFax rdf:type rdf:Property ;
    rdfs:label 'Office Fax' ;
    rdfs:comment 'Fax number for the recording office, used in jurisdictions that accept fax-based document submission or rejection notice delivery.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeHours rdf:type rdf:Property ;
    rdfs:label 'Office Hours' ;
    rdfs:comment 'Standard business hours of the recording office (e.g., \'Mon-Fri 08:00-17:00 CT\'). Used to determine same-day recording eligibility and courier delivery scheduling.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officePhone rdf:type rdf:Property ;
    rdfs:label 'Office Phone' ;
    rdfs:comment 'Primary telephone number for the recording office, used to resolve rejection inquiries, confirm receipt of mailed documents, and coordinate resubmission.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeStatus rdf:type rdf:Property ;
    rdfs:label 'Office Status' ;
    rdfs:comment 'Current operational status of the recording jurisdiction. Inactive or merged jurisdictions are retained for historical recording reference but blocked from new submission routing.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Office Website Url' ;
    rdfs:comment 'Public website URL for the recording office, providing access to fee schedules, accepted document formats, cover-sheet requirements, and online search portals.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:plantCoverageAvailable rdf:type rdf:Property ;
    rdfs:label 'Plant Coverage Available' ;
    rdfs:comment 'Indicates whether a title plant (DataTrace, TitlePoint, or county plant index) provides automated search coverage for this jurisdiction. Drives search channel selection in the title production system.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plantProviderName rdf:type rdf:Property ;
    rdfs:label 'Plant Provider Name' ;
    rdfs:comment 'Name of the title plant or automated search provider covering this jurisdiction (e.g., DataTrace, TitlePoint). Used for search order routing and vendor management.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingActType rdf:type rdf:Property ;
    rdfs:label 'Recording Act Type' ;
    rdfs:comment 'Type of recording act governing priority of recorded instruments in this jurisdiction: race (first to record wins), notice (subsequent BFP without notice wins), or race_notice (both conditions required). Critical for chain-of-title analysis.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingOfficeName rdf:type rdf:Property ;
    rdfs:label 'Recording Office Name' ;
    rdfs:comment 'Official name of the county recorder, register of deeds, or equivalent recording authority (e.g., \'Travis County Clerk\', \'Cook County Recorder of Deeds\'). Used on cover sheets and submission routing.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingOfficeType rdf:type rdf:Property ;
    rdfs:label 'Recording Office Type' ;
    rdfs:comment 'Classification of the recording authority type, which varies by state (e.g., county_recorder in CA, register_of_deeds in MI, county_clerk in TX). Drives cover-sheet template and fee schedule selection.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingReferenceFormat rdf:type rdf:Property ;
    rdfs:label 'Recording Reference Format' ;
    rdfs:comment 'Format used by this jurisdiction to assign recording references to accepted instruments (e.g., book/page, instrument number, document number). Determines how recording_reference_number is parsed and stored.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionRatePct rdf:type rdf:Property ;
    rdfs:label 'Rejection Rate Pct' ;
    rdfs:comment 'Observed percentage of document submissions rejected by this jurisdiction, based on historical submission data. Used for recording rejection/resubmission rate metrics and operational risk monitoring.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ronAccepted rdf:type rdf:Property ;
    rdfs:label 'Ron Accepted' ;
    rdfs:comment 'Indicates whether this jurisdiction accepts documents notarized via Remote Online Notarization (RON). Drives closing channel eligibility and notarization workflow routing.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sameDayRecordingCutoffTime rdf:type rdf:Property ;
    rdfs:label 'Same Day Recording Cutoff Time' ;
    rdfs:comment 'Local time (HH:MM, 24-hour) by which a document must be submitted to qualify for same-day recording in this jurisdiction. Critical for gap-period management and closing scheduling.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:stateSpecificNotes rdf:type rdf:Property ;
    rdfs:label 'State Specific Notes' ;
    rdfs:comment 'Free-text field capturing jurisdiction-specific recording requirements, exceptions, or procedural notes not captured in structured fields (e.g., special deed tax stamps, unique cover sheet rules, holiday closures).' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferTaxBasis rdf:type rdf:Property ;
    rdfs:label 'Transfer Tax Basis' ;
    rdfs:comment 'Specifies the taxable basis for documentary transfer tax in this jurisdiction (e.g., full consideration, equity only, loan amount). Required for accurate transfer tax calculation on the settlement statement.' ;
    rdfs:domain ind:Jurisdiction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentImageReference rdf:type rdf:Property ;
    rdfs:label 'Document Image Reference' ;
    rdfs:comment 'URI or document management system reference to the scanned or electronic image of the recorded instrument as returned by the county recorder. Supports evidence and provenance requirements per VREQ-007.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentStatus rdf:type rdf:Property ;
    rdfs:label 'Instrument Status' ;
    rdfs:comment 'Current lifecycle status of the recorded instrument as confirmed by the county recorder. Accepted = stamped and indexed; Released = lien released; Superseded = replaced by corrective instrument; Voided = expunged by court order.' ;
    rdfs:domain ind:RecordedInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentSubtype rdf:type rdf:Property ;
    rdfs:label 'Instrument Subtype' ;
    rdfs:comment 'Further classification within the instrument type (e.g., Warranty Deed (WD), Quit Claim Deed (QCD), Special Warranty Deed (SWD), Purchase Money Mortgage (PMM), HELOC, Deed of Trust). Refines title examination and underwriting analysis.' ;
    rdfs:domain ind:RecordedInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalDescription rdf:type rdf:Property ;
    rdfs:label 'Legal Description' ;
    rdfs:comment 'Full legal description of the property as it appears on the recorded instrument (metes and bounds, PLSS township/range/section, or plat/subdivision lot reference). Critical for chain-of-title and Schedule A verification.' ;
    rdfs:domain ind:RecordedInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lienType rdf:type rdf:Property ;
    rdfs:label 'Lien Type' ;
    rdfs:comment 'Classification of the encumbrance type for lien instruments (e.g., mortgage, deed of trust, tax lien, mechanics lien, judgment lien, HOA lien, UCC). Null for conveyance instruments. Supports open-lien and aging-defect metrics.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notaryCommissionExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Notary Commission Expiration Date' ;
    rdfs:comment 'Expiration date of the notary\'s commission at the time of acknowledgment. Used to validate that the notarization was performed within an active commission period, preventing recording defects.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pageCount rdf:type rdf:Property ;
    rdfs:label 'Page Count' ;
    rdfs:comment 'Total number of pages in the recorded instrument as accepted by the county recorder. Used to calculate per-page recording fees and verify fee reconciliation.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordingJurisdictionName rdf:type rdf:Property ;
    rdfs:label 'Recording Jurisdiction Name' ;
    rdfs:comment 'Human-readable name of the county recorder or register of deeds office where the instrument was recorded (e.g., \'Cook County Recorder of Deeds\'). Complements county_fips_code for display and reporting.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorSubmissionRecordingSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Prior Submission Recording Submission Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding submission record for this package, enabling full resubmission chain traceability per VREQ-007.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecordingSubmission .

ind:settlementStatementId rdf:type rdf:Property ;
    rdfs:label 'Settlement Statement Id' ;
    rdfs:comment 'Reference to the settlement statement (CD/HUD-1/ALTA) associated with the closing that produced the documents in this submission.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementStatement .

ind:submittedByPartyId rdf:type rdf:Property ;
    rdfs:label 'Submitted By Party Id' ;
    rdfs:comment 'Reference to the party (closing agent, escrow officer, title agent, or attorney) who submitted the recording package to the county recorder or eRecording gateway.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:erecordingTransactionId rdf:type rdf:Property ;
    rdfs:label 'Erecording Transaction Id' ;
    rdfs:comment 'Unique transaction identifier assigned by the eRecording gateway (Simplifile, CSC) for this submission. Used for gateway-level status tracking and reconciliation.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapOpenDate rdf:type rdf:Property ;
    rdfs:label 'Gap Open Date' ;
    rdfs:comment 'Date the gap coverage period opened, typically the closing/disbursement date. Marks the start of the unrecorded instrument risk window.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRejectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Rejection Date' ;
    rdfs:comment 'Date of the most recent rejection of this submission by the county recorder or eRecording gateway. Used for resubmission SLA tracking.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Last Rejection Reason Code' ;
    rdfs:comment 'Standardized code for the most recent rejection reason returned by the county recorder or eRecording gateway (e.g., MISSING_NOTARY, INCORRECT_FEE, ILLEGIBLE_DOCUMENT).' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Last Rejection Reason Description' ;
    rdfs:comment 'Free-text description of the most recent rejection reason as returned by the county recorder or eRecording gateway. Supports curative action and resubmission workflow.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryDocumentType rdf:type rdf:Property ;
    rdfs:label 'Primary Document Type' ;
    rdfs:comment 'Type of the lead instrument in the submission (e.g., Warranty Deed, Deed of Trust, Mortgage, Quit Claim Deed, Reconveyance, Satisfaction). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionMethod rdf:type rdf:Property ;
    rdfs:label 'Submission Method' ;
    rdfs:comment 'Method by which documents were submitted to the county recorder: eRecording via gateway (Simplifile, CSC), physical counter delivery, mail, or courier.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Number' ;
    rdfs:comment 'Externally-known business identifier assigned to this recording submission, used for tracking with the eRecording gateway and county recorder. Unique per submission attempt.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'Current lifecycle state of the recording submission. Drives recording rejection/resubmission rate and policy-issuance-lag metrics. [ENUM-REF-CANDIDATE: draft|submitted|pending_review|accepted|rejected|resubmitted|recorded|cancelled — promote to reference' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submitterRole rdf:type rdf:Property ;
    rdfs:label 'Submitter Role' ;
    rdfs:comment 'Role of the party who submitted the recording package (e.g., closing agent, escrow officer, title agent, attorney). Supports agency oversight and audit.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRecordingFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Total Recording Fee Amount' ;
    rdfs:comment 'Aggregate recording fees charged by the county recorder for all instruments in this submission, in USD. Feeds settlement statement disbursement and escrow reconciliation.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalTransferTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Total Transfer Tax Amount' ;
    rdfs:comment 'Aggregate transfer tax (documentary stamp tax, deed tax) collected and remitted for all instruments in this submission, in USD.' ;
    rdfs:domain ind:RecordingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rejectionEventId rdf:type rdf:Property ;
    rdfs:label 'Rejection Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each discrete rejection notice event returned by a county recorder or eRecording gateway for a recording submission or individual submission document.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rejectionRecordingSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Rejection Recording Submission Id' ;
    rdfs:comment 'Reference to the parent recording_submission record against which this rejection was issued. Establishes the submission-level context for the rejection event.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecordingSubmission .

ind:rejectionResubmissionSubmissionRecordingSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Rejection Resubmission Submission Recording Submission Id' ;
    rdfs:comment 'Reference to the new recording_submission record created as a result of resubmitting the corrected document after this rejection, enabling chain-of-resubmission tracking.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RecordingSubmission .

ind:submissionDocumentId rdf:type rdf:Property ;
    rdfs:label 'Submission Document Id' ;
    rdfs:comment 'Reference to the specific submission_document within the parent submission that triggered this rejection, when the rejection is document-level rather than submission-level. Null for submission-level rejections.' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SubmissionDocument .

ind:assignedToUser rdf:type rdf:Property ;
    rdfs:label 'Assigned To User' ;
    rdfs:comment 'Username or employee identifier of the recording specialist or closer assigned to resolve this rejection event. Supports workload management and accountability tracking.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correctedFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Corrected Fee Amount' ;
    rdfs:comment 'Corrected recording fee amount (in USD) required by the county recorder to accept the resubmission, when the rejection was due to an incorrect fee. Supports settlement reconciliation.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'The document-level tracking number or identifier assigned by the eRecording gateway or county recorder to the specific document that was rejected, for traceability.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Type of instrument or document that was rejected (e.g., Deed of Trust, Warranty Deed, Quit Claim Deed, Mortgage, Release, Assignment). Relevant for document-level rejections. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erecordingGatewayName rdf:type rdf:Property ;
    rdfs:label 'Erecording Gateway Name' ;
    rdfs:comment 'Name of the eRecording gateway or submission channel through which the document was submitted and rejected (e.g., Simplifile, CSC eRecording, or direct county submission).' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalatedToUnderwriting rdf:type rdf:Property ;
    rdfs:label 'Escalated To Underwriting' ;
    rdfs:comment 'Indicates whether this rejection event was escalated to the underwriting team for risk assessment or exception handling, particularly when the rejection creates a title defect or cloud on title.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalation Timestamp' ;
    rdfs:comment 'Date and time when this rejection event was escalated to underwriting or management for review. Null if not escalated. Supports escalation rate and aging metrics.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:gapPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Gap Period Days' ;
    rdfs:comment 'Number of calendar days of gap coverage exposure attributable to this rejection event, measured from the original submission date to the resubmission or resolution date.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gapPeriodImpacted rdf:type rdf:Property ;
    rdfs:label 'Gap Period Impacted' ;
    rdfs:comment 'Indicates whether this rejection event extended or created a gap coverage period (GAP) between the closing date and confirmed recording date, triggering additional underwriting risk exposure.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Original Submission Date' ;
    rdfs:comment 'Date on which the original recording submission was first submitted to the county recorder or eRecording gateway, prior to this rejection. Used to calculate total recording cycle time.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyIssuanceImpacted rdf:type rdf:Property ;
    rdfs:label 'Policy Issuance Impacted' ;
    rdfs:comment 'Indicates whether this rejection event delayed or blocked the issuance of the owner or lender title policy, contributing to the policy-issuance-lag-after-recording metric.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'Date and time when the rejection notice was received from the county recorder or eRecording gateway. Principal business event timestamp for this rejection event; anchors aging and SLA calculations.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:rejectionCategory rdf:type rdf:Property ;
    rdfs:label 'Rejection Category' ;
    rdfs:comment 'High-level classification of the rejection reason (e.g., legal_description_error, missing_signature, incorrect_fee, formatting_defect, vesting_mismatch, notarization_defect). [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:Recording ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionGrain rdf:type rdf:Property ;
    rdfs:label 'Rejection Grain' ;
    rdfs:comment 'Explicit grain discriminator indicating whether this rejection applies to the entire recording submission (submission-level) or to a single document within the submission (document-level).' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Notice Date' ;
    rdfs:comment 'Calendar date stated on the official rejection notice issued by the county recorder or eRecording gateway. Distinct from received_timestamp; reflects the official notice date for legal purposes.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rejectionNoticeText rdf:type rdf:Property ;
    rdfs:label 'Rejection Notice Text' ;
    rdfs:comment 'Full verbatim text of the rejection notice as received from the county recorder or eRecording gateway, preserved for evidence, provenance, and curative action guidance.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Rejection Sequence Number' ;
    rdfs:comment 'Ordinal sequence of this rejection event within the parent recording submission, enabling tracking of repeated rejections (1st rejection, 2nd rejection, etc.) for resubmission rate metrics.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rejectionSource rdf:type rdf:Property ;
    rdfs:label 'Rejection Source' ;
    rdfs:comment 'The authority or system that issued the rejection notice — county recorder, eRecording gateway (Simplifile/CSC), register of deeds, or state-level recording office.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionStatus rdf:type rdf:Property ;
    rdfs:label 'Rejection Status' ;
    rdfs:comment 'Current workflow state of this rejection event. Drives recording rejection/resubmission rate metrics and aging analysis. [ENUM-REF-CANDIDATE: open|resolved|resubmitted|waived|escalated|closed — promote to reference product]' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionMethod rdf:type rdf:Property ;
    rdfs:label 'Resolution Method' ;
    rdfs:comment 'Method by which this rejection was resolved: resubmission of corrected document, waiver granted by county, withdrawal of submission, escalation to underwriter, or county-initiated override.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Resolution Timestamp' ;
    rdfs:comment 'Date and time when this rejection event was resolved (either by successful resubmission, waiver, or closure). Used to calculate rejection resolution cycle time.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:resubmissionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Resubmission Deadline Date' ;
    rdfs:comment 'Date by which the corrected document must be resubmitted to the county recorder to preserve GAP coverage and avoid policy issuance delays. Critical for gap-period risk management.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemRejectionCode rdf:type rdf:Property ;
    rdfs:label 'Source System Rejection Code' ;
    rdfs:comment 'Native identifier for this rejection event as assigned by the originating system of record (eRecording gateway such as Simplifile or CSC, or title production system). Supports reconciliation.' ;
    rdfs:domain ind:RejectionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Sequence Number' ;
    rdfs:comment 'Ordinal position of this document within the parent recording submission package. Determines recording priority order (e.g., deed records before deed of trust).' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle status of this individual document within the recording workflow. Tracks progression from pending through recorded or rejected/resubmitted states.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSubtype rdf:type rdf:Property ;
    rdfs:label 'Document Subtype' ;
    rdfs:comment 'Further classification within the document type (e.g., Warranty Deed vs. Quit Claim Deed vs. Special Warranty Deed). Supports granular chain-of-title analysis. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTitle rdf:type rdf:Property ;
    rdfs:label 'Document Title' ;
    rdfs:comment 'Human-readable title or caption of the legal instrument as it appears on the face of the document (e.g., \'Warranty Deed\', \'Deed of Trust and Security Agreement\').' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isErecordingEligible rdf:type rdf:Property ;
    rdfs:label 'Is Erecording Eligible' ;
    rdfs:comment 'Indicates whether this document type and jurisdiction combination supports electronic recording (eRecording). False indicates paper recording is required for this document.' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityRecordingFlag rdf:type rdf:Property ;
    rdfs:label 'Priority Recording Flag' ;
    rdfs:comment 'Indicates this document requires expedited or priority recording to protect lien priority or close the gap period within a time-sensitive window (e.g., same-day recording required).' ;
    rdfs:domain ind:SubmissionDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:submissionStatusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Submission Status History Id' ;
    rdfs:comment 'Unique surrogate identifier for each immutable status transition record in the recording submission lifecycle history. Primary key of this append-only event log.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:countyAcknowledgmentCode rdf:type rdf:Property ;
    rdfs:label 'County Acknowledgment Code' ;
    rdfs:comment 'Acknowledgment or confirmation code returned by the county recorder or eRecording gateway for this status event, used for reconciliation and dispute resolution with the recording authority.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysInPriorStatus rdf:type rdf:Property ;
    rdfs:label 'Days In Prior Status' ;
    rdfs:comment 'Number of calendar days the submission spent in status_from before transitioning to status_to. Supports title clearance cycle time and recording aging metrics per VREQ-016.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventSource rdf:type rdf:Property ;
    rdfs:label 'Event Source' ;
    rdfs:comment 'System or actor that triggered this status transition. Identifies whether the change originated from the eRecording gateway, county recorder response, internal workflow, or manual override. Core EVENT_SOURCE_REFERENCE.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCorrectionFlag rdf:type rdf:Property ;
    rdfs:label 'Fee Correction Flag' ;
    rdfs:comment 'Indicates whether a recording fee correction was applied at this status transition, distinguishing fee-related rejections and corrections from other rejection types in root-cause analysis.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gapCoverageActive rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Active' ;
    rdfs:comment 'Indicates whether the GAP coverage period (between closing and confirmed recording) is active at the time of this status event, supporting gap-period risk monitoring.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:initiatedByRole rdf:type rdf:Property ;
    rdfs:label 'Initiated By Role' ;
    rdfs:comment 'Business role of the actor who triggered this status transition, distinguishing automated gateway events from manual escrow officer or recording specialist actions for workflow analysis.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByUser rdf:type rdf:Property ;
    rdfs:label 'Initiated By User' ;
    rdfs:comment 'Username or system account identifier of the person or automated process that triggered this status transition, supporting audit trail and accountability for manual overrides.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isResubmission rdf:type rdf:Property ;
    rdfs:label 'Is Resubmission' ;
    rdfs:comment 'Indicates whether this status transition represents a resubmission following a prior rejection, distinguishing initial submissions from corrective resubmissions in workflow analytics.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTerminalState rdf:type rdf:Property ;
    rdfs:label 'Is Terminal State' ;
    rdfs:comment 'Indicates whether status_to represents a terminal (final) state in the submission lifecycle (RECORDED or CANCELLED), enabling efficient filtering for open versus closed submissions.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Flag' ;
    rdfs:comment 'Indicates whether the time spent in the prior status exceeded the applicable SLA threshold for that status, supporting recording turnaround SLA compliance monitoring.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:slaThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Sla Threshold Days' ;
    rdfs:comment 'The SLA threshold in calendar days applicable to the prior status at the time of this transition, against which days_in_prior_status is evaluated for breach determination.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusFrom rdf:type rdf:Property ;
    rdfs:label 'Status From' ;
    rdfs:comment 'The submission lifecycle status immediately before this transition. Enables full before/after audit trail. [ENUM-REF-CANDIDATE: DRAFT|SUBMITTED|PENDING_REVIEW|REJECTED|CORRECTED|RESUBMITTED|ACCEPTED|RECORDED|CANCELLED — promote to reference product]' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusTo rdf:type rdf:Property ;
    rdfs:label 'Status To' ;
    rdfs:comment 'The submission lifecycle status entered as a result of this transition. Together with status_from, defines the complete state machine arc. [ENUM-REF-CANDIDATE: DRAFT|SUBMITTED|PENDING_REVIEW|REJECTED|CORRECTED|RESUBMITTED|ACCEPTED|RECORDED|CANCELLED —' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionAttemptNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Attempt Number' ;
    rdfs:comment 'Sequential count of the submission attempt associated with this status event (1 = initial, 2 = first resubmission, etc.). Supports recording rejection and resubmission rate metrics.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transitionType rdf:type rdf:Property ;
    rdfs:label 'Transition Type' ;
    rdfs:comment 'Categorical classification of the nature of this status change, distinguishing initial submissions from rejections, corrections, resubmissions, and final recording confirmations for workflow analytics.' ;
    rdfs:domain ind:SubmissionStatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingOrderId rdf:type rdf:Property ;
    rdfs:label 'Closing Order Id' ;
    rdfs:comment 'Reference to the closing event or closing session during which this document was executed or collected. Supports grouping all documents from a single closing table.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClosingOrder .

ind:supersededByClosingDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Closing Document Id' ;
    rdfs:comment 'Reference to the closing_document record that supersedes this version, if applicable. Preserves prior document versions in the lifecycle history per VREQ-007.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClosingDocument .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Externally visible business identifier assigned to this closing document by the title production system (e.g., SoftPro Select / Qualia). Used for tracking and reference in correspondence.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentPageCount rdf:type rdf:Property ;
    rdfs:label 'Document Page Count' ;
    rdfs:comment 'Total number of pages in the closing document. Used for recording fee calculation (many jurisdictions charge per page) and document completeness verification.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentSource rdf:type rdf:Property ;
    rdfs:label 'Document Source' ;
    rdfs:comment 'Originating party or system that provided or prepared this closing document (e.g., lender loan package, title company, borrower-provided identity document).' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentVersion rdf:type rdf:Property ;
    rdfs:label 'Document Version' ;
    rdfs:comment 'Version number of this document, incremented when a document is revised or superseded during the closing lifecycle. Supports lifecycle revision tracking per VREQ-007.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:erecordingStatus rdf:type rdf:Property ;
    rdfs:label 'Erecording Status' ;
    rdfs:comment 'Current status of the document within the eRecording gateway workflow. Drives recording rejection and resubmission rate metrics per VREQ-016.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionMethod rdf:type rdf:Property ;
    rdfs:label 'Execution Method' ;
    rdfs:comment 'Method by which the document was executed: wet signature, Remote Online Notarization (RON), In-Person Electronic Notarization (IPEN), or full eClose. Supports RON/IPEN compliance tracking.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imagingDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Imaging Document Ref' ;
    rdfs:comment 'Identifier or URI referencing the scanned or electronic image of this document in the Document Management and Imaging System. Supports evidence and provenance capture per VREQ-007.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irs1099sFiled rdf:type rdf:Property ;
    rdfs:label 'Irs 1099s Filed' ;
    rdfs:comment 'Indicates whether the 1099-S form has been filed with the IRS for this closing document. Supports tax compliance audit and regulatory reporting.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notarizationDate rdf:type rdf:Property ;
    rdfs:label 'Notarization Date' ;
    rdfs:comment 'Date the document was notarized. Relevant for deeds, affidavits, and other instruments requiring notarial acknowledgment. Supports gap period and recording readiness analysis.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notaryCommissionNumber rdf:type rdf:Property ;
    rdfs:label 'Notary Commission Number' ;
    rdfs:comment 'State-issued commission number of the notary public. Required for recording compliance verification and notary credential audit.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:poaDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Poa Document Ref' ;
    rdfs:comment 'Reference number or identifier for the power of attorney document used in execution, if applicable. Links to the POA instrument in the document management system.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:powerOfAttorneyUsed rdf:type rdf:Property ;
    rdfs:label 'Power Of Attorney Used' ;
    rdfs:comment 'Indicates whether a power of attorney was used in the execution of this document. Triggers additional underwriting review and POA document collection requirements.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordingRejectionReason rdf:type rdf:Property ;
    rdfs:label 'Recording Rejection Reason' ;
    rdfs:comment 'Reason code or description provided by the county recorder when a document submission is rejected. Supports root-cause analysis of recording rejection rates per VREQ-016.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requires1099s rdf:type rdf:Property ;
    rdfs:label 'Requires 1099s' ;
    rdfs:comment 'Indicates whether this document triggers a 1099-S real estate proceeds reporting obligation to the IRS. Drives tax reporting workflow and compliance tracking.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresRecording rdf:type rdf:Property ;
    rdfs:label 'Requires Recording' ;
    rdfs:comment 'Indicates whether this document must be submitted to the county recorder as part of the closing process (e.g., deeds, deeds of trust). Drives recording workflow initiation.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resubmissionCount rdf:type rdf:Property ;
    rdfs:label 'Resubmission Count' ;
    rdfs:comment 'Number of times this document has been resubmitted to the county recorder after an initial rejection. Supports recording rejection and resubmission rate metrics per VREQ-016.' ;
    rdfs:domain ind:ClosingDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:closingEscrowOfficerPartyId rdf:type rdf:Property ;
    rdfs:label 'Closing Escrow Officer Party Id' ;
    rdfs:comment 'Reference to the party record for the escrow officer (EOT) responsible for managing trust funds and coordinating the closing. Supports IOLTA accountability.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:closingLenderPartyId rdf:type rdf:Property ;
    rdfs:label 'Closing Lender Party Id' ;
    rdfs:comment 'Reference to the party record for the lending institution funding this transaction. Drives lender-specific closing instructions, wire instructions, and CPL requirements.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:escrowLedgerId rdf:type rdf:Property ;
    rdfs:label 'Escrow Ledger Id' ;
    rdfs:comment 'Reference to the escrow trust ledger associated with this closing order. Supports receipt-to-disbursement reconciliation and three-way trust accounting.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EscrowLedger .

ind:primaryClosingAgentPartyId rdf:type rdf:Property ;
    rdfs:label 'Primary Closing Agent Party Id' ;
    rdfs:comment 'Reference to the party record for the closing agent or settlement agent conducting the closing. May differ from escrow officer in some jurisdictions.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:actualClosingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Closing Timestamp' ;
    rdfs:comment 'Date and time the closing was actually executed (all documents signed). Distinct from scheduled time; used to measure closing cycle time and SLA adherence.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:allRequirementsCleared rdf:type rdf:Property ;
    rdfs:label 'All Requirements Cleared' ;
    rdfs:comment 'Indicates whether all Schedule B-I title requirements have been satisfied and cleared prior to closing. Key closing-readiness gate control.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cashToCloseAmount rdf:type rdf:Property ;
    rdfs:label 'Cash To Close Amount' ;
    rdfs:comment 'Net amount of funds the buyer must bring to closing after credits, deposits, and loan proceeds. Key figure on the Closing Disclosure under TRID.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdAcknowledgedDate rdf:type rdf:Property ;
    rdfs:label 'Cd Acknowledged Date' ;
    rdfs:comment 'Date the borrower acknowledged receipt of the Closing Disclosure. Starts the mandatory 3-business-day waiting period under TRID.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cdDeliveryDate rdf:type rdf:Property ;
    rdfs:label 'Cd Delivery Date' ;
    rdfs:comment 'Date the Closing Disclosure (CD) was delivered to the borrower. TRID requires delivery at least 3 business days before consummation.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closingLocationType rdf:type rdf:Property ;
    rdfs:label 'Closing Location Type' ;
    rdfs:comment 'Type of physical or virtual location where the closing is conducted. Supports operational capacity planning and RON/IPEN compliance tracking.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingMethod rdf:type rdf:Property ;
    rdfs:label 'Closing Method' ;
    rdfs:comment 'Execution method for document signing at closing. Wet-sign is traditional in-person; RON (Remote Online Notarization) and IPEN (In-Person Electronic Notarization) are electronic alternatives.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingStatus rdf:type rdf:Property ;
    rdfs:label 'Closing Status' ;
    rdfs:comment 'Current lifecycle state of the closing order. Drives closing-readiness dashboards and workflow routing. [ENUM-REF-CANDIDATE: scheduled|in_progress|closed|cancelled|on_hold|pending_funding — promote to reference product]' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplIssued rdf:type rdf:Property ;
    rdfs:label 'Cpl Issued' ;
    rdfs:comment 'Indicates whether a Closing Protection Letter (CPL) was issued for this closing engagement. CPL protects the lender against escrow officer fraud or failure.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disbursementDate rdf:type rdf:Property ;
    rdfs:label 'Disbursement Date' ;
    rdfs:comment 'Date on which escrow funds were disbursed to payees (seller, lienholders, service providers). Must follow funding and recording per state good-funds laws.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earnestMoneyDepositAmount rdf:type rdf:Property ;
    rdfs:label 'Earnest Money Deposit Amount' ;
    rdfs:comment 'Amount of the earnest money deposit (EMD) held in escrow trust. Applied as a credit to the buyer at closing on the settlement statement.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingDate rdf:type rdf:Property ;
    rdfs:label 'Funding Date' ;
    rdfs:comment 'Date on which loan proceeds were disbursed by the lender into the escrow trust account. Critical for disbursement authorization and gap coverage period calculation.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapCoverageEndDate rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage End Date' ;
    rdfs:comment 'End date of the gap coverage period, typically the date of recording. Marks the close of the insured gap window.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gapCoverageStartDate rdf:type rdf:Property ;
    rdfs:label 'Gap Coverage Start Date' ;
    rdfs:comment 'Start date of the gap coverage period, typically the date of closing/execution. Marks the beginning of the insured gap between closing and recording.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lenderClosingInstructionsDate rdf:type rdf:Property ;
    rdfs:label 'Lender Closing Instructions Date' ;
    rdfs:comment 'Date on which lender closing instructions were received by the settlement agent. Used to measure lead time and closing preparation cycle.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lenderClosingInstructionsReceived rdf:type rdf:Property ;
    rdfs:label 'Lender Closing Instructions Received' ;
    rdfs:comment 'Indicates whether lender closing instructions have been received and acknowledged by the settlement agent. A prerequisite for closing readiness.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:positivePaySubmitted rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Submitted' ;
    rdfs:comment 'Indicates whether positive pay files were submitted to the escrow trust bank for check disbursements at closing. Supports ALTA Best Practices Pillar 5 reconciliation controls.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purchasePriceAmount rdf:type rdf:Property ;
    rdfs:label 'Purchase Price Amount' ;
    rdfs:comment 'Gross purchase price of the real property as stated in the purchase agreement. Base amount for premium calculation, transfer tax, and settlement statement preparation.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduledClosingTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Closing Time' ;
    rdfs:comment 'Precise date and time the closing appointment is scheduled, including timezone offset. Supports RON/IPEN session coordination and notary scheduling.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementFormType rdf:type rdf:Property ;
    rdfs:label 'Settlement Form Type' ;
    rdfs:comment 'Type of settlement statement form required for this closing. CD (Closing Disclosure) applies under TRID; HUD-1 applies to pre-TRID or exempt transactions; ALTA Settlement Statement for cash/commercial.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayReconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Three Way Reconciliation Status' ;
    rdfs:comment 'Status of the three-way escrow trust account reconciliation (bank balance vs. book balance vs. trial balance). Required under ALTA Best Practices Pillar 5.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titlePremiumLenderAmount rdf:type rdf:Property ;
    rdfs:label 'Title Premium Lender Amount' ;
    rdfs:comment 'Premium charged for the lender\'s title insurance policy (LTP). Separately tracked from owner premium per VREQ-010 and TRID disclosure requirements.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:titlePremiumOwnerAmount rdf:type rdf:Property ;
    rdfs:label 'Title Premium Owner Amount' ;
    rdfs:comment 'Premium charged for the owner\'s title insurance policy (OTP). Feeds premium remittance calculation and agency split schedule.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalSettlementChargesAmount rdf:type rdf:Property ;
    rdfs:label 'Total Settlement Charges Amount' ;
    rdfs:comment 'Total closing costs and settlement charges as reflected on the settlement statement. Supports TRID tolerance monitoring and consumer disclosure compliance.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wireInstructionsVerified rdf:type rdf:Property ;
    rdfs:label 'Wire Instructions Verified' ;
    rdfs:comment 'Indicates whether wire instructions for disbursement have been independently verified per ALTA Best Practices fraud prevention controls. Actual wire details stored in NPPI Vault.' ;
    rdfs:domain ind:ClosingOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:payeePartyId rdf:type rdf:Property ;
    rdfs:label 'Payee Party Id' ;
    rdfs:comment 'Reference to the party record for the disbursement recipient. Links to the party master for role-based access and NPPI protection of payee details.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:payeePartyRoleId rdf:type rdf:Property ;
    rdfs:label 'Payee Party Role Id' ;
    rdfs:comment 'Foreign key linking to operations.party_role. Business justification: Disbursements require role context (seller proceeds, lender payoff, vendor payment) for settlement statement line-item mapping, 1099-S reporting, and role-specific disbursement rules.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartyRole .

ind:abaRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Aba Routing Number' ;
    rdfs:comment 'Nine-digit American Bankers Association (ABA) routing transit number for the receiving bank. Required for wire and ACH disbursements. Classified confidential as a partial banking identifier.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'Gross amount of the outgoing payment in the transaction currency. Represents the face value of the check or wire before any adjustments. Core monetary field for escrow reconciliation.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:authorizationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Authorization Timestamp' ;
    rdfs:comment 'Date and time the disbursement was formally authorized by the escrow officer or closing manager. Distinct from the issued date; captures the approval event for audit trail.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:authorizedBy rdf:type rdf:Property ;
    rdfs:label 'Authorized By' ;
    rdfs:comment 'Name or identifier of the escrow officer or authorized signatory who approved this disbursement. Required for dual-control and audit compliance under ALTA Best Practices.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Name of the receiving financial institution for wire or ACH disbursements. Non-sensitive identifier used for routing verification and audit trail without exposing account details.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disbursementStatus rdf:type rdf:Property ;
    rdfs:label 'Disbursement Status' ;
    rdfs:comment 'Current lifecycle state of the disbursement: pending (authorized but not yet issued), issued (sent), cleared (confirmed by bank), voided, returned, or stopped. Drives reconciliation and exception workflows.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disbursementType rdf:type rdf:Property ;
    rdfs:label 'Disbursement Type' ;
    rdfs:comment 'Categorical classification of the disbursement purpose (e.g., payoff/reconveyance, seller proceeds, commission, recording fee, title premium, HOA assessment).' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowTrustAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Escrow Trust Account Number' ;
    rdfs:comment 'Identifier of the specific IOLTA or escrow trust bank account from which the disbursement is drawn. Supports multi-account escrow operations and three-way reconciliation.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGapPeriodDisbursement rdf:type rdf:Property ;
    rdfs:label 'Is Gap Period Disbursement' ;
    rdfs:comment 'Indicates whether this disbursement was issued during the gap period between closing and recording. True flags disbursements subject to gap coverage risk per title commitment terms.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuedDate rdf:type rdf:Property ;
    rdfs:label 'Issued Date' ;
    rdfs:comment 'Actual date the check was printed or the wire/ACH was initiated from the escrow trust account. May differ from scheduled date due to funding delays or corrections.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:loanPayoffAmount rdf:type rdf:Property ;
    rdfs:label 'Loan Payoff Amount' ;
    rdfs:comment 'For payoff disbursements, the per-diem-adjusted loan payoff amount as confirmed by the lender\'s payoff statement. Null for non-payoff disbursements. Supports lien clearance verification.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memo rdf:type rdf:Property ;
    rdfs:label 'Memo' ;
    rdfs:comment 'Free-text memo or description printed on the check or included in the wire/ACH addenda record. Describes the purpose of the disbursement for payee and audit reference.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netDisbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Net Disbursement Amount' ;
    rdfs:comment 'Final net amount disbursed after applying any adjustments to the gross disbursement amount. Used for final reconciliation against the escrow ledger balance.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payeeTaxIdRef rdf:type rdf:Property ;
    rdfs:label 'Payee Tax Id Ref' ;
    rdfs:comment 'Vault reference token for the payee\'s Tax Identification Number (TIN/SSN/EIN) stored in the NPPI Vault. Used for IRS 1099-S reporting. Actual TIN is never stored in this table.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positivePayException rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Exception' ;
    rdfs:comment 'Indicates whether the bank flagged this disbursement as a positive-pay exception (mismatch between issued check details and presented check). True triggers manual review.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordingFeeJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Recording Fee Jurisdiction' ;
    rdfs:comment 'County or jurisdiction name to which a recording fee disbursement is directed. Null for non-recording-fee disbursements. Supports recording submission reconciliation.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnDate rdf:type rdf:Property ;
    rdfs:label 'Return Date' ;
    rdfs:comment 'Date a returned check or ACH return was received by the escrow trust account. Null if not returned. Triggers re-issuance workflow and ledger reversal.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnReasonCode rdf:type rdf:Property ;
    rdfs:label 'Return Reason Code' ;
    rdfs:comment 'NACHA ACH return reason code or bank-issued check return reason (e.g., R01 insufficient funds, R02 account closed). Null for non-returned disbursements.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDisbursementDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Disbursement Date' ;
    rdfs:comment 'Date on which the disbursement is authorized and scheduled to be issued from the escrow trust account, typically the closing date or a specified post-closing date.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementStatementLineRef rdf:type rdf:Property ;
    rdfs:label 'Settlement Statement Line Ref' ;
    rdfs:comment 'Line item reference number or code on the settlement statement (CD/HUD-1/ALTA) that authorizes this disbursement (e.g., line 103, line 504). Enables traceability from disbursement to closing disclosure.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemName rdf:type rdf:Property ;
    rdfs:label 'Source System Name' ;
    rdfs:comment 'Name of the operational system of record from which this disbursement record was ingested (e.g., SoftPro, RamQuest, Qualia). Supports multi-system lakehouse lineage.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voidReason rdf:type rdf:Property ;
    rdfs:label 'Void Reason' ;
    rdfs:comment 'Reason code explaining why the disbursement was voided (e.g., stale check, incorrect amount, wire rejected). Required when disbursement_status is voided for audit and reconciliation.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Wire Confirmation Number' ;
    rdfs:comment 'Bank-issued IMAD/OMAD or confirmation reference number for wire transfer disbursements. Null for check or ACH disbursements. Used to confirm wire receipt with receiving bank.' ;
    rdfs:domain ind:Disbursement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:branchCode rdf:type rdf:Property ;
    rdfs:label 'Branch Code' ;
    rdfs:comment 'Reference to the direct branch, centralized lender channel, or independent agent office responsible for this escrow ledger.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:buyerFundsAmount rdf:type rdf:Property ;
    rdfs:label 'Buyer Funds Amount' ;
    rdfs:comment 'Total cash-to-close funds received from the buyer/borrower into escrow, net of any earnest money deposit already credited.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentBalance rdf:type rdf:Property ;
    rdfs:label 'Current Balance' ;
    rdfs:comment 'Current book balance of the escrow trust account ledger (total receipts minus total disbursements). Should equal zero at ledger close.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disbursementAuthorizationMethod rdf:type rdf:Property ;
    rdfs:label 'Disbursement Authorization Method' ;
    rdfs:comment 'Method required to authorize disbursements from this escrow ledger (e.g., dual signature, single signature, electronic approval). Controls disbursement risk.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emdAmount rdf:type rdf:Property ;
    rdfs:label 'Emd Amount' ;
    rdfs:comment 'Dollar amount of the earnest money deposit received into escrow. Key component of the receipt-to-disbursement reconciliation for purchase transactions.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emdReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Emd Received Date' ;
    rdfs:comment 'Date the earnest money deposit was received into the escrow trust account. Key milestone for purchase transactions.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escrowFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Escrow Fee Amount' ;
    rdfs:comment 'Fee charged by the settlement/escrow agent for closing services, collected through escrow and disbursed to the title company.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdbackAmount rdf:type rdf:Property ;
    rdfs:label 'Holdback Amount' ;
    rdfs:comment 'Amount withheld in escrow post-closing for a specific purpose (e.g., repair holdback, construction draw, or curative holdback). Released upon condition satisfaction.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdbackReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Holdback Release Date' ;
    rdfs:comment 'Date on which the escrow holdback amount was or is scheduled to be released upon satisfaction of the holdback condition.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ledgerCloseDate rdf:type rdf:Property ;
    rdfs:label 'Ledger Close Date' ;
    rdfs:comment 'Date the escrow ledger was formally closed after all disbursements, reconciliation, and any holdback releases were completed.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ledgerNumber rdf:type rdf:Property ;
    rdfs:label 'Ledger Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier for this escrow trust account ledger, assigned by the escrow/trust accounting system (e.g., SoftPro Trust Accounting).' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledgerStatus rdf:type rdf:Property ;
    rdfs:label 'Ledger Status' ;
    rdfs:comment 'Current lifecycle state of the escrow ledger. Tracks progression from open through reconciliation and closure. [ENUM-REF-CANDIDATE: open|pending_close|closed|reconciled|voided|suspended — promote to reference product]' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ledgerType rdf:type rdf:Property ;
    rdfs:label 'Ledger Type' ;
    rdfs:comment 'Classification of the escrow ledger by transaction type: purchase, refinance, HELOC, construction, commercial, or home equity. Drives workflow and disbursement rules.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanProceedsAmount rdf:type rdf:Property ;
    rdfs:label 'Loan Proceeds Amount' ;
    rdfs:comment 'Amount of lender loan proceeds wired into the escrow trust account for disbursement at closing.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openingDate rdf:type rdf:Property ;
    rdfs:label 'Opening Date' ;
    rdfs:comment 'Date the escrow trust account ledger was opened and funds were first authorized to be received for this closing.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:outOfBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Out Of Balance Amount' ;
    rdfs:comment 'Dollar variance identified during three-way reconciliation between the bank statement balance, book balance, and individual ledger balances. Zero when balanced.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outOfBalanceReason rdf:type rdf:Property ;
    rdfs:label 'Out Of Balance Reason' ;
    rdfs:comment 'Narrative explanation for any out-of-balance condition identified during three-way reconciliation. Required for audit and remediation tracking.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positivePayEnrolled rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Enrolled' ;
    rdfs:comment 'Indicates whether this escrow trust account is enrolled in the bank\'s positive pay fraud prevention program for check disbursements.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sellerProceedsAmount rdf:type rdf:Property ;
    rdfs:label 'Seller Proceeds Amount' ;
    rdfs:comment 'Net proceeds disbursed to the seller from escrow after payoff of existing liens, prorations, and closing costs.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemLedgerRef rdf:type rdf:Property ;
    rdfs:label 'Source System Ledger Ref' ;
    rdfs:comment 'Native ledger or file number assigned by the escrow/trust accounting system of record (e.g., SoftPro Trust Accounting, RamQuest). Supports SoR traceability.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeWayReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Three Way Reconciliation Date' ;
    rdfs:comment 'Date the most recent three-way reconciliation was performed: bank statement balance vs. book balance vs. individual ledger balances.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:titlePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Title Premium Amount' ;
    rdfs:comment 'Total title insurance premium collected through escrow for owner and/or lender policies, to be remitted to the underwriter per the premium split schedule.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDisbursementsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Disbursements Amount' ;
    rdfs:comment 'Cumulative gross amount of all funds disbursed from the escrow trust account for this ledger, including payoffs, proceeds, and fees.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalReceiptsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Receipts Amount' ;
    rdfs:comment 'Cumulative gross amount of all funds received into the escrow trust account for this ledger, including EMD, loan proceeds, and buyer funds.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trustAccountBankName rdf:type rdf:Property ;
    rdfs:label 'Trust Account Bank Name' ;
    rdfs:comment 'Name of the financial institution holding the IOLTA/escrow trust account for this closing.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trustAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Trust Account Number' ;
    rdfs:comment 'Bank account number of the IOLTA/escrow trust account holding funds for this closing. Restricted per VREQ-012 and GLBA as sensitive financial account data.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trustAccountRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Trust Account Routing Number' ;
    rdfs:comment 'ABA routing/transit number for the IOLTA/escrow trust account bank. Restricted per VREQ-012 as sensitive wire/bank instruction data.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireInstructionVerified rdf:type rdf:Property ;
    rdfs:label 'Wire Instruction Verified' ;
    rdfs:comment 'Indicates whether outgoing wire instructions for this escrow ledger have been independently verified per ALTA Best Practices wire fraud prevention procedures.' ;
    rdfs:domain ind:EscrowLedger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wireVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Wire Verification Method' ;
    rdfs:comment 'Method used to verify outgoing wire instructions (e.g., phone callback to known number, secure portal confirmation, in-person). Supports wire fraud prevention audit.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowReceiptId rdf:type rdf:Property ;
    rdfs:label 'Escrow Receipt Id' ;
    rdfs:comment 'Unique surrogate identifier for each escrow trust account receipt record. Primary key for the escrow_receipt entity.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escrowOfficerPartyId rdf:type rdf:Property ;
    rdfs:label 'Escrow Officer Party Id' ;
    rdfs:comment 'Reference to the escrow officer (EOT) responsible for receiving and posting this receipt. Supports accountability, audit, and closing-readiness tracking.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorReceiptEscrowReceiptId rdf:type rdf:Property ;
    rdfs:label 'Prior Receipt Escrow Receipt Id' ;
    rdfs:comment 'Self-referencing link to the original receipt record when this record represents a correction, repost, or replacement. Preserves lifecycle history per VREQ-007.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EscrowReceipt .

ind:remitterPartyRoleId rdf:type rdf:Property ;
    rdfs:label 'Remitter Party Role Id' ;
    rdfs:comment 'Foreign key linking to operations.party_role. Business justification: Receipts from parties in specific roles (buyer earnest money, borrower down payment, lender loan proceeds) require role context for proper settlement statement allocation, TRID' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PartyRole .

ind:wireInstructionId rdf:type rdf:Property ;
    rdfs:label 'Wire Instruction Id' ;
    rdfs:comment 'Reference to the verified wire instruction record that authorized this incoming wire receipt. Supports fraud prevention and wire verification audit trail.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WireInstruction .

ind:achTraceNumber rdf:type rdf:Property ;
    rdfs:label 'Ach Trace Number' ;
    rdfs:comment 'NACHA-assigned trace number for ACH credit entries received into the trust account. Populated only when funds_type is \'ach\'; supports return and NOC processing.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emdContractDate rdf:type rdf:Property ;
    rdfs:label 'Emd Contract Date' ;
    rdfs:comment 'Date of the purchase contract requiring the EMD. Populated only when emd_flag is true; used to verify timely EMD receipt per contract terms.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emdFlag rdf:type rdf:Property ;
    rdfs:label 'Emd Flag' ;
    rdfs:comment 'Indicates whether this receipt represents an Earnest Money Deposit (EMD). True when receipt_type is \'emd\'; drives EMD tracking and forfeiture/return workflows.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expectedReceiptAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Receipt Amount' ;
    rdfs:comment 'Amount expected to be received per the settlement statement or wire instruction. Compared against receipt_amount to detect shortfalls or overages at closing.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fraudAlertFlag rdf:type rdf:Property ;
    rdfs:label 'Fraud Alert Flag' ;
    rdfs:comment 'Indicates whether a fraud alert has been raised on this receipt (e.g., suspicious wire origin, mismatched remitter, business email compromise indicator).' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fraudAlertNotes rdf:type rdf:Property ;
    rdfs:label 'Fraud Alert Notes' ;
    rdfs:comment 'Free-text description of the fraud alert reason or investigation notes when fraud_alert_flag is true. Supports escrow officer review and SAR filing if required.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundsType rdf:type rdf:Property ;
    rdfs:label 'Funds Type' ;
    rdfs:comment 'Method by which the funds were remitted: wire transfer, personal check, ACH, cashier\'s check, certified check, cash, or electronic transfer. Governs availability and positive-pay rules.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netReceiptAmount rdf:type rdf:Property ;
    rdfs:label 'Net Receipt Amount' ;
    rdfs:comment 'Net funds credited to the escrow ledger after adjustments (receipt_amount + adjustment_amount). Used in three-way reconciliation and ledger balance calculations.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positivePaySubmittedFlag rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Submitted Flag' ;
    rdfs:comment 'Indicates whether this receipt was submitted to the bank\'s positive-pay system for check verification. Applicable when funds_type is check or cashiers_check.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'Date and time the receipt was posted to the escrow ledger in the trust accounting system, which may differ from received_timestamp due to processing lag.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:receiptAmount rdf:type rdf:Property ;
    rdfs:label 'Receipt Amount' ;
    rdfs:comment 'Gross amount of funds received into the escrow trust account for this receipt record. Base monetary fact before any adjustments or reversals.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receiptStatus rdf:type rdf:Property ;
    rdfs:label 'Receipt Status' ;
    rdfs:comment 'Current lifecycle status of the receipt within the trust accounting workflow. Drives reconciliation and positive-pay processing.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptType rdf:type rdf:Property ;
    rdfs:label 'Receipt Type' ;
    rdfs:comment 'Classification of the incoming funds: EMD (Earnest Money Deposit), loan proceeds wire-in, buyer cash-to-close, seller contribution, HOA/payoff overfund return, or other.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remitterAccountToken rdf:type rdf:Property ;
    rdfs:label 'Remitter Account Token' ;
    rdfs:comment 'Tokenized reference to the remitter\'s bank account number stored in the NPPI/Identity Vault. Never stores raw account number; token resolves to vault record per GLBA.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remitterBankName rdf:type rdf:Property ;
    rdfs:label 'Remitter Bank Name' ;
    rdfs:comment 'Name of the financial institution from which the funds originated. Used for fraud screening and wire verification per ALTA Best Practices Pillar 3.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remitterName rdf:type rdf:Property ;
    rdfs:label 'Remitter Name' ;
    rdfs:comment 'Full legal name of the individual or entity remitting the funds. NPPI/PII — stored with restricted classification per GLBA and CFPB requirements.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remitterPartyRole rdf:type rdf:Property ;
    rdfs:label 'Remitter Party Role' ;
    rdfs:comment 'Role of the party remitting the funds at the time of this receipt (buyer, seller, lender, independent agent, HOA, third party). Contextual role per VREQ-006.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'Date on which the receipt reversal was processed. Populated only when reversal_flag is true; used to calculate net trust account balance impact.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicates whether this receipt has been reversed (e.g., returned check, wire recall, ACH return). True triggers a corresponding reversal entry in the escrow ledger.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Reason code for the reversal when reversal_flag is true: NSF, stop payment, wire recall, ACH return, duplicate posting, data entry error, or other. [ENUM-REF-CANDIDATE: nsf|stop_payment|wire_recall|ach_return|duplicate|error|other — 7 candidates stripped' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemReceiptRef rdf:type rdf:Property ;
    rdfs:label 'Source System Receipt Ref' ;
    rdfs:comment 'Native receipt identifier from the originating escrow/trust accounting system (SoftPro Trust Accounting, RamQuest) for lineage and reconciliation back to the system of record.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Wire Reference Number' ;
    rdfs:comment 'Fedwire or CHIPS reference number assigned to the incoming wire transfer. Populated only when funds_type is \'wire\'; used for bank reconciliation and fraud verification.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Wire Verified Flag' ;
    rdfs:comment 'Indicates whether the incoming wire was verified against the authorized wire instruction prior to posting. Required by ALTA Best Practices Pillar 3 fraud controls.' ;
    rdfs:domain ind:EscrowReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Escrow Reconciliation Id' ;
    rdfs:comment 'Unique surrogate identifier for the escrow trust account three-way reconciliation record. Primary key for this entity.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedBySupervisorPartyId rdf:type rdf:Property ;
    rdfs:label 'Approved By Supervisor Party Id' ;
    rdfs:comment 'Reference to the supervising manager or compliance officer who reviewed and approved this reconciliation record per ALTA dual-control requirements.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the escrow trust account being reconciled. IOLTA accounts hold client funds earning interest for legal aid; dedicated trust accounts are file-specific.' ;
    rdfs:domain ind:Settlement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustedBankBalance rdf:type rdf:Property ;
    rdfs:label 'Adjusted Bank Balance' ;
    rdfs:comment 'Bank statement balance plus outstanding deposits minus outstanding checks. Represents the reconciled bank-side balance for comparison to the escrow ledger balance.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalNotes rdf:type rdf:Property ;
    rdfs:label 'Approval Notes' ;
    rdfs:comment 'Free-text notes entered by the approving supervisor at the time of reconciliation approval, documenting any conditions, exceptions, or follow-up actions required.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountNumberMasked rdf:type rdf:Property ;
    rdfs:label 'Bank Account Number Masked' ;
    rdfs:comment 'Masked bank account number showing only the last four digits, used for display and audit purposes. Full account number stored in the Identity and NPPI Vault per GLBA.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Routing Number' ;
    rdfs:comment 'ABA routing transit number of the financial institution holding the escrow trust account. Used to identify the bank for reconciliation and wire verification purposes.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankStatementBalance rdf:type rdf:Property ;
    rdfs:label 'Bank Statement Balance' ;
    rdfs:comment 'Ending balance per the bank statement for the reconciliation period. First leg of the three-way reconciliation. Denominated in USD.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankStatementDate rdf:type rdf:Property ;
    rdfs:label 'Bank Statement Date' ;
    rdfs:comment 'The statement date of the bank statement used as the primary source for the bank-side leg of the three-way reconciliation.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankToLedgerVariance rdf:type rdf:Property ;
    rdfs:label 'Bank To Ledger Variance' ;
    rdfs:comment 'Difference between the adjusted bank balance and the escrow ledger balance. A non-zero value indicates a discrepancy requiring investigation and resolution.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysToReconcile rdf:type rdf:Property ;
    rdfs:label 'Days To Reconcile' ;
    rdfs:comment 'Number of calendar days elapsed between the reconciliation period end date and the date the reconciliation was completed. Supports cycle-time analytics per VREQ-016.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escrowLedgerBalance rdf:type rdf:Property ;
    rdfs:label 'Escrow Ledger Balance' ;
    rdfs:comment 'Total balance per the escrow trust accounting ledger as of the reconciliation period end date. Second leg of the three-way reconciliation.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBalanced rdf:type rdf:Property ;
    rdfs:label 'Is Balanced' ;
    rdfs:comment 'Indicates whether all three legs of the reconciliation (bank, ledger, open files) agree within the defined tolerance threshold. True when fully balanced.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Reportable' ;
    rdfs:comment 'Indicates whether this reconciliation record or its variance must be reported to a state Department of Insurance or other regulatory body per applicable state requirements.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ledgerToFileVariance rdf:type rdf:Property ;
    rdfs:label 'Ledger To File Variance' ;
    rdfs:comment 'Difference between the escrow ledger balance and the aggregate of open file balances. A non-zero value indicates unallocated funds or file balance errors.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openFileBalanceAggregate rdf:type rdf:Property ;
    rdfs:label 'Open File Balance Aggregate' ;
    rdfs:comment 'Sum of all individual open escrow file (order) balances as of the reconciliation period end date. Third leg of the three-way reconciliation per ALTA Best Practices.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openFileCount rdf:type rdf:Property ;
    rdfs:label 'Open File Count' ;
    rdfs:comment 'Number of individual escrow files (title orders) with open balances included in the open file balance aggregate for this reconciliation period.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outstandingCheckCount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Check Count' ;
    rdfs:comment 'Number of individual checks or disbursement items issued but not yet cleared the bank as of the reconciliation date.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outstandingChecksAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Checks Amount' ;
    rdfs:comment 'Total of checks or wire disbursements issued but not yet cleared the bank as of the reconciliation date. Adjusts bank balance downward.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingDepositsAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Deposits Amount' ;
    rdfs:comment 'Total of deposits recorded in the escrow ledger but not yet reflected on the bank statement as of the reconciliation date. Adjusts bank balance upward.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positivePaySubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Positive Pay Submission Date' ;
    rdfs:comment 'Date on which the positive pay file was submitted to the bank for the reconciliation period. Null if positive pay was not submitted.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorPeriodVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Period Variance Amount' ;
    rdfs:comment 'Unresolved variance amount carried forward from the immediately preceding reconciliation period. Non-zero values indicate aging discrepancies requiring escalation.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationNumber rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Number' ;
    rdfs:comment 'Externally-known business identifier for this reconciliation run, typically formatted as RECON-YYYY-MM-NNNNNN. Used for audit trail and operational reference.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Period End Date' ;
    rdfs:comment 'Last calendar date of the reconciliation period covered by this record, typically the last day of the statement month.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Period Start Date' ;
    rdfs:comment 'First calendar date of the reconciliation period covered by this record, typically the first day of the statement month.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationType rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Type' ;
    rdfs:comment 'Classification of the reconciliation procedure performed. Three-way compares bank statement, escrow ledger, and open file balances simultaneously per ALTA Best Practices.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Date' ;
    rdfs:comment 'Date on which this reconciliation or its associated variance was reported to the applicable state regulatory authority. Null if not yet reported or not required.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemReconRef rdf:type rdf:Property ;
    rdfs:label 'Source System Recon Ref' ;
    rdfs:comment 'Native reconciliation record identifier from the originating escrow trust accounting system (SoftPro, RamQuest, etc.) for lineage and cross-system traceability.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:staleCheckAmount rdf:type rdf:Property ;
    rdfs:label 'Stale Check Amount' ;
    rdfs:comment 'Total dollar value of outstanding checks that have exceeded the stale-date threshold and are subject to escheatment or reissuance review.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:staleCheckCount rdf:type rdf:Property ;
    rdfs:label 'Stale Check Count' ;
    rdfs:comment 'Number of outstanding checks that have exceeded the stale-date threshold (typically 90–180 days) and require escheatment review or reissuance action.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:toleranceAmount rdf:type rdf:Property ;
    rdfs:label 'Tolerance Amount' ;
    rdfs:comment 'Maximum allowable variance in USD between reconciliation legs before the record is flagged as out-of-balance. Typically set to $0.00 for trust accounts per ALTA.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceExplanation rdf:type rdf:Property ;
    rdfs:label 'Variance Explanation' ;
    rdfs:comment 'Free-text explanation provided by the escrow officer or supervisor describing the cause of any out-of-balance condition and the planned resolution steps.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceResolutionStatus rdf:type rdf:Property ;
    rdfs:label 'Variance Resolution Status' ;
    rdfs:comment 'Current status of the investigation and resolution effort for any out-of-balance variance identified in this reconciliation record.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceResolvedDate rdf:type rdf:Property ;
    rdfs:label 'Variance Resolved Date' ;
    rdfs:comment 'Date on which the out-of-balance variance was fully resolved and the reconciliation was confirmed as balanced. Null if variance remains open.' ;
    rdfs:domain ind:EscrowReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:premiumChargeId rdf:type rdf:Property ;
    rdfs:label 'Premium Charge Id' ;
    rdfs:comment 'Unique surrogate identifier for a premium charge record within the title insurance settlement system.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:endorsementId rdf:type rdf:Property ;
    rdfs:label 'Endorsement Id' ;
    rdfs:comment 'Reference to the ALTA endorsement for which this charge is assessed. Populated only when charge_type is endorsement fee.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Endorsement .

ind:priorVersionChargePremiumChargeId rdf:type rdf:Property ;
    rdfs:label 'Prior Version Charge Premium Charge Id' ;
    rdfs:comment 'Reference to the previous version of this charge record when a revision or adjustment has been made, preserving the full revision history per VREQ-007.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PremiumCharge .

ind:agentPremiumSplitAmount rdf:type rdf:Property ;
    rdfs:label 'Agent Premium Split Amount' ;
    rdfs:comment 'Dollar amount of the net charge allocated to the independent title agent per the applicable agency agreement premium split schedule.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basePremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Base Premium Amount' ;
    rdfs:comment 'Gross base premium amount calculated from the applicable rate schedule before any adjustments, discounts, or simultaneous issue credits.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdLineItemCode rdf:type rdf:Property ;
    rdfs:label 'Cd Line Item Code' ;
    rdfs:comment 'TRID Closing Disclosure (CD) line item code identifying where this charge appears on the CD form (e.g., Section B, C, or H line reference).' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeDate rdf:type rdf:Property ;
    rdfs:label 'Charge Date' ;
    rdfs:comment 'The business event date on which the premium charge was assessed or calculated, typically the closing date or commitment date.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:chargeNumber rdf:type rdf:Property ;
    rdfs:label 'Charge Number' ;
    rdfs:comment 'Externally visible business identifier for this premium charge record, assigned by the title production system (e.g., SoftPro/RamQuest charge line reference).' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeStatus rdf:type rdf:Property ;
    rdfs:label 'Charge Status' ;
    rdfs:comment 'Current lifecycle status of the premium charge: calculated (computed but not yet assessed), assessed, invoiced, collected, waived, adjusted, or voided. [ENUM-REF-CANDIDATE: calculated|assessed|invoiced|collected|waived|adjusted|voided — 7 candidates' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chargeType rdf:type rdf:Property ;
    rdfs:label 'Charge Type' ;
    rdfs:comment 'Classification of the charge: OTP (Owner\'s Title Policy) premium, LTP (Lender\'s Title Policy) premium, endorsement fee, search fee, exam fee, or settlement fee.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectedDate rdf:type rdf:Property ;
    rdfs:label 'Collected Date' ;
    rdfs:comment 'Date on which the premium charge was collected from the responsible party at or after closing. Null if not yet collected.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endorsementTypeCode rdf:type rdf:Property ;
    rdfs:label 'Endorsement Type Code' ;
    rdfs:comment 'ALTA endorsement form number or code (e.g., ALTA 9, ALTA 8.1, ALTA 22) when charge_type is endorsement_fee. Null for non-endorsement charges.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hud1LineNumber rdf:type rdf:Property ;
    rdfs:label 'Hud1 Line Number' ;
    rdfs:comment 'HUD-1 Settlement Statement line number where this charge appears, applicable for transactions governed by legacy RESPA HUD-1 disclosure requirements.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Liability Amount' ;
    rdfs:comment 'The insured amount or coverage liability used as the basis for premium calculation (e.g., purchase price for OTP, loan amount for LTP).' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Net Charge Amount' ;
    rdfs:comment 'Final assessed charge amount after all adjustments (base_premium_amount + adjustment_amount). This is the amount appearing on the settlement statement.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paidByParty rdf:type rdf:Property ;
    rdfs:label 'Paid By Party' ;
    rdfs:comment 'Identifies which transaction party is responsible for paying this charge: buyer, seller, lender, or split between parties.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorPolicyAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Amount' ;
    rdfs:comment 'Liability amount of the prior existing title policy used as the basis for calculating a reissue credit. Populated only when reissue_credit_flag is true.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPolicyDate rdf:type rdf:Property ;
    rdfs:label 'Prior Policy Date' ;
    rdfs:comment 'Effective date of the prior title policy used for reissue credit eligibility determination. Must fall within the state-mandated lookback period.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratePerThousand rdf:type rdf:Property ;
    rdfs:label 'Rate Per Thousand' ;
    rdfs:comment 'The filed premium rate expressed as a dollar amount per $1,000 of liability amount, sourced from the applicable state-filed rate schedule.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Code' ;
    rdfs:comment 'Code identifying the filed rate schedule or rate table used to calculate the base premium, as maintained in the underwriting rate management system.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueCreditFlag rdf:type rdf:Property ;
    rdfs:label 'Reissue Credit Flag' ;
    rdfs:comment 'Indicates whether a reissue credit was applied to this charge based on a prior existing title policy covering the same property.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'Date on which the premium charge is recognized as earned revenue in the general ledger, per applicable accounting standards.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:simultaneousIssueFlag rdf:type rdf:Property ;
    rdfs:label 'Simultaneous Issue Flag' ;
    rdfs:comment 'Indicates whether this charge benefits from a simultaneous issue discount, applicable when both an OTP and LTP are issued for the same transaction at the same time.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemChargeRef rdf:type rdf:Property ;
    rdfs:label 'Source System Charge Ref' ;
    rdfs:comment 'Native charge or fee line identifier from the originating title production system (SoftPro Select, RamQuest Horizon, or Qualia) for traceability.' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitPercentage rdf:type rdf:Property ;
    rdfs:label 'Split Percentage' ;
    rdfs:comment 'Agent\'s percentage share of the net premium charge as defined in the premium split schedule. Expressed as a percentage (e.g., 70.00 for 70%).' ;
    rdfs:domain ind:PremiumCharge ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwriterPremiumSplitAmount rdf:type rdf:Property ;
    rdfs:label 'Underwriter Premium Split Amount' ;
    rdfs:comment 'Dollar amount of the net charge retained by or remitted to the underwriter per the applicable agency agreement premium split schedule.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Business justification for waiving or reducing this charge. Populated only when charge_status is waived or adjustment_amount is negative.' ;
    rdfs:domain ind:TitleInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorStatementSettlementStatementId rdf:type rdf:Property ;
    rdfs:label 'Prior Statement Settlement Statement Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding version of this settlement statement. Enables full revision chain traversal and prior classification preservation per VREQ-007.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementStatement .

ind:cashToClose rdf:type rdf:Property ;
    rdfs:label 'Cash To Close' ;
    rdfs:comment 'Net cash amount the borrower must bring to closing (or receive back) after all credits and debits are applied. Key closing-readiness metric. Positive = cash due from borrower; negative = cash back to borrower.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnestMoneyDeposit rdf:type rdf:Property ;
    rdfs:label 'Earnest Money Deposit' ;
    rdfs:comment 'Earnest money deposit amount credited to the borrower/buyer on the settlement statement. Reflects funds held in escrow prior to closing and applied at settlement.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossAmountDueBorrower rdf:type rdf:Property ;
    rdfs:label 'Gross Amount Due Borrower' ;
    rdfs:comment 'Total gross amount due from the borrower at closing before credits and adjustments. Corresponds to Section 100 of HUD-1 or borrower-side summary on CD/ALTA statement.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hoaDuesProrated rdf:type rdf:Property ;
    rdfs:label 'Hoa Dues Prorated' ;
    rdfs:comment 'Prorated HOA dues credited or debited between buyer and seller at closing. Reflects the HOA assessment allocation through the closing date.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irs1099sRequired rdf:type rdf:Property ;
    rdfs:label 'Irs 1099s Required' ;
    rdfs:comment 'Indicates whether IRS Form 1099-S reporting is required for this real estate transaction. Driven by sales price threshold and seller exemption status.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderTitlePremium rdf:type rdf:Property ;
    rdfs:label 'Lender Title Premium' ;
    rdfs:comment 'Premium charged for the lender\'s title insurance policy (LTP) as shown on the settlement statement. Supports premium revenue recognition and owner-vs-lender policy coverage metrics per VREQ-016.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownerTitlePremium rdf:type rdf:Property ;
    rdfs:label 'Owner Title Premium' ;
    rdfs:comment 'Premium charged for the owner\'s title insurance policy (OTP) as shown on the settlement statement. Supports premium revenue recognition and owner-vs-lender policy coverage metrics per VREQ-016.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payoffFirstMortgage rdf:type rdf:Property ;
    rdfs:label 'Payoff First Mortgage' ;
    rdfs:comment 'Payoff amount for the existing first mortgage or deed of trust (DOT) being satisfied at closing. Includes principal, accrued interest, and per diem through disbursement date.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payoffSecondMortgage rdf:type rdf:Property ;
    rdfs:label 'Payoff Second Mortgage' ;
    rdfs:comment 'Payoff amount for any existing second mortgage or home equity line of credit (HELOC) being satisfied at closing. Null if no second lien exists.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proratedTaxes rdf:type rdf:Property ;
    rdfs:label 'Prorated Taxes' ;
    rdfs:comment 'Property tax proration amount credited or debited between buyer and seller based on the closing date within the tax year. Disclosed on the settlement statement.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realEstateCommission rdf:type rdf:Property ;
    rdfs:label 'Real Estate Commission' ;
    rdfs:comment 'Total real estate brokerage commission paid at closing, typically from seller proceeds. Disclosed on the settlement statement. Null for refinance transactions.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordingFees rdf:type rdf:Property ;
    rdfs:label 'Recording Fees' ;
    rdfs:comment 'Total fees paid to the county recorder for recording the deed, mortgage/deed of trust, and any other instruments at closing. Disclosed as a zero-tolerance item under TRID.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rescissionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Rescission Expiry Date' ;
    rdfs:comment 'Date on which the borrower\'s right of rescission expires for refinance transactions under TILA. Disbursement is held until this date. Null for purchase transactions.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:salesPrice rdf:type rdf:Property ;
    rdfs:label 'Sales Price' ;
    rdfs:comment 'Contract purchase price of the real property as stated on the settlement statement. Applicable to purchase transactions. Null for refinance. Reported on Schedule A and IRS Form 1099-S.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellerNetProceeds rdf:type rdf:Property ;
    rdfs:label 'Seller Net Proceeds' ;
    rdfs:comment 'Net amount disbursed to the seller after payoff of existing liens, commissions, and closing costs. Applicable to purchase transactions. Null for refinance.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAgentName rdf:type rdf:Property ;
    rdfs:label 'Settlement Agent Name' ;
    rdfs:comment 'Name of the settlement agent or escrow officer responsible for conducting the closing and preparing the settlement statement. Disclosed on the CD/HUD-1/ALTA statement.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementFee rdf:type rdf:Property ;
    rdfs:label 'Settlement Fee' ;
    rdfs:comment 'Fee charged by the settlement agent or escrow officer for conducting the closing. Disclosed on the settlement statement as a title service fee under TRID Section B or C.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:statementFormType rdf:type rdf:Property ;
    rdfs:label 'Statement Form Type' ;
    rdfs:comment 'Regulatory form type used for this settlement statement. CD = Closing Disclosure (TRID/TILA-RESPA), HUD-1 = legacy RESPA settlement statement, ALTA = ALTA Settlement Statement for non-TRID transactions.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementNumber rdf:type rdf:Property ;
    rdfs:label 'Statement Number' ;
    rdfs:comment 'Externally visible alphanumeric identifier assigned to this settlement statement by the title production or escrow system (e.g., SoftPro file number suffix). Used for audit and regulatory reference.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementStatus rdf:type rdf:Property ;
    rdfs:label 'Statement Status' ;
    rdfs:comment 'Current lifecycle status of the settlement statement. Tracks progression from draft preparation through final execution and any post-closing void or correction.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeDayWaitingPeriodMet rdf:type rdf:Property ;
    rdfs:label 'Three Day Waiting Period Met' ;
    rdfs:comment 'Indicates whether the mandatory three-business-day waiting period between CD delivery and consummation was satisfied under TRID. Critical compliance flag for CFPB examination.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:toleranceCureAmount rdf:type rdf:Property ;
    rdfs:label 'Tolerance Cure Amount' ;
    rdfs:comment 'Dollar amount of any tolerance cure credit applied to the borrower due to TRID fee tolerance violations. Disclosed on the final CD. Zero if no cure was required.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalClosingCostsBorrower rdf:type rdf:Property ;
    rdfs:label 'Total Closing Costs Borrower' ;
    rdfs:comment 'Total closing costs charged to the borrower as summarized on the settlement statement. Includes origination charges, title fees, recording fees, prepaid items, and escrow reserves.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalClosingCostsSeller rdf:type rdf:Property ;
    rdfs:label 'Total Closing Costs Seller' ;
    rdfs:comment 'Total closing costs charged to the seller as summarized on the settlement statement. Includes real estate commissions, seller-paid title fees, and payoff amounts. Null for refinance.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCreditsBorrower rdf:type rdf:Property ;
    rdfs:label 'Total Credits Borrower' ;
    rdfs:comment 'Total credits applied to the borrower\'s side of the settlement statement including earnest money deposit (EMD), seller credits, and loan proceeds. Corresponds to Section 200 of HUD-1.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wireAmountBorrower rdf:type rdf:Property ;
    rdfs:label 'Wire Amount Borrower' ;
    rdfs:comment 'Dollar amount of the wire transfer received from or sent to the borrower at closing. Sensitive financial data per VREQ-012. Reconciled against escrow ledger receipts.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wireAmountLender rdf:type rdf:Property ;
    rdfs:label 'Wire Amount Lender' ;
    rdfs:comment 'Dollar amount of the loan proceeds wire received from the lender at closing. Sensitive financial data per VREQ-012. Reconciled against escrow ledger receipts.' ;
    rdfs:domain ind:SettlementStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorInstructionWireInstructionId rdf:type rdf:Property ;
    rdfs:label 'Prior Instruction Wire Instruction Id' ;
    rdfs:comment 'Self-referencing identifier of the previous wire instruction record that this record supersedes. Preserves the revision history and chain of custody for audit purposes.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WireInstruction .

ind:abaRoutingNumberToken rdf:type rdf:Property ;
    rdfs:label 'Aba Routing Number Token' ;
    rdfs:comment 'Tokenized or encrypted ABA/routing transit number (9-digit) of the receiving bank. Stored as a token referencing the NPPI Vault; never stored in plaintext per GLBA and ALTA Best Practices Pillar 3.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountNumberToken rdf:type rdf:Property ;
    rdfs:label 'Account Number Token' ;
    rdfs:comment 'Tokenized or encrypted beneficiary bank account number. Stored as a reference token to the NPPI Vault; never stored in plaintext per GLBA and ALTA Best Practices Pillar 3.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time when the wire instruction was formally approved for disbursement by an authorized escrow officer or supervisor.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:bankAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Bank Address Line1' ;
    rdfs:comment 'Primary street address of the receiving bank branch. Required for domestic wire instructions and correspondent bank identification.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankCity rdf:type rdf:Property ;
    rdfs:label 'Bank City' ;
    rdfs:comment 'City of the receiving bank branch used for wire routing verification and correspondent bank identification.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankCountryCode rdf:type rdf:Property ;
    rdfs:label 'Bank Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the receiving bank. Distinguishes domestic (USA) from international wire instructions.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankState rdf:type rdf:Property ;
    rdfs:label 'Bank State' ;
    rdfs:comment 'Two-letter US state code of the receiving bank branch per USPS/FIPS standards.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryName rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Name' ;
    rdfs:comment 'Full legal name of the wire beneficiary as it must appear on the outgoing wire transfer. Required for bank matching and fraud prevention.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReason rdf:type rdf:Property ;
    rdfs:label 'Change Reason' ;
    rdfs:comment 'Business reason documented for changing or replacing a previously verified wire instruction (e.g., bank account change, payoff amount update). Required when is_change_request is true.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'Channel through which the wire instruction was received from the party. Secure portal and encrypted email are preferred per ALTA Best Practices Pillar 2.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedWireAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Wire Amount' ;
    rdfs:comment 'Expected gross USD amount to be wired per the settlement statement or payoff demand. Used for pre-wire verification and positive-pay controls.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:furtherCreditAccountToken rdf:type rdf:Property ;
    rdfs:label 'Further Credit Account Token' ;
    rdfs:comment 'Tokenized further-credit (FFC) sub-account number at the receiving bank. Stored as a token referencing the NPPI Vault.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:furtherCreditName rdf:type rdf:Property ;
    rdfs:label 'Further Credit Name' ;
    rdfs:comment 'Name on the further-credit (FFC) sub-account when the wire must be credited to a sub-account at the receiving bank (common for lender payoffs and HOA accounts).' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionNumber rdf:type rdf:Property ;
    rdfs:label 'Instruction Number' ;
    rdfs:comment 'Externally visible reference number assigned to this wire instruction record by the escrow or trust accounting system (e.g., SoftPro Trust Accounting).' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionStatus rdf:type rdf:Property ;
    rdfs:label 'Instruction Status' ;
    rdfs:comment 'Current lifecycle state of the wire instruction. [ENUM-REF-CANDIDATE: draft|pending_verification|verified|approved|used|cancelled|expired — promote to reference product]' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermediaryAbaToken rdf:type rdf:Property ;
    rdfs:label 'Intermediary Aba Token' ;
    rdfs:comment 'Tokenized ABA routing number of the intermediary (correspondent) bank. Stored as a token referencing the NPPI Vault.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermediaryBankName rdf:type rdf:Property ;
    rdfs:label 'Intermediary Bank Name' ;
    rdfs:comment 'Name of the intermediary (correspondent) bank required when the receiving bank cannot accept wires directly. Used for complex domestic or international routing.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isChangeRequest rdf:type rdf:Property ;
    rdfs:label 'Is Change Request' ;
    rdfs:comment 'Indicates whether this wire instruction record represents a change or update to a previously verified instruction. Change requests require re-verification per ALTA Best Practices Pillar 2 fraud controls.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Source Document Ref' ;
    rdfs:comment 'Reference identifier or document management system link to the original wire instruction document (e.g., signed wire authorization form, secure portal submission record) stored in the Document Management and Imaging System.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swiftBicCode rdf:type rdf:Property ;
    rdfs:label 'Swift Bic Code' ;
    rdfs:comment 'Society for Worldwide Interbank Financial Telecommunication (SWIFT) Bank Identifier Code (BIC) for international wire transfers. Required when bank_country_code is not USA.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Verification Timestamp' ;
    rdfs:comment 'Date and time when the wire instruction was independently verified by the escrow officer per ALTA Best Practices Pillar 2 callback or secure-channel protocol.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:wirePurpose rdf:type rdf:Property ;
    rdfs:label 'Wire Purpose' ;
    rdfs:comment 'Business purpose of the wire disbursement as it relates to the closing (e.g., seller proceeds, mortgage payoff, EMD). [ENUM-REF-CANDIDATE: seller_proceeds|payoff|earnest_money|commission|tax_proration|hoa_dues|other — promote to reference product]' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireReferenceMemo rdf:type rdf:Property ;
    rdfs:label 'Wire Reference Memo' ;
    rdfs:comment 'Free-text reference or memo line to be included on the outgoing wire (e.g., loan number, file number, property address). Assists receiving bank in applying the funds.' ;
    rdfs:domain ind:WireInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedPartyId rdf:type rdf:Property ;
    rdfs:label 'Assigned Party Id' ;
    rdfs:comment 'Reference to the party (examiner, curative specialist, attorney, or vendor) responsible for executing this curative action.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:decisionId rdf:type rdf:Property ;
    rdfs:label 'Decision Id' ;
    rdfs:comment 'Foreign key linking to underwriting.underwriting_decision. Business justification: Curative actions may be triggered by or result from formal underwriting decisions.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Decision .

ind:priorActionId rdf:type rdf:Property ;
    rdfs:label 'Prior Action Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the previous curative action attempt for the same requirement or finding. Preserves lifecycle history and re-attempt lineage per VREQ-007.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CurativeAction .

ind:actionSubtype rdf:type rdf:Property ;
    rdfs:label 'Action Subtype' ;
    rdfs:comment 'Further classification within the action type (e.g., within lien_release: tax_lien_release, mechanics_lien_release, judgment_lien_release, HOA_lien_release). Supports granular curative aging analysis.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attemptNumber rdf:type rdf:Property ;
    rdfs:label 'Attempt Number' ;
    rdfs:comment 'Sequential count of attempts made to complete this curative action. Values greater than 1 indicate re-attempts after prior failure or rejection. Supports curative effectiveness metrics.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:curativeCost rdf:type rdf:Property ;
    rdfs:label 'Curative Cost' ;
    rdfs:comment 'Actual cost incurred to complete this curative action (e.g., recording fees, attorney fees, court filing fees, survey costs). USD. Used for curative cost analysis.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defectCategory rdf:type rdf:Property ;
    rdfs:label 'Defect Category' ;
    rdfs:comment 'Category of the underlying title defect or cloud being cured (e.g., lien, chain-of-title break, vesting defect, gap). Supports unresolved defect and lien metrics.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureReason rdf:type rdf:Property ;
    rdfs:label 'Failure Reason' ;
    rdfs:comment 'Reason this curative action attempt failed or was rejected, triggering a re-attempt. Null if action was completed successfully. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isChainOfTitleBreak rdf:type rdf:Property ;
    rdfs:label 'Is Chain Of Title Break' ;
    rdfs:comment 'Indicates whether this curative action is addressing a break in the chain of title (COT). Supports chain-of-title break metrics and evidence completeness reporting.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGapCure rdf:type rdf:Property ;
    rdfs:label 'Is Gap Cure' ;
    rdfs:comment 'Indicates whether this curative action specifically addresses a gap period coverage issue between the effective date of the commitment and the recording of the insured instrument.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMarketableTitleImpairment rdf:type rdf:Property ;
    rdfs:label 'Is Marketable Title Impairment' ;
    rdfs:comment 'Indicates whether the underlying defect being cured rises to the level of a marketable title impairment, requiring resolution before the transaction can close.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:requiresUwApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Uw Approval' ;
    rdfs:comment 'Indicates whether this curative action requires formal underwriter approval before the requirement can be marked satisfied. Drives UWR referral rate metrics.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsiblePartyType rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Type' ;
    rdfs:comment 'Classification of the party responsible for fulfilling this curative action (e.g., seller must provide release, buyer must provide affidavit, title company handles recording).' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemActionCode rdf:type rdf:Property ;
    rdfs:label 'Source System Action Code' ;
    rdfs:comment 'Native identifier for this curative action record in the originating title production system (SoftPro, RamQuest, Qualia). Enables reconciliation with the system of record.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the external vendor, attorney, or service provider engaged to perform or facilitate this curative action (e.g., lien release service, probate attorney).' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Vendor Reference Number' ;
    rdfs:comment 'External reference or tracking number assigned by the vendor or third-party service provider for this curative action. Used for follow-up and reconciliation.' ;
    rdfs:domain ind:CurativeAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByEndorsementId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Endorsement Id' ;
    rdfs:comment 'Reference to the replacement endorsement record when this endorsement has been superseded by a revised version. Preserves revision lineage per VREQ-007. Null if not superseded.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Endorsement .

ind:additionalPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Additional Premium Amount' ;
    rdfs:comment 'Additional premium charged for this endorsement, expressed in USD. Added to the base policy premium. Used for premium revenue recognition and agency remittance calculations.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:altaFormNumber rdf:type rdf:Property ;
    rdfs:label 'Alta Form Number' ;
    rdfs:comment 'Standardized ALTA endorsement form number identifying the endorsement type (e.g., ALTA 9, ALTA 8.1, ALTA 22, ALTA 28, ALTA 3.1). Drives coverage scope and premium calculation.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageCategory rdf:type rdf:Property ;
    rdfs:label 'Coverage Category' ;
    rdfs:comment 'Broad category of risk coverage provided by the endorsement. [ENUM-REF-CANDIDATE: access|environmental|survey|zoning|tax|mechanics_lien|usury|variable_rate|other — promote to reference product]' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementDescription rdf:type rdf:Property ;
    rdfs:label 'Endorsement Description' ;
    rdfs:comment 'Full narrative description of the coverage provided by this endorsement, including any specific conditions, limitations, or property-specific language added by the underwriter.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electronicDelivery rdf:type rdf:Property ;
    rdfs:label 'Electronic Delivery' ;
    rdfs:comment 'Indicates whether this endorsement was delivered electronically to the insured or lender rather than in paper form. Supports eRecording and digital closing workflow tracking.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endorsementStatus rdf:type rdf:Property ;
    rdfs:label 'Endorsement Status' ;
    rdfs:comment 'Current lifecycle state of the endorsement. Tracks progression from draft through issuance or cancellation. Supports commitment revision frequency and policy issuance lag metrics.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementType rdf:type rdf:Property ;
    rdfs:label 'Endorsement Type' ;
    rdfs:comment 'Indicates whether this endorsement applies to an Owner\'s Title Policy (OTP), a Lender\'s Title Policy (LTP), or both. Supports owner-versus-lender coverage analysis per VREQ-010.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuanceDate rdf:type rdf:Property ;
    rdfs:label 'Issuance Date' ;
    rdfs:comment 'Date the endorsement was formally issued and delivered to the insured or lender. Used to measure policy issuance lag after recording and endorsement production cycle time.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:issuingOfficerName rdf:type rdf:Property ;
    rdfs:label 'Issuing Officer Name' ;
    rdfs:comment 'Name of the authorized title officer or underwriting officer who executed and issued this endorsement. Supports audit trail and authority verification.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingUnderwriterCode rdf:type rdf:Property ;
    rdfs:label 'Issuing Underwriter Code' ;
    rdfs:comment 'Code identifying the title underwriter (e.g., FNF, FAF, STC, ORI) that issued this endorsement. Supports underwriter-level premium and loss ratio reporting.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementName rdf:type rdf:Property ;
    rdfs:label 'Endorsement Name' ;
    rdfs:comment 'Human-readable name or short title of the endorsement form (e.g., \'Restrictions, Encroachments, Minerals\', \'Environmental Protection Lien\', \'Location\'). Complements the ALTA form number.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumBasis rdf:type rdf:Property ;
    rdfs:label 'Premium Basis' ;
    rdfs:comment 'Method used to calculate the endorsement premium (e.g., flat fee, rate per thousand of liability, percentage of policy amount, or no additional charge). Drives premium calculation logic.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorEndorsementId rdf:type rdf:Property ;
    rdfs:label 'Prior Endorsement Id' ;
    rdfs:comment 'Reference to the prior version of this endorsement that was superseded. Enables full revision chain traversal. Null for original issuances. Supports VREQ-007 lifecycle history.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remittanceDate rdf:type rdf:Property ;
    rdfs:label 'Remittance Date' ;
    rdfs:comment 'Date the endorsement premium was included in the agent\'s remittance to the underwriter. Null until remitted. Supports agency remittance timeliness metrics per VREQ-016.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remittanceIncluded rdf:type rdf:Property ;
    rdfs:label 'Remittance Included' ;
    rdfs:comment 'Indicates whether the endorsement premium has been included in the agent\'s premium remittance to the underwriter. Supports agency remittance timeliness and settlement reconciliation.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemEndorsementRef rdf:type rdf:Property ;
    rdfs:label 'Source System Endorsement Ref' ;
    rdfs:comment 'Native identifier for this endorsement record in the originating title production system (SoftPro, RamQuest, Qualia). Enables reconciliation and traceability back to the system of record.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingConditions rdf:type rdf:Property ;
    rdfs:label 'Underwriting Conditions' ;
    rdfs:comment 'Narrative description of any conditions imposed by the underwriter as part of an approved-with-conditions decision for this endorsement. Null if no conditions apply.' ;
    rdfs:domain ind:Endorsement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingDecision rdf:type rdf:Property ;
    rdfs:label 'Underwriting Decision' ;
    rdfs:comment 'Underwriting decision outcome for this endorsement when a referral was required. Null if no referral was needed. Supports UW exception rate and referral analysis.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingReferralRequired rdf:type rdf:Property ;
    rdfs:label 'Underwriting Referral Required' ;
    rdfs:comment 'Indicates whether this endorsement required an underwriting referral (UWR) for approval before issuance. Supports UW referral and exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyExceptionId rdf:type rdf:Property ;
    rdfs:label 'Policy Exception Id' ;
    rdfs:comment 'Unique surrogate identifier for a Schedule B-II policy exception record. Primary key for the policy_exception entity in the underwriting domain.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyException .

ind:priorExceptionPolicyExceptionId rdf:type rdf:Property ;
    rdfs:label 'Prior Exception Policy Exception Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the prior version of this exception record when it was revised or superseded. Preserves revision history and prior classifications per VREQ-007.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyException .

ind:addedDate rdf:type rdf:Property ;
    rdfs:label 'Added Date' ;
    rdfs:comment 'Calendar date on which this exception was first added to the commitment or policy Schedule B-II. Used for aging analysis and open exception tracking.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:affectsDescription rdf:type rdf:Property ;
    rdfs:label 'Affects Description' ;
    rdfs:comment 'Narrative description of the portion of the insured property affected by this exception (e.g., \'the northerly 10 feet\', \'the entire parcel\', \'as shown on survey\'). Supports partial-coverage analysis.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carriedToPolicyDate rdf:type rdf:Property ;
    rdfs:label 'Carried To Policy Date' ;
    rdfs:comment 'Date on which this exception was formally carried from the commitment into the issued title policy. Supports policy issuance lag and closing readiness metrics.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commitmentScheduleSection rdf:type rdf:Property ;
    rdfs:label 'Commitment Schedule Section' ;
    rdfs:comment 'Identifies the schedule section of the commitment where this item appears: Schedule B-II (exceptions from coverage) versus Schedule B-I (requirements). Enforces legal distinction per VREQ-002 and VREQ-017.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deletedDate rdf:type rdf:Property ;
    rdfs:label 'Deleted Date' ;
    rdfs:comment 'Calendar date on which this exception was removed from the commitment or policy Schedule B-II (e.g., after curative action, endorsement, or underwriter waiver). Null if still open.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:endorsementAvailable rdf:type rdf:Property ;
    rdfs:label 'Endorsement Available' ;
    rdfs:comment 'Indicates whether an ALTA endorsement (e.g., ALTA 9, ALTA 8.1, ALTA 22) is available to insure over or modify this exception, reducing its coverage impact.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exceptionNumber rdf:type rdf:Property ;
    rdfs:label 'Exception Number' ;
    rdfs:comment 'Sequential alphanumeric identifier assigned to this exception within the commitment or policy Schedule B-II (e.g., \'1\', \'2a\', \'3\'). Used for referencing in closing and curative documents.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionStatus rdf:type rdf:Property ;
    rdfs:label 'Exception Status' ;
    rdfs:comment 'Current lifecycle status of the exception: open (active on commitment), deleted (removed prior to policy), carried_to_policy (included in issued policy), waived (underwriter waived), subordinated (subordination obtained).' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionText rdf:type rdf:Property ;
    rdfs:label 'Exception Text' ;
    rdfs:comment 'Full verbatim text of the Schedule B-II exception as it appears in the commitment or policy. This is the legally operative language that defines the scope of the exclusion from coverage.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionType rdf:type rdf:Property ;
    rdfs:label 'Exception Type' ;
    rdfs:comment 'Categorical classification of the exception matter (e.g., easement, CC&R, ROW, HOA, survey matter, mineral rights, tax lien, mechanics lien). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDeleted rdf:type rdf:Property ;
    rdfs:label 'Is Deleted' ;
    rdfs:comment 'Logical deletion flag indicating this exception record has been superseded or removed from the active Schedule B-II. Preserves lifecycle history per VREQ-007 without physical deletion.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isStandardException rdf:type rdf:Property ;
    rdfs:label 'Is Standard Exception' ;
    rdfs:comment 'Indicates whether this exception is a standard pre-printed ALTA exception (true) or a special/typed exception specific to this property or transaction (false).' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSurveyException rdf:type rdf:Property ;
    rdfs:label 'Is Survey Exception' ;
    rdfs:comment 'Indicates whether this exception relates to survey matters (encroachments, overlaps, boundary disputes, or facts that an accurate survey would disclose). Relevant to ALTA 9 endorsement eligibility.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienAmountCurrency rdf:type rdf:Property ;
    rdfs:label 'Lien Amount Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the lien amount (e.g., USD). Defaults to USD for domestic US title transactions.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityPosition rdf:type rdf:Property ;
    rdfs:label 'Priority Position' ;
    rdfs:comment 'Numeric lien priority position of the encumbrance underlying this exception (e.g., 1 = first lien, 2 = second lien). Relevant for subordination analysis and LTV/CLTV underwriting.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceInstrumentDate rdf:type rdf:Property ;
    rdfs:label 'Source Instrument Date' ;
    rdfs:comment 'Execution or effective date of the source instrument underlying this exception. Used in chain-of-title analysis and exception provenance.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceInstrumentReference rdf:type rdf:Property ;
    rdfs:label 'Source Instrument Reference' ;
    rdfs:comment 'Recording reference (book/page, document number, or instrument number) of the instrument that is the basis for this exception, as recorded in the county recorder or register of deeds.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceInstrumentType rdf:type rdf:Property ;
    rdfs:label 'Source Instrument Type' ;
    rdfs:comment 'Type of recorded or filed instrument that is the basis for this exception (e.g., deed, mortgage, DOT, easement agreement, plat, judgment, tax certificate, UCC filing, HOA document, survey).' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemExceptionCode rdf:type rdf:Property ;
    rdfs:label 'Source System Exception Code' ;
    rdfs:comment 'Native identifier for this exception record in the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Supports system-of-record traceability and reconciliation.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardExceptionCode rdf:type rdf:Property ;
    rdfs:label 'Standard Exception Code' ;
    rdfs:comment 'Underwriter-assigned code identifying whether this is a standard pre-printed exception (e.g., ALTA standard exceptions 1–5) or a special/typed exception unique to this transaction.' ;
    rdfs:domain ind:PolicyException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwriterNotes rdf:type rdf:Property ;
    rdfs:label 'Underwriter Notes' ;
    rdfs:comment 'Free-text notes entered by the underwriter documenting the rationale for the underwriting decision on this exception, including any conditions or limitations applied.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingReferralId rdf:type rdf:Property ;
    rdfs:label 'Underwriting Referral Id' ;
    rdfs:comment 'Reference to the underwriting referral record if this exception required escalation to an underwriter for a risk decision. Supports UWR rate and exception rate metrics.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorCommitmentTitleCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Commitment Title Commitment Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding commitment version. Null for initial issuance. Preserves full revision lineage per VREQ-007.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleCommitment .

ind:underwriterId rdf:type rdf:Property ;
    rdfs:label 'Underwriter Id' ;
    rdfs:comment 'Reference to the title underwriter (e.g., FNF, FAF, STC, ORI) on whose paper this commitment is issued. Required for policy issuance and claims administration.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:closingDateActual rdf:type rdf:Property ;
    rdfs:label 'Closing Date Actual' ;
    rdfs:comment 'Date on which the transaction actually closed and settlement occurred. Null until closing is completed. Used to measure title clearance cycle time per VREQ-016.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closingDateScheduled rdf:type rdf:Property ;
    rdfs:label 'Closing Date Scheduled' ;
    rdfs:comment 'Anticipated closing/settlement date for the transaction. Used for closing readiness tracking and commitment expiration management per VREQ-016.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closingProtectionLetterFlag rdf:type rdf:Property ;
    rdfs:label 'Closing Protection Letter Flag' ;
    rdfs:comment 'Indicates whether a Closing Protection Letter (CPL) / Insured Closing Letter has been issued in connection with this commitment, protecting the lender against settlement agent fraud or negligence.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentNumber rdf:type rdf:Property ;
    rdfs:label 'Commitment Number' ;
    rdfs:comment 'Externally-known alphanumeric identifier assigned to this commitment by the title production system (e.g., SoftPro/RamQuest/Qualia). Printed on the commitment document delivered to parties.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentStatus rdf:type rdf:Property ;
    rdfs:label 'Commitment Status' ;
    rdfs:comment 'Current lifecycle state of this commitment version. Tracks progression from draft through issuance, revision, expiration, and closure. [ENUM-REF-CANDIDATE: draft|issued|revised|extended|expired|cancelled|closed — promote to reference product]' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentType rdf:type rdf:Property ;
    rdfs:label 'Commitment Type' ;
    rdfs:comment 'Classification of the underlying real estate transaction type for which the commitment is issued: purchase, refinance (REFI), home equity (HELOC), construction, or commercial.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cplIssueDate rdf:type rdf:Property ;
    rdfs:label 'Cpl Issue Date' ;
    rdfs:comment 'Date on which the Closing Protection Letter (CPL) was issued for this commitment. Null if no CPL was issued. Distinct from commitment issue_date per VREQ-008.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insurableTitleDetermination rdf:type rdf:Property ;
    rdfs:label 'Insurable Title Determination' ;
    rdfs:comment 'Underwriter\'s determination of whether title is insurable, insurable with exceptions, or not insurable at the time of commitment issuance. Core underwriting output.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanPolicyAmount rdf:type rdf:Property ;
    rdfs:label 'Loan Policy Amount' ;
    rdfs:comment 'Dollar amount of lender\'s title policy (LTP) coverage proposed in Schedule A. Typically equals the loan amount. Supports owner-versus-lender coverage metrics per VREQ-016.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loanPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Loan Premium Amount' ;
    rdfs:comment 'Calculated title insurance premium for the lender\'s policy (LTP) based on the applicable state rate schedule and liability amount. Used for premium remittance and revenue recognition.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openExceptionsCount rdf:type rdf:Property ;
    rdfs:label 'Open Exceptions Count' ;
    rdfs:comment 'Count of Schedule B-II exceptions (policy_exception records) listed on this commitment version. Supports unresolved defects/liens and exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openRequirementsCount rdf:type rdf:Property ;
    rdfs:label 'Open Requirements Count' ;
    rdfs:comment 'Count of uncleared Schedule B-I requirements (title_requirement records) at the time this commitment version was issued. Supports open/aging requirements metrics per VREQ-016.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerPolicyAmount rdf:type rdf:Property ;
    rdfs:label 'Owner Policy Amount' ;
    rdfs:comment 'Dollar amount of owner\'s title policy (OTP) coverage proposed in Schedule A. Typically equals the purchase price. Supports owner-versus-lender coverage metrics per VREQ-016.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownerPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Owner Premium Amount' ;
    rdfs:comment 'Calculated title insurance premium for the owner\'s policy (OTP) based on the applicable state rate schedule and liability amount. Used for premium remittance and revenue recognition.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyFormCode rdf:type rdf:Property ;
    rdfs:label 'Policy Form Code' ;
    rdfs:comment 'Code identifying the ALTA policy form version to be issued (e.g., ALTA 2006, ALTA 2016, state-specific form). Determines coverage terms and endorsement eligibility.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedInsuredLender rdf:type rdf:Property ;
    rdfs:label 'Proposed Insured Lender' ;
    rdfs:comment 'Name of the proposed insured lender/mortgagee as it appears in Schedule A of the commitment (LTP). Includes MERS nominee language where applicable.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedInsuredOwner rdf:type rdf:Property ;
    rdfs:label 'Proposed Insured Owner' ;
    rdfs:comment 'Name of the proposed insured owner as it appears in Schedule A of the commitment (OTP). Reflects vesting as it will appear on the deed. Distinct from lender insured.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reissueRateFlag rdf:type rdf:Property ;
    rdfs:label 'Reissue Rate Flag' ;
    rdfs:comment 'Indicates whether a reissue/refinance premium rate applies based on a prior policy within the qualifying period. Affects premium calculation and rate schedule selection.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisionDate rdf:type rdf:Property ;
    rdfs:label 'Revision Date' ;
    rdfs:comment 'Date on which this revision was prepared and issued. Null for the initial issuance version. Distinct from issue_date to preserve the amendment timeline per VREQ-007 and VREQ-008.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:scheduleANotes rdf:type rdf:Property ;
    rdfs:label 'Schedule A Notes' ;
    rdfs:comment 'Free-text notes or special conditions appearing in Schedule A of the commitment beyond the standard fields (e.g., vesting instructions, special estate language, survey requirements).' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCommitmentRef rdf:type rdf:Property ;
    rdfs:label 'Source System Commitment Ref' ;
    rdfs:comment 'Native commitment identifier from the originating title production system (e.g., SoftPro order/commitment number, RamQuest file number). Enables cross-system reconciliation.' ;
    rdfs:domain ind:TitleCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affectsFullParcel rdf:type rdf:Property ;
    rdfs:label 'Affects Full Parcel' ;
    rdfs:comment 'Flag indicating whether this finding affects the entire parcel or only a portion of it. When false, the partial_area_description field provides the specific affected area. Relevant for easements, encroachments, and partial liens.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bookVolume rdf:type rdf:Property ;
    rdfs:label 'Book Volume' ;
    rdfs:comment 'Book or volume number in the county recorder index where the instrument is recorded. Part of the official recording reference used to locate the instrument in the title plant or county records.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curativeDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Curative Deadline Date' ;
    rdfs:comment 'Target date by which curative action must be completed to meet the closing schedule. Used to identify aging and at-risk findings that may delay closing readiness. Supports closing readiness metrics per VREQ-016.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discoveryDate rdf:type rdf:Property ;
    rdfs:label 'Discovery Date' ;
    rdfs:comment 'Date the finding was identified during title examination. Represents the principal business event date (BUSINESS_EVENT_TIMESTAMP category). Used to calculate curative aging and open-requirement aging metrics per VREQ-016.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:findingDescription rdf:type rdf:Property ;
    rdfs:label 'Finding Description' ;
    rdfs:comment 'Free-text narrative description of the title defect, encumbrance, lien, cloud, or anomaly as documented by the examiner. Captures the specific nature of the issue including parties, amounts, and legal basis.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingNumber rdf:type rdf:Property ;
    rdfs:label 'Finding Number' ;
    rdfs:comment 'Human-readable business identifier for the finding, typically assigned by the Title Production System (e.g., SoftPro/RamQuest). Used in examiner notes, curative memos, and commitment schedules for cross-reference.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Status' ;
    rdfs:comment 'Current lifecycle status of the title finding. Drives open/aging requirement metrics and curative action tracking. Transitions from open through curative processing to cleared, excepted on Schedule B-II, or waived.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingType rdf:type rdf:Property ;
    rdfs:label 'Finding Type' ;
    rdfs:comment 'Categorical classification of the title defect or encumbrance discovered. [ENUM-REF-CANDIDATE: tax_lien|judgment_lien|mechanics_lien|lis_pendens|ucc_filing|easement|encroachment|cot_break|vesting_defect|hoa_lien|deed_of_trust|mortgage|cc_and_r|row|other —' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gapPeriodIndicator rdf:type rdf:Property ;
    rdfs:label 'Gap Period Indicator' ;
    rdfs:comment 'Flag indicating whether this finding falls within the gap period between the effective date of the title search and the recording of the insured instrument. Triggers gap coverage (GAPcure) analysis.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Date' ;
    rdfs:comment 'Date the underlying instrument giving rise to this finding was executed or created. Distinct from recording date; used in chain-of-title analysis and lien priority determination.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Flag indicating whether this is the current active version of the finding record. Supports soft-delete and record versioning patterns in the Silver layer. False indicates the record has been superseded or logically deleted.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:partialAreaDescription rdf:type rdf:Property ;
    rdfs:label 'Partial Area Description' ;
    rdfs:comment 'Legal or narrative description of the portion of the parcel affected by this finding when affects_full_parcel is false. Used for easements, encroachments, rights-of-way, and partial lien coverage analysis.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reclassificationDate rdf:type rdf:Property ;
    rdfs:label 'Reclassification Date' ;
    rdfs:comment 'Date on which the finding was reclassified from its prior_classification to the current finding_type or risk_classification. Null if no reclassification has occurred. Supports lifecycle revision history per VREQ-007.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskClassification rdf:type rdf:Property ;
    rdfs:label 'Risk Classification' ;
    rdfs:comment 'Underwriting determination of whether the finding renders title insurable, marketable, or requires curative action or referral. Supports insurable/marketable-title determination metrics per VREQ-016.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleBDisposition rdf:type rdf:Property ;
    rdfs:label 'Schedule B Disposition' ;
    rdfs:comment 'Disposition of this finding on the title commitment Schedule B. A value of \'requirement\' places it on Schedule B-I; \'exception\' places it on Schedule B-II. Legally distinct per VREQ-002 and VREQ-017.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severity rdf:type rdf:Property ;
    rdfs:label 'Severity' ;
    rdfs:comment 'Underwriter-assigned severity level indicating the risk impact of the finding on insurability or marketability of title. Critical findings typically require curative action or underwriting referral before commitment issuance.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemFindingRef rdf:type rdf:Property ;
    rdfs:label 'Source System Finding Ref' ;
    rdfs:comment 'Native identifier or reference number assigned to this finding by the originating operational system of record (e.g., SoftPro finding ID, RamQuest defect code). Enables reconciliation back to the SoR.' ;
    rdfs:domain ind:TitleFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companionPolicyNumber rdf:type rdf:Property ;
    rdfs:label 'Companion Policy Number' ;
    rdfs:comment 'Policy number of the simultaneously issued companion policy (OTP companion to LTP or vice versa). Supports simultaneous issue rate validation and owner-vs-lender coverage analysis.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTime rdf:type rdf:Property ;
    rdfs:label 'Effective Time' ;
    rdfs:comment 'Time component of the policy effective date (HH:mm:ss) as recorded on Schedule A. Title insurance coverage attaches at a specific time of day on the effective date.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:endorsementCount rdf:type rdf:Property ;
    rdfs:label 'Endorsement Count' ;
    rdfs:comment 'Number of ALTA endorsements attached to this policy at issuance (e.g., ALTA 9, ALTA 8.1, ALTA 22). Supports owner-versus-lender coverage and endorsement analysis.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estateOrInterest rdf:type rdf:Property ;
    rdfs:label 'Estate Or Interest' ;
    rdfs:comment 'Nature of the estate or interest in the land insured under Schedule A (e.g., fee simple, leasehold). Defines the scope of title coverage.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredType rdf:type rdf:Property ;
    rdfs:label 'Insured Type' ;
    rdfs:comment 'Classification of the insured party: individual person, legal entity (LLC/Corp), trust, estate, or government body. Drives vesting and coverage analysis.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyExceptionCount rdf:type rdf:Property ;
    rdfs:label 'Policy Exception Count' ;
    rdfs:comment 'Number of Schedule B-II exceptions (policy_exception records) carried on this policy at issuance. Supports unresolved defect and exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current lifecycle state of the title policy. Tracks progression from draft through issuance, and captures cancellations or reissuances for revision history per VREQ-007.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumAmount rdf:type rdf:Property ;
    rdfs:label 'Premium Amount' ;
    rdfs:comment 'Gross title insurance premium charged for this policy before any splits or adjustments. Used for premium revenue recognition and remittance calculations.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reissueFlag rdf:type rdf:Property ;
    rdfs:label 'Reissue Flag' ;
    rdfs:comment 'Indicates whether this policy was issued at a reissue rate based on a prior policy. Triggers reissue credit calculation and prior policy validation.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemPolicyRef rdf:type rdf:Property ;
    rdfs:label 'Source System Policy Ref' ;
    rdfs:comment 'Native policy identifier from the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Enables traceability back to the system of record.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underwritingReferralFlag rdf:type rdf:Property ;
    rdfs:label 'Underwriting Referral Flag' ;
    rdfs:comment 'Indicates whether this policy required an underwriting referral (UWR) to the underwriter\'s home office or senior underwriter prior to issuance. Drives UWR rate metrics.' ;
    rdfs:domain ind:TitlePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorRequirementTitleRequirementId rdf:type rdf:Property ;
    rdfs:label 'Prior Requirement Title Requirement Id' ;
    rdfs:comment 'Self-referencing link to the previous version of this requirement record when a material revision occurred. Preserves lifecycle history per VREQ-007.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TitleRequirement .

ind:addedToCommitmentDate rdf:type rdf:Property ;
    rdfs:label 'Added To Commitment Date' ;
    rdfs:comment 'Date this requirement was formally added to the title commitment as a Schedule B-I item. May differ from identified_date if added during a commitment revision.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appliesToPolicyType rdf:type rdf:Property ;
    rdfs:label 'Applies To Policy Type' ;
    rdfs:comment 'Indicates whether this requirement applies to the owner policy (OTP), lender policy (LTP), or both. Supports owner-versus-lender coverage analysis per VREQ-010.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedCurativeProcessor rdf:type rdf:Property ;
    rdfs:label 'Assigned Curative Processor' ;
    rdfs:comment 'Name or identifier of the internal curative processor or title officer assigned to manage resolution of this requirement. Supports workload and aging analysis.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmedPayoffAmount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Payoff Amount' ;
    rdfs:comment 'Confirmed dollar amount from the payoff demand letter or lien release documentation. Supersedes estimated_payoff_amount once verified. Used for final settlement reconciliation.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curativeMemoReference rdf:type rdf:Property ;
    rdfs:label 'Curative Memo Reference' ;
    rdfs:comment 'Reference number or identifier of the Curative Processing Memo (CPM) associated with the resolution effort for this requirement. Links to document management system.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedPayoffAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Payoff Amount' ;
    rdfs:comment 'Estimated dollar amount required to satisfy this requirement (e.g., mortgage payoff, tax lien amount, judgment amount). Used for settlement statement preparation and escrow funding.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evidenceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Document Reference' ;
    rdfs:comment 'Document management system reference (document ID or URL) for the evidence supporting satisfaction of this requirement (e.g., recorded release, payoff confirmation letter).' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'Calendar date on which this requirement was first identified during title examination. Start point for curative aging calculations and SLA tracking.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instrumentReference rdf:type rdf:Property ;
    rdfs:label 'Instrument Reference' ;
    rdfs:comment 'Recording reference (book/page, document number, or instrument number) of the recorded instrument underlying this requirement. Supports chain-of-title tracing.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActiveVersion rdf:type rdf:Property ;
    rdfs:label 'Is Active Version' ;
    rdfs:comment 'Indicates whether this record is the current active version of the requirement. False for superseded versions retained for lifecycle history. Supports bi-temporal querying.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isClosingCondition rdf:type rdf:Property ;
    rdfs:label 'Is Closing Condition' ;
    rdfs:comment 'Indicates whether this requirement must be satisfied before closing can proceed. True = hard closing block; False = may be satisfied post-closing with escrow holdback.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isUnderwriterReferral rdf:type rdf:Property ;
    rdfs:label 'Is Underwriter Referral' ;
    rdfs:comment 'Indicates whether this requirement was escalated to the underwriter for a formal underwriting referral (UWR) decision. Supports UW referral rate metrics.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Operational priority assigned to this requirement for curative processing. Critical items block closing; high items require expedited action before commitment expiry.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementCategory rdf:type rdf:Property ;
    rdfs:label 'Requirement Category' ;
    rdfs:comment 'Broad grouping of the requirement for reporting and aging analysis (e.g., lien clearance, vesting, survey, tax). Supports open/aging requirement metrics. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementDescription rdf:type rdf:Property ;
    rdfs:label 'Requirement Description' ;
    rdfs:comment 'Full narrative text of the Schedule B-I requirement as it appears on the commitment. Describes the specific curative action required of the parties before policy issuance.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementNumber rdf:type rdf:Property ;
    rdfs:label 'Requirement Number' ;
    rdfs:comment 'Human-readable Schedule B-I item number as it appears on the commitment (e.g., B-I-1, B-I-2). Used for external communication with parties and lenders.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementSource rdf:type rdf:Property ;
    rdfs:label 'Requirement Source' ;
    rdfs:comment 'Identifies who or what system originated this requirement (examiner, underwriter, lender instruction, automated search engine). Supports provenance and audit.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementStatus rdf:type rdf:Property ;
    rdfs:label 'Requirement Status' ;
    rdfs:comment 'Current lifecycle state of the Schedule B-I requirement. Drives closing readiness and open/aging requirement dashboards. Transitions: open → in_progress → satisfied or waived.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requirementType rdf:type rdf:Property ;
    rdfs:label 'Requirement Type' ;
    rdfs:comment 'Categorical classification of the curative action required (e.g., payoff, release, satisfaction, subordination). Drives workflow routing and curative processing.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionDate rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Date' ;
    rdfs:comment 'Date on which this requirement was confirmed as satisfied (e.g., payoff received, release recorded). Null if not yet satisfied. Used for curative effectiveness metrics.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:satisfactionMethod rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Method' ;
    rdfs:comment 'Method by which this requirement was ultimately satisfied or resolved (e.g., payoff and release, recorded release, affidavit, court order, underwriter waiver, escrow holdback).' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRequirementCode rdf:type rdf:Property ;
    rdfs:label 'Source System Requirement Code' ;
    rdfs:comment 'Native identifier of this requirement in the originating title production system (e.g., SoftPro Select, RamQuest Horizon, Qualia). Used for system-of-record reconciliation.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverAuthority rdf:type rdf:Property ;
    rdfs:label 'Waiver Authority' ;
    rdfs:comment 'Name or identifier of the underwriter or authorized officer who approved the waiver of this requirement. Required when requirement_status is waived. Supports audit trail.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Date' ;
    rdfs:comment 'Date on which this requirement was formally waived by the underwriter or authorized officer. Null if not waived. Requires waiver_authority and waiver_reason to be populated.' ;
    rdfs:domain ind:TitleRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorDecisionId rdf:type rdf:Property ;
    rdfs:label 'Prior Decision Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding version of this underwriting decision. Preserves full revision history per VREQ-007.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Decision .

ind:conditionsImposed rdf:type rdf:Property ;
    rdfs:label 'Conditions Imposed' ;
    rdfs:comment 'Free-text description of conditions, requirements, or curative actions imposed by the underwriter as part of a conditional approval. Drives Schedule B-I requirement generation.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementRequired rdf:type rdf:Property ;
    rdfs:label 'Endorsement Required' ;
    rdfs:comment 'Indicates whether the underwriting decision requires issuance of one or more ALTA endorsements as a condition of insuring title.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endorsementTypes rdf:type rdf:Property ;
    rdfs:label 'Endorsement Types' ;
    rdfs:comment 'Comma-separated list of ALTA endorsement form numbers required by this decision (e.g., ALTA 9, ALTA 8.1, ALTA 22). Populated when endorsement_required is true.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationCount rdf:type rdf:Property ;
    rdfs:label 'Escalation Count' ;
    rdfs:comment 'Number of times this underwriting decision was escalated to a higher authority level. Supports UW referral and exception rate metrics per VREQ-016.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceptionScheduled rdf:type rdf:Property ;
    rdfs:label 'Exception Scheduled' ;
    rdfs:comment 'Indicates whether the underwriting decision resulted in a Schedule B-II exception being carried to the commitment or policy rather than cured.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isExceptionApproval rdf:type rdf:Property ;
    rdfs:label 'Is Exception Approval' ;
    rdfs:comment 'Indicates whether this decision constitutes a policy exception approval (PE) — an approval granted outside standard underwriting guidelines. Supports UW exception rate metrics.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketableTitleDetermination rdf:type rdf:Property ;
    rdfs:label 'Marketable Title Determination' ;
    rdfs:comment 'Formal determination of whether title meets the marketable title standard. Legally distinct from insurable title; both must be tracked per VREQ-007.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outcome rdf:type rdf:Property ;
    rdfs:label 'Outcome' ;
    rdfs:comment 'The formal outcome of the underwriting review. Distinct from decision_status (workflow state) — this is the substantive risk determination result.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTypeRequested rdf:type rdf:Property ;
    rdfs:label 'Policy Type Requested' ;
    rdfs:comment 'Indicates whether the underwriting decision covers an Owner\'s Title Policy (OTP), Lender\'s Title Policy (LTP), or both. Supports owner-versus-lender coverage metrics per VREQ-016.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorClaimReference rdf:type rdf:Property ;
    rdfs:label 'Prior Claim Reference' ;
    rdfs:comment 'Reference number or identifier of any prior title claim on the subject property that influenced this underwriting decision. Supports claim frequency and risk history analysis.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rationale rdf:type rdf:Property ;
    rdfs:label 'Rationale' ;
    rdfs:comment 'Detailed narrative explanation of the underwriter\'s reasoning, risk analysis, and basis for the decision outcome. Preserved for audit, legal, and regulatory review.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralDate rdf:type rdf:Property ;
    rdfs:label 'Referral Date' ;
    rdfs:comment 'Date on which the underwriting referral or risk matter was submitted to the underwriter for decision. Used to calculate UW turnaround time and referral aging metrics.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referralTriggerReason rdf:type rdf:Property ;
    rdfs:label 'Referral Trigger Reason' ;
    rdfs:comment 'Narrative or coded reason that caused this matter to require an underwriting decision, e.g., liability threshold exceeded, chain-of-title break, prior claim, gap period.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'Risk tier assigned by the underwriter based on defect severity, lien exposure, chain-of-title integrity, and other risk factors identified during examination.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemDecisionRef rdf:type rdf:Property ;
    rdfs:label 'Source System Decision Ref' ;
    rdfs:comment 'Native identifier of this underwriting decision in the originating source system. Enables cross-system reconciliation between the lakehouse and the title production or UW risk system.' ;
    rdfs:domain ind:Decision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Uw Authority Level' ;
    rdfs:comment 'Authority tier at which this decision was rendered. Tracks escalation path and ensures decisions are within the underwriter\'s delegated authority limits.' ;
    rdfs:domain ind:Underwriting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinerPartyId rdf:type rdf:Property ;
    rdfs:label 'Examiner Party Id' ;
    rdfs:comment 'Reference to the party record for the licensed title examiner or attorney who performed the examination. Supports examiner identity and workload analytics.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:priorExaminationId rdf:type rdf:Property ;
    rdfs:label 'Prior Examination Id' ;
    rdfs:comment 'Self-referencing identifier pointing to the immediately preceding examination record for this order. Preserves revision lineage and material lifecycle transitions (VREQ-007).' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UnderwritingTitleExamination .

ind:examinationCompletionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Examination Completion Timestamp' ;
    rdfs:comment 'Precise date and time the examiner finalized the examination and released findings. Used to compute title clearance cycle time and examiner throughput metrics.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:examinationScopeNotes rdf:type rdf:Property ;
    rdfs:label 'Examination Scope Notes' ;
    rdfs:comment 'Free-text notes describing the scope, limitations, or special conditions of the examination (e.g., limited search period, missing instruments, county plant gaps). Supports evidence provenance.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinerOpinion rdf:type rdf:Property ;
    rdfs:label 'Examiner Opinion' ;
    rdfs:comment 'Formal written opinion or summary conclusion of the title examiner regarding the state of title, including any qualifications or conditions. Core evidence and provenance field (VREQ-007).' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examinerStateCode rdf:type rdf:Property ;
    rdfs:label 'Examiner State Code' ;
    rdfs:comment 'Two-letter US state code where the examiner is licensed to perform title examinations. Ensures jurisdiction-appropriate examination standards are applied.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingCount rdf:type rdf:Property ;
    rdfs:label 'Finding Count' ;
    rdfs:comment 'Total number of title_finding records generated from this examination. Supports open/aging defect metrics and examiner productivity reporting (VREQ-016).' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:judgmentLienIdentified rdf:type rdf:Property ;
    rdfs:label 'Judgment Lien Identified' ;
    rdfs:comment 'Indicates whether a judgment lien against the vested owner or property was identified during examination. Requires curative clearance before policy issuance.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lienSearchIncluded rdf:type rdf:Property ;
    rdfs:label 'Lien Search Included' ;
    rdfs:comment 'Indicates whether a lien search (judgment liens, tax liens, mechanics liens, HOA assessments) was included in the examination scope. Affects unresolved lien metrics.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lisPendensIdentified rdf:type rdf:Property ;
    rdfs:label 'Lis Pendens Identified' ;
    rdfs:comment 'Indicates whether a lis pendens (LP) — notice of pending litigation — was identified against the subject property during examination. Significant underwriting risk factor.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mechanicsLienIdentified rdf:type rdf:Property ;
    rdfs:label 'Mechanics Lien Identified' ;
    rdfs:comment 'Indicates whether a mechanics lien or materialman\'s lien was identified against the subject property during examination. Common in construction transactions.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyCountyFips rdf:type rdf:Property ;
    rdfs:label 'Property County Fips' ;
    rdfs:comment 'Five-digit FIPS county code for the county in which the subject property is located. Used for county recorder routing, plant access, and jurisdiction-level reporting.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemExamRef rdf:type rdf:Property ;
    rdfs:label 'Source System Exam Ref' ;
    rdfs:comment 'Native identifier for this examination record in the originating title production system (SoftPro/RamQuest/Qualia). Enables cross-system reconciliation and audit traceability.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxLienIdentified rdf:type rdf:Property ;
    rdfs:label 'Tax Lien Identified' ;
    rdfs:comment 'Indicates whether a federal or state tax lien was identified against the subject property or vested owner during examination. Triggers curative requirement.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:underwritingReferralReason rdf:type rdf:Property ;
    rdfs:label 'Underwriting Referral Reason' ;
    rdfs:comment 'Free-text or coded reason explaining why the examination was escalated for underwriting review (e.g., chain-of-title break, unresolved lien, high-risk vesting). Supports UWR rate analysis.' ;
    rdfs:domain ind:UnderwritingTitleExamination ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorReferralId rdf:type rdf:Property ;
    rdfs:label 'Prior Referral Id' ;
    rdfs:comment 'Self-referential link to the previous version of this referral when revision_number > 1. Preserves material lifecycle history and revision chain per VREQ-007.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:UwReferral .

ind:uwAssignedUnderwriterPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Assigned Underwriter Party Id' ;
    rdfs:comment 'Identifier of the underwriter assigned to review and decide on this referral. Supports underwriter workload, cycle time, and decision-rate analytics.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:uwPartyId rdf:type rdf:Property ;
    rdfs:label 'Uw Party Id' ;
    rdfs:comment 'Identifier of the title examiner or branch staff member who initiated the underwriting referral. Supports examiner-level UWR rate and workload analytics.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Party .

ind:channel rdf:type rdf:Property ;
    rdfs:label 'Channel' ;
    rdfs:comment 'Business channel through which the originating title order was produced: direct branch, centralized lender, or independent agent. Supports channel-level UWR rate reporting.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closingDateImpact rdf:type rdf:Property ;
    rdfs:label 'Closing Date Impact' ;
    rdfs:comment 'Indicates whether this underwriting referral caused or is at risk of causing a delay to the scheduled closing date. Supports closing readiness metrics per VREQ-016.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liabilityThresholdExceeded rdf:type rdf:Property ;
    rdfs:label 'Liability Threshold Exceeded' ;
    rdfs:comment 'Indicates whether the transaction liability amount exceeded the underwriter\'s authority threshold, triggering mandatory referral. True = threshold exceeded.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:referralNumber rdf:type rdf:Property ;
    rdfs:label 'Referral Number' ;
    rdfs:comment 'Human-readable, externally referenceable identifier for this underwriting referral, formatted as UWR-YYYY-NNNNNN. Used in correspondence with underwriters and in audit trails.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralStatus rdf:type rdf:Property ;
    rdfs:label 'Referral Status' ;
    rdfs:comment 'Current lifecycle state of the underwriting referral. Drives open/aging UWR metrics and commitment readiness. [ENUM-REF-CANDIDATE: open|pending_uw_review|approved|approved_with_conditions|declined|withdrawn — promote to reference product]' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referralTimestamp rdf:type rdf:Property ;
    rdfs:label 'Referral Timestamp' ;
    rdfs:comment 'Precise date-time when the underwriting referral was submitted. Provides intraday precision for SLA measurement and audit trail beyond the referral_date.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:referralType rdf:type rdf:Property ;
    rdfs:label 'Referral Type' ;
    rdfs:comment 'Classification of the primary reason for escalation to underwriting review. Supports UWR rate analytics by trigger category. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaBreach rdf:type rdf:Property ;
    rdfs:label 'Sla Breach' ;
    rdfs:comment 'Indicates whether the underwriting decision was rendered after the sla_target_days threshold. True = SLA breached. Supports aging and cycle time reporting.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:uwDecision rdf:type rdf:Property ;
    rdfs:label 'Uw Decision' ;
    rdfs:comment 'Final underwriting decision rendered on this referral. Drives commitment issuance, exception scheduling, and curative action requirements.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uwDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Date' ;
    rdfs:comment 'Date on which the underwriter rendered a decision (approved, approved with conditions, or declined) on this referral. Used to compute UWR cycle time.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uwDecisionRationale rdf:type rdf:Property ;
    rdfs:label 'Uw Decision Rationale' ;
    rdfs:comment 'Narrative explanation provided by the underwriter supporting the decision. Required for declined and approved-with-conditions outcomes for audit and regulatory review.' ;
    rdfs:domain ind:UwReferral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .
